<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="view_account_move_fleet_form" model="ir.ui.view">
        <field name="name">account.move.fleet.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account_fleet.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']//field[@name='account_id']" position="attributes">
                <attribute name="widget">m2o_cell_with_extra_fields</attribute>
                <attribute name="options">{'parent_field': 'line_ids'}</attribute>
            </xpath>
        </field>
    </record>

</odoo>
