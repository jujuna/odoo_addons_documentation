      "properties": {
        "ssin": {
          "examples": [
            "12345678901"
          ],
          "mask": "00.00.00-000.00",
          "pattern": "^[0-9]{2}(0[0-9]|1[0-2]|2[0-9]|3[0-2]|4[0-9]|5[0-2])([0-2][0-9]|3[01])[0-9]{3}([0-8][0-9]|[9][0-7])$",
          "title": "Numéro de sécurité sociale",
          "type": "string"
        },
        "cbein": {
          "examples": [
            "0123.456.789"
          ],
          "mask": "0000.000.000",
          "pattern": "^[0-1][0-9]{9}$",
          "title": "Numéro d'entreprise",
          "type": "string"
        },
        "tin": {
          "examples": [
            "BE0123456789"
          ],
          "pattern": "^[a-zA-Z0-9]*$",
          "title": "Numéro d'identification fiscale",
          "type": "string"
