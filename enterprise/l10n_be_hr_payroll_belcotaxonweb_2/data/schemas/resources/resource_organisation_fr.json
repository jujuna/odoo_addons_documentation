    "address": {
      "additionalProperties": false,
      "properties": {
        "b": {
          "examples": [
            "5"
          ],
          "maxLength": 100,
          "minLength": 1,
          "title": "Boîte",
          "type": "string"
        },
        "n": {
          "examples": [
            "15"
          ],
          "maxLength": 20,
          "minLength": 1,
          "title": "Numéro",
          "type": "string"
        },
        "s": {
          "examples": [
            "Rue Principale"
          ],
          "maxLength": 100,
          "minLength": 1,
          "title": "Rue",
          "type": "string"
        },
        "c": {
          "examples": [
            "Bruxelles"
          ],
          "maxLength": 100,
          "minLength": 1,
          "title": "Ville",
          "type": "string"
        },
        "p": {
          "examples": [
            "1000"
          ],
          "maxLength": 50,
          "minLength": 1,
          "title": "Code postal",
          "type": "string"
        },
        "l": {
          "description": "Code pays INS, voir https://www.socialsecurity.be",
          "examples": [
            "150"
          ],
          "pattern": "^[0-9]{3}$",
          "title": "Pays",
          "type": "string"
        }
      },
      "required": [
        "l"
      ],
      "title": "Adresse",
      "type": "object"
    }
  },
  "$id": "urn:r:d:o:1:fr",
  "$schema": "https://belcotax.be/resources/schema/1",
  "additionalProperties": false,
  "properties": {
    "$s": {
      "oneOf": [
        {
          "const": "urn:r:d:o:1"
        },
        {
          "const": "urn:r:d:o:1:fr"
        },
        {
          "const": "urn:r:d:o:1:nl"
        },
        {
          "const": "urn:r:d:o:1:de"
        }
      ],
      "title": "Schéma",
      "type": "string"
    },
    "integrityHash": {
      "description": "Integrity hash",
      "title": "Integrity hash",
      "type": "string"
    },
    "k": {
      "description": "Clé utilisée pour identifier cette ressource",
      "examples": [
        "ORGA-12345"
      ],
      "maxLength": 255,
      "minLength": 1,
      "title": "Clé",
      "type": "string"
    },
    "i": {
      "additionalProperties": false,
      "description": "Clés d'identification de l'organisation",
      "minProperties": 1,
      "properties": {
        "cbein": {
          "examples": [
            "0123456789"
          ],
          "mask": "0000.000.000",
          "pattern": "^[019][0-9]{9}$",
          "title": "Numéro d'entreprise de la Banque-Carrefour des Entreprises",
          "type": "string"
        },
        "tin": {
          "examples": [
            "BE0123456789"
          ],
          "pattern": "^[a-zA-Z0-9]*$",
          "title": "Numéro d'identification fiscale",
          "type": "string"
        },
        "vat": {
          "examples": [
            "BE0123456789"
          ],
          "maxLength": 25,
          "pattern": "^[A-Z]{2}[A-Z0-9]+$",
          "title": "Numéro de TVA",
          "type": "string"
        },
        "fain": {
          "maxLength": 25,
          "title": "Numéro d'identification de l'association fiscale",
          "type": "string"
        },
        "vcode": {
          "examples": [
            "V1234567"
          ],
          "pattern": "^V[0-9]{7}$",
          "title": "Numéro d'association",
          "type": "string"
        }
      },
      "title": "Identifications",
      "type": "object"
    },
    "n": {
      "additionalProperties": false,
      "description": "Les noms de l'organisation dans différentes langues",
      "minProperties": 1,
      "properties": {
        "fr": {
          "examples": [
            "Nom d'exemple d'organisation"
          ],
          "maxLength": 255,
          "minLength": 1,
          "title": "Français",
          "type": "string"
        },
        "nl": {
          "examples": [
            "Voorbeeld Organisatie Naam"
          ],
          "maxLength": 255,
          "minLength": 1,
          "title": "Néerlandais",
          "type": "string"
        },
        "de": {
          "examples": [
            "Beispiel Organisation Name"
          ],
          "maxLength": 255,
          "minLength": 1,
          "title": "Allemand",
          "type": "string"
        }
      },
      "title": "Noms",
      "type": "object"
    },
    "f": {
      "description": "Forme juridique abréviation anglaise, voir https://economie.fgov.be/en",
      "examples": [
        "PLC",
        "PLIMCO",
        "OTHER"
      ],
      "pattern": "^[A-Z]{1,15}$",
      "title": "Forme juridique",
      "type": "string"
    },
    "a": {
      "$ref": "#/$defs/address"
    }
  },
  "required": [
    "$s",
    "k",
    "n"
  ],
  "title": "Organisation",
  "type": "object"
}
