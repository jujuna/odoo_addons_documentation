<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_batch_payment_form_inherit_l10n_it_cbi" model="ir.ui.view">
        <field name="name">account.batch.payment.form.inherit.l10n.it.cbi</field>
        <field name="model">account.batch.payment</field>
        <field name="inherit_id" ref="account_batch_payment.view_batch_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_method_id']" position="after">
                <field name="l10n_it_cbi_priority"
                       invisible="payment_method_code != 'cbi_ct'"
                       required="payment_method_code == 'cbi_ct'"/>
            </xpath>
        </field>
    </record>
</odoo>
