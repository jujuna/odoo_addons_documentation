<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_be_pos_blackbox.BurgerMenuDialog" t-inherit="point_of_sale.BurgerMenuDialog" t-inherit-mode="extension">
        <xpath expr="//button[@title='Local Network Access']" position="after">
            <t t-if="this.pos.blackbox.isActive">
                <div class="small lh-sm ml-2">
                    <div>
                        POS ID: <t t-out="this.pos.config.l10n_be_pos_id"/>
                    </div>
                    <div>
                        PosSwVersion: <t t-out="this.pos.config.posSwVersion"/>
                    </div>
                </div>
            </t>
        </xpath>
    </t>
</templates>
