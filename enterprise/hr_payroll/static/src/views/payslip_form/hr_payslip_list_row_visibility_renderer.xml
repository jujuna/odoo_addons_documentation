<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <t t-name="hr_payroll.PayslipListRowVisibility" t-inherit="web.ListRenderer.Rows" t-inherit-mode="primary">
        <xpath expr="//t[@t-foreach='list.records']" position="attributes">
            <attribute name="t-foreach">this.VisibleRows</attribute>
        </xpath>
    </t>

    <t t-name="hr_payroll.PayslipListRecordRow" t-inherit="web.ListRenderer.RecordRow" t-inherit-mode="primary">
        <xpath expr="//tr[hasclass('o_data_row')]" position="attributes">
            <attribute name="t-att-style">this.getRowStyle(record)</attribute>
        </xpath>
    </t>
</odoo>
