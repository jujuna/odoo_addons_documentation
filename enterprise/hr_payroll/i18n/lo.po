#. module: hr_payroll
#. odoo-python
#: code:addons/hr_payroll/models/hr_payslip_run.py:0
msgid "You can only correct a validated or paid pay run."
msgstr "ທ່ານສາມາດແກ້ໄຂໄດ້ສະເພາະຮອບຈ່າຍເງິນເດືອນທີ່ຢືນຢັນແລ້ວ ຫຼື ຈ່າຍແລ້ວເທົ່ານັ້ນ."

#. module: hr_payroll
#. odoo-python
#: code:addons/hr_payroll/models/hr_payslip.py:0
msgid "You can only correct payslips that have been paid."
msgstr "ທ່ານສາມາດແກ້ໄຂໄດ້ສະເພາະໃບແຈ້ງເງິນເດືອນທີ່ຈ່າຍແລ້ວເທົ່ານັ້ນ."

#. module: hr_payroll
#. odoo-python
#: code:addons/hr_payroll/models/hr_payslip_run.py:0
msgid ""
"You can only re-compute payslips in a pay run that is in draft or ready "
"state."
msgstr ""
"ທ່ານສາມາດຄິດໄລ່ໃບແຈ້ງເງິນເດືອນຄືນໃໝ່ໄດ້ສະເພາະໃນຮອບຈ່າຍທີ່ຢູ່ໃນສະຖານະ ຮ່າງ ຫຼື ພ້ອມແລ້ວ ເທົ່ານັ້ນ."

#. module: hr_payroll
#. odoo-python
#: code:addons/hr_payroll/models/hr_version.py:0
msgid "You can't archive a version with validated payslips."
msgstr "ທ່ານບໍ່ສາມາດຈັດເກັບເວີຊັນທີ່ມີໃບແຈ້ງເງິນເດືອນທີ່ຢືນຢັນແລ້ວໄດ້."

#. module: hr_payroll
#. odoo-python
#: code:addons/hr_payroll/models/hr_payslip.py:0
msgid "You can't confirm cancelled payslips."
msgstr "ທ່ານບໍ່ສາມາດຢືນຢັນໃບແຈ້ງເງິນເດືອນທີ່ຖືກຍົກເລີກແລ້ວໄດ້."

#. module: hr_payroll
#. odoo-python
#: code:addons/hr_payroll/models/hr_payslip_run.py:0
msgid ""
"You can't delete a pay run with payslips if they are not draft or cancelled."
msgstr ""
"ທ່ານບໍ່ສາມາດລຶບຮອບຈ່າຍເງິນເດືອນທີ່ມີໃບແຈ້ງເງິນເດືອນໄດ້ ຖ້າສະຖານະບໍ່ແມ່ນສະບັບຮ່າງ ຫຼື ຖືກຍົກເລີກ."

#. module: hr_payroll
#. odoo-python
#: code:addons/hr_payroll/models/hr_version.py:0
msgid "You can't delete a version with validated payslips."
msgstr "ທ່ານບໍ່ສາມາດລຶບເວີຊັນທີ່ມີໃບແຈ້ງເງິນເດືອນທີ່ຢືນຢັນແລ້ວໄດ້."

#. module: hr_payroll
#. odoo-python
#: code:addons/hr_payroll/models/hr_payslip.py:0
msgid "You can't validate a payslip linked to an archived version."
msgstr "ທ່ານບໍ່ສາມາດຢືນຢັນໃບແຈ້ງເງິນເດືອນທີ່ເຊື່ອມໂຍງກັບເວີຊັນທີ່ຖືກຈັດເກັບແລ້ວໄດ້."

#. module: hr_payroll
#. odoo-python
#: code:addons/hr_payroll/models/hr_payslip.py:0
msgid "You cannot cancel the payment if the payslip has not been paid."
msgstr "ທ່ານບໍ່ສາມາດຍົກເລີກການຈ່າຍເງິນໄດ້ ຖ້າໃບແຈ້ງເງິນເດືອນຍັງບໍ່ທັນໄດ້ຈ່າຍ."

#. module: hr_payroll
#. odoo-python
#: code:addons/hr_payroll/models/hr_salary_rule_category.py:0
msgid ""
"You cannot change the country of category %s as it is used in existing "
"Salary Rules"
msgstr "ທ່ານບໍ່ສາມາດປ່ຽນປະເທດຂອງໝວດໝູ່ %s ໄດ້ ເນື່ອງຈາກຖືກນຳໃຊ້ໃນກົດເກນເງິນເດືອນທີ່ມີຢູ່ແລ້ວ"

#. module: hr_payroll
#. odoo-python
#: code:addons/hr_payroll/models/base_document_layout.py:0
msgid "You cannot configure the document layout for this company"
msgstr "ທ່ານບໍ່ສາມາດຕັ້ງຄ່າຮູບແບບເອກະສານສຳລັບບໍລິສັດນີ້ໄດ້"

#. module: hr_payroll
#. odoo-python
#: code:addons/hr_payroll/models/hr_salary_attachment.py:0
msgid "You cannot delete a payslip adjustment that is linked to a payslip!"
msgstr "ທ່ານບໍ່ສາມາດລຶບການປັບປຸງໃບແຈ້ງເງິນເດືອນທີ່ເຊື່ອມໂຍງກັບໃບແຈ້ງເງິນເດືອນໄດ້!"

#. module: hr_payroll
#. odoo-python
#: code:addons/hr_payroll/models/hr_rule_parameter.py:0
msgid ""
"You cannot delete a rule parameter created by the system.\n"
"Archive it instead."
msgstr ""
"ທ່ານບໍ່ສາມາດລຶບພາຣາມິເຕີກົດເກນທີ່ສ້າງຂຶ້ນໂດຍລະບົບໄດ້.\n"
"ໃຫ້ປ່ຽນເປັນການຈັດເກັບແທນ."

#. module: hr_payroll
#. odoo-python
#: code:addons/hr_payroll/models/hr_rule_parameter_value.py:0
msgid ""
"You cannot delete a rule parameter value created by the system.\n"
"You can modify its value instead or archive the rule parameter."
msgstr ""
"ທ່ານບໍ່ສາມາດລຶບຄ່າພາຣາມິເຕີກົດເກນທີ່ສ້າງຂຶ້ນໂດຍລະບົບໄດ້.\n"
"ທ່ານສາມາດແກ້ໄຂຄ່າຂອງມັນແທນ ຫຼື ຈັດເກັບພາຣາມິເຕີກົດເກນນັ້ນໄວ້."

#. module: hr_payroll
#. odoo-python
#: code:addons/hr_payroll/models/hr_salary_rule.py:0
msgid ""
"You cannot delete a salary rule created by the system.\n"
"Archive it instead."
msgstr ""
"ທ່ານບໍ່ສາມາດລຶບກົດເກນເງິນເດືອນທີ່ສ້າງຂຶ້ນໂດຍລະບົບໄດ້.\n"
"ໃຫ້ປ່ຽນເປັນການຈັດເກັບແທນ."

#. module: hr_payroll
#. odoo-python
#: code:addons/hr_payroll/models/hr_salary_rule_section.py:0
msgid "You cannot delete a section currently used in a salary structure."
msgstr "ທ່ານບໍ່ສາມາດລຶບພາກສ່ວນທີ່ກຳລັງຖືກນຳໃຊ້ໃນໂຄງສ້າງເງິນເດືອນໄດ້."

#. module: hr_payroll
#. odoo-python
#: code:addons/hr_payroll/models/payroll_config_settings.py:0
msgid ""
"You cannot delete the only payroll configuration of %(company)s. A company "
"must always keep at least one configuration."
msgstr ""
"ທ່ານບໍ່ສາມາດລຶບການຕັ້ງຄ່າບັນຊີເງິນເດືອນອັນດຽວຂອງ %(company)s ໄດ້. "
"ບໍລິສັດຕ້ອງມີການຕັ້ງຄ່າຢ່າງໜ້ອຍໜຶ່ງອັນສະເໝີ."

#. module: hr_payroll
#. odoo-python
#: code:addons/hr_payroll/models/hr_work_entry_type.py:0
