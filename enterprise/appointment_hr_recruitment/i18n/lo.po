#. module: appointment_hr_recruitment
#: model:ir.module.module,description:base.module_appointment_hr_recruitment
msgid ""
"\n"
"Keeps track of all appointments related to applicants.\n"
msgstr ""
"\n"
"ຕິດຕາມການນັດໝາຍທັງໝົດທີ່ກ່ຽວຂ້ອງກັບຜູ້ສະໝັກ.\n"

#. module: appointment_hr_recruitment
#: model:mail.template,body_html:appointment_hr_recruitment.email_template_data_applicant_schedule_interview
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <h2>Hello,</h2>\n"
"    <div style=\"font-size: 13px;\">\n"
"        Thanks for your application and interest in <t t-"
"out=\"object.company_id.name or ''\">YourCompany</t>.<br>\n"
"        <br>\n"
"        I would like to organize a phone interview with you, it should last "
"about 30 min.\n"
"        We'll go through your resume and motivations to join the <t t-"
"out=\"object.company_id.name or ''\">YourCompany</t> team.\n"
"        You can book a slot in our agenda by cliking on the button below."
"<br>\n"
"    </div>\n"
"    <br>\n"
"    <a t-att-href=\"object._get_interview_invite_url()\" t-attf-"
"style=\"background-color: {{user.company_id.email_secondary_color or "
"'#875A7B'}}; text-decoration: none; color: "
"{{user.company_id.email_primary_color or '#FFFFFF'}}; padding: 8px 16px 8px "
"16px; border-radius: 5px;\">Schedule my interview</a><br>\n"
"    <br>\n"
"    Best regards,\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <h2>ສະບາຍດີ,</h2>\n"
"    <div style=\"font-size: 13px;\">\n"
"        ຂອບໃຈສຳລັບການສະໝັກ ແລະ ຄວາມສົນໃຈຂອງທ່ານຕໍ່ກັບ <t t-"
"out=\"object.company_id.name or ''\">YourCompany</t>.<br>\n"
"        <br>\n"
"        ພວກເຮົາຢາກຂໍນັດສຳພາດທາງໂທລະສັບກັບທ່ານ, ເຊິ່ງຈະໃຊ້ເວລາປະມານ 30 ນາທີ.\n"
"        ພວກເຮົາຈະກວດເບິ່ງຊີວະປະຫວັດ ແລະ ແຮງຈູງໃຈຂອງທ່ານໃນການເຂົ້າຮ່ວມທີມງານ <t t-"
"out=\"object.company_id.name or ''\">YourCompany</t>.\n"
"        ທ່ານສາມາດເລືອກຈອງເວລາໃນຕາຕະລາງຂອງພວກເຮົາໄດ້ ໂດຍການກົດປຸ່ມຂ້າງລຸ່ມນີ້.<br>\n"
"    </div>\n"
"    <br>\n"
"    <a t-att-href=\"object._get_interview_invite_url()\" t-attf-"
"style=\"background-color: {{user.company_id.email_secondary_color or "
"'#875A7B'}}; text-decoration: none; color: {"
"{user.company_id.email_primary_color or '#FFFFFF'}}; padding: 8px 16px 8px "
"16px; border-radius: 5px;\">ກຳນົດເວລານັດສຳພາດຂອງຂ້ອຍ</a><br>\n"
"    <br>\n"
"    ດ້ວຍຄວາມນັບຖື,\n"
"</div>\n"
"        "

#. module: appointment_hr_recruitment
#: model_terms:ir.ui.view,arch_db:appointment_hr_recruitment.appointment_applicant_link_expired
msgid ""
"<i class=\"oi\" data-icon=\"info\"/>\n"
"                    It may have expired because your application process has "
"already been completed or closed."
msgstr ""
"<i class=\"oi\" data-icon=\"info\"/>\n"
"                    ລິ້ງອາດຈະໝົດອາຍຸແລ້ວ ເນື່ອງຈາກຂະບວນການສະໝັກຂອງທ່ານໄດ້ສຳເລັດ ຫຼື ຖືກປິດໄປ"
"ແລ້ວ."

#. module: appointment_hr_recruitment
#: model:ir.model,name:appointment_hr_recruitment.model_hr_applicant
msgid "Applicant"
msgstr "ຜູ້ສະໝັກ"

#. module: appointment_hr_recruitment
#: model:ir.model,website_form_label:appointment_hr_recruitment.model_hr_applicant
msgid "Apply for a Job"
msgstr "ສະໝັກວຽກ"

#. module: appointment_hr_recruitment
#: model:mail.template,subject:appointment_hr_recruitment.email_template_data_applicant_schedule_interview
msgid ""
"Can we plan an interview together for your {{ (object.job_id.name + ' ') if "
"object.job_id else '' }}application?"
msgstr ""
"ພວກເຮົາສາມາດນັດໝາຍເວລາສຳພາດຮ່ວມກັນສຳລັບການສະໝັກ {{ (object.job_id.name + ' ') if "
"object.job_id else '' }}ຂອງທ່ານໄດ້ບໍ່?"

#. module: appointment_hr_recruitment
#: model:ir.model.fields,field_description:appointment_hr_recruitment.field_hr_applicant__display_name
msgid "Display Name"
msgstr "ຊື່ສະແດງ"

#. module: appointment_hr_recruitment
#: model:ir.model.fields,field_description:appointment_hr_recruitment.field_hr_applicant__id
msgid "ID"
msgstr "ID"

#. module: appointment_hr_recruitment
#: model_terms:ir.ui.view,arch_db:appointment_hr_recruitment.appointment_applicant_link_expired
msgid ""
"If you believe this is a mistake or have questions, feel free to reply to "
"the\n"
"                    original email or contact the recruitment team directly."
msgstr ""
"ຖ້າຫາກທ່ານຄິດວ່າມີຂໍ້ຜິດພາດ ຫຼື ມີຄຳຖາມ, ທ່ານສາມາດຕອບກັບ\n"
"                    ອີເມວຕົ້ນສະບັບ ຫຼື ຕິດຕໍ່ທີມງານຮັບສະໝັກພະນັກງານໂດຍກົງໄດ້ເລີຍ."

#. module: appointment_hr_recruitment
#: model:ir.model.fields,field_description:appointment_hr_recruitment.field_hr_applicant__interview_invite_code
msgid "Interview Invite Code"
msgstr "ລະຫັດເຊີນສຳພາດ"

#. module: appointment_hr_recruitment
#: model_terms:ir.ui.view,arch_db:appointment_hr_recruitment.appointment_applicant_link_expired
msgid "Interview Link Unavailable"
msgstr "ລິ້ງສຳພາດບໍ່ພ້ອມໃຊ້ງານ"

#. module: appointment_hr_recruitment
#: model:appointment.type,name:appointment_hr_recruitment.appointment_type_interviews
msgid "Interviews availabilities"
msgstr "ຊ່ວງເວລາຫວ່າງສຳລັບການສຳພາດ"

#. module: appointment_hr_recruitment
#: model:ir.module.module,summary:base.module_appointment_hr_recruitment
msgid "Keep track of recruitment appointments"
msgstr "ຕິດຕາມການນັດໝາຍຮັບສະໝັກພະນັກງານ"

#. module: appointment_hr_recruitment
#: model:ir.module.module,shortdesc:base.module_appointment_hr_recruitment
msgid "Recruitment tracking on appointments"
msgstr "ການຕິດຕາມການຮັບສະໝັກພະນັກງານໃນການນັດໝາຍ"

#. module: appointment_hr_recruitment
#: model:mail.template,name:appointment_hr_recruitment.email_template_data_applicant_schedule_interview
msgid "Recruitment: Schedule interview"
msgstr "ການຮັບສະໝັກພະນັກງານ: ກຳນົດເວລານັດສຳພາດ"

#. module: appointment_hr_recruitment
#: model:mail.template,description:appointment_hr_recruitment.email_template_data_applicant_schedule_interview
msgid ""
"Send this email when you want to schedule an interview with an applicant"
msgstr "ສົ່ງອີເມວນີ້ເມື່ອທ່ານຕ້ອງການກຳນົດເວລານັດສຳພາດກັບຜູ້ສະໝັກ"

#. module: appointment_hr_recruitment
#: model_terms:ir.ui.view,arch_db:appointment_hr_recruitment.appointment_applicant_link_expired
msgid "This interview is no longer active"
msgstr "ການສຳພາດນີ້ບໍ່ໄດ້ເປີດໃຊ້ງານອີກຕໍ່ໄປ"
