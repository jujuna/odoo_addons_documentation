<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Monthly VAT return, due by the 20th of the following month (Law on VAT No. 60/NA, art. 30.2 and 31.2). -->
        <record id="la_tax_return_type" model="account.return.type">
            <field name="name">VAT Return (01/ອມພ)</field>
            <field name="name@lo_LA">ໃບແຈ້ງ-ມອບອາກອນມູນຄ່າເພີ່ມ (01/ອມພ)</field>
            <field name="report_id" ref="l10n_la.l10n_la_tax_report"/>
            <field name="country_id" ref="base.la"/>
            <field name="states_workflow">generic_state_tax_report</field>
            <field name="default_deadline_periodicity">monthly</field>
            <field name="default_deadline_days_delay">20</field>
        </record>
    </data>
</odoo>
