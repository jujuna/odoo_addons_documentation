#. module: appointment_hr
#: model:ir.model.fields,field_description:appointment_hr.field_appointment_type__work_hours_activated
msgid "Employee Schedule"
msgstr "ຕາຕະລາງເວລາພະນັກງານ"

#. module: appointment_hr
#: model:ir.module.module,shortdesc:base.module_appointment_hr
msgid "Employees on Appointments"
msgstr "ພະນັກງານໃນການນັດໝາຍ"

#. module: appointment_hr
#: model:ir.model.fields,field_description:appointment_hr.field_appointment_type__id
