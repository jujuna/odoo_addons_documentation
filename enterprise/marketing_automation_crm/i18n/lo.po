msgid "ID"
msgstr "ID"

#. module: marketing_automation_crm
#. odoo-python
#: code:addons/marketing_automation_crm/models/marketing_campaign.py:0
msgid ""
"If lead is created for existing contact, schedule a call with their "
"salesperson."
msgstr ""
"ຖ້າຫາກສ້າງລູກຄ້າເປົ້າໝາຍສຳລັບຜູ້ຕິດຕໍ່ທີ່ມີຢູ່ແລ້ວ, ໃຫ້ກຳນົດເວລາໂທກັບພະນັກງານຂາຍຂອງພວກເຂົາ."

#. module: marketing_automation_crm
#. odoo-python
#: code:addons/marketing_automation_crm/models/marketing_campaign.py:0
msgid "If not opened, priority = 0"
msgstr "ຖ້າບໍ່ໄດ້ເປີດ, ບູລິມະສິດ = 0"

#. module: marketing_automation_crm
#. odoo-python
#: code:addons/marketing_automation_crm/models/marketing_campaign.py:0
msgid "If replied, assign 3 stars"
msgstr "ຖ້າຕອບກັບ, ໃຫ້ 3 ດາວ"

#. module: marketing_automation_crm
#: model:ir.model,name:marketing_automation_crm.model_marketing_campaign
msgid "Marketing Campaign"
msgstr "ແຄມເປນການຕະຫຼາດ"

#. module: marketing_automation_crm
#. odoo-python
#: code:addons/marketing_automation_crm/models/marketing_campaign.py:0
msgid "Next activity: Call"
msgstr "ກິດຈະກຳຕໍ່ໄປ: ໂທ"

#. module: marketing_automation_crm
#. odoo-python
#: code:addons/marketing_automation_crm/models/marketing_campaign.py:0
msgid "Not Opened, Low Priority"
msgstr "ບໍ່ໄດ້ເປີດ, ບູລິມະສິດຕໍ່າ"

#. module: marketing_automation_crm
#. odoo-python
#: code:addons/marketing_automation_crm/models/marketing_campaign.py:0
msgid "Prioritize Hot Leads"
msgstr "ໃຫ້ບູລິມະສິດແກ່ລູກຄ້າເປົ້າໝາຍທີ່ມີຄວາມສົນໃຈສູງ"

#. module: marketing_automation_crm
#. odoo-python
#: code:addons/marketing_automation_crm/models/marketing_campaign.py:0
msgid "Replied High Priority"
msgstr "ຕອບກັບແລ້ວ ບູລິມະສິດສູງ"

#. module: marketing_automation_crm
#. odoo-python
#: code:addons/marketing_automation_crm/models/marketing_campaign.py:0
msgid "Schedule Call"
msgstr "ກຳນົດເວລາໂທ"

#. module: marketing_automation_crm
#. odoo-python
#: code:addons/marketing_automation_crm/models/marketing_campaign.py:0
msgid "Schedule Calls"
msgstr "ກຳນົດເວລາການໂທ"

#. module: marketing_automation_crm
#. odoo-python
#: code:addons/marketing_automation_crm/models/marketing_campaign.py:0
msgid "Send Email"
msgstr "ສົ່ງອີເມວ"

#. module: marketing_automation_crm
#. odoo-python
#: code:addons/marketing_automation_crm/models/marketing_campaign.py:0
msgid ""
"Send an email to new leads and assign them a high priority if they open it."
msgstr ""
"ສົ່ງອີເມວຫາລູກຄ້າເປົ້າໝາຍໃໝ່ ແລະ ກຳນົດບູລິມະສິດສູງໃຫ້ພວກເຂົາ ຖ້າຫາກພວກເຂົາເປີດອ່ານ."

#. module: marketing_automation_crm
#. odoo-python
#: code:addons/marketing_automation_crm/models/marketing_campaign.py:0
msgid "Send welcome Email"
msgstr "ສົ່ງອີເມວຕ້ອນຮັບ"

#. module: marketing_automation_crm
#. odoo-python
