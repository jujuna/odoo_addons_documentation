#. module: whatsapp_pos_self_order
#: model:ir.module.module,description:base.module_whatsapp_pos_self_order
msgid ""
"Integrates POS Self Order with WhatsApp to send customers order confirmation "
"and receipt."
msgstr ""
"ເຊື່ອມໂຍງ POS ສັ່ງຊື້ດ້ວຍຕົນເອງ ກັບ WhatsApp ເພື່ອສົ່ງການຢືນຢັນການສັ່ງຊື້ ແລະ ໃບຮັບເງິນໃຫ້ລູກຄ້າ."

#. module: whatsapp_pos_self_order
#: model_terms:ir.ui.view,arch_db:whatsapp_pos_self_order.view_pos_preset_form_inherit_whatsapp_pos_self_order
msgid "None"
msgstr "ບໍ່ມີ"

#. module: whatsapp_pos_self_order
#: model:ir.model,name:whatsapp_pos_self_order.model_pos_order
msgid "Point of Sale Order"
msgstr "ລາຍການສັ່ງຊື້ຈຸດຂາຍໜ້າຮ້ານ"

#. module: whatsapp_pos_self_order
#: model_terms:ir.ui.view,arch_db:whatsapp_pos_self_order.view_pos_preset_form_inherit_whatsapp_pos_self_order
msgid "WhatsApp Confirmation"
msgstr "ການຢືນຢັນຜ່ານ WhatsApp"

#. module: whatsapp_pos_self_order
#: model:ir.module.module,shortdesc:base.module_whatsapp_pos_self_order
msgid "WhatsApp PoS Self Order"
msgstr "ການສັ່ງຊື້ດ້ວຍຕົນເອງ PoS ຜ່ານ WhatsApp"

#. module: whatsapp_pos_self_order
#: model:ir.model.fields,field_description:whatsapp_pos_self_order.field_pos_preset__whatsapp_receipt_template_id
msgid "WhatsApp Receipt template"
msgstr "ແບບຟອມໃບຮັບເງິນ WhatsApp"

#. module: whatsapp_pos_self_order
#: model:ir.model.fields,help:whatsapp_pos_self_order.field_pos_preset__whatsapp_receipt_template_id
msgid ""
"WhatsApp template used to send the order receipt to the customer after a "
"successful self order."
msgstr ""
"ແບບຟອມ WhatsApp ທີ່ນຳໃຊ້ເພື່ອສົ່ງໃບຮັບເງິນການສັ່ງຊື້ໄປໃຫ້ລູກຄ້າ ຫຼັງຈາກການສັ່ງຊື້ດ້ວຍຕົນເອງສຳເລັດ."
