<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-name="stock_barcode.barcode_generate_lot_dialog">
        <Dialog title="this.title" contentClass="'o_stock_barcode_confirm_quant_dialog'" fullscreen="this.ui.isSmall">
            <div class="o_form_view o_form_nosheet">
                <div class="container">
                    <div class="row mb-2">
                        <div class="col" >
                            <div class="form-check" t-on-click="() => this.generationMode.set('only_one')">
                                <input id="mode_one" class="form-check-input" type="radio" value="only_one" t-model="this.generationMode"/>
                                <label class="o_form_label" for="mode_one" >Only One</label>
                            </div>
                        </div>
                        <div class="col">
                            <div class="form-check" t-on-click="() => this.generationMode.set('all')">
                                <input id="mode_all" class="form-check-input" type="radio" name="generationMode" value="all" t-model="this.generationMode"/>
                                <label class="o_form_label" for="mode_all">All</label>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-4">
                            <label class="o_form_label" for="next_serial_0">
                                <t t-if="this.isLotTracking &amp;&amp; this.generationMode() === 'only_one'">Lot Number</t>
                                <t t-elif="this.isLotTracking &amp;&amp; this.generationMode() === 'all'">First Lot Number</t>
                                <t t-elif="!this.isLotTracking &amp;&amp; this.generationMode() === 'only_one'">Serial Number</t>
                                <t t-elif="!this.isLotTracking &amp;&amp; this.generationMode() === 'all'">First Serial Number</t>
                            </label>
                        </div>
                        <div class="col-8">
                            <div name="next_serial" class="o_field_widget o_field_char">
                                <input class="o_input" t-model="this.nextSerial" id="next_serial_0" type="text" placeholder="e.g. LOT-PR-00012"/>
                            </div>
                        </div>
                    </div>

                    <div t-if="this.isLotTracking || this.generationMode() !== 'only_one'" class="row mb-2">
                        <div class="col-4">
                            <label class="o_form_label" for="total_received_0">
                                <t t-if="this.isLotTracking">Quantity Received</t>
                                <t t-else="">Number of SN</t>
                            </label>
                        </div>
                        <div class="col-8">
                            <div name="total_received" class="o_field_widget o_field_integer">
                                <input inputmode="numeric" min="1" t-model="this.qtyReceived" class="o_input" id="total_received_0" type="number"/>
                            </div>
                            <span t-if="this.props.model.groups.group_uom" t-out="this.props.line.uom_id.name"/>
                        </div>
                    </div>

                    <div class="row mb-2" t-if="this.isLotTracking &amp;&amp; this.generationMode() !== 'only_one'">
                        <div class="col-4">
                            <label class="o_form_label" for="next_serial_count_0">Quantity per Lot</label>
                        </div>
                        <div class="col-8">
                            <div name="next_serial_count" class="o_field_widget o_field_integer">
                                <input inputmode="numeric" min="1" t-model="this.qtyPerLot" class="o_input" id="next_serial_count_0" type="number"/>
                            </div>
                            <span t-if="this.isLotTracking &amp;&amp; this.props.model.groups.group_uom" t-out="this.props.line.uom_id.name"/>
                        </div>
                    </div>
                </div>
            </div>
            <t t-set-slot="footer">
                <div class="o_barcode_control o_action_buttons d-inline-flex w-100" t-if="this.ui.isSmall">
                    <button class="btn btn-lg btn-primary py-3 flex-grow-1 d-flex align-items-center justify-content-center m-1" t-on-click="this._onValidate">Validate</button>
                    <button class="btn btn-lg btn-secondary py-3 flex-grow-1 d-flex align-items-center justify-content-center m-1" t-on-click="this.props.close">Discard</button>
                </div>
                <t t-else="">
                    <button class="o_confirm btn btn-primary" t-on-click="this._onValidate">Validate</button>
                    <button class="o_cancel btn btn-secondary" t-on-click="this.props.close">Discard</button>
                </t>
            </t>
        </Dialog>
    </t>
</templates>
