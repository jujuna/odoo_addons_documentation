#: code:addons/stock_barcode/static/src/models/barcode_picking_batch_model.js:0
msgid "%(nbr_of_picking)s pickings"
msgstr "%(nbr_of_picking)s ລາຍການເບີກ"

#. module: stock_barcode
#. odoo-javascript
#: code:addons/stock_barcode/static/src/js/stock_barcode_sml_form.js:0
