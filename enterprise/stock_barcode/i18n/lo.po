#: code:addons/stock_barcode/static/src/models/barcode_picking_model.js:0
msgid "You are supposed to scan %s or another source location"
msgstr "ທ່ານຄວນສະແກນ %s ຫຼື ສະຖານທີ່ຕົ້ນທາງອື່ນ"

#. module: stock_barcode
#. odoo-javascript
#: code:addons/stock_barcode/static/src/models/barcode_picking_model.js:0
msgid "You can't apply a package type. First, scan product or select a line"
msgstr ""
"ທ່ານບໍ່ສາມາດນຳໃຊ້ປະເພດຫີບຫໍ່ໄດ້. ກະລຸນາສະແກນສິນຄ້າ ຫຼື ເລືອກແຖວລາຍການກ່ອນ"

#. module: stock_barcode
#. odoo-javascript
#: code:addons/stock_barcode/static/src/models/barcode_picking_model.js:0
msgid "You can't register scrap at this state of the operation"
msgstr "ທ່ານບໍ່ສາມາດບັນທຶກສິນຄ້າເສຍຫາຍໃນສະຖານະນີ້ຂອງການດຳເນີນງານໄດ້"

#. module: stock_barcode
#. odoo-python
#: code:addons/stock_barcode/models/stock_picking.py:0
msgid ""
"You cannot validate a transfer if no quantities are reserved nor done. You "
"can use the info button on the top right corner of your screen to remove the "
"transfer in question from the batch."
msgstr ""
"ທ່ານບໍ່ສາມາດຢັ້ງຢືນການໂອນຍ້າຍໄດ້ ຖ້າບໍ່ມີຈຳນວນທີ່ຖືກຈອງ ຫຼື ເຮັດສຳເລັດແລ້ວ. ທ່ານສາມາດໃຊ້ປຸ່ມຂໍ້ມູນຢູ່ມຸມຂວາ"
"ເທິງຂອງໜ້າຈໍ ເພື່ອລຶບການໂອນຍ້າຍດັ່ງກ່າວອອກຈາກຊຸດງານ."

#. module: stock_barcode
#. odoo-javascript
#: code:addons/stock_barcode/static/src/models/barcode_picking_model.js:0
msgid ""
"You have already scanned %s items of this package. Do you want to scan the "
"whole package?"
msgstr ""
"ທ່ານໄດ້ສະແກນສິນຄ້າໃນຫີບຫໍ່ນີ້ແລ້ວ %s ລາຍການ. ທ່ານຕ້ອງການສະແກນທັງໝົດຫີບຫໍ່ບໍ່?"

#. module: stock_barcode
#: model_terms:ir.ui.view,arch_db:stock_barcode.view_backorder_confirmation
msgid "You have processed less products than the initial demand:"
msgstr "ທ່ານໄດ້ດຳເນີນການສິນຄ້າໜ້ອຍກວ່າຈຳນວນຄວາມຕ້ອງການເບື້ອງຕົ້ນ:"

#. module: stock_barcode
#. odoo-javascript
#: code:addons/stock_barcode/static/src/models/barcode_picking_model.js:0
msgid "You must scan a package or put in pack"
msgstr "ທ່ານຕ້ອງສະແກນຫີບຫໍ່ ຫຼື ບັນຈຸໃສ່ຫີບຫໍ່"

#. module: stock_barcode
#. odoo-javascript
#: code:addons/stock_barcode/static/src/models/barcode_picking_model.js:0
msgid "You must scan a product"
msgstr "ທ່ານຕ້ອງສະແກນສິນຄ້າ"

#. module: stock_barcode
#. odoo-javascript
#: code:addons/stock_barcode/static/src/components/main.xml:0
msgid "You scanned"
msgstr "ທ່ານໄດ້ສະແກນ"

#. module: stock_barcode
#. odoo-javascript
#: code:addons/stock_barcode/static/src/models/barcode_model.js:0
msgid ""
"You still have unassigned quantities for product %(product)s. Scan a lot to "
"assign them before scanning another product."
msgstr ""
"ທ່ານຍັງມີຈຳນວນທີ່ຍັງບໍ່ໄດ້ກຳນົດສຳລັບສິນຄ້າ %(product)s. ກະລຸນາສະແກນຊຸດຜະລິດເພື່ອກຳນົດຈຳນວນກ່ອນທີ່ຈະ"
"ສະແກນສິນຄ້າອື່ນ."

#. module: stock_barcode
#. odoo-javascript
#: code:addons/stock_barcode/static/src/components/barcode_generate_serial.xml:0
msgid "e.g. LOT-PR-00012"
msgstr "ຕົວຢ່າງ: LOT-PR-00012"

#. module: stock_barcode
#. odoo-javascript
#: code:addons/stock_barcode/static/src/components/main.xml:0
msgid "of"
msgstr "ຈາກ"

#. module: stock_barcode
#: model_terms:ir.ui.view,arch_db:stock_barcode.view_backorder_confirmation
msgid "products were not processed at all."
msgstr "ສິນຄ້າບໍ່ໄດ້ຮັບການປະມວນຜົນເລີຍ."

#. module: stock_barcode
#: model_terms:ir.ui.view,arch_db:stock_barcode.view_backorder_confirmation
msgid "products were partially processed."
msgstr "ສິນຄ້າໄດ້ຮັບການປະມວນຜົນບາງສ່ວນ."
