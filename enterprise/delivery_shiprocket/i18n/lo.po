#. module: delivery_shiprocket
#: model_terms:ir.ui.view,arch_db:delivery_shiprocket.view_delivery_carrier_form_inherit_delivery_shiprocket
msgid "<b>Click on Add a New Channel</b>"
msgstr "<b>ກົດໃສ່ ເພີ່ມຊ່ອງທາງໃໝ່</b>"

#. module: delivery_shiprocket
#: model_terms:ir.ui.view,arch_db:delivery_shiprocket.view_delivery_carrier_form_inherit_delivery_shiprocket
msgid ""
"<b>Copy your API User's Email and Password and paste into Delivery method's "
"configuration.</b>"
msgstr ""
"<b>ສຳເນົາອີເມວ ແລະ ລະຫັດຜ່ານຂອງຜູ້ໃຊ້ງານ API ຂອງທ່ານ ແລ້ວນຳໄປວາງໃສ່ໃນການຕັ້ງຄ່າວິທີການຈັດສົ່"
"ງ.</b>"

#. module: delivery_shiprocket
#: model_terms:ir.ui.view,arch_db:delivery_shiprocket.view_delivery_carrier_form_inherit_delivery_shiprocket
msgid ""
"<b>Fill the details and Click on Save Channel &amp; Test Connection button.</"
"b>"
msgstr ""
"<b>ຕື່ມລາຍລະອຽດ ແລ້ວກົດໃສ່ປຸ່ມ ບັນທຶກຊ່ອງທາງ &amp; ທົດສອບການເຊື່ອມຕໍ່.</b>"

#. module: delivery_shiprocket
#: model_terms:ir.ui.view,arch_db:delivery_shiprocket.view_delivery_carrier_form_inherit_delivery_shiprocket
msgid ""
"<b>In Odoo configuration click on <i class=\"oi oe_inline\" data-"
"icon=\"refresh\"/> icon near Shiprocket Channel to sync newly created "
"channels.</b>"
msgstr ""
"<b>ໃນການຕັ້ງຄ່າ Odoo ໃຫ້ກົດໃສ່ໄອຄອນ <i class=\"oi oe_inline\" data-"
"icon=\"refresh\"/> ໃກ້ກັບຊ່ອງທາງ Shiprocket ເພື່ອຊິ້ງຊ່ອງທາງທີ່ສ້າງຂຶ້ນໃໝ່.</b>"

#. module: delivery_shiprocket
#: model_terms:ir.ui.view,arch_db:delivery_shiprocket.view_delivery_carrier_form_inherit_delivery_shiprocket
msgid "<b>Now click on Add for MANUAL</b>"
msgstr "<b>ຕອນນີ້ໃຫ້ກົດໃສ່ ເພີ່ມສຳລັບ MANUAL</b>"

#. module: delivery_shiprocket
#: model_terms:ir.ui.view,arch_db:delivery_shiprocket.view_delivery_carrier_form_inherit_delivery_shiprocket
msgid ""
"<b>Once your account is created, go to Settings &gt; API &gt; Configure. </"
"b>\n"
"                                <b>You can add new API User from the right "
"side of the page.</b>\n"
"                                <br/>"
msgstr ""
"<b>ເມື່ອບັນຊີຂອງທ່ານຖືກສ້າງແລ້ວ, ໃຫ້ໄປທີ່ ການຕັ້ງຄ່າ &gt; API &gt; ກຳນົດຄ່າ. </b>\n"
"                                <b>ທ່ານສາມາດເພີ່ມຜູ້ໃຊ້ງານ API ໃໝ່ໄດ້ຈາກເບື້ອງຂວາຂອງໜ້"
"າ.</b>\n"
"                                <br/>"

#. module: delivery_shiprocket
#: model_terms:ir.ui.view,arch_db:delivery_shiprocket.view_delivery_carrier_form_inherit_delivery_shiprocket
msgid "<b>To Create a channel, Go to Shiprocket Channels</b>"
msgstr "<b>ເພື່ອສ້າງຊ່ອງທາງ, ໃຫ້ໄປທີ່ ຊ່ອງທາງ Shiprocket</b>"

#. module: delivery_shiprocket
#: model_terms:ir.ui.view,arch_db:delivery_shiprocket.view_delivery_carrier_form_inherit_delivery_shiprocket
msgid ""
"<i class=\"oi\" data-icon=\"warning\"/> In test environment, to avoid "
"charges, your shippings are automatically <b>cancelled</b> after the label "
"creation. The amount of cancelled shipment will be returned in next 3-4 days."
msgstr ""
"<i class=\"oi\" data-icon=\"warning\"/> ໃນສະພາບແວດລ້ອມທົດສອບ, ເພື່ອຫຼີກລ່ຽງຄ່າທຳນຽມ, "
"ການຈັດສົ່ງຂອງທ່ານຈະຖືກ <b>ຍົກເລີກ</b> ໂດຍອັດຕະໂນມັດ ຫຼັງຈາກສ້າງປ້າຍຕິດ. ຈຳນວນເງິນຂອງການຈັດສົ່ງທີ່"
"ຖືກຍົກເລີກຈະຖືກສົ່ງຄືນພາຍໃນ 3-4 ວັນຕໍ່ໜ້າ."

#. module: delivery_shiprocket
#: model:ir.model.fields,help:delivery_shiprocket.field_delivery_carrier__shiprocket_manifests_generate
msgid ""
"A manifest is a document that is required by some carriers to streamline the "
"pickup process.particularly when shipping out a high-volume of ecommerce "
"orders."
msgstr ""
"Manifest ແມ່ນເອກະສານທີ່ຜູ້ໃຫ້ບໍລິການຂົນສົ່ງບາງລາຍຕ້ອງການ ເພື່ອເຮັດໃຫ້ຂັ້ນຕອນການເຂົ້າຮັບສິນຄ້າມີຄວາມສະ"
"ດວກວ່ອງໄວຂຶ້ນ ໂດຍສະເພາະເມື່ອມີການຈັດສົ່ງຄຳສັ່ງຊື້ອີຄອມເມີຊຈຳນວນຫຼາຍ."

