#. module: stock_barcode_quality_control
#: model:ir.module.module,description:base.module_stock_barcode_quality_control
msgid ""
"\n"
"This bridge module is auto-installed when the modules stock_barcode and "
"quality_control are installed.\n"
msgstr ""
"\n"
"ໂມດູນເຊື່ອມຕໍ່ນີ້ຈະຖືກຕິດຕັ້ງໂດຍອັດຕະໂນມັດ ເມື່ອໂມດູນ stock_barcode ແລະ quality_control ຖືກຕິດຕັ້"
"ງແລ້ວ.\n"

#. module: stock_barcode_quality_control
#. odoo-javascript
#: code:addons/stock_barcode_quality_control/static/src/models/barcode_picking_model.js:0
msgid "All the quality checks have been done"
msgstr "ການກວດສອບຄຸນນະພາບທັງໝົດແມ່ນສຳເລັດແລ້ວ"

#. module: stock_barcode_quality_control
#: model:ir.module.module,summary:base.module_stock_barcode_quality_control
msgid "Allows the usage of quality checks within the barcode views"
msgstr "ອະນຸຍາດໃຫ້ນຳໃຊ້ການກວດສອບຄຸນນະພາບພາຍໃນໜ້າບາໂຄດ"

#. module: stock_barcode_quality_control
#: model:ir.module.module,shortdesc:base.module_stock_barcode_quality_control
msgid "Barcode Quality bridge module"
msgstr "ໂມດູນເຊື່ອມຕໍ່ລະບົົບບາໂຄດ ແລະ ຄຸນນະພາບ"

#. module: stock_barcode_quality_control
#: model:ir.model,name:stock_barcode_quality_control.model_stock_picking_batch
