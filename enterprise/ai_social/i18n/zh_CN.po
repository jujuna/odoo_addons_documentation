#. module: ai_social
#: model:ir.actions.server,ai_tool_description:ai_social.ir_actions_server_add_human
msgid ""
"\n"
"            Adds an available human operator to the current conversation\n"
"            and stops the AI agent from handling new user messages.\n"
"            Use this tool when the user asks for a human,\n"
"            or when the conversation must be escalated to a person.\n"
"            If no operator is available, the AI agent remains in the "
"conversation.\n"
"        "
msgstr ""
"\n"
"            向当前对话添加一名可用的人工客服，\n"
"            并停止 AI 代理处理新的用户消息。\n"
"            当用户要求人工服务，\n"
"            或对话必须转接给真人时，使用此工具。\n"
"            如果没有可用的客服人员，AI 代理将继续留在对话中。\n"
"        "

#. module: ai_social
#. odoo-python
#: code:addons/ai_social/models/ai_agent.py:0
msgid ""
"A human operator has been added to the conversation. Let the user know that "
"a human will take over."
msgstr "已向对话添加一名人工客服。请告知用户将有真人接管。"

