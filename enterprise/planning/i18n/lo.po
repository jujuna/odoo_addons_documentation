#. module: planning
#. odoo-python
#: code:addons/planning/models/planning_slot.py:0
msgid "You are not allowed to reset shifts to draft."
msgstr "ທ່ານບໍ່ໄດ້ຮັບອະນຸຍາດໃຫ້ຕັ້ງຄ່າຜັດວຽກກັບເປັນສະບັບຮ່າງ."

#. module: planning
#. odoo-python
#: code:addons/planning/models/planning_slot.py:0
msgid "You can not assign yourself to an already assigned shift."
msgstr "ທ່ານບໍ່ສາມາດເລືອກຮັບຜັດວຽກທີ່ມີການມອບໝາຍແລ້ວ."

#. module: planning
#. odoo-python
#: code:addons/planning/models/planning_slot.py:0
msgid "You can not unassign another employee than yourself."
msgstr "ທ່ານບໍ່ສາມາດຍົກເລີກການມອບໝາຍພະນັກງານຄົນອື່ນນອກຈາກຕົນເອງໄດ້."

#. module: planning
#. odoo-python
#: code:addons/planning/models/planning_slot.py:0
msgid "You cannot assign yourself to a shift belonging to another company."
msgstr "ທ່ານບໍ່ສາມາດເລືອກຮັບຜັດວຽກທີ່ຂຶ້ນກັບບໍລິສັດອື່ນໄດ້."

#. module: planning
#. odoo-python
#: code:addons/planning/models/planning_slot.py:0
msgid "You cannot assign yourself to a shift in the past."
msgstr "ທ່ານບໍ່ສາມາດເລືອກຮັບຜັດວຽກທີ່ຜ່ານມາແລ້ວໃນອະດີດ."

#. module: planning
#. odoo-python
#: code:addons/planning/models/planning_slot.py:0
msgid "You cannot cancel a request to switch made by another user."
msgstr "ທ່ານບໍ່ສາມາດຍົກເລີກຄຳຮ້ອງຂໍປ່ຽນຜັດທີ່ສ້າງຂຶ້ນໂດຍຜູ້ໃຊ້ອື່ນໄດ້."

#. module: planning
#. odoo-python
#: code:addons/planning/models/planning_slot.py:0
msgid "You cannot cancel a request to switch that is in the past."
msgstr "ທ່ານບໍ່ສາມາດຍົກເລີກຄຳຮ້ອງຂໍປ່ຽນຜັດທີ່ຜ່ານມາແລ້ວໃນອະດີດ."

#. module: planning
#. odoo-python
#: code:addons/planning/models/planning_slot.py:0
msgid "You cannot request to switch a shift that is assigned to another user."
msgstr "ທ່ານບໍ່ສາມາດຮ້ອງຂໍປ່ຽນຜັດວຽກທີ່ຖືກມອບໝາຍໃຫ້ກັບຜູ້ໃຊ້ອື່ນໄດ້."

#. module: planning
#. odoo-python
#: code:addons/planning/models/planning_slot.py:0
msgid "You cannot switch a shift that is in the past."
msgstr "ທ່ານບໍ່ສາມາດປ່ຽນຜັດວຽກທີ່ຜ່ານມາແລ້ວໃນອະດີດ."

#. module: planning
#. odoo-python
#: code:addons/planning/models/planning_slot.py:0
msgid "You cannot unassign yourself from a shift in the past."
msgstr "ທ່ານບໍ່ສາມາດຍົກເລີກການຮັບຜັດວຽກທີ່ຜ່ານມາແລ້ວໃນອະດີດ."

#. module: planning
#. odoo-python
#: code:addons/planning/models/planning_slot.py:0
msgid "You don't have the right to assign yourself to shifts."
msgstr "ທ່ານບໍ່ມີສິດໃນການເລືອກຮັບຜັດວຽກດ້ວຍຕົນເອງ."

#. module: planning
#. odoo-python
#: code:addons/planning/models/planning_slot.py:0
msgid "You don't have the right to cancel a request to switch."
msgstr "ທ່ານບໍ່ມີສິດໃນການຍົກເລີກຄຳຮ້ອງຂໍປ່ຽນຜັດວຽກ."

#. module: planning
#. odoo-python
#: code:addons/planning/models/planning_slot.py:0
msgid "You don't have the right to switch shifts."
msgstr "ທ່ານບໍ່ມີສິດໃນການປ່ຽນຜັດວຽກ."

