#. module: planning
#: model:mail.template,body_html:planning.email_template_planning_planning
msgid ""
"<div>\n"
"                    <p t-if=\"ctx.get('employee')\">Dear <t t-"
"out=\"ctx['employee'].name or ''\">Anita Oliver</t>,</p>\n"
"                    <p t-else=\"\">Hello,</p>\n"
"                    <br/>\n"
"                    <p t-if=\"ctx.get('start_datetime') and "
"ctx.get('end_datetime')\">\n"
"                        Your upcoming shifts from <t t-"
"out=\"format_date(ctx['start_datetime'])\">05-05-2021</t>\n"
"                        to <t t-out=\"format_date(ctx['end_datetime'])"
"\">05-11-2021</t> have been published.\n"
"                    </p>\n"
"                    <div style=\"display: flex; margin: 15px;\">\n"
"                        <div t-if=\"ctx.get('planning_url')\" style=\"margin-"
"right: 15px;\">\n"
"                            <a t-att-href=\"ctx['planning_url']\" "
"target=\"_blank\" t-att-style=\"'font-size: 12px; color: ' + "
"(company.email_primary_color or '#FFFFFF') + '; background-color: ' + "
"(company.email_secondary_color or '#875A7B') + '; padding: 8px 12px 11px; "
"text-decoration: none !important; font-weight: bold;'\">\n"
"                                View Your Planning\n"
"                            </a>\n"
"                        </div>\n"
"                        <div t-if=\"ctx.get('planning_url_ics')\">\n"
"                            <a target=\"_blank\" t-att-"
"href=\"ctx['planning_url_ics']\" t-att-style=\"'font-size: 12px; color: ' + "
"(company.email_secondary_color or '#875A7B') + '; padding: 8px 12px 11px; "
"text-decoration: none !important; font-weight: bold;'\">\n"
"                                Add to Calendar\n"
"                            </a>\n"
"                        </div>\n"
"                    </div>\n"
"                    <br/>\n"
"                    <p t-if=\"ctx.get('planning_url') and "
"(ctx.get('slot_unassigned') or (object.allow_self_unassign and "
"object.self_unassign_days_before))\">\n"
"                        <t t-if=\"ctx.get('slot_unassigned')\">\n"
"                            We would also like to remind you that there are "
"some open shifts available, and if you are interested and available, please "
"assign yourself to those shifts.\n"
"                        </t>\n"
"                        <t t-if=\"object.allow_self_unassign and "
"object.self_unassign_days_before\">\n"
"                            If you are unable to work a shift that has been "
"assigned to you, please unassign yourself within <t t-"
"out=\"object.self_unassign_days_before or ''\">5</t> day(s) before the start "
"of the shift.\n"
"                        </t>\n"
"                    </p>\n"
"                    <p t-if=\"ctx.get('message')\" t-out=\"ctx['message']\"/"
">\n"
"                    <p t-if=\"ctx.get('is_internal_user') and not "
"object.allow_self_unassign\">In case your current schedule doesn't suit you, "
"we encourage you to reach out to your colleagues and request to switch "
"shifts. They might be interested in exchanging shifts with you.</p>\n"
"                </div>\n"
"            "
msgstr ""
"<div>\n"
"                    <p t-if=\"ctx.get('employee')\">ຮຽນ <t t-"
"out=\"ctx['employee'].name or ''\">Anita Oliver</t>,</p>\n"
"                    <p t-else=\"\">ສະບາຍດີ,</p>\n"
"                    <br/>\n"
"                    <p t-if=\"ctx.get('start_datetime') and ctx.get"
"('end_datetime')\">\n"
"                        ຜັດວຽກທີ່ຈະມາເຖິງຂອງທ່ານຕັ້ງແຕ່ <t t-out=\"format_date"
"(ctx['start_datetime'])\">05-05-2021</t>\n"
"                        ຫາ <t t-out=\"format_date(ctx['end_datetime'])\">05-"
"11-2021</t> ໄດ້ຖືກເຜີຍແຜ່ແລ້ວ.\n"
"                    </p>\n"
"                    <div style=\"display: flex; margin: 15px;\">\n"
"                        <div t-if=\"ctx.get('planning_url')\" style=\"margin-"
"right: 15px;\">\n"
"                            <a t-att-href=\"ctx['planning_url']\" "
"target=\"_blank\" t-att-style=\"'font-size: 12px; color: ' + "
"(company.email_primary_color or '#FFFFFF') + '; background-color: ' + "
"(company.email_secondary_color or '#875A7B') + '; padding: 8px 12px 11px; "
"text-decoration: none !important; font-weight: bold;'\">\n"
"                                ເບິ່ງແຜນວຽກຂອງທ່ານ\n"
"                            </a>\n"
"                        </div>\n"
"                        <div t-if=\"ctx.get('planning_url_ics')\">\n"
"                            <a target=\"_blank\" t-att-"
"href=\"ctx['planning_url_ics']\" t-att-style=\"'font-size: 12px; color: ' + "
"(company.email_secondary_color or '#875A7B') + '; padding: 8px 12px 11px; "
"text-decoration: none !important; font-weight: bold;'\">\n"
"                                ເພີ່ມໃສ່ປະຕິທິນ\n"
"                            </a>\n"
"                        </div>\n"
"                    </div>\n"
"                    <br/>\n"
"                    <p t-if=\"ctx.get('planning_url') and (ctx.get"
"('slot_unassigned') or (object.allow_self_unassign and "
"object.self_unassign_days_before))\">\n"
"                        <t t-if=\"ctx.get('slot_unassigned')\">\n"
"                            ພວກເຮົາຍັງຢາກແຈ້ງເຕືອນໃຫ້ທ່ານຊາບວ່າຍັງມີບາງຜັດວຽກທີ່ວ່າງຢູ່, ຖ້າທ່"
"ານສົນໃຈ ແລະ ວ່າງ, ກະລຸນາເລືອກລົງທະບຽນເຂົ້າຜັດວຽກເຫຼົ່ານັ້ນ.\n"
"                        </t>\n"
"                        <t t-if=\"object.allow_self_unassign and "
"object.self_unassign_days_before\">\n"
"                            ຖ້າທ່ານບໍ່ສາມາດເຮັດວຽກໃນຜັດທີ່ໄດ້ຮັບມອບໝາຍ, ກະລຸນາຍົກເລີກການຮັບ"
"ຜັດວຽກດ້ວຍຕົນເອງພາຍໃນ <t t-out=\"object.self_unassign_days_before or ''\">5</t> "
"ມື້ ກ່ອນເລີ່ມຜັດວຽກ.\n"
"                        </t>\n"
"                    </p>\n"
"                    <p t-if=\"ctx.get('message')\" t-out=\"ctx['message']\"/>"
"\n"
"                    <p t-if=\"ctx.get('is_internal_user') and not "
"object.allow_self_unassign\">ໃນກໍລະນີທີ່ຕາຕະລາງປະຈຸບັນບໍ່ສະດວກສຳລັບທ່ານ, ພວກເຮົາແນະນຳໃຫ້ທ່"
"ານຕິດຕໍ່ຫາເພື່ອນຮ່ວມງານເພື່ອຂໍປ່ຽນຜັດວຽກກັນ. ເຂົາເຈົ້າອາດຈະສົນໃຈປ່ຽນຜັດວຽກກັບທ່ານ.</p>\n"
"                </div>\n"
"            "

#. module: planning
#: model:mail.template,body_html:planning.email_template_shift_switch_email
msgid ""
"<div>\n"
"                    <p t-if=\"ctx.get('old_assignee_name')\">Dear <t t-"
"out=\"ctx['old_assignee_name']\">Anita Oliver</t>,</p>\n"
"                    <p t-else=\"\">Hello,</p>\n"
"                    <br/>\n"
"                    <p>\n"
"                        The following shift that you requested to switch has "
"been re-assigned\n"
"                        <t t-if=\"ctx.get('new_assignee_names')\"> to <t t-"
"out=\"ctx['new_assignee_names']\">Marc Demo</t></t>.\n"
"                    </p>\n"
"                    <table style=\"margin-left: 30px;\">\n"
"                        <tr t-if=\"(ctx.get('start_datetime') and "
"ctx.get('end_datetime'))                                   or "
"ctx.get('allocated_hours')                                   or "
"ctx.get('allocated_percentage')\">\n"
"                            <th style=\"padding: 5px; text-align: left;"
"\">Date</th>\n"
"                            <td style=\"padding: 5px;\">\n"
"                                <span t-if=\"ctx.get('start_datetime') and "
"ctx.get('end_datetime')\" t-out=\"'%s ⟶ %s' % "
"(                                     ctx['start_datetime'],                                     "
"ctx['end_datetime'],                                 )\">\n"
"                                    05/31/2021, 8:00 AM ⟶ 05/31/2021, 4:00 "
"PM\n"
"                                </span>\n"
"                                <span t-if=\"ctx.get('allocated_hours')\" "
"style=\"opacity: 0.5;\">\n"
"                                    (<t t-out=\"ctx['allocated_hours']"
"\">4:00</t>h)\n"
"                                </span>\n"
"                                <span t-if=\"ctx.get('allocated_percentage') "
"and ctx['allocated_percentage'] != '100'\" style=\"opacity: 0.5;\">\n"
"                                    (<t t-out=\"ctx['allocated_percentage']"
"\">50</t>%)\n"
"                                </span>\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr t-if=\"object.role_id\">\n"
"                            <th style=\"padding: 5px; text-align: left;"
"\">Role</th>\n"
"                            <td style=\"padding: 5px;\" t-"
"out=\"object.role_id.name or ''\">Bartender</td>\n"
"                        </tr>\n"
"                        <tr t-if=\"hasattr(object, 'project_id') and "
"object.project_id\">\n"
"                            <th style=\"padding: 5px; text-align: left;"
"\">Project</th>\n"
"                            <td style=\"padding: 5px;\" t-"
"out=\"object.sudo().project_id.name or ''\">Gathering</td>\n"
"                        </tr>\n"
"                        <tr t-if=\"hasattr(object, 'task_id') and "
"object.task_id\">\n"
"                            <th style=\"padding: 5px; text-align: left;"
"\">Task</th>\n"
"                            <td style=\"padding: 5px;\" t-"
"out=\"object.sudo().task_id.name or ''\">Chef</td>\n"
"                        </tr>\n"
"                        <tr t-if=\"hasattr(object, 'sale_line_id') and "
"object.sale_line_id\">\n"
"                            <th style=\"padding: 5px; text-align: left;"
"\">Sales Order Item</th>\n"
"                            <td style=\"padding: 5px;\" t-"
"out=\"object.sudo().sale_line_id.name or ''\">Coffee</td>\n"
"                        </tr>\n"
"                        <tr t-if=\"hasattr(object, 'name') and "
"object.name\">\n"
"                            <th style=\"padding: 5px; text-align: left;"
"\">Note</th>\n"
"                            <td style=\"padding: 5px;\" t-out=\"object.name "
"or ''\">/</td>\n"
"                        </tr>\n"
"                    </table>\n"
"                    <br/>\n"
"                </div>\n"
"            "
msgstr ""
"<div>\n"
"                    <p t-if=\"ctx.get('old_assignee_name')\">ຮຽນ <t t-"
"out=\"ctx['old_assignee_name']\">Anita Oliver</t>,</p>\n"
"                    <p t-else=\"\">ສະບາຍດີ,</p>\n"
"                    <br/>\n"
"                    <p>\n"
"                        ຜັດວຽກຕໍ່ໄປນີ້ທີ່ທ່ານໄດ້ຮ້ອງຂໍປ່ຽນ ໄດ້ຖືກມອບໝາຍໃໝ່ແລ້ວ\n"
"                        <t t-if=\"ctx.get('new_assignee_names')\"> ໃຫ້ກັບ <t t-"
"out=\"ctx['new_assignee_names']\">Marc Demo</t></t>.\n"
"                    </p>\n"
"                    <table style=\"margin-left: 30px;\">\n"
"                        <tr t-if=\"(ctx.get('start_datetime') and ctx.get"
"('end_datetime'))                                   or ctx.get"
"('allocated_hours')                                   or ctx.get"
"('allocated_percentage')\">\n"
"                            <th style=\"padding: 5px; text-align: left;\">ວັນ"
"ທີ</th>\n"
"                            <td style=\"padding: 5px;\">\n"
"                                <span t-if=\"ctx.get('start_datetime') and "
"ctx.get('end_datetime')\" t-out=\"'%s ⟶ %s' % "
"(                                     "
"ctx['start_datetime'],                                     "
"ctx['end_datetime'],                                 )\">\n"
"                                    05/31/2021, 8:00 AM ⟶ 05/31/2021, 4:00 "
"PM\n"
"                                </span>\n"
"                                <span t-if=\"ctx.get('allocated_hours')\" "
"style=\"opacity: 0.5;\">\n"
"                                    (<t t-out=\"ctx['allocated_hours']\">"
"4:00</t>ຊມ)\n"
"                                </span>\n"
"                                <span t-if=\"ctx.get('allocated_percentage') "
"and ctx['allocated_percentage'] != '100'\" style=\"opacity: 0.5;\">\n"
"                                    (<t t-"
"out=\"ctx['allocated_percentage']\">50</t>%)\n"
"                                </span>\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr t-if=\"object.role_id\">\n"
"                            <th style=\"padding: 5px; text-align: left;\">ບົດບ"
"າດ</th>\n"
"                            <td style=\"padding: 5px;\" t-"
"out=\"object.role_id.name or ''\">Bartender</td>\n"
"                        </tr>\n"
"                        <tr t-if=\"hasattr(object, 'project_id') and "
"object.project_id\">\n"
"                            <th style=\"padding: 5px; text-align: left;\">ໂຄງ"
"ການ</th>\n"
"                            <td style=\"padding: 5px;\" t-out=\"object.sudo()"
".project_id.name or ''\">Gathering</td>\n"
"                        </tr>\n"
"                        <tr t-if=\"hasattr(object, 'task_id') and "
"object.task_id\">\n"
"                            <th style=\"padding: 5px; text-align: left;\">ໜ້າວ"
"ຽກ</th>\n"
"                            <td style=\"padding: 5px;\" t-out=\"object.sudo()"
".task_id.name or ''\">Chef</td>\n"
"                        </tr>\n"
"                        <tr t-if=\"hasattr(object, 'sale_line_id') and "
"object.sale_line_id\">\n"
"                            <th style=\"padding: 5px; text-align: left;\">ລາຍ"
"ການໃບສັ່ງຂາຍ</th>\n"
"                            <td style=\"padding: 5px;\" t-out=\"object.sudo()"
".sale_line_id.name or ''\">Coffee</td>\n"
"                        </tr>\n"
"                        <tr t-if=\"hasattr(object, 'name') and object.name\">"
"\n"
