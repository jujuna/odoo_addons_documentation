#. module: frontdesk_sms
#. odoo-python
#: code:addons/frontdesk_sms/models/frontdesk_frontdesk.py:0
msgid ""
"%(host_names)s must have a valid Phone to be informed about visitor arrival."
msgstr ""
"%(host_names)s doivent disposer d'un numéro de téléphone valide pour être "
"informés de l'arrivée des visiteurs."

#. module: frontdesk_sms
#: model:ir.model.fields,field_description:frontdesk_sms.field_frontdesk_frontdesk__display_name
#: model:ir.model.fields,field_description:frontdesk_sms.field_frontdesk_visitor__display_name
msgid "Display Name"
msgstr "Nom d'affichage"

#. module: frontdesk_sms
#: model:ir.module.module,description:base.module_frontdesk_sms
msgid ""
"Enable SMS alerts to hosts when visitors check in, or when hosts are "
"unavailable. This bridge module extends Frontdesk with SMS delivery options, "
"using host phone numbers and configurable templates."
msgstr ""
"Activez les alertes SMS aux hôtes lorsque les visiteurs s'enregistrent ou "
"lorsque les hôtes sont indisponibles. Ce module de liaison étend "
"l'application Accueil avec des options de notification par SMS, en utilisant "
"les numéros de téléphone des hôtes et des modèles configurables."

