msgid "Frontdesk SMS Template"
msgstr "ແມ່ແບບ SMS ໂຕະຕ້ອນຮັບ"

#. module: frontdesk_sms
#: model:ir.model,name:frontdesk_sms.model_frontdesk_visitor
msgid "Frontdesk Visitor"
msgstr "ຜູ້ມາຢ້ຽມຢາມໂຕະຕ້ອນຮັບ"

#. module: frontdesk_sms
#: model:sms.template,body:frontdesk_sms.frontdesk_sms_template
msgid ""
"Hello, Your visitor {{ object.name }} {{ '(%s)' % object.phone if "
"object.phone else '' }} {{ '(%s)' % object.company if object.company else "
"'' }} wants to meet you at {{ object.station_id.name }}. Please let them "
"know you'll be there shortly."
msgstr ""
"ສະບາຍດີ, ແຂກຂອງທ່ານ {{ object.name }} {{ '(%s)' % object.phone if object.phone "
"else '' }} {{ '(%s)' % object.company if object.company else '' }} ຕ້ອງການພົບທ່າ"
"ນຢູ່ທີ່ {{ object.station_id.name }}. ກະລຸນາແຈ້ງໃຫ້ພວກເຂົາຮູ້ວ່າ ທ່ານຈະໄປຮອດໃນໄວໆນີ້."

