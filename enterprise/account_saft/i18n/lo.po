msgstr "ກະລຸນາກຳນົດສິ່ງຕໍ່ໄປນີ້ສຳລັບ"

#. module: account_saft
#. odoo-python
#: code:addons/account_saft/models/account_general_ledger.py:0
msgid "SAF-T is only compatible with one column group."
msgstr "SAF-T ຮອງຮັບໄດ້ສະເພາະກັບກຸ່ມຖັນດຽວເທົ່ານັ້ນ."

#. module: account_saft
#. odoo-python
#: code:addons/account_saft/models/account_general_ledger.py:0
msgid "Some partners are missing at least one address (Zip/City)."
msgstr "ຄູ່ຄ້າບາງລາຍການຍັງຂາດທີ່ຢູ່ຢ່າງໜ້ອຍໜຶ່ງຢ່າງ (ລະຫັດໄປສະນີ/ເມືອງ)."

#. module: account_saft
#: model:ir.module.module,shortdesc:base.module_account_saft
msgid "Standard Audit File for Tax Base module"
msgstr "ໂມດູນພື້ນຖານ Standard Audit File for Tax"

#. module: account_saft
#. odoo-python
#: code:addons/account_saft/models/account_general_ledger.py:0
msgid "Undistributed profits or losses may cause export rejection."
msgstr "ກຳໄລ ຫຼື ຂາດທຶນທີ່ຍັງບໍ່ທັນໄດ້ຈັດສັນ ອາດເຮັດໃຫ້ການສົ່ງອອກຖືກປະຕິເສດ."

#. module: account_saft
#. odoo-python
#: code:addons/account_saft/models/account_general_ledger.py:0
msgid "View Company Partner"
msgstr "ເບິ່ງຄູ່ຄ້າຂອງບໍລິສັດ"

#. module: account_saft
#. odoo-python
#: code:addons/account_saft/models/account_general_ledger.py:0
msgid "View Partners"
msgstr "ເບິ່ງຄູ່ຄ້າ"

#. module: account_saft
#. odoo-python
#: code:addons/account_saft/models/account_general_ledger.py:0
msgid "the Company ID"
msgstr "ລະຫັດປະຈຳຕົວບໍລິສັດ"

#. module: account_saft
#. odoo-python
#: code:addons/account_saft/models/account_general_ledger.py:0
msgid "the city or zip code"
msgstr "ເມືອງ ຫຼື ລະຫັດໄປສະນີ"

#. module: account_saft
#. odoo-python
#: code:addons/account_saft/models/account_general_ledger.py:0
msgid "the phone number"
msgstr "ເບີໂທລະສັບ"

#. module: account_saft
#. odoo-javascript
#: code:addons/account_saft/static/src/components/general_ledger/filters/warnings.xml:0
msgid "your company"
msgstr "ບໍລິສັດຂອງທ່ານ"
