#. module: timesheet_grid_hr_attendance
#: model:ir.module.module,description:base.module_timesheet_grid_hr_attendance
msgid ""
"\n"
"Bridge module for Timesheets Grid and HR Attendance\n"
"====================================================\n"
"This module modifies the timesheet systray behavior when the attendance "
"module is installed,\n"
"allowing for integrated attendance and timesheet tracking from a single "
"interface.\n"
msgstr ""
"\n"
"工时表网格与 HR 出勤的桥接模块\n"
"====================================================\n"
"安装出勤模块后，本模块会修改工时表系统托盘的行为，\n"
"允许在单一界面中集成出勤与工时表跟踪。\n"

#. module: timesheet_grid_hr_attendance
#. odoo-javascript
#: code:addons/timesheet_grid_hr_attendance/static/src/js/tours/timesheet_grid_hr_attendance.js:0
msgid ""
"<b>Check in to start the timer</b> <br/> <i>This begins tracking your "
"current activity automatically.</i>"
msgstr "<b>签到以启动计时器</b> <br/> <i>这会自动开始跟踪您当前的活动。</i>"

#. module: timesheet_grid_hr_attendance
#. odoo-javascript
#: code:addons/timesheet_grid_hr_attendance/static/src/js/tours/timesheet_grid_hr_attendance.js:0
msgid ""
"<b>Use the timer to track your time</b> <br/> <i>Start your day by checking "
"in and log timesheets from anywhere.</i>"
msgstr ""
"<b>使用计时器记录工时</b> <br/> <i> 每天开始工作时签到，并可在任何地点记录工"
"时单。</i>"

