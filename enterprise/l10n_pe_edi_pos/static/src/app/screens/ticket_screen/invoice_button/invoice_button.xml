<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="l10n_pe_edi_pos.InvoiceButton" t-inherit="point_of_sale.InvoiceButton" t-inherit-mode="extension">
        <xpath expr="//button" position="attributes">
            <attribute name="t-att-disabled">this.isAlreadyInvoiced and this.pos.company.account_fiscal_country_id.code === 'PE'</attribute>
        </xpath>
    </t>

</templates>
