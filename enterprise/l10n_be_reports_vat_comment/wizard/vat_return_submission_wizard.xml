<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vat_return_submission_wizard_form_inherit" model="ir.ui.view">
        <field name="name">l10n_be_reports_vat_comment.vat.return.submission.wizard.form.inherit</field>
        <field name="model">l10n_be_reports.vat.return.submission.wizard</field>
        <field name="inherit_id" ref="l10n_be_reports.vat_return_submission_wizard_form"/>
        <field name="arch" type="xml">
            <group id="instructions" position="before">
                <label for="comment" string="Comment for the Administration"/>
                <field name="comment" placeholder="e.g. This declaration replaces the one sent previously for the same period." help="Optional free text transmitted with your declaration to the VAT office."/>
            </group>
        </field>
    </record>
</odoo>
