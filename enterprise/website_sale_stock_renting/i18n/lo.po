#. module: website_sale_stock_renting
#. odoo-javascript
#: code:addons/website_sale_stock_renting/static/src/xml/website_sale_stock_renting_product_availability.xml:0
msgid ""
"You already added all the available product in your cart during the selected "
"period."
msgstr ""
"ທ່ານໄດ້ເພີ່ມສິນຄ້າທີ່ມີທັງໝົດລົງໃນກະຕ່າຂອງທ່ານແລ້ວ ສຳລັບໄລຍະເວລາທີ່ເລືອກ."

#. module: website_sale_stock_renting
#. odoo-python
#: code:addons/website_sale_stock_renting/models/sale_order_line.py:0
msgid ""
"You requested %(desired_quantity)g %(product_name)s, but only %"
"(available_quantity)g are available from %(rental_period)s."
msgstr ""
"ທ່ານຕ້ອງການ %(desired_quantity)g %(product_name)s, ແຕ່ມີພຽງ %(available_quantity)"
"g ທີ່ພ້ອມໃຫ້ບໍລິການຕັ້ງແຕ່ %(rental_period)s."

#. module: website_sale_stock_renting
#. odoo-javascript
#: code:addons/website_sale_stock_renting/static/src/interactions/daterange_picker.js:0
msgid "Your rental product cannot be prepared as fast, please rent later."
msgstr ""
"ສິນຄ້າເຊົ່າຂອງທ່ານບໍ່ສາມາດກຽມພ້ອມໄດ້ໄວຂະໜາດນັ້ນ, ກະລຸນາເລືອກເຊົ່າໃນພາຍຫຼັງ."

