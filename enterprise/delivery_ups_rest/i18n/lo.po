#. module: delivery_ups_rest
#. odoo-python
#: code:addons/delivery_ups_rest/models/ups_request.py:0
msgid ""
"The delivery cannot be done because the weight of your product %s is missing."
msgstr "ບໍ່ສາມາດຈັດສົ່ງໄດ້ ເນື່ອງຈາກຂາດຂໍ້ມູນນ້ຳໜັກຂອງສິນຄ້າ %s."

#. module: delivery_ups_rest
#. odoo-python
#: code:addons/delivery_ups_rest/models/ups_request.py:0
msgid ""
"The estimated shipping price cannot be computed because the weight is "
"missing for the following product(s): \n"
" %s"
msgstr ""
"ບໍ່ສາມາດຄິດໄລ່ລາຄາຈັດສົ່ງໂດຍປະມານໄດ້ ເນື່ອງຈາກບໍ່ມີຂໍ້ມູນນ້ຳໜັກສຳລັບສິນຄ້າຕໍ່ໄປນີ້: \n"
" %s"

