#. odoo-python
#: code:addons/delivery_ups_rest/models/ups_request.py:0
msgid "The name of the customer should be no more than 35 characters."
msgstr "ຊື່ຂອງລູກຄ້າບໍ່ຄວນເກີນ 35 ຕົວອັກສອນ."

#. module: delivery_ups_rest
#. odoo-python
#: code:addons/delivery_ups_rest/models/ups_request.py:0
