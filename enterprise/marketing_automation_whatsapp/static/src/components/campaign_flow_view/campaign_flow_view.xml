<templates>
    <t t-name="marketing_automation_whatsapp.CampaignFlowView" t-inherit="marketing_automation.CampaignFlowView" t-inherit-mode="extension">
        <xpath expr="//t[@t-elif=&quot;activity.data.activity_type === &apos;mail&apos;&quot;]" position="after">
            <t t-elif="activity.data.activity_type === 'whatsapp'">
                <t t-set="position" t-value="this.getActivityPositionOnScreen(activity)"/>
                <!-- "WhatsApp" node: -->
                <div class="o-editor-node d-flex flex-column align-self-center flex-shrink-0 bg-light rounded border p-3"
                    t-att-style="this.getCSSTransform(position.x, position.y)"
                    t-on-pointerdown="(e) => this.addPointerListenerOnMarketingActivity(activity, e)">
                    <div class="d-flex flex-row align-items-center">
                        <i class="oi oi-2x mb-auto p-2 bg-300 rounded pt-1" data-icon="oi_whatsapp" alt="Whatsapp icon"/>
                        <div class="d-flex flex-column ps-1 lh-sm pb-1">
                            <span class="fs-2 fw-bold text-truncate" t-out="activity.data.name"/>
                            <span class="small" t-out="activity.data.whatsapp_template_id.display_name"/>
                        </div>
                    </div>
                    <div class="d-flex border-top px-1">
                        <div class="d-flex align-items-center">
                            <span class="small px-1" t-out="activity.data.total_sent"/>
                            <span class="text-muted small">Sent</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <span class="small px-1" t-out="activity.data.total_open"/>
                            <span class="text-muted small">Opened</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <span class="small px-1" t-out="activity.data.total_click"/>
                            <span class="text-muted small">Clicks</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <span class="small px-1" t-out="activity.data.total_reply"/>
                            <span class="text-muted small">Replied</span>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </t>
</templates>
