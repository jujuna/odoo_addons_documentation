<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="res_config_settings_view_form_inherit_l10n_it_pos_fiskaly">
        <field name="name">res.config.settings.view.form.inherit.l10n_it_pos_fiskaly</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_localization_section']" position="after">
                <block id="l10n_it_pos_fiskaly_section" title="Fiscalization" help="Those settings are used to comply with legal requirements in specific countries." invisible="country_code != 'IT'">
                    <setting id="italy_pos_localization" string="Italy Fiskaly" company_dependent="1"
                        help="Register this point of sale with fiskaly SIGN IT to transmit its receipts to the Agenzia delle Entrate">
                        <button name="action_l10n_it_fiskaly_create_system" type="object"
                                string="Register this Register" class="btn-primary" groups="base.group_system"
                                invisible="pos_l10n_it_fiskaly_system_state == 'COMMISSIONED'"/>
                        <group invisible="not l10n_it_fiskaly_taxpayer_id">
                            <field name="pos_l10n_it_fiskaly_system_id" readonly="1"
                                invisible="not pos_l10n_it_fiskaly_system_id"/>
                            <field name="pos_l10n_it_fiskaly_system_state" readonly="1"
                                invisible="not pos_l10n_it_fiskaly_system_id"/>
                        </group>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
