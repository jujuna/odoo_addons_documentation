<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_pos_config_kanban" model="ir.ui.view">
        <field name="name">pos.config.kanban.view.inherit.l10n_it_pos_fiskaly</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_config_kanban"/>
        <field name="arch" type="xml">
            <div name="card_title" position="after">
                <field name="l10n_it_fiskaly_system_id" invisible="1"/>
                <div t-if="record.l10n_it_fiskaly_system_id.raw_value" class="d-flex align-items-center gap-2 position-relative ms-2">
                    <div class="badge text-bg-info o_kanban_inline_block me-2">Registered POS</div>
                </div>
            </div>
        </field>
    </record>
</odoo>
