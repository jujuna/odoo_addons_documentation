<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <template id="l10n_it_pos_fiskaly.pos_order_receipt_footer" inherit_id="point_of_sale.pos_order_receipt_footer">
            <div name="footer" position="inside">
                <div t-if="extra_data.get('l10n_it_fiskaly_refunded_compliance_number')" class="w-100 text-center">
                    Refund of <t t-out="extra_data['l10n_it_fiskaly_refunded_compliance_number']"/>
                </div>
                <div t-if="order.get('l10n_it_fiskaly_compliance_number')" class="w-100 text-center">
                    <t t-out="order.get('l10n_it_fiskaly_compliance_number')"/>
                </div>
            </div>
        </template>
    </data>
</odoo>
