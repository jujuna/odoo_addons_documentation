#. module: pos_self_order_mobile
#: model:ir.model.fields,field_description:pos_self_order_mobile.field_pos_config__id
msgid "ID"
msgstr "ID"

#. module: pos_self_order_mobile
#: model:ir.module.module,summary:base.module_pos_self_order_mobile
msgid "Odoo Mobile POS Self Order module"
msgstr "ໂມດູນການສັ່ງຊື້ດ້ວຍຕົນເອງ POS ສຳລັບ Odoo Mobile"

#. module: pos_self_order_mobile
#. odoo-javascript
#: code:addons/pos_self_order_mobile/static/src/backend/self_open_kiosk_button/self_open_kiosk_button.js:0
