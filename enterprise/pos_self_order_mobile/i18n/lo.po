msgstr "ເປີດ Kiosk"

#. module: pos_self_order_mobile
#. odoo-javascript
#: code:addons/pos_self_order_mobile/static/src/backend/open_kiosk.js:0
msgid "Open Normally"
msgstr "ເປີດແບບປົກກະຕິ"

#. module: pos_self_order_mobile
#: model:ir.module.module,shortdesc:base.module_pos_self_order_mobile
msgid "POS Self Order Mobile"
msgstr "POS ສັ່ງຊື້ດ້ວຍຕົນເອງເທິງມືຖື"

#. module: pos_self_order_mobile
#: model:ir.model,name:pos_self_order_mobile.model_pos_config
msgid "Point of Sale Configuration"
msgstr "ການຕັ້ງຄ່າຈຸດຂາຍ"

#. module: pos_self_order_mobile
#. odoo-javascript
#: code:addons/pos_self_order_mobile/static/src/backend/self_open_kiosk_button/self_open_kiosk_button.js:0
