#. module: voip
#: model:mail.template,body_html:voip.mail_template_phone_number_request
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    Dear <t t-out=\"ctx.get('recipient_name')\"/>,\n"
"                    <br/><br/>\n"
"                    <strong t-out=\"user.name\"/> has requested a phone "
"number.\n"
"                    <br/><br/>\n"
"                    <t t-if=\"not is_html_empty(object.body_html)\">\n"
"                        <span>They added the following comment:</span>\n"
"                        <div style=\"border-left: 4px solid #dee2e6; "
"padding: 8px 0 8px 16px; margin: 1rem 0 2rem 0;\">\n"
"                            <t t-out=\"object.body_html\"/>\n"
"                        </div>\n"
"                    </t>\n"
"                    <a t-attf-style=\"background-color: "
"{{user.company_id.email_secondary_color or '#875A7B'}}; padding: 8px 16px; "
"text-decoration: none; color: {{user.company_id.email_primary_color or "
"'#FFFFFF'}}; border-radius: 5px;\" href=\"/odoo/action-"
"voip.action_voip_did_number\">\n"
"                        Buy Number\n"
"                    </a>\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    尊敬的 <t t-out=\"ctx.get('recipient_name')\"/>：\n"
"                    <br/><br/>\n"
"                    <strong t-out=\"user.name\"/> 申请了一个电话号码。\n"
"                    <br/><br/>\n"
"                    <t t-if=\"not is_html_empty(object.body_html)\">\n"
"                        <span>对方添加了以下备注：</span>\n"
"                        <div style=\"border-left: 4px solid #dee2e6; "
"padding: 8px 0 8px 16px; margin: 1rem 0 2rem 0;\">\n"
"                            <t t-out=\"object.body_html\"/>\n"
"                        </div>\n"
"                    </t>\n"
"                    <a t-attf-style=\"background-color: "
"{{user.company_id.email_secondary_color or '#875A7B'}}; padding: 8px 16px; "
"text-decoration: none; color: {{user.company_id.email_primary_color or "
"'#FFFFFF'}}; border-radius: 5px;\" href=\"/odoo/action-"
"voip.action_voip_did_number\">\n"
"                        购买号码\n"
"                    </a>\n"
"                </p>\n"
"            </div>\n"
"        "

#. module: voip
#: model:mail.template,body_html:voip.mail_template_voicemail_message
msgid ""
"<div>\n"
"                <p>A new mailbox message was left in <t t-"
"out=\"object.voicemail_id.name\"/>.</p>\n"
"                <ul>\n"
"                    <li>\n"
"                        <strong>Caller:</strong>\n"
"                        <t t-if=\"object.caller_id_name or "
"object.caller_id_num\" t-out=\"object.caller_id_name or "
"object.caller_id_num\"/>\n"
"                        <t t-else=\"\">Unknown caller</t>\n"
"                    </li>\n"
"                    <li t-if=\"object.caller_id_name and "
"object.caller_id_num\"><strong>Phone number:</strong> <t t-"
"out=\"object.caller_id_num\"/></li>\n"
"                    <li><strong>Received on:</strong> <t t-"
"out=\"format_datetime(object.occurred_at)\"/></li>\n"
"                    <li><strong>Duration:</strong> <t t-"
"out=\"format_duration(object.duration / 3600)\"/></li>\n"
"                </ul>\n"
"                <p>The recording is attached to this email.</p>\n"
"            </div>\n"
"        "
msgstr ""
"<div>\n"
"                <p><t t-out=\"object.voicemail_id.name\"/> 中收到一条新的语音"
"信箱留言。</p>\n"
"                <ul>\n"
"                    <li>\n"
"                        <strong>主叫方：</strong>\n"
"                        <t t-if=\"object.caller_id_name or "
"object.caller_id_num\" t-out=\"object.caller_id_name or "
"object.caller_id_num\"/>\n"
"                        <t t-else=\"\">未知主叫方</t>\n"
"                    </li>\n"
"                    <li t-if=\"object.caller_id_name and "
"object.caller_id_num\"><strong>电话号码：</strong> <t t-"
"out=\"object.caller_id_num\"/></li>\n"
"                    <li><strong>接收时间：</strong> <t t-"
"out=\"format_datetime(object.occurred_at)\"/></li>\n"
"                    <li><strong>时长：</strong> <t t-"
"out=\"format_duration(object.duration / 3600)\"/></li>\n"
"                </ul>\n"
"                <p>录音已作为附件添加到本邮件。</p>\n"
"            </div>\n"
"        "

