msgstr "ທ່ານສາມາດສັ່ງຊື້ໄດ້ສູງສຸດ %(max)s ເບີໃນຄັ້ງດຽວ."

#. module: voip
#. odoo-python
#: code:addons/voip/wizards/voip_did_number_search_wizard.py:0
msgid "You can request between 1 and %(max)s numbers."
msgstr "ທ່ານສາມາດຮ້ອງຂໍໄດ້ລະຫວ່າງ 1 ຫາ %(max)s ເບີ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_provider.py:0
msgid "You cannot delete Odoo Phone Service."
msgstr "ທ່ານບໍ່ສາມາດລຶບ ບໍລິການ Odoo Phone ໄດ້."

#. module: voip
#. odoo-python
#: code:addons/voip/models/phone_service_api.py:0
#: code:addons/voip/models/voip_did_number.py:0
msgid "You do not have enough credits to complete this operation."
msgstr "ທ່ານມີເຄຣດິດບໍ່ພຽງພໍທີ່ຈະເຮັດການດຳເນີນການນີ້ໃຫ້ສຳເລັດ."

#. module: voip
#. odoo-python
#: code:addons/voip/wizards/voip_did_number_search_wizard.py:0
msgid "You don't have permission to purchase phone numbers."
msgstr "ທ່ານບໍ່ມີສິດໃນການຊື້ເບີໂທລະສັບ."

#. module: voip
#. odoo-python
#: code:addons/voip/wizards/voip_did_number_search_wizard.py:0
msgid "You don't have permission to request phone numbers."
msgstr "ທ່ານບໍ່ມີສິດໃນການຮ້ອງຂໍເບີໂທລະສັບ."

#. module: voip
#. odoo-python
#: code:addons/voip/wizards/voip_did_number_search_wizard.py:0
msgid "You don't have permission to search phone numbers."
msgstr "ທ່ານບໍ່ມີສິດໃນການຄົ້ນຫາເບີໂທລະສັບ."

#. module: voip
#. odoo-python
#: code:addons/voip/wizards/voip_did_number_search_wizard.py:0
msgid "You must activate your database to buy a phone number."
msgstr "ທ່ານຕ້ອງເປີດໃຊ້ງານຖານຂໍ້ມູນຂອງທ່ານກ່ອນ ຈຶ່ງຈະສາມາດຊື້ເບີໂທລະສັບໄດ້."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_did_number.py:0
msgid "You must release phone numbers before deleting them."
msgstr "ທ່ານຕ້ອງປ່ອຍເບີໂທລະສັບຄືນກ່ອນ ຈຶ່ງຈະສາມາດລຶບມັນອອກໄດ້."

#. module: voip
#. odoo-python
#: code:addons/voip/models/phone_service_api.py:0
msgid "Your Odoo subscription does not allow this operation."
msgstr "ການສະໝັກສະມາຊິກ Odoo ຂອງທ່ານບໍ່ຮອງຮັບການດຳເນີນການນີ້."

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/core/web/voip_service.js:0
msgid ""
"Your browser does not support some of the features required. Please try "
"updating your browser or using a different one."
msgstr ""
"ບຣາວເຊີຂອງທ່ານບໍ່ຮອງຮັບຄຸນສົມບັດບາງຢ່າງທີ່ຈຳເປັນ. ກະລຸນາລອງອັບເດດບຣາວເຊີ ຫຼື ປ່ຽນໄປໃຊ້ບຣາວເຊີອື່ນ."

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/softphone/history.js:0
msgid "Your call history is empty! Make a call now and have it listed here 💡"
msgstr "ປະຫວັດການໂທຂອງທ່ານວ່າງເປົ່າ! ເລີ່ມໂທດຽວນີ້ ເພື່ອໃຫ້ລາຍການສະແດງຢູ່ນີ້ 💡"

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/softphone/status_menu.xml:0
msgid "Your caller ID"
msgstr "ໝາຍເລກໂທອອກຂອງທ່ານ"

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_did_number_request.py:0
msgid ""
"Your decision is needed for this number request. Review any proposed numbers "
"and reply within five business days to avoid automatic cancellation."
msgstr ""
"ຕ້ອງການການຕັດສິນໃຈຂອງທ່ານສຳລັບຄຳຂໍເບີນີ້. ກະລຸນາກວດກາເບິ່ງເບີທີ່ສະເໜີ ແລະ ຕອບກັບພາຍໃນຫ້າວັນລັດຖະກ"
"ານ ເພື່ອຫຼີກລ່ຽງການຍົກເລີກອັດຕະໂນມັດ."

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/softphone/status_menu.js:0
msgid "Your extension"
msgstr "ເບີພາຍໃນຂອງທ່ານ"

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/core/web/voip_service.js:0
msgid ""
"Your login details to use the phone are not set in your user preferences. "
"Please check or ask your administrator if needed."
msgstr ""
"ຂໍ້ມູນການເຂົ້າສູ່ລະບົບເພື່ອໃຊ້ໂທລະສັບຍັງບໍ່ໄດ້ຖືກຕັ້ງຄ່າໃນການຕັ້ງຄ່າສ່ວນຕົວຂອງທ່ານ. ກະລຸນາກວດສອບ ຫຼື ຕິດຕໍ່ຜູ້ເ"
"ບິ່ງແຍງລະບົບຫາກຕ້ອງການ."

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/softphone/status_menu.js:0
msgid "Your number"
msgstr "ເບີຂອງທ່ານ"

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/core/web/voip_service.js:0
msgid ""
"Your number has been ordered and is under review. We'll notify you when it's "
"ready."
msgstr ""
"ເບີຂອງທ່ານໄດ້ຖືກສັ່ງຊື້ແລ້ວ ແລະ ພວມຢູ່ໃນຂັ້ນຕອນການກວດສອບ. ພວກເຮົາຈະແຈ້ງເຕືອນເມື່ອພ້ອມໃຊ້ງານ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_did_number.py:0
msgid "Your number has been released (%(number)s)"
msgstr "ເບີຂອງທ່ານຖືກປ່ອຍຄືນແລ້ວ (%(number)s)"

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_did_number.py:0
msgid "Your number is active! (%(number)s)"
msgstr "ເບີຂອງທ່ານເປີດໃຊ້ງານແລ້ວ! (%(number)s)"

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/core/web/voip_service.js:0
msgid ""
"Your number is active. Your phone setup is still being finalized. Calling "
"will be available once setup is complete."
msgstr ""
"ເບີຂອງທ່ານເປີດໃຊ້ງານແລ້ວ. ການຕັ້ງຄ່າໂທລະສັບຂອງທ່ານພວມຢູ່ໃນຂັ້ນຕອນສຳເລັດ. ຈະສາມາດໂທໄດ້ເມື່ອການຕັ້ງ"
"ຄ່າສຳເລັດສົມບູນ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_did_number.py:0
msgid "Your number is suspended (%(number)s)"
msgstr "ເບີຂອງທ່ານຖືກໂຈະການນຳໃຊ້ (%(number)s)"

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/core/web/voip_service.js:0
msgid "Your number is suspended. Calls use %(number)s."
msgstr "ເບີຂອງທ່ານຖືກໂຈະການນຳໃຊ້. ການໂທຈະໃຊ້ %(number)s ແທນ."

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/core/web/voip_service.js:0
msgid ""
"Your number is suspended. Internal calling is not configured, and external "
"calls are unavailable."
msgstr ""
"ເບີຂອງທ່ານຖືກໂຈະການນຳໃຊ້. ຍັງບໍ່ໄດ້ຕັ້ງຄ່າການໂທພາຍໃນ, ແລະ ບໍ່ສາມາດໂທອອກຕ່າງປະເທດ/ພາຍນອກໄດ້."

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/core/web/voip_service.js:0
msgid "Your number is suspended. Internal calls remain available."
msgstr "ເບີຂອງທ່ານຖືກໂຈະການນຳໃຊ້. ແຕ່ຍັງສາມາດໂທພາຍໃນໄດ້ຕາມປົກກະຕິ."

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/core/web/voip_service.js:0
msgid "Your number is under review. Calls remain simulated in Demo Mode."
msgstr "ເບີຂອງທ່ານພວມຢູ່ໃນຂັ້ນຕອນການກວດສອບ. ການໂທຍັງຄົງເປັນແບບຈຳລອງໃນໂໝດທົດລອງ."

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/core/web/voip_service.js:0
msgid "Your number is under review. Calls use %(number)s until it is approved."
msgstr ""
"ເບີຂອງທ່ານພວມຢູ່ໃນຂັ້ນຕອນການກວດສອບ. ການໂທຈະໃຊ້ %(number)s ຈົນກວ່າຈະໄດ້ຮັບການອະນຸມັດ."

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/core/web/voip_service.js:0
msgid ""
"Your number is under review. Internal calling is not configured; external "
"calls also require an approved number."
msgstr ""
"ເບີຂອງທ່ານພວມຢູ່ໃນຂັ້ນຕອນການກວດສອບ. ຍັງບໍ່ໄດ້ຕັ້ງຄ່າການໂທພາຍໃນ; ແລະ ການໂທພາຍນອກກໍຈຳເປັນຕ້ອງໃຊ້"
"ເບີທີ່ໄດ້ຮັບການອະນຸມັດແລ້ວ."

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/core/web/voip_service.js:0
msgid ""
"Your number is under review. Internal calls remain available; external calls "
"will be available after approval."
msgstr ""
"ເບີຂອງທ່ານພວມຢູ່ໃນຂັ້ນຕອນການກວດສອບ. ຍັງສາມາດໂທພາຍໃນໄດ້; ສ່ວນການໂທພາຍນອກຈະໃຊ້ໄດ້ຫຼັງຈາກໄດ້ຮັບ"
"ການອະນຸມັດແລ້ວ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_did_number.py:0
msgid "Your number order has failed (%(number)s)"
msgstr "ການສັ່ງຊື້ເບີຂອງທ່ານບໍ່ສຳເລັດ (%(number)s)"

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_did_number.py:0
msgid "Your number order is under review (%(number)s)"
msgstr "ການສັ່ງຊື້ເບີຂອງທ່ານພວມຢູ່ໃນຂັ້ນຕອນການກວດສອບ (%(number)s)"

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/softphone/status_menu.js:0
msgid "Your numbers"
msgstr "ເບີຂອງທ່ານ"

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_did_number.py:0
msgid ""
"Your phone number %(number)s has been released. It is no longer yours and "
"can no longer be used to make or receive calls."
msgstr ""
"ເບີໂທລະສັບ %(number)s ຂອງທ່ານຖືກປ່ອຍຄືນແລ້ວ. ມັນບໍ່ແມ່ນເບີຂອງທ່ານອີກຕໍ່ໄປ ແລະ ບໍ່ສາມາດໃຊ້ໂທອອກ "
"ຫຼື ຮັບສາຍໄດ້ອີກ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_did_number.py:0
msgid ""
"Your phone number %(number)s has been suspended because your credit balance "
"could not cover its monthly fee. Buy credits to reactivate it, otherwise it "
"will be released."
msgstr ""
"ເບີໂທລະສັບ %(number)s ຂອງທ່ານຖືກໂຈະການນຳໃຊ້ ເນື່ອງຈາກຍອດເຄຣດິດບໍ່ພໍຈ່າຍຄ່າບໍລິການລາຍເດືອນ. ກະ"
"ລຸນາຕື່ມເຄຣດິດເພື່ອເປີດໃຊ້ອີກຄັ້ງ, ບໍ່ດັ່ງນັ້ນເບີຈະຖືກປ່ອຍຄືນ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_did_number.py:0
msgid "Your phone number is in \"%(state)s\" state."
msgstr "ເບີໂທລະສັບຂອງທ່ານຢູ່ໃນສະຖານະ \"%(state)s\"."

