#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/core/web/user_agent.js:0
msgid ""
"There is still a call in progress, are you sure you want to leave the page?"
msgstr "ຍັງມີສາຍທີ່ພວມໂທຢູ່, ທ່ານແນ່ໃຈບໍ່ວ່າຕ້ອງການອອກຈາກໜ້ານີ້?"

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/core/web/user_agent.js:0
msgid "There seems to be an issue with the WebSocket connection."
msgstr "ເບິ່ງຄືວ່າມີບັນຫາກັບການເຊື່ອມຕໍ່ WebSocket."

#. module: voip
#: model_terms:ir.ui.view,arch_db:voip.voip_did_number_request_form_view
msgid ""
"These numbers are not charged yet. Reply below to approve or decline them."
msgstr ""
"ເບີເຫຼົ່ານີ້ຍັງບໍ່ທັນຖືກຄິດໄລ່ເງິນ. ຕອບກັບຢູ່ລຸ່ມນີ້ເພື່ອອະນຸມັດ ຫຼື ປະຕິເສດ."

#. module: voip
#: model_terms:ir.ui.view,arch_db:voip.voip_did_number_search_wizard_form
