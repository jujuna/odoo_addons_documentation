#. module: voip
#: model_terms:ir.ui.view,arch_db:voip.voip_did_number_form_view
msgid ""
"<strong>Identity verification required.</strong>\n"
"                    This number is waiting for regulatory approval. Click\n"
"                    <strong>Update Requirements</strong> above and complete\n"
"                    the identity verification step to activate this number."
msgstr ""
"<strong>ຈຳເປັນຕ້ອງຢືນຢັນຕົວຕົນ.</strong>\n"
"                    ເບີນີ້ກຳລັງລໍຖ້າການອະນຸມັດຕາມລະບຽບການ. ກົດໃສ່\n"
"                    <strong>ອັບເດດເອກະສານທີ່ກຳນົດ</strong> ຢູ່ເທິງນີ້ ແລະ ເຮັດສຳເລັດ\n"
"                    ຂັ້ນຕອນການຢືນຢັນຕົວຕົນເພື່ອເປີດນຳໃຊ້ເບີນີ້."

#. module: voip
#: model_terms:ir.ui.view,arch_db:voip.voip_did_number_request_form_view
msgid ""
"<strong>More information is required.</strong>\n"
"                        Review and reply below within five business days to "
"avoid automatic cancellation."
msgstr ""
"<strong>ຕ້ອງການຂໍ້ມູນເພີ່ມເຕີມ.</strong>\n"
"                        ກວດສອບ ແລະ ຕອບກັບດ້ານລຸ່ມພາຍໃນ 5 ວັນລັດຖະການເພື່ອຫຼີກລ່ຽງການຍົກເລີ"
"ກອັດຕະໂນມັດ."

#. module: voip
#: model_terms:ir.ui.view,arch_db:voip.voip_did_number_request_form_view
msgid ""
"<strong>Odoo is sourcing your numbers.</strong>\n"
"                        You will not be charged until you approve a proposal "
"and the request is fulfilled."
msgstr ""
"<strong>Odoo ກຳລັງຈັດຫາເບີໃຫ້ທ່ານ.</strong>\n"
"                        ທ່ານຈະຍັງບໍ່ຖືກຮຽກເກັບເງິນຈົນກວ່າທ່ານຈະອະນຸມັດຂໍ້ສະເໜີ ແລະ ຄຳຮ້ອງຂໍຖືກດ"
"ຳເນີນການສຳເລັດ."

#. module: voip
#: model_terms:ir.ui.view,arch_db:voip.voip_did_number_form_view
msgid ""
"<strong>This order failed.</strong>\n"
"                    Review the latest chatter message, then return to Phone "
"Numbers and search again."
msgstr ""
"<strong>ການສັ່ງຊື້ນີ້ບໍ່ສຳເລັດ.</strong>\n"
"                    ກວດເບິ່ງຂໍ້ຄວາມຫຼ້າສຸດໃນກ່ອງຂໍ້ຄວາມ, ຈາກນັ້ນກັບໄປທີ່ໜ້າ ເບີໂທລະສັບ ແລ້ວຄົ້ນຫາໃ"
"ໝ່ອີກຄັ້ງ."

#. module: voip
#: model_terms:ir.ui.view,arch_db:voip.voip_did_number_request_form_view
msgid ""
"<strong>This request could not be fulfilled.</strong>\n"
"                        Review the latest message below for details."
msgstr ""
"<strong>ບໍ່ສາມາດດຳເນີນການຕາມຄຳຮ້ອງຂໍນີ້ໄດ້.</strong>\n"
"                        ກວດເບິ່ງຂໍ້ຄວາມຫຼ້າສຸດດ້ານລຸ່ມສຳລັບລາຍລະອຽດ."

#. module: voip
#: model_terms:ir.ui.view,arch_db:voip.voip_did_number_request_form_view
msgid ""
"<strong>This request has been processed.</strong>\n"
"                        Phone numbers appear below as their individual "
"orders complete."
msgstr ""
"<strong>ຄຳຮ້ອງຂໍນີ້ໄດ້ຮັບການປະມວນຜົນແລ້ວ.</strong>\n"
"                        ເບີໂທລະສັບຈະສະແດງຢູ່ດ້ານລຸ່ມເມື່ອການສັ່ງຊື້ຂອງແຕ່ລະເບີສຳເລັດສົມບູນ."

#. module: voip
#: model_terms:ir.ui.view,arch_db:voip.voip_did_number_search_wizard_form
msgid "<strong>Your credits:</strong>"
msgstr "<strong>ເຄຣດິດຂອງທ່ານ:</strong>"

#. module: voip
#: model_terms:ir.ui.view,arch_db:voip.voip_did_number_request_form_view
msgid ""
"<strong>Your decision is needed.</strong>\n"
"                        Review any proposed numbers and reply below within "
"five business days."
msgstr ""
"<strong>ຕ້ອງການການຕັດສິນໃຈຂອງທ່ານ.</strong>\n"
"                        ກວດເບິ່ງເບີທີ່ສະເໜີ ແລະ ຕອບກັບດ້ານລຸ່ມພາຍໃນ 5 ວັນລັດຖະການ."

#. module: voip
#: model_terms:ir.ui.view,arch_db:voip.voip_did_number_form_view
msgid ""
"<strong>Your order is Under Review.</strong>\n"
"                    You will be notified of any change via this chatter."
msgstr ""
"<strong>ລາຍການສັ່ງຊື້ຂອງທ່ານກຳລັງຢູ່ໃນຂັ້ນຕອນການກວດສອບ.</strong>\n"
"                    ທ່ານຈະໄດ້ຮັບການແຈ້ງເຕືອນເມື່ອມີການປ່ຽນແປງຜ່ານທາງກ່ອງຂໍ້ຄວາມນີ້."

#. module: voip
#: model_terms:ir.ui.view,arch_db:voip.voip_did_number_form_view
msgid ""
"<strong>Your order is Under Review.</strong>\n"
"                    You will receive messages via this chatter if any "
"required document gets rejected.\n"
"                    Update requirements until all documents are approved."
msgstr ""
"<strong>ລາຍການສັ່ງຊື້ຂອງທ່ານກຳລັງຢູ່ໃນຂັ້ນຕອນການກວດສອບ.</strong>\n"
"                    ທ່ານຈະໄດ້ຮັບຂໍ້ຄວາມຜ່ານກ່ອງຂໍ້ຄວາມນີ້ຖ້າມີເອກະສານໃດໜຶ່ງຖືກປະຕິເສດ.\n"
"                    ກະລຸນາອັບເດດເອກະສານຈົນກວ່າເອກະສານທັງໝົດຈະໄດ້ຮັບການອະນຸມັດ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_call_flow.py:0
msgid "A Call Flow connection uses a saturated port."
msgstr "ການເຊື່ອມຕໍ່ຜັງສາຍໂທກຳລັງໃຊ້ພອດທີ່ເຕັມແລ້ວ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_call_flow.py:0
msgid "A Call Flow connection uses an invalid port."
msgstr "ການເຊື່ອມຕໍ່ຜັງສາຍໂທກຳລັງໃຊ້ພອດທີ່ບໍ່ຖືກຕ້ອງ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_call_flow.py:0
msgid "A Call Flow connection uses incompatible ports."
msgstr "ການເຊື່ອມຕໍ່ຜັງສາຍໂທກຳລັງໃຊ້ພອດທີ່ບໍ່ເຂົ້າກັນ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_call_flow.py:0
msgid "A Call Flow node has invalid output ports."
msgstr "ໂນດຂອງຜັງສາຍໂທມີພອດສົ່ງອອກທີ່ບໍ່ຖືກຕ້ອງ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_call_flow.py:0
msgid "A Call Group or Queue cannot use more than one Time Condition."
msgstr "ກຸ່ມສາຍໂທ ຫຼື ຄິວ ບໍ່ສາມາດໃຊ້ເງື່ອນໄຂເວລາເກີນໜຶ່ງເງື່ອນໄຂໄດ້."

#. module: voip
#: model:ir.model.constraint,message:voip.constraint_voip_call_leg_pbx_call_id_unique_per_conversation
msgid "A PBX call id is unique within its conversation."
msgstr "ລະຫັດສາຍໂທ PBX ຕ້ອງບໍ່ຊ້ຳກັນພາຍໃນການສົນທະນາດຽວກັນ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_extension.py:0
msgid "A PBX destination can only be linked to one extension."
msgstr "ປາຍທາງ PBX ສາມາດເຊື່ອມໂຍງໄດ້ກັບເບີພາຍໃນພຽງເບີດຽວເທົ່ານັ້ນ."

#. module: voip
#: model:ir.model.constraint,message:voip.constraint_voip_voicemail_message_unique_pbx_message_id
msgid "A PBX mailbox message can only be stored once."
msgstr "ຂໍ້ຄວາມກ່ອງສຽງ PBX ສາມາດບັນທຶກໄດ້ພຽງຄັ້ງດຽວເທົ່ານັ້ນ."

#. module: voip
#: model:ir.model.constraint,message:voip.constraint_voip_call_leg_sip_call_id_unique
msgid "A SIP Call-ID identifies a single leg."
msgstr "SIP Call-ID ໃຊ້ລະບຸຂາສາຍໂທດຽວເທົ່ານັ້ນ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_call_flow.py:0
msgid "A Time Condition node must have one Open and one Closed output."
msgstr "ໂນດເງື່ອນໄຂເວລາຕ້ອງມີຊ່ອງອອກແບບ 'ເປີດ' ໜຶ່ງຊ່ອງ ແລະ 'ປິດ' ໜຶ່ງຊ່ອງ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_call_flow.py:0
msgid ""
"A Time Condition outside Start must have its Open output connected to a Call "
"Group or Queue."
msgstr ""
"ເງື່ອນໄຂເວລາທີ່ຢູ່ນອກຈຸດເລີ່ມຕົ້ນ ຕ້ອງມີຊ່ອງອອກແບບ 'ເປີດ' ເຊື່ອມຕໍ່ກັບກຸ່ມສາຍໂທ ຫຼື ຄິວ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_call_flow.py:0
msgid "A destination used by the Call Flow no longer exists."
msgstr "ປາຍທາງທີ່ໃຊ້ໂດຍຜັງສາຍໂທບໍ່ມີຢູ່ນຳອີກແລ້ວ."

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/core/web/audio_manager.js:0
msgid ""
"A hardware error has occurred while trying to access the audio recording "
"device. Please ensure that your computer is up to date (e.g. the drivers) "
"and try again."
msgstr ""
"ເກີດຂໍ້ຜິດພາດທາງຮາດແວຂະນະພະຍາຍາມເຂົ້າເຖິງອຸປະກອນບັນທຶກສຽງ. ກະລຸນາກວດສອບວ່າຄອມພິວເຕີຂອງທ່ານໄດ້"
"ອັບເດດແລ້ວ (ເຊັ່ນ: ໄດຣເວີ) ແລ້ວລອງໃໝ່ອີກຄັ້ງ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_voicemail.py:0
msgid "A mailbox cannot be changed between personal and shared."
