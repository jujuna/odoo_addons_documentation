#. module: voip
#: model_terms:ir.ui.view,arch_db:voip.voip_res_users_settings_view_form
msgid "e.g. 1000"
msgstr "ເຊັ່ນ: 1000"

#. module: voip
#: model_terms:ir.ui.view,arch_db:voip.voip_voicemail_view_form
