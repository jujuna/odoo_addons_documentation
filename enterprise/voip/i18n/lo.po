#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_did_number.py:0
msgid "created"
msgstr "ສ້າງແລ້ວ"

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/softphone/status_menu.xml:0
msgid "credit_card"
msgstr "credit_card"

#. module: voip
#: model_terms:ir.ui.view,arch_db:voip.voip_did_number_search_wizard_form
msgid "credits now, then"
msgstr "ເຄຣດິດຕອນນີ້, ຈາກນັ້ນ"

#. module: voip
#: model_terms:ir.ui.view,arch_db:voip.voip_did_number_search_wizard_form
msgid "credits/month"
msgstr "ເຄຣດິດ/ເດືອນ"

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/softphone/status_menu.xml:0
msgid "dialpad"
msgstr "dialpad"

