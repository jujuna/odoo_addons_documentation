msgstr "ID ກຸ່ມຂໍ້ກຳນົດ Telnyx ຕ້ອງບໍ່ຊ້ຳກັນ!"

#. module: voip
#: model:ir.model.fields,help:voip.field_voip_ivr__tts_voice
#: model:ir.model.fields,help:voip.field_voip_sound__tts_voice
msgid "Telnyx voice identifier used to generate the audio."
msgstr "ຕົວລະບຸສຽງຂອງ Telnyx ທີ່ໃຊ້ສ້າງສຽງເວົ້າ."

#. module: voip
#: model:ir.model.fields,field_description:voip.field_voip_ivr__tts_text
#: model:ir.model.fields,field_description:voip.field_voip_sound__tts_text
#: model:ir.model.fields.selection,name:voip.selection__voip_requirement__field_type__textual
msgid "Text"
msgstr "ຂໍ້ຄວາມ"

#. module: voip
#: model:ir.model.fields,field_description:voip.field_voip_requirement__text_value
msgid "Text Value"
msgstr "ຄ່າຂໍ້ຄວາມ"

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_sound.py:0
msgid "Text and Voice are required to generate audio."
msgstr "ຕ້ອງມີຂໍ້ຄວາມ ແລະ ສຽງເວົ້າເພື່ອສ້າງສຽງ."

#. module: voip
#: model:ir.model.fields,help:voip.field_voip_ivr__tts_text
#: model:ir.model.fields,help:voip.field_voip_sound__tts_text
msgid "Text that will be synthesized into an audio file."
msgstr "ຂໍ້ຄວາມທີ່ຈະຖືກສັງເຄາະເປັນໄຟລ໌ສຽງ."

#. module: voip
#: model:ir.model.fields.selection,name:voip.selection__voip_sound__source_type__tts
msgid "Text-to-speech"
msgstr "ການແປງຂໍ້ຄວາມເປັນສຽງເວົ້າ (Text-to-speech)"

#. module: voip
#. odoo-python
#: code:addons/voip/models/pbx_service.py:0
msgid "The %(model)s model is not a supported PBX destination."
msgstr "ໂມເດວ %(model)s ບໍ່ແມ່ນປາຍທາງ PBX ທີ່ຮອງຮັບ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_call_flow.py:0
msgid "The %(node_type)s node has an invalid destination."
msgstr "ໂນດ %(node_type)s ມີປາຍທາງທີ່ບໍ່ຖືກຕ້ອງ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_call_flow.py:0
msgid "The Call Flow contains a duplicate connection."
msgstr "Call Flow ມີການເຊື່ອມຕໍ່ທີ່ຊ້ຳຊ້ອນ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_call_flow.py:0
msgid "The Call Flow contains an invalid connection."
msgstr "Call Flow ມີການເຊື່ອມຕໍ່ທີ່ບໍ່ຖືກຕ້ອງ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_call_flow.py:0
msgid "The Call Flow contains an unsupported node."
msgstr "Call Flow ມີໂນດທີ່ບໍ່ຮອງຮັບ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_call_flow.py:0
msgid "The Call Flow graph must be an object."
msgstr "ກຣາຟ Call Flow ຕ້ອງເປັນ object."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_call_flow.py:0
msgid "The Call Flow graph must contain nodes and connections."
msgstr "ກຣາຟ Call Flow ຕ້ອງປະກອບມີໂນດ ແລະ ການເຊື່ອມຕໍ່."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_call_flow.py:0
msgid "The Call Flow must contain exactly one Start node."
msgstr "Call Flow ຕ້ອງມີໂນດເລີ່ມຕົ້ນ (Start node) ພຽງໂນດດຽວເທົ່ານັ້ນ."

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/core/web/session.js:0
msgid ""
"The DTLS fingerprint and/or setup is missing from the SDP. Verify that the "
"VoIP provider is configured to use SRTP-DTLS."
msgstr ""
"DTLS fingerprint ແລະ/ຫຼື setup ບໍ່ມີໃນ SDP. ກະລຸນາກວດສອບວ່າຜູ້ໃຫ້ບໍລິການ VoIP ໄດ້ຖືກຕັ້ງຄ່າໃຫ້ນ"
"ຳໃຊ້ SRTP-DTLS ແລ້ວ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_call_group.py:0
msgid "The Group timeout cannot be negative."
msgstr "ເວລາໝົດກຳນົດຂອງກຸ່ມບໍ່ສາມາດຕິດລົບໄດ້."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_call_group.py:0
msgid "The Group user timeout must be positive."
msgstr "ເວລາໝົດກຳນົດຂອງຜູ້ໃຊ້ໃນກຸ່ມຕ້ອງເປັນຄ່າບວກ."

#. module: voip
#: model:ir.model.fields,help:voip.field_voip_provider__pbx_ip
msgid "The IP address of your PBX Server"
msgstr "ທີ່ຢູ່ IP ຂອງເຊີບເວີ PBX ຂອງທ່ານ"

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_ivr.py:0
msgid "The IVR option must contain only digits, '*' or '#'."
msgstr "ຕົວເລືອກ IVR ຕ້ອງປະກອບມີສະເພາະຕົວເລກ, '*' ຫຼື '#' ເທົ່ານັ້ນ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/phone_service_api.py:0
msgid ""
"The Odoo Phone Service could not authenticate with the PBX. Please contact "
"Odoo support if the problem persists."
msgstr ""
"ບໍລິການ Odoo Phone ບໍ່ສາມາດຢັ້ງຢືນຕົວຕົນກັບ PBX ໄດ້. ກະລຸນາຕິດຕໍ່ຝ່າຍຊ່ວຍເຫຼືອ Odoo ຖ້າບັນຫາຍັງຄົງຢູ່."

#. module: voip
#. odoo-python
#: code:addons/voip/models/phone_service_api.py:0
msgid ""
"The Odoo Phone Service is temporarily unavailable. Please try again later."
msgstr "ບໍລິການ Odoo Phone ບໍ່ພ້ອມໃຊ້ງານຊົ່ວຄາວ. ກະລຸນາລອງໃໝ່ພາຍຫຼັງ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_sound.py:0
msgid "The Odoo Phone Service returned an empty audio file."
msgstr "ບໍລິການ Odoo Phone ສົ່ງໄຟລ໌ສຽງທີ່ວ່າງເປົ່າກັບຄືນມາ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_did_number_request.py:0
msgid ""
"The Odoo Phone Service returned an invalid number request. Please try again "
"later."
msgstr ""
"ບໍລິການ Odoo Phone ສົ່ງຄຳຂໍເບີທີ່ບໍ່ຖືກຕ້ອງກັບຄືນມາ. ກະລຸນາລອງໃໝ່ພາຍຫຼັງ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_call_flow_member_mixin.py:0
msgid ""
"The PBX destinations of records used in a Call Flow can only be modified "
"from that Call Flow."
msgstr ""
"ປາຍທາງ PBX ຂອງຂໍ້ມູນທີ່ໃຊ້ໃນ Call Flow ສາມາດແກ້ໄຂໄດ້ຈາກ Call Flow ນັ້ນເທົ່ານັ້ນ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/phone_service_api.py:0
msgid "The PBX operation could not be completed. Please try again later."
msgstr "ການເຮັດວຽກຂອງ PBX ບໍ່ສຳເລັດ. ກະລຸນາລອງໃໝ່ພາຍຫຼັງ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/phone_service_api.py:0
msgid "The Phone Service endpoint host %(host)s is not an allowed Odoo host."
msgstr ""
"endpoint host ຂອງ Phone Service %(host)s ບໍ່ແມ່ນ host ຂອງ Odoo ທີ່ໄດ້ຮັບອະນຸຍາດ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/phone_service_api.py:0
msgid "The Phone Service endpoint must be a valid HTTPS URL."
msgstr "endpoint ຂອງ Phone Service ຕ້ອງເປັນ URL HTTPS ທີ່ຖືກຕ້ອງ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_call_flow.py:0
msgid "The Start node must be connected to exactly one node."
msgstr "ໂນດເລີ່ມຕົ້ນ (Start node) ຕ້ອງເຊື່ອມຕໍ່ກັບພຽງແຕ່ໂນດດຽວເທົ່ານັ້ນ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_call_flow.py:0
msgid "The Start node must have exactly one output and no input."
msgstr "ໂນດເລີ່ມຕົ້ນ (Start node) ຕ້ອງມີຂາອອກພຽງອັນດຽວ ແລະ ບໍ່ມີຂາເຂົ້າ."

#. module: voip
#: model:ir.model.fields,help:voip.field_voip_provider__ws_server
msgid "The URL of your WebSocket"
msgstr "URL ຂອງ WebSocket ຂອງທ່ານ"

#. module: voip
#. odoo-python
#: code:addons/voip/models/ir_config_parameter.py:0
msgid ""
"The VoIP webhook URL could not be synchronized with the Phone Service. It "
"will be retried automatically."
msgstr ""
"ບໍ່ສາມາດຊິ້ງ URL ຂອງ VoIP webhook ກັບ Phone Service ໄດ້. ລະບົບຈະລອງໃໝ່ໂດຍອັດຕະໂນມັດ."

#. module: voip
#. odoo-python
#: code:addons/voip/tools/wav.py:0
msgid "The WAV file must be uncompressed (PCM)."
msgstr "ໄຟລ໌ WAV ຕ້ອງບໍ່ຖືກບີບອັດ (PCM)."

#. module: voip
#. odoo-python
#: code:addons/voip/tools/wav.py:0
msgid "The WAV file must use 8, 16, or 32-bit samples."
msgstr "ໄຟລ໌ WAV ຕ້ອງໃຊ້ sample ຂະໜາດ 8, 16, ຫຼື 32-bit."

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/core/web/user_agent.js:0
msgid "The WebSocket connection was lost and couldn't be reestablished."
msgstr "ການເຊື່ອມຕໍ່ WebSocket ຫຼຸດ ແລະ ບໍ່ສາມາດເຊື່ອມຕໍ່ຄືນໃໝ່ໄດ້."

#. module: voip
#. odoo-python
#: code:addons/voip/models/phone_service_api.py:0
msgid ""
"The address could not be saved. Please verify that all fields are correct."
msgstr "ບໍ່ສາມາດບັນທຶກທີ່ຢູ່ໄດ້. ກະລຸນາກວດສອບວ່າທຸກຊ່ອງຂໍ້ມູນຖືກຕ້ອງ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_requirement.py:0
msgid "The address could not be validated by the provider."
msgstr "ຜູ້ໃຫ້ບໍລິການບໍ່ສາມາດກວດສອບຢັ້ງຢືນທີ່ຢູ່ນີ້ໄດ້."

#. module: voip
#. odoo-python
#: code:addons/voip/models/phone_service_api.py:0
msgid "The address is invalid."
msgstr "ທີ່ຢູ່ບໍ່ຖືກຕ້ອງ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/phone_service_api.py:0
msgid "The borough is invalid."
msgstr "ເຂດ/ເທດສະບານບໍ່ຖືກຕ້ອງ."

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/core/web/session.js:0
msgid "The call could not be established due to a configuration issue."
msgstr "ບໍ່ສາມາດເຊື່ອມຕໍ່ສາຍໂທໄດ້ ເນື່ອງຈາກບັນຫາການກຳນົດຄ່າ."

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/widgets/call_status_badge_field.js:0
msgid "The call ended successfully."
msgstr "ສິ້ນສຸດສາຍໂທສຳເລັດແລ້ວ."

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/widgets/call_status_badge_field.js:0
msgid "The call was answered on another device."
msgstr "ມີການຮັບສາຍໃນອຸປະກອນອື່ນແລ້ວ."

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/widgets/call_status_badge_field.js:0
msgid "The callee did not pick up."
msgstr "ຜູ້ຮັບສາຍບໍ່ໄດ້ຮັບສາຍ."

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/widgets/call_status_badge_field.js:0
msgid "The callee pressed the hangup key while ringing."
msgstr "ຜູ້ຮັບສາຍໄດ້ກົດວາງສາຍໃນຂະນະທີ່ສຽງກຳລັງດັງ."

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/widgets/call_status_badge_field.js:0
msgid "The callee's phone is ringing right now."
msgstr "ໂທລະສັບຂອງຜູ້ຮັບສາຍກຳລັງດັງຢູ່ໃນຕອນນີ້."

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/widgets/call_status_badge_field.js:0
msgid "The caller ended the call before pickup."
msgstr "ຜູ້ໂທໄດ້ວາງສາຍກ່ອນທີ່ຈະມີການຮັບສາຍ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/phone_service_api.py:0
msgid "The city is invalid."
msgstr "ເມືອງບໍ່ຖືກຕ້ອງ."

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/core/web/registerer.js:0
msgid ""
"The connection failed. Please try again later. If the problem persists, "
"please ask your administrator to check the configuration."
msgstr ""
"ການເຊື່ອມຕໍ່ບໍ່ສຳເລັດ. ກະລຸນາລອງໃໝ່ພາຍຫຼັງ. ຖ້າບັນຫາຍັງຄົງຢູ່ ກະລຸນາຕິດຕໍ່ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານເພື່ອກວດສ"
"ອບການຕັ້ງຄ່າ."

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/core/web/registerer.js:0
msgid ""
"The connection failed. Your login or provider details in your user "
"preferences for the phone might be incorrect. Please check or ask your "
"administrator to check if needed."
msgstr ""
"ການເຊື່ອມຕໍ່ບໍ່ສຳເລັດ. ຂໍ້ມູນການເຂົ້າສູ່ລະບົບ ຫຼື ຂໍ້ມູນຜູ້ໃຫ້ບໍລິການໃນການຕັ້ງຄ່າສ່ວນຕົວສຳລັບໂທລະສັບຂອງທ່ານອາດ"
"ບໍ່ຖືກຕ້ອງ. ກະລຸນາກວດສອບ ຫຼື ຕິດຕໍ່ຜູ້ເບິ່ງແຍງລະບົບຫາກຕ້ອງການ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/pbx_service.py:0
msgid "The contact %(contact)s must have a valid phone number."
msgstr "ຜູ້ຕິດຕໍ່ %(contact)s ຕ້ອງມີເບີໂທລະສັບທີ່ຖືກຕ້ອງ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/phone_service_api.py:0
msgid "The country code is invalid."
msgstr "ລະຫັດປະເທດບໍ່ຖືກຕ້ອງ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_call_flow.py:0
msgid "The destination connected after Start no longer exists."
msgstr "ປາຍທາງທີ່ເຊື່ອມຕໍ່ຫຼັງຈາກ Start ບໍ່ມີຢູ່ນຳແລ້ວ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/phone_service_api.py:0
msgid ""
"The document could not be uploaded. Please check that the file is a "
"supported format (PDF, JPEG, or PNG)."
msgstr ""
"ບໍ່ສາມາດອັບໂຫຼດເອກະສານໄດ້. ກະລຸນາກວດສອບວ່າໄຟລ໌ຢູ່ໃນຮູບແບບທີ່ຮອງຮັບ (PDF, JPEG, ຫຼື PNG)."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_time_condition.py:0
msgid "The end time must be strictly after the start time."
msgstr "ເວລາສິ້ນສຸດຕ້ອງຢູ່ຫຼັງເວລາເລີ່ມຕົ້ນຢ່າງຊັດເຈນ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/phone_service_api.py:0
msgid "The extended address is invalid."
msgstr "ທີ່ຢູ່ເພີ່ມເຕີມບໍ່ຖືກຕ້ອງ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_extension.py:0
msgid "The extension number must be between 100 and 9999."
msgstr "ເບີພາຍໃນຕ້ອງຢູ່ລະຫວ່າງ 100 ຫາ 9999."

#. module: voip
#: model:ir.model.constraint,message:voip.constraint_voip_extension_number_unique
msgid "The extension number must be unique."
msgstr "ເບີພາຍໃນຕ້ອງບໍ່ຊ້ຳກັນ."

#. module: voip
#. odoo-python
#: code:addons/voip/tools/wav.py:0
msgid "The file must be a valid WAV file."
msgstr "ໄຟລ໌ຕ້ອງເປັນໄຟລ໌ WAV ທີ່ຖືກຕ້ອງ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_time_condition.py:0
msgid "The hours must be between 00:00 and 24:00."
msgstr "ຊົ່ວໂມງຕ້ອງຢູ່ລະຫວ່າງ 00:00 ຫາ 24:00."

#. module: voip
#. odoo-python
#: code:addons/voip/models/phone_service_api.py:0
msgid "The house number is invalid."
msgstr "ເລກທີເຮືອນບໍ່ຖືກຕ້ອງ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_voicemail.py:0
msgid "The mailbox number must be unique."
msgstr "ໝາຍເລກກ່ອງຂໍ້ຄວາມຕ້ອງບໍ່ຊ້ຳກັນ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_voicemail.py:0
msgid "The mailbox number must contain only digits."
msgstr "ໝາຍເລກກ່ອງຂໍ້ຄວາມຕ້ອງປະກອບມີສະເພາະຕົວເລກເທົ່ານັ້ນ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_ivr.py:0
msgid "The maximum number of tries must be positive."
msgstr "ຈຳນວນຄັ້ງສູງສຸດໃນການລອງໃໝ່ຕ້ອງເປັນຄ່າບວກ."

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/call_flow/call_flow_field.js:0
msgid "The module rejected this connection."
msgstr "ໂມດູນໄດ້ປະຕິເສດການເຊື່ອມຕໍ່ນີ້."

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/call_flow/call_flow_field.js:0
msgid "The module returned an invalid validation result."
msgstr "ໂມດູນໄດ້ສົ່ງຄືນຜົນການກວດສອບທີ່ບໍ່ຖືກຕ້ອງ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/phone_service_api.py:0
msgid "The neighborhood is invalid."
msgstr "ບໍລິເວນໃກ້ຄຽງ/ເຂດບ້ານບໍ່ຖືກຕ້ອງ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/res_users_settings.py:0
msgid "The no answer timeout must be positive."
msgstr "ເວລາລໍຖ້າເມື່ອບໍ່ມີການຕອບຮັບຕ້ອງເປັນຄ່າບວກ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_call_flow.py:0
msgid "The node connected after Start has an invalid destination."
msgstr "ໂນດທີ່ເຊື່ອມຕໍ່ຫຼັງຈາກ Start ມີປາຍທາງທີ່ບໍ່ຖືກຕ້ອງ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_call_flow.py:0
msgid "The node connected after Start has no destination."
msgstr "ໂນດທີ່ເຊື່ອມຕໍ່ຫຼັງຈາກ Start ບໍ່ມີປາຍທາງ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_call_flow.py:0
msgid "The node connected after Start is invalid."
msgstr "ໂນດທີ່ເຊື່ອມຕໍ່ຫຼັງຈາກ Start ບໍ່ຖືກຕ້ອງ."

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/core/web/session.js:0
msgid ""
"The number appears to be invalid. If you believe it is valid, check that "
"your VoIP configuration is correct."
msgstr ""
"ເບີດັ່ງກ່າວເບິ່ງຄືວ່າບໍ່ຖືກຕ້ອງ. ຖ້າທ່ານໝັ້ນໃຈວ່າມັນຖືກຕ້ອງ, ກະລຸນາກວດສອບວ່າການກຳນົດຄ່າ VoIP ຂອງທ່ານຖືກ"
"ຕ້ອງແລ້ວ."

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/core/web/session.js:0
msgid "The number you dialed seems to be incorrect, unavailable, or blocked."
msgstr "ເບີທີ່ທ່ານໂທເບິ່ງຄືວ່າບໍ່ຖືກຕ້ອງ, ບໍ່ພ້ອມໃຫ້ບໍລິການ, ຫຼື ຖືກບລັອກ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_ivr.py:0
msgid ""
"The options of an IVR used in a Call Flow can only be modified from that "
"Call Flow."
msgstr ""
"ຕົວເລືອກຂອງ IVR ທີ່ໃຊ້ໃນ Call Flow ສາມາດແກ້ໄຂໄດ້ຈາກ Call Flow ນັ້ນເທົ່ານັ້ນ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_did_number.py:0
msgid ""
"The order for your phone number %(number)s could not be completed. You can "
"find more details on the phone number."
msgstr ""
"ການສັ່ງຊື້ເບີໂທລະສັບ %(number)s ຂອງທ່ານບໍ່ສຳເລັດ. ທ່ານສາມາດເບິ່ງລາຍລະອຽດເພີ່ມເຕີມໄດ້ທີ່ເບີໂທລະສັບ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_did_number.py:0
msgid ""
"The order for your phone number %(number)s has been received and is under "
"review. The documents you have submitted are being evaluated. You will be "
"notified if we need more information to complete the order."
msgstr ""
"ໄດ້ຮັບຄຳສັ່ງຊື້ເບີໂທລະສັບ %(number)s ຂອງທ່ານແລ້ວ ແລະ ພວມຢູ່ໃນຂັ້ນຕອນການກວດສອບ. ເອກະສານທີ່ທ່ານສົ່"
"ງມາກຳລັງໄດ້ຮັບການປະເມີນ. ພວກເຮົາຈະແຈ້ງເຕືອນໃຫ້ທ່ານຊາບ ຖ້າຕ້ອງການຂໍ້ມູນເພີ່ມເຕີມເພື່ອເຮັດໃຫ້ການສັ່ງຊື້ສ"
"ຳເລັດ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_did_number.py:0
msgid ""
"The order for your phone number %(number)s is complete. Your number is now "
"active and you can assign it."
msgstr ""
"ການສັ່ງຊື້ເບີໂທລະສັບ %(number)s ຂອງທ່ານສຳເລັດແລ້ວ. ຕອນນີ້ເບີຂອງທ່ານເປີດໃຊ້ງານແລ້ວ ແລະ ທ່ານສາມາ"
"ດກຳນົດໃຫ້ນຳໃຊ້ໄດ້."

#. module: voip
#: model:ir.model.fields,help:voip.field_res_partner__t9_name
#: model:ir.model.fields,help:voip.field_res_users__t9_name
msgid ""
"The partner's name, encoded as the digits that correspond to the letters on "
"an old cell phone keypad.\n"
"Useful for searching for partners based on this field.\n"
"Spaces are preserved, characters that can't be encoded are replaced with an "
"'x'.\n"
"T9 stands for Text on 9 keys, it comes from the name of the original "
"technology on old cell phones."
msgstr ""
"ຊື່ຂອງຄູ່ຄ້າ, ຖືກເຂົ້າລະຫັດເປັນຕົວເລກທີ່ກົງກັບຕົວອັກສອນເທິງແປ້ນກົດໂທລະສັບມືຖືລຸ້ນເກົ່າ.\n"
"ມີປະໂຫຍດໃນການຄົ້ນຫາຄູ່ຄ້າໂດຍອີງໃສ່ຊ່ອງຂໍ້ມູນນີ້.\n"
"ການຍະຫວ່າງຈະຖືກຮັກສາໄວ້, ຕົວອັກສອນທີ່ບໍ່ສາມາດແປງໄດ້ຈະຖືກແທນທີ່ດ້ວຍ 'x'.\n"
"T9 ຫຍໍ້ມາຈາກ Text on 9 keys ເຊິ່ງມາຈາກຊື່ເທັກໂນໂລຢີດັ້ງເດີມເທິງໂທລະສັບມືຖືລຸ້ນເກົ່າ."

#. module: voip
#: model:ir.model.fields,help:voip.field_res_users_settings__voip_secret
msgid "The password that will be used to register with the PBX server."
msgstr "ລະຫັດຜ່ານທີ່ຈະໃຊ້ເພື່ອລົງທະບຽນກັບເຊີບເວີ PBX."

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/core/web/session.js:0
msgid "The person you are trying to contact is currently busy."
msgstr "ບຸກຄົນທີ່ທ່ານພະຍາຍາມຕິດຕໍ່ກຳລັງຕິດສາຍອື່ນຢູ່."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_did_number.py:0
msgid "The phone number could not be released."
msgstr "ບໍ່ສາມາດປ່ອຍເບີໂທລະສັບຄືນໄດ້."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_requirement.py:0
msgid "The phone number must be in international format (e.g. +32485200345)."
msgstr "ເບີໂທລະສັບຕ້ອງຢູ່ໃນຮູບແບບສາກົນ (ເຊັ່ນ: +32485200345)."

#. module: voip
#: model:ir.model.fields,help:voip.field_voip_provider__voicemail_code
msgid "The phone number or short code used to dial into the mailbox system."
msgstr "ເບີໂທລະສັບ ຫຼື ລະຫັດສັ້ນທີ່ໃຊ້ເພື່ອໂທເຂົ້າລະບົບກ່ອງຂໍ້ຄວາມສຽງ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_did_number.py:0
msgid "The phone number statuses are up to date."
msgstr "ສະຖານະເບີໂທລະສັບເປັນປັດຈຸບັນແລ້ວ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_did_number.py:0
msgid "The phone number was released."
msgstr "ປ່ອຍເບີໂທລະສັບຄືນແລ້ວ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_did_number.py:0
msgid "The phone service did not confirm the order for: %(numbers)s."
msgstr "ບໍລິການໂທລະສັບບໍ່ໄດ້ຢືນຢັນຄຳສັ່ງຊື້ສຳລັບ: %(numbers)s."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_requirement.py:0
msgid ""
"The phone service did not return an identity verification link. Please try "
"again."
msgstr "ບໍລິການໂທລະສັບບໍ່ໄດ້ສົ່ງລິ້ງຢັ້ງຢືນຕົວຕົນກັບຄືນມາ. ກະລຸນາລອງໃໝ່ອີກຄັ້ງ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/phone_service_api.py:0
msgid "The postal code is invalid."
msgstr "ລະຫັດໄປສະນີບໍ່ຖືກຕ້ອງ."

#. module: voip
#. odoo-javascript
#: code:addons/voip/static/src/widgets/audio_binary/audio_binary_field.js:0
msgid "The recording could not be converted to WAV."
msgstr "ບໍ່ສາມາດແປງສຽງທີ່ບັນທຶກໄວ້ເປັນ WAV ໄດ້."

#. module: voip
#. odoo-python
#: code:addons/voip/models/phone_service_api.py:0
msgid "The request sent to the Odoo Phone Service is incomplete."
msgstr "ຄຳຂໍທີ່ສົ່ງໄປຫາບໍລິການ Odoo Phone ບໍ່ຄົບຖ້ວນ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/phone_service_api.py:0
msgid "The request sent to the Odoo Phone Service is invalid."
msgstr "ຄຳຂໍທີ່ສົ່ງໄປຫາບໍລິການ Odoo Phone ບໍ່ຖືກຕ້ອງ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/phone_service_api.py:0
msgid ""
"The requested PBX resource was not found. It may have been deleted already."
msgstr "ບໍ່ພົບຊັບພະຍາກອນ PBX ທີ່ຮ້ອງຂໍ. ມັນອາດຈະຖືກລຶບໄປແລ້ວ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/phone_service_api.py:0
msgid "The requested update is invalid for the current resource state."
msgstr "ການອັບເດດທີ່ຮ້ອງຂໍບໍ່ຖືກຕ້ອງສຳລັບສະຖານະຂອງຊັບພະຍາກອນໃນປັດຈຸບັນ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_did_number.py:0
msgid ""
"The search result expired or the number became unavailable. Search again and "
"complete the purchase promptly. No credits were charged."
msgstr ""
"ຜົນການຄົ້ນຫາໝົດອາຍຸ ຫຼື ເບີນັ້ນບໍ່ຫວ່າງແລ້ວ. ກະລຸນາຄົ້ນຫາໃໝ່ ແລະ ເຮັດການຊື້ໃຫ້ສຳເລັດໂດຍໄວ. ບໍ່ມີການຮຽກເ"
"ກັບເຄຣດິດໃດໆ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/voip_ivr.py:0
msgid "The selected audio message no longer exists."
msgstr "ຂໍ້ຄວາມສຽງທີ່ເລືອກບໍ່ມີຢູ່ນຳແລ້ວ."

#. module: voip
#. odoo-python
#: code:addons/voip/models/res_users_settings.py:0
msgid "The selected destination does not match the destination kind."
