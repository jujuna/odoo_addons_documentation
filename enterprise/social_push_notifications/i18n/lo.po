#. odoo-javascript
#: code:addons/social_push_notifications/static/src/interactions/push_notification_request_interaction.js:0
msgid ""
"It looks like notifications are blocked by your browser. To stay updated, "
"please enable them in your browser settings!"
msgstr ""
"ເບິ່ງຄືວ່າການແຈ້ງເຕືອນຖືກບລັອກໂດຍບຣາວເຊີຂອງທ່ານ. ເພື່ອຕິດຕາມຂໍ້ມູນໃໝ່ໆ, ກະລຸນາເປີດນຳໃຊ້ໃນການຕັ້ງຄ່າບ"
"ຣາວເຊີຂອງທ່ານ!"

#. module: social_push_notifications
#. odoo-javascript
#: code:addons/social_push_notifications/static/src/interactions/push_notification_request_interaction.js:0
msgid ""
"It looks like notifications aren't enabled in your browser. To stay updated, "
"please enable them in your browser settings!"
msgstr ""
"ເບິ່ງຄືວ່າການແຈ້ງເຕືອນຍັງບໍ່ໄດ້ເປີດເທື່ອໃນບຣາວເຊີຂອງທ່ານ. ເພື່ອຕິດຕາມຂໍ້ມູນໃໝ່ໆ, ກະລຸນາເປີດນຳໃຊ້ໃນການຕັ້"
"ງຄ່າບຣາວເຊີຂອງທ່ານ!"

#. module: social_push_notifications
#: model:ir.model.fields,help:social_push_notifications.field_website_visitor_push_subscription__keys
msgid ""
"It refer to browser keys used by the notification: \n"
"- p256dh: It's the subscription public key generated by the browser. The "
"browser will \n"
"          keep the private key secret and use it for decrypting the payload\n"
"- auth: The auth value should be treated as a secret and not shared outside "
"of Odoo"
msgstr ""
"ໝາຍເຖິງຄີຂອງບຣາວເຊີທີ່ໃຊ້ໃນການແຈ້ງເຕືອນ: \n"
"- p256dh: ແມ່ນ Public Key ສຳລັບການສະໝັກທີ່ສ້າງຂຶ້ນໂດຍບຣາວເຊີ. ບຣາວເຊີຈະ \n"
"          ຮັກສາ Private Key ໄວ້ເປັນຄວາມລັບ ແລະ ໃຊ້ມັນເພື່ອຖອດລະຫັດຂໍ້ມູນ (Payload)\n"
"- auth: ຄ່າ Auth ນີ້ຄວນເກັບໄວ້ເປັນຄວາມລັບ ແລະ ບໍ່ຄວນເປີດເຜີຍອອກນອກ Odoo"

