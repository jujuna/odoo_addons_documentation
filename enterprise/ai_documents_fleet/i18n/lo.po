#. module: ai_documents_fleet
#. odoo-python
#: code:addons/ai_documents_fleet/wizard/ai_documents_sort.py:0
msgid ""
"If the document contains license plate number, link the document with the "
"vehicle with the same license plate."
msgstr ""
"ຖ້າຫາກເອກະສານມີໝາຍເລກທະບຽນ, ໃຫ້ເຊື່ອມຕໍ່ເອກະສານດັ່ງກ່າວໃສ່ກັບພາຫະນະທີ່ມີໝາຍເລກທະບຽນດຽວກັນ."

#. module: ai_documents_fleet
#. odoo-python
#: code:addons/ai_documents_fleet/wizard/ai_documents_sort.py:0
msgid ""
"If the document is a traffic fine, move it to the %(fleet)s folder and link "
"it to the vehicle with the matching license plate."
msgstr ""
"ຖ້າຫາກເອກະສານແມ່ນໃບປັບໃໝການສັນຈອນ, ໃຫ້ຍ້າຍໄປໄວ້ໃນໂຟນເດີ %(fleet)s ແລະ ເຊື່ອມຕໍ່ໃສ່ກັບພາຫະນະ"
"ທີ່ມີໝາຍເລກທະບຽນກົງກັນ."

#. module: ai_documents_fleet
#: model:ir.actions.server,ai_tool_description:ai_documents_fleet.ir_actions_server_fleet_link
msgid "Link document to fleet vehicle"
msgstr "ເຊື່ອມຕໍ່ເອກະສານໃສ່ພາຫະນະ"

#. module: ai_documents_fleet
#. odoo-python
#: code:addons/ai_documents_fleet/models/documents_document.py:0
msgid "This document is already linked to a vehicle."
msgstr "ເອກະສານນີ້ໄດ້ຖືກເຊື່ອມຕໍ່ໃສ່ກັບພາຫະນະແລ້ວ."

#. module: ai_documents_fleet
#. odoo-python
#: code:addons/ai_documents_fleet/models/documents_document.py:0
msgid "Vehicle not found: %s"
msgstr "ບໍ່ພົບເຫັນພາຫະນະ: %s"

