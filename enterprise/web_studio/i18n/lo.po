msgstr "ບໍ່ມີເມທອດ %(method)s ໃນຕົວແບບ %(model_name)s (%(model_id)s)"

#. module: web_studio
#. odoo-javascript
#: code:addons/web_studio/static/src/client_action/report_editor/report_editor_components.js:0
