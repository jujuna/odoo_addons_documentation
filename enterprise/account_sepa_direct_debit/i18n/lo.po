"                    <span style=\"font-size: 10px;\">Your Direct Debit "
"Payment Notification</span><br/>\n"
"                </td></tr>\n"
"                <tr><td valign=\"middle\" align=\"right\" t-if=\"not "
"company.uses_default_logo\">\n"
"                    <img t-attf-src=\"/logo.png?company={{ company.id }}\" "
"style=\"padding: 0px; margin: 0px; height: auto; width: 80px;\" t-att-"
"alt=\"company.name\"/>\n"
"                </td></tr>\n"
"                <tr><td colspan=\"2\" style=\"text-align:center;\">\n"
"                    <hr width=\"100%\" style=\"background-"
