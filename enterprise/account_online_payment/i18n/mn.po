#. module: account_online_payment
#: model:mail.template,body_html:account_online_payment.mail_template_account_payment_activation
msgid ""
"<div style=\"font-size: 14px;\">\n"
"                    <p>Hi there,</p>\n"
"                    <p>We see you haven't activated your payments feature in "
"Odoo yet. By enabling it, you'll be able to process payments directly and "
"efficiently through your Odoo account.</p>\n"
"                    <p>Of course, if you've already activated payments since "
"receiving this email, you can simply ignore this message.</p>\n"
"                    <p>Ready to get started? Activate your payments here! "
"You can also complete this setup later by visiting your scheduled activities "
"within Odoo.</p>\n"
"                    <div style=\"margin:16px auto; text-align:center\">\n"
"                        <a t-att-href=\"ctx.get('url')\" t-attf-"
"style=\"padding: 8px 16px 8px 16px; border-radius: 3px; background-color: "
"{{object.company_id.email_secondary_color or '#875A7B'}}; text-align:center; "
"text-decoration:none; color: {{object.company_id.email_primary_color or "
"'#FFFFFF'}};\">\n"
"                            Activate payments\n"
"                        </a>\n"
"                    </div>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"font-size: 14px;\">\n"
"                    <p>Сайн байна уу,</p>\n"
"                    <p>Та Odoo дахь төлбөрийн боломжоо хараахан "
"идэвхжүүлээгүй байна. Үүнийг идэвхжүүлснээр Odoo бүртгэлээрээ дамжуулан "
"төлбөрөө шууд бөгөөд үр ашигтай гүйцэтгэх боломжтой болно.</p>\n"
"                    <p>Хэрэв та энэ имэйлийг хүлээн авснаас хойш төлбөрөө "
"аль хэдийн идэвхжүүлсэн бол энэ зурвасыг үл тоомсорлож болно.</p>\n"
"                    <p>Эхлэхэд бэлэн үү? Төлбөрөө эндээс идэвхжүүлээрэй! Мөн "
"энэ тохиргоог дараа нь Odoo дахь төлөвлөсөн ажилбаруудаасаа гүйцээж болно.</"
"p>\n"
"                    <div style=\"margin:16px auto; text-align:center\">\n"
"                        <a t-att-href=\"ctx.get('url')\" t-attf-"
"style=\"padding: 8px 16px 8px 16px; border-radius: 3px; background-color: {"
"{object.company_id.email_secondary_color or '#875A7B'}}; text-align:center; "
"text-decoration:none; color: {{object.company_id.email_primary_color or "
"'#FFFFFF'}};\">\n"
"                            Төлбөр идэвхжүүлэх\n"
"                        </a>\n"
"                    </div>\n"
"                </div>\n"
"            "

#. module: account_online_payment
#: model:mail.template,body_html:account_online_payment.mail_template_account_payment_activation_success
msgid ""
"<div style=\"font-size: 14px;\">\n"
"                    <p>Hi there,</p>\n"
"                    <p>We're pleased to inform you that the payments feature "
"in Odoo has been successfully activated. </p>\n"
"                    <p>You can now process payments directly through your "
"Odoo database, ensuring faster, more secure, and more efficient transactions."
"</p>\n"
"                    <div style=\"margin:16px auto; text-align:center\">\n"
"                        <a t-att-href=\"object.get_base_url()\" t-attf-"
"style=\"padding: 8px 16px 8px 16px; border-radius: 3px; background-color: "
"{{object.company_id.email_secondary_color or '#875A7B'}}; text-align:center; "
"text-decoration:none; color: {{object.company_id.email_primary_color or "
"'#FFFFFF'}};\">\n"
"                            Make Payments\n"
"                        </a>\n"
"                    </div>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"font-size: 14px;\">\n"
"                    <p>Сайн байна уу,</p>\n"
"                    <p>Odoo дахь төлбөрийн боломж амжилттай идэвхжсэнийг "
"дуулгахад таатай байна. </p>\n"
"                    <p>Одоо та Odoo өгөгдлийн сангаараа дамжуулан төлбөрөө "
"шууд гүйцэтгэж, илүү хурдан, аюулгүй, үр ашигтай гүйлгээ хийх боломжтой.</p>"
"\n"
"                    <div style=\"margin:16px auto; text-align:center\">\n"
"                        <a t-att-href=\"object.get_base_url()\" t-attf-"
"style=\"padding: 8px 16px 8px 16px; border-radius: 3px; background-color: {"
"{object.company_id.email_secondary_color or '#875A7B'}}; text-align:center; "
"text-decoration:none; color: {{object.company_id.email_primary_color or "
"'#FFFFFF'}};\">\n"
"                            Төлбөр хийх\n"
"                        </a>\n"
"                    </div>\n"
"                </div>\n"
"            "

