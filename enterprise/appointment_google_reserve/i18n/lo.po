"<span class=\"oi oi-fw me-1\" data-icon=\"check\"/>\n"
"                                <span>Your Google Reserve Synchronization is "
"active. </span>"
msgstr ""
"<span class=\"oi oi-fw me-1\" data-icon=\"check\"/>\n"
"                                <span>ການຊິງຄ໌ Google Reserve ຂອງທ່ານເປີດໃຊ້ງານຢູ່. "
"</span>"

#. module: appointment_google_reserve
#: model_terms:ir.ui.view,arch_db:appointment_google_reserve.appointment_type_view_form
msgid ""
"<span class=\"oi oi-fw me-1\" data-icon=\"map\"/>\n"
"                                <span>Synchronize your establishment with "
"Google Reserve. </span>"
msgstr ""
"<span class=\"oi oi-fw me-1\" data-icon=\"map\"/>\n"
"                                <span>ຊິງຄ໌ສະຖານປະກອບການຂອງທ່ານກັບ Google "
