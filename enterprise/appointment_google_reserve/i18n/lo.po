#. module: appointment_google_reserve
#. odoo-python
#: code:addons/appointment_google_reserve/models/appointment_type.py:0
msgid ""
"%(appointment_type_name)s: A %(appointment_category)s appointment type "
"cannot be used with the Google Bookings integration."
msgstr ""
"%(appointment_type_name)s: ປະເພດການນັດໝາຍ %(appointment_category)s ບໍ່ສາມາດນຳໃຊ້ກັ"
"ບການເຊື່ອມໂຍງ Google Bookings ໄດ້."

#. module: appointment_google_reserve
#. odoo-python
#: code:addons/appointment_google_reserve/models/appointment_type.py:0
msgid ""
"%(appointment_type_name)s: Please configure your Google Reserve Merchant for "
"Google Reserve."
msgstr ""
"%(appointment_type_name)s: ກະລຸນາກຳນົດຄ່າຜູ້ຄ້າ Google Reserve ຂອງທ່ານສຳລັບ Google "
"Reserve."

#. module: appointment_google_reserve
#. odoo-python
#: code:addons/appointment_google_reserve/models/appointment_type.py:0
msgid ""
"%(appointment_type_name)s: The Google Bookings integration only works in the "
"auto-assign mode."
msgstr ""
"%(appointment_type_name)s: ການເຊື່ອມໂຍງ Google Bookings ໃຊ້ວຽກໄດ້ສະເພາະໃນໂໝດມອບໝາ"
"ຍອັດຕະໂນມັດເທົ່ານັ້ນ."

#. module: appointment_google_reserve
#: model_terms:ir.ui.view,arch_db:appointment_google_reserve.appointment_type_view_form
msgid ""
"<i class=\"oi oi-filled ms-2\" data-icon=\"info\" title=\"Required for "
"Google Reserve\"/>"
msgstr ""
"<i class=\"oi oi-filled ms-2\" data-icon=\"info\" title=\"ຈຳເປັນສຳລັບ Google "
"Reserve\"/>"

#. module: appointment_google_reserve
#: model_terms:ir.ui.view,arch_db:appointment_google_reserve.appointment_type_view_form
msgid ""
"<span class=\"oi me-1\" data-icon=\"hourglass_empty\"/>Synchronization with "
"Google Reserve in progress. This can take up to 24 hours."
msgstr ""
"<span class=\"oi me-1\" data-icon=\"hourglass_empty\"/>ກຳລັງດຳເນີນການຊິງຄ໌ຂໍ້ມູນກັບ "
"Google Reserve. ການດຳເນີນການນີ້ອາດໃຊ້ເວລາສູງສຸດ 24 ຊົ່ວໂມງ."

#. module: appointment_google_reserve
#: model_terms:ir.ui.view,arch_db:appointment_google_reserve.appointment_type_view_form
