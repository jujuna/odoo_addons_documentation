<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pos_restauramt_appointment.JsonFieldResource" t-inherit="web.CharField">
        <xpath expr="//t[@t-if='this.props.readonly']//span" position="replace">
            <t t-set="usage" t-value="this.usage"/>
            <span t-if="usage" class="text-nowrap">
                <t t-out="usage.start"/> - <t t-out="usage.stop"/>
                <span class="text-muted ms-1 fst-italic">· <t t-out="usage.capacity"/>p</span>
            </span>
        </xpath>
    </t>
</templates>
