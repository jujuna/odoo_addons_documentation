#. module: delivery_iot
#: model:ir.module.module,description:base.module_delivery_iot
msgid ""
"\n"
"Allows using IoT devices, such as scales and printers, for delivery "
"operations.\n"
msgstr ""
"\n"
"ອະນຸຍາດໃຫ້ນຳໃຊ້ອຸປະກອນ IoT ເຊັ່ນ: ຊິງຊັ່ງ ແລະ ຈັກພິມ ສຳລັບການດຳເນີນງານການຈັດສົ່ງ.\n"

#. module: delivery_iot
#: model:ir.model.fields,field_description:delivery_iot.field_stock_put_in_pack__available_scale_ids
msgid "Available Scale"
msgstr "ຊິງຊັ່ງທີ່ມີຢູ່"

#. module: delivery_iot
#: model:ir.model.fields,help:delivery_iot.field_stock_picking_type__iot_scale_ids
msgid ""
"Choose the scales you want to use for this operation type. Those scales can "
"be used to weigh the packages created."
msgstr ""
"ເລືອກຊິງຊັ່ງທີ່ທ່ານຕ້ອງການນຳໃຊ້ສຳລັບປະເພດການດຳເນີນງານນີ້. ຊິງຊັ່ງເຫຼົ່ານັ້ນສາມາດນຳໃຊ້ເພື່ອຊັ່ງນ້ຳໜັກຫໍ່ເຄື່ອງ"
"ທີ່ສ້າງຂຶ້ນ."

#. module: delivery_iot
#: model_terms:ir.ui.view,arch_db:delivery_iot.view_picking_type_form_inherit
msgid "Connect Scale"
msgstr "ເຊື່ອມຕໍ່ຊິງຊັ່ງ"

#. module: delivery_iot
#. odoo-javascript
#: code:addons/delivery_iot/static/src/field_many2one_iot_scale.js:0
msgid "Could not get measurement from device"
msgstr "ບໍ່ສາມາດດຶງຄ່າການວັດແທກຈາກອຸປະກອນໄດ້"

#. module: delivery_iot
#: model:ir.model.fields,field_description:delivery_iot.field_iot_device__display_name
#: model:ir.model.fields,field_description:delivery_iot.field_stock_picking_type__display_name
#: model:ir.model.fields,field_description:delivery_iot.field_stock_put_in_pack__display_name
msgid "Display Name"
msgstr "ຊື່ສະແດງ"

#. module: delivery_iot
#: model_terms:ir.ui.view,arch_db:delivery_iot.view_picking_type_form_inherit
msgid "How to connect scales?"
msgstr "ວິທີເຊື່ອມຕໍ່ຊິງຊັ່ງ?"

#. module: delivery_iot
#: model:ir.model.fields,field_description:delivery_iot.field_iot_device__id
#: model:ir.model.fields,field_description:delivery_iot.field_stock_picking_type__id
#: model:ir.model.fields,field_description:delivery_iot.field_stock_put_in_pack__id
msgid "ID"
msgstr "ລະຫັດ"

#. module: delivery_iot
#: model:ir.model,name:delivery_iot.model_iot_device
msgid "IOT Device"
msgstr "ອຸປະກອນ IoT"

#. module: delivery_iot
#: model:ir.model.fields,field_description:delivery_iot.field_stock_put_in_pack__device_identifier
msgid "Identifier"
msgstr "ຕົວລະບຸ"

#. module: delivery_iot
#: model_terms:ir.ui.view,arch_db:delivery_iot.view_picking_type_form_inherit
msgid ""
"If you connect your scales through the IoT App, the\n"
"                            weight of the package will be set automatically "
"when\n"
"                            you do a \"Put in Pack\" operation.\n"
"                            <br/>"
msgstr ""
"ຖ້າທ່ານເຊື່ອມຕໍ່ຊິງຊັ່ງຂອງທ່ານຜ່ານແອັບ IoT,\n"
"                            ນ້ຳໜັກຂອງຫໍ່ເຄື່ອງຈະຖືກກຳນົດໂດຍອັດຕະໂນມັດເມື່ອ\n"
"                            ທ່ານເຮັດການດຳເນີນງານ \"ໃສ່ໃນຫໍ່\".\n"
"                            <br/>"

#. module: delivery_iot
#: model:ir.model.fields,field_description:delivery_iot.field_stock_put_in_pack__iot_id
msgid "IoT Box"
msgstr "ກ່ອງ IoT"

#. module: delivery_iot
#: model:ir.module.module,shortdesc:base.module_delivery_iot
msgid "IoT for Delivery"
msgstr "IoT ສຳລັບການຈັດສົ່ງ"

#. module: delivery_iot
#: model_terms:ir.ui.view,arch_db:delivery_iot.iot_device_view_form_inherit
msgid "Linked Operation Types"
msgstr "ປະເພດການດຳເນີນງານທີ່ເຊື່ອມໂຍງ"

#. module: delivery_iot
#. odoo-javascript
#: code:addons/delivery_iot/static/src/field_many2one_iot_scale.js:0
msgid "No IoT device configured."
msgstr "ບໍ່ມີການກຳນົດຄ່າອຸປະກອນ IoT."

#. module: delivery_iot
#: model:ir.model.fields,field_description:delivery_iot.field_iot_device__picking_type_ids
msgid "Operation Types"
msgstr "ປະເພດການດຳເນີນງານ"

#. module: delivery_iot
#: model:ir.model,name:delivery_iot.model_stock_picking_type
msgid "Picking Type"
msgstr "ປະເພດການເບີກຈ່າຍ"

#. module: delivery_iot
#: model:ir.model,name:delivery_iot.model_stock_put_in_pack
msgid "Put In Pack Wizard"
msgstr "ຕົວຊ່ວຍການໃສ່ໃນຫໍ່"

#. module: delivery_iot
#. odoo-javascript
#: code:addons/delivery_iot/static/src/field_many2one_iot_scale.xml:0
msgid "Read weight"
msgstr "ອ່ານນ້ຳໜັກ"

#. module: delivery_iot
#: model:ir.model.fields,field_description:delivery_iot.field_stock_put_in_pack__iot_device_id
msgid "Scale"
msgstr "ຊິງຊັ່ງ"

#. module: delivery_iot
#: model:ir.model.fields,field_description:delivery_iot.field_stock_picking_type__iot_scale_ids
#: model_terms:ir.ui.view,arch_db:delivery_iot.view_picking_type_form_inherit
msgid "Scales"
msgstr "ຊິງຊັ່ງ"

#. module: delivery_iot
#: model:ir.module.module,summary:base.module_delivery_iot
msgid "Use IoT devices in delivery operations"
msgstr "ນຳໃຊ້ອຸປະກອນ IoT ໃນການດຳເນີນງານການຈັດສົ່ງ"
