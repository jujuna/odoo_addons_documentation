msgstr "ບໍ່ມີໄຟລ໌ຄັດຕິດຖືກສົ່ງມາ"

#. module: account_bank_statement_import
#. odoo-python
#: code:addons/account_bank_statement_import/models/account_journal.py:0
msgid "No currency found matching '%s'."
msgstr "ບໍ່ພົບສະກຸນເງິນທີ່ກົງກັບ '%s'."

#. module: account_bank_statement_import
#. odoo-python
#: code:addons/account_bank_statement_import/models/account_bank_statement.py:0
msgid "No transactions matching your filters were found."
msgstr "ບໍ່ພົບລາຍການເຄື່ອນໄຫວທີ່ກົງກັບຕົວກັ່ນຕອງຂອງທ່ານ."

#. module: account_bank_statement_import
#. odoo-python
#: code:addons/account_bank_statement_import/models/account_bank_statement.py:0
msgid "Nothing to do here!"
msgstr "ບໍ່ມີຫຍັງຕ້ອງເຮັດຢູ່ບ່ອນນີ້!"

#. module: account_bank_statement_import
#. odoo-python
#: code:addons/account_bank_statement_import/models/account_bank_statement.py:0
msgid "Template for Bank Transactions"
msgstr "ແມ່ແບບສຳລັບລາຍການເຄື່ອນໄຫວທະນາຄານ"

#. module: account_bank_statement_import
#. odoo-python
#: code:addons/account_bank_statement_import/models/account_journal.py:0
msgid ""
"The account of this statement (%(account)s) is not the same as the journal (%"
"(journal)s)."
msgstr "ບັນຊີຂອງໃບລາຍງານນີ້ (%(account)s) ບໍ່ກົງກັບປຶ້ມບັນຊີ (%(journal)s)."

#. module: account_bank_statement_import
#. odoo-python
#: code:addons/account_bank_statement_import/models/account_journal.py:0
msgid ""
"The currency of the bank statement (%(code)s) is not the same as the "
"currency of the journal (%(journal)s)."
msgstr ""
"ສະກຸນເງິນຂອງໃບລາຍງານບັນຊີທະນາຄານ (%(code)s) ບໍ່ກົງກັບສະກຸນເງິນຂອງປຶ້ມບັນຊີ (%(journal)s)."

#. module: account_bank_statement_import
#. odoo-python
#: code:addons/account_bank_statement_import/models/account_journal.py:0
msgid ""
"This file doesn't contain any statement for account %s.\n"
"If it contains transactions for more than one account, it must be imported "
"on each of them."
msgstr ""
"ໄຟລ໌ນີ້ບໍ່ມີໃບລາຍງານໃດໆສຳລັບບັນຊີ %s.\n"
"ຖ້າມັນມີລາຍການເຄື່ອນໄຫວຫຼາຍກວ່າໜຶ່ງບັນຊີ, ຈະຕ້ອງໄດ້ນຳເຂົ້າແຍກໃສ່ແຕ່ລະບັນຊີ."

#. module: account_bank_statement_import
#. odoo-python
#: code:addons/account_bank_statement_import/models/account_journal.py:0
msgid ""
"This file doesn't contain any transaction for account %s.\n"
"If it contains transactions for more than one account, it must be imported "
"on each of them."
msgstr ""
"ໄຟລ໌ນີ້ບໍ່ມີລາຍການເຄື່ອນໄຫວໃດໆສຳລັບບັນຊີ %s.\n"
"ຖ້າມັນມີລາຍການເຄື່ອນໄຫວຫຼາຍກວ່າໜຶ່ງບັນຊີ, ຈະຕ້ອງໄດ້ນຳເຂົ້າແຍກໃສ່ແຕ່ລະບັນຊີ."

#. module: account_bank_statement_import
#. odoo-python
#: code:addons/account_bank_statement_import/models/account_journal.py:0
msgid ""
"This file only contains transactions with a zero amount. There is nothing to "
"import."
msgstr "ໄຟລ໌ນີ້ມີພຽງແຕ່ລາຍການທີ່ມີມູນຄ່າເປັນສູນ. ບໍ່ມີຂໍ້ມູນໃດໃຫ້ນຳເຂົ້າ."

#. module: account_bank_statement_import
#. odoo-python
#: code:addons/account_bank_statement_import/models/account_journal.py:0
msgid "View successfully imported statements"
msgstr "ເບິ່ງໃບລາຍງານທີ່ນຳເຂົ້າສຳເລັດແລ້ວ"

#. module: account_bank_statement_import
#. odoo-python
#: code:addons/account_bank_statement_import/models/account_journal.py:0
msgid "You already have imported that file."
msgstr "ທ່ານໄດ້ນຳເຂົ້າໄຟລ໌ນັ້ນແລ້ວ."

#. module: account_bank_statement_import
#. odoo-python
#: code:addons/account_bank_statement_import/models/account_journal.py:0
msgid "You have to set a Default Account for the journal: %s"
msgstr "ທ່ານຕ້ອງກຳນົດບັນຊີເລີ່ມຕົ້ນໃຫ້ກັບປຶ້ມບັນຊີ: %s"

#. module: account_bank_statement_import
#. odoo-python
#: code:addons/account_bank_statement_import/models/account_journal.py:0
msgid "You uploaded an invalid or empty file."
msgstr "ທ່ານໄດ້ອັບໂຫຼດໄຟລ໌ທີ່ບໍ່ຖືກຕ້ອງ ຫຼື ໄຟລ໌ຫວ່າງເປົ່າ."
