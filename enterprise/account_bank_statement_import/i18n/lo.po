#. module: account_bank_statement_import
#: model:ir.model.constraint,message:account_bank_statement_import.constraint_account_bank_statement_line_unique_import_id
msgid "A bank account transactions can be imported only once!"
msgstr "ລາຍການເຄື່ອນໄຫວບັນຊີທະນາຄານສາມາດນຳເຂົ້າໄດ້ພຽງຄັ້ງດຽວເທົ່ານັ້ນ!"

#. module: account_bank_statement_import
#: model:ir.module.module,shortdesc:base.module_account_bank_statement_import
msgid "Account Bank Statement Import"
msgstr "ການນຳເຂົ້າໃບລາຍງານບັນຊີທະນາຄານ"

#. module: account_bank_statement_import
#. odoo-python
#: code:addons/account_bank_statement_import/models/account_journal.py:0
msgid "All or part of the following file(s) could not be imported:\n"
msgstr "ທັງໝົດ ຫຼື ບາງສ່ວນຂອງໄຟລ໌ຕໍ່ໄປນີ້ບໍ່ສາມາດນຳເຂົ້າໄດ້:\n"

#. module: account_bank_statement_import
#. odoo-python
#: code:addons/account_bank_statement_import/models/account_journal.py:0
msgid ""
"All transactions in this file either have a zero amount or have already been "
"imported. There is nothing to import."
msgstr ""
"ທຸກໆລາຍການໃນໄຟລ໌ນີ້ອາດຈະມີມູນຄ່າເປັນສູນ ຫຼື ຖືກນຳເຂົ້າໄປແລ້ວ. ບໍ່ມີຂໍ້ມູນໃດໃຫ້ນຳເຂົ້າ."

#. module: account_bank_statement_import
#: model:ir.model,name:account_bank_statement_import.model_account_bank_statement_line
msgid "Bank Transaction"
msgstr "ລາຍການເຄື່ອນໄຫວທະນາຄານ"

#. module: account_bank_statement_import
#: model:ir.model,name:account_bank_statement_import.model_account_setup_bank_manual_config
msgid "Bank setup manual config"
msgstr "ການຕັ້ງຄ່າທະນາຄານດ້ວຍຕົນເອງ"

#. module: account_bank_statement_import
#. odoo-python
#: code:addons/account_bank_statement_import/models/account_journal.py:0
msgid ""
"Cannot find in which journal to import the statement for account %s. Please "
"configure the journal first."
msgstr ""
"ບໍ່ພົບປຶ້ມບັນຊີທີ່ຈະນຳເຂົ້າໃບລາຍງານສຳລັບບັນຊີ %s. ກະລຸນາ ຕັ້ງຄ່າປຶ້ມບັນຊີກ່ອນ."

#. module: account_bank_statement_import
#. odoo-python
#: code:addons/account_bank_statement_import/models/account_journal.py:0
msgid ""
"Cannot find in which journal to import this statement. Please manually "
"select a journal."
msgstr ""
"ບໍ່ພົບປຶ້ມບັນຊີທີ່ຈະນຳເຂົ້າໃບລາຍງານນີ້. ກະລຸນາເລືອກ ປຶ້ມບັນຊີດ້ວຍຕົນເອງ."

#. module: account_bank_statement_import
#. odoo-python
#: code:addons/account_bank_statement_import/models/account_bank_statement.py:0
msgid "Click \"New\" or upload a %s."
msgstr "ກົດ \"ສ້າງໃໝ່\" ຫຼື ອັບໂຫຼດ %s."

#. module: account_bank_statement_import
#. odoo-python
#: code:addons/account_bank_statement_import/models/account_journal.py:0
msgid ""
"Could not make sense of the given file.\n"
"Did you install the module to support this type of file?"
msgstr ""
"ບໍ່ສາມາດອ່ານ ຫຼື ປະມວນຜົນໄຟລ໌ທີ່ໃຫ້ມານີ້ໄດ້.\n"
"ທ່ານໄດ້ຕິດຕັ້ງໂມດູນເພື່ອຮອງຮັບໄຟລ໌ປະເພດນີ້ແລ້ວບໍ່?"

#. module: account_bank_statement_import
#: model:ir.model.fields,field_description:account_bank_statement_import.field_account_bank_statement_line__display_name
#: model:ir.model.fields,field_description:account_bank_statement_import.field_account_journal__display_name
#: model:ir.model.fields,field_description:account_bank_statement_import.field_account_setup_bank_manual_config__display_name
msgid "Display Name"
msgstr "ຊື່ສະແດງ"

#. module: account_bank_statement_import
#: model:ir.module.module,description:base.module_account_bank_statement_import
msgid ""
"Generic Wizard to Import Bank Statements.\n"
"\n"
"(This module does not include any type of import format.)\n"
"\n"
"OFX and QIF imports are available in Enterprise version."
msgstr ""
"ຕົວຊ່ວຍທົ່ວໄປສຳລັບການນຳເຂົ້າໃບລາຍງານບັນຊີທະນາຄານ.\n"
"\n"
"(ໂມດູນນີ້ບໍ່ໄດ້ລວມຮູບແບບການນຳເຂົ້າໃດໆມານຳ.)\n"
"\n"
"ການນຳເຂົ້າຮູບແບບ OFX ແລະ QIF ແມ່ນມີໃຫ້ໃຊ້ໃນລຸ້ນ Enterprise."

