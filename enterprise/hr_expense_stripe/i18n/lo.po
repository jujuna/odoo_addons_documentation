#. odoo-python
#: code:addons/hr_expense_stripe/models/hr_expense_stripe_dispute.py:0
msgid "You cannot download an attachment of a dispute you're not linked to."
msgstr "ທ່ານບໍ່ສາມາດດາວໂຫຼດໄຟລ໌ຄັດຕິດຂອງຂໍ້ຂັດແຍ່ງທີ່ທ່ານບໍ່ໄດ້ກ່ຽວຂ້ອງໄດ້."

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/controllers/main.py:0
msgid "You cannot download stripe attachment for the given model."
msgstr "ທ່ານບໍ່ສາມາດດາວໂຫຼດໄຟລ໌ຄັດຕິດ Stripe ສຳລັບໂມເດວນີ້ໄດ້."

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/models/hr_expense.py:0
msgid ""
"You cannot duplicate an expense that was created from a Stripe card "
"transaction."
msgstr "ທ່ານບໍ່ສາມາດສຳເນົາລາຍຈ່າຍທີ່ສ້າງຂຶ້ນຈາກທຸລະກຳບັດ Stripe ໄດ້."

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/models/hr_expense.py:0
msgid "You cannot edit the security fields of an expense manually"
msgstr "ທ່ານບໍ່ສາມາດແກ້ໄຂຊ່ອງຂໍ້ມູນຄວາມປອດໄພຂອງລາຍຈ່າຍດ້ວຍຕົນເອງໄດ້"

#. module: hr_expense_stripe
#: model:ir.model.constraint,message:hr_expense_stripe.constraint_res_company_constraint_journal_stripe_activated
msgid ""
"You cannot remove the journal used by Stripe Issuing when it is activated"
msgstr ""
"ທ່ານບໍ່ສາມາດລຶບປຶ້ມບັນຊີລາຍວັນທີ່ນຳໃຊ້ໂດຍການອອກບັດ Stripe ໄດ້ ເມື່ອມັນຖືກເປີດໃຊ້ງານຢູ່"

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/models/product_product.py:0
msgid ""
"You cannot set a cost on a product that is used as an Expense card category. "
"Please duplicate it instead."
msgstr ""
"ທ່ານບໍ່ສາມາດກຳນົດຕົ້ນທຶນໃຫ້ກັບສິນຄ້າທີ່ໃຊ້ເປັນໝວດໝູ່ບັດລາຍຈ່າຍໄດ້. ກະລຸນາສ້າງສຳເນົາແທນ."

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/models/hr_expense.py:0
msgid ""
"You cannot split an expense that is reserved. Please wait for the "
"transaction to be captured."
msgstr ""
"ທ່ານບໍ່ສາມາດແບ່ງແຍກລາຍຈ່າຍທີ່ກັນໄວ້ໄດ້. ກະລຸນາລໍຖ້າໃຫ້ທຸລະກຳຖືກຕັດເງິນຮຽບຮ້ອຍກ່ອນ."

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/models/hr_expense.py:0
msgid ""
"You cannot submit an expense that is reserved. Please wait for the "
"transaction to be captured."
msgstr ""
"ທ່ານບໍ່ສາມາດສົ່ງລາຍຈ່າຍທີ່ກັນໄວ້ໄດ້. ກະລຸນາລໍຖ້າໃຫ້ທຸລະກຳຖືກຕັດເງິນຮຽບຮ້ອຍກ່ອນ."

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/__init__.py:0
msgid ""
"You cannot uninstall the 'Expense cards' module while there are active or "
"inactive Stripe cards. Please manually block all cards before uninstalling "
"the module."
msgstr ""
"ທ່ານບໍ່ສາມາດຖອນການຕິດຕັ້ງໂມດູນ 'Expense cards' ໄດ້ ໃນຂະນະທີ່ຍັງມີບັດ Stripe ທີ່ເຄື່ອນໄຫວ ຫຼື ບໍ່ເຄື່"
"ອນໄຫວຢູ່. ກະລຸນາລະງັບບັດທັງໝົດດ້ວຍຕົນເອງກ່ອນຖອນການຕິດຕັ້ງໂມດູນ."

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/controllers/main.py:0
msgid "You cannot upload stripe attachment for the given model."
msgstr "ທ່ານບໍ່ສາມາດອັບໂຫຼດໄຟລ໌ຄັດຕິດ Stripe ສຳລັບໂມເດວນີ້ໄດ້."

#. module: hr_expense_stripe
#. odoo-javascript
#: code:addons/hr_expense_stripe/static/src/components/open_card_receive_terms.xml:0
msgid "You confirm you have received the physical expense card."
msgstr "ທ່ານຢັ້ງຢືນວ່າທ່ານໄດ້ຮັບບັດລາຍຈ່າຍຕົວຈິງແລ້ວ."

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/models/hr_expense.py:0
msgid ""
"You do not have the necessary access rights to file a dispute. Please "
"contact your expense administrator to file the dispute."
msgstr ""
"ທ່ານບໍ່ມີສິດການເຂົ້າເຖິງທີ່ຈຳເປັນໃນການຍື່ນຂໍ້ຂັດແຍ່ງ. ກະລຸນາຕິດຕໍ່ຜູ້ເບິ່ງແຍງລະບົບລາຍຈ່າຍຂອງທ່ານເພື່ອຍື່ນຂໍ້ຂັດແ"
"ຍ່ງ."

#. module: hr_expense_stripe
#. odoo-javascript
#: code:addons/hr_expense_stripe/static/src/components/open_expense_issuing_terms.xml:0
msgid ""
"You must comply with all applicable laws and regulations and you are "
"responsible\n"
"                    for ensuring lawful use of funds and expense cards in "
"your jurisdiction."
msgstr ""
"ທ່ານຕ້ອງປະຕິບັດຕາມກົດໝາຍ ແລະ ລະບຽບການທີ່ກ່ຽວຂ້ອງທັງໝົດ ແລະ ທ່ານຕ້ອງຮັບຜິດຊອບ\n"
"                    ໃນການຮັບປະກັນການນຳໃຊ້ເງິນທຶນ ແລະ ບັດລາຍຈ່າຍຢ່າງຖືກຕ້ອງຕາມກົດໝາຍໃນເຂດ"
"ອຳນາດສານຂອງທ່ານ."

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/wizard/hr_expense_stripe_card_receive_wizard.py:0
msgid "You must confirm that you have received the card before activating it."
msgstr "ທ່ານຕ້ອງຢັ້ງຢືນວ່າໄດ້ຮັບບັດແລ້ວ ກ່ອນທີ່ຈະເປີດໃຊ້ງານບັດ."

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/models/hr_expense_stripe_card.py:0
msgid "You must create a Stripe account in order to use Stripe"
msgstr "ທ່ານຕ້ອງສ້າງບັນຊີ Stripe ກ່ອນ ຈຶ່ງຈະສາມາດນຳໃຊ້ Stripe ໄດ້"

#. module: hr_expense_stripe
#. odoo-javascript
#: code:addons/hr_expense_stripe/static/src/components/open_card_receive_terms.xml:0
msgid ""
"You must report lost or stolen cards immediately.\n"
"                    You are responsible for monitoring usage and disputing "
"unauthorized charges promptly."
msgstr ""
"ທ່ານຕ້ອງແຈ້ງບັດເສຍ ຫຼື ຖືກລັກທັນທີ.\n"
"                    ທ່ານມີຄວາມຮັບຜິດຊອບໃນການຕິດຕາມການໃຊ້ງານ ແລະ ຍື່ນຄັດຄ້ານການຮຽກເກັບເງິນ"
"ທີ່ບໍ່ໄດ້ຮັບອະນຸຍາດຢ່າງວ່ອງໄວ."

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/models/res_company.py:0
msgid "You need to be connected to stripe in order to configure your account."
msgstr "ທ່ານຕ້ອງເຊື່ອມຕໍ່ກັບ Stripe ກ່ອນ ເພື່ອກຳນົດຄ່າບັນຊີຂອງທ່ານ."

#. module: hr_expense_stripe
#: model:mail.template,subject:hr_expense_stripe.email_template_hr_expense_stripe_dispute_lost
