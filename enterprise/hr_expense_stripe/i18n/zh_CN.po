"11px; padding: 0px 8px 0px 8px; border-collapse:separate;\">\n"
"                    <tr><td valign=\"middle\" align=\"left\">\n"
"                        <t t-out=\"company.name or ''\">YourCompany</t>\n"
"                    </td></tr>\n"
"                    <tr><td valign=\"middle\" align=\"left\" "
"style=\"opacity: 0.7;\">\n"
"                    <t t-if=\"company.phone\">\n"
"                        <t t-out=\"company.phone or ''\">+1 650-123-4567</t> "
"|\n"
"                    </t>\n"
"                    <t t-if=\"company.email\">\n"
"                        <a t-attf-href=\"mailto:{{ company.email }}\" "
"style=\"text-decoration:none; color: #454748;\" t-out=\"company.email or "
"''\">info@yourcompany.com</a> |\n"
"                    </t>\n"
"                    <t t-if=\"company.website\">\n"
"                        <a t-attf-href=\"{{ company.website }}\" "
"style=\"text-decoration:none; color: #454748;\" t-out=\"company.website or "
