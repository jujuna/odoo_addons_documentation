<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Overtime: attendances beyond the daily schedule, paid by their time types at their rate. The rules run
             in sequence order: public holidays first, then the other days, the weekly rest day included. -->
        <record id="l10n_lb_time_rule_overtime_public_holiday" model="hr.time.rule">
            <field name="name">Work on Public Holidays</field>
            <field name="description">Attendances on the public holidays of the working schedule are paid an extra day's pay on top of the monthly wage, as the law prescribes for 1 May and 22 November (Laws of 30 April 1959 and 21 November 1962).</field>
            <field name="sequence">10</field>
            <field name="country_id" ref="base.lb"/>
            <field name="calendar_source">employee</field>
            <field name="apply_monday" eval="False"/>
            <field name="apply_tuesday" eval="False"/>
            <field name="apply_wednesday" eval="False"/>
            <field name="apply_thursday" eval="False"/>
            <field name="apply_friday" eval="False"/>
            <field name="apply_saturday" eval="False"/>
            <field name="apply_sunday" eval="False"/>
            <field name="apply_on_public_holidays" eval="True"/>
            <field name="condition_work_entry_type_ids" eval="[(4, ref('hr_work_entry.lb_work_entry_type_attendance'))]"/>
            <field name="work_entry_type_id" ref="hr_work_entry.l10n_lb_work_entry_type_overtime_public_holiday"/>
        </record>

        <record id="l10n_lb_time_rule_overtime_normal_day" model="hr.time.rule">
            <field name="name">Overtime on Normal Days</field>
            <field name="description">Attendances beyond the daily schedule, and on the weekly rest day when no compensatory rest is given, are overtime paid +50% of the normal hourly wage, at most 12 hours of work a day (Labour Code, art. 33 and 37).</field>
            <field name="sequence">20</field>
            <field name="country_id" ref="base.lb"/>
            <field name="calendar_source">employee</field>
            <field name="apply_on_public_holidays" eval="False"/>
            <field name="condition_work_entry_type_ids" eval="[(4, ref('hr_work_entry.lb_work_entry_type_attendance'))]"/>
            <field name="work_entry_type_id" ref="hr_work_entry.lb_work_entry_type_overtime"/>
        </record>
    </data>
</odoo>
