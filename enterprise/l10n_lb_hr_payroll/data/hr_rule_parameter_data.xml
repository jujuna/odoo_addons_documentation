        <record id="rule_parameter_lb_minimum_wage_monthly" model="hr.rule.parameter">
            <field name="name">LB: Official Minimum Wage (Monthly)</field>
            <field name="code">l10n_lb_minimum_wage_monthly</field>
            <field name="description">Official minimum monthly wage in LBP (Labour Code, art. 44; Law No. 36/67, art. 6): LBP 9,000,000 from 26 April 2023 (Decree No. 11226 of 2023), 18,000,000 from 1 April 2024 (Decree No. 13164 of 2024, retroactive), 28,000,000 from 1 August 2025 (Decree No. 699 of 18 July 2025). Compared with the basic salary, the cost-of-living increases and the regular allowances of the contract by a payroll warning.</field>
            <field name="country_id" ref="base.lb"/>
        </record>
        <record id="rule_parameter_lb_minimum_wage_monthly_2023_04_26" model="hr.rule.parameter.value">
            <field name="parameter_value">9000000</field>
            <field name="rule_parameter_id" ref="rule_parameter_lb_minimum_wage_monthly"/>
            <field name="date_from" eval="datetime(2023, 4, 26).date()"/>
        </record>
        <record id="rule_parameter_lb_minimum_wage_monthly_2024_04" model="hr.rule.parameter.value">
            <field name="parameter_value">18000000</field>
            <field name="rule_parameter_id" ref="rule_parameter_lb_minimum_wage_monthly"/>
            <field name="date_from" eval="datetime(2024, 4, 1).date()"/>
        </record>
