        <record id="rule_parameter_lb_nssf_rates" model="hr.rule.parameter">
            <field name="name">LB: NSSF Contribution Rates (%)</field>
            <field name="code">l10n_lb_nssf_rates</field>
            <field name="description">Rates of the National Social Security Fund: sickness and maternity 3% employee and 8% employer (9% normal rate and 2% of the retirees' scheme of Law No. 27 of 2017, shared equally), family allowances 6% employer, end-of-service indemnity 8.5% employer (Social Security Code, art. 73; forms CNSS 190A and 386). The work injury branch was never put into force.</field>
            <field name="country_id" ref="base.lb"/>
        </record>
        <record id="rule_parameter_lb_nssf_rates_2017_10" model="hr.rule.parameter.value">
            <field name="parameter_value">{'sm_employee': 3, 'sm_employer': 8, 'fa_employer': 6, 'eos_employer': 8.5}</field>
            <field name="rule_parameter_id" ref="rule_parameter_lb_nssf_rates"/>
            <field name="date_from" eval="datetime(2017, 10, 1).date()"/>
        </record>

        <record id="rule_parameter_lb_nssf_sm_ceiling" model="hr.rule.parameter">
            <field name="name">LB: NSSF Sickness and Maternity Ceiling</field>
            <field name="code">l10n_lb_nssf_sm_ceiling</field>
            <field name="description">Monthly ceiling in LBP of the earnings bearing the sickness and maternity contributions (Social Security Code, art. 68 §2): LBP 5,000,000 from 1 July 2022 (Decree No. 9415), 18,000,000 from 1 September 2023 (Decree No. 11928), 45,000,000 from 1 March 2024 and 90,000,000 from 1 April 2024 (5 times the minimum wage, Decree No. 12962), 120,000,000 from 1 August 2025 (Decree No. 887 of 2025).</field>
            <field name="country_id" ref="base.lb"/>
        </record>
