        <record id="rule_parameter_lb_its_bands" model="hr.rule.parameter">
            <field name="name">LB: Income Tax Bands</field>
            <field name="code">l10n_lb_its_bands</field>
            <field name="description">Yearly bands in LBP of the tax on salaries and wages, after the family deduction (Income Tax Law, art. 58): 2%, 4%, 7%, 11%, 15%, 20% and 25%, up to 18, 45, 90, 180, 360 and 675 million from 1 January 2022 (Law No. 10 of 2022, art. 33), up to 360, 900, 1,800, 3,600, 7,200 and 13,500 million from 1 January 2024 (Law No. 324 of 2024, art. 47). They are split by the days of work, a month counting 30 days (art. 59).</field>
            <field name="country_id" ref="base.lb"/>
        </record>
        <record id="rule_parameter_lb_its_bands_2022" model="hr.rule.parameter.value">
            <field name="parameter_value">[(18000000, 2), (45000000, 4), (90000000, 7), (180000000, 11), (360000000, 15), (675000000, 20), (None, 25)]</field>
