        <record id="rule_parameter_lb_nssf_family_allowance" model="hr.rule.parameter">
            <field name="name">LB: NSSF Family Allowances</field>
            <field name="code">l10n_lb_nssf_family_allowance</field>
            <field name="description">Monthly family allowances in LBP paid by the employer for the Fund (Social Security Code, art. 46 to 48): for the spouse without paid work nor pension and for each dependent child up to 5: LBP 600,000 and 330,000 from 1 January 2024 (Decree No. 12599 of 2023), 1,200,000 and 660,000 from 1 July 2025 (Decree No. 422 of 2025), 2,100,000 and 1,155,000 from 1 May 2026 (Decree No. 2923 of 2026).</field>
            <field name="country_id" ref="base.lb"/>
        </record>
