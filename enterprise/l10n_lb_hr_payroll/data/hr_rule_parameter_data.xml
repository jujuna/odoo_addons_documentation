        <record id="rule_parameter_lb_its_rounding" model="hr.rule.parameter">
            <field name="name">LB: Income Tax Rounding</field>
            <field name="code">l10n_lb_its_rounding</field>
            <field name="description">The fractions of LBP 10,000 of the taxes, the salaries and wages included, are rounded up in favour of the Treasury (Tax Procedures Law, art. 154, as amended by Law No. 324 of 2024, art. 76).</field>
            <field name="country_id" ref="base.lb"/>
        </record>
