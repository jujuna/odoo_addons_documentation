            <field name="name">LB: Income Tax Daily Deduction</field>
            <field name="code">l10n_lb_its_daily_deduction</field>
            <field name="description">Deduction in LBP for each day paid to a daily or hourly worker, whatever the family situation (Income Tax Law, art. 59): LBP 125,000 from 15 November 2022 (Law No. 10 of 2022, art. 34), 1,500,000 from 1 January 2024 (Law No. 324 of 2024, art. 48).</field>
            <field name="country_id" ref="base.lb"/>
        </record>
