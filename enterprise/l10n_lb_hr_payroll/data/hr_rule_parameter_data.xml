        <record id="rule_parameter_lb_its_family_deduction" model="hr.rule.parameter">
            <field name="name">LB: Income Tax Family Deduction</field>
            <field name="code">l10n_lb_its_family_deduction</field>
            <field name="description">Yearly family deduction in LBP (Income Tax Law, art. 31 and 56): the taxpayer, added for a married taxpayer whose spouse has no taxable activity, and for each dependent child up to 5. LBP 37,500,000, 12,500,000 and 2,500,000 from 1 January 2022 (Law No. 10 of 2022, art. 27), 450,000,000, 225,000,000 and 45,000,000 from 1 January 2024 (Law No. 324 of 2024, art. 49), unchanged by the budgets of 2025 and 2026.</field>
            <field name="country_id" ref="base.lb"/>
        </record>
