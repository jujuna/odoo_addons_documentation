<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Paid time: remuneration, NSSF earnings ("paid leaves", Social Security Code, art. 68 §1) and taxable income.
             The sick leave at half pay is paid at half the wage through the rate of its time type (Labour Code,
             art. 40), see hr.leave._get_l10n_lb_sick_leave_split(); the maternity leave is paid in full by the employer
             (art. 29). -->
        <record id="hr_work_entry.lb_work_entry_type_attendance" model="hr.work.entry.type">
            <field name="category_ids" eval="[(6, 0, [
                ref('l10n_lb_hr_payroll.LB_REMUNERATION_BASE'),
                ref('l10n_lb_hr_payroll.LB_NSSF_BASE'),
                ref('l10n_lb_hr_payroll.LB_TAX_BASE'),
            ])]"/>
        </record>

        <record id="hr_work_entry.lb_work_entry_type_home_working" model="hr.work.entry.type">
            <field name="category_ids" eval="[(6, 0, [
                ref('l10n_lb_hr_payroll.LB_REMUNERATION_BASE'),
                ref('l10n_lb_hr_payroll.LB_NSSF_BASE'),
                ref('l10n_lb_hr_payroll.LB_TAX_BASE'),
            ])]"/>
        </record>

        <record id="hr_work_entry.lb_work_entry_type_leave" model="hr.work.entry.type">
            <field name="category_ids" eval="[(6, 0, [
                ref('l10n_lb_hr_payroll.LB_REMUNERATION_BASE'),
                ref('l10n_lb_hr_payroll.LB_NSSF_BASE'),
                ref('l10n_lb_hr_payroll.LB_TAX_BASE'),
            ])]"/>
        </record>

        <record id="hr_work_entry.lb_work_entry_type_compensatory" model="hr.work.entry.type">
            <field name="category_ids" eval="[(6, 0, [
                ref('l10n_lb_hr_payroll.LB_REMUNERATION_BASE'),
                ref('l10n_lb_hr_payroll.LB_NSSF_BASE'),
                ref('l10n_lb_hr_payroll.LB_TAX_BASE'),
            ])]"/>
        </record>

        <record id="hr_work_entry.lb_work_entry_type_legal_leave" model="hr.work.entry.type">
            <field name="category_ids" eval="[(6, 0, [
                ref('l10n_lb_hr_payroll.LB_REMUNERATION_BASE'),
                ref('l10n_lb_hr_payroll.LB_NSSF_BASE'),
                ref('l10n_lb_hr_payroll.LB_TAX_BASE'),
            ])]"/>
        </record>

        <record id="hr_work_entry.lb_work_entry_type_public_holiday" model="hr.work.entry.type">
            <field name="category_ids" eval="[(6, 0, [
                ref('l10n_lb_hr_payroll.LB_REMUNERATION_BASE'),
                ref('l10n_lb_hr_payroll.LB_NSSF_BASE'),
                ref('l10n_lb_hr_payroll.LB_TAX_BASE'),
            ])]"/>
        </record>

        <record id="hr_work_entry.lb_work_entry_type_sick_leave" model="hr.work.entry.type">
            <field name="category_ids" eval="[(6, 0, [
                ref('l10n_lb_hr_payroll.LB_REMUNERATION_BASE'),
                ref('l10n_lb_hr_payroll.LB_NSSF_BASE'),
                ref('l10n_lb_hr_payroll.LB_TAX_BASE'),
            ])]"/>
        </record>

        <record id="hr_work_entry.l10n_lb_work_entry_type_sick_leave_half" model="hr.work.entry.type">
            <field name="category_ids" eval="[(6, 0, [
                ref('l10n_lb_hr_payroll.LB_REMUNERATION_BASE'),
                ref('l10n_lb_hr_payroll.LB_NSSF_BASE'),
                ref('l10n_lb_hr_payroll.LB_TAX_BASE'),
            ])]"/>
        </record>

        <record id="hr_work_entry.l10n_lb_work_entry_type_maternity_leave" model="hr.work.entry.type">
            <field name="category_ids" eval="[(6, 0, [
                ref('l10n_lb_hr_payroll.LB_REMUNERATION_BASE'),
                ref('l10n_lb_hr_payroll.LB_NSSF_BASE'),
                ref('l10n_lb_hr_payroll.LB_TAX_BASE'),
            ])]"/>
        </record>

        <record id="hr_work_entry.l10n_lb_work_entry_type_bereavement_leave" model="hr.work.entry.type">
            <field name="category_ids" eval="[(6, 0, [
                ref('l10n_lb_hr_payroll.LB_REMUNERATION_BASE'),
                ref('l10n_lb_hr_payroll.LB_NSSF_BASE'),
                ref('l10n_lb_hr_payroll.LB_TAX_BASE'),
            ])]"/>
        </record>

        <!-- Overtime hours, paid at the rate of their time type: +50% of the hourly wage on the normal days (Labour
             Code, art. 33), an extra day's pay on top of the monthly wage on the public holidays (Laws of 30 April 1959
             and 21 November 1962) -->
        <record id="hr_work_entry.lb_work_entry_type_overtime" model="hr.work.entry.type">
            <field name="category_ids" eval="[(6, 0, [
                ref('hr_payroll.EXTRA_HOURS'),
                ref('l10n_lb_hr_payroll.LB_REMUNERATION_BASE'),
                ref('l10n_lb_hr_payroll.LB_NSSF_BASE'),
                ref('l10n_lb_hr_payroll.LB_TAX_BASE'),
            ])]"/>
            <field name="display_hours" eval="True"/>
        </record>

        <record id="hr_work_entry.l10n_lb_work_entry_type_overtime_public_holiday" model="hr.work.entry.type">
            <field name="category_ids" eval="[(6, 0, [
                ref('hr_payroll.EXTRA_HOURS'),
                ref('l10n_lb_hr_payroll.LB_REMUNERATION_BASE'),
                ref('l10n_lb_hr_payroll.LB_NSSF_BASE'),
                ref('l10n_lb_hr_payroll.LB_TAX_BASE'),
            ])]"/>
            <field name="display_hours" eval="True"/>
        </record>

        <!-- Time without wage -->
        <record id="hr_work_entry.lb_hr_work_entry_type_out_of_contract" model="hr.work.entry.type">
            <field name="category_ids" eval="[(5, 0, 0)]"/>
        </record>

        <record id="hr_work_entry.lb_work_entry_type_unpaid_leave" model="hr.work.entry.type">
            <field name="category_ids" eval="[(5, 0, 0)]"/>
        </record>

        <record id="hr_work_entry.l10n_lb_work_entry_type_sick_leave_unpaid" model="hr.work.entry.type">
            <field name="category_ids" eval="[(5, 0, 0)]"/>
        </record>
    </data>
</odoo>
