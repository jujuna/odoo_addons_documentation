    <!-- NSSF family allowance paid with the salary for the Fund and offset in the contribution schedule -->
    <record id="l10n_lb_rule_family_allowance" model="hr.salary.rule">
        <field name="name">NSSF Family Allowance</field>
        <field name="code">FAMILY_ALW</field>
        <field name="sequence">30</field>
        <field name="category_ids" eval="[(6, 0, [ref('l10n_lb_hr_payroll.LB_REMUNERATION_BASE')])]"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = payslip._l10n_lb_compute_family_allowance()
        </field>
        <field name="appears_on_payslip">non_zero</field>
        <field name="note">Paid monthly by the employer for the Fund and offset in the contribution schedule (Social Security Code, art. 48): LBP 2,100,000 for the spouse without paid work and LBP 1,155,000 for each dependent child up to 5 from 1 May 2026 (Decree No. 2923 of 2026). Neither NSSF earnings nor taxable income (Social Security Code, art. 67 §3; Income Tax Law, art. 47(10)).</field>
        <field name="struct_ids" eval="[(6, 0, [ref('l10n_lb_hr_payroll.hr_payroll_structure_lb_employee_salary')])]"/>
        <field name="country_id" ref="base.lb"/>
    </record>

    <!-- Tax borne by the employer: income tax grossed up, iterated in hr.payslip._get_payslip_lines() -->
    <record id="l10n_lb_rule_gross_up" model="hr.salary.rule">
        <field name="name">Tax Borne by the Employer</field>
        <field name="code">GROSS_UP</field>
        <field name="sequence">50</field>
        <field name="category_ids" eval="[(6, 0, [
            ref('hr_payroll.ALW'),
            ref('l10n_lb_hr_payroll.LB_REMUNERATION_BASE'),
            ref('l10n_lb_hr_payroll.LB_NSSF_BASE'),
            ref('l10n_lb_hr_payroll.LB_TAX_BASE'),
        ])]"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = version.l10n_lb_net_salary</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = l10n_lb_gross_up
        </field>
        <field name="appears_on_payslip">non_zero</field>
        <field name="note">Income tax paid by the employer for the employee: a cash benefit itself (Income Tax Law, art. 49), grossed up.</field>
        <field name="struct_ids" eval="[(6, 0, [ref('l10n_lb_hr_payroll.hr_payroll_structure_lb_employee_salary')])]"/>
        <field name="country_id" ref="base.lb"/>
    </record>

    <!-- Bonuses: taxed with the cumulative income of the month of payment -->
    <record id="l10n_lb_rule_bonus" model="hr.salary.rule">
