            ref('l10n_lb_hr_payroll.LB_REMUNERATION_BASE'),
            ref('l10n_lb_hr_payroll.LB_NSSF_BASE'),
            ref('l10n_lb_hr_payroll.LB_TAX_BASE'),
        ])]"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = 'LEAVE_IN_LIEU' in inputs</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = inputs['LEAVE_IN_LIEU'].amount
        </field>
        <field name="input_usage_employee" eval="False"/>
        <field name="input_usage_payslip" eval="True"/>
        <field name="input_section" ref="l10n_lb_hr_payroll.l10n_lb_salary_rule_section_termination"/>
        <field name="note">Annual leave not taken, paid at the termination: taxable, NSSF earnings but not part of the end-of-service wage (Regulation No. 11, art. 1(II)).</field>
        <field name="struct_ids" eval="[(6, 0, [ref('l10n_lb_hr_payroll.hr_payroll_structure_lb_employee_salary')])]"/>
        <field name="country_id" ref="base.lb"/>
    </record>

    <!-- End-of-service indemnity: computed on the last payslip of the foreign employees outside the end-of-service
         branch of the NSSF, entered for the other employees. Neither NSSF earnings nor taxable income. -->
    <record id="l10n_lb_rule_end_of_service" model="hr.salary.rule">
        <field name="name">End-of-Service Indemnity</field>
        <field name="code">END_OF_SERVICE</field>
        <field name="sequence">72</field>
        <field name="category_ids" eval="[(6, 0, [ref('l10n_lb_hr_payroll.LB_REMUNERATION_BASE')])]"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = 'END_OF_SERVICE' in inputs or payslip._l10n_lb_is_end_of_service_computed()</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
if 'END_OF_SERVICE' in inputs:
    result = inputs['END_OF_SERVICE'].amount
else:
    result = payslip._l10n_lb_compute_end_of_service(categories['LB_STATUTORY_ALW'])
        </field>
        <field name="input_usage_employee" eval="False"/>
        <field name="input_usage_payslip" eval="True"/>
        <field name="input_section" ref="l10n_lb_hr_payroll.l10n_lb_salary_rule_section_termination"/>
        <field name="note">Lebanese employees, and foreign employees covered by the end-of-service branch of the NSSF: the indemnity is liquidated by the NSSF (Social Security Code, art. 51); enter the amount paid by the employer, if any. Foreign employees outside the branch (art. 9 §3): computed on the last payslip, half a month of wage below one year of service, a month of wage for each year of service from one year (Labour Code, art. 54), a year begun counting for its months and a month begun as a whole month, as the NSSF does for its indemnity (Social Security Code, art. 51); the wage is the basic salary with the cost-of-living increases and the regular allowances (art. 57). An amount entered replaces the computation. Exempt from the income tax (Income Tax Law, art. 47), not NSSF earnings.</field>
