        <field name="code">BONUS</field>
        <field name="sequence">60</field>
        <field name="category_ids" eval="[(6, 0, [
            ref('l10n_lb_hr_payroll.LB_REMUNERATION_BASE'),
            ref('l10n_lb_hr_payroll.LB_NSSF_BASE'),
            ref('l10n_lb_hr_payroll.LB_TAX_BASE'),
        ])]"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = 'BONUS' in inputs</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = inputs['BONUS'].amount
        </field>
        <field name="input_usage_employee" eval="False"/>
        <field name="input_usage_payslip" eval="True"/>
        <field name="input_section" ref="l10n_lb_hr_payroll.l10n_lb_salary_rule_section_payments"/>
        <field name="note">Bonus or incentive: no statutory bonus exists. NSSF earnings of the month of payment, subject to the annual regularisation of the ceilings (Regulation No. 11, art. 4), and taxable income of the month, in the marginal bands of the cumulative computation.</field>
        <field name="struct_ids" eval="[(6, 0, [ref('l10n_lb_hr_payroll.hr_payroll_structure_lb_employee_salary')])]"/>
        <field name="country_id" ref="base.lb"/>
    </record>

    <record id="l10n_lb_rule_leave_in_lieu" model="hr.salary.rule">
        <field name="name">Untaken Leave Paid</field>
        <field name="code">LEAVE_IN_LIEU</field>
        <field name="sequence">71</field>
