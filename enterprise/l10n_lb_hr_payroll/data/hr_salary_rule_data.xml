        <field name="name">Transport Allowance</field>
        <field name="code">TRANSPORT_ALW</field>
        <field name="sequence">20</field>
        <field name="category_ids" eval="[(6, 0, [
            ref('hr_payroll.ALW'),
            ref('l10n_lb_hr_payroll.LB_REMUNERATION_BASE'),
        ])]"/>
        <field name="condition_select">property_input</field>
        <field name="amount_select">property_input</field>
        <field name="input_usage_employee" eval="True"/>
        <field name="input_usage_payslip" eval="True"/>
        <field name="input_default_value" eval="0.0"/>
        <field name="input_section" ref="l10n_lb_hr_payroll.l10n_lb_salary_rule_section_allowances"/>
        <field name="appears_on_payslip">non_zero</field>
        <field name="note">Transport allowance of the decrees: LBP 450,000 for each day of actual attendance at the workplace from 15 February 2024 (Law No. 217 of 2012; Decree No. 12966 of 2024), not due for the leaves, the holidays and the remote work, nor when the employer provides the transport or the lodging. Not part of the NSSF earnings (Law No. 217, §4) nor of the taxable income (Income Tax Law, art. 50(2)). Enter the amount of the month; the transport paid above the statutory amount goes to the additional transport allowance.</field>
        <field name="struct_ids" eval="[(6, 0, [ref('l10n_lb_hr_payroll.hr_payroll_structure_lb_employee_salary')])]"/>
        <field name="country_id" ref="base.lb"/>
    </record>

