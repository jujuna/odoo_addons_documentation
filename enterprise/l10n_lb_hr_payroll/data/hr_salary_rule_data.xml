    <!-- Basic salary: the paid time types feed the remuneration, the NSSF earnings and the taxable income, the rule only
         displays the remuneration base before any other rule. The overtime is paid by its time types at their rate
         (+50% on the normal days, an extra day's pay on the public holidays), detailed in the worked days. -->
    <record id="l10n_lb_rule_basic" model="hr.salary.rule">
        <field name="name">Basic Salary</field>
        <field name="code">BASIC</field>
        <field name="sequence">1</field>
        <field name="category_ids" eval="[(5, 0, 0)]"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = categories['LB_REMUNERATION_BASE']
        </field>
        <field name="struct_ids" eval="[(6, 0, [ref('l10n_lb_hr_payroll.hr_payroll_structure_lb_employee_salary')])]"/>
        <field name="country_id" ref="base.lb"/>
    </record>

    <!-- Increases and allowances added to the basic wage: part of the wage of the end-of-service indemnity -->
    <record id="l10n_lb_rule_cost_of_living" model="hr.salary.rule">
        <field name="name">Cost-of-Living Increase</field>
        <field name="code">COL_ALW</field>
        <field name="sequence">10</field>
        <field name="category_ids" eval="[(6, 0, [
            ref('hr_payroll.ALW'),
            ref('l10n_lb_hr_payroll.LB_REMUNERATION_BASE'),
            ref('l10n_lb_hr_payroll.LB_STATUTORY_ALW'),
            ref('l10n_lb_hr_payroll.LB_NSSF_BASE'),
            ref('l10n_lb_hr_payroll.LB_TAX_BASE'),
        ])]"/>
        <field name="condition_select">property_input</field>
        <field name="amount_select">property_input</field>
        <field name="input_usage_employee" eval="True"/>
        <field name="input_usage_payslip" eval="True"/>
        <field name="input_default_value" eval="0.0"/>
        <field name="input_section" ref="l10n_lb_hr_payroll.l10n_lb_salary_rule_section_contractual"/>
        <field name="appears_on_payslip">non_zero</field>
        <field name="note">Cost-of-living increases granted by decree and acquired in the wage: LBP 1,325,000 from 1 April 2022 on the wages up to LBP 4,000,000 (Decree No. 9129 of 2022, part of the NSSF earnings by its art. 3) and LBP 6,400,000 from 29 May 2023 (Decree No. 11343 of 2023). Counted in the minimum wage and the wage of the indemnities (Labour Code, art. 57).</field>
        <field name="struct_ids" eval="[(6, 0, [ref('l10n_lb_hr_payroll.hr_payroll_structure_lb_employee_salary')])]"/>
        <field name="country_id" ref="base.lb"/>
    </record>

