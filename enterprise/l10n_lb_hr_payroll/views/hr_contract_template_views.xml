<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_contract_template_view_form" model="ir.ui.view">
        <field name="name">hr.contract.template.view.form.inherit.l10n_lb_hr_payroll</field>
        <field name="model">hr.version</field>
        <field name="inherit_id" ref="hr.hr_contract_template_form_view"/>
        <field name="arch" type="xml">
            <group name="salary_info" position="inside">
                <group string="Lebanon Payroll" name="l10n_lb_payroll" invisible="country_code != 'LB'">
                    <field name="l10n_lb_tax_category" class="o_hr_narrow_field"/>
                    <field name="l10n_lb_net_salary" string="Tax Borne by the Employer"/>
                    <field name="l10n_lb_nssf_coverage" class="o_hr_narrow_field"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
