msgstr "<i class=\"oi\" data-icon=\"east\"/> ສ້າງຄີ API"

#. module: product_barcodelookup
#: model_terms:ir.ui.view,arch_db:product_barcodelookup.product_fetch_image_wizard_view_form
msgid ""
"<span invisible=\"nb_products_selected &lt;= 1000\">\n"
"                            As only 1000 products can be processed per day, "
"the remaining will be\n"
"                            done tomorrow.\n"
"                        </span>"
msgstr ""
"<span invisible=\"nb_products_selected &lt;= 1000\">\n"
"                            ເນື່ອງຈາກສາມາດປະມວນຜົນໄດ້ພຽງ 1000 ສິນຄ້າຕໍ່ມື້, ສ່ວນທີ່ເຫຼືອຈະຖື"
"ກ\n"
"                            ດຳເນີນການໃນມື້ອື່ນ.\n"
"                        </span>"

#. module: product_barcodelookup
#: model_terms:ir.ui.view,arch_db:product_barcodelookup.product_fetch_image_wizard_view_form
msgid ""
"<strong>Note: </strong>\n"
"                        Some images may not be royalty-free and should not "
"be published online."
msgstr ""
"<strong>ໝາຍເຫດ: </strong>\n"
"                        ບາງຮູບພາບອາດມີລິຂະສິດ ແລະ ບໍ່ຄວນນຳໄປເຜີຍແຜ່ທາງອອນລາຍ."

#. module: product_barcodelookup
#. odoo-python
#: code:addons/product_barcodelookup/wizard/product_fetch_image_wizard.py:0
msgid ""
"A task to process products in the background is already running. Please try "
