msgid ""
"%(matching_images_count)s matching images have been found for %"
"(product_count)s products."
msgstr ""
"ພົບເຫັນຮູບພາບທີ່ກົງກັນ %(matching_images_count)s ຮູບ ສຳລັບ %(product_count)s ສິນຄ້າ."

#. module: product_barcodelookup
#: model_terms:ir.ui.view,arch_db:product_barcodelookup.res_config_settings_view_form
