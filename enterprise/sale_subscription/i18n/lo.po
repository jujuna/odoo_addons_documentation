#. module: sale_subscription
#: model:mail.template,body_html:sale_subscription.mail_template_subscription_alert
msgid ""
"<t>\n"
"<p>Dear <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,</p>\n"
"<p>Your subscription <strong t-out=\"object.name or ''\">Office Cleaning "
"Service\"</strong> needs your attention.</p>\n"
"<p>We invite you to renew it by clicking on the following link.</p>\n"
"<p>Kind regards.</p>\n"
"<p t-out=\"object.user_id.signature or ''\" data-o-mail-quote=\"1\">--<br "
"data-o-mail-quote=\"1\"/>Mitchell Admin</p>\n"
"        </t>"
msgstr ""
"<t>\n"
"<p>ຮຽນ <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,</p>\n"
"<p>ການສະໝັກໃຊ້ຂອງທ່ານ <strong t-out=\"object.name or ''\">Office Cleaning "
"Service\"</strong> ຕ້ອງການຄວາມເອົາໃຈໃສ່ຈາກທ່ານ.</p>\n"
"<p>ພວກເຮົາຂໍເຊີນທ່ານຕໍ່ອາຍຸໂດຍການກົດລິ້ງຕໍ່ໄປນີ້.</p>\n"
"<p>ດ້ວຍຄວາມນັບຖື.</p>\n"
"<p t-out=\"object.user_id.signature or ''\" data-o-mail-quote=\"1\">--<br "
"data-o-mail-quote=\"1\"/>Mitchell Admin</p>\n"
"        </t>"

#. module: sale_subscription
#: model:mail.template,body_html:sale_subscription.email_payment_close
msgid ""
"<t>\n"
"<t t-set=\"company\" t-value=\"object.company_id or "
"object.user_id.company_id or user.company_id\"/>\n"
"Hello <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,<br/><br/"
">\n"
"<t t-if=\"ctx.get('payment_token') and ctx.get('next_invoice_amount')\">\n"
"    Our final attempt to process a payment for your subscription using your "
"payment method\n"
"    <t t-out=\"ctx.get('payment_token') or ''\">TOKEN</t>\n"
"    for <t t-out=\"ctx['next_invoice_amount'] or ''\">100</t> <t t-"
"out=\"ctx.get('currency') or ''\">$</t> failed.\n"
"    <t t-if=\"ctx.get('error')\">\n"
"        Your bank or credit institution gave the following details about the "
"issue: <pre t-out=\"ctx['error'] or ''\"/>.\n"
"    </t>\n"
"</t>\n"
"<t t-else=\"\">\n"
"    Our final attempt to process a payment for your subscription failed "
"because we have no payment method recorded for you.\n"
"</t>\n"
"<br/><br/>\n"
"As your payment should have been made <strong><t t-"
"out=\"ctx.get('auto_close_limit') or ''\">5</t> days ago</strong>, your "
"subscription has been terminated.\n"
"Should you wish to resolve this issue, do not hesitate to contact us.<br/"
"><br/>\n"
"Thank you for choosing <t t-out=\"company.name or ''\">YourCompany</t>!\n"
"<div t-if=\"user.signature\" data-o-mail-quote-container=\"1\">\n"
"    <br/><br/>\n"
"    <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-"
"out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"</div>\n"
"</t>\n"
"        "
msgstr ""
"<t>\n"
"<t t-set=\"company\" t-value=\"object.company_id or "
"object.user_id.company_id or user.company_id\"/>\n"
"ສະບາຍດີ <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,<br/>"
"<br/>\n"
"<t t-if=\"ctx.get('payment_token') and ctx.get('next_invoice_amount')\">\n"
"    ຄວາມພະຍາຍາມຄັ້ງສຸດທ້າຍຂອງພວກເຮົາໃນການດຳເນີນການຊຳລະເງິນສຳລັບການສະໝັກໃຊ້ຂອງທ່ານ ໂດຍຜ່ານ"
"ວິທີການຊຳລະເງິນ\n"
"    <t t-out=\"ctx.get('payment_token') or ''\">TOKEN</t>\n"
"    ສຳລັບຈຳນວນ <t t-out=\"ctx['next_invoice_amount'] or ''\">100</t> <t t-"
"out=\"ctx.get('currency') or ''\">$</t> ບໍ່ສຳເລັດ.\n"
"    <t t-if=\"ctx.get('error')\">\n"
"        ທະນາຄານ ຫຼື ສະຖາບັນສິນເຊື່ອຂອງທ່ານໄດ້ແຈ້ງລາຍລະອຽດກ່ຽວກັບບັນຫາດັ່ງນີ້: <pre t-"
"out=\"ctx['error'] or ''\"/>.\n"
"    </t>\n"
"</t>\n"
"<t t-else=\"\">\n"
"    ຄວາມພະຍາຍາມຄັ້ງສຸດທ້າຍໃນການດຳເນີນການຊຳລະເງິນສຳລັບການສະໝັກໃຊ້ຂອງທ່ານບໍ່ສຳເລັດ ເນື່ອງຈາກພວ"
"ກເຮົາບໍ່ມີຂໍ້ມູນວິທີການຊຳລະເງິນຂອງທ່ານທີ່ບັນທຶກໄວ້.\n"
"</t>\n"
"<br/><br/>\n"
"ເນື່ອງຈາກການຊຳລະເງິນຂອງທ່ານຄວນຈະດຳເນີນການຕັ້ງແຕ່ <strong><t t-out=\"ctx.get"
"('auto_close_limit') or ''\">5</t> ມື້ກ່ອນໜ້ານີ້</strong>, ການສະໝັກໃຊ້ຂອງທ່ານຈຶ່ງໄດ້ຖືກຍົກເ"
"ລີກແລ້ວ.\n"
"ຖ້າທ່ານຕ້ອງການແກ້ໄຂບັນຫານີ້, ສາມາດຕິດຕໍ່ພວກເຮົາໄດ້ທຸກເວລາ.<br/><br/>\n"
"ຂໍຂອບໃຈທີ່ເລືອກໃຊ້ບໍລິການ <t t-out=\"company.name or ''\">YourCompany</t>!\n"
"<div t-if=\"user.signature\" data-o-mail-quote-container=\"1\">\n"
"    <br/><br/>\n"
"    <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-"
"out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"</div>\n"
"</t>\n"
"        "

#. module: sale_subscription
#: model:mail.template,body_html:sale_subscription.email_payment_reminder
msgid ""
"<t>\n"
"<t t-set=\"company\" t-value=\"object.company_id or "
"object.user_id.company_id or user.company_id\"/>\n"
"Hello <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,<br/><br/"
">\n"
"<t t-if=\"ctx.get('payment_token') and ctx.get('next_invoice_amount')\">\n"
"    We were unable to process a payment for your subscription using your "
"payment method\n"
"    <t t-out=\"ctx['payment_token'] or ''\">TOKEN</t>\n"
"    for <t t-out=\"ctx['next_invoice_amount'] or ''\">10</t> <t t-"
"out=\"ctx.get('currency_name') or ''\">$</t>.\n"
"    <t t-if=\"ctx.get('error')\">\n"
"        Your bank or credit institution gave the following details about the "
"issue: <pre t-out=\"ctx['error'] or ''\"/>.\n"
"    </t>\n"
"</t>\n"
"<t t-else=\"\">\n"
"    Your subscription <t t-out=\"object.client_order_ref or ''\">CODE</t> is "
"due for renewal but we haven’t received your payment yet. To keep your "
"subscription active, please make your payment as soon as possible.\n"
"</t>\n"
"<br/><br/>\n"
"Your subscription <t t-out=\"object.client_order_ref or ''\">CODE</t> will "
"be <strong>suspended</strong>\n"
"<t t-out=\"(ctx.get('date_close') and ('on ' + "
"format_date(ctx.get('date_close')))) or 'soon'\">05/05/2021</t>\n"
"if payment is not received.<br/>\n"
"<div style=\"margin: 16px 0px; text-align: center;\">\n"
"    <a t-attf-href=\"{{ ctx.get('payment_link', object.get_portal_url()) }}"
"\" t-attf-style=\"display: inline-block; padding: 10px 30px; text-"
"decoration: none; background-color: {{company.email_secondary_color or "
"'#875A7B'}}; color: {{company.email_primary_color or '#FFFFFF'}}; border-"
"radius: 5px;\">\n"
"        Pay Now\n"
"    </a>\n"
"</div>\n"
"<br/>\n"
"If you have any questions, do not hesitate to contact us.<br/><br/>\n"
"Thank you for choosing <t t-out=\"company.name or ''\">YourCompany</t>!\n"
"<div>\n"
"<t t-if=\"user.signature\">\n"
"    <br/><br/>\n"
"    <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-"
"out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"</t>\n"
"</div>\n"
"</t>\n"
"        "
msgstr ""
"<t>\n"
"<t t-set=\"company\" t-value=\"object.company_id or "
"object.user_id.company_id or user.company_id\"/>\n"
"ສະບາຍດີ <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,<br/>"
"<br/>\n"
"<t t-if=\"ctx.get('payment_token') and ctx.get('next_invoice_amount')\">\n"
"    ພວກເຮົາບໍ່ສາມາດດຳເນີນການຊຳລະເງິນສຳລັບການສະໝັກໃຊ້ຂອງທ່ານ ຜ່ານວິທີການຊຳລະເງິນ\n"
"    <t t-out=\"ctx['payment_token'] or ''\">TOKEN</t>\n"
"    ສຳລັບຈຳນວນ <t t-out=\"ctx['next_invoice_amount'] or ''\">10</t> <t t-"
"out=\"ctx.get('currency_name') or ''\">$</t> ໄດ້.\n"
"    <t t-if=\"ctx.get('error')\">\n"
"        ທະນາຄານ ຫຼື ສະຖາບັນສິນເຊື່ອຂອງທ່ານໄດ້ແຈ້ງລາຍລະອຽດກ່ຽວກັບບັນຫາດັ່ງນີ້: <pre t-"
"out=\"ctx['error'] or ''\"/>.\n"
"    </t>\n"
"</t>\n"
"<t t-else=\"\">\n"
"    ການສະໝັກໃຊ້ຂອງທ່ານ <t t-out=\"object.client_order_ref or ''\">CODE</t> ເຖິງກຳ"
"ນົດຕໍ່ອາຍຸແລ້ວ ແຕ່ພວກເຮົາຍັງບໍ່ທັນໄດ້ຮັບການຊຳລະເງິນຈາກທ່ານ. ເພື່ອຮັກສາສະຖານະການສະໝັກໃຊ້ໃຫ້ສືບຕໍ່ໃຊ້ງານ"
"ໄດ້, ກະລຸນາດຳເນີນການຊຳລະເງິນໃຫ້ໄວເທົ່າທີ່ຈະໄວໄດ້.\n"
"</t>\n"
"<br/><br/>\n"
"ການສະໝັກໃຊ້ຂອງທ່ານ <t t-out=\"object.client_order_ref or ''\">CODE</t> ຈະຖືກ "
"<strong>ໂຈະໄວ້ຊົ່ວຄາວ</strong>\n"
"<t t-out=\"(ctx.get('date_close') and ('on ' + format_date(ctx.get"
"('date_close')))) or 'soon'\">05/05/2021</t>\n"
"ຫາກຍັງບໍ່ໄດ້ຮັບການຊຳລະເງິນ.<br/>\n"
"<div style=\"margin: 16px 0px; text-align: center;\">\n"
"    <a t-attf-href=\"{{ ctx.get('payment_link', object.get_portal_url()) }}"
"\" t-attf-style=\"display: inline-block; padding: 10px 30px; text-"
"decoration: none; background-color: {{company.email_secondary_color or "
"'#875A7B'}}; color: {{company.email_primary_color or '#FFFFFF'}}; border-"
"radius: 5px;\">\n"
"        ຊຳລະເງິນດຽວນີ້\n"
"    </a>\n"
"</div>\n"
"<br/>\n"
"ຫາກທ່ານມີຄຳຖາມໃດໆ, ສາມາດຕິດຕໍ່ພວກເຮົາໄດ້ຕະຫຼອດເວລາ.<br/><br/>\n"
"ຂໍຂອບໃຈທີ່ເລືອກໃຊ້ບໍລິການ <t t-out=\"company.name or ''\">YourCompany</t>!\n"
"<div>\n"
"<t t-if=\"user.signature\">\n"
"    <br/><br/>\n"
"    <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-"
"out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"</t>\n"
"</div>\n"
"</t>\n"
"        "

