#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e5
msgid ""
"<strong>{{ company_name }}</strong> aims to decouple economic growth from\n"
"                        material consumption, reduce waste generation, and "
"enhance resource\n"
"                        efficiency in line with the EU Circular Economy "
"Action Plan."
msgstr ""
"<strong>{{ company_name }}</strong> vise à dissocier la croissance "
"économique de\n"
"                        la consommation de matériaux, à réduire la "
"production de déchets et à améliorer l’efficacité\n"
"                        des ressources conformément au plan d’action de l’UE "
"pour l’économie circulaire."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s3
msgid ""
"<strong>{{ company_name }}</strong> applies a Community Engagement\n"
"                                        Policy and Human-Rights Policy "
"covering social inclusion,\n"
"                                        consultation, and impact mitigation. "
"Policies are aligned\n"
"                                        with the UN Guiding Principles on "
"Business and Human Rights\n"
"                                        and OECD standards."
msgstr ""
"<strong>{{ company_name }}</strong> applique une politique d’engagement "
"communautaire\n"
"                                        et une politique relative aux droits "
"humains couvrant l’inclusion sociale,\n"
"                                        la consultation et l’atténuation des "
"impacts. Les politiques sont alignées\n"
"                                        sur les principes directeurs des "
"Nations unies relatifs aux entreprises et aux droits humains\n"
"                                        et les normes de l’OCDE."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s2
msgid ""
"<strong>{{ company_name }}</strong> applies a Responsible Sourcing\n"
"                                    Policy and Supplier Code of Conduct "
"covering labor rights,\n"
"                                    working conditions, and ethical "
"practices."
msgstr ""
"<strong>{{ company_name }}</strong> applique une politique "
"d’approvisionnement responsable\n"
"                                    et un code de conduite des fournisseurs "
"couvrant les droits du travail,\n"
"                                    les conditions de travail et les "
"pratiques éthiques."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s4
msgid ""
"<strong>{{ company_name }}</strong> applies policies on product\n"
"                                        safety, ethical marketing, consumer "
"privacy, and complaint\n"
"                                        handling. Policies align with "
"international standards such\n"
"                                        as <em>\n"
"                                            <strong>ISO 9001, ISO 26000, and "
"consumer protection\n"
"                                        regulations.</strong>\n"
"                                        </em>"
msgstr ""
"<strong>{{ company_name }}</strong> applique des politiques relatives à la "
"sécurité\n"
"                                        des produits, au marketing éthique, "
"à la confidentialité des consommateurs et au traitement\n"
"                                        des réclamations. Les politiques "
"sont alignées sur des normes internationales telles\n"
"                                        que <em>\n"
"                                        <strong>ISO 9001, ISO 26000 et les "
"réglementations de protection\n"
"                                        des consommateurs.</strong>\n"
"                                        </em>"

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e4
msgid ""
"<strong>{{ company_name }}</strong> assesses financial\n"
"                                            exposure to\n"
"                                            water-related risks (scarcity, "
"regulation, pollution\n"
"                                            events) and\n"
"                                            potential opportunities (cost "
"savings, sustainable\n"
"                                            branding). These\n"
"                                            assessments are integrated into "
"the enterprise risk\n"
"                                            management framework\n"
"                                            and scenario analyses."
msgstr ""
"<strong>{{ company_name }}</strong> évalue l’exposition \n"
"                                            financière aux\n"
"                                            risques liés à l’eau (rareté, "
"réglementation, événements de pollution)\n"
"                                            et\n"
"                                            aux opportunités potentielles "
"(économies de coûts, image de marque durable). Ces\n"
"                                            évaluations sont intégrées dans "
"le cadre de gestion des risques\n"
"                                            d’entreprise\n"
"                                            et les analyses de scénarios."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e3
msgid ""
"<strong>{{ company_name }}</strong> assesses financial\n"
"                                        exposure to\n"
"                                        water-related risks (scarcity, "
"regulation, pollution events)\n"
"                                        and potential\n"
"                                        opportunities (cost savings, "
"sustainable branding). These\n"
"                                        assessments are\n"
"                                        integrated into the enterprise risk "
"management framework and\n"
"                                        scenario\n"
"                                        analyses."
msgstr ""
"<strong>{{ company_name }}</strong> évalue l’exposition financière\n"
"                                        aux\n"
"                                        risques liés à l’eau (rareté, "
"réglementation, événements de pollution)\n"
"                                        et aux opportunités\n"
"                                        potentielles (économies de coûts, "
"image de marque durable). Ces\n"
"                                        évaluations sont\n"
"                                        intégrées dans le cadre de gestion "
"des risques d’entreprise et les\n"
"                                        analyses de\n"
"                                        scénarios."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e2
msgid ""
"<strong>{{ company_name }}</strong> assesses financial exposure to\n"
"                                pollution-related risks, including "
"regulatory changes, accidental\n"
"                                releases, and contamination of air, water, "
"and soil."
msgstr ""
"<strong>{{ company_name }}</strong> évalue l’exposition financière aux\n"
"                                risques liés à la pollution, y compris les "
"évolutions réglementaires, les rejets\n"
"                                accidentels et la contamination de l’air, de "
"l’eau et des sols."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e1
msgid ""
"<strong>{{ company_name }}</strong> assesses financial exposure to both\n"
"                                physical climate risks (e.g., extreme "
"weather, heat, flooding) and\n"
"                                transition risks (e.g., carbon pricing, "
"regulatory change,\n"
"                                technology shifts)."
msgstr ""
"<strong>{{ company_name }}</strong> évalue l’exposition financière aux "
"risques\n"
"                                physiques climatiques (p. ex. événements "
"météorologiques extrêmes, chaleur, inondations) et\n"
"                                aux risques de transition (p. ex. prix du "
"carbone, évolution réglementaire,\n"
"                                évolutions technologiques)."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_environmental_a
msgid ""
"<strong>{{ company_name }}</strong> calculates its GHG emissions following "
"the <strong>GHG Protocol</strong>\n"
"                and <strong>Le Bilan Carbone®</strong> methodology. The "
"emissions are categorized\n"
"                into:"
msgstr ""
"<strong>{{ company_name }}</strong> calcule ses émissions de GES selon le "
"<strong>GHG Protocol</strong>\n"
"                et la méthodologie <strong>Le Bilan Carbone®</strong>. Les "
"émissions sont classées\n"
"                en :"

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s3
msgid ""
"<strong>{{ company_name }}</strong> engages communities via consultations, "
"town halls,\n"
"                                                surveys, and collaborative "
"projects. Engagement\n"
"                                                identifies risks such as "
"displacement, environmental\n"
"                                                harm, or lack of economic "
"opportunities. Outcomes\n"
"                                                inform mitigation and "
"investment plans."
msgstr ""
"<strong>{{ company_name }}</strong> échange avec les communautés via des "
"consultations, réunions publiques,\n"
"                                                enquêtes et projets "
"collaboratifs. L’engagement\n"
"                                                identifie des risques tels "
"que le déplacement, les dommages environnementaux\n"
"                                                ou le manque d’opportunités "
"économiques. Les résultats\n"
"                                                alimentent les plans "
"d’atténuation et d’investissement."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s2
msgid ""
"<strong>{{ company_name }}</strong> engages suppliers and their workers "
"through audits,\n"
"                                            surveys, and dialogue<strong>\n"
"                                                <em> platforms</em>\n"
"                                            </strong><em>\n"
"                                            .</em>Engagement aims to "
"identify and address issues\n"
"                                            such as excessive overtime, "
"discrimination, or lack of\n"
"                                            worker representation. Findings "
"feed into\n"
"                                            supplier-improvement plans."
msgstr ""
"<strong>{{ company_name }}</strong> échange avec les fournisseurs et leurs "
"travailleurs par le biais d’audits,\n"
"                                            d’enquêtes et de <strong>\n"
"                                                <em> plateformes</em>\n"
"                                            </strong><em>\n"
"                                            </em> de dialogue.L’engagement "
"vise à identifier et traiter les problèmes\n"
"                                            tels que les heures "
"supplémentaires excessives, la discrimination ou le manque de\n"
"                                            représentation des travailleurs. "
"Les conclusions alimentent les plans\n"
"                                            d’amélioration des fournisseurs."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s1
msgid ""
"<strong>{{ company_name }}</strong> engages workers via surveys, focus\n"
"                                groups, and consultation committees to "
"capture views on workplace\n"
"                                conditions and workforce impacts."
msgstr ""
"<strong>{{ company_name }}</strong> échange avec les travailleurs par le "
"biais d’enquêtes, de groupes de discussion\n"
"                                et de comités de consultation afin de "
"recueillir leurs points de vue sur les conditions\n"
"                                de travail et les impacts sur le personnel."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s1
msgid ""
"<strong>{{ company_name }}</strong> ensures that all workers receive\n"
"                                wages meeting or exceeding legal minimums "
"and living wage benchmarks\n"
"                                where available. Regular reviews assess wage "
"competitiveness and\n"
"                                internal equity."
msgstr ""
"<strong>{{ company_name }}</strong> veille à ce que tous les travailleurs "
"reçoivent\n"
"                                des salaires atteignant ou dépassant les "
"minimums légaux et les références de salaire décent\n"
"                                lorsqu’elles sont disponibles. Des revues "
"régulières évaluent la compétitivité des salaires et\n"
"                                l’équité interne."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s1
msgid ""
"<strong>{{ company_name }}</strong> ensures that employees have the\n"
"                                right to freedom of association and "
"collective bargaining. Social\n"
"                                dialogue occurs through regular meetings "
"between management and\n"
"                                employee representatives at site and group "
"levels. Collective\n"
"                                agreements define working conditions, pay, "
"and benefits where\n"
"                                applicable."
msgstr ""
"<strong>{{ company_name }}</strong> garantit aux employés le\n"
"                                droit à la liberté d’association et à la "
"négociation collective. Le dialogue social\n"
"                                a lieu lors de réunions régulières entre la "
"direction et\n"
"                                les représentants des employés, au niveau "
"des sites et du groupe. Les conventions\n"
"                                collectives définissent les conditions de "
"travail, la rémunération et les avantages lorsque\n"
"                                cela s’applique."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e5
msgid ""
"<strong>{{ company_name }}</strong> evaluates\n"
"                                            financial impacts from\n"
"                                            resource-use and circular-"
"economy risks, integrating\n"
"                                            them into\n"
"                                            enterprise risk management. "
"Opportunities include\n"
"                                            cost savings,\n"
"                                            access to green financing, and "
"market growth for\n"
"                                            circular products."
msgstr ""
"<strong>{{ company_name }}</strong> évalue\n"
"                                            les impacts financiers liés aux\n"
"                                            risques d’utilisation des "
"ressources et d’économie circulaire, en les intégrant\n"
"                                            dans la\n"
"                                            gestion des risques "
"d’entreprise. Les opportunités incluent\n"
"                                            les économies de coûts,\n"
"                                            l’accès au financement vert et "
"la croissance du marché pour\n"
"                                            les produits circulaires."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s1
msgid ""
"<strong>{{ company_name }}</strong> fosters inclusion for persons with "
"disabilities through\n"
"                                accessible recruitment, workplace "
"adaptation, and dedicated\n"
"                                training. Progress is monitored via self-"
"identification and HR\n"
"                                systems."
msgstr ""
"<strong>{{ company_name }}</strong> favorise l’inclusion des personnes en "
"situation de handicap par\n"
"                                un recrutement accessible, l’adaptation du "
"lieu de travail et des formations\n"
"                                dédiées. Les progrès sont suivis via l’auto-"
"identification et les systèmes\n"
"                                RH."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e4
msgid ""
"<strong>{{ company_name }}</strong> has developed a transition plan\n"
"                                    to ensure its business model and "
"strategy are compatible with\n"
"                                    global ecological thresholds, <strong>\n"
"                                        <em>including the Post-2020 Global "
"Biodiversity Framework\n"
"                                            and the EU\n"
"                                            Biodiversity Strategy for 2030</"
"em>\n"
"                                    </strong>.\n"
"                                    The plan addresses material impacts and "
"dependencies on\n"
"                                    biodiversity and ecosystems across own "
"operations and the value\n"
"                                    chain, using the mitigation hierarchy: "
"avoid, reduce, restore,\n"
"                                    and offset. Short-term (2025), medium-"
"term (2030), and long-term\n"
"                                    (2040-2050) milestones are defined, with "
"governance approval and\n"
"                                    monitoring systems in place."
msgstr ""
"<strong>{{ company_name }}</strong> a développé un plan de transition\n"
"                                    afin de garantir que son modèle "
"économique et sa stratégie sont compatibles avec\n"
"                                    les seuils écologiques mondiaux, "
"<strong>\n"
"                                    <em>y compris le Cadre mondial de la "
"biodiversité post-2020\n"
"                                    et la stratégie de l’UE\n"
"                                    en faveur de la biodiversité à l’horizon "
"2030</em>\n"
"                                    </strong>.\n"
"                                    Le plan traite les impacts matériels et "
"les dépendances liés à\n"
"                                    la biodiversité et aux écosystèmes dans "
"les opérations propres et la chaîne de\n"
"                                    valeur, en utilisant la hiérarchie "
"d’atténuation : éviter, réduire, restaurer\n"
"                                    et compenser. Des jalons à court terme "
"(2025), moyen terme (2030) et long terme\n"
"                                    (2040-2050) sont définis, avec une "
"approbation de la gouvernance et\n"
"                                    des systèmes de suivi en place."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e1
msgid ""
"<strong>{{ company_name }}</strong> has established a transition plan\n"
"                                to align its activities with a 1.5°C "
"pathway, achieving net-zero GHG\n"
"                                emissions by <strong>\n"
"                                    <em>[insert year]</em>\n"
"                                </strong>.\n"
"                                The plan includes short-term (2025), medium-"
"term (2030), and\n"
"                                long-term (2040-2050) milestones."
msgstr ""
"<strong>{{ company_name }}</strong> a établi un plan de transition\n"
"                                afin d’aligner ses activités sur une "
"trajectoire de 1,5 °C, en atteignant zéro émission nette de GES\n"
"                                d’ici <strong>\n"
"                                <em>[insérer l’année]</em>\n"
"                                </strong>.\n"
"                                Le plan comprend des jalons à court terme "
"(2025), moyen terme (2030) et\n"
"                                long terme (2040-2050)."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e2
msgid ""
"<strong>{{ company_name }}</strong> identifies substances of concern\n"
"                                (including SVHCs) in operations, products, "
"and supply chains.\n"
"                                Management measures include substitution, "
"safe handling, and\n"
"                                tracking of quantities used."
msgstr ""
"<strong>{{ company_name }}</strong> identifie les substances préoccupantes\n"
"                                (y compris les SVHC) dans ses opérations, "
"produits et chaînes d’approvisionnement.\n"
"                                Les mesures de gestion incluent la "
"substitution, la manipulation sûre et\n"
"                                le suivi des quantités utilisées."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s2
msgid ""
"<strong>{{ company_name }}</strong> implements\n"
"                                    supplier-training programs, capacity-"
"building partnerships, and\n"
"                                    collaborative industry initiatives to "
"reduce negative impacts on\n"
"                                    value-chain workers. Effectiveness is "
"evaluated by improvements\n"
"                                    in audit results, reduced complaints, "
"and supplier retention\n"
"                                    rates."
msgstr ""
"<strong>{{ company_name }}</strong> met en œuvre\n"
"                                    des programmes de formation des "
"fournisseurs, des partenariats de renforcement des capacités et\n"
"                                    des initiatives sectorielles "
"collaboratives afin de réduire les impacts négatifs sur\n"
"                                    les travailleurs de la chaîne de valeur. "
"L’efficacité est évaluée par l’amélioration\n"
"                                    des résultats d’audit, la réduction des "
"plaintes et les taux de rétention\n"
"                                    des fournisseurs."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s3
msgid ""
"<strong>{{ company_name }}</strong> implements community-investment\n"
"                                            programs, livelihood "
"initiatives, and collaborative\n"
"                                            mitigation projects. "
"Effectiveness is evaluated by\n"
"                                            reductions in complaints, "
"improved community\n"
"                                            satisfaction, and measurable "
"social outcomes."
msgstr ""
"<strong>{{ company_name }}</strong> identifie les substances préoccupantes\n"
"                                            (y compris les SVHC) dans ses "
"opérations, produits et chaînes d’approvisionnement.\n"
"                                            Les mesures de gestion incluent "
"la substitution, la manipulation sûre et\n"
"                                            le suivi des quantités utilisées."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e1
msgid ""
"<strong>{{ company_name }}</strong> implements group-wide climate and\n"
"                                energy policies to steer operations toward "
"decarbonization and\n"
"                                resilience. Policies are endorsed by the "
"Board and integrated into\n"
"                                corporate governance."
msgstr ""
"<strong>{{ company_name }}</strong> met en œuvre des politiques climatiques "
"et\n"
"                                énergétiques à l’échelle du groupe afin "
"d’orienter les opérations vers la décarbonation et\n"
"                                la résilience. Les politiques sont "
"approuvées par le Conseil et intégrées dans\n"
"                                la gouvernance d’entreprise."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e2
msgid ""
"<strong>{{ company_name }}</strong> implements group-wide pollution\n"
"                                policies endorsed by the Board, integrated "
"into operational\n"
"                                management and governance. Policies cover "
"prevention, monitoring,\n"
"                                and reporting of environmental impacts."
msgstr ""
"<strong>{{ company_name }}</strong> met en œuvre des politiques de "
"pollution\n"
"                                à l’échelle du groupe, approuvées par le "
"Conseil et intégrées dans la gestion\n"
"                                opérationnelle et la gouvernance. Les "
"politiques couvrent la prévention, le suivi\n"
"                                et le reporting des impacts environnementaux."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e1
msgid ""
"<strong>{{ company_name }}</strong> integrates carbon-cost\n"
"                                considerations into its decision-making to "
"anticipate regulatory,\n"
"                                market, and transition risks. The company "
"applies an internal carbon\n"
"                                price to guide capital allocation and "
"project evaluation."
msgstr ""
"<strong>{{ company_name }}</strong> intègre les considérations liées au coût "
"du carbone\n"
"                                dans sa prise de décision afin d’anticiper "
"les risques réglementaires,\n"
"                                de marché et de transition. La société "
"applique un prix interne du carbone\n"
"                                pour orienter l’allocation du capital et "
"l’évaluation des projets."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s1
msgid ""
"<strong>{{ company_name }}</strong> invests in continuous learning through "
"structured\n"
"                                programs, on-the-job training, and e-"
"learning. Focus areas include\n"
"                                digital skills, leadership, and "
"sustainability awareness."
msgstr ""
"<strong>{{ company_name }}</strong> investit dans l’apprentissage continu au "
"moyen de programmes\n"
"                                structurés, de formations sur le terrain et "
"d’e-learning. Les domaines prioritaires incluent\n"
"                                les compétences numériques, le leadership et "
"la sensibilisation à la durabilité."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e3
msgid ""
"<strong>{{ company_name }}</strong> maintains comprehensive water\n"
"                                    and marine management policies approved "
"by senior leadership.\n"
"                                    These policies aim to ensure responsible "
"sourcing, efficient\n"
"                                    consumption, and safe return of water to "
"the environment, while\n"
"                                    safeguarding ocean ecosystems."
msgstr ""
"<strong>{{ company_name }}</strong> maintient des politiques complètes de "
"gestion de l’eau\n"
"                                    et des milieux marins approuvées par la "
"direction senior.\n"
"                                    Ces politiques visent à garantir un "
"approvisionnement responsable, une consommation\n"
"                                    efficace et un retour sûr de l’eau dans "
"l’environnement, tout en\n"
"                                    protégeant les écosystèmes océaniques."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_g1
msgid ""
"<strong>{{ company_name }}</strong> maintains corporate culture and\n"
"                                    business conduct policies covering "
"ethical behavior,\n"
"                                    whistleblowing, anti-corruption, and "
"responsible\n"
"                                    decision-making. Policies align with "
"OECD Guidelines, UN Global\n"
"                                    Compact, and ISO 37001 anti-bribery "
"standards."
msgstr ""
"<strong>{{ company_name }}</strong> maintient une culture d’entreprise et\n"
"                                    des politiques de conduite des affaires "
"couvrant le comportement éthique,\n"
"                                    le lancement d’alerte, l’anticorruption "
"et la prise de décision\n"
"                                    responsable. Les politiques sont "
"alignées sur les Principes directeurs de l’OCDE, le Pacte mondial des "
"Nations unies\n"
"                                    et la norme anticorruption ISO 37001."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_vsm_c5
msgid ""
"<strong>{{ company_name }}</strong> monitors additional workforce "
"characteristics to provide a complete view of its human capital management. "
"This section includes management-level gender ratios and information on self-"
"employed and temporary workers engaged by the company. Data is collected "
"from employee application."
msgstr ""
"<strong>{{ company_name }}</strong> suit des caractéristiques "
"supplémentaires du personnel afin de fournir une vue complète de sa gestion "
"du capital humain. Cette section inclut les ratios femmes-hommes au niveau "
"de la direction et les informations sur les travailleurs indépendants et "
"temporaires engagés par la société. Les données sont collectées depuis "
"l’application Employés."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e1
msgid ""
"<strong>{{ company_name }}</strong> monitors any GHG removal activities\n"
"                                or carbon credit projects linked to its "
"operations. These may\n"
"                                include carbon sequestration in soils, "
"forests, or technological\n"
"                                capture, and participation in certified "
"carbon offset programs."
msgstr ""
"<strong>{{ company_name }}</strong> suit toutes les activités d’élimination "
"des GES\n"
"                                ou les projets de crédits carbone liés à ses "
"opérations. Ceux-ci peuvent\n"
"                                inclure la séquestration du carbone dans les "
"sols, les forêts ou par capture\n"
"                                technologique, ainsi que la participation à "
"des programmes certifiés de compensation carbone."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e1
msgid ""
"<strong>{{ company_name }}</strong> progressively increases renewable\n"
"                                energy share through Power Purchase "
"Agreements and on-site\n"
"                                generation."
msgstr ""
"<strong>{{ company_name }}</strong> augmente progressivement la part "
"d’énergie renouvelable\n"
"                                via des contrats d’achat d’électricité et de "
"la production\n"
"                                sur site."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s1
msgid ""
"<strong>{{ company_name }}</strong> promotes equal opportunity and\n"
"                                diversity at all levels. Metrics include "
"gender, age, nationality,\n"
"                                and underrepresented groups. Diversity "
"targets are integrated into\n"
"                                leadership evaluations and HR processes."
msgstr ""
"<strong>{{ company_name }}</strong> promeut l’égalité des chances et\n"
"                                la diversité à tous les niveaux. Les "
"métriques incluent le genre, l’âge, la nationalité\n"
"                                et les groupes sous-représentés. Les "
"objectifs de diversité sont intégrés dans\n"
"                                les évaluations de leadership et les "
"processus RH."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s1
msgid ""
"<strong>{{ company_name }}</strong> provides formal channels for\n"
"                                workers to report concerns, including "
"whistleblowing hotlines,\n"
"                                email, and direct contact with HR. "
"Remediation processes ensure\n"
"                                timely follow-up, investigation, and "
"resolution of issues."
msgstr ""
"<strong>{{ company_name }}</strong> fournit des canaux formels permettant\n"
"                                aux travailleurs de signaler des "
"préoccupations, y compris des lignes d’alerte,\n"
"                                l’e-mail et le contact direct avec les RH. "
"Les processus de remédiation garantissent\n"
"                                un suivi, une enquête et une résolution des "
"problèmes dans les délais."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e1
msgid ""
"<strong>{{ company_name }}</strong> quantifies its greenhouse-gas (GHG)\n"
"                                emissions following recognised accounting "
"principles consistent with\n"
"                                the GHG Protocol Corporate Standard and ESRS "
"E1-6."
msgstr ""
"<strong>{{ company_name }}</strong> quantifie ses émissions de gaz à effet "
"de serre (GES)\n"
"                                selon des principes comptables reconnus, "
"cohérents avec\n"
"                                le GHG Protocol Corporate Standard et l’ESRS "
"E1-6."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e2
msgid ""
"<strong>{{ company_name }}</strong> tracks emissions and discharges\n"
"                                systematically across all relevant "
"operational sites. Data\n"
"                                collection is aligned with the EMS and "
"reported consistently to\n"
"                                management and regulatory authorities."
msgstr ""
"<strong>{{ company_name }}</strong> suit les émissions et les rejets\n"
"                                de manière systématique sur tous les sites "
"opérationnels pertinents. La collecte\n"
"                                des données est alignée avec le SME et "
"communiquée de manière cohérente à\n"
"                                la direction et aux autorités réglementaires."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s3
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s4
msgid ""
"<strong>{{ company_name }}</strong> will <strong>review this assessment\n"
"                                    annually</strong> or in response to "
"significant business,\n"
"                                    regulatory, or environmental changes."
msgstr ""
"<strong>{{ company_name }}</strong> <strong>révisera cette analyse\n"
"                                    chaque année</strong> ou en réponse à "
"des changements significatifs liés à l’activité,\n"
"                                    à la réglementation ou à l’environnement."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e1
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e2
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e3
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e4
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e5
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_g1
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s1
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s2
msgid ""
"<strong>{{ company_name }}</strong> will <strong>review this assessment\n"
"                                annually</strong> or in response to "
"significant business,\n"
"                                regulatory, or environmental changes."
msgstr ""
"<strong>{{ company_name }}</strong> <strong>révisera cette analyse\n"
"                                chaque année</strong> ou en réponse à des "
"changements significatifs liés à l’activité,\n"
"                                à la réglementation ou à l’environnement."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e4
msgid ""
"<strong>{{ company_name }}</strong>'s biodiversity objectives: <strong>\n"
"                                <em>To be completed...</em>\n"
"                            </strong>"
msgstr ""
"Objectifs de biodiversité de <strong>{{ company_name }}</strong> : <strong>\n"
"                                <em>À compléter...</em>\n"
"                            </strong>"

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e2
msgid ""
"<strong>{{ company_name }}</strong>'s pollution management strategic\n"
"                            objectives: <em>\n"
"                                <strong>To be completed...</strong>\n"
"                            </em>"
msgstr ""
"Objectifs stratégiques de gestion de la pollution de "
"<strong>{{ company_name }}</strong> :\n"
"                            <em>\n"
"                                <strong>À compléter...</strong>\n"
"                           </em>"

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e1
msgid ""
"<strong>{{ company_name }}</strong>'s strategic ambition toward climate\n"
"                            neutrality by <strong>\n"
"                                <em>[insert target year for climate "
"neutrality]</em>\n"
"                            </strong><em>\n"
"                            .</em><strong>\n"
"                                <em></em>\n"
"                            </strong>"
msgstr ""
"Ambition stratégique de <strong>{{ company_name }}</strong> vers la "
"neutralité\n"
"                            climatique d’ici <strong>\n"
"                                <em>[insérer l’année cible pour la "
"neutralité climatique]</em>\n"
"                            </strong><em>\n"
"                            .</em><strong>\n"
"                                <em></em>\n"
"                            </strong>"

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e3
msgid ""
"<strong>{{ company_name }}</strong>'s water management and conservation\n"
"                                objectives: <strong>\n"
"                                    <em>To be completed...</em>\n"
"                                </strong>"
msgstr ""
"Objectifs de gestion et de conservation de l’eau de \n"
"                                <strong>{{ company_name }}</strong> : "
"<strong>\n"
"                                    <em>À compléter...</em>\n"
"                                </strong>"

#. module: esg
#: model:mail.template,body_html:esg.mail_template_esg_metric_ask_feedback
msgid ""
"<t t-set=\"logged_user\" t-value=\"ctx.get('logged_user')\"/>\n"
"                <t t-set=\"company_name\" t-value=\"ctx.get('company_name')"
"\"/>\n"
"                <t t-set=\"deadline\" t-value=\"ctx.get('deadline')\"/>\n"
"                <div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;"
"\">\n"
"                        </p><p style=\"margin-left:5px\">Dear <t t-"
"out=\"object.partner_id.name or 'stakeholder'\">[Stakeholder]</t></p>\n"
"                        <span>\n"
"                            <t t-out=\"logged_user\">[Current user]</t> "
"invites you to participate in the CSRD double materiality review for <t t-"
"out=\"company_name\">[Company Name]</t>. We are looking for your input on: "
"<br/>\n"
"                            - How the company impacts the environment, "
"society, and the economy. <br/>\n"
"                            - How these impacts could affect the company "
"financially. <br/>\n"
"                            Please complete your review by <t t-"
"out=\"deadline\">[specified deadline]</t> to help us meet CSRD requirements. "
"Your expertise is important for an accurate assessment. </span>\n"
"                        <br/> Thank you for your contribution. <br/>\n"
"                        Best regards, <t t-out=\"logged_user\">[Current "
"user]</t>\n"
"                        <br/><br/>\n"
"                        <div style=\"margin: 16px 0px 16px 0px; text-align: "
"center;\">\n"
"                            <a t-att-href=\"object.get_start_url()\" t-attf-"
"style=\"background-color: {{user.company_id.email_secondary_color or "
"'#875A7B'}}; padding: 8px 16px 8px 16px; text-decoration: none; color: "
"{{user.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px; "
"font-size:13px;\">\n"
"                                Start the Review\n"
"                            </a>\n"
"                        </div>\n"
"                    \n"
"                </div>\n"
"            "
msgstr ""
"<t t-set=\"logged_user\" t-value=\"ctx.get('logged_user')\"/> \n"
"                <t t-set=\"company_name\" t-value=\"ctx.get('company_name')"
"\"/> \n"
