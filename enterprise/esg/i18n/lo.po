#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_basic_for_prepation
msgid ""
"The <strong>expected level of accuracy</strong> or\n"
"                                        uncertainty."
msgstr ""
"<strong>ລະດັບຄວາມຖືກຕ້ອງທີ່ຄາດຫວັງ</strong> ຫຼື\n"
"                                        ຄວາມບໍ່ແນ່ນອນ."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_general_information
msgid "The <strong>guidance provided by EFRAG</strong>"
msgstr "<strong>ຄຳແນະນຳທີ່ສະໜອງໃຫ້ໂດຍ EFRAG</strong>"

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_basic_for_prepation
