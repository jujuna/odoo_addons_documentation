"                        ໄວ້ຢ່າງຈະແຈ້ງໃນແຕ່ລະພາກສ່ວນຫົວຂໍ້ທີ່ກ່ຽວຂ້ອງ."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_basic_for_prepation
msgid ""
"When specific sustainability topics deviate from these default time "
"horizons\n"
"                        (e.g., climate-related targets extending beyond 10 "
"years), the rationale is\n"
"                        provided in the respective disclosure section."
msgstr ""
"ເມື່ອຫົວຂໍ້ຄວາມຍືນຍົງສະເພາະໃດໜຶ່ງແຕກຕ່າງຈາກກອບໄລຍະເວລາເລີ່ມຕົ້ນເຫຼົ່ານີ້\n"
"                        (ເຊັ່ນ: ເປົ້າໝາຍດ້ານດິນຟ້າອາກາດທີ່ມີກຳນົດຍາວກວ່າ 10 ປີ), ເຫດຜົນຈະຖືກ"
"ລະບຸ\n"
"                        ໄວ້ໃນພາກສ່ວນການເປີດເຜີຍຂໍ້ມູນທີ່ກ່ຽວຂ້ອງ."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_metrics_targets
msgid ""
"Where applicable, both absolute and intensity-based data are disclosed to\n"
"                        ensure\n"
"                        comparability and transparency."
msgstr ""
"ໃນກໍລະນີທີ່ກ່ຽວຂ້ອງ, ຂໍ້ມູນທັງແບບຄ່າສົມບູນ ແລະ ແບບຄວາມເຂັ້ມຂຸ້ນຈະຖືກເປີດເຜີຍ ເພື່ອ\n"
"                        ຮັບປະກັນ\n"
"                        ຄວາມສາມາດໃນການປຽບທຽບ ແລະ ຄວາມໂປ່ງໃສ."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_environmental_a
msgid ""
"Where automated measurement is not available, data are estimated using "
"emission\n"
"                factors or mass balance methods consistent with the EU "
"Industrial Emissions\n"
"                Directive (IED) or ISO 14064 guidelines."
msgstr ""
"ໃນກໍລະນີທີ່ບໍ່ມີການວັດແທກແບບອັດຕະໂນມັດ, ຂໍ້ມູນຈະຖືກປະມານການໂດຍໃຊ້ຄ່າສຳປະສິດການປ່ອຍ\n"
"                (emission factors) ຫຼື ວິທີດຸນດ່ຽງມວນສານ ທີ່ສອດຄ່ອງກັບຂໍ້ກຳນົດການປ່ອຍອາຍພິດອຸ"
"ດສາຫະກຳຂອງສະຫະພາບເອີຣົບ\n"
"                (IED) ຫຼື ແນວທາງ ISO 14064."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_governance_c
msgid ""
"Where complete data are unavailable, estimates are based on the scope of "
"governance\n"
"                oversight, sample audits, or extrapolation from comparable "
"business units."
msgstr ""
"ໃນກໍລະນີທີ່ບໍ່ມີຂໍ້ມູນຄົບຖ້ວນ, ການປະມານການຈະອີງໃສ່ຂອບເຂດການກຳກັບດູແລ,\n"
"                ການກວດສອບຕົວຢ່າງ, ຫຼື ການຄາດຄະເນຈາກໜ່ວຍທຸລະກິດທີ່ທຽບຄຽງກັນໄດ້."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_social_b
msgid ""
"Where data gaps exist, disclose estimation techniques and\n"
"                                    sources."
msgstr ""
"ໃນກໍລະນີທີ່ມີຊ່ອງຫວ່າງຂອງຂໍ້ມູນ, ໃຫ້ເປີດເຜີຍເຕັກນິກການປະມານການ ແລະ\n"
"                                    ແຫຼ່ງທີ່ມາ."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_social_b
msgid "Where data gaps exist, disclose estimation techniques and data sources."
msgstr ""
"ໃນກໍລະນີທີ່ມີຊ່ອງຫວ່າງຂອງຂໍ້ມູນ, ໃຫ້ເປີດເຜີຍເຕັກນິກການປະມານການ ແລະ ແຫຼ່ງທີ່ມາຂອງຂໍ້ມູນ."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_social_b
msgid ""
"Where direct data are unavailable, estimates are derived from sample "
"surveys,\n"
"                        historical trends, or modeled ratios based on "
"comparable products, services,\n"
"                        or regions."
msgstr ""
"ໃນກໍລະນີທີ່ບໍ່ມີຂໍ້ມູນໂດຍກົງ, ການປະມານການຈະໄດ້ມາຈາກການສຳຫຼວດຕົວຢ່າງ,\n"
"                        ທ່າອ່ຽງໃນອະດີດ, ຫຼື ອັດຕາສ່ວນຈຳລອງທີ່ອີງໃສ່ຜະລິດຕະພັນ, ການບໍລິການ,\n"
"                        ຫຼື ພາກພື້ນທີ່ທຽບຄຽງກັນໄດ້."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_basic_for_prepation
msgid ""
"Where quantitative metrics are based on estimates, approximations, or "
"partial\n"
"                        data coverage, the methodology and assumptions are "
"explained in the\n"
"                        corresponding disclosure notes."
msgstr ""
"ໃນກໍລະນີທີ່ຕົວຊີ້ວັດທາງປະລິມານອີງໃສ່ການປະມານການ, ການຄາດຄະເນ, ຫຼື ການຄອບຄຸມ\n"
"                        ຂໍ້ມູນພຽງບາງສ່ວນ, ວິທີການ ແລະ ຂໍ້ສົມມຸດຕິຖານຈະຖືກອະທິບາຍໄວ້ໃນ\n"
"                        ໝາຍເຫດການເປີດເຜີຍຂໍ້ມູນທີ່ກ່ຽວຂ້ອງ."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_social_b
msgid ""
"Where relevant, consumer-related indicators (e.g., complaints, product\n"
"                        recalls, satisfaction scores, privacy compliance) "
"undergo external assurance\n"
"                        in line with recognized frameworks such as ISO 9001, "
"ISO 26000, AA1000\n"
"                        Assurance Standard, or regulatory audits."
msgstr ""
"ໃນກໍລະນີທີ່ກ່ຽວຂ້ອງ, ຕົວຊີ້ວັດທີ່ກ່ຽວກັບຜູ້ບໍລິໂພກ (ເຊັ່ນ: ຂໍ້ຮ້ອງຮຽນ, ການຮຽກຄືນ\n"
"                        ຜະລິດຕະພັນ, ຄະແນນຄວາມເພິ່ງພໍໃຈ, ການປະຕິບັດຕາມຄວາມເປັນສ່ວນຕົວ) ຈ"
"ະໄດ້ຮັບການກວດສອບຢັ້ງຢືນຈາກພາຍນອກ\n"
"                        ຕາມມາດຕະຖານທີ່ໄດ້ຮັບການຍອມຮັບ ເຊັ່ນ: ISO 9001, ISO 26000, ມາ"
"ດຕະຖານການກວດສອບ\n"
"                        AA1000, ຫຼື ການກວດສອບຕາມກົດໝາຍ."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_governance_c
msgid ""
"Where relevant, governance indicators (e.g., confirmed corruption incidents, "
"policy\n"
"                coverage, ethical training completion) undergo external "
"assurance using recognized\n"
"                frameworks such as ISO 37001, AA1000 Assurance Standard, or "
"national audit\n"
"                standards."
msgstr ""
"ໃນກໍລະນີທີ່ກ່ຽວຂ້ອງ, ຕົວຊີ້ວັດດ້ານທຳມາພິບານ (ເຊັ່ນ: ເຫດການສໍ້ລາດບັງຫຼວງທີ່ຖືກຢືນຢັນ, ຂອບເຂດນະໂຍບາ"
"ຍ,\n"
"                ການສຳເລັດການຝຶກອົບຮົມດ້ານຈັນຍາບັນ) ຈະໄດ້ຮັບການກວດສອບຢັ້ງຢືນຈາກພາຍນອກ ໂດຍໃ"
"ຊ້ມາດຕະຖານທີ່ໄດ້ຮັບການຍອມຮັບ\n"
"                ເຊັ່ນ: ISO 37001, ມາດຕະຖານການກວດສອບ AA1000, ຫຼື ມາດຕະຖານການກວດສອ"
"ບ\n"
"                ແຫ່ງຊາດ."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_iro_management
msgid ""
"Where relevant, references are included to external standards or\n"
"                        initiatives the company aligns with."
msgstr ""
"ໃນກໍລະນີທີ່ກ່ຽວຂ້ອງ, ຈະມີການອ້າງອີງເຖິງມາດຕະຖານພາຍນອກ ຫຼື\n"
"                        ຂໍ້ລິເລີ່ມທີ່ບໍລິສັດຍຶດຖືປະຕິບັດຕາມ."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_social_b
msgid ""
"Where relevant, workforce indicators (e.g., diversity, pay equity, safety)\n"
"                undergo external assurance in line with recognized "
"frameworks such as <strong>ISAE\n"
"                3000</strong>, <strong>GRI 401-404</strong>, or <strong>ILO "
"labor standards</strong>\n"
"                ."
msgstr ""
"ໃນກໍລະນີທີ່ກ່ຽວຂ້ອງ, ຕົວຊີ້ວັດດ້ານກຳລັງແຮງງານ (ເຊັ່ນ: ຄວາມຫຼາກຫຼາຍ, ຄວາມສະເໝີພາບດ້ານຄ່າຕອບແທນ, ຄ"
"ວາມປອດໄພ)\n"
"                ຈະໄດ້ຮັບການກວດສອບຢັ້ງຢືນຈາກພາຍນອກ ຕາມມາດຕະຖານທີ່ໄດ້ຮັບການຍອມຮັບ ເຊັ່ນ: "
"<strong>ISAE\n"
"                3000</strong>, <strong>GRI 401-404</strong>, ຫຼື <strong>ມາດຕະຖ"
"ານແຮງງານ ILO</strong>\n"
"                ."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_basic_for_prepation
msgid ""
"Where reporting systems are still being harmonized, integration of\n"
"                        sustainability data collection, consolidation, and "
"internal control\n"
"                        procedures is targeted for completion by "
"<strong>[<em>insert target year</em>]</strong>."
msgstr ""
"ໃນກໍລະນີທີ່ລະບົບການລາຍງານຍັງຢູ່ໃນໄລຍະການປັບໃຫ້ສອດຄ່ອງກັນ, ການເຊື່ອມໂຍງການເກັບກຳ\n"
"                        ຂໍ້ມູນຄວາມຍືນຍົງ, ການຮວບຮວມ, ແລະ ຂັ້ນຕອນການຄວບຄຸມພາຍໃນ\n"
"                        ມີເປົ້າໝາຍໃຫ້ສຳເລັດພາຍໃນ <strong>[<em>ລະບຸປີເປົ້າໝາຍ</em>]</"
"strong>."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_basic_for_prepation
msgid ""
"Where such topics have been assessed as <strong>material</strong>,\n"
"                                the entity should still provide a "
"<strong>summary of relevant\n"
"                                impacts, policies,\n"
"                                    actions, and metrics</strong>."
msgstr ""
"ເມື່ອຫົວຂໍ້ດັ່ງກ່າວໄດ້ຮັບການປະເມີນວ່າມີ <strong>ຄວາມສຳຄັນ</strong>,\n"
"                                ອົງກອນຄວນສະໜອງ <strong>ບົດສະຫຼຸບກ່ຽວກັບຜົນກະທົບ,\n"
"                                ນະໂຍບາຍ, ການປະຕິບັດ,\n"
"                                    ແລະ ຕົວຊີ້ວັດທີ່ກ່ຽວຂ້ອງ</strong>."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_basic_for_prepation
msgid "Which standards are partially or fully omitted"
msgstr "ມາດຕະຖານໃດທີ່ຖືກລະເວັ້ນບາງສ່ວນ ຫຼື ທັງໝົດ"

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_governance_c
msgid "Whistleblowing and grievance reporting platforms."
msgstr "ລະບົບແຈ້ງເບາະແສ ແລະ ຊ່ອງທາງລາຍງານຂໍ້ຮ້ອງຮຽນ."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s1
msgid "Whistleblowing or feedback channels"
msgstr "ຊ່ອງທາງການແຈ້ງເບາະແສ ຫຼື ຄຳຕິຊົມ"

#. module: esg
#: model_terms:ir.ui.view,arch_db:esg.emission_factor_search_view
msgid "With Assignations"
msgstr "ມີການມອບໝາຍ"

#. module: esg
#: model_terms:ir.ui.view,arch_db:esg.carbon_emission_report_search_view
msgid "With Emission Factor"
msgstr "ມີຄ່າສຳປະສິດການປ່ອຍອາຍພິດ"

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_basic_for_prepation
msgid "Within 1 year"
msgstr "ພາຍໃນ 1 ປີ"

#. module: esg
#: model_terms:ir.ui.view,arch_db:esg.emission_factor_search_view
msgid "Without Assignations"
msgstr "ບໍ່ມີການມອບໝາຍ"

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s1
msgid "Women in top-level management"
msgstr "ແມ່ຍິງໃນລະດັບການຄຸ້ມຄອງຂັ້ນສູງ"

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s1
msgid "Women in workforce"
msgstr "ແມ່ຍິງໃນກຳລັງແຮງງານ"

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s1
msgid "Work-Life Balance Metrics (S1-15)"
msgstr "ຕົວຊີ້ວັດຄວາມສົມດຸນລະຫວ່າງຊີວິດ ແລະ ການເຮັດວຽກ (S1-15)"

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s1
msgid ""
"Work-Life Balance Metrics (S1-15) <span class=\"d-print-none\">[Material]</"
"span>"
msgstr ""
"ຕົວຊີ້ວັດຄວາມສົມດຸນລະຫວ່າງຊີວິດ ແລະ ການເຮັດວຽກ (S1-15) <span class=\"d-print-none\">[ມີຄ"
"ວາມສຳຄັນ]</span>"

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s1
msgid ""
"Work-Life Balance Metrics (S1-15) <span class=\"d-print-none\">[Non "
"Material]</span>"
msgstr ""
