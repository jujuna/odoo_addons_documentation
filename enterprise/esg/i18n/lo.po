#. module: esg
#: model:ir.ui.menu,name:esg.menu_esg_report
msgid "Report"
msgstr "ລາຍງານ"

#. module: esg
#: model:ir.model.fields,field_description:esg.field_esg_report__report_type
msgid "Report Type"
msgstr "ປະເພດລາຍງານ"

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_vsm_c3
msgid "Report absolute values, not relative percentages only."
msgstr "ລາຍງານມູນຄ່າຕົວຈິງ, ບໍ່ແມ່ນສະເພາະເປີເຊັນປຽບທຽບເທົ່ານັ້ນ."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_g1
msgid "Report aggregated metrics across suppliers."
msgstr "ລາຍງານຕົວຊີ້ວັດລວມໃນທົ່ວຜູ້ສະໜອງ."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_vsm_c8
msgid "Report both current and prior year revenue for comparability."
msgstr "ລາຍງານລາຍຮັບທັງປີປະຈຸບັນ ແລະ ປີກ່ອນໜ້າເພື່ອການປຽບທຽບ."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_vsm_c7
msgid ""
"Report corrective actions taken in the Notes column (investigation, "
"remediation, supplier engagement, policy updates)."
msgstr ""
"ລາຍງານມາດຕະການແກ້ໄຂທີ່ໄດ້ປະຕິບັດໃນຖັນໝາຍເຫດ (ການສືບສວນ, ການຟື້ນຟູ/ແກ້ໄຂ, ການມີສ່ວນຮ່ວມຂອງຜູ້ສະ"
"ໜອງ, ການອັບເດດນະໂຍບາຍ)."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e1
msgid ""
"Report gross removals separately from emission\n"
"                                            reductions."
msgstr ""
"ລາຍງານການກຳຈັດລວມແຍກຕ່າງຫາກຈາກການຫຼຸດຜ່ອນ\n"
"                                            ການປ່ອຍອາຍພິດ."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_g1
msgid ""
"Report on coverage, frequency, and\n"
"                                                                effectiveness "
"of anti-corruption\n"
"                                                                programs."
msgstr ""
"ລາຍງານກ່ຽວກັບການກວມເອົາ, ຄວາມຖີ່, ແລະ\n"
"                                                                ປະສິດທິຜົນຂອງໂຄງ"
"ການ\n"
"                                                                ຕ້ານການສໍ້ລາດບັງຫຼ"
"ວງ."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_vsm_c6
msgid ""
"Report only discrimination/harassment incidents; not accidents or safety "
"events."
msgstr ""
"ລາຍງານສະເພາະເຫດການການຈຳແນກ/ການລົບກວນ; ບໍ່ແມ່ນອຸບັດຕິເຫດ ຫຼື ເຫດການຄວາມປອດໄພ."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_vsm_b6
msgid ""
"Report only withdrawal, unless consumption is relevant due to production "
"processes."
msgstr ""
"ລາຍງານສະເພາະການດຶງນ້ຳມາໃຊ້, ເວັ້ນເສຍແຕ່ວ່າການຊົມໃຊ້ນັ້ນມີຄວາມກ່ຽວຂ້ອງເນື່ອງຈາກຂະບວນການຜະລິດ."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e5
msgid ""
"Report product circularity features (durability,\n"
"                                            reparability,\n"
"                                            recyclability) and disclose "
"waste generation by\n"
"                                            type, treatment, and\n"
"                                            recovery method. Highlight % of "
"waste diverted from\n"
"                                            disposal and the\n"
"                                            proportion of recyclable content "
"in products or\n"
"                                            packaging."
msgstr ""
"ລາຍງານຄຸນລັກສະນະເສດຖະກິດໝູນວຽນຂອງຜະລິດຕະພັນ (ຄວາມທົນທານ,\n"
"                                            ການສ້ອມແປງໄດ້,\n"
"                                            ການຣີໄຊເຄິນໄດ້) ແລະ ເປີດເຜີຍການສ້າງສິ່ງເສ"
"ດເຫຼືອຕາມ\n"
"                                            ປະເພດ, ການບຳບັດ, ແລະ\n"
"                                            ວິທີການຟື້ນຟູ. ເນັ້ນ % ຂອງສິ່ງເສດເຫຼືອທີ່ຫຼີກລ່ຽງ"
"ຈາກ\n"
"                                            ການກຳຈັດ ແລະ\n"
"                                            ອັດຕາສ່ວນຂອງເນື້ອຫາທີ່ຣີໄຊເຄິນໄດ້ໃນຜະລິດຕະພັ"
"ນ ຫຼື\n"
"                                            ການຫຸ້ມຫໍ່."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e4
msgid ""
"Report targets set to mitigate material impacts and achieve\n"
"                                        policy\n"
"                                        objectives, with dates, milestones, "
"ecological thresholds,\n"
"                                        alignment with\n"
"                                        global/EU biodiversity frameworks, "
"and the relevant\n"
"                                        mitigation hierarchy\n"
"                                        layer."
msgstr ""
"ລາຍງານເປົ້າໝາຍທີ່ກຳນົດຂຶ້ນເພື່ອຫຼຸດຜ່ອນຜົນກະທົບທີ່ມີຄວາມສຳຄັນ ແລະ ບັນລຸ\n"
"                                        ຈຸດປະສົງ\n"
"                                        ຂອງນະໂຍບາຍ, ພ້ອມດ້ວຍວັນທີ, ຂີດໝາຍສຳຄັນ, ເກນ"
"ທາງນິເວດວິທະຍາ,\n"
"                                        ຄວາມສອດຄ່ອງກັບ\n"
"                                        ຂອບວຽກຄວາມຫຼາກຫຼາຍທາງຊີວະພາບລະດັບໂລກ/ສະຫະ"
"ພາບເອີຣົບ, ແລະ ຂັ້ນຕອນ\n"
"                                        ລຳດັບການຫຼຸດຜ່ອນ\n"
"                                        ຜົນກະທົບທີ່ກ່ຽວຂ້ອງ."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_vsm_c9
msgid "Report the gender diversity ratio clearly."
msgstr "ລາຍງານອັດຕາສ່ວນຄວາມຫຼາກຫຼາຍທາງເພດໃຫ້ຊັດເຈນ."

#. module: esg
#: model:ir.model.fields,field_description:esg.field_esg_metric__date_start
#: model:ir.model.fields,field_description:esg.field_esg_report__start_date
msgid "Reporting Date"
msgstr "ວັນທີລາຍງານ"

#. module: esg
#: model:ir.model.fields,field_description:esg.field_esg_metric__date_end
#: model:ir.model.fields,field_description:esg.field_esg_report__end_date
msgid "Reporting End Date"
msgstr "ວັນທີສິ້ນສຸດການລາຍງານ"

#. module: esg
#: model_terms:ir.ui.view,arch_db:esg.esg_metric_list_view
#: model_terms:ir.ui.view,arch_db:esg.esg_metric_search_view
msgid "Reporting Period"
msgstr "ໄລຍະເວລາການລາຍງານ"

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_vsm_b4
msgid "Reporting Year Value"
msgstr "ມູນຄ່າຂອງປີລາຍງານ"

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_environmental_a
msgid ""
"Reporting covers operational sites and value-chain activities with\n"
"                    potential or actual impacts on biodiversity and "
"ecosystems, including areas\n"
"                    within or near protected or high-biodiversity zones. "
"Exclusions are justified\n"
"                    based on materiality or data availability."
msgstr ""
"ການລາຍງານກວມເອົາສະຖານທີ່ດຳເນີນງານ ແລະ ກິດຈະກຳໃນຕ່ອງໂສ້ມູນຄ່າທີ່ມີ\n"
"                    ຜົນກະທົບທີ່ອາດເກີດຂຶ້ນ ຫຼື ເກີດຂຶ້ນຕົວຈິງຕໍ່ຄວາມຫຼາກຫຼາຍທາງຊີວະພາບ ແລະ ລະບົບນິ"
"ເວດ, ລວມທັງພື້ນທີ່\n"
"                    ພາຍໃນ ຫຼື ໃກ້ຄຽງກັບເຂດສະຫງວນ ຫຼື ເຂດທີ່ມີຄວາມຫຼາກຫຼາຍທາງຊີວະພາບສູງ. ກາ"
"ນຍົກເວັ້ນແມ່ນມີເຫດຜົນຮອງຮັບ\n"
"                    ໂດຍອີງໃສ່ຄວາມມີສຳຄັນ ຫຼື ຄວາມພ້ອມຂອງຂໍ້ມູນ."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_social_b
msgid ""
"Reporting covers workforce-related practices across the value chain, "
"including\n"
"                permanent, temporary, and contract workers. Exclusions are "
"justified based on\n"
"                materiality, legal constraints, or data availability."
msgstr ""
"ການລາຍງານກວມເອົາແນວທາງປະຕິບັດທີ່ກ່ຽວຂ້ອງກັບກຳລັງແຮງງານໃນທົ່ວຕ່ອງໂສ້ມູນຄ່າ, ລວມທັງ\n"
"                ພະນັກງານຖາວອນ, ຊົ່ວຄາວ, ແລະ ຕາມສັນຍາຈ້າງ. ການຍົກເວັ້ນແມ່ນມີເຫດຜົນຮອງຮັບໂດ"
"ຍອີງໃສ່\n"
"                ຄວາມມີສຳຄັນ, ຂໍ້ຈຳກັດທາງກົດໝາຍ, ຫຼື ຄວາມພ້ອມຂອງຂໍ້ມູນ."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_social_b
msgid "Reporting covers:"
msgstr "ການລາຍງານກວມເອົາ:"

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_environmental_a
msgid ""
"Reporting includes own operations and value-chain stages (upstream and\n"
"                    downstream) contributing to material use and waste "
"generation. Exclusions are\n"
"                    justified based on data availability or immateriality."
msgstr ""
"ການລາຍງານລວມມີການດຳເນີນງານຂອງຕົນເອງ ແລະ ຂັ້ນຕອນໃນຕ່ອງໂສ້ມູນຄ່າ (ຕົ້ນນ້ຳ ແລະ\n"
"                    ປາຍນ້ຳ) ທີ່ປະກອບສ່ວນເຂົ້າໃນການນຳໃຊ້ວັດສະດຸ ແລະ ການເກີດສິ່ງເສດເຫຼືອ. ການ"
"ຍົກເວັ້ນແມ່ນ\n"
"                    ມີເຫດຜົນຮອງຮັບໂດຍອີງໃສ່ຄວາມພ້ອມຂອງຂໍ້ມູນ ຫຼື ການບໍ່ມີຄວາມສຳຄັນ."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_vsm_b11
msgid ""
"Reporting prompt payments demonstrates compliance and strengthens supplier "
"trust. Keep records of disputes and resolution measures."
msgstr ""
"ການລາຍງານການຊຳລະເງິນຢ່າງວ່ອງໄວສະແດງເຖິງການປະຕິບັດຕາມກົດລະບຽບ ແລະ ເສີມສ້າງຄວາມໄວ້ວາງໃຈຂອ"
"ງຜູ້ສະໜອງ. ຮັກສາບັນທຶກຂໍ້ຂັດແຍ່ງ ແລະ ມາດຕະການແກ້ໄຂ."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_vsm_c7
msgid "Reporting “0” is mandatory when no incidents occurred."
msgstr "ການລາຍງານ “0” ແມ່ນຈຳເປັນເມື່ອບໍ່ມີເຫດການໃດໆເກີດຂຶ້ນ."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_vsm_c4
msgid "Reputation"
msgstr "ຊື່ສຽງ"

