msgstr "En son kaydedilen değerin tarihi."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_basic_for_prepation
msgid "The disclosure applies to <strong>own operations</strong>,"
msgstr "Açıklama, <strong>kendi operasyonlarımız</strong> için geçerlidir,"

#. module: esg
#: model:ir.model.fields,help:esg.field_esg_action__target_end_date
