msgstr "Bu emisyon faktörünün geçerli olduğu ülkeler."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_general_information
msgid ""
"The data and disclosures cover the reporting period from "
"<strong>{{ date_start }}</strong> to <strong>{{ date_end }}</strong>, "
