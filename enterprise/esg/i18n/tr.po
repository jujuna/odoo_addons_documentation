msgid ""
"<strong>\n"
"                                    <em>{{ company_name }}</em>\n"
"                                </strong>operates\n"
"                                grievance mechanisms enabling confidential "
"reporting of workplace\n"
"                                concerns, including discrimination, "
"harassment, or labor rights\n"
"                                breaches. All cases are logged, "
"investigated, and remediated. Severe\n"
"                                impacts are escalated to executive level and "
"disclosed\n"
"                                transparently."
msgstr ""
"<strong>\n"
"                                    <em>{{ company_name }}</em>\n"
"                               </strong> işletir\n"
"                                ayrımcılık, taciz veya iş hakları\n"
"                                ihlalleri dahil olmak üzere işyerindeki "
"endişelerin gizli bir şekilde bildirilmesini sağlayan\n"
"                                şikayet mekanizmaları. Tüm vakalar "
"kaydedilir, soruşturulur ve düzeltilir. Ciddi\n"
"                                etkiler yönetici düzeyine iletilir ve\n"
"                                şeffaf bir şekilde açıklanır."

