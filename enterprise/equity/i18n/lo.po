#. module: equity
#: model:mail.template,body_html:equity.equity_ubo_form_email_template
msgid ""
"<div>\n"
"                    <p> Hello,<br/>\n"
"                        Following our legal obligations to identify clients, "
"we need to report natural persons who directly or indirectly\n"
"                        hold or control at least 25% in the capital or "
"voting rights of <b><t t-out=\"user_id.company_id.name\"/></b>. <br/> <br/>\n"
"                        Please fill in the UBO request through the link "
"above.<br/> <br/>\n"
"                        Thank you,\n"
"                        <t t-if=\"user_id.signature\">\n"
"                            <br/>--<br/>\n"
"                            <t t-out=\"user_id.signature\"/>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div>\n"
"                    <p> ສະບາຍດີ,<br/>\n"
"                        ຕາມພັນທະທາງກົດໝາຍຂອງພວກເຮົາໃນການຢັ້ງຢືນຕົວຕົນລູກຄ້າ, ພວກເຮົາຕ້ອງລ"
"າຍງານບຸກຄົນທຳມະດາທີ່ຖືຄອງ ຫຼື ຄວບຄຸມໂດຍກົງ ຫຼື ທາງອ້ອມ\n"
"                        ຢ່າງໜ້ອຍ 25% ໃນທຶນ ຫຼື ສິດອອກສຽງຂອງ <b><t t-"
"out=\"user_id.company_id.name\"/></b>. <br/> <br/>\n"
"                        ກະລຸນາຕື່ມແບບຟອມຄຳຮ້ອງຂໍ UBO ຜ່ານລິ້ງຂ້າງເທິງ.<br/> <br/>\n"
"                        ຂໍຂອບໃຈ,\n"
"                        <t t-if=\"user_id.signature\">\n"
"                            <br/>--<br/>\n"
"                            <t t-out=\"user_id.signature\"/>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "

#. module: equity
#: model:mail.template,body_html:equity.equity_shareholder_email_template
msgid ""
"<div>\n"
"                    <p> Hello,<br/>\n"
"                        You will find your latest transaction and valuations "
"in the link above. <br/> <br/>\n"
"                        Best,\n"
"                        <t t-if=\"user_id.signature\">\n"
"                            <br/>--<br/>\n"
"                            <t t-out=\"user_id.signature\"/>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div>\n"
"                    <p> ສະບາຍດີ,<br/>\n"
"                        ທ່ານສາມາດກວດເບິ່ງທຸລະກຳ ແລະ ການປະເມີນມູນຄ່າຫຼ້າສຸດຂອງທ່ານໄດ້ຕາມລິ້ງ"
"ຂ້າງເທິງ. <br/> <br/>\n"
"                        ດ້ວຍຄວາມນັບຖື,\n"
"                        <t t-if=\"user_id.signature\">\n"
"                            <br/>--<br/>\n"
"                            <t t-out=\"user_id.signature\"/>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "

