#: code:addons/sale_tiktok/wizard/tiktok_shop_create_wizard.py:0
msgid "(Pending Authorization)"
msgstr "(Yetkilendirme Bekleniyor)"

#. module: sale_tiktok
#: model:mail.template,body_html:sale_tiktok.order_sync_failure
msgid ""
"<div>\n"
"                <p>\n"
"                    The synchronization of the TikTok Shop order with "
"reference\n"
"                    <t t-out=\"ctx.get('tiktok_order_ref') or ''\">REF</t>\n"
"                    encountered an error and was not completed.\n"
"                </p>\n"
"                <p>\n"
"                    Unless the order is canceled in TikTok Shop, no other "
"synchronization will be attempted.\n"
"                </p>\n"
"                <p>\n"
"                    To schedule a new synchronization attempt, proceed as "
"follows:\n"
"                    </p><ol>\n"
"                        <li>Enter the Developer Tools.</li>\n"
"                        <li>Open the form of the TikTok Shop on which the "
"order was placed.</li>\n"
"                        <li>Navigate to the Order Follow-up tab.</li>\n"
"                        <li>\n"
"                            Set a date for <em>Last Order Synchronization "
"Date</em> that is before the last status update of the order.\n"
"                        </li>\n"
"                        <li>Save the changes and click on the <em>SYNC "
"ORDERS</em> button.</li>\n"
"                    </ol>\n"
"                \n"
"                <p>\n"
"                    If the problem persists, contact\n"
"                    <a href=\"https://www.odoo.com/help/\">Odoo support</"
"a>.\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div>\n"
"                <p>\n"
"                    TikTok Shop siparişinin referans numarasıyla "
"senkronizasyonu\n"
"                   <t t-out=\"ctx.get('tiktok_order_ref') or ''\"> REF</t>\n"
"                    bir hata ile karşılaştı ve tamamlanamadı.\n"
"               </p>\n"
"                <p> \n"
"                    Sipariş TikTok Shop'ta iptal edilmedikçe, başka bir "
"senkronizasyon denemesi yapılmayacaktır.\n"
"               </p>\n"
"                <p> \n"
"                    Yeni bir senkronizasyon denemesi planlamak için "
"aşağıdaki adımları izleyin:\n"
"                   </p><ol> \n"
"                       <li> Geliştirici Araçları'na girin.</li>\n"
"                        <li>Siparişin verildiği TikTok Shop formunu açın.</"
"li>\n"
"                        <li>\"Sipariş Takibi\" sekmesine gidin.</li>\n"
"                        <li>\n"
"                            \" <em>\" (Son Sipariş Senkronizasyon Tarihi)</"
"em> için, siparişin son durum güncellemesinden önceki bir tarih belirleyin.\n"
"                       </li>\n"
"                        <li> Değişiklikleri kaydedin ve \" <em>\" "
"(Siparişleri Senkronize Et)</em> düğmesine tıklayın.</li>\n"
"                    </ol>\n"
"                \n"
"               <p> \n"
"                    Sorun devam ederse,\n"
"                   <a href=\"https://www.odoo.com/help/\"> Odoo destek "
"ekibiyle</a> iletişime geçin.\n"
"               </p>\n"
"            </div> \n"
"        "

#. module: sale_tiktok
#: model_terms:ir.ui.view,arch_db:sale_tiktok.tiktok_shop_form
