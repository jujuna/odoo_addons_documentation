"<strong>Authorization Failed: </strong>\n"
"                    An unexpected error occurred during authorization. "
"Please try again."
msgstr ""
"<strong>Yetkilendirme Başarısız: </strong>\n"
"                    Yetkilendirme sırasında beklenmedik bir hata oluştu. "
"Lütfen tekrar deneyin."

#. module: sale_tiktok
#: model_terms:ir.ui.view,arch_db:sale_tiktok.tiktok_shop_create_wizard_view_form
msgid ""
"<strong>Where to find your API credentials:</strong><br/>\n"
"                    1. Go to TikTok Shop Partner Center<br/>\n"
"                    2. Navigate to Apps &amp; Service → Create New App or "
"use existing<br/>\n"
"                    3. Grant the App permissions to access your shop data<br/"
">\n"
"                    4. Get your Service ID, App key and App secret<br/>"
msgstr ""
"<strong>API kimlik bilgilerinizi nereden bulabilirsiniz:</strong><br/>\n"
"                    1. TikTok Shop İş Ortağı Merkezi'ne gidin<br/>\n"
"                    2. Uygulamalar &amp; Hizmeti → Yeni Uygulama Oluştur "
"seçeneğine gidin veya mevcut bir uygulamayı kullanın<br/>\n"
"                    3. Uygulamaya mağaza verilerinize erişim izni verin<br/>"
"\n"
"                    4. Hizmet Kimliğinizi, Uygulama anahtarınızı ve Uygulama "
"gizli anahtarınızı alın<br/>"

#. module: sale_tiktok
#: model:mail.template,body_html:sale_tiktok.inventory_sync_failure
msgid ""
"<style>\n"
"                .tiktok_table {\n"
"                    width: 100%;\n"
"                    max-width: 900px;\n"
"                    border-collapse: collapse;\n"
"                }\n"
"\n"
"                .tiktok_table th,\n"
"                .tiktok_table td {\n"
"                    border: 1px solid #888;\n"
"                }\n"
"\n"
"                .tiktok_table th {\n"
"                    white-space: nowrap;\n"
"                }\n"
"\n"
"                .tiktok_table thead th {\n"
"                    padding: 0.5em 0.5em;\n"
"                    text-align: center;\n"
"                    border-bottom: 1px solid #888;\n"
"                }\n"
"\n"
"                .tiktok_table tbody th,\n"
"                .tiktok_table tbody td {\n"
"                    padding: 0.5em 0.5em 1em;\n"
"                    vertical-align: top;\n"
"                }\n"
"            </style>\n"
"            <body><div>\n"
"                <p>\n"
"                    The synchronization of the inventory for TikTok Shop\n"
"                    <b><t t-out=\"ctx.get('tiktok_shop') or ''\">REF</t></"
"b>\n"
"                    encountered some errors and was not completed.\n"
"                </p>\n"
"                <p>Here are the errors sent by TikTok Shop:</p>\n"
"                <table class=\"tiktok_table\">\n"
"                    <thead>\n"
"                        <tr>\n"
"                            <th>Product Internal Reference(s)</th>\n"
"                            <th>Message</th>\n"
"                        </tr>\n"
"                    </thead>\n"
"                    <tbody>\n"
"                        <tr t-foreach=\"ctx.get('error_messages')\" t-"
"as=\"error\">\n"
"                            <th>\n"
"                                <t t-out=\"', '.join(error['default_codes'])"
"\"></t>\n"
"                            </th>\n"
"                            <td>\n"
"                                <t t-if=\"error['message']\" t-"
"out=\"error['message']\"></t>\n"
"                                <t t-else=\"\">\n"
"                                    An unknown error occurred during the "
"synchronisation with TikTok Shop.\n"
"                                    Unfortunately you need to manually check "
"if the available quantity for the product is correct or not.\n"
"                                    If the problem persists, contact\n"
"                                    <a href=\"https://www.odoo.com/help/"
"\">Odoo support</a>.\n"
"                                </t>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"            </div>\n"
"        </body>"
msgstr ""
"<style>\n"
"                .tiktok_table {\n"
"                    width: 100%;\n"
"                    max-width: 900px;\n"
"                    border-collapse: collapse;\n"
"                }\n"
"\n"
"                .tiktok_table th,\n"
"                .tiktok_table td {\n"
"                    border: 1px solid #888;\n"
"                }\n"
"\n"
"                .tiktok_table th {\n"
"                    white-space: nowrap;\n"
"                }\n"
"\n"
"                .tiktok_table thead th {\n"
"                    padding: 0.5em 0.5em;\n"
"                    text-align: center;\n"
"                    border-bottom: 1px solid #888;\n"
"                }\n"
"\n"
"                .tiktok_table tbody th,\n"
"                .tiktok_table tbody td {\n"
"                    padding: 0.5em 0.5em 1em;\n"
"                    vertical-align: top;\n"
"                }\n"
"            </style>\n"
"            <body><div>\n"
"                <p>\n"
"                    TikTok Mağazası için stok senkronizasyonu\n"
"                    <b><t t-out=\"ctx.get('tiktok_shop') or ''\">REF</t></b>"
"\n"
"                    bazı hatalarla karşılaştı ve tamamlanamadı.\n"
"                </p>\n"
"                <p>TikTok Mağazası tarafından gönderilen hatalar şunlardır:</"
"p>\n"
"                <table class=\"tiktok_table\">\n"
"                    <thead>\n"
"                        <tr>\n"
"                            <th>Ürün Dahili Referans(lar)ı</th>\n"
"                            <th>Mesaj</th>\n"
"                        </tr>\n"
"                    </thead>\n"
"                    <tbody>\n"
"                        <tr t-foreach=\"ctx.get('error_messages')\" t-"
"as=\"error\">\n"
"                            <th>\n"
"                                <t t-out=\"', '.join(error['default_codes'])"
"\"></t>\n"
"                            </th>\n"
"                            <td>\n"
"                                <t t-if=\"error['message']\" t-"
"out=\"error['message']\"></t>\n"
"                                <t t-else=\"\">\n"
"                                    TikTok Mağazası ile senkronizasyon "
"sırasında bilinmeyen bir hata oluştu.\n"
"                                    Maalesef, ürün için mevcut miktarın "
"doğru olup olmadığını manuel olarak kontrol etmeniz gerekiyor.\n"
"                                    Sorun devam ederse, \n"
"                                    <a href=\"https://www.odoo.com/help/\">"
"Odoo desteği</a> ile iletişime geçin.\n"
"                                </t>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"            </div>\n"
"        </body>"

