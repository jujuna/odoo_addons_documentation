#. module: sale_tiktok
#: model_terms:ir.ui.view,arch_db:sale_tiktok.tiktok_shop_create_wizard_view_form
#, fuzzy
msgid ""
"<strong>Where to find your API credentials:</strong><br/>\n"
"                    1. Go to TikTok Shop Partner Center<br/>\n"
"                    2. Navigate to Apps &amp; Service → Create New App or "
"use existing<br/>\n"
"                    3. Grant the App permissions to access your shop data<br/"
">\n"
"                    4. Get your Service ID, App key and App secret<br/>"
msgstr ""
"<strong>Onde encontrar suas credenciais de API:</strong><br/>\n"
"                    1. Acesse o TikTok Shop Partner Center<br/>\n"
"                    2. Navegue até Aplicativos &amp; Serviço → Criar Novo "
"Aplicativo ou usar um existente<br/>\n"
"                    3. Conceda ao aplicativo permissões para acessar os "
"dados da sua loja<br/>\n"
"                    4. Obtenha seu ID de Serviço, chave do Aplicativo e "
"segredo do Aplicativo<br/>"

#. module: sale_tiktok
#: model:mail.template,body_html:sale_tiktok.inventory_sync_failure
msgid ""
"<style>\n"
"                .tiktok_table {\n"
"                    width: 100%;\n"
"                    max-width: 900px;\n"
"                    border-collapse: collapse;\n"
"                }\n"
"\n"
"                .tiktok_table th,\n"
"                .tiktok_table td {\n"
"                    border: 1px solid #888;\n"
"                }\n"
"\n"
"                .tiktok_table th {\n"
"                    white-space: nowrap;\n"
"                }\n"
"\n"
"                .tiktok_table thead th {\n"
"                    padding: 0.5em 0.5em;\n"
"                    text-align: center;\n"
"                    border-bottom: 1px solid #888;\n"
"                }\n"
"\n"
"                .tiktok_table tbody th,\n"
"                .tiktok_table tbody td {\n"
"                    padding: 0.5em 0.5em 1em;\n"
"                    vertical-align: top;\n"
"                }\n"
"            </style>\n"
"            <body><div>\n"
"                <p>\n"
"                    The synchronization of the inventory for TikTok Shop\n"
"                    <b><t t-out=\"ctx.get('tiktok_shop') or ''\">REF</t></"
"b>\n"
"                    encountered some errors and was not completed.\n"
"                </p>\n"
"                <p>Here are the errors sent by TikTok Shop:</p>\n"
"                <table class=\"tiktok_table\">\n"
"                    <thead>\n"
"                        <tr>\n"
"                            <th>Product Internal Reference(s)</th>\n"
"                            <th>Message</th>\n"
"                        </tr>\n"
"                    </thead>\n"
"                    <tbody>\n"
"                        <tr t-foreach=\"ctx.get('error_messages')\" t-"
"as=\"error\">\n"
"                            <th>\n"
"                                <t t-out=\"', '.join(error['default_codes'])"
"\"></t>\n"
"                            </th>\n"
"                            <td>\n"
"                                <t t-if=\"error['message']\" t-"
"out=\"error['message']\"></t>\n"
"                                <t t-else=\"\">\n"
"                                    An unknown error occurred during the "
"synchronisation with TikTok Shop.\n"
"                                    Unfortunately you need to manually check "
"if the available quantity for the product is correct or not.\n"
"                                    If the problem persists, contact\n"
"                                    <a href=\"https://www.odoo.com/help/"
"\">Odoo support</a>.\n"
"                                </t>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"            </div>\n"
"        </body>"
msgstr ""
"<style>\n"
"                .tiktok_table {\n"
"                    width: 100%;\n"
"                    max-width: 900px;\n"
"                    border-collapse: collapse;\n"
"                }\n"
"\n"
"                .tiktok_table th,\n"
"                .tiktok_table td {\n"
"                    border: 1px solid #888;\n"
"                }\n"
"\n"
"                .tiktok_table th {\n"
"                    white-space: nowrap;\n"
"                }\n"
"\n"
"                .tiktok_table thead th {\n"
"                    padding: 0.5em 0.5em;\n"
"                    text-align: center;\n"
"                    border-bottom: 1px solid #888;\n"
"                }\n"
"\n"
"                .tiktok_table tbody th,\n"
"                .tiktok_table tbody td {\n"
"                    padding: 0.5em 0.5em 1em;\n"
"                    vertical-align: top;\n"
"                }\n"
"            </style>\n"
"            <body><div>\n"
"                <p>\n"
"                    A sincronização do inventário para a TikTok Shop\n"
"                    <b><t t-out=\"ctx.get('tiktok_shop') or ''\">REF</t></b>"
"\n"
"                    encontrou alguns erros e não foi concluída.\n"
"                </p>\n"
"                <p>Aqui estão os erros enviados pela TikTok Shop:</p>\n"
"                <table class=\"tiktok_table\">\n"
"                    <thead>\n"
"                        <tr>\n"
"                            <th>Referência(s) interna(s) do produto</th>\n"
"                            <th>Mensagem</th>\n"
"                        </tr>\n"
"                    </thead>\n"
"                    <tbody>\n"
"                        <tr t-foreach=\"ctx.get('error_messages')\" t-"
"as=\"error\">\n"
"                            <th>\n"
"                                <t t-out=\"', '.join(error['default_codes'])"
"\"></t>\n"
"                            </th>\n"
"                            <td>\n"
"                                <t t-if=\"error['message']\" t-"
"out=\"error['message']\"></t>\n"
"                                <t t-else=\"\">\n"
"                                    Ocorreu um erro desconhecido durante a "
"sincronização com a TikTok Shop.\n"
"                                    Infelizmente, você precisa verificar "
"manualmente se a quantidade disponível para o produto está correta ou não.\n"
"                                    Se o problema persistir, entre em "
"contato com o\n"
"                                    <a href=\"https://www.odoo.com/help/\">"
"suporte da Odoo</a>.\n"
"                                </t>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"            </div>\n"
"        </body>"

