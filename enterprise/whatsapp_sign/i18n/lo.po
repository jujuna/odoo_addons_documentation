#. module: whatsapp_sign
#: model_terms:ir.ui.view,arch_db:whatsapp_sign.sign_request_logs_user_whatsapp
msgid ""
"<small>Phone verification: The signatory has confirmed control of their "
"phone number by clicking on a unique link</small>"
msgstr ""
"<small>ການຢືນຢັນເບີໂທ: ຜູ້ລົງລາຍເຊັນໄດ້ຢືນຢັນການຄວບຄຸມເບີໂທລະສັບຂອງຕົນເອງໂດຍການກົດໃສ່ລິ້ງສະເພາ"
"ະ</small>"

#. module: whatsapp_sign
#. odoo-python
#: code:addons/whatsapp_sign/models/sign_request.py:0
msgid ""
"All Whatsapp templates must be configured before creating the sign request."
msgstr "ແມ່ແບບ Whatsapp ທັງໝົດຕ້ອງໄດ້ຮັບການຕັ້ງຄ່າກ່ອນທີ່ຈະສ້າງຄຳຂໍລົງລາຍເຊັນ."

#. module: whatsapp_sign
#. odoo-python
#: code:addons/whatsapp_sign/wizard/sign_send_request.py:0
msgid "All signers must have a phone number to send messages via WhatsApp."
msgstr "ຜູ້ລົງລາຍເຊັນທຸກຄົນຕ້ອງມີເບີໂທລະສັບເພື່ອສົ່ງຂໍ້ຄວາມຜ່ານ WhatsApp."

#. module: whatsapp_sign
#: model_terms:ir.ui.view,arch_db:whatsapp_sign.res_config_settings_view_form
msgid "Allow users to send documents for signing via WhatsApp"
msgstr "ອະນຸຍາດໃຫ້ຜູ້ໃຊ້ສົ່ງເອກະສານເພື່ອລົງລາຍເຊັນຜ່ານ WhatsApp"

#. module: whatsapp_sign
#: model:ir.model.fields,help:whatsapp_sign.field_res_config_settings__request_completion_wa_template_id
msgid "Approved WhatsApp template sent when a signature request is completed."
msgstr ""
"ແມ່ແບບ WhatsApp ທີ່ໄດ້ຮັບການອະນຸມັດ ຖືກສົ່ງເມື່ອຄຳຂໍລົງລາຍເຊັນສຳເລັດແລ້ວ."

#. module: whatsapp_sign
#: model:ir.model.fields,help:whatsapp_sign.field_res_config_settings__request_refusal_wa_template_id
msgid "Approved WhatsApp template sent when a signature request is refused."
msgstr ""
"ແມ່ແບບ WhatsApp ທີ່ໄດ້ຮັບການອະນຸມັດ ຖືກສົ່ງເມື່ອຄຳຂໍລົງລາຍເຊັນຖືກປະຕິເສດ."

#. module: whatsapp_sign
#: model:ir.model.fields,help:whatsapp_sign.field_res_config_settings__sign_send_request_wa_template_id
msgid "Approved WhatsApp template used to send signature requests."
msgstr "ແມ່ແບບ WhatsApp ທີ່ໄດ້ຮັບການອະນຸມັດ ທີ່ໃຊ້ສຳລັບການສົ່ງຄຳຂໍລົງລາຍເຊັນ."

