<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sign_request_logs_user_whatsapp" inherit_id="sign.sign_request_logs_user">
        <xpath expr="//t[@name='participant_email_authentication']" position="after">
            <t t-elif="o.send_channel == 'whatsapp' and sri.access_via_link">
                Unique Link via WhatsApp
                <t t-set="whatsapp_num" t-value="sri.partner_id.phone"/>
                <div t-if="whatsapp_num" t-out="''.join(['******', whatsapp_num[-4:]])">******1234</div>
            </t>
        </xpath>
    </template>
</odoo>
