#. module: website_generator
#: model:ir.module.module,description:base.module_website_generator
msgid ""
"\n"
"Generates a new website in Odoo, with the goal of recreating an external "
"website as close as possible.\n"
msgstr ""
"\n"
"ສ້າງເວັບໄຊໃໝ່ໃນ Odoo ໂດຍມີເປົ້າໝາຍເພື່ອສ້າງເວັບໄຊພາຍນອກຄືນໃໝ່ໃຫ້ໃກ້ຄຽງທີ່ສຸດເທົ່າທີ່ຈະເປັນໄປໄດ້.\n"

#. module: website_generator
#: model:mail.template,body_html:website_generator.email_template_website_scrapped
msgid ""
"<div>\n"
"                    <t t-if=\"ctx.get('website_url') and "
"ctx.get('nbr_products_created') and ctx.get('nbr_products_created') &gt; 0 "
"and ctx.get('nbr_blogs_created') and ctx.get('nbr_blogs_created') &gt; 0\">\n"
"                        <p><b>Great news!</b> Your website has been "
"generated, and <t t-out=\"ctx.get('nbr_products_created')\"/> products and "
"<t t-out=\"ctx.get('nbr_blogs_created')\"/> blog posts have been created.</"
"p>\n"
"                    </t>\n"
"                    <t t-elif=\"ctx.get('website_url') and "
"ctx.get('nbr_products_created') and ctx.get('nbr_products_created') &gt; "
"0\">\n"
"                        <p><b>Great news!</b> Your website has been "
"generated and <t t-out=\"ctx.get('nbr_products_created')\"/> product(s) have "
"been created.</p>\n"
"                    </t>\n"
"                    <t t-elif=\"ctx.get('website_url') and "
"ctx.get('nbr_blogs_created') and ctx.get('nbr_blogs_created') &gt; 0\">\n"
"                        <p><b>Great news!</b> Your website has been "
"generated and <t t-out=\"ctx.get('nbr_blogs_created')\"/> blog posts have "
"been created.</p>\n"
"                    </t>\n"
"                    <t t-elif=\"ctx.get('website_url')\">\n"
"                        <p><b>Great news!</b> Your website has been "
"successfully generated.</p>\n"
"                    </t>    \n"
"                    <t t-elif=\"ctx.get('nbr_products_created') and "
"ctx.get('nbr_products_created') &gt; 0 and ctx.get('nbr_blogs_created') and "
"ctx.get('nbr_blogs_created') &gt; 0\">\n"
"                        <p><b>Great news!</b> The import tool successfully "
"created <t t-out=\"ctx.get('nbr_products_created')\"/> products and <t t-"
"out=\"ctx.get('nbr_blogs_created')\"/> blog posts.</p>\n"
"                    </t>\n"
"                    <t t-elif=\"ctx.get('nbr_products_created') and "
"ctx.get('nbr_products_created') &gt; 0\">\n"
"                        <p><b>Great news!</b> The import tool successfully "
"created <t t-out=\"ctx.get('nbr_products_created')\"/> product(s).</p>\n"
"                    </t>\n"
"                    <t t-elif=\"ctx.get('nbr_blogs_created') and "
"ctx.get('nbr_blogs_created') &gt; 0\">\n"
"                        <p><b>Great news!</b> The import tool successfully "
"created <t t-out=\"ctx.get('nbr_blogs_created')\"/> blog post(s).</p>\n"
"                    </t>\n"
"                    <t t-else=\"\">\n"
"                        <p><b>Update:</b> We were unable to generate your "
"website or products this time.</p>\n"
"                        <p>This may happen for a variety of reasons, such as:"
"</p>\n"
"                        <ul>\n"
"                            <li>Protection mechanisms on your website "
"preventing automated access,</li>\n"
"                            <li>Temporary maintenance or limited "
"availability on our servers,</li>\n"
"                            <li>Custom code or configurations on your "
"website that are not fully compatible with our process.</li>\n"
"                        </ul>\n"
"                        <p>Feel free to try again later or contact us if the "
"issue persists — we’re here to help!</p>\n"
"                    </t>\n"
"\n"
"            <t t-if=\"ctx.get('website_url')\">\n"
"                <p>You can access your website by clicking the button below:"
"</p>\n"
"                <div style=\"margin: 16px 0px 16px 0px;\">\n"
"                    <a t-att-href=\"ctx.get('website_url')\" "
"style=\"background-color: #875A7B; padding: 8px 16px 8px 16px; text-"
"decoration: none; color: #fff; border-radius: 5px; font-size:13px;\">\n"
"                        Go to Website\n"
"                    </a>\n"
"                </div>\n"
"            </t>\n"
"            \n"
"            <p>Thank you for choosing Odoo for your web integration!</p>\n"
"            <p>Best regards,</p>\n"
"            <br/>\n"
"            <p>Odoo - The best open source website builder.</p>\n"
"            </div>\n"
"            "
msgstr ""
"<div>\n"
"                    <t t-if=\"ctx.get('website_url') and ctx.get"
"('nbr_products_created') and ctx.get('nbr_products_created') &gt; 0 and "
"ctx.get('nbr_blogs_created') and ctx.get('nbr_blogs_created') &gt; 0\">\n"
"                        <p><b>ຂ່າວດີ!</b> ເວັບໄຊຂອງທ່ານໄດ້ຮັບການສ້າງຂຶ້ນແລ້ວ, ແລະ ສິນຄ້າ "
"<t t-out=\"ctx.get('nbr_products_created')\"/> ລາຍການ ພ້ອມທັງບົດຄວາມບລັອກ <t t-"
"out=\"ctx.get('nbr_blogs_created')\"/> ບົດ ໄດ້ຮັບການສ້າງຂຶ້ນແລ້ວ.</p>\n"
"                    </t>\n"
"                    <t t-elif=\"ctx.get('website_url') and ctx.get"
"('nbr_products_created') and ctx.get('nbr_products_created') &gt; 0\">\n"
"                        <p><b>ຂ່າວດີ!</b> ເວັບໄຊຂອງທ່ານໄດ້ຮັບການສ້າງຂຶ້ນແລ້ວ ແລະ ສິນຄ້າ "
"<t t-out=\"ctx.get('nbr_products_created')\"/> ລາຍການ ໄດ້ຮັບການສ້າງຂຶ້ນແລ້ວ.</p>\n"
"                    </t>\n"
"                    <t t-elif=\"ctx.get('website_url') and ctx.get"
"('nbr_blogs_created') and ctx.get('nbr_blogs_created') &gt; 0\">\n"
"                        <p><b>ຂ່າວດີ!</b> ເວັບໄຊຂອງທ່ານໄດ້ຮັບການສ້າງຂຶ້ນແລ້ວ ແລະ ບົດຄວາມ"
"ບລັອກ <t t-out=\"ctx.get('nbr_blogs_created')\"/> ບົດ ໄດ້ຮັບການສ້າງຂຶ້ນແລ້ວ.</p>\n"
"                    </t>\n"
"                    <t t-elif=\"ctx.get('website_url')\">\n"
"                        <p><b>ຂ່າວດີ!</b> ເວັບໄຊຂອງທ່ານໄດ້ຮັບການສ້າງຂຶ້ນສຳເລັດແລ້ວ.</p>"
"\n"
"                    </t>    \n"
"                    <t t-elif=\"ctx.get('nbr_products_created') and ctx.get"
"('nbr_products_created') &gt; 0 and ctx.get('nbr_blogs_created') and ctx.get"
"('nbr_blogs_created') &gt; 0\">\n"
"                        <p><b>ຂ່າວດີ!</b> ເຄື່ອງມືນຳເຂົ້າໄດ້ສ້າງສິນຄ້າ <t t-"
"out=\"ctx.get('nbr_products_created')\"/> ລາຍການ ແລະ ບົດຄວາມບລັອກ <t t-"
"out=\"ctx.get('nbr_blogs_created')\"/> ບົດ ສຳເລັດແລ້ວ.</p>\n"
"                    </t>\n"
"                    <t t-elif=\"ctx.get('nbr_products_created') and ctx.get"
"('nbr_products_created') &gt; 0\">\n"
"                        <p><b>ຂ່າວດີ!</b> ເຄື່ອງມືນຳເຂົ້າໄດ້ສ້າງສິນຄ້າ <t t-"
"out=\"ctx.get('nbr_products_created')\"/> ລາຍການ ສຳເລັດແລ້ວ.</p>\n"
"                    </t>\n"
"                    <t t-elif=\"ctx.get('nbr_blogs_created') and ctx.get"
"('nbr_blogs_created') &gt; 0\">\n"
"                        <p><b>ຂ່າວດີ!</b> ເຄື່ອງມືນຳເຂົ້າໄດ້ສ້າງບົດຄວາມບລັອກ <t t-"
"out=\"ctx.get('nbr_blogs_created')\"/> ບົດ ສຳເລັດແລ້ວ.</p>\n"
"                    </t>\n"
"                    <t t-else=\"\">\n"
"                        <p><b>ອັບເດດ:</b> ພວກເຮົາບໍ່ສາມາດສ້າງເວັບໄຊ ຫຼື ສິນຄ້າຂອງທ່ານໄດ້ໃ"
"ນຄັ້ງນີ້.</p>\n"
"                        <p>ສິ່ງນີ້ອາດເກີດຂຶ້ນຍ້ອນຫຼາຍສາເຫດ ເຊັ່ນ:</p>\n"
"                        <ul>\n"
"                            <li>ລະບົບປ້ອງກັນໃນເວັບໄຊຂອງທ່ານກີດຂວາງການເຂົ້າເຖິງແບບອັດຕະໂ"
"ນມັດ,</li>\n"
"                            <li>ການປັບປຸງລະບົບຊົ່ວຄາວ ຫຼື ເຊີບເວີຂອງພວກເຮົາມີຂໍ້ຈຳກັດໃນການໃ"
"ຫ້ບໍລິການ,</li>\n"
"                            <li>ລະຫັດ ຫຼື ການຕັ້ງຄ່າແບບກຳນົດເອງໃນເວັບໄຊຂອງທ່ານບໍ່ເຂົ້າກັນກັບ"
"ຂະບວນການຂອງພວກເຮົາຢ່າງສົມບູນ.</li>\n"
"                        </ul>\n"
"                        <p>ທ່ານສາມາດລອງໃໝ່ອີກຄັ້ງໃນພາຍຫຼັງ ຫຼື ຕິດຕໍ່ຫາພວກເຮົາຫາກບັນຫາຍັງຄົງ"
"ຢູ່ — ພວກເຮົາພ້ອມທີ່ຈະຊ່ວຍເຫຼືອ!</p>\n"
"                    </t>\n"
"\n"
"            <t t-if=\"ctx.get('website_url')\">\n"
"                <p>ທ່ານສາມາດເຂົ້າເຖິງເວັບໄຊຂອງທ່ານໄດ້ໂດຍການກົດປຸ່ມດ້ານລຸ່ມ:</p>\n"
"                <div style=\"margin: 16px 0px 16px 0px;\">\n"
"                    <a t-att-href=\"ctx.get('website_url')\" "
"style=\"background-color: #875A7B; padding: 8px 16px 8px 16px; text-"
"decoration: none; color: #fff; border-radius: 5px; font-size:13px;\">\n"
"                        ໄປທີ່ເວັບໄຊ\n"
"                    </a>\n"
"                </div>\n"
"            </t>\n"
"            \n"
"            <p>ຂອບໃຈທີ່ເລືອກໃຊ້ Odoo ສຳລັບການເຊື່ອມໂຍງເວັບໄຊຂອງທ່ານ!</p>\n"
"            <p>ດ້ວຍຄວາມນັບຖື,</p>\n"
"            <br/>\n"
"            <p>Odoo - ເຄື່ອງມືສ້າງເວັບໄຊ Open Source ທີ່ດີທີ່ສຸດ.</p>\n"
"            </div>\n"
"            "

