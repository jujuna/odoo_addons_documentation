msgid "Display Name"
msgstr "ຊື່ສະແດງ"

#. module: ai_documents_account
#: model:ir.model,name:ai_documents_account.model_documents_document
msgid "Document"
msgstr "ເອກະສານ"

#. module: ai_documents_account
#: model:ir.model.fields,field_description:ai_documents_account.field_ai_documents_sort__id
#: model:ir.model.fields,field_description:ai_documents_account.field_documents_document__id
#: model:ir.model.fields,field_description:ai_documents_account.field_ir_actions_server__id
msgid "ID"
msgstr "ລະຫັດ"

#. module: ai_documents_account
#. odoo-python
#: code:addons/ai_documents_account/wizard/ai_documents_sort.py:0
msgid "If it is a customer invoice, trigger the action to create one."
msgstr "ຖ້າມັນແມ່ນໃບແຈ້ງໜີ້ລູກຄ້າ, ໃຫ້ເອີ້ນໃຊ້ການດຳເນີນການເພື່ອສ້າງໃບໃໝ່."

#. module: ai_documents_account
#. odoo-python
#: code:addons/ai_documents_account/wizard/ai_documents_sort.py:0
msgid ""
"If the customer is %s it means it is a vendor bill, trigger the Create "
"Vendor Bill action."
msgstr ""
"ຖ້າລູກຄ້າແມ່ນ %s ໝາຍຄວາມວ່າມັນແມ່ນໃບບິນຜູ້ສະໜອງ, ໃຫ້ເອີ້ນໃຊ້ການດຳເນີນການ ສ້າງໃບບິນຜູ້ສະໜອງ."

#. module: ai_documents_account
#. odoo-python
#: code:addons/ai_documents_account/wizard/ai_documents_sort.py:0
msgid ""
"If the document is an invoice, trigger the Vendor Bill action after moving "
"it."
msgstr ""
"ຖ້າເອກະສານແມ່ນໃບແຈ້ງໜີ້, ໃຫ້ເອີ້ນໃຊ້ການດຳເນີນການ ໃບບິນຜູ້ສະໜອງ ຫຼັງຈາກຍ້າຍມັນແລ້ວ."

#. module: ai_documents_account
#. odoo-python
#: code:addons/ai_documents_account/wizard/ai_documents_sort.py:0
msgid "If the document is not an invoice, move it to the correct folder:"
msgstr "ຖ້າເອກະສານບໍ່ແມ່ນໃບແຈ້ງໜີ້, ໃຫ້ຍ້າຍມັນໄປໃສ່ໂຟນເດີທີ່ຖືກຕ້ອງ:"

#. module: ai_documents_account
#. odoo-python
#: code:addons/ai_documents_account/wizard/ai_documents_sort.py:0
msgid "Insurance contracts go to the %(insurance)s folder."
msgstr "ສັນຍາປະກັນໄພ ຍ້າຍໄປທີ່ໂຟນເດີ %(insurance)s."

#. module: ai_documents_account
#: model:ir.model,name:ai_documents_account.model_ir_actions_server
msgid "Server Action"
msgstr "ການດຳເນີນການຂອງເຊີເວີ"

#. module: ai_documents_account
#: model:documents.tag,name:ai_documents_account.documents_tag_to_split
msgid "To Split"
msgstr "ລໍຖ້າແຍກ"
