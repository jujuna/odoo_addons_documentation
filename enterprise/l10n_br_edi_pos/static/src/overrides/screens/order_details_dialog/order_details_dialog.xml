<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_br_edi_pos.OrderDetailsDialog" t-inherit="point_of_sale.OrderDetailsDialog" t-inherit-mode="extension">
        <xpath expr="//t[@t-foreach='this.getOrderFields()']/.." position="inside">
            <div class="col-sm-6 d-flex align-items-center" t-if="this.CanSendNFCe(order)">
                <button t-on-click="() => this.SendNFCe()" class="btn btn-secondary btn-sm d-flex align-items-center">
                    <i class="oi me-1" data-icon="refresh" aria-hidden="true"/>
                    <span>Send NFC-e</span>
                </button>
            </div>
        </xpath>
        <xpath expr="//t[@t-foreach='this.getCustomerFields()']/.." position="inside">
            <div class="col-sm-6 d-flex field-details flex-column" t-if="this.pos.config.l10n_br_is_nfce and order.l10n_br_avatax_error">
                <div class="text-muted small">Brazil Avatax Error</div>
                <div class="fw-medium text-warning" t-out="order.l10n_br_avatax_error"/>
            </div>
        </xpath>
    </t>
</templates>
