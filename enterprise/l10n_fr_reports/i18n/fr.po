msgid ""
"<span invisible=\"vat_amount\">\n"
"                            There is no amount in your Tax report, Odoo will "
"send an empty declaration (check box \"declaration of nil\" checked)\n"
"                        </span>\n"
"                        <span invisible=\"not "
"has_wrongly_configured_account\">\n"
"                            Your account is wrongly configured. For the VAT "
"declaration we need an account number and\n"
"                            the BIC code.\n"
"                        </span>\n"
"                        <span invisible=\"is_vat_due or computed_vat_amount "
"&gt;= vat_amount\">\n"
"                            The VAT amount does not match the amount you "
"want to receive.<br/>\n"
"                            If you proceed without matching the VAT amount,\n"
"                            the difference will be carried over to the next "
"period.\n"
"                        </span>\n"
"                        <span invisible=\"not is_vat_due or "
"computed_vat_amount &gt;= vat_amount\">\n"
"                            The VAT amount does not match to the amount you "
"have to pay to the administration.\n"
"                        </span>"
msgstr ""
"<span invisible=\"vat_amount\">\n"
"                            Aucun montant ne figure dans votre déclaration "
"de TVA. Odoo enverra une déclaration néant (case \"Déclaration néant\" "
"cochée)\n"
"                        </span>\n"
"                        <span invisible=\"not "
"has_wrongly_configured_account\">\n"
"                            Votre compte est mal configuré. Pour la "
"déclaration de TVA, un numéro de compte et\n"
"                            un code BIC sont nécessaires.\n"
"                        </span>\n"
"                        <span invisible=\"is_vat_due or computed_vat_amount "
"&gt;= vat_amount\">\n"
"                            Le montant de TVA ne correspond pas au montant "
"que vous souhaitez recevoir.<br/>\n"
"                            Si vous poursuivez sans faire correspondre le "
"montant de TVA,\n"
"                            la différence sera reportée sur la période "
"suivante.\n"
"                        </span>\n"
"                        <span invisible=\"not is_vat_due or "
"computed_vat_amount &gt;= vat_amount\">\n"
"                            Le montant de TVA ne correspond pas au montant "
"que vous devez payer à l'administration.\n"
"                        </span>"

