#. module: planning_field_service
#. odoo-javascript
#: code:addons/planning_field_service/static/src/js/tours/planning_field_service_tour.js:0
msgid ""
"<b>Mark the shift as complete</b><br/><i>Close the shift once the work is "
"finished.</i>"
msgstr ""
"<b>ໝາຍວ່າຜຽນວຽກສຳເລັດແລ້ວ</b><br/><i>ປິດຜຽນວຽກເມື່ອວຽກສຳເລັດຮຽບຮ້ອຍ.</i>"

#. module: planning_field_service
#: model_terms:ir.ui.view,arch_db:planning_field_service.planning_shift_ics_description_inherit
msgid "<b>Phone:</b>"
msgstr "<b>ເບີໂທ:</b>"

#. module: planning_field_service
#. odoo-javascript
#: code:addons/planning_field_service/static/src/js/tours/planning_field_service_tour.js:0
msgid ""
"<b>Publish the shift</b><br/><i>This officially schedules the shift and "
"makes it visible to technicians.</i>"
msgstr ""
"<b>ເຜີຍແຜ່ຜຽນວຽກ</b><br/><i>ນີ້ຈະເປັນການກຳນົດຕາຕະລາງຜຽນວຽກຢ່າງເປັນທາງການ ແລະ ເຮັດໃຫ້ຊ່າງ"
"ເຕັກນິກສາມາດເບິ່ງເຫັນໄດ້.</i>"

#. module: planning_field_service
#. odoo-javascript
#: code:addons/planning_field_service/static/src/js/tours/planning_field_service_tour.js:0
msgid ""
"<b>Select the customer</b><br/><i>Add an address to automatically generate "
"directions.</i>"
msgstr ""
"<b>ເລືອກລູກຄ້າ</b><br/><i>ເພີ່ມທີ່ຢູ່ເພື່ອສ້າງເສັ້ນທາງການເດີນທາງໂດຍອັດຕະໂນມັດ.</i>"

#. module: planning_field_service
#. odoo-javascript
#: code:addons/planning_field_service/static/src/js/tours/planning_field_service_tour.js:0
msgid ""
"<b>Select the shift</b><br/><i>You can view the details of the shift.</i>"
msgstr "<b>ເລືອກຜຽນວຽກ</b><br/><i>ທ່ານສາມາດເບິ່ງລາຍລະອຽດຂອງຜຽນວຽກໄດ້.</i>"

#. module: planning_field_service
#. odoo-javascript
#: code:addons/planning_field_service/static/src/js/tours/planning_field_service_tour.js:0
msgid ""
"<b>Start managing your onsite shifts</b><br/><i>Everything begins here.</i>"
msgstr ""
"<b>ເລີ່ມຈັດການຜຽນວຽກໜ້າວຽກຂອງທ່ານ</b><br/><i>ທຸກຢ່າງເລີ່ມຕົ້ນຢູ່ນີ້.</i>"

#. module: planning_field_service
#. odoo-javascript
#: code:addons/planning_field_service/static/src/js/tours/planning_field_service_tour.js:0
msgid ""
"<b>Start onsite</b><br/><i>Start the shift when you arrive at the customer "
"location.</i>"
msgstr ""
"<b>ເລີ່ມວຽກຢູ່ໜ້າສະໜາມ</b><br/><i>ເລີ່ມຜຽນວຽກເມື່ອທ່ານໄປຮອດສະຖານທີ່ຂອງລູກຄ້າ.</i>"

#. module: planning_field_service
#: model:mail.template,body_html:planning_field_service.mail_template_data_intervention_details
msgid ""
"<div>\n"
"    <t t-set=\"date_begin\" t-value=\"format_datetime(object.start_datetime, "
"dt_format='MMM d', tz=object.partner_id.tz, lang_code=object.partner_id.lang)"
"\"/>\n"
"    <t t-set=\"time_begin\" t-value=\"format_time(object.start_datetime, "
"time_format='short', tz=object.partner_id.tz, "
"lang_code=object.partner_id.lang)\"/>\n"
"    <t t-set=\"date_end\" t-value=\"format_datetime(object.end_datetime, "
"dt_format='MMM d', tz=object.partner_id.tz, lang_code=object.partner_id.lang)"
"\"/>\n"
"    <t t-set=\"time_end\" t-value=\"format_time(object.end_datetime, "
"time_format='short', tz=object.partner_id.tz, "
"lang_code=object.partner_id.lang)\"/>\n"
"\n"
"    Dear <t t-out=\"object.partner_id.name or 'customer'\"/>,<br/><br/>\n"
"    <t t-if=\"date_begin and date_end\">\n"
"        <t t-if=\"object.start_datetime.date() == object.end_datetime.date()"
"\">\n"
"            Your intervention is scheduled for <t t-out=\"date_begin or "
"''\">Nov 17</t> from <t t-out=\"time_begin or ''\">8 AM</t> to <t t-"
"out=\"time_end or ''\">10 AM</t>.\n"
"        </t>\n"
"        <t t-else=\"\">\n"
"            Your intervention is scheduled from <t t-out=\"date_begin or "
"''\">Nov 17</t> at <t t-out=\"time_begin or ''\">8 AM</t> to <t t-"
"out=\"date_end or ''\">Nov 18</t> at <t t-out=\"time_end or ''\">10 AM</t>.\n"
"        </t>\n"
"    </t>\n"
"    <t t-else=\"\">\n"
"        Your intervention is scheduled.\n"
"    </t>\n"
"    <br/><br/>\n"
"    Best regards,\n"
"    <t t-if=\"user.signature\">\n"
"        <br/>\n"
"        <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-"
"out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"    </t>\n"
"</div>\n"
"        "
msgstr ""
"<div>\n"
"    <t t-set=\"date_begin\" t-value=\"format_datetime(object.start_datetime, "
"dt_format='MMM d', tz=object.partner_id.tz, lang_code=object.partner_id.lang)"
"\"/>\n"
"    <t t-set=\"time_begin\" t-value=\"format_time(object.start_datetime, "
"time_format='short', tz=object.partner_id.tz, "
"lang_code=object.partner_id.lang)\"/>\n"
"    <t t-set=\"date_end\" t-value=\"format_datetime(object.end_datetime, "
"dt_format='MMM d', tz=object.partner_id.tz, lang_code=object.partner_id.lang)"
"\"/>\n"
"    <t t-set=\"time_end\" t-value=\"format_time(object.end_datetime, "
"time_format='short', tz=object.partner_id.tz, "
"lang_code=object.partner_id.lang)\"/>\n"
"\n"
"    ຮຽນ <t t-out=\"object.partner_id.name or 'ລູກຄ້າ'\"/>,<br/><br/>\n"
"    <t t-if=\"date_begin and date_end\">\n"
"        <t t-if=\"object.start_datetime.date() == object.end_datetime.date()"
"\">\n"
"            ການປະຕິບັດງານຂອງທ່ານໄດ້ກຳນົດໄວ້ໃນວັນທີ <t t-out=\"date_begin or ''\">Nov "
"17</t> ແຕ່ເວລາ <t t-out=\"time_begin or ''\">8 AM</t> ຫາ <t t-out=\"time_end "
"or ''\">10 AM</t>.\n"
"        </t>\n"
"        <t t-else=\"\">\n"
"            ການປະຕິບັດງານຂອງທ່ານໄດ້ກຳນົດໄວ້ແຕ່ວັນທີ <t t-out=\"date_begin or ''\">Nov "
"17</t> ເວລາ <t t-out=\"time_begin or ''\">8 AM</t> ຫາ <t t-out=\"date_end or "
"''\">Nov 18</t> ເວລາ <t t-out=\"time_end or ''\">10 AM</t>.\n"
"        </t>\n"
"    </t>\n"
"    <t t-else=\"\">\n"
"        ການປະຕິບັດງານຂອງທ່ານໄດ້ຖືກກຳນົດແລ້ວ.\n"
"    </t>\n"
"    <br/><br/>\n"
"    ດ້ວຍຄວາມເຄົາລົບນັບຖື,\n"
"    <t t-if=\"user.signature\">\n"
"        <br/>\n"
"        <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-"
"out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"    </t>\n"
"</div>\n"
"        "

