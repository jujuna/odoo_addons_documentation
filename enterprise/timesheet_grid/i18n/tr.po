#. module: timesheet_grid
#. odoo-javascript
#: code:addons/timesheet_grid/static/src/js/tours/timesheet_grid.js:0
msgid ""
"<b>Add a description</b> <br/> <i>Briefly summarize your activity, e.g., "
"\"Meeting with the customer.\"</i>"
msgstr ""
"<b>Açıklama ekle</b> <br/> <i>Etkinliğinizi kısaca özetleyin, örn. \"Müşteri "
"ile toplantı.\"</i>"

#. module: timesheet_grid
#. odoo-javascript
#: code:addons/timesheet_grid/static/src/js/tours/timesheet_grid.js:0
msgid ""
"<b>Add time in the Grid view</b> <br/> <i>Click a cell to enter hours. Press "
"Tab or Enter to navigate easily.</i>"
msgstr ""
"<b>Tablo görünümüne saat ekleyin</b> <br/> <i> Saatleri girmek için bir "
"hücreye tıklayın. Kolayca gezinmek için Tab veya Enter tuşuna basın.</i>"

#. module: timesheet_grid
#. odoo-javascript
#: code:addons/timesheet_grid/static/src/js/tours/timesheet_grid.js:0
msgid ""
"<b>Create the timesheet</b> <br/> <i>Once saved, the timer automatically "
"restarts for your next activity.</i>"
msgstr ""
"<b>Çalışma Çizelgelerini oluşturun</b> <br/> <i> Kaydedildikten sonra, "
"zamanlayıcı bir sonraki etkinliğiniz için otomatik olarak yeniden başlar.</i>"

#. module: timesheet_grid
#. odoo-javascript
#: code:addons/timesheet_grid/static/src/js/tours/timesheet_grid.js:0
msgid ""
"<b>Select a project</b> <br/> <i>Choose the relevant project, such as a "
"customer or team project.</i>"
msgstr ""
"<b>Bir proje seçin</b> <br/> <i> Müşteri veya ekip projesi gibi ilgili "
"projeyi seçin.</i>"

#. module: timesheet_grid
#. odoo-javascript
#: code:addons/timesheet_grid/static/src/js/tours/timesheet_grid.js:0
msgid ""
"<b>Start managing your timesheets</b> <br/> <i>Everything you track begins "
"here.</i>"
msgstr ""
"<b>Çalışma Çizelgelerinizi yönetmeye başlayın</b> <br/> <i> Takip ettiğiniz "
"her şey burada başlar.</i>"

#. module: timesheet_grid
#. odoo-javascript
#: code:addons/timesheet_grid/static/src/js/tours/timesheet_grid.js:0
msgid ""
"<b>Start your session</b> <br/> <i>A session must be running to log a "
"timesheet.</i>"
msgstr ""
"<b>Oturumunuzu başlatın</b> <br/> <i>Çalışma çizelgesi kaydetmek için bir "
"oturum çalışıyor olmalıdır.</i>"

#. module: timesheet_grid
#: model_terms:digest.tip,tip_description:timesheet_grid.digest_tip_timesheet_grid_0
msgid "<b>Tip: Let the Timesheets Assistant do the hard work</b>"
msgstr ""
"<b>İpucu: Çalışma Çizelgeleri Asistanının zor işi yapmasına izin verin</b>"

#. module: timesheet_grid
#. odoo-javascript
#: code:addons/timesheet_grid/static/src/js/tours/timesheet_grid.js:0
msgid ""
"<b>Use the timer to track your activities</b> <br/> <i>Start the timer, then "
"log a timesheet when your activity ends. It restarts automatically for the "
"next task.</i>"
msgstr ""
"<b>Zamanlayıcıyı kullanarak faaliyetlerinizi takip edin</b> <br/> <i> "
"Zamanlayıcıyı başlatın, ardından faaliyetiniz bittiğinde Çalışma "
"Çizelgelerine kaydedin. Bir sonraki görev için otomatik olarak yeniden "
"başlar.</i>"

