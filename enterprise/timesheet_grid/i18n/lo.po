#. module: timesheet_grid
#. odoo-javascript
#: code:addons/timesheet_grid/static/src/js/tours/timesheet_grid.js:0
msgid ""
"<b>Add a description</b> <br/> <i>Briefly summarize your activity, e.g., "
"\"Metting with the customer.\"</i>"
msgstr ""
"<b>ເພີ່ມຄຳອະທິບາຍ</b> <br/> <i>ສະຫຼຸບກິດຈະກຳຂອງທ່ານໂດຍຫຍໍ້, ເຊັ່ນ: \"ປະຊຸມກັບລູກຄ້າ.\"</i>"

#. module: timesheet_grid
#. odoo-javascript
#: code:addons/timesheet_grid/static/src/js/tours/timesheet_grid.js:0
msgid ""
"<b>Add time in the Grid view</b> <br/> <i>Click a cell to enter hours. Press "
"Tab or Enter to navigate easily.</i>"
msgstr ""
"<b>ເພີ່ມເວລາໃນມຸມມອງຕາຕະລາງ</b> <br/> <i>ຄລິກໃສ່ຕາລາງເພື່ອປ້ອນຊົ່ວໂມງ. ກົດ Tab ຫຼື Enter ເ"
"ພື່ອເລື່ອນໄປມາໄດ້ງ່າຍ.</i>"

#. module: timesheet_grid
#. odoo-javascript
#: code:addons/timesheet_grid/static/src/js/tours/timesheet_grid.js:0
msgid ""
"<b>Create the timesheet</b> <br/> <i>Once saved, the timer automatically "
"restarts for your next activity.</i>"
msgstr ""
"<b>ສ້າງໃບບັນທຶກເວລາ</b> <br/> <i>ເມື່ອບັນທຶກແລ້ວ, ໂມງຈັບເວລາຈະເລີ່ມໃໝ່ໂດຍອັດຕະໂນມັດສຳລັບກິດຈະ"
"ກຳຕໍ່ໄປຂອງທ່ານ.</i>"

#. module: timesheet_grid
#. odoo-javascript
#: code:addons/timesheet_grid/static/src/js/tours/timesheet_grid.js:0
msgid ""
"<b>Select a project</b> <br/> <i>Choose the relevant project, such as a "
"customer or team project.</i>"
msgstr ""
"<b>ເລືອກໂຄງການ</b> <br/> <i>ເລືອກໂຄງການທີ່ກ່ຽວຂ້ອງ, ເຊັ່ນ: ໂຄງການຂອງລູກຄ້າ ຫຼື ຂອງທີມງາ"
"ນ.</i>"

#. module: timesheet_grid
#. odoo-javascript
#: code:addons/timesheet_grid/static/src/js/tours/timesheet_grid.js:0
msgid ""
"<b>Start managing your timesheets</b> <br/> <i>Everything you track begins "
"here.</i>"
msgstr ""
"<b>ເລີ່ມຈັດການໃບບັນທຶກເວລາຂອງທ່ານ</b> <br/> <i>ທຸກຢ່າງທີ່ທ່ານຕິດຕາມເລີ່ມຕົ້ນຢູ່ນີ້.</i>"

#. module: timesheet_grid
#: model_terms:digest.tip,tip_description:timesheet_grid.digest_tip_timesheet_grid_0
msgid "<b>Tip: Let the Timesheets Assistant do the hard work</b>"
msgstr "<b>ເຄັດລັບ: ໃຫ້ຜູ້ຊ່ວຍໃບບັນທຶກເວລາເຮັດວຽກໜັກແທນທ່ານ</b>"

#. module: timesheet_grid
#. odoo-javascript
#: code:addons/timesheet_grid/static/src/js/tours/timesheet_grid.js:0
msgid ""
"<b>Use the timer to track your activities</b> <br/> <i>Start the timer, then "
"log a timesheet when your activity ends. It restarts automatically for the "
"next task.</i>"
msgstr ""
"<b>ໃຊ້ໂມງຈັບເວລາເພື່ອຕິດຕາມກິດຈະກຳຂອງທ່ານ</b> <br/> <i>ເລີ່ມໂມງຈັບເວລາ, ແລ້ວບັນທຶກໃບບັນທຶກເວ"
"ລາເມື່ອກິດຈະກຳຂອງທ່ານສິ້ນສຸດລົງ. ມັນຈະເລີ່ມໃໝ່ໂດຍອັດຕະໂນມັດສຳລັບໜ້າວຽກຕໍ່ໄປ.</i>"

#. module: timesheet_grid
#: model_terms:ir.ui.view,arch_db:timesheet_grid.res_config_settings_view_form
msgid "<span class=\"col-auto ms-2\">min</span>"
msgstr "<span class=\"col-auto ms-2\">ນາທີ</span>"

#. module: timesheet_grid
#: model_terms:web_tour.tour,rainbow_man_message:timesheet_grid.timesheet_tour
msgid ""
"<span><b>You're all set!</b>\n"
"            <br>\n"
"            <i>You're ready to track your time like a pro.</i>\n"
"        </span>"
msgstr ""
"<span><b>ທ່ານພ້ອມແລ້ວ!</b>\n"
"            <br>\n"
"            <i>ທ່ານພ້ອມແລ້ວທີ່ຈະຕິດຕາມເວລາຂອງທ່ານແບບມືອາຊີບ.</i>\n"
"        </span>"

#. module: timesheet_grid
#: model:mail.template,body_html:timesheet_grid.mail_template_timesheet_reminder_user
msgid ""
"<t>\n"
"<t t-set=\"timesheet_hours\" t-value=\"ctx.get('timesheet_hours', 0)\"/>\n"
"<t t-set=\"working_hours\" t-value=\"ctx.get('working_hours', 0)\"/>\n"
"Hello <t t-out=\"object.name or ''\">Abigail Peterson</t>,<br/><br/>\n"
"This is a friendly reminder to log your hours for the following period: <t t-"
"out=\"ctx.get('date_start') or ''\">05/05/2021</t> <i class=\"oi\" data-"
"icon=\"east\"/> <t t-out=\"ctx.get('date_stop') or ''\">05/06/2021</t>.\n"
"For the time being, you <t t-if=\"timesheet_hours != 0\">only</t> logged <t "
"t-out=\"'%d' %int(timesheet_hours)\">2</t><t t-if=\"timesheet_hours % 1 != "
"0\" t-out=\"':%02d' % (round(timesheet_hours % 1 * 60))\">:30</t> hours on "
"the <t t-out=\"'%d' %int(working_hours)\">8</t><t t-if=\"working_hours % 1 !"
"= 0\" t-out=\"':%02d' % (round(working_hours % 1 * 60))\">:30</t> requested."
"<br/>\n"
"<div t-if=\"ctx.get('action_url')\" style=\"margin: 16px 0px 16px 0px;\">\n"
"    <a t-att-href=\"ctx.get('action_url')\" t-attf-style=\"background-color: "
"{{object.company_id.email_secondary_color or '#875A7B'}};; padding: 8px 16px "
"8px 16px; text-decoration: none; color: "
"{{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px; "
"font-size: 13px;\">Fill in your timesheet</a>\n"
"</div>\n"
"<br/>Thank you,<br/>\n"
"<t t-if=\"user.signature\">\n"
"    <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-"
"out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"</t>\n"
"            </t>"
msgstr ""
"<t>\n"
"<t t-set=\"timesheet_hours\" t-value=\"ctx.get('timesheet_hours', 0)\"/>\n"
"<t t-set=\"working_hours\" t-value=\"ctx.get('working_hours', 0)\"/>\n"
"ສະບາຍດີ <t t-out=\"object.name or ''\">Abigail Peterson</t>,<br/><br/>\n"
"ນີ້ແມ່ນຂໍ້ຄວາມແຈ້ງເຕືອນໃຫ້ບັນທຶກຊົ່ວໂມງເຮັດວຽກຂອງທ່ານສຳລັບໄລຍະເວລາຕໍ່ໄປນີ້: <t t-out=\"ctx.get"
"('date_start') or ''\">05/05/2021</t> <i class=\"oi\" data-icon=\"east\"/> "
"<t t-out=\"ctx.get('date_stop') or ''\">05/06/2021</t>.\n"
"ໃນຕອນນີ້, ທ່ານໄດ້ບັນທຶກ<t t-if=\"timesheet_hours != 0\">ພຽງແຕ່</t> <t t-out=\"'%d' "
"%int(timesheet_hours)\">2</t><t t-if=\"timesheet_hours % 1 != 0\" t-"
"out=\"':%02d' % (round(timesheet_hours % 1 * 60))\">:30</t> ຊົ່ວໂມງ ຈາກທັງໝົດ <t "
"t-out=\"'%d' %int(working_hours)\">8</t><t t-if=\"working_hours % 1 != 0\" t-"
"out=\"':%02d' % (round(working_hours % 1 * 60))\">:30</t> ຊົ່ວໂມງທີ່ກຳນົດ.<br/>\n"
"<div t-if=\"ctx.get('action_url')\" style=\"margin: 16px 0px 16px 0px;\">\n"
"    <a t-att-href=\"ctx.get('action_url')\" t-attf-style=\"background-color: "
"{{object.company_id.email_secondary_color or '#875A7B'}};; padding: 8px 16px "
"8px 16px; text-decoration: none; color: {"
"{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px; "
"font-size: 13px;\">ຕື່ມໃສ່ໃບບັນທຶກເວລາຂອງທ່ານ</a>\n"
"</div>\n"
"<br/>ຂໍຂອບໃຈ,<br/>\n"
"<t t-if=\"user.signature\">\n"
"    <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-"
"out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"</t>\n"
"            </t>"

#. module: timesheet_grid
#: model:mail.template,body_html:timesheet_grid.mail_template_timesheet_reminder
msgid ""
"<t>\n"
"Hello <t t-out=\"object.name or ''\">Abigail Peterson</t>,<br/><br/>\n"
"This is a friendly reminder to approve your team's timesheets for the "
"following period: <t t-out=\"ctx.get('date_start') or ''\">05/05/2021</t> - "
"<t t-out=\"ctx.get('date_stop') or ''\">06/05/2021</t>.<br/>\n"
"<div t-if=\"ctx.get('action_url')\" style=\"margin: 16px 0px 16px 0px;\">\n"
"    <a t-att-href=\"ctx.get('action_url')\" t-attf-style=\"background-color: "
"{{object.company_id.email_secondary_color or '#875A7B'}}; padding: 8px 16px "
"8px 16px; text-decoration: none; color: "
"{{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px; "
"font-size: 13px;\">Validate the Timesheets</a>\n"
"</div>\n"
"<br/>Thank you,<br/>\n"
"<t t-if=\"user.signature\">\n"
"    <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-"
"out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"</t>\n"
"            </t>"
msgstr ""
"<t>\n"
"ສະບາຍດີ <t t-out=\"object.name or ''\">Abigail Peterson</t>,<br/><br/>\n"
"ນີ້ແມ່ນຂໍ້ຄວາມແຈ້ງເຕືອນໃຫ້ອະນຸມັດໃບບັນທຶກເວລາຂອງທີມງານຂອງທ່ານສຳລັບໄລຍະເວລາຕໍ່ໄປນີ້: <t t-"
"out=\"ctx.get('date_start') or ''\">05/05/2021</t> - <t t-out=\"ctx.get"
"('date_stop') or ''\">06/05/2021</t>.<br/>\n"
"<div t-if=\"ctx.get('action_url')\" style=\"margin: 16px 0px 16px 0px;\">\n"
"    <a t-att-href=\"ctx.get('action_url')\" t-attf-style=\"background-color: "
"{{object.company_id.email_secondary_color or '#875A7B'}}; padding: 8px 16px "
"8px 16px; text-decoration: none; color: {"
"{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px; "
"font-size: 13px;\">ຢັ້ງຢືນໃບບັນທຶກເວລາ</a>\n"
"</div>\n"
"<br/>ຂໍຂອບໃຈ,<br/>\n"
"<t t-if=\"user.signature\">\n"
"    <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-"
"out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"</t>\n"
"            </t>"

