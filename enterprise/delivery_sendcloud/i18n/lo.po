msgstr "ຕ້ອງການເບີໂທ %(partner_name)s"

#. module: delivery_sendcloud
#: model_terms:ir.ui.view,arch_db:delivery_sendcloud.view_shipping_method_sendcloud
msgid ""
"<i class=\"oi\" data-icon=\"info\"/> Available shipping products depend on "
"enabled carriers in your Sendcloud account."
msgstr ""
"<i class=\"oi\" data-icon=\"info\"/> ປະເພດການຈັດສົ່ງທີ່ມີ ຈະຂຶ້ນກັບຜູ້ໃຫ້ບໍລິການຂົນສົ່ງທີ່ເປີດໃຊ້ງ"
"ານໃນບັນຊີ Sendcloud ຂອງທ່ານ."

#. module: delivery_sendcloud
#: model_terms:ir.ui.view,arch_db:delivery_sendcloud.view_delivery_carrier_form
msgid ""
"<i class=\"oi\" data-icon=\"warning\"/> Do not forget to load your SendCloud "
"shipping products for a valid configuration."
msgstr ""
"<i class=\"oi\" data-icon=\"warning\"/> ຢ່າລືມໂຫຼດປະເພດການຈັດສົ່ງ SendCloud ຂອງທ່ານ "
"ເພື່ອໃຫ້ການກຳນົດຄ່າມີຜົນບັງຄັບໃຊ້."

#. module: delivery_sendcloud
#: model_terms:ir.ui.view,arch_db:delivery_sendcloud.view_delivery_carrier_form
msgid ""
"<i class=\"oi\" data-icon=\"warning\"/> In test environment, to avoid "
"charges, your shippings are automatically <b>cancelled</b> after the label "
"creation."
msgstr ""
"<i class=\"oi\" data-icon=\"warning\"/> ໃນສະພາບແວດລ້ອມທົດສອບ ເພື່ອຫຼີກລ່ຽງຄ່າບໍລິການ ກາ"
"ນຈັດສົ່ງຂອງທ່ານຈະຖືກ <b>ຍົກເລີກ</b> ໂດຍອັດຕະໂນມັດ ຫຼັງຈາກສ້າງສະຫຼາກແລ້ວ."

#. module: delivery_sendcloud
#: model_terms:ir.ui.view,arch_db:delivery_sendcloud.view_delivery_carrier_form
msgid ""
"<i class=\"oi\" data-icon=\"warning\"/> Only administrators can configure "
"the public and private keys."
msgstr ""
"<i class=\"oi\" data-icon=\"warning\"/> ສະເພາະຜູ້ດູແລລະບົບເທົ່ານັ້ນ ທີ່ສາມາດກຳນົດຄ່າ ຄີສາທ"
"າລະນະ (Public key) ແລະ ຄີສ່ວນຕົວ (Private key) ໄດ້."

