#. module: account_reports
#. odoo-python
#: code:addons/account_reports/models/bank_reconciliation_report.py:0
msgid ""
"'%(account_name)s' account balance is affected by journal items which don't "
"originate from a bank statement or payment."
msgstr ""
"ຍອດເຫຼືອບັນຊີ '%(account_name)s' "
"ໄດ້ຮັບຜົນກະທົບຈາກລາຍການບັນຊີປະຈຳວັນທີ່ບໍ່ໄດ້ມາຈາກໃບແຈ້ງຍອດທະນາຄານ ຫຼື ການຊຳລະເງິນ."

#. module: account_reports
#. odoo-python
#: code:addons/account_reports/models/account_report.py:0
msgid ""
"'%s' date scope cannot be evaluated for a report used by multiple return "
"types using different periodicities."
msgstr ""
"ຂອບເຂດວັນທີ '%s' ບໍ່ສາມາດປະເມີນໄດ້ສຳລັບລາຍງານທີ່ໃຊ້ໂດຍປະເພດການຍື່ນຫຼາຍແບບທີ່ມີຮອບວຽນແຕກຕ່າງກັນ."

#. module: account_reports
#. odoo-python
#: code:addons/account_reports/models/account_report.py:0
msgid ""
"'Open General Ledger' caret option is only available form report lines "
"targetting accounts or Result Brought Forward."
msgstr ""
"ຕົວເລືອກ 'ເປີດບັນຊີແຍກປະເພດທົ່ວໄປ' ແມ່ນໃຊ້ໄດ້ສະເພາະແຖວລາຍງານທີ່ກຳນົດເປົ້າໝາຍໃສ່ບັນຊີ ຫຼື "
"ຍອດຍົກມາເທົ່ານັ້ນ."

#. module: account_reports
#. odoo-python
#: code:addons/account_reports/models/account_report.py:0
msgid ""
"'View Bank Statement' caret option is only available for report lines "
"targeting bank statements."
msgstr ""
"ຕົວເລືອກ 'ເບິ່ງໃບແຈ້ງຍອດທະນາຄານ' "
"ແມ່ນໃຊ້ໄດ້ສະເພາະແຖວລາຍງານທີ່ກຳນົດເປົ້າໝາຍໃສ່ໃບແຈ້ງຍອດທະນາຄານເທົ່ານັ້ນ."

#. module: account_reports
#. odoo-python
#: code:addons/account_reports/models/account_return.py:0
msgid ""
"'active' field of account.return.type shouldn't be directly written to in "
"data files. Use active_fallback. (Detected while loading %(file_path)s)"
msgstr ""
"ຫ້ອງຂໍ້ມູນ 'active' ຂອງ account.return.type ບໍ່ຄວນຖືກຂຽນທັບໂດຍກົງໃນໄຟລ໌ຂໍ້ມູນ. ໃຫ້ໃຊ້ "
"active_fallback ແທນ. (ກວດພົບໃນຂະນະກຳລັງໂຫຼດ %(file_path)s)"

#. module: account_reports
#. odoo-python
#: code:addons/account_reports/models/account_report.py:0
msgid ""
"'date_from' must be set when generating the report date options in range "
"mode."
msgstr "ຕ້ອງກຳນົດ 'date_from' (ຕັ້ງແຕ່ວັນທີ) ເມື່ອສ້າງຕົວເລືອກວັນທີລາຍງານໃນໂໝດຊ່ວງໄລຍະເວລາ."

#. module: account_reports
#. odoo-python
#: code:addons/account_reports/models/account_report.py:0
msgid "'date_to' must be set when generating the report date options."
msgstr "ຕ້ອງກຳນົດ 'date_to' (ຮອດວັນທີ) ເມື່ອສ້າງຕົວເລືອກວັນທີລາຍງານ."

#. module: account_reports
#. odoo-python
#: code:addons/account_reports/models/account_report.py:0
msgid "'external' engine does not support groupby."
msgstr "ລະບົບ 'external' ບໍ່ຮອງຮັບການຈັດກຸ່ມ (groupby)."

#. module: account_reports
