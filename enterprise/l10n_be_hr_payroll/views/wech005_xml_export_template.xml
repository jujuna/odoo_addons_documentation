<?xml version="1.0" encoding="utf-8"?>
<!-- https://www.socialsecurity.be/site_fr/employer/general/techlib.htm#glossaryOnem -->
<odoo>
    <template id="wech005_xml_export">
        <WECH005 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" t-att="{'xsi:noNamespaceSchemaLocation': schema_location}">
            <t t-call="l10n_be_hr_payroll.drs_xml_form">
                <t t-call="l10n_be_hr_payroll.drs_xml_occupation">
                    <MonthlyDclTempUnemploymentHours>
                        <MajorForceReason t-if="major_force_reason" t-out="major_force_reason"/>
                        <t t-call="l10n_be_hr_payroll.drs_xml_calculation_base_allowance"/>
                        <ReferencePeriod>
                            <RefStartingDate t-out="date_from"/>
                            <RefEndingDate t-out="date_to"/>
                            <t t-call="l10n_be_hr_payroll.drs_xml_nature_of_days"/>
                        </ReferencePeriod>
                        <CommentDeclaration t-if="declaration_comment">
                            <CommentOfDeclaration t-out="declaration_comment"/>
                        </CommentDeclaration>
                    </MonthlyDclTempUnemploymentHours>
                </t>
            </t>
        </WECH005>
    </template>
</odoo>
