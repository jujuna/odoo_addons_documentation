<?xml version="1.0"?>
<odoo>

<!-- The translated copy of a Belgian payslip tells which document holds legal value -->
<template id="report_payslip_translation_message" inherit_id="hr_payroll.report_payslip">
    <xpath expr="//div[@t-if='is_invalid']/div" position="attributes">
        <attribute name="t-out">is_invalid if o.env.context.get('translated_from') else None</attribute>
    </xpath>
</template>

<template id="report_termination_holiday_n1" inherit_id="hr_payroll.report_payslip" primary="True">
    <xpath expr="//h2[@id='payslip_name']/span" position="replace">
        <span>
            Holiday Pay (<t t-out="(o.date_to-relativedelta(years=1)).strftime('%Y')"/>)
        </span>
    </xpath>
    <div id="departure_date" position="after">
        <div id="apprenticeship_contract_number" t-if="o.version_id.l10n_be_apprenticeship_contract_number">
            <strong class="me-2">Apprenticeship Contract Number:</strong>
            <span t-field="o.version_id.l10n_be_apprenticeship_contract_number"/>
        </div>
    </div>
    <div id="worked_days_table" position="replace"/>
</template>

<template id="report_termination_holiday_n1_lang">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="l10n_be_hr_payroll.report_termination_holiday_n1"/>
        </t>
    </t>
</template>

<template id="report_termination_holiday_n" inherit_id="hr_payroll.report_payslip" primary="True">
    <xpath expr="//h2[@id='payslip_name']/span" position="replace">
        <span>
            Holiday Pay (<t t-out="o.date_to.strftime('%Y')"/>)
        </span>
    </xpath>
    <div id="departure_date" position="after">
        <div id="apprenticeship_contract_number" t-if="o.version_id.l10n_be_apprenticeship_contract_number">
            <strong class="me-2">Apprenticeship Contract Number:</strong>
            <span t-field="o.version_id.l10n_be_apprenticeship_contract_number"/>
        </div>
    </div>
    <div id="worked_days_table" position="replace"/>
</template>

<template id="report_termination_holiday_n_lang">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="l10n_be_hr_payroll.report_termination_holiday_n"/>
        </t>
    </t>
</template>

<template id="report_bonus_month" inherit_id="hr_payroll.report_payslip" primary="True">
    <div id="worked_days_table" position="replace"/>
    <div id="departure_date" position="after">
        <div id="apprenticeship_contract_number" t-if="o.version_id.l10n_be_apprenticeship_contract_number">
            <strong class="me-2">Apprenticeship Contract Number:</strong>
            <span t-field="o.version_id.l10n_be_apprenticeship_contract_number"/>
        </div>
    </div>
</template>

<template id="report_bonus_lang">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="l10n_be_hr_payroll.report_bonus_month"/>
        </t>
    </t>
</template>

<template id="report_belgium_payslip" inherit_id="hr_payroll.report_payslip" primary="True">
    <xpath expr="//div[@id='employee_person_in_charge']" position="replace">
        <t t-set="person_in_charge" t-value="o.employee_id.other_dependents"/>
        <div id="employee_person_in_charge" t-if="person_in_charge">
            <strong class="me-2">Person in Charge:</strong>
            <span t-out="person_in_charge"/>
        </div>
    </xpath>
    <xpath expr="//td[@id='employee_infos']" position="inside">
        <div id="employee_pay_category" t-if="o.version_id.l10n_be_egov3_code != '999'">
            <strong class="me-2"> Pay Category:</strong>
            <span t-field="o.version_id.structure_type_id"/>
        </div>
        <div id="employee_joint_committee1" t-if="o.version_id.l10n_be_egov3_code != '999'">
            <strong class="me-2">Joint Committee:</strong>
            <span t-field="o.version_id.l10n_be_joint_committee_id"/>
        </div>
    </xpath>

    <xpath expr="//div[@id='working_schedule']" position="attributes">
        <attribute name="t-if">o.version_id.l10n_be_egov3_code != '999'</attribute>
    </xpath>
    <div id="working_schedule" position="after">
        <div id="employee_salary_scale" t-if="o.version_id.l10n_be_salary_scale_id or o.version_id.display_l10n_be_scale">
            <strong class="me-2">Salary Scale:</strong>
            <span t-if="o.version_id.l10n_be_salary_scale_id" t-out="o.version_id.l10n_be_salary_scale_id.name"/>
            <span t-else="">Unknown</span>
        </div>
    </div>
    <div id="wage" position="after">
        <t t-set="ecovouchers" t-value="o._get_eco_vouchers_amount()"/>
        <div id="employee_eco_vouchers" t-if="ecovouchers">
            <strong class="me-2">Eco-Vouchers:</strong>
            <span t-out="round(ecovouchers, 2)"/>€<span class="me-2"/>
            (= <span t-out="int(ecovouchers // 10)"/>*10€ + 1*<span t-out="round(ecovouchers % 10, 2)"/>€)
        </div>
        <t t-set="mobility_budget" t-value="o.version_id.l10n_be_mobility_budget_amount_monthly"/>
        <div id="employee_mobility_budget" t-if="mobility_budget">
            <strong class="me-2">Mobility Budget (Monthly):</strong>
            <span t-out="mobility_budget"/> €
        </div>
    </div>
    <td id="employee_infos" position="inside">
        <div id="employee_company_car">
            <strong class="me-2" t-if="o.version_id.sudo().car_id and not o._is_outside_contract_dates()">Company Car:</strong>
            <t t-if="o.version_id.car_id and not o._is_outside_contract_dates()">
               <span t-field="o.version_id.sudo().car_id.model_id" class="me-2"/>
               [<span t-field="o.version_id.sudo().car_id.license_plate"/>]
            </t>
        </div>
    </td>
    <td id="other_infos" position="inside">
        <t t-if="o.version_id.is_worker()">
            <div id="company_holiday_pay_fund_name">
                <strong class="me-2">Holiday pay fund: </strong>
                <span t-field="o.payroll_config_id.l10n_be_holiday_pay_fund_name"/>
            </div>
            <div id="company_holiday_pay_fund_number">
                <strong class="me-2">Holiday pay fund number: </strong>
                <span t-field="o.payroll_config_id.l10n_be_holiday_pay_fund_number"/>
            </div>
        </t>
    </td>
    <xpath expr="//div[@id='worked_days_table']/table" position="before">
        <h2 id="l10n_be_salary_heading" class="h4 mt-4">Salary</h2>
    </xpath>
    <div id="to_pay" position="after">
        <t t-set="supplementary_hours" t-value="o._l10n_be_get_report_supplementary_hours()"/>
        <t t-set="show_supplementary_hours" t-value="any(round(hours, 2) for hours in supplementary_hours.values())"/>
        <t t-set="counters" t-value="o._l10n_be_get_report_time_off_counters()"/>
        <t t-set="time_off_counters" t-value="counters['time_off']"/>
        <t t-set="compensatory_overtime" t-value="counters['overtime']"/>
        <div t-if="show_supplementary_hours or time_off_counters or compensatory_overtime" id="l10n_be_counters">
            <h2 id="l10n_be_counters_heading" class="h4 mt-4">Overtime &amp; Counters</h2>
            <div t-if="show_supplementary_hours" id="l10n_be_supplementary_hours_table" style="page-break-inside: avoid;">
                <table class="table table-sm table-borderless">
                    <thead class="o_black_border">
                        <tr>
                            <th id="supplementary_hours_header_name">Supplementary Hours With and Without Reduction</th>
                            <th id="supplementary_hours_header_balance" class="text-end">Balance</th>
                        </tr>
                    </thead>
                    <tbody id="supplementary_hours_lines">
                        <tr>
                            <td id="supplementary_hours_month_with"><span>This month with reduced tax burden</span></td>
                            <td id="supplementary_hours_month_with_balance" class="text-end">
                                <span t-out="round(supplementary_hours['month_with'], 2)" t-options="{'widget': 'float_time'}"/>
                            </td>
                        </tr>
                        <tr>
                            <td id="supplementary_hours_year_with" class="ps-4"><span>Yearly total with reduced tax burden</span></td>
                            <td id="supplementary_hours_year_with_balance" class="text-end">
                                <span t-out="round(supplementary_hours['year_with'], 2)" t-options="{'widget': 'float_time'}"/>
                            </td>
                        </tr>
                        <tr>
                            <td id="supplementary_hours_month_without"><span>This month without reduced tax burden</span></td>
                            <td id="supplementary_hours_month_without_balance" class="text-end">
                                <span t-out="round(supplementary_hours['month_without'], 2)" t-options="{'widget': 'float_time'}"/>
                            </td>
                        </tr>
                        <tr>
                            <td id="supplementary_hours_year_without" class="ps-4"><span>Yearly total without reduced tax burden</span></td>
                            <td id="supplementary_hours_year_without_balance" class="text-end">
                                <span t-out="round(supplementary_hours['year_without'], 2)" t-options="{'widget': 'float_time'}"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div t-if="time_off_counters or compensatory_overtime" id="l10n_be_time_off_counters_table" style="page-break-inside: avoid;">
                <table class="table table-sm table-borderless">
                    <thead class="o_black_border">
                        <tr>
                            <th id="time_off_counters_header_name">Time Off Counters</th>
                            <th id="time_off_counters_header_initial" class="text-end">Initial Allocation</th>
                            <th id="time_off_counters_header_previous" class="text-end">Before</th>
                            <th id="time_off_counters_header_earned" class="text-end">Earned</th>
                            <th id="time_off_counters_header_taken" class="text-end">Taken</th>
                            <th id="time_off_counters_header_final" class="text-end">New Balance</th>
                        </tr>
                    </thead>
                    <tbody t-if="time_off_counters" id="time_off_counters_lines">
                        <tr><td id="time_off_counters_subsection" colspan="6" class="fw-bold">Time Off</td></tr>
                        <tr t-foreach="time_off_counters" t-as="counter">
                            <td id="time_off_counter_name">
                                <span t-out="counter['name']"/>
                                <span t-if="counter['unit'] == 'hour'">(hours)</span>
                                <span t-else="">(days)</span>
                            </td>
                            <t t-foreach="['initial', 'previous', 'earned', 'taken', 'final']" t-as="key">
                                <td t-attf-id="time_off_counter_{{key}}" class="text-end">
                                    <span t-out="round(counter[key], 2)"
                                        t-options="{'widget': 'float_time' if counter['unit'] == 'hour' else 'float', 'precision': 2}"/>
                                </td>
                            </t>
                        </tr>
                    </tbody>
                    <tbody t-if="compensatory_overtime" id="compensatory_overtime_lines">
                        <tr><td id="compensatory_overtime_subsection" colspan="6" class="fw-bold">Overtime</td></tr>
                        <tr t-foreach="compensatory_overtime" t-as="counter">
                            <td id="compensatory_overtime_name">
                                <span t-out="counter['name']"/>
                                <span>(hours)</span>
                            </td>
                            <td id="compensatory_overtime_initial"/>
                            <t t-foreach="['previous', 'earned', 'taken', 'final']" t-as="key">
                                <td t-attf-id="compensatory_overtime_{{key}}" class="text-end">
                                    <span t-out="round(counter[key], 2)" t-options="{'widget': 'float_time'}"/>
                                </td>
                            </t>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <t t-set="payroll_config" t-value="o.payroll_config_id"/>
        <t t-set="has_third_party_info" t-value="any([
            o.version_id.is_employee() and (payroll_config.employee_accident_insurance_name or payroll_config.employee_accident_insurance_number),
            o.version_id.is_worker() and (payroll_config.worker_accident_insurance_name or payroll_config.worker_accident_insurance_number),
            payroll_config.group_insurance_name,
            payroll_config.group_insurance_number,
            payroll_config.l10n_be_SEPPT_name,
            payroll_config.l10n_be_SEPPT_number,
        ])"/>
        <div id="third_party" t-if="has_third_party_info" style="page-break-before:always;">
            <h2 id="l10n_be_extra_information_heading" class="h4 mt-4">Extra Information</h2>
            <table class="table table-sm table-borderless">
                <thead class="o_black_border">
                    <tr>
                        <th>Third Party Information</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td id="third_party_infos">
                            <div id="company_employee_accident_insurance_name" t-if="o.version_id.is_employee() and o.payroll_config_id.employee_accident_insurance_name">
                                <strong class="me-2">Accident insurance organization: </strong>
                                <span t-field="o.payroll_config_id.employee_accident_insurance_name"/>
                            </div>
                            <div id="company_employee_accident_insurance_number" t-if="o.version_id.is_employee() and o.payroll_config_id.employee_accident_insurance_number">
                                <strong class="me-2">Work accident policy number: </strong>
                                <span t-field="o.payroll_config_id.employee_accident_insurance_number"/>
                            </div>
                            <div id="company_worker_accident_insurance_name" t-if="o.version_id.is_worker() and o.payroll_config_id.worker_accident_insurance_name">
                                <strong class="me-2">Accident insurance organization: </strong>
                                <span t-field="o.payroll_config_id.worker_accident_insurance_name"/>
                            </div>
                            <div id="company_worker_accident_insurance_number" t-if="o.version_id.is_worker() and o.payroll_config_id.worker_accident_insurance_number">
                                <strong class="me-2">Work accident policy number: </strong>
                                <span t-field="o.payroll_config_id.worker_accident_insurance_number"/>
                            </div>
                            <div id="company_group_insurance_name" t-if="o.payroll_config_id.group_insurance_name">
                                <strong class="me-2">Group insurance name: </strong>
                                <span t-field="o.payroll_config_id.group_insurance_name"/>
                            </div>
                            <div id="company_group_insurance_number" t-if="o.payroll_config_id.group_insurance_number">
                                <strong class="me-2">Group insurance number: </strong>
                                <span t-field="o.payroll_config_id.group_insurance_number"/>
                            </div>
                            <div id="company_l10n_be_SEPPT_name" t-if="o.payroll_config_id.l10n_be_SEPPT_name">
                                <strong class="me-2">External service for prevention and protection at work name: </strong>
                                <span t-field="o.payroll_config_id.l10n_be_SEPPT_name"/>
                            </div>
                            <div id="company_l10n_be_SEPPT_number" t-if="o.payroll_config_id.l10n_be_SEPPT_number">
                                <strong class="me-2">External service for prevention and protection at work number: </strong>
                                <span t-field="o.payroll_config_id.l10n_be_SEPPT_number"/>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div id="departure_date" position="after">
        <div id="apprenticeship_contract_number" t-if="o.version_id.l10n_be_apprenticeship_contract_number">
            <strong class="me-2">Apprenticeship Contract Number:</strong>
            <span t-field="o.version_id.l10n_be_apprenticeship_contract_number"/>
        </div>
    </div>
</template>

<template id="report_belgium_payslip_lang">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="l10n_be_hr_payroll.report_belgium_payslip"/>
        </t>
    </t>
</template>

<template id="report_belgium_light_payslip" inherit_id="hr_payroll.report_light_payslip" primary="True">
    <tr id="pay_period" position="after">
        <t t-set="ecovouchers" t-value="o._get_eco_vouchers_amount()"/>
        <tr t-if="ecovouchers">
            <td>Eco-Vouchers:</td>
            <td class="text-end fw-bold">
                <span t-out="round(ecovouchers, 2)"/>€<span class="me-2"/>
                (= <span t-out="int(ecovouchers // 10)"/>*10€ + 1*<span t-out="round(ecovouchers % 10, 2)"/>€)
            </td>
        </tr>
    </tr>
</template>

<template id="report_belgium_light_payslip_lang">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="l10n_be_hr_payroll.report_belgium_light_payslip"/>
        </t>
    </t>
</template>
</odoo>
