<?xml version="1.0" encoding="utf-8"?>
<!-- https://www.socialsecurity.be/site_fr/employer/general/techlib.htm#glossaryOnem -->
<odoo>
    <template id="wech009_xml_export">
        <WECH009 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" t-att="{'xsi:noNamespaceSchemaLocation': schema_location}">
            <t t-call="l10n_be_hr_payroll.drs_xml_form">
                <t t-call="l10n_be_hr_payroll.drs_xml_occupation">
                    <AnnualDclYoungHolidays>
                        <MonthOfYoungAnnualHolidays t-out="holiday_start_month"/>
                        <t t-call="l10n_be_hr_payroll.drs_xml_calculation_base_allowance"/>
                        <HolidaysSector>
                            <HolidaySectorIndicator t-out="sector"/>
                            <HoursHolidayDetail>
                                <HolidayCode>7</HolidayCode>
                                <HolidayHoursNumber t-out="holiday_hours"/>
                            </HoursHolidayDetail>
                        </HolidaysSector>
                        <CommentDeclaration t-if="declaration_comment">
                            <CommentOfDeclaration t-out="declaration_comment"/>
                        </CommentDeclaration>
                    </AnnualDclYoungHolidays>
                </t>
            </t>
        </WECH009>
    </template>
</odoo>
