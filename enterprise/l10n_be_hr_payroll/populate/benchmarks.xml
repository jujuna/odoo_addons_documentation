<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="benchmark_be_payrun_compute" model="populate.blueprint">
        <field name="name">Benchmark: Belgian Payroll Payrun Compute</field>
        <field name="definition_xml" type="xml">
            <create model="res.company" count="1" id="bench_be_payroll_company" scale="False" parallel="False">
                <field name="name" eval="'Benchmark Belgian Payroll Company'"/>
                <field name="country_id" eval="env.ref('base.be').id"/>
            </create>

            <write model="payroll.config.settings" ref="bench_be_payroll_company.payroll_config_ids" batched="True">
                <field name="l10n_be_employer_category_id" eval="env.ref('l10n_be_hr_payroll.l10n_be_employer_category_00010').id"/>
            </write>

            <write model="l10n.be.joint.committee" domain="[('active', 'in', [True, False]), ('egov3_code', '=', '200')]" batched="True">
                <field name="active" eval="True"/>
            </write>

            <create model="hr.employee" count="300" id="bench_be_payroll_employees" scale="False">
                <value name="counter" generator="misc.counter" start="1" unique="True"/>
                <field name="name" eval="f'Benchmark BE Payroll Employee {counter:05}'"/>
                <field name="company_id" ref="bench_be_payroll_company"/>
                <field name="private_country_id" eval="env.ref('base.be').id"/>
                <field name="birthday" eval="f'{1960 + counter % 46}-{1 + counter % 12:02}-15'"/>
                <field name="date_version" eval="'2026-01-01'"/>
                <field name="contract_date_start" eval="'2026-01-01'"/>
                <field name="structure_type_id" eval="env.ref('hr.structure_type_employee_cp200').id"/>
                <field name="employee_type_id" eval="env.ref('hr.contract_type_employee').id"/>
                <field name="resource_calendar_id" ref="bench_be_payroll_company.resource_calendar_id"/>
                <field name="schedule_pay" eval="'monthly'"/>
                <field name="wage_type" eval="'monthly'"/>
                <field name="currency_id" ref="bench_be_payroll_company.currency_id"/>
                <field name="wage" start="2100.0" end="9500.0" distribution="normal(mean=4500, std=1600)"/>
                <field name="review_state" eval="'1_reviewed'"/>
                <field name="l10n_be_joint_committee_id" eval="env.ref('l10n_be_hr_payroll.l10n_be_joint_committee_200').id"/>
                <field name="l10n_be_salary_scale_id" eval="env.ref('l10n_be_hr_payroll.cp200_b').id"/>
                <field name="l10n_be_worker_code_id" eval="env.ref('l10n_be_hr_payroll.l10n_be_worker_code_00015' if counter % 5 == 0 else 'l10n_be_hr_payroll.l10n_be_worker_code_00495').id"/>
                <field name="l10n_be_dimona_category" eval="'oth'"/>
                <field name="sex" values="['male', 'female']"/>
                <field name="marital" values="{'single': 4, 'married': 3, 'cohabitant': 1, 'divorced': 1, 'widower': 1}"/>
                <field name="spouse_fiscal_status" values="{'without_income': 3, 'high_income': 3, 'low_income': 1, 'low_pension': 1, 'high_pension': 1}"/>
                <field name="children" values="{0: 5, 1: 2, 2: 2, 3: 1, 9: 1}"/>
                <field name="l10n_be_dependent_children_attachment" values="{0: 9, 2: 1}"/>
                <field name="l10n_be_resident_situation" eval="'resident'"/>
                <field name="certificate" values="{'other': 4, 'bachelor': 2, 'master': 2, 'doctor': 2}"/>
                <field name="rd_percentage" eval="0.4 if certificate in ('bachelor', 'master', 'doctor') and counter % 2 == 0 else 0.0"/>
                <field name="ip_wage_rate" eval="0.25 if counter % 10 == 3 else 0.0"/>
                <field name="transport_mode_car" eval="counter % 3 == 1"/>
                <field name="private_car_employee_kilometer" eval="25 if counter % 6 == 2 else 0"/>
                <field name="bike_transport_employee_kilometer" eval="8.0 if counter % 6 == 5 else 0.0"/>
                <field name="meal_voucher_amount" values="{0.0: 2, 8.0: 8}"/>
                <field name="internet" values="{0.0: 1, 38.0: 1}"/>
                <field name="mobile" values="{0.0: 1, 30.0: 1}"/>
                <field name="laptop" values="{0.0: 1, 1.0: 1}"/>
                <field name="l10n_be_lsa_internet_amount" values="{0.0: 2, 20.0: 1}"/>
                <field name="l10n_be_lsa_phone_amount" values="{0.0: 2, 20.0: 1}"/>
                <field name="l10n_be_group_insurance_rate" values="{0.0: 2, 0.025: 1}"/>
                <field name="commission_on_target" eval="1000.0 if counter % 4 == 0 else 0.0"/>
            </create>

            <create model="fleet.vehicle.model.brand" count="1" id="bench_be_payroll_car_brand" scale="False" parallel="False">
                <field name="name" eval="'Benchmark Brand'"/>
            </create>

            <create model="fleet.vehicle.model" count="1" id="bench_be_payroll_car_model" scale="False" parallel="False">
                <field name="name" eval="'Benchmark Model'"/>
                <field name="brand_id" ref="bench_be_payroll_car_brand"/>
                <field name="vehicle_type" eval="'car'"/>
            </create>

            <create model="fleet.vehicle" count="100" id="bench_be_payroll_cars" scale="False" parallel="False">
                <value name="counter" generator="misc.counter" start="1" unique="True"/>
                <value name="employee" eval="env['hr.employee'].search([('name', '=', f'Benchmark BE Payroll Employee {counter * 3 - 2:05}')], limit=1)"/>
                <field name="model_id" ref="bench_be_payroll_car_model"/>
                <field name="license_plate" eval="f'BENCH-{counter:05}'"/>
                <field name="driver_id" eval="employee.work_contact_id.id"/>
                <field name="company_id" ref="bench_be_payroll_company"/>
                <field name="acquisition_date" eval="'2025-01-01'"/>
                <field name="car_value" start="30000.0" end="70000.0"/>
                <field name="fuel_type" values="['diesel', 'gasoline', 'plug_in_hybrid_gasoline', 'electric']"/>
                <field name="co2" start="0.0" end="160.0"/>
            </create>

            <function model="hr.version" name="_compute_car_id" batched="True" parallel="False"
                      domain="[('transport_mode_car', '=', True), ('company_id.name', '=', 'Benchmark Belgian Payroll Company')]"/>

            <create model="resource.calendar.leaves" count="1" id="bench_be_payroll_public_holiday" scale="False" parallel="False">
                <field name="name" eval="'Benchmark Public Holiday'"/>
                <field name="company_id" ref="bench_be_payroll_company"/>
                <field name="calendar_id" ref="bench_be_payroll_company.resource_calendar_id"/>
                <field name="date_from" eval="'2026-08-14 04:00:00'"/>
                <field name="date_to" eval="'2026-08-14 20:00:00'"/>
                <field name="work_entry_type_id" eval="env.ref('hr_work_entry.l10n_be_work_entry_type_bank_holiday').id"/>
            </create>

            <create model="hr.leave" count="150" id="bench_be_payroll_legal_leaves" scale="False" parallel="False" context="{'skip_allocation_check': True}">
                <value name="counter" generator="misc.counter" start="1" unique="True"/>
                <field name="employee_id" eval="env['hr.employee'].search([('name', '=', f'Benchmark BE Payroll Employee {counter * 2 - 1:05}')], limit=1).id"/>
                <field name="work_entry_type_id" eval="env.ref('hr_work_entry.be_work_entry_type_legal_leave').id"/>
                <field name="request_date_from" eval="'2026-08-03'"/>
                <field name="request_date_to" eval="'2026-08-05'"/>
            </create>

            <create model="hr.leave" count="60" id="bench_be_payroll_sick_leaves" scale="False" parallel="False" context="{'skip_allocation_check': True}">
                <value name="counter" generator="misc.counter" start="1" unique="True"/>
                <field name="employee_id" eval="env['hr.employee'].search([('name', '=', f'Benchmark BE Payroll Employee {counter * 5:05}')], limit=1).id"/>
                <field name="work_entry_type_id" eval="env.ref('hr_work_entry.be_work_entry_type_sick_leave').id"/>
                <field name="request_date_from" eval="'2026-08-17'"/>
                <field name="request_date_to" eval="'2026-08-19'"/>
            </create>

            <create model="hr.leave" count="30" id="bench_be_payroll_unemployment" scale="False" parallel="False" context="{'skip_allocation_check': True}">
                <value name="counter" generator="misc.counter" start="1" unique="True"/>
                <field name="employee_id" eval="env['hr.employee'].search([('name', '=', f'Benchmark BE Payroll Employee {counter * 10 - 3:05}')], limit=1).id"/>
                <field name="work_entry_type_id" eval="env.ref('hr_work_entry.l10n_be_work_entry_type_temporary_economic_unemployement_employee').id"/>
                <field name="request_date_from" eval="'2026-08-10'"/>
                <field name="request_date_to" eval="'2026-08-12'"/>
            </create>

            <create model="hr.leave" count="100" id="bench_be_payroll_home_working" scale="False" parallel="False" context="{'skip_allocation_check': True}">
                <value name="counter" generator="misc.counter" start="1" unique="True"/>
                <field name="employee_id" eval="env['hr.employee'].search([('name', '=', f'Benchmark BE Payroll Employee {counter * 3:05}')], limit=1).id"/>
                <field name="work_entry_type_id" eval="env.ref('hr_work_entry.be_work_entry_type_home_working').id"/>
                <field name="request_date_from" eval="'2026-08-24'"/>
                <field name="request_date_to" eval="'2026-08-26'"/>
            </create>

            <function model="hr.leave" name="_action_validate" batched="True" parallel="False" context="{'skip_allocation_check': True}"
                      domain="[('employee_id.company_id.name', '=', 'Benchmark Belgian Payroll Company'), ('state', '=', 'confirm')]">
                <arg name="check_state" eval="False"/>
            </function>

            <create model="hr.payslip" count="2100" id="bench_be_payroll_previous_payslips" scale="False" parallel="False">
                <value name="counter" generator="misc.counter" start="0" unique="True"/>
                <value name="month" eval="counter // 300 + 1"/>
                <value name="employee" eval="env['hr.employee'].search([('name', '=', f'Benchmark BE Payroll Employee {counter % 300 + 1:05}')], limit=1)"/>
                <field name="name" eval="f'Benchmark BE Payroll Previous Payslip {counter:05}'"/>
                <field name="employee_id" eval="employee.id"/>
                <field name="version_id" eval="employee.version_id.id"/>
                <field name="date_from" eval="f'2026-{month:02}-01'"/>
                <field name="date_to" eval="('2026-01-31', '2026-02-28', '2026-03-31', '2026-04-30', '2026-05-31', '2026-06-30', '2026-07-31')[month - 1]"/>
                <field name="struct_id" eval="env.ref('l10n_be_hr_payroll.hr_payroll_structure_cp200_employee_salary').id"/>
                <field name="company_id" ref="bench_be_payroll_company"/>
            </create>

            <function model="hr.payslip" name="compute_sheet" ref="bench_be_payroll_previous_payslips" batched="True" parallel="False"/>

            <write model="hr.payslip" ref="bench_be_payroll_previous_payslips" batched="True" parallel="False">
                <field name="state" eval="'validated'"/>
            </write>

            <create model="hr.payslip.run" count="1" id="bench_be_payroll_payrun" scale="False" parallel="False">
                <field name="name" eval="'Benchmark Belgian Payroll Payrun - August 2026'"/>
                <field name="date_start" eval="'2026-08-01'"/>
                <field name="date_end" eval="'2026-08-31'"/>
                <field name="structure_id" eval="env.ref('l10n_be_hr_payroll.hr_payroll_structure_cp200_employee_salary').id"/>
                <field name="company_id" ref="bench_be_payroll_company"/>
            </create>

            <create model="hr.payslip" count="300" id="bench_be_payroll_payslips" scale="False" parallel="False">
                <value name="counter" generator="misc.counter" start="1" unique="True"/>
                <field name="name" eval="f'Benchmark BE Payroll Payslip {counter:05}'"/>
                <field name="employee_id" ref="bench_be_payroll_employees"
                       domain="[('name', '=', 'Benchmark BE Payroll Employee %05d' % counter)]"/>
                <field name="version_id" eval="env['hr.employee'].browse(employee_id).version_id.id"/>
                <field name="payslip_run_id" ref="bench_be_payroll_payrun"/>
                <field name="date_from" eval="'2026-08-01'"/>
                <field name="date_to" eval="'2026-08-31'"/>
                <field name="struct_id" eval="env.ref('l10n_be_hr_payroll.hr_payroll_structure_cp200_employee_salary').id"/>
                <field name="company_id" ref="bench_be_payroll_company"/>
            </create>

            <create model="hr.payslip.input" count="75" id="bench_be_payroll_commission_inputs" scale="False" parallel="False">
                <value name="counter" generator="misc.counter" start="1" unique="True"/>
                <field name="payslip_id" eval="env['hr.payslip'].search([('date_from', '=', '2026-08-01'), ('employee_id.name', '=', f'Benchmark BE Payroll Employee {counter * 4:05}')], limit=1).id"/>
                <field name="salary_rule_id" eval="env.ref('l10n_be_hr_payroll.cp200_employees_salary_fixed_commission').id"/>
                <field name="amount" start="200.0" end="2000.0"/>
            </create>

            <create model="hr.payslip.input" count="50" id="bench_be_payroll_additional_gross_inputs" scale="False" parallel="False">
                <value name="counter" generator="misc.counter" start="1" unique="True"/>
                <field name="payslip_id" eval="env['hr.payslip'].search([('date_from', '=', '2026-08-01'), ('employee_id.name', '=', f'Benchmark BE Payroll Employee {counter * 6 - 1:05}')], limit=1).id"/>
                <field name="salary_rule_id" eval="env.ref('l10n_be_hr_payroll.cp200_employees_salary_additional_gross').id"/>
                <field name="amount" start="100.0" end="1500.0"/>
            </create>

            <create model="hr.payslip.input" count="37" id="bench_be_payroll_atn_misc_inputs" scale="False" parallel="False">
                <value name="counter" generator="misc.counter" start="1" unique="True"/>
                <field name="payslip_id" eval="env['hr.payslip'].search([('date_from', '=', '2026-08-01'), ('employee_id.name', '=', f'Benchmark BE Payroll Employee {counter * 8 - 2:05}')], limit=1).id"/>
                <field name="salary_rule_id" eval="env.ref('l10n_be_hr_payroll.cp200_employees_salary_atn_miscellaneous').id"/>
                <field name="amount" start="20.0" end="300.0"/>
            </create>

            <create model="hr.payslip.input" count="20" id="bench_be_payroll_attachment_inputs" scale="False" parallel="False">
                <value name="counter" generator="misc.counter" start="1" unique="True"/>
                <field name="payslip_id" eval="env['hr.payslip'].search([('date_from', '=', '2026-08-01'), ('employee_id.name', '=', f'Benchmark BE Payroll Employee {counter * 15:05}')], limit=1).id"/>
                <field name="salary_rule_id" eval="env.ref('l10n_be_hr_payroll.l10n_be_hr_payroll_structure_cp200_employee_salary_attachment_of_salary_rule').id"/>
                <field name="amount" start="100.0" end="800.0"/>
            </create>
        </field>
    </record>
</odoo>
