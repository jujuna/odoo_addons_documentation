msgstr ""
"une description des clauses et événements déclencheurs susceptibles de "
"modifier ou d’interrompre les droits et obligations initialement attachés "
"aux jetons, ainsi que des conséquences comptables de la survenance de chaque "
"événement déclencheur"

#. module: l10n_fr_reports_accountant_knowledge
#: model_terms:knowledge.article,template_body:l10n_fr_reports_accountant_knowledge.l10n_fr_accountant_knowledge_article_template_notes_other_information
msgid "a description of the context and purpose of each issuance"
msgstr "une description du contexte et de l’objet de chaque émission"

#. module: l10n_fr_reports_accountant_knowledge
#: model_terms:knowledge.article,template_body:l10n_fr_reports_accountant_knowledge.l10n_fr_accountant_knowledge_article_template_notes_other_information
msgid ""
"a description of the economic model(s) used to manage and account for "
"emission allowances (\"Production\" model, \"Trading\" model)"
msgstr ""
"une description du ou des modèles économiques utilisés pour gérer et "
"comptabiliser les quotas d’émission (modèle « Production », modèle « Négoce "
"»)"

#. module: l10n_fr_reports_accountant_knowledge
#: model_terms:knowledge.article,template_body:l10n_fr_reports_accountant_knowledge.l10n_fr_accountant_knowledge_article_template_notes_off_balance_sheet
msgid "a description of the nature and objectives of the transaction"
msgstr "une description de la nature et des objectifs de l’opération"

#. module: l10n_fr_reports_accountant_knowledge
#: model_terms:knowledge.article,template_body:l10n_fr_reports_accountant_knowledge.l10n_fr_accountant_knowledge_article_template_notes_liabilities
msgid "a description of the nature of the contingent liabilities"
msgstr "une description de la nature des passifs éventuels"

#. module: l10n_fr_reports_accountant_knowledge
#: model_terms:knowledge.article,template_body:l10n_fr_reports_accountant_knowledge.l10n_fr_accountant_knowledge_article_template_notes_liabilities
msgid "a description of the nature of this liability"
msgstr "une description de la nature de ce passif"

#. module: l10n_fr_reports_accountant_knowledge
#: model_terms:knowledge.article,template_body:l10n_fr_reports_accountant_knowledge.l10n_fr_accountant_knowledge_article_template_notes_off_balance_sheet
