"<em class=\"text-danger\">Indication of the impact of the change on the main"
" items concerned, unless impracticable.</em>"
msgstr ""
"<em class=\"text-danger\">Indiquez l’incidence du changement sur les "
"principaux postes concernés, sauf impossibilité pratique.</em>"

#. module: l10n_fr_reports_accountant_knowledge
#: model_terms:knowledge.article,template_body:l10n_fr_reports_accountant_knowledge.l10n_fr_accountant_knowledge_article_template_notes_accounting_policies
msgid ""
"<em class=\"text-danger\">Mention and justification of the change in "
"estimate.</em>"
msgstr ""
"<em class=\"text-danger\">Mentionnez et justifiez le changement "
"d’estimation.</em>"

#. module: l10n_fr_reports_accountant_knowledge
#: model_terms:knowledge.article,template_body:l10n_fr_reports_accountant_knowledge.l10n_fr_accountant_knowledge_article_template_notes_accounting_policies
msgid ""
"<em class=\"text-danger\">Mention of the impact of the change in regulation "
"determined at the opening, specifying the items concerned.</em>"
msgstr ""
"<em class=\"text-danger\">Mentionnez l’incidence du changement de "
"réglementation déterminée à l’ouverture de l’exercice, en précisant les "
"postes concernés.</em>"

#. module: l10n_fr_reports_accountant_knowledge
#: model_terms:knowledge.article,template_body:l10n_fr_reports_accountant_knowledge.l10n_fr_accountant_knowledge_article_template_notes_accounting_policies
msgid ""
