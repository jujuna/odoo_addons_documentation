msgstr "par marché géographique"

#. module: l10n_fr_reports_accountant_knowledge
#: model_terms:knowledge.article,template_body:l10n_fr_reports_accountant_knowledge.l10n_fr_accountant_knowledge_article_template_notes_related_party_transactions
msgid "by the company with subsidiaries it wholly owns"
msgstr "par la société avec des filiales qu’elle détient intégralement"

#. module: l10n_fr_reports_accountant_knowledge
