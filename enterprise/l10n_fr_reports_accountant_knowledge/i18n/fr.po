#. module: l10n_fr_reports_accountant_knowledge
#: model_terms:knowledge.article,template_body:l10n_fr_reports_accountant_knowledge.l10n_fr_accountant_knowledge_article_template_notes_management
msgid ""
"advances and credits granted to them, indicating the terms granted and the "
"repayments made during the year, as well as the amount of commitments made "
"on their behalf"
msgstr ""
"avances et crédits qui leur ont été accordés, en indiquant les conditions "
"consenties et les remboursements effectués au cours de l’exercice, ainsi que "
"le montant des engagements pris pour leur compte"

#. module: l10n_fr_reports_accountant_knowledge
#: model_terms:knowledge.article,template_body:l10n_fr_reports_accountant_knowledge.l10n_fr_accountant_knowledge_article_template_notes_liabilities
msgid "an estimate of their financial effects"
msgstr "une estimation de leurs effets financiers"

#. module: l10n_fr_reports_accountant_knowledge
#: model_terms:knowledge.article,template_body:l10n_fr_reports_accountant_knowledge.l10n_fr_accountant_knowledge_article_template_notes_off_balance_sheet
msgid ""
"an indication of the amount of risks and benefits expected from the "
"transaction over the entire term of the agreement"
msgstr ""
"une indication du montant des risques et avantages attendus de l’opération "
"pendant toute la durée du contrat"

#. module: l10n_fr_reports_accountant_knowledge
#: model_terms:knowledge.article,template_body:l10n_fr_reports_accountant_knowledge.l10n_fr_accountant_knowledge_article_template_notes_off_balance_sheet
msgid ""
"an indication of the guarantees given in connection with the transaction"
msgstr "une indication des garanties données dans le cadre de l’opération"

#. module: l10n_fr_reports_accountant_knowledge
#: model_terms:knowledge.article,template_body:l10n_fr_reports_accountant_knowledge.l10n_fr_accountant_knowledge_article_template_notes_taxation
msgid ""
"an indication of the nature, amount and accounting treatment of receivables "
"resulting from the carryback of losses"
msgstr ""
"une indication de la nature, du montant et du traitement comptable des "
"créances résultant du report en arrière des déficits"

#. module: l10n_fr_reports_accountant_knowledge
#: model_terms:knowledge.article,template_body:l10n_fr_reports_accountant_knowledge.l10n_fr_accountant_knowledge_article_template_notes_liabilities
msgid ""
"an indication of the uncertainties relating to the amount or timing of any "
"outflow of resources"
msgstr ""
"une indication des incertitudes relatives au montant ou à l’échéance d’une "
"sortie de ressources"

#. module: l10n_fr_reports_accountant_knowledge
#: model_terms:knowledge.article,template_body:l10n_fr_reports_accountant_knowledge.l10n_fr_accountant_knowledge_article_template_notes_liabilities
msgid ""
"an indication of the uncertainties relating to the amount or timing of any "
"outflow of resources."
msgstr ""
"une indication des incertitudes relatives au montant ou à l’échéance d’une "
"sortie de ressources."

#. module: l10n_fr_reports_accountant_knowledge
#: model_terms:knowledge.article,template_body:l10n_fr_reports_accountant_knowledge.l10n_fr_accountant_knowledge_article_template_notes_taxation
msgid ""
"an indication, even approximate, of the extent to which the result has been "
"affected by tax-driven measurement departures adopted in order to obtain tax"
" relief"
msgstr ""
"une indication, même approximative, de la mesure dans laquelle le résultat a "
"été affecté par les dérogations d’évaluation à caractère fiscal adoptées "
"pour obtenir un allègement fiscal"

#. module: l10n_fr_reports_accountant_knowledge
#: model_terms:knowledge.article,template_body:l10n_fr_reports_accountant_knowledge.l10n_fr_accountant_knowledge_article_template_notes_off_balance_sheet
msgid ""
"any other information useful for a proper understanding of the transaction."
msgstr "toute autre information utile à la bonne compréhension de l’opération."

#. module: l10n_fr_reports_accountant_knowledge
#: model_terms:knowledge.article,template_body:l10n_fr_reports_accountant_knowledge.l10n_fr_accountant_knowledge_article_template_notes_other_information
