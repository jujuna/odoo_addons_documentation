#. module: l10n_fr_reports_accountant_knowledge
#: model_terms:knowledge.article,template_body:l10n_fr_reports_accountant_knowledge.l10n_fr_accountant_knowledge_article_template_notes_accounting_policies
msgid ""
"<em class=\"text-danger\">Describe here events with no material direct link "
"to a situation existing at the balance sheet date, occurring between the "
"balance sheet date of {{ end of period }} and the date the accounts are "
"prepared.</em>"
msgstr ""
"<em class=\"text-danger\">Décrivez ici les événements sans lien direct "
"prépondérant avec une situation existant à la date de clôture, survenus "
"entre la date de clôture du {{ end of period }} et la date d’établissement "
"des comptes.</em>"

#. module: l10n_fr_reports_accountant_knowledge
#: model_terms:knowledge.article,template_body:l10n_fr_reports_accountant_knowledge.l10n_fr_accountant_knowledge_article_template_notes_accounting_policies
msgid ""
"<em class=\"text-danger\">Describe here significant events other than "
"subsequent events.</em>"
msgstr ""
"<em class=\"text-danger\">Décrivez ici les événements significatifs autres "
"que les événements postérieurs à la clôture.</em>"

#. module: l10n_fr_reports_accountant_knowledge
#: model_terms:knowledge.article,template_body:l10n_fr_reports_accountant_knowledge.l10n_fr_accountant_knowledge_article_template_notes_accounting_policies
msgid ""
"<em class=\"text-danger\">Eventually, add the location where to find the "
"consolidated financial statements</em>"
msgstr ""
"<em class=\"text-danger\">Le cas échéant, indiquez où les comptes consolidés "
"peuvent être consultés</em>"

#. module: l10n_fr_reports_accountant_knowledge
#: model_terms:knowledge.article,template_body:l10n_fr_reports_accountant_knowledge.l10n_fr_accountant_knowledge_article_template_notes_accounting_policies
msgid ""
"<em class=\"text-danger\">For this change, indication of the reasons for its"
" prospective application and of its impact on the main items concerned for "
"the year, unless impracticable.</em>"
msgstr ""
"<em class=\"text-danger\">Pour ce changement, indiquez les raisons de son "
"application prospective et son incidence sur les principaux postes concernés "
"de l’exercice, sauf impossibilité pratique.</em>"

#. module: l10n_fr_reports_accountant_knowledge
#: model_terms:knowledge.article,template_body:l10n_fr_reports_accountant_knowledge.l10n_fr_accountant_knowledge_article_template_notes_accounting_policies
