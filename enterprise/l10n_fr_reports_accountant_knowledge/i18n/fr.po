msgid ""
"commitments relating to outstanding placement guarantees on digital assets, "
"mentioned in point (e) of 5° of Article L. 54-10-2 of the French Monetary "
"and Financial Code"
msgstr ""
"engagements relatifs aux garanties de placement d’actifs numériques en "
"cours, mentionnées au point e) du 5° de l’article L. 54-10-2 du Code "
"monétaire et financier"

#. module: l10n_fr_reports_accountant_knowledge
#: model_terms:knowledge.article,template_body:l10n_fr_reports_accountant_knowledge.l10n_fr_accountant_knowledge_article_template_micro_companies
msgid "commitments to related or associated entities"
msgstr "engagements envers les entités liées ou associées"

#. module: l10n_fr_reports_accountant_knowledge
#: model_terms:knowledge.article,template_body:l10n_fr_reports_accountant_knowledge.l10n_fr_accountant_knowledge_article_template_notes_other_information
msgid ""
"conditions for the vesting of shares or the exercise of purchase options "
"(performance, presence)"
msgstr ""
"conditions d’acquisition définitive des actions ou d’exercice des options "
"d’achat (performance, présence)"

#. module: l10n_fr_reports_accountant_knowledge
#: model_terms:knowledge.article,template_body:l10n_fr_reports_accountant_knowledge.l10n_fr_accountant_knowledge_article_template_notes_income_statement
msgid ""
"corrections of errors, except where correcting an entry that was directly "
"charged to equity."
msgstr ""
"corrections d’erreurs, sauf lorsqu’elles corrigent une écriture directement "
"imputée aux capitaux propres."

#. module: l10n_fr_reports_accountant_knowledge
#: model_terms:knowledge.article,template_body:l10n_fr_reports_accountant_knowledge.l10n_fr_accountant_knowledge_article_template_notes_accounting_policies
