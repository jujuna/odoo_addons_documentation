<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_contract_template_view_form" model="ir.ui.view">
        <field name="name">hr.contract.template.view.form.inherit.l10n_ge_hr_payroll</field>
        <field name="model">hr.version</field>
        <field name="inherit_id" ref="hr.hr_contract_template_form_view"/>
        <field name="arch" type="xml">
            <group name="salary_info" position="inside">
                <group string="Georgia Payroll" name="l10n_ge_payroll" invisible="country_code != 'GE'">
                    <field name="l10n_ge_net_salary" string="Net Salary Basis"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
