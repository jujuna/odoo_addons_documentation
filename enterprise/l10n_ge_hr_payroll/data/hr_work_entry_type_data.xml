<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Paid time: remuneration and taxable salary. The sick leave is paid by the employer from the first day (MoH
             Order No. 87/ნ of 2009); a company not applying the order sets the rate of its time type to 0. -->
        <record id="hr_work_entry.ge_work_entry_type_attendance" model="hr.work.entry.type">
            <field name="category_ids" eval="[(6, 0, [
                ref('l10n_ge_hr_payroll.GE_REMUNERATION_BASE'),
                ref('l10n_ge_hr_payroll.GE_TAXABLE'),
            ])]"/>
        </record>

        <record id="hr_work_entry.ge_work_entry_type_home_working" model="hr.work.entry.type">
            <field name="category_ids" eval="[(6, 0, [
                ref('l10n_ge_hr_payroll.GE_REMUNERATION_BASE'),
                ref('l10n_ge_hr_payroll.GE_TAXABLE'),
            ])]"/>
            <field name="round_days_type">DOWN</field>
        </record>

        <record id="hr_work_entry.ge_work_entry_type_leave" model="hr.work.entry.type">
            <field name="category_ids" eval="[(6, 0, [
                ref('l10n_ge_hr_payroll.GE_REMUNERATION_BASE'),
                ref('l10n_ge_hr_payroll.GE_TAXABLE'),
            ])]"/>
            <field name="round_days_type">DOWN</field>
        </record>

        <record id="hr_work_entry.ge_work_entry_type_compensatory" model="hr.work.entry.type">
            <field name="category_ids" eval="[(6, 0, [
                ref('l10n_ge_hr_payroll.GE_REMUNERATION_BASE'),
                ref('l10n_ge_hr_payroll.GE_TAXABLE'),
            ])]"/>
            <field name="round_days_type">DOWN</field>
        </record>

        <record id="hr_work_entry.ge_work_entry_type_legal_leave" model="hr.work.entry.type">
            <field name="category_ids" eval="[(6, 0, [
                ref('l10n_ge_hr_payroll.GE_REMUNERATION_BASE'),
                ref('l10n_ge_hr_payroll.GE_TAXABLE'),
            ])]"/>
            <field name="round_days_type">DOWN</field>
        </record>

        <record id="hr_work_entry.l10n_ge_work_entry_type_additional_leave" model="hr.work.entry.type">
            <field name="category_ids" eval="[(6, 0, [
                ref('l10n_ge_hr_payroll.GE_REMUNERATION_BASE'),
                ref('l10n_ge_hr_payroll.GE_TAXABLE'),
            ])]"/>
        </record>

        <record id="hr_work_entry.ge_work_entry_type_public_holiday" model="hr.work.entry.type">
            <field name="category_ids" eval="[(6, 0, [
                ref('l10n_ge_hr_payroll.GE_REMUNERATION_BASE'),
                ref('l10n_ge_hr_payroll.GE_TAXABLE'),
            ])]"/>
        </record>

        <record id="hr_work_entry.ge_work_entry_type_sick_leave" model="hr.work.entry.type">
            <field name="category_ids" eval="[(6, 0, [
                ref('l10n_ge_hr_payroll.GE_REMUNERATION_BASE'),
                ref('l10n_ge_hr_payroll.GE_TAXABLE'),
            ])]"/>
            <field name="round_days_type">DOWN</field>
        </record>

        <!-- Overtime hours are paid by the overtime rule at the rate agreed in the contract -->
        <record id="hr_work_entry.ge_work_entry_type_overtime" model="hr.work.entry.type">
            <field name="category_ids" eval="[(6, 0, [ref('hr_payroll.EXTRA_HOURS')])]"/>
            <field name="display_hours" eval="True"/>
        </record>

        <!-- Time without wage: the maternity, parental and adoption leaves are paid by the State (Labour Code, art. 39) -->
        <record id="hr_work_entry.ge_hr_work_entry_type_out_of_contract" model="hr.work.entry.type">
            <field name="category_ids" eval="[(5, 0, 0)]"/>
            <field name="round_days_type">HALF-UP</field>
        </record>

        <record id="hr_work_entry.ge_work_entry_type_unpaid_leave" model="hr.work.entry.type">
            <field name="category_ids" eval="[(5, 0, 0)]"/>
            <field name="round_days_type">DOWN</field>
        </record>

        <record id="hr_work_entry.l10n_ge_work_entry_type_maternity_leave" model="hr.work.entry.type">
            <field name="category_ids" eval="[(5, 0, 0)]"/>
        </record>

        <record id="hr_work_entry.l10n_ge_work_entry_type_parental_leave" model="hr.work.entry.type">
            <field name="category_ids" eval="[(5, 0, 0)]"/>
        </record>

        <record id="hr_work_entry.l10n_ge_work_entry_type_adoption_leave" model="hr.work.entry.type">
            <field name="category_ids" eval="[(5, 0, 0)]"/>
        </record>

        <record id="hr_work_entry.l10n_ge_work_entry_type_additional_parental_leave" model="hr.work.entry.type">
            <field name="category_ids" eval="[(5, 0, 0)]"/>
        </record>
    </data>
</odoo>
