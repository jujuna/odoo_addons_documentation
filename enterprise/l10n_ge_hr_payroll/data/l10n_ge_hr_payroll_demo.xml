<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="base.demo_company_ge" model="res.company" forcecreate="1">
        <field name="name">GE Company</field>
        <field name="currency_id" ref="base.GEL"/>
        <field name="country_id" ref="base.ge"/>
        <field name="resource_calendar_id" ref="l10n_ge_hr_payroll.resource_calendar_ge_40"/>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="company_ids" eval="[(4, ref('base.demo_company_ge'))]"/>
    </record>

    <record id="base.user_demo" model="res.users">
        <field name="company_ids" eval="[(4, ref('base.demo_company_ge'))]"/>
    </record>

    <record id="hr_department_rdge" model="hr.department">
        <field name="name">RD GE</field>
        <field name="company_id" ref="base.demo_company_ge"/>
    </record>

    <record id="ge_hr_job_developer" model="hr.job">
        <field name="name">Experienced Developer</field>
        <field name="company_id" ref="base.demo_company_ge"/>
    </record>
    <record id="ge_hr_job_consultant" model="hr.job">
        <field name="name">Consultant</field>
        <field name="company_id" ref="base.demo_company_ge"/>
    </record>

    <record id="hr_employee_giorgi" model="hr.employee">
        <field name="name">Giorgi Beridze</field>
        <field name="job_id" ref="l10n_ge_hr_payroll.ge_hr_job_developer"/>
        <field name="country_id" ref="base.ge"/>
        <field name="company_id" ref="base.demo_company_ge"/>
        <field name="department_id" ref="hr_department_rdge"/>
        <field name="sex">male</field>
        <field name="structure_type_id" ref="l10n_ge_hr_payroll.structure_type_employee_ge"/>
        <field name="employee_type_id" ref="hr.contract_type_employee"/>
        <field name="wage">5200</field>
        <field name="date_version" eval="(DateTime.today() + relativedelta(years=-6, month=1, day=1))"/>
        <field name="contract_date_start" eval="(DateTime.today() + relativedelta(years=-6, month=1, day=1))"/>
        <field name="resource_calendar_id" ref="l10n_ge_hr_payroll.resource_calendar_ge_40"/>
    </record>

    <record id="hr_employee_nino" model="hr.employee">
        <field name="name">Nino Kapanadze</field>
        <field name="job_id" ref="l10n_ge_hr_payroll.ge_hr_job_consultant"/>
        <field name="country_id" ref="base.ge"/>
        <field name="company_id" ref="base.demo_company_ge"/>
        <field name="department_id" ref="hr_department_rdge"/>
        <field name="parent_id" ref="hr_employee_giorgi"/>
        <field name="sex">female</field>
        <field name="structure_type_id" ref="l10n_ge_hr_payroll.structure_type_employee_ge"/>
        <field name="employee_type_id" ref="hr.contract_type_employee"/>
        <field name="wage">3000</field>
        <field name="l10n_ge_tax_privilege">a</field>
        <field name="date_version" eval="(DateTime.today() + relativedelta(years=-1, month=1, day=1))"/>
        <field name="contract_date_start" eval="(DateTime.today() + relativedelta(years=-1, month=1, day=1))"/>
        <field name="resource_calendar_id" ref="l10n_ge_hr_payroll.resource_calendar_ge_40"/>
    </record>
</odoo>
