<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Grounds of termination of the Labour Code (art. 47(1) and 17(4)): the severance pay applies to the
         terminations by the employer on objective grounds (art. 48) -->
    <record id="l10n_ge_departure_redundancy" model="hr.departure.reason">
        <field name="sequence">1</field>
        <field name="name">Redundancy (Economic, Technological or Organisational Changes)</field>
        <field name="country_id" ref="base.ge"/>
        <field name="l10n_ge_severance" eval="True"/>
    </record>

    <record id="l10n_ge_departure_qualification_mismatch" model="hr.departure.reason">
        <field name="sequence">2</field>
        <field name="name">Qualification or Skills Mismatch</field>
        <field name="country_id" ref="base.ge"/>
        <field name="l10n_ge_severance" eval="True"/>
    </record>

    <record id="l10n_ge_departure_long_term_incapacity" model="hr.departure.reason">
        <field name="sequence">3</field>
        <field name="name">Long-Term Incapacity</field>
        <field name="country_id" ref="base.ge"/>
        <field name="l10n_ge_severance" eval="True"/>
    </record>

    <record id="l10n_ge_departure_objective_circumstances" model="hr.departure.reason">
        <field name="sequence">4</field>
        <field name="name">Other Objective Circumstances</field>
        <field name="country_id" ref="base.ge"/>
        <field name="l10n_ge_severance" eval="True"/>
    </record>

    <record id="l10n_ge_departure_resignation" model="hr.departure.reason">
        <field name="sequence">5</field>
        <field name="name">Voluntary Resignation</field>
        <field name="country_id" ref="base.ge"/>
    </record>

    <record id="l10n_ge_departure_contract_expiry" model="hr.departure.reason">
        <field name="sequence">6</field>
        <field name="name">Expiry of the Employment Agreement</field>
        <field name="country_id" ref="base.ge"/>
    </record>

    <record id="l10n_ge_departure_work_completion" model="hr.departure.reason">
        <field name="sequence">7</field>
        <field name="name">Completion of the Work</field>
        <field name="country_id" ref="base.ge"/>
    </record>

    <record id="l10n_ge_departure_mutual_agreement" model="hr.departure.reason">
        <field name="sequence">8</field>
        <field name="name">Written Agreement between the Parties</field>
        <field name="country_id" ref="base.ge"/>
    </record>

    <record id="l10n_ge_departure_gross_violation" model="hr.departure.reason">
        <field name="sequence">9</field>
        <field name="name">Gross Violation of Obligations</field>
        <field name="country_id" ref="base.ge"/>
    </record>

    <record id="l10n_ge_departure_repeated_violation" model="hr.departure.reason">
        <field name="sequence">10</field>
        <field name="name">Repeated Violation after a Disciplinary Measure</field>
        <field name="country_id" ref="base.ge"/>
    </record>

    <record id="l10n_ge_departure_court_judgment" model="hr.departure.reason">
        <field name="sequence">11</field>
        <field name="name">Court Judgment Precluding the Work</field>
        <field name="country_id" ref="base.ge"/>
    </record>

    <record id="l10n_ge_departure_illegal_strike" model="hr.departure.reason">
        <field name="sequence">12</field>
        <field name="name">Illegal Strike</field>
        <field name="country_id" ref="base.ge"/>
    </record>

    <record id="l10n_ge_departure_death" model="hr.departure.reason">
        <field name="sequence">13</field>
        <field name="name">Death of the Employer or the Employee</field>
        <field name="country_id" ref="base.ge"/>
    </record>

    <record id="l10n_ge_departure_liquidation" model="hr.departure.reason">
        <field name="sequence">14</field>
        <field name="name">Employer Liquidation</field>
        <field name="country_id" ref="base.ge"/>
    </record>

    <record id="l10n_ge_departure_probation" model="hr.departure.reason">
        <field name="sequence">15</field>
        <field name="name">Termination during the Probation Period</field>
        <field name="country_id" ref="base.ge"/>
    </record>
</odoo>
