#. module: frontdesk_whatsapp
#. odoo-python
#: code:addons/frontdesk_whatsapp/models/frontdesk_frontdesk.py:0
msgid ""
"%(host_names)s must have a valid work phone with a country code to receive "
"visitor arrival notifications via WhatsApp."
msgstr ""
"%(host_names)s ຕ້ອງມີເບີໂທລະສັບບ່ອນເຮັດວຽກທີ່ຖືກຕ້ອງ ພ້ອມລະຫັດປະເທດ ເພື່ອຮັບການແຈ້ງເຕືອນການມາຮ"
"ອດຂອງຜູ້ມາຢ້ຽມຢາມຜ່ານ WhatsApp."

#. module: frontdesk_whatsapp
#: model:ir.model.fields,field_description:frontdesk_whatsapp.field_frontdesk_frontdesk__display_name
#: model:ir.model.fields,field_description:frontdesk_whatsapp.field_frontdesk_visitor__display_name
msgid "Display Name"
msgstr "ຊື່ສະແດງ"

#. module: frontdesk_whatsapp
#: model:ir.module.module,description:base.module_frontdesk_whatsapp
msgid ""
"Enable WhatsApp alerts to hosts when visitors check in, or when hosts are "
"unavailable. This bridge module extends Frontdesk with WhatsApp delivery "
"options, using host phone numbers and configurable templates."
msgstr ""
"ເປີດໃຊ້ການແຈ້ງເຕືອນ WhatsApp ຫາເຈົ້າພາບ ເມື່ອມີຜູ້ມາຢ້ຽມຢາມເຊັກອິນ ຫຼື ເມື່ອເຈົ້າພາບບໍ່ວ່າງ. ໂມດູນເຊື່ອ"
"ມຕໍ່ນີ້ຊ່ວຍເພີ່ມຄວາມສາມາດໃຫ້ກັບ Frontdesk ດ້ວຍຕົວເລືອກການສົ່ງຜ່ານ WhatsApp, ໂດຍນຳໃຊ້ເບີໂທລະສັບຂ"
"ອງເຈົ້າພາບ ແລະ ແມ່ແບບທີ່ສາມາດກຳນົດຄ່າໄດ້."

