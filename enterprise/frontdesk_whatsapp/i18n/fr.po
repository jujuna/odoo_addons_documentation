#: code:addons/frontdesk_whatsapp/models/frontdesk_frontdesk.py:0
msgid ""
"%(host_names)s must have a valid work phone with a country code to receive "
"visitor arrival notifications via WhatsApp."
msgstr ""
"%(host_names)s doivent disposer d'un numéro de téléphone professionnel "
"valide avec un indicatif de pays pour recevoir les notifications d'arrivée "
"des visiteurs via WhatsApp."

