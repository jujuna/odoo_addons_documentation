#: code:addons/frontdesk_whatsapp/models/frontdesk_frontdesk.py:0
msgid ""
"%(host_names)s must have a valid work phone with a country code to receive "
"visitor arrival notifications via WhatsApp."
msgstr ""
"%(host_names)s 必须提供带国家/地区代码的有效办公电话，才能通过 WhatsApp 接收"
"访客到达通知。"

