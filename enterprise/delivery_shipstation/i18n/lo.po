#. odoo-python
#: code:addons/delivery_shipstation/models/shipstation_request.py:0
msgid "Partner information is required to get rate."
msgstr "ຈຳເປັນຕ້ອງມີຂໍ້ມູນຄູ່ຄ້າເພື່ອຂໍລາຄາ."

#. module: delivery_shipstation
#: model_terms:ir.ui.view,arch_db:delivery_shipstation.view_delivery_carrier_form
msgid ""
"Paste the Production Key copied from your ShipStation account, making sure "
"you are using the V2 API."
msgstr ""
"ວາງ Production Key ທີ່ສຳເນົາມາຈາກບັນຊີ ShipStation ຂອງທ່ານ, ໂດຍກວດເບິ່ງໃຫ້ແນ່ໃຈວ່າທ່ານກຳລັ"
"ງນຳໃຊ້ V2 API."

#. module: delivery_shipstation
#. odoo-javascript
#: code:addons/delivery_shipstation/static/src/components/shipstation_selection_dialog.js:0
msgid "Please select a service"
msgstr "ກະລຸນາເລືອກການບໍລິການ"

#. module: delivery_shipstation
#: model:ir.model.fields,help:delivery_shipstation.field_delivery_carrier__shipstation_label_file_type
msgid ""
"Possible file formats in which shipping labels can be downloaded. We "
