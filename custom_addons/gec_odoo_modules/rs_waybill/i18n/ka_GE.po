#. module: rs_waybill
#: model:ir.model.fields,help:rs_waybill.field_res_company__rs_stock_integration_date model:ir.model.fields,help:rs_waybill.field_res_config_settings__rs_stock_integration_date
msgid "Waybills activated (or created) on or after this Georgian date get their Odoo documents built automatically. Earlier ones stay data-only."
msgstr "ამ თარიღზე (საქართველოს დროით) ან მის შემდეგ გააქტიურებულ (ან შექმნილ) ზედნადებებს Odoo დოკუმენტები ავტომატურად ექმნება. უფრო ადრეულები მხოლოდ მონაცემებად რჩება."

#. module: rs_waybill
#: model:ir.model.fields,help:rs_waybill.field_res_company__rs_mapping_cutoff_date model:ir.model.fields,help:rs_waybill.field_res_config_settings__rs_mapping_cutoff_date
