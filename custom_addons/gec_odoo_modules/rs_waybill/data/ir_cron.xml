<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_sync_updated_waybills" model="ir.cron">
            <field name="name">RS.GE: Sync Updated Waybills</field>
            <field name="model_id" ref="model_rs_waybill"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_updated_waybills()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>


        <record id="cron_sync_template_waybills" model="ir.cron">
            <field name="name">RS.GE: Sync Template Waybills</field>
            <field name="model_id" ref="model_rs_waybill"/>
            <field name="state">code</field>
            <field name="code">model.action_sync_templates()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>


        <record id="cron_sync_transporter_waybills" model="ir.cron">
            <field name="name">RS.GE: Sync Transporter Waybills</field>
            <field name="model_id" ref="model_rs_waybill"/>
            <field name="state">code</field>
            <field name="code">model.action_sync_transporter_waybills()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>

        <record id="cron_rs_drift_repair" model="ir.cron">
            <field name="name">RS.GE: Drift Repair</field>
            <field name="model_id" ref="model_rs_waybill"/>
            <field name="state">code</field>
            <field name="code">model._cron_rs_drift_repair()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(minutes=7)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active">True</field>
        </record>

    </data>

</odoo>
