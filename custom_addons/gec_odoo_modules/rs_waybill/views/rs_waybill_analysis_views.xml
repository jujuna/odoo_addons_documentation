<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Waybill analysis / dashboards. Self-contained: remove this file from the manifest 'data' and upgrade.
         Stored fields only (rs_menu_side is not stored, so it cannot be a pivot/graph group-by). -->

    <record id="view_rs_waybill_analysis_search" model="ir.ui.view">
        <field name="name">rs.waybill.analysis.search</field>
        <field name="model">rs.waybill</field>
        <field name="arch" type="xml">
            <search string="Waybill Analysis">
                <field name="rs_waybill_number"/>
                <field name="company_id"/>
                <separator/>
                <filter name="f_seller" string="Seller" domain="[('waybill_direction','=','seller')]"/>
                <filter name="f_buyer" string="Buyer" domain="[('waybill_direction','=','buyer')]"/>
                <separator/>
                <filter name="f_active" string="Active" domain="[('state','=','active')]"/>
                <filter name="f_completed" string="Completed" domain="[('state','=','completed')]"/>
                <filter name="f_cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter name="g_direction" string="Direction" context="{'group_by':'waybill_direction'}"/>
                <filter name="g_type" string="Type" context="{'group_by':'waybill_type'}"/>
                <filter name="g_state" string="State" context="{'group_by':'state'}"/>
                <filter name="g_status" string="RS Status" context="{'group_by':'waybill_status'}"/>
                <filter name="g_company" string="Company" context="{'group_by':'company_id'}"/>
                <filter name="g_month" string="Activation Month" context="{'group_by':'activation_date:month'}"/>
            </search>
        </field>
    </record>

    <record id="view_rs_waybill_pivot" model="ir.ui.view">
        <field name="name">rs.waybill.pivot</field>
        <field name="model">rs.waybill</field>
        <field name="arch" type="xml">
            <pivot string="Waybill Analysis" sample="1">
                <field name="waybill_direction" type="row"/>
                <field name="state" type="col"/>
                <field name="full_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_rs_waybill_graph" model="ir.ui.view">
        <field name="name">rs.waybill.graph</field>
        <field name="model">rs.waybill</field>
        <field name="arch" type="xml">
            <graph string="Waybill Analysis" type="bar" sample="1">
                <field name="activation_date" interval="month" type="row"/>
                <field name="waybill_type" type="col"/>
                <field name="full_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_rs_waybill_analysis" model="ir.actions.act_window">
        <field name="name">Waybill Analysis</field>
        <field name="res_model">rs.waybill</field>
        <field name="view_mode">graph,pivot</field>
        <field name="search_view_id" ref="view_rs_waybill_analysis_search"/>
        <field name="domain">[('is_template','=',False)]</field>
        <field name="context">{'search_default_g_type': 1}</field>
    </record>

    <record id="view_rs_waybill_line_pivot" model="ir.ui.view">
        <field name="name">rs.waybill.line.pivot</field>
        <field name="model">rs.waybill.line</field>
        <field name="arch" type="xml">
            <pivot string="Waybill Goods Analysis" sample="1">
                <field name="product_id" type="row"/>
                <field name="quantity" type="measure"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_rs_waybill_line_analysis" model="ir.actions.act_window">
        <field name="name">Goods Analysis</field>
        <field name="res_model">rs.waybill.line</field>
        <field name="view_mode">pivot</field>
        <field name="domain">[('product_id','!=',False)]</field>
    </record>

    <menuitem id="menu_rs_waybill_analysis_root" name="Analysis"
              parent="menu_rs_waybill_root" sequence="60"/>
    <menuitem id="menu_rs_waybill_analysis" name="Waybill Analysis"
              parent="menu_rs_waybill_analysis_root" action="action_rs_waybill_analysis" sequence="10"/>
    <menuitem id="menu_rs_waybill_line_analysis" name="Goods Analysis"
              parent="menu_rs_waybill_analysis_root" action="action_rs_waybill_line_analysis" sequence="20"/>
</odoo>
