<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="sale_order_form_inheri_rs_waybill" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.rs.waybill</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <!-- sale_stock's extension has priority 20: this view must apply after it, or
                 //button[@name='action_view_delivery'] is not there yet. -->
            <field name="priority">25</field>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_view_delivery']" position="after">
                    <button name="action_view_waybills"
                            type="object"
                            class="oe_stat_button"
                            icon="description"
                            invisible="not waybill_id">
                        <field name="waybill_id" widget="statinfo" string="Waybill"/>
                    </button>
                </xpath>
                <xpath expr="//notebook" position="before">
                    <field name="rs_waybill_locked" invisible="1"/>
                    <div class="alert alert-warning mb-2" role="alert" invisible="not rs_waybill_locked">
                        This order is linked to an RS.GE waybill. To change the customer, products or
                        quantities, open the waybill and use <b>Adjustment</b> — direct changes here will
                        not sync to RS.GE.
                    </div>
                </xpath>
                <!-- Customer is already read-only once the order is confirmed (state='sale'), always the case
                     with a waybill on RS. -->
                <xpath expr="//field[@name='order_line']" position="attributes">
                    <attribute name="readonly">state == 'cancel' or locked or rs_waybill_locked</attribute>
                </xpath>
            </field>
        </record>


        <record id="view_order_form_inherit_rs_waybill" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.rs.waybill</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <!-- List columns are wrapped in <column>; product_id sits inside
                     <column name="product_and_description">, so anchor on the column. -->
                <xpath expr="//field[@name='order_line']/list/column[@name='product_and_description']" position="after">
                    <field name="bar_code" optional="show"/>
                </xpath>
            </field>
        </record>


    </data>
</odoo>
