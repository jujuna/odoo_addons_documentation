    <record id="view_rs_waybills_list" model="ir.ui.view">
        <field name="name">rs.waybill.list</field>
        <field name="model">rs.waybill</field>
        <field name="arch" type="xml">
            <list>
                <field name="state" widget="waybill_state_icon" string="" width="32px"/>
                <field name="rs_waybill_number"/>
                <field name="waybill_status"/>
                <field name="is_confirmed"/>
                <field name="category"/>
                <field name="waybill_type"/>
                <field name="buyer_name"/>
                <field name="full_amount"/>
                <field name="driver_name"/>
                <field name="car_number"/>
                <field name="transport_cost" optional="hide"/>
                <field name="start_address" optional="hide"/>
                <field name="end_address" optional="hide"/>
                <field name="activation_date" optional="hide"/>
                <field name="transport_start_date" optional="hide"/>
                <field name="delivery_date" optional="hide"/>
                <field name="cancel_date" optional="hide"/>
                <field name="close_date" optional="hide"/>
                <field name="comment" optional="hide"/>
                <field name="s_user_id" optional="hide"/>
                <field name="create_date" optional="hide"/>
            </list>
        </field>
    </record>


    <record id="view_rs_waybill_given_list" model="ir.ui.view">
        <field name="name">rs.waybill.given.list</field>
        <field name="model">rs.waybill</field>
        <field name="arch" type="xml">
            <list js_class="rs_waybill_list_kpis">
                <field name="state" widget="waybill_state_icon" string="" width="32px"/>
                <field name="rs_waybill_number"/>
                <field name="waybill_status"/>
                <field name="is_confirmed"/>
                <field name="category"/>
                <field name="waybill_type"/>
                <field name="buyer_name"/>
                <field name="full_amount"/>
                <field name="driver_name"/>
                <field name="car_number"/>
                <field name="transport_cost" optional="hide"/>
                <field name="start_address" optional="hide"/>
                <field name="end_address" optional="hide"/>
                <field name="activation_date" optional="hide"/>
                <field name="transport_start_date" optional="hide"/>
                <field name="delivery_date" optional="hide"/>
                <field name="cancel_date" optional="hide"/>
                <field name="close_date" optional="hide"/>
                <field name="comment" optional="hide"/>
                <field name="s_user_id" optional="hide"/>
            </list>
        </field>
    </record>


    <record id="view_rs_waybill_received_list" model="ir.ui.view">
        <field name="name">rs.waybill.received.list</field>
        <field name="model">rs.waybill</field>
        <field name="arch" type="xml">
            <list js_class="rs_waybill_list_kpis" create="0" decoration-warning="unresolved_count > 0">
                <header>
                    <button name="action_confirm_waybill" type="object"
                            string="Mark as Received" class="btn-secondary" icon="check"/>
                </header>
                <field name="state" widget="waybill_state_icon" string="" width="32px"/>
                <field name="unresolved_count" string="Needs Mapping" optional="show"/>
                <field name="rs_waybill_number"/>
                <field name="waybill_status"/>
                <field name="is_confirmed"/>
                <field name="category"/>
                <field name="waybill_type"/>
                <field name="seller_name"/>
                <field name="full_amount"/>
                <field name="driver_name"/>
                <field name="car_number"/>
                <field name="transport_cost" optional="hide"/>
                <field name="start_address" optional="hide"/>
                <field name="end_address" optional="hide"/>
                <field name="activation_date" optional="hide"/>
                <field name="transport_start_date" optional="hide"/>
                <field name="delivery_date" optional="hide"/>
                <field name="cancel_date" optional="hide"/>
                <field name="close_date" optional="hide"/>
                <field name="comment" optional="hide"/>
                <field name="s_user_id" optional="hide"/>
            </list>
        </field>
    </record>


    <record id="view_rs_waybill_saved_list" model="ir.ui.view">
        <field name="name">rs.waybill.saved.list</field>
        <field name="model">rs.waybill</field>
        <field name="arch" type="xml">
            <list>
                <field name="state" widget="waybill_state_icon" string="" width="32px"/>
                <field name="rs_waybill_number"/>
                <field name="waybill_status"/>
                <field name="is_confirmed"/>
                <field name="category"/>
                <field name="waybill_type"/>
                <field name="buyer_name"/>
                <field name="full_amount"/>
                <field name="driver_name"/>
                <field name="car_number"/>
                <field name="transport_cost" optional="hide"/>
                <field name="start_address" optional="hide"/>
                <field name="end_address" optional="hide"/>
                <field name="activation_date" optional="hide"/>
                <field name="transport_start_date" optional="hide"/>
                <field name="delivery_date" optional="hide"/>
                <field name="cancel_date" optional="hide"/>
                <field name="close_date" optional="hide"/>
                <field name="comment" optional="hide"/>
                <field name="s_user_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_rs_waybill_transporter_list" model="ir.ui.view">
        <field name="name">rs.waybill.transporter.list</field>
        <field name="model">rs.waybill</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="state" widget="waybill_state_icon" string="" width="32px"/>
                <field name="rs_waybill_number"/>
                <field name="waybill_status"/>
                <field name="waybill_type"/>
                <field name="seller_name"/>
                <field name="buyer_name"/>
                <field name="full_amount"/>
                <field name="driver_name"/>
                <field name="car_number"/>
                <field name="transport_cost" optional="hide"/>
                <field name="start_address" optional="hide"/>
                <field name="end_address" optional="hide"/>
                <field name="activation_date" optional="hide"/>
                <field name="delivery_date" optional="hide"/>
                <field name="comment" optional="hide"/>

            </list>
        </field>
    </record>


    <record id="view_rs_waybill_template_list" model="ir.ui.view">
        <field name="name">rs.waybill.template.list</field>
        <field name="model">rs.waybill</field>
        <field name="arch" type="xml">
            <list string="Templates" create="false" class="o_rs_waybill_template_list">
                <field name="template_name"/>
                <field name="rs_template_id"/>
                <field name="waybill_type"/>
                <field name="buyer_name"/>
                <field name="buyer_tin"/>
                <field name="full_amount"/>
                <field name="car_number"/>
                <field name="transport_cost" optional="hide"/>
                <field name="start_address" optional="show"/>
                <field name="end_address" optional="show"/>
                <field name="activation_date" optional="hide"/>
                <field name="delivery_date" optional="hide"/>
                <field name="comment" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_rs_waybill_given" model="ir.actions.act_window">
        <field name="name">Sent Waybills</field>
        <field name="res_model">rs.waybill</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_rs_waybill_given_list"/>
        <field name="search_view_id" ref="view_rs_waybills_search"/>
        <field name="domain">['&amp;', ('is_template', '=', False),
            '&amp;', ('rs_menu_side', '=', 'sent'),
                '|', ('state', '!=', 'draft'), ('waybill_status', '=', '8')]</field>
        <field name="context">{'default_waybill_direction': 'seller'}</field>
    </record>

    <record id="action_rs_waybill_received" model="ir.actions.act_window">
        <field name="name">Received Waybills</field>
        <field name="res_model">rs.waybill</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_rs_waybill_received_list"/>
        <field name="search_view_id" ref="view_rs_waybills_search"/>
        <!-- When WE are also the carrier, the waybill stays in the Transporter worklist until transport is activated
             (state draft covers RS status 0 and 8); once active it shows in BOTH lists. -->
        <field name="domain">['&amp;', ('is_template', '=', False),
            '&amp;', ('rs_menu_side', '=', 'received'),
                '|', ('is_our_carrier', '=', False), ('state', '!=', 'draft')]</field>
        <field name="context">{'default_waybill_direction': 'buyer', 'create': False}</field>
    </record>

    <record id="action_rs_waybill_saved" model="ir.actions.act_window">
        <field name="name">Saved Waybills</field>
        <field name="res_model">rs.waybill</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_rs_waybill_saved_list"/>
        <field name="search_view_id" ref="view_rs_waybills_search"/>
        <field name="domain">['&amp;', ('state', '=', 'draft'),
            '&amp;', ('rs_menu_side', '=', 'sent'),
                '&amp;', ('waybill_status', '!=', '8'), ('is_template', '=', False)]</field>
    </record>

    <record id="action_rs_waybill_transporter" model="ir.actions.act_window">
        <field name="name">Sent To Transporter</field>
        <field name="res_model">rs.waybill</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_rs_waybill_transporter_list"/>
        <field name="search_view_id" ref="view_rs_waybills_search"/>
        <!-- The carrier's worklist: pure transporter records plus waybills where our own company is the carrier. -->
        <field name="domain">['|', ('waybill_direction', '=', 'transporter'), ('is_our_carrier', '=', True), ('is_template', '=', False)]</field>
        <field name="context">{'default_waybill_direction': 'transporter', 'create': False}</field>
    </record>

    <record id="action_rs_waybill_template" model="ir.actions.act_window">
        <field name="name">Waybill Templates</field>
        <field name="res_model">rs.waybill</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_rs_waybill_template_list"/>
        <field name="search_view_id" ref="view_rs_waybills_search"/>
        <field name="domain">[('is_template', '=', True)]</field>
        <field name="context">{'default_is_template': True}</field>
    </record>

