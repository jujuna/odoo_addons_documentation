<?xml version="1.0" encoding="utf-8" ?>
<odoo>


    <record id="view_rs_waybills_search" model="ir.ui.view">
        <field name="name">rs.waybill.search</field>
        <field name="model">rs.waybill</field>
        <field name="arch" type="xml">
            <search>
                <searchpanel>
                    <field name="state" string="Status" icon="circle"/>
                    <field name="is_confirmed" string="State" icon="flag"/>
                    <field name="waybill_type" string="Type" icon="description"/>
                </searchpanel>
                <field name="rs_waybill_number" string="Waybill Number"/>
                <field name="rs_internal_id" string="RS ID"/>
                <field name="buyer_name"/>
                <field name="buyer_tin"/>
                <field name="seller_name"/>
                <field name="seller_tin"/>
                <field name="driver_name"/>
                <field name="driver_tin"/>
                <field name="car_number"/>
                <field name="transporter_name"/>
                <separator/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="filter_completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <filter name="filter_cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="filter_unconfirmed" string="Not Confirmed" domain="[('is_confirmed', '=', '0')]"/>
                <filter name="filter_confirmed" string="Confirmed" domain="[('is_confirmed', '=', '1')]"/>
                <filter name="filter_rejected" string="Rejected" domain="[('is_confirmed', '=', '2')]"/>
                <filter name="filter_refused" string="Refused" domain="[('is_confirmed', '=', '-1')]"/>
                <separator/>
                <filter name="filter_internal" string="Internal Transport" domain="[('waybill_type', '=', '1')]"/>
                <filter name="filter_with_transport" string="With Transport" domain="[('waybill_type', '=', '2')]"/>
                <filter name="filter_without_transport" string="Without Transport" domain="[('waybill_type', '=', '3')]"/>
                <filter name="filter_distribution" string="Distribution" domain="[('waybill_type', '=', '4')]"/>
                <filter name="filter_return" string="Return" domain="[('waybill_type', '=', '5')]"/>
                <filter name="filter_sub_waybill" string="Sub Waybill" domain="[('waybill_type', '=', '6')]"/>
                <separator/>
                <filter name="filter_auto" string="Auto" domain="[('transport_type', '=', '1')]"/>
                <filter name="filter_rail" string="Railway" domain="[('transport_type', '=', '2')]"/>
                <filter name="filter_air" string="Air" domain="[('transport_type', '=', '3')]"/>
                <filter name="filter_other" string="Other" domain="[('transport_type', '=', '4')]"/>
                <filter name="filter_foreign_auto" string="Auto Foreign" domain="[('transport_type', '=', '6')]"/>
                <filter name="filter_carrier" string="Carrier" domain="[('transport_type', '=', '7')]"/>
                <filter name="filter_moto" string="Moped / Motorcycle" domain="[('transport_type', '=', '8')]"/>
            </search>
        </field>
    </record>


