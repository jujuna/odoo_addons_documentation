<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_bog" model="ir.module.category">
        <field name="name">Bank Of Georgia</field>
        <field name="description">Send transfers and import statements via the Bank Of Georgia BIS API.</field>
        <field name="sequence">25</field>
    </record>

    <record id="bog_privilege" model="res.groups.privilege">
        <field name="name">Bank Of Georgia</field>
        <field name="category_id" ref="module_category_bog"/>
        <field name="sequence">25</field>
    </record>

    <record id="group_bog_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="bog_privilege"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="group_bog_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="bog_privilege"/>
        <field name="implied_ids" eval="[(4, ref('group_bog_user')), (4, ref('account.group_account_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
