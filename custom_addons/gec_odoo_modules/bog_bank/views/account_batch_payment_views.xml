<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_batch_payment_form_bog" model="ir.ui.view">
        <field name="name">account.batch.payment.form.bog</field>
        <field name="model">account.batch.payment</field>
        <field name="inherit_id" ref="account_batch_payment.view_batch_payment_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <field name="is_bog" invisible="1"/>
                <field name="bog_state" invisible="1"/>
                <field name="bog_processing_mode" invisible="1"/>

                <button name="action_bog_submit_approval" type="object"
                        string="Submit for Approval" class="btn-secondary"
                        invisible="payment_method_code != 'bog_transfer'
                                   or bog_processing_mode != 'odoo_approve' or state != 'draft'"/>
                <button name="action_bog_approve" type="object"
                        string="Approve" class="btn-secondary"
                        invisible="payment_method_code != 'bog_transfer'
                                   or bog_processing_mode != 'odoo_approve' or state != 'draft'"/>

                <button name="action_bog_send_batch" type="object"
                        groups="bog_bank.group_bog_user"
                        string="Send to BOG" class="btn-primary"
                        confirm="This submits every transfer in this batch to Bank of Georgia in one call. Continue?"
                        invisible="payment_method_code != 'bog_transfer'
                                   or bog_state not in ('draft', 'failed', 'partial', 'unknown')"/>
                <button name="action_bog_send_batch_individually" type="object"
                        groups="bog_bank.group_bog_user"
                        string="Send One by One" class="btn-secondary"
                        confirm="This sends each transfer as its own document. Slower, but each gets its own bank key. Continue?"
                        invisible="payment_method_code != 'bog_transfer'
                                   or bog_state not in ('draft', 'failed', 'partial', 'unknown')"/>
                <button name="action_bog_refresh_bulk_status" type="object"
                        string="Refresh Batch Status" class="btn-secondary"
                        invisible="payment_method_code != 'bog_transfer'
                                   or bog_state not in ('created', 'sent', 'partial', 'unknown')"/>
                <button name="action_bog_cancel_batch" type="object"
                        groups="bog_bank.group_bog_user"
                        string="Cancel at Bank" class="btn-secondary"
                        confirm="This deletes the unsigned batch at Bank of Georgia. Continue?"
                        invisible="payment_method_code != 'bog_transfer' or not bog_bulk_key or bog_state != 'created'"/>

                <field name="bog_state" widget="statusbar"
                       statusbar_visible="draft,created,sent,confirmed"
                       invisible="payment_method_code != 'bog_transfer'"/>
            </header>
            <xpath expr="//button[@id='validate_button'][@name='validate_batch_button']" position="attributes">
                <attribute name="invisible" add="payment_method_code == 'bog_transfer'" separator=" or "/>
            </xpath>

            <sheet position="inside">
                <div class="alert alert-warning" role="alert"
                     invisible="payment_method_code != 'bog_transfer' or not bog_bulk_key or bog_state != 'created'">
                    The batch exists at Bank of Georgia but is not yet reported as executed.
                    Bulk submissions return only a batch key — use "Refresh Batch Status" to
                    learn which individual lines succeeded.
                </div>
                <div class="alert alert-danger" role="alert"
                     invisible="payment_method_code != 'bog_transfer' or bog_state != 'unknown'">
                    Bank of Georgia never confirmed this batch. Recover each transfer
                    individually before resending — resending blind can pay twice.
                </div>

                <group string="Bank of Georgia"
                       invisible="payment_method_code != 'bog_transfer'">
                    <group>
                        <field name="bog_bulk_key"/>
                        <field name="bog_file_name" groups="base.group_no_one"/>
                    </group>
                    <group>
                        <field name="bog_bank_status" groups="base.group_no_one"/>
                        <field name="bog_error_message"/>
                    </group>
                </group>
            </sheet>
        </field>
    </record>
</odoo>
