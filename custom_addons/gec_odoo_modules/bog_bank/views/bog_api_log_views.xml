<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bog_api_log_list" model="ir.ui.view">
        <field name="name">bog.api.log.list</field>
        <field name="model">bog.api.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="create_date"/>
                <field name="connection_id"/>
                <field name="endpoint"/>
                <field name="http_status"/>
                <!-- A 200 carrying a non-zero result code is a failed operation. -->
                <field name="result_code"/>
                <field name="correlation_id" optional="show"/>
                <field name="retry_after" optional="hide"/>
                <field name="is_money_movement" optional="hide"/>
                <field name="error_message"/>
                <field name="duration_ms"/>
            </list>
        </field>
    </record>

    <record id="view_bog_api_log_form" model="ir.ui.view">
        <field name="name">bog.api.log.form</field>
        <field name="model">bog.api.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="connection_id"/>
                            <field name="endpoint"/>
                            <field name="http_status"/>
                            <field name="result_code"/>
                            <field name="duration_ms"/>
                        </group>
                        <group>
                            <!-- Quote this to customerservice@bog.ge when reporting a fault. -->
                            <field name="correlation_id"/>
                            <field name="retry_after"/>
                            <field name="is_money_movement"/>
                            <field name="error_message"/>
                        </group>
                    </group>
                    <group string="Request">
                        <field name="request_payload" nolabel="1"/>
                    </group>
                    <group string="Response">
                        <field name="response_payload" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bog_api_log" model="ir.actions.act_window">
        <field name="name">Bank of Georgia API Logs</field>
        <field name="res_model">bog.api.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
