<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bog_statement_list" model="ir.ui.view">
        <field name="name">bog.statement.list</field>
        <field name="model">bog.statement</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="fetched_on"/>
                <field name="journal_id"/>
                <field name="account_number"/>
                <field name="currency_code"/>
                <field name="snapshot_type"/>
                <field name="period_from"/>
                <field name="period_to"/>
                <field name="credit_sum" sum="Total Credit"/>
                <field name="debit_sum" sum="Total Debit"/>
                <field name="closing_balance"/>
                <field name="entry_count" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_bog_statement_form" model="ir.ui.view">
        <field name="name">bog.statement.form</field>
        <field name="model">bog.statement</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group string="Account">
                            <field name="connection_id"/>
                            <field name="journal_id"/>
                            <field name="account_number"/>
                            <field name="currency_code"/>
                        </group>
                        <group string="Period">
                            <field name="snapshot_type"/>
                            <field name="period_from"/>
                            <field name="period_to"/>
                            <field name="fetched_on"/>
                        </group>
                    </group>
                    <group string="Totals">
                        <group>
                            <field name="credit_sum"/>
                            <field name="debit_sum"/>
                        </group>
                        <group>
                            <field name="closing_balance"/>
                            <field name="entry_count"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bog_statement" model="ir.actions.act_window">
        <field name="name">Bank of Georgia Statements</field>
        <field name="res_model">bog.statement</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
