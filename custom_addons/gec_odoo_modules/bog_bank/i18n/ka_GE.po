#: code:addons/bog_bank/services/bog_service.py:0
msgid "Bank of Georgia authentication failed: %s"
msgstr "საქართველოს ბანკში ავთენტიფიკაცია ვერ მოხერხდა: %s"

#. module: bog_bank
#: model_terms:ir.ui.view,arch_db:bog_bank.view_account_payment_form_bog
msgid ""
"Bank of Georgia declined this document with a warning and did not create it."
" Submit it again with the same request id?"
msgstr ""
"საქართველოს ბანკმა ეს დოკუმენტი გაფრთხილებით უარყო და არ შექმნა. გავაგზავნოთ"
" ხელახლა იგივე მოთხოვნის იდენტიფიკატორით?"

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_batch_payment.py:0
msgid ""
"Bank of Georgia did not confirm this batch. The transfers may or may not "
"exist at the bank - recover each one before resending."
msgstr ""
"საქართველოს ბანკმა ეს პაკეტი არ დაადასტურა. გადარიცხვები ბანკში შეიძლება "
"არსებობდეს, შეიძლება — არა; ხელახლა გაგზავნამდე თითოეული აღადგინეთ."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_payment.py:0
msgid ""
"Bank of Georgia did not confirm this transfer (timeout/server error). It may"
" or may not exist at the bank - use 'Recover from BOG' before resending."
msgstr ""
"საქართველოს ბანკმა ეს გადარიცხვა არ დაადასტურა (დრო ამოიწურა/სერვერის "
"შეცდომა). ბანკში შეიძლება არსებობდეს, შეიძლება — არა; ხელახლა გაგზავნამდე "
"გამოიყენეთ „ბანკიდან აღდგენა“."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/services/bog_service.py:0
msgid "Bank of Georgia does not accept '.%(ext)s' files. Allowed: %(list)s"
msgstr "საქართველოს ბანკი '.%(ext)s' ფაილებს არ იღებს. დასაშვებია: %(list)s"

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/services/bog_service.py:0
msgid "Bank of Georgia error %(status)s: %(body)s"
msgstr "საქართველოს ბანკის შეცდომა %(status)s: %(body)s"

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_payment.py:0
msgid ""
"Bank of Georgia flagged this as a duplicate. Check Business Online and reset"
" the transfer manually if it really is new."
msgstr ""
"საქართველოს ბანკმა ეს დოკუმენტი დუბლიკატად მიიჩნია. შეამოწმეთ Business "
"Online და, თუ გადარიცხვა ნამდვილად ახალია, ხელით დააბრუნეთ მოლოდინში."

#. module: bog_bank
#: model_terms:ir.ui.view,arch_db:bog_bank.view_bog_connection_form
msgid ""
"Bank of Georgia has no test environment. Every call from this\n"
"                        connection reaches production and moves real money."
msgstr ""
"საქართველოს ბანკს სატესტო გარემო არ აქვს. ამ კავშირიდან ყოველი\n"
"                        მოთხოვნა რეალურ სისტემაში ხვდება და რეალურ თანხას გადარიცხავს."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/services/bog_service.py:0
msgid "Bank of Georgia is unreachable."
msgstr "საქართველოს ბანკთან კავშირი ვერ დამყარდა."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_payment.py:0
msgid ""
"Bank of Georgia matched the beneficiary name at only %(match).0f%% "
"(threshold %(threshold).0f%%). Check the recipient before this document is "
"signed."
msgstr ""
"საქართველოს ბანკმა მიმღების დასახელების თანხვედრა მხოლოდ %(match).0f%%-ით "
"დაადგინა (ზღვარი %(threshold).0f%%). ამ დოკუმენტის ხელმოწერამდე შეამოწმეთ "
"მიმღები."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_payment_method_line.py:0
msgid ""
"Bank of Georgia needs the bank (BIC) of these recipients' accounts. Enter "
"the full Georgian IBAN, which fills in the bank, or set the BIC on the "
"account: %s"
msgstr ""
"საქართველოს ბანკს ამ მიმღებების ანგარიშების ბანკი (BIC) სჭირდება. შეიყვანეთ "
"სრული ქართული IBAN — ბანკი ავტომატურად შეივსება — ან ანგარიშზე BIC მიუთითეთ:"
" %s"

#. module: bog_bank
#: model_terms:ir.ui.view,arch_db:bog_bank.view_batch_payment_form_bog
msgid ""
"Bank of Georgia never confirmed this batch. Recover each transfer\n"
"                    individually before resending — resending blind can pay twice."
msgstr ""
"საქართველოს ბანკს ეს პაკეტი არ დაუდასტურებია. ხელახლა გაგზავნამდე თითოეული\n"
"                    გადარიცხვა ცალ-ცალკე აღადგინეთ — შემოწმების გარეშე ხელახლა გაგზავნისას თანხა შეიძლება ორჯერ გადაირიცხოს."

#. module: bog_bank
#: model_terms:ir.ui.view,arch_db:bog_bank.view_account_payment_form_bog
msgid ""
"Bank of Georgia never confirmed this send. Use \"Recover from BOG\" before\n"
"                    resending — resending blind can pay twice."
msgstr ""
"საქართველოს ბანკს ეს გაგზავნა არ დაუდასტურებია. ხელახლა გაგზავნამდე გამოიყენეთ \"ბანკიდან აღდგენა\"\n"
"                    — შემოწმების გარეშე ხელახლა გაგზავნისას თანხა შეიძლება ორჯერ გადაირიცხოს."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_payment_method_line.py:0
msgid ""
"Bank of Georgia pays payroll only into Georgian IBANs. Pay these recipients "
"another way, or give them a Georgian account: %s"
msgstr ""
"სახელფასო გადახდებს საქართველოს ბანკი მხოლოდ ქართულ IBAN-ზე ასრულებს. ამ "
"მიმღებებს სხვა გზით გადაუხადეთ ან მიუთითეთ მათი ქართული ანგარიში: %s"

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_batch_payment.py:0
#: code:addons/bog_bank/models/account_payment.py:0
msgid "Bank of Georgia refused the cancellation: %s"
msgstr "საქართველოს ბანკმა გაუქმებაზე უარი თქვა: %s"

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/services/bog_service.py:0
msgid "Bank of Georgia refused the upload of %(name)s: %(error)s"
msgstr "საქართველოს ბანკმა %(name)s-ის ატვირთვაზე უარი თქვა: %(error)s"

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_batch_payment.py:0
msgid ""
"Bank of Georgia reports this file as a duplicate of an earlier package. "
"Check Business Online before doing anything else: the earlier package may "
"have executed, and nothing was resent."
msgstr ""
"საქართველოს ბანკი ამ ფაილს წინა პაკეტის დუბლიკატად აფიქსირებს. სანამ რამეს "
"გააკეთებდეთ, შეამოწმეთ Business Online: წინა პაკეტი შესაძლოა შესრულდა, "
"ხელახლა კი არაფერი გაგზავნილა."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/services/bog_service.py:0
msgid "Bank of Georgia request failed."
msgstr "საქართველოს ბანკისთვის გაგზავნილი მოთხოვნა ვერ შესრულდა."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/services/bog_service.py:0
msgid "Bank of Georgia request timed out. Please try again."
msgstr ""
"საქართველოს ბანკისთვის გაგზავნილი მოთხოვნის დრო ამოიწურა. სცადეთ ხელახლა."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_payment.py:0
msgid "Bank of Georgia result code %s."
msgstr "საქართველოს ბანკის შედეგის კოდი %s."

#. module: bog_bank
#: model_terms:ir.ui.view,arch_db:bog_bank.view_account_payment_form_bog
msgid ""
"Bank of Georgia returned a warning and did <b>not</b> create the document.\n"
"                    Fix the cause (funds, value date, validation) and then use \"Create Anyway\"."
msgstr ""
"საქართველოს ბანკმა დააბრუნა გაფრთხილება და დოკუმენტი <b>არ</b> შექმნა.\n"
"                    აღმოფხვერით მიზეზი (თანხა, ვალუტირების თარიღი, შემოწმება) და შემდეგ გამოიყენეთ \"მაინც შექმნა\"."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_batch_payment.py:0
msgid ""
"Bank of Georgia returned an unrecognised batch status: %s. The batch state "
"was left unchanged."
msgstr ""
"საქართველოს ბანკმა დააბრუნა პაკეტის უცნობი სტატუსი: %s. პაკეტის სტატუსი არ "
"შეცვლილა."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_payment.py:0
msgid ""
"Bank of Georgia returned an unrecognised document status: %s. The payment "
"state was left unchanged."
msgstr ""
"საქართველოს ბანკმა დააბრუნა დოკუმენტის უცნობი სტატუსი: %s. გადახდის სტატუსი "
"არ შეცვლილა."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/services/bog_service.py:0
msgid ""
"Bank of Georgia returned more than %(pages)s pages for %(account)s. Import a"
" shorter period."
msgstr ""
"საქართველოს ბანკმა %(account)s-ისთვის %(pages)s-ზე მეტი გვერდი დააბრუნა. "
"გააკეთეთ უფრო მოკლე პერიოდის იმპორტი."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_payment.py:0
msgid "Bank of Georgia returned no activity list. Try again shortly."
msgstr ""
"საქართველოს ბანკმა ოპერაციების სია არ დააბრუნა. ცოტა ხანში სცადეთ ხელახლა."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_batch_payment.py:0
msgid "Bank of Georgia returned no batch key. Check Business Online."
msgstr ""
"საქართველოს ბანკმა პაკეტის გასაღები არ დააბრუნა. შეამოწმეთ Business Online."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/services/bog_service.py:0
msgid "Bank of Georgia returned no file hash for %s."
msgstr "საქართველოს ბანკმა %s-ისთვის ფაილის ჰეში არ დააბრუნა."

#. module: bog_bank
#: model:ir.model.fields,help:bog_bank.field_bog_connection__match_threshold
msgid ""
"Bank of Georgia returns how closely the beneficiary name matches the actual "
"account holder on domestic documents. Below this percentage a warning is "
"logged on the payment. Set 0 to disable the check."
msgstr ""
"შიდა დოკუმენტებზე საქართველოს ბანკი აბრუნებს, რამდენად ემთხვევა მიმღების "
"დასახელება ანგარიშის რეალურ მფლობელს. ამ პროცენტზე ნაკლების შემთხვევაში "
"გადახდაზე გაფრთხილება ჩაიწერება. შემოწმების გასათიშად მიუთითეთ 0."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/services/bog_service.py:0
msgid ""
"Bank of Georgia sent %(count)s entries of %(account)s but no statement id to"
" read the rest. Nothing was imported; import a shorter period."
msgstr ""
"საქართველოს ბანკმა ანგარიშის %(account)s %(count)s ჩანაწერი გამოგზავნა, "
"მაგრამ დანარჩენის წასაკითხად ამონაწერის ID არ დააბრუნა. არაფერი დაიმპორტდა; "
"გააკეთეთ უფრო მოკლე პერიოდის იმპორტი."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/services/bog_service.py:0
msgid ""
"Bank of Georgia sent %(count)s of the %(total)s entries of %(account)s and "
"then stopped. Nothing was imported; import the period again later."
msgstr ""
"საქართველოს ბანკმა ანგარიშის %(account)s %(total)s ჩანაწერიდან მხოლოდ "
"%(count)s გამოგზავნა და შეწყვიტა. არაფერი დაიმპორტდა; მოგვიანებით გაიმეორეთ "
"ამ პერიოდის იმპორტი."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/services/bog_service.py:0
msgid "Bank of Georgia token request timed out."
msgstr "საქართველოს ბანკიდან ტოკენის მოთხოვნის დრო ამოიწურა."

