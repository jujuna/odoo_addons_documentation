#: model_terms:ir.ui.view,arch_db:bog_bank.view_account_payment_form_bog
msgid "Only reset this after checking Business Online. If the document is there, a new send pays twice: Bank of Georgia blocks a repeat of the same request for 7 days only."
msgstr "მოლოდინში დააბრუნეთ მხოლოდ Business Online-ის შემოწმების შემდეგ. თუ დოკუმენტი იქ არის, ახალი გაგზავნით თანხა ორჯერ გადაირიცხება: საქართველოს ბანკი იმავე მოთხოვნის გამეორებას მხოლოდ 7 დღის განმავლობაში ბლოკავს."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_batch_payment.py:0
msgid "Processing"
msgstr "დასამუშავებელი"

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_payment.py:0
msgid "Purpose (Nomination) is mandatory."
msgstr "დანიშნულების (Nomination) მითითება სავალდებულოა."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_payment.py:0
msgid "Purpose field exceeds 250 characters."
msgstr "დანიშნულების ველი 250 სიმბოლოს აღემატება."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_payment.py:0
msgid "Rejected"
msgstr "უარყოფილი"

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_payment.py:0
msgid "Salary transfers may only be made to individuals."
msgstr "ხელფასის გადარიცხვა მხოლოდ ფიზიკურ პირზეა შესაძლებელი."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_payment.py:0
msgid "Sender ID not found, or the sender account is invalid."
msgstr "გამგზავნის იდენტიფიკატორი ვერ მოიძებნა, ან გამგზავნის ანგარიში არასწორია."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_payment.py:0
msgid "Sign In Progress"
msgstr "ხელმოწერის პროცესში"

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_batch_payment.py:0
msgid "Sign in progress"
msgstr "დოკუმენტი ხელმოწერის პროცესშია"

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_batch_payment.py:0
#: code:addons/bog_bank/models/account_payment.py:0
msgid "Signed"
msgstr "ხელმოწერილი"

#. module: bog_bank
#: model:ir.model.fields,help:bog_bank.field_account_payment__bog_attachment_hashes
msgid "Space-separated externalFileHash values returned by BOG for the files of the last send. Every send uploads the files again."
msgstr "ბოლო გაგზავნის ფაილებისთვის ბანკის მიერ დაბრუნებული externalFileHash მნიშვნელობები, ჰარით გამოყოფილი. ყოველი გაგზავნა ფაილებს ხელახლა ტვირთავს."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_batch_payment.py:0
msgid "The Bank of Georgia package key was restored from the batch's transfers."
msgstr "საქართველოს ბანკის პაკეტის გასაღები პაკეტის გადარიცხვებიდან აღდგა."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_batch_payment.py:0
msgid "The bulk transfer is in process of signature"
msgstr "მიმდინარეობს პაკეტური გადარიცხვის ხელმოწერა"

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_payment.py:0
msgid "The document failed BOG's validations."
msgstr "დოკუმენტმა ბანკის შემოწმება ვერ გაიარა."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_payment.py:0
msgid "The document was found at Bank of Georgia, but without its document key, so the payment is left as it is. Try Recover from BOG again later."
msgstr "დოკუმენტი საქართველოს ბანკში მოიძებნა, მაგრამ დოკუმენტის გასაღების გარეშე, ამიტომ გადახდა უცვლელი დარჩა. მოგვიანებით კვლავ სცადეთ „ბანკიდან აღდგენა“."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_payment.py:0
msgid "The document's signature deadline expired."
msgstr "დოკუმენტის ხელმოწერის ვადა ამოიწურა."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_payment.py:0
msgid "The recipient account and name do not match."
msgstr "მიმღების ანგარიში და სახელი ერთმანეთს არ ემთხვევა."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_batch_payment.py:0
#: code:addons/bog_bank/models/account_payment.py:0
msgid "To be Signed"
msgstr "ხელმოსაწერი"

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_payment.py:0
msgid "Transfer purpose (Nomination) is empty."
msgstr "გადარიცხვის დანიშნულება (Nomination) შევსებული არ არის."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_payment.py:0
msgid "Treasury code not set."
msgstr "სახაზინო კოდი მითითებული არ არის."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_batch_payment.py:0
msgid "Uploading file, checking"
msgstr "მიმდინარეობს ფაილის ატვირთვა, შემოწმება"

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_payment.py:0
msgid "Value date is invalid."
msgstr "ვალუტირების თარიღი არასწორია."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_payment.py:0
msgid "Working balance is insufficient."
msgstr "სამუშაო ნაშთი არასაკმარისია."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_payment.py:0
msgid "Wrong IBAN format."
msgstr "IBAN-ის ფორმატი არასწორია."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_payment.py:0
msgid "Wrong destination."
msgstr "მიმართულება არასწორია."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_payment.py:0
msgid "You do not have permission to transfer from this account."
msgstr "ამ ანგარიშიდან გადარიცხვის უფლება არ გაქვთ."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_payment.py:0
msgid "You do not have transfer permission."
msgstr "გადარიცხვის უფლება არ გაქვთ."

#. module: bog_bank
#. odoo-python
#: code:addons/bog_bank/models/account_batch_payment.py:0
msgid "This batch is already being processed. Try again in a moment."
msgstr "ეს პაკეტი უკვე მუშავდება. სცადეთ ცოტა ხანში."
