<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_platform_order_glovo.OrderDisplay" t-inherit="point_of_sale.OrderDisplay" t-inherit-mode="extension">
        <xpath expr="//span[@t-out='this.order.platformOrderStatus']" position="after">
            <span t-if="this.order.isGlovoOrder" class="glovo-order-badge badge text-bg-warning">Glovo</span>
        </xpath>
    </t>
</templates>
