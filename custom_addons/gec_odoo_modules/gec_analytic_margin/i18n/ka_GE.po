#: model_terms:ir.ui.view,arch_db:gec_analytic_margin.res_config_settings_view_form_gec_abc
msgid "<span class=\"ms-1\">days after the month ends</span>"
msgstr "<span class=\"ms-1\">დღე თვის დასრულების შემდეგ</span>"

#. module: gec_analytic_margin
#: model_terms:ir.ui.view,arch_db:gec_analytic_margin.view_gec_allocation_run_form
msgid "<span class=\"o_stat_text\">Activity<br/>Rates</span>"
msgstr "<span class=\"o_stat_text\">აქტივობების<br/>განაკვეთები</span>"

#. module: gec_analytic_margin
#: model_terms:ir.ui.view,arch_db:gec_analytic_margin.view_gec_activity_form
msgid ""
"<strong>Press Preview Quantities before using this activity in a rule.</strong>\n"
"                        It shows what the configuration actually measures year to date, so a\n"
"                        wrong path or filter is obvious in seconds rather than after money\n"
"                        has moved. Common paths:\n"
"                        <span class=\"font-monospace\">account.analytic.line → x_planN_id</span>,\n"
"                        <span class=\"font-monospace\">project.task → project_id.account_id</span>."
msgstr ""
"<strong>ამ აქტივობის წესში გამოყენებამდე დააჭირეთ ღილაკს „რაოდენობების წინასწარი ნახვა“.</strong>\n"
"                        ის აჩვენებს, რას ზომავს კონფიგურაცია რეალურად წლის დასაწყისიდან, ამიტომ\n"
"                        არასწორი გზა ან ფილტრი წამებში გამოჩნდება და არა მაშინ, როცა თანხები\n"
"                        უკვე გადაადგილდა. ხშირად გამოყენებული გზები:\n"
"                        <span class=\"font-monospace\">account.analytic.line → x_planN_id</span>,\n"
"                        <span class=\"font-monospace\">project.task → project_id.account_id</span>."

#. module: gec_analytic_margin
#. odoo-python
#: code:addons/gec_analytic_margin/models/gec_margin_dashboard_proof.py:0
msgid "= Retained this year"
msgstr "= შენარჩუნებული ამ წელს"

#. module: gec_analytic_margin
#: model:ir.model.fields,field_description:gec_analytic_margin.field_res_company__gec_allocation_cron_basis
#: model:ir.model.fields,field_description:gec_analytic_margin.field_res_config_settings__gec_allocation_cron_basis
msgid "A Period Is Closed When"
msgstr "პერიოდი დახურულად ითვლება, როცა"

#. module: gec_analytic_margin
#. odoo-python
#: code:addons/gec_analytic_margin/models/gec_margin_component.py:0
msgid ""
"A classification rule needs a code prefix, an account type, or both — "
"otherwise it would claim every account."
msgstr ""
"კლასიფიკაციის წესს სჭირდება კოდის პრეფიქსი, ანგარიშის ტიპი ან ორივე — "
"წინააღმდეგ შემთხვევაში ის ყველა ანგარიშს მოიცავდა."

#. module: gec_analytic_margin
#: model_terms:ir.actions.act_window,help:gec_analytic_margin.action_gec_margin_component
msgid ""
"A component is a line of your P&amp;L — Revenue, Direct Cost,\n"
"                Personnel, Overhead. It decides which margin levels an account's\n"
"                amounts reach, and whether cost on it can be allocated."
msgstr ""
"კომპონენტი თქვენი მოგება-ზარალის (P&amp;L) სტრიქონია — შემოსავალი, პირდაპირი ხარჯი,\n"
"                პერსონალის ხარჯები, ზედნადები ხარჯები. ის განსაზღვრავს, მარჟის რომელ დონეებამდე აღწევს ანგარიშის\n"
"                თანხები და შეიძლება თუ არა მასზე აღრიცხული ხარჯის განაწილება."

#. module: gec_analytic_margin
#: model:ir.model.fields,help:gec_analytic_margin.field_gec_margin_row__row_type
msgid ""
"A component line carries the amounts booked on its accounts. A subtotal line"
" repeats those same amounts, once per level it belongs to — which is why the"
" two must never be summed together."
msgstr ""
"კომპონენტის სტრიქონი აჩვენებს მის ანგარიშებზე აღრიცხულ თანხებს. ქვეჯამის "
"სტრიქონი იმავე თანხებს იმეორებს — ერთხელ თითოეული დონისთვის, რომელსაც "
"ეკუთვნის. სწორედ ამიტომ ეს ორი ერთად არასოდეს უნდა შეიკრიბოს."

#. module: gec_analytic_margin
#: model:ir.model.fields,help:gec_analytic_margin.field_gec_activity_plan_wizard__overwrite
msgid ""
"A cost object that already has a plan for the target period is updated. "
"Untick to leave hand-edited plans alone."
msgstr ""
"ხარჯის ობიექტი, რომელსაც სამიზნე პერიოდისთვის უკვე აქვს გეგმა, განახლდება. "
"მოხსენით მონიშვნა, თუ ხელით შესწორებული გეგმები არ უნდა შეიცვალოს."

#. module: gec_analytic_margin
#. odoo-python
#: code:addons/gec_analytic_margin/models/gec_margin_dashboard_proof.py:0
msgid ""
"A half-time schedule counts 0.5; a starter on the 17th of a 31-day month "
"counts 15/31."
msgstr ""
"ნახევარ განაკვეთზე განრიგი ითვლება 0.5-ად; 31-დღიანი თვის 17 რიცხვში "
"მუშაობის დამწყები ითვლება 15/31-ად."

#. module: gec_analytic_margin
#. odoo-python
#: code:addons/gec_analytic_margin/models/gec_margin_dashboard_proof.py:0
msgid ""
"A line dated for the whole year counts only for the days it shares with the "
"period."
msgstr ""
"მთელი წლით დათარიღებული სტრიქონი მხოლოდ იმ დღეებით ითვლება, რომლებიც პერიოდს"
" ემთხვევა."

#. module: gec_analytic_margin
#: model:ir.model.fields,help:gec_analytic_margin.field_gec_margin_component__is_function
msgid ""
"A line of the P&L by function — Cost of Sales, R&D, Sales & Marketing, G&A. "
"Cost centres and activities name one of these, and a company reporting by "
"function reads its costs under them. No GL account is classified here "
"directly."
msgstr ""
"ფუნქციის მიხედვით მოგება-ზარალის სტრიქონი — რეალიზაციის თვითღირებულება, "
"კვლევა და განვითარება, გაყიდვები და მარკეტინგი, ზოგადი და ადმინისტრაციული. "
"ხარჯების ცენტრებსა და აქტივობებზე ერთ-ერთი მათგანია მითითებული, ხოლო "
"ფუნქციის მიხედვით ანგარიშგების მქონე კომპანია ხარჯებს მათ ქვეშ ხედავს. აქ "
"საბუღალტრო ანგარიში პირდაპირ არ კლასიფიცირდება."

#. module: gec_analytic_margin
#: model:ir.model.constraint,message:gec_analytic_margin.constraint_gec_margin_component_code_uniq
msgid "A margin component with this code already exists."
msgstr "მარჟის კომპონენტი ამ კოდით უკვე არსებობს."

#. module: gec_analytic_margin
#: model:ir.model.constraint,message:gec_analytic_margin.constraint_gec_margin_level_code_uniq
msgid "A margin level with this code already exists."
msgstr "მარჟის დონე ამ კოდით უკვე არსებობს."

#. module: gec_analytic_margin
#. odoo-python
#: code:addons/gec_analytic_margin/models/gec_margin_dashboard_delivery.py:0
msgid ""
"A milestone counts when it is marked reached; the date it was reached is "
"what is compared."
msgstr ""
"საკვანძო ეტაპი ითვლება, როცა მიღწეულად არის მონიშნული; შედარდება მიღწევის "
"თარიღი."

#. module: gec_analytic_margin
#: model:ir.model.fields,help:gec_analytic_margin.field_gec_activity__setup_warning
msgid ""
"A misconfigured activity does not fail — it measures nothing, and an "
"allocation built on it moves no money without saying so."
msgstr ""
"არასწორად კონფიგურირებული აქტივობა შეცდომას არ იძლევა — ის არაფერს ზომავს, "
"ხოლო მასზე აგებული განაწილება თანხებს არ გადაადგილებს და ამის შესახებ არც "
"გატყობინებთ."

#. module: gec_analytic_margin
#: model:ir.model.constraint,message:gec_analytic_margin.constraint_gec_forecast_snapshot_month_uniq
msgid "A month has one forecast per company."
msgstr "ერთ თვეს თითო კომპანიაზე ერთი პროგნოზი აქვს."

#. module: gec_analytic_margin
#: model:ir.model.fields.selection,name:gec_analytic_margin.selection__res_company__gec_allocation_cron_basis__delay
msgid "A number of days after the month ends"
msgstr "თვის დასრულებიდან მითითებული რაოდენობის დღის შემდეგ"

#. module: gec_analytic_margin
#. odoo-python
#: code:addons/gec_analytic_margin/models/gec_margin_dashboard_delivery.py:0
msgid ""
"A payment registered but not yet matched with the bank already counts as "
"paid."
msgstr ""
"რეგისტრირებული გადახდა, რომელიც ბანკთან ჯერ არ არის შეჯერებული, უკვე "
"გადახდილად ითვლება."

#. module: gec_analytic_margin
#. odoo-python
#: code:addons/gec_analytic_margin/models/gec_margin_dashboard_proof.py:0
msgid "A project counts as product work when its P&L Function is R&D."
msgstr ""
"პროექტი პროდუქტზე სამუშაოდ ითვლება, თუ მისი მოგება-ზარალის ფუნქციაა კვლევა "
"და განვითარება."

#. module: gec_analytic_margin
#. odoo-python
#: code:addons/gec_analytic_margin/models/gec_margin_dashboard_delivery.py:0
msgid ""
"A project not live yet counts as late from the day after its planned date "
"(today is %s)."
msgstr ""
"პროექტი, რომელიც ჯერ არ არის გაშვებული, დაგვიანებულად ითვლება დაგეგმილი "
"თარიღის მომდევნო დღიდან (დღეს არის %s)."

#. module: gec_analytic_margin
#: model:ir.model.constraint,message:gec_analytic_margin.constraint_gec_revenue_stream_code_uniq
msgid "A revenue stream with this code already exists."
msgstr "შემოსავლის ნაკადი ამ კოდით უკვე არსებობს."

#. module: gec_analytic_margin
#: model_terms:ir.actions.act_window,help:gec_analytic_margin.action_gec_allocation_rule
msgid ""
"A rule moves cost from one analytic plan onto another — typically\n"
"                personnel and overhead from the cost centre plan onto the business\n"
"                line plan — using a driver such as revenue share or headcount.\n"
"                Leave the target accounts empty and the rule keeps working when\n"
"                new analytic accounts are added."
msgstr ""
"წესი ხარჯს ერთი ანალიტიკური გეგმიდან მეორეზე გადაიტანს — ჩვეულებრივ,\n"
"                პერსონალისა და ზედნადებ ხარჯებს ხარჯების ცენტრის გეგმიდან ბიზნეს ხაზის\n"
"                გეგმაზე — ისეთი დრაივერით, როგორიცაა შემოსავლის წილი ან თანამშრომელთა რაოდენობა.\n"
"                თუ სამიზნე ანგარიშებს ცარიელს დატოვებთ, წესი მუშაობას გააგრძელებს მაშინაც, როცა\n"
"                ახალი ანალიტიკური ანგარიშები დაემატება."

#. module: gec_analytic_margin
#: model_terms:ir.actions.act_window,help:gec_analytic_margin.action_gec_allocation_run
msgid ""
"A run applies the allocation rules over a period and generates\n"
"                analytic lines: a contra line on the source account and one line\n"
"                per target. Journal entries are never modified, and deleting the\n"
"                run removes every line it created."
msgstr ""
"გაშვება განაწილების წესებს მითითებულ პერიოდზე იყენებს და ქმნის\n"
