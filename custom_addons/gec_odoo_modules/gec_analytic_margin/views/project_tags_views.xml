<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_tags_tree_view_gec_rework" model="ir.ui.view">
        <field name="name">project.tags.list.gec.rework</field>
        <field name="model">project.tags</field>
        <field name="inherit_id" ref="project.project_tags_tree_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="gec_rework" widget="boolean_toggle"/>
            </field>
        </field>
    </record>

    <record id="project_tags_form_view_gec_rework" model="ir.ui.view">
        <field name="name">project.tags.form.gec.rework</field>
        <field name="model">project.tags</field>
        <field name="inherit_id" ref="project.project_tags_form_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="gec_rework"/>
            </field>
        </field>
    </record>

</odoo>
