<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Per-plan columns are injected into every view of this model by analytic.plan.fields.mixin, usable as filters;
         the tree uses plan_id / analytic_account_id, produced by exploding those columns into rows. -->

    <record id="view_gec_margin_report_pivot" model="ir.ui.view">
        <field name="name">gec.margin.report.pivot</field>
        <field name="model">gec.margin.report</field>
        <field name="arch" type="xml">
            <pivot string="Analytic Margin" sample="1">
                <field name="direction" type="row"/>
                <field name="plan_id" type="col"/>
                <field name="amount" type="measure"/>
                <!-- Quantity and margin levels are unnamed: invisible="1" would strip them from the measures menu. -->
            </pivot>
        </field>
    </record>

    <record id="view_gec_margin_report_list" model="ir.ui.view">
        <field name="name">gec.margin.report.list</field>
        <field name="model">gec.margin.report</field>
        <field name="arch" type="xml">
            <list string="Analytic Margin" create="false" edit="false"
                  default_order="plan_sequence, date desc">
                <field name="plan_id" optional="show"/>
                <field name="analytic_account_id" optional="show"/>
                <field name="general_account_id" optional="show"/>
                <field name="move_id" optional="show"/>
                <field name="project_id" optional="show"/>
                <field name="activity_id" optional="hide"/>
                <field name="partner_id" optional="hide"/>
                <field name="date" optional="show"/>
                <field name="line_type" optional="hide"/>
                <field name="direction" optional="hide"/>
                <field name="component_id" optional="hide"/>
                <field name="is_allocation" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="revenue_amount" sum="Revenue" optional="show"/>
                <field name="expense_amount" sum="Expense" optional="show"/>
                <field name="amount" sum="Net" optional="show"/>
                <field name="unit_amount" sum="Quantity" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_gec_margin_report_graph" model="ir.ui.view">
        <field name="name">gec.margin.report.graph</field>
        <field name="model">gec.margin.report</field>
        <field name="arch" type="xml">
            <graph string="Analytic Margin" type="bar" sample="1">
                <field name="analytic_account_id"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_gec_margin_report_search" model="ir.ui.view">
        <field name="name">gec.margin.report.search</field>
        <field name="model">gec.margin.report</field>
        <field name="arch" type="xml">
            <search string="Analytic Margin">
                <field name="analytic_account_id"/>
                <field name="general_account_id"/>
                <field name="move_id"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="activity_id"/>
                <field name="plan_id"/>

                <filter name="filter_actual" string="Actual" domain="[('line_type', '=', 'actual')]"/>
                <filter name="filter_budget" string="Budget" domain="[('line_type', '=', 'budget')]"/>
                <separator/>
                <filter name="filter_revenue" string="Revenue" domain="[('direction', '=', 'revenue')]"/>
                <filter name="filter_expense" string="Expense" domain="[('direction', '=', 'expense')]"/>
                <separator/>
                <filter name="filter_primary_plan" string="Count Each Amount Once"
                        domain="[('is_primary_plan', '=', True)]"
                        help="One row per amount instead of one per analytic plan.
                              Use this whenever you need a grand total across
                              different plans."/>
                <filter name="filter_before_allocation" string="Before Allocation"
                        domain="[('is_allocation', '=', False)]"
                        help="Excludes the lines produced by allocation runs — the
                              cost centre view, before personnel and overhead are
                              pushed out."/>
                <separator/>
                <filter name="filter_date" string="Date" date="date"/>

                <group>
                    <filter name="group_plan" string="Analytic Plan" context="{'group_by': 'plan_id'}"/>
                    <filter name="group_analytic_account" string="Analytic Account"
                            context="{'group_by': 'analytic_account_id'}"/>
                    <filter name="group_general_account" string="GL Account"
                            context="{'group_by': 'general_account_id'}"/>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_activity" string="Activity" context="{'group_by': 'activity_id'}"/>
                    <filter name="group_move" string="Invoice / Bill" context="{'group_by': 'move_id'}"/>
                    <filter name="group_partner" string="Partner" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_direction" string="Revenue / Expense"
                            context="{'group_by': 'direction'}"/>
                    <filter name="group_line_type" string="Budget / Actual"
                            context="{'group_by': 'line_type'}"/>
                    <filter name="group_revenue_stream" string="Revenue Stream"
                            context="{'group_by': 'revenue_stream_id'}"/>
                    <filter name="group_component" string="Margin Component"
                            context="{'group_by': 'component_id'}"/>
                    <filter name="group_date" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gec_margin_report" model="ir.actions.act_window">
        <field name="name">Analytic Margin</field>
        <field name="res_model">gec.margin.report</field>
        <field name="view_mode">pivot,list,graph</field>
        <!-- Count Each Amount Once is deliberately not applied: with plans across the top it would empty every column
             but the first, and each column is meant to be the whole company read through one plan. -->
        <field name="context">{
            'search_default_filter_actual': 1,
            'pivot_row_groupby': ['direction'],
            'pivot_column_groupby': ['plan_id'],
            'pivot_measures': ['amount'],
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No analytic data yet</p>
            <p>
                Revenue and Expense down the side, your analytic plans across the
                top. Click a plan to open it into its own accounts, an account into
                the GL accounts behind it, and a GL account into the invoices and
                bills.
            </p>
            <p>
                <b>Each column is the whole company, read through one plan.</b> The
                same revenue appears under Project, Business Line and Product
                because it carries all three — so compare columns, never add them.
                The grand total on the right is the sum of those readings and means
                nothing.
            </p>
            <p>
                Tick <b>Count Each Amount Once</b> to make the totals add up again.
                Every amount then appears under one plan only, which is what you
                want for a company figure and not for this layout.
            </p>
        </field>
    </record>

</odoo>
