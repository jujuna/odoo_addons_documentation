<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gec_allocation_run_list" model="ir.ui.view">
        <field name="name">gec.allocation.run.list</field>
        <field name="model">gec.allocation.run</field>
        <field name="arch" type="xml">
            <list string="Allocation Runs">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="line_count" string="Lines"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="allocated_amount" sum="Allocated"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'draft'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_gec_allocation_run_form" model="ir.ui.view">
        <field name="name">gec.allocation.run.form</field>
        <field name="model">gec.allocation.run</field>
        <field name="arch" type="xml">
            <form string="Allocation Run">
                <header>
                    <button name="action_dry_run" type="object" string="Preview"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_compute" type="object" string="Generate Allocation"
                            class="btn-secondary" invisible="state != 'draft'"/>
                    <button name="action_compute" type="object" string="Recompute"
                            class="btn-secondary" invisible="state != 'done'"/>
                    <button name="action_reset" type="object" string="Delete Allocation"
                            invisible="state != 'done'"
                            confirm="This deletes every analytic line generated by this run. Continue?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_lines" type="object" class="oe_stat_button"
                                icon="view_list" invisible="state != 'done'">
                            <field name="line_count" widget="statinfo" string="Lines"/>
                        </button>
                        <button name="action_open_rates" type="object" class="oe_stat_button"
                                icon="speed" invisible="state != 'done' or not rate_ids">
                            <span class="o_stat_text">Activity<br/>Rates</span>
                        </button>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="not driver_warning">
                        <field name="driver_warning" readonly="1" nolabel="1"
                               widget="text" class="mb-0"/>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. FY2026 Q1 allocation"
                                   readonly="state != 'draft'"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <label for="date_from" string="Period"/>
                            <div class="o_row">
                                <field name="date_from" nolabel="1" class="oe_inline"
                                       readonly="state != 'draft'"/>
                                <i class="oi mx-2" data-icon="east" aria-label="to" title="to"/>
                                <field name="date_to" nolabel="1" class="oe_inline"
                                       readonly="state != 'draft'"/>
                            </div>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state != 'draft'" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="allocated_amount" invisible="state != 'done'"/>
                        </group>
                    </group>
                    <group string="Rules">
                        <field name="rule_ids" nolabel="1" widget="many2many_tags"
                               readonly="state != 'draft'"
                               placeholder="Leave empty to run every active rule"/>
                    </group>
                    <notebook invisible="state != 'done'">
                        <page string="Run Log" name="log">
                            <field name="log" readonly="1" widget="text"/>
                        </page>
                        <page string="Activity Rates" name="rates"
                              invisible="not rate_ids">
                            <field name="rate_ids" readonly="1" nolabel="1">
                                <list string="Activity Rates">
                                    <field name="activity_id"/>
                                    <field name="driver_label"/>
                                    <field name="rate" digits="[16,4]"/>
                                    <field name="quantity"/>
                                    <field name="capacity_used" widget="percentage"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="pool_amount" sum="Pool"/>
                                    <field name="charged_amount" sum="Charged"/>
                                    <field name="volume_variance" sum="Idle Capacity"/>
                                    <field name="spending_variance" sum="Rate Variance"/>
                                    <field name="variance_amount" sum="Not Charged"/>
                                </list>
                            </field>
                        </page>
                        <page string="Generated Lines" name="lines">
                            <field name="line_ids" readonly="1">
                                <list string="Generated Lines">
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="gec_allocation_kind"/>
                                    <field name="general_account_id"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="amount" sum="Total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gec_allocation_run" model="ir.actions.act_window">
        <field name="name">Cost Allocation Runs</field>
        <field name="res_model">gec.allocation.run</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Run a cost allocation</p>
            <p>
                A run applies the allocation rules over a period and generates
                analytic lines: a contra line on the source account and one line
                per target. Journal entries are never modified, and deleting the
                run removes every line it created.
            </p>
        </field>
    </record>

</odoo>
