<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gec_activity_plan_list" model="ir.ui.view">
        <field name="name">gec.activity.plan.list</field>
        <field name="model">gec.activity.plan</field>
        <field name="arch" type="xml">
            <list string="Planned vs Actual" editable="bottom"
                  decoration-danger="variance_percent > 0.2"
                  decoration-success="variance_percent &lt; -0.2">
                <field name="date_from"/>
                <field name="date_to" optional="hide"/>
                <field name="activity_id" options="{'no_create': True}"/>
                <field name="analytic_account_id" options="{'no_create': True}"/>
                <field name="driver_label" string="Unit" readonly="1"/>
                <field name="planned_quantity" sum="Planned"/>
                <field name="actual_quantity" sum="Actual"/>
                <field name="variance_quantity" sum="Variance"/>
                <field name="variance_percent" widget="percentage"/>
                <field name="has_rate" column_invisible="True"/>
                <field name="rate" digits="[16,4]" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <!-- No rate means no run has covered this period yet: "not known", not "no money at stake". -->
                <field name="variance_amount" sum="Variance Value"
                       invisible="not has_rate"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_gec_activity_plan_form" model="ir.ui.view">
        <field name="name">gec.activity.plan.form</field>
        <field name="model">gec.activity.plan</field>
        <field name="arch" type="xml">
            <form string="Planned Consumption">
                <sheet>
                    <group>
                        <group string="What and where">
                            <field name="activity_id" options="{'no_create': True}"/>
                            <field name="analytic_account_id" options="{'no_create': True}"/>
                            <label for="date_from" string="Period"/>
                            <div class="o_row">
                                <field name="date_from" nolabel="1" class="oe_inline"/>
                                <i class="oi mx-2" data-icon="east" aria-label="to" title="to"/>
                                <field name="date_to" nolabel="1" class="oe_inline"/>
                            </div>
                            <field name="currency_id" invisible="1"/>
                            <field name="has_rate" invisible="1"/>
                        </group>
                        <group string="Plan against actual">
                            <field name="planned_quantity"/>
                            <field name="actual_quantity"/>
                            <field name="variance_quantity"/>
                            <field name="variance_percent" widget="percentage"/>
                            <field name="driver_label" string="Unit"/>
                            <field name="rate" digits="[16,4]" invisible="not has_rate"/>
                            <field name="variance_amount" invisible="not has_rate"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="has_rate">
                        No run has recorded a rate covering this period, so the
                        variance cannot be valued yet. The unit variance above is
                        still real.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gec_activity_plan_pivot" model="ir.ui.view">
        <field name="name">gec.activity.plan.pivot</field>
        <field name="model">gec.activity.plan</field>
        <field name="arch" type="xml">
            <pivot string="Planned vs Actual" sample="1">
                <field name="analytic_account_id" type="row"/>
                <field name="planned_quantity" type="measure"/>
                <field name="actual_quantity" type="measure"/>
                <field name="variance_quantity" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_gec_activity_plan_graph" model="ir.ui.view">
        <field name="name">gec.activity.plan.graph</field>
        <field name="model">gec.activity.plan</field>
        <field name="arch" type="xml">
            <graph string="Planned vs Actual" type="bar" sample="1">
                <field name="analytic_account_id"/>
                <field name="planned_quantity" type="measure"/>
                <field name="actual_quantity" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_gec_activity_plan_search" model="ir.ui.view">
        <field name="name">gec.activity.plan.search</field>
        <field name="model">gec.activity.plan</field>
        <field name="arch" type="xml">
            <search string="Planned vs Actual">
                <field name="activity_id"/>
                <field name="analytic_account_id"/>
                <filter name="filter_period" string="Period" date="date_from"/>
                <separator/>
                <filter name="filter_over" string="Over Plan"
                        domain="[('variance_quantity', '>', 0)]"
                        help="Consumed more of the activity than was planned."/>
                <filter name="filter_under" string="Under Plan"
                        domain="[('variance_quantity', '&lt;', 0)]"/>
                <group>
                    <filter name="group_activity" string="Activity"
                            context="{'group_by': 'activity_id'}"/>
                    <filter name="group_account" string="Cost Object"
                            context="{'group_by': 'analytic_account_id'}"/>
                    <filter name="group_period" string="Period"
                            context="{'group_by': 'date_from'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gec_activity_plan" model="ir.actions.act_window">
        <field name="name">Planned vs Actual</field>
        <field name="res_model">gec.activity.plan</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="context">{'search_default_group_activity': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing planned yet</p>
            <p>
                Say how many driver units each project, product or customer is
                expected to consume — the hours a project was sold with, the
                tickets a contract allows for. Actuals are measured from the same
                activity that drives the allocation, so the two can never disagree.
            </p>
            <p>
                Fastest way in: open an activity and use <b>Plan from Actuals</b>
                to carry last period's measured quantities forward, with a factor.
            </p>
        </field>
    </record>

    <record id="view_gec_activity_plan_wizard_form" model="ir.ui.view">
        <field name="name">gec.activity.plan.wizard.form</field>
        <field name="model">gec.activity.plan.wizard</field>
        <field name="arch" type="xml">
            <form string="Plan from Actuals">
                <group>
                    <group string="Measure">
                        <field name="activity_id" options="{'no_create': True}"/>
                        <field name="source_date_from"/>
                        <field name="source_date_to"/>
                    </group>
                    <group string="Plan">
                        <field name="target_date_from"/>
                        <field name="target_date_to"/>
                        <field name="factor"/>
                        <field name="overwrite"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generate"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
