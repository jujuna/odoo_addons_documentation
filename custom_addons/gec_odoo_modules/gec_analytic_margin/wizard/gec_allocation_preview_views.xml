<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gec_allocation_preview_form" model="ir.ui.view">
        <field name="name">gec.allocation.preview.form</field>
        <field name="model">gec.allocation.preview</field>
        <field name="arch" type="xml">
            <form string="Dry Run">
                <div class="alert alert-warning" role="alert"
                     invisible="not driver_warning">
                    <field name="driver_warning" readonly="1" nolabel="1"
                           widget="text" class="mb-0"/>
                </div>
                <group>
                    <group>
                        <field name="run_id" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="line_count"/>
                        <field name="allocated_amount"/>
                    </group>
                </group>
                <notebook>
                    <page string="What Each Rule Would Do" name="log">
                        <field name="log" readonly="1" widget="text" nolabel="1"/>
                    </page>
                    <page string="Lines" name="lines">
                        <field name="line_ids" readonly="1" nolabel="1">
                            <list string="Lines" create="false" edit="false">
                                <field name="date"/>
                                <field name="analytic_label"/>
                                <field name="name"/>
                                <field name="general_account_id"/>
                                <field name="kind"/>
                                <field name="currency_id" column_invisible="True"/>
                                <field name="amount" sum="Total"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_confirm" type="object" string="Generate It"
                            class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
