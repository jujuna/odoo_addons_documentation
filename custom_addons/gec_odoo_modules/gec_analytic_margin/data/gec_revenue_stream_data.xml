<?xml version="1.0" encoding="utf-8"?>
<!-- noupdate: a company renames or retires these, and an upgrade must not undo that. -->
<odoo noupdate="1">

    <record id="revenue_stream_license" model="gec.revenue.stream">
        <field name="name">Licenses</field>
        <field name="code">license</field>
        <field name="sequence">10</field>
        <field name="standard_product" eval="True"/>
    </record>

    <record id="revenue_stream_maintenance" model="gec.revenue.stream">
        <field name="name">Maintenance &amp; Support</field>
        <field name="code">maintenance</field>
        <field name="sequence">20</field>
        <field name="recurring" eval="True"/>
        <field name="standard_product" eval="True"/>
    </record>

    <record id="revenue_stream_subscription" model="gec.revenue.stream">
        <field name="name">Subscriptions</field>
        <field name="code">subscription</field>
        <field name="sequence">30</field>
        <field name="recurring" eval="True"/>
        <field name="standard_product" eval="True"/>
    </record>

    <record id="revenue_stream_services" model="gec.revenue.stream">
        <field name="name">Professional Services</field>
        <field name="code">services</field>
        <field name="sequence">40</field>
    </record>

</odoo>
