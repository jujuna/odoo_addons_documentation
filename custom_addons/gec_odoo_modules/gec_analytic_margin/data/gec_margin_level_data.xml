<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The default margin ladder: each level is a real report column, created and dropped with the record.
              Finance Costs, Income Tax, Other Income and Excluded are in no level on purpose (IAS 1.82). -->

    <record id="level_contribution" model="gec.margin.level">
        <field name="name">Contribution Margin</field>
        <field name="code">contribution</field>
        <field name="sequence">10</field>
        <field name="component_ids" eval="[(6, 0, [
            ref('component_revenue'),
            ref('component_direct_cost'),
        ])]"/>
    </record>

    <record id="level_gross" model="gec.margin.level">
        <field name="name">Gross Margin</field>
        <field name="code">gross</field>
        <field name="sequence">20</field>
        <field name="component_ids" eval="[(6, 0, [
            ref('component_revenue'),
            ref('component_direct_cost'),
            ref('component_personnel'),
            ref('component_function_cogs'),
        ])]"/>
    </record>

    <record id="level_ebitda" model="gec.margin.level">
        <field name="name">EBITDA</field>
        <field name="code">ebitda</field>
        <field name="sequence">30</field>
        <field name="component_ids" eval="[(6, 0, [
            ref('component_revenue'),
            ref('component_direct_cost'),
            ref('component_personnel'),
            ref('component_overhead'),
            ref('component_function_cogs'),
            ref('component_function_rnd'),
            ref('component_function_sm'),
            ref('component_function_ga'),
        ])]"/>
    </record>

    <record id="level_ebit" model="gec.margin.level">
        <field name="name">EBIT</field>
        <field name="code">ebit</field>
        <field name="sequence">40</field>
        <field name="component_ids" eval="[(6, 0, [
            ref('component_revenue'),
            ref('component_direct_cost'),
            ref('component_personnel'),
            ref('component_overhead'),
            ref('component_function_cogs'),
            ref('component_function_rnd'),
            ref('component_function_sm'),
            ref('component_function_ga'),
            ref('component_depreciation'),
        ])]"/>
    </record>
</odoo>
