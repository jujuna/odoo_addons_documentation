<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_rs_spec_second_unit" model="ir.ui.view">
        <field name="name">purchase.order.form.rs.spec.second.unit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='uom_id']" position="after">
                <field name="rs_spec_alt_qty" optional="hide"/>
                <field name="rs_spec_alt_uom_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_rs_spec_second_unit" model="ir.ui.view">
        <field name="name">sale.order.form.rs.spec.second.unit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/column[@name='sol_uom']" position="after">
                <field name="rs_spec_alt_qty" optional="hide"/>
                <field name="rs_spec_alt_uom_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_form_rs_spec_second_unit" model="ir.ui.view">
        <field name="name">stock.picking.form.rs.spec.second.unit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']/list/field[@name='uom_id']" position="after">
                <field name="rs_spec_alt_qty" optional="hide"/>
                <field name="rs_spec_alt_uom_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_move_line_detailed_operation_tree_rs_spec_second_unit" model="ir.ui.view">
        <field name="name">stock.move.line.operations.list.rs.spec.second.unit</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='uom_id']" position="after">
                <field name="rs_spec_alt_qty" optional="hide"/>
                <field name="rs_spec_alt_uom_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_line_tree_rs_spec_second_unit" model="ir.ui.view">
        <field name="name">stock.move.line.list.rs.spec.second.unit</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='uom_id']" position="after">
                <field name="rs_spec_alt_qty" optional="hide"/>
                <field name="rs_spec_alt_uom_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_tree_rs_spec_second_unit" model="ir.ui.view">
        <field name="name">stock.move.list.rs.spec.second.unit</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='uom_id']" position="after">
                <field name="rs_spec_alt_qty" sum="Total Alt. Quantity" optional="hide"/>
                <field name="rs_spec_alt_uom_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
