<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payslip_form_gec_payroll_bank" model="ir.ui.view">
        <field name="name">hr.payslip.form.gec.payroll.bank</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <button name="action_payslip_payment_report" position="before">
                <button name="action_gec_pay_salaries" type="object"
                        string="Pay Salaries" class="oe_highlight"
                        groups="hr_payroll.group_hr_payroll_manager"
                        invisible="state != 'validated'"/>
            </button>
            <button name="action_payslip_payment_report" position="attributes">
                <attribute name="class" remove="oe_highlight" separator=" "/>
            </button>
        </field>
    </record>

    <record id="action_server_gec_pay_salaries" model="ir.actions.server">
        <field name="name">Pay Salaries</field>
        <field name="model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_gec_pay_salaries()</field>
        <field name="group_ids" eval="[(4, ref('hr_payroll.group_hr_payroll_manager'))]"/>
    </record>
</odoo>
