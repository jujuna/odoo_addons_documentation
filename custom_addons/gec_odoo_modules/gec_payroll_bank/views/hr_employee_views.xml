<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_gec_payroll_bank" model="ir.ui.view">
        <field name="name">hr.employee.form.gec.payroll.bank</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <field name="private_phone" position="after">
                <field name="gec_payroll_channel_id" options="{'no_create': True}"
                       groups="hr_payroll.group_hr_payroll_manager"/>
            </field>
        </field>
    </record>

    <record id="view_employee_list_gec_payroll_bank" model="ir.ui.view">
        <field name="name">hr.employee.list.gec.payroll.bank</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <list position="inside">
                <field name="gec_payroll_channel_id" optional="hide"
                       options="{'no_create': True}"
                       groups="hr_payroll.group_hr_payroll_manager"/>
            </list>
        </field>
    </record>
</odoo>
