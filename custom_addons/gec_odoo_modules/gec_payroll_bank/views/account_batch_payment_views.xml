<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_batch_payment_form_gec_payroll_bank" model="ir.ui.view">
        <field name="name">account.batch.payment.form.gec.payroll.bank</field>
        <field name="model">account.batch.payment</field>
        <field name="inherit_id" ref="account_batch_payment.view_batch_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Payroll" invisible="not gec_payroll_is_batch">
                    <group>
                        <field name="gec_payroll_is_batch" invisible="1"/>
                        <field name="gec_payroll_kind" readonly="1"/>
                        <field name="gec_payroll_channel_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="payslip_run_id" readonly="1"
                               groups="hr_payroll.group_hr_payroll_user"/>
                        <field name="gec_payroll_manual_ack" readonly="1"
                               invisible="not gec_payroll_manual_ack"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_batch_payment_list_gec_payroll_bank" model="ir.ui.view">
        <field name="name">account.batch.payment.list.gec.payroll.bank</field>
        <field name="model">account.batch.payment</field>
        <field name="inherit_id" ref="account_batch_payment.view_batch_payment_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="gec_payroll_kind" optional="hide"/>
                <field name="payslip_run_id" optional="hide"
                       groups="hr_payroll.group_hr_payroll_user"/>
            </field>
        </field>
    </record>
</odoo>
