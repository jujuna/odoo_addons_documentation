<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payslip_run_view_kanban_gec_payroll_bank" model="ir.ui.view">
        <field name="name">hr.payslip.run.kanban.gec.payroll.bank</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payrun_payslip_kanban_card_view"/>
        <field name="arch" type="xml">
            <button name="action_payment_report" position="before">
                <field name="gec_payroll_can_pay" invisible="1"
                       groups="hr_payroll.group_hr_payroll_manager"/>
                <field name="gec_payroll_batch_count" invisible="1"
                       groups="hr_payroll.group_hr_payroll_manager"/>
                <button name="action_gec_pay_salaries" type="object"
                        class="btn btn-primary" string="Pay Salaries"
                        groups="hr_payroll.group_hr_payroll_manager"
                        invisible="not gec_payroll_can_pay"/>
                <button name="action_gec_payroll_view_batches" type="object"
                        class="btn btn-secondary" string="Payment Batches"
                        groups="hr_payroll.group_hr_payroll_manager"
                        invisible="gec_payroll_batch_count == 0"/>
            </button>
        </field>
    </record>
</odoo>
