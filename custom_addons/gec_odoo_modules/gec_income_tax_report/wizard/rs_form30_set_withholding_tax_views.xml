<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rs_form30_set_withholding_tax_form" model="ir.ui.view">
        <field name="name">rs.form30.set.withholding.tax.form</field>
        <field name="model">rs.form30.set.withholding.tax</field>
        <field name="arch" type="xml">
            <form string="Set Withholding Tax">
                <field name="company_id" invisible="1"/>
                <group>
                    <field name="move_id" readonly="1" force_save="1"/>
                    <field name="tax_id" options="{'no_create': True}"/>
                </group>
                <field name="line_ids" options="{'no_create': True}">
                    <list>
                        <field name="name"/>
                        <field name="account_id"/>
                        <field name="partner_id"/>
                        <field name="balance"/>
                        <field name="tax_ids" widget="many2many_tags"/>
                    </list>
                </field>
                <footer>
                    <button name="action_apply" type="object" string="Set Withholding Tax" class="btn-primary"
                            confirm="The entry is reset to draft and posted again. Continue?"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
