<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rs_form30_tax_change_form" model="ir.ui.view">
        <field name="name">rs.form30.tax.change.form</field>
        <field name="model">rs.form30.tax.change</field>
        <field name="arch" type="xml">
            <form string="Apply Tax / RS Change">
                <group>
                    <field name="tax_id"/>
                    <field name="income_type_id"/>
                    <field name="change_kind"/>
                    <field name="effective_date"/>
                    <field name="rule_action" invisible="change_kind != 'rules'"/>
                    <field name="old_rate" invisible="change_kind == 'tax' or rule_action == 'allow'" readonly="change_kind == 'both'"/>
                    <field name="new_rate" invisible="change_kind == 'rules' and rule_action == 'stop'"/>
                    <field name="category_ids" widget="many2many_tags" options="{'no_create': True}"
                           invisible="change_kind == 'tax'" required="change_kind != 'tax'"/>
                    <field name="new_tax_name" invisible="change_kind == 'rules'" required="change_kind != 'rules'"/>
                </group>
                <group string="Review the change">
                    <field name="preview" nolabel="1"/>
                    <field name="affected_tax_ids" string="Taxes sharing this income type (accessible companies)"
                           widget="many2many_tags" invisible="change_kind == 'tax'"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply Change" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
