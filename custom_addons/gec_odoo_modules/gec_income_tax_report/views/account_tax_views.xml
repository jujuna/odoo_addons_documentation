<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tax_form_rs_form30" model="ir.ui.view">
        <field name="name">account.tax.form.rs.form30</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="gec_localization.view_tax_form_ge_withholding"/>
        <field name="arch" type="xml">
            <field name="gec_is_withholding" position="after">
                <field name="rs_form30_income_type_id" invisible="not gec_is_withholding"/>
            </field>
            <xpath expr="//notebook" position="inside">
                <page name="rs_form30_rules" string="RS Declaration Rules" invisible="not gec_is_withholding">
                    <group>
                        <field name="rs_form30_income_type_id" options="{'no_create': True}"/>
                        <field name="rs_form30_service_type_id" options="{'no_create': True}"/>
                        <field name="rs_form30_annex_e" invisible="amount != 0"/>
                        <field name="rs_form30_previous_tax_id" readonly="1" invisible="not rs_form30_previous_tax_id"/>
                        <field name="rs_form30_date_from" readonly="1"/>
                        <field name="rs_form30_date_to" readonly="1"/>
                    </group>
                    <div class="alert alert-info" role="status">
                        RS rules below are shared by all companies and taxes with this income type.
                        Editing the normal tax percentage does not change the allowed RS rates.
                        Use Apply Tax / RS Change to preserve previous periods when legislation changes.
                    </div>
                    <button name="action_rs_form30_change" type="object" string="Apply Tax / RS Change"
                            class="btn-primary mb-3" groups="account.group_account_manager"
                            invisible="not rs_form30_income_type_id"/>
                    <field name="rs_form30_rule_ids" nolabel="1" groups="account.group_account_manager"
                           invisible="not rs_form30_income_type_id"
                           context="{'default_income_type_id': rs_form30_income_type_id}">
                        <list editable="bottom" delete="0">
                            <field name="category_id" options="{'no_create': True}"/>
                            <field name="rate"/>
                            <field name="valid_from"/>
                            <field name="valid_to"/>
                            <field name="note" optional="show"/>
                        </list>
                    </field>
                    <field name="rs_form30_rule_ids" nolabel="1" readonly="1" groups="!account.group_account_manager"
                           invisible="not rs_form30_income_type_id">
                        <list create="0" edit="0" delete="0">
                            <field name="category_id"/><field name="rate"/>
                            <field name="valid_from"/><field name="valid_to"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_rs_form30_withholding_tax" model="ir.actions.act_window">
        <field name="name">Withholding Taxes</field>
        <field name="res_model">account.tax</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('rs_form30_income_type_id', '!=', False)]</field>
    </record>
</odoo>
