<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rs_form30_category_list" model="ir.ui.view">
        <field name="name">rs.form30.category.list</field>
        <field name="model">rs.form30.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="display_code"/>
                <field name="name"/>
                <field name="use_salary" optional="show"/>
                <field name="use_entry" optional="show"/>
                <field name="use_bill" optional="show"/>
                <field name="usage_note" optional="show"/>
                <field name="valid_from" optional="hide"/>
                <field name="valid_to" optional="hide"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_rs_form30_category" model="ir.actions.act_window">
        <field name="name">Recipient Categories</field>
        <field name="res_model">rs.form30.category</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_rs_form30_income_type_list" model="ir.ui.view">
        <field name="name">rs.form30.income.type.list</field>
        <field name="model">rs.form30.income.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="valid_from" optional="show"/>
                <field name="valid_to" optional="show"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_rs_form30_income_type" model="ir.actions.act_window">
        <field name="name">Income Types</field>
        <field name="res_model">rs.form30.income.type</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_rs_form30_rate_rule_list" model="ir.ui.view">
        <field name="name">rs.form30.rate.rule.list</field>
        <field name="model">rs.form30.rate.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="category_id"/>
                <field name="income_type_id"/>
                <field name="rate"/>
                <field name="valid_from"/>
                <field name="valid_to"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_rs_form30_rate_rule_search" model="ir.ui.view">
        <field name="name">rs.form30.rate.rule.search</field>
        <field name="model">rs.form30.rate.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="category_id"/>
                <field name="income_type_id"/>
                <group name="group_by">
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_income_type" string="Income Type" context="{'group_by': 'income_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rs_form30_rate_rule" model="ir.actions.act_window">
        <field name="name">Allowed Rates</field>
        <field name="res_model">rs.form30.rate.rule</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
