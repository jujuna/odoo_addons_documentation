<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_rs_form30" model="ir.ui.view">
        <field name="name">res.config.settings.form.rs.form30</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='default_taxes_setting_container']" position="after">
                <block title="Form 30" name="rs_form30_setting_container" groups="account.group_account_manager">
                    <setting id="rs_form30_pension_accounts" company_dependent="1"
                             string="Pension Liability Accounts"
                             help="Accounts that hold the 2% pension withheld from the recipient on a journal entry">
                        <field name="rs_form30_pension_account_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </setting>
                    <setting id="rs_form30_employer_pension_accounts" company_dependent="1"
                             string="Employer Pension Expense Accounts"
                             help="Accounts that hold the pension the employer pays on top of the recipient's gross">
                        <field name="rs_form30_employer_pension_account_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
