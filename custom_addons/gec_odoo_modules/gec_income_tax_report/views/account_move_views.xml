<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_rs_form30" model="ir.ui.view">
        <field name="name">account.move.form.rs.form30</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_draft']" position="after">
                <field name="rs_form30_can_set_withholding" invisible="1"/>
                <button name="action_rs_form30_set_withholding_tax" type="object" string="Set Withholding Tax"
                        invisible="not rs_form30_can_set_withholding"
                        groups="account.group_account_user"/>
                <button name="action_rs_form30_detect_withholding_tax" type="object" string="Detect Again"
                        confirm="The entry is reset to draft and posted again. Continue?"
                        invisible="not rs_form30_can_set_withholding"
                        groups="account.group_account_user"/>
            </xpath>
        </field>
    </record>
</odoo>
