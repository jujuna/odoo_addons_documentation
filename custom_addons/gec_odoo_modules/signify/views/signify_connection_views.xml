<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="signify_connection_view_list" model="ir.ui.view">
        <field name="name">signify.connection.list</field>
        <field name="model">signify.connection</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <header>
                    <button name="action_connect" type="object" string="Connect Signify Account" display="always" class="oe_highlight"/>
                </header>
                <field name="user_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="email"/>
                <field name="connected" widget="boolean"/>
                <button name="action_disconnect" type="object" string="Disconnect" invisible="not connected"/>
            </list>
        </field>
    </record>

    <record id="signify_connection_view_search" model="ir.ui.view">
        <field name="name">signify.connection.search</field>
        <field name="model">signify.connection</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="email"/>
                <filter name="my" string="My Accounts" domain="[('user_id', '=', uid)]"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_signify_connection" model="ir.actions.act_window">
        <field name="name">Signify Accounts</field>
        <field name="res_model">signify.connection</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_my': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Connect your Signify account to send documents for signature</p>
            <p>Press Connect Signify Account. The account is connected for the company chosen at the top right.</p>
        </field>
    </record>
</odoo>
