<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rs_form15_declaration_list" model="ir.ui.view">
        <field name="name">rs.form15.declaration.list</field>
        <field name="model">rs.form15.declaration</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_from"/>
                <field name="land_reference_date" optional="show"/>
                <field name="kind"/>
                <field name="part3_count" string="Property Rows"/>
                <field name="part3_total" sum="Property Tax"/>
                <field name="part4_count" string="Land Rows"/>
                <field name="part4_total" sum="Land Tax"/>
                <field name="warning_count" string="Warnings" decoration-warning="warning_count &gt; 0"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge" decoration-success="state == 'exported'"/>
            </list>
        </field>
    </record>

    <record id="view_rs_form15_declaration_form" model="ir.ui.view">
        <field name="name">rs.form15.declaration.form</field>
        <field name="model">rs.form15.declaration</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate" type="object" groups="account.group_account_user" string="Generate"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_generate_part3" type="object" groups="account.group_account_user" string="Generate Part III"
                            invisible="state != 'draft'"/>
                    <button name="action_generate_part4" type="object" groups="account.group_account_user" string="Generate Part IV"
                            invisible="state != 'draft'"/>
                    <button name="action_export" type="object" groups="account.group_account_user" string="Export"
                            invisible="state != 'draft' or (not part4_line_ids and not part3_line_ids)"/>
                    <button name="action_draft" type="object" groups="account.group_account_user" string="Reset to Draft"
                            invisible="state != 'exported'"/>
                    <button name="action_export_explanation" type="object"
                            string="Explanation Workbook"
                            invisible="not part3_line_ids and not part4_line_ids"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="1"/>
                            <field name="land_reference_date" readonly="state != 'draft'"/>
                            <field name="kind" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="part4_line_ids or part3_line_ids"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="months_of_existence" readonly="state != 'draft'"/>
                            <field name="part3_total"/>
                            <field name="part4_total"/>
                            <field name="next_advance_amount" invisible="not part3_line_ids"/>
                            <field name="next_advance_date" invisible="not part3_line_ids"/>
                            <field name="warning_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Part III — Property" name="part3">
                            <field name="part3_line_ids" widget="rs_form15_part3_grid"
                                   readonly="state != 'draft'" nolabel="1">
                                <list editable="bottom" limit="1000">
                                    <field name="property_type_id" options="{'no_create': True}"/>
                                    <field name="asset_id" string="Name" options="{'no_create': True, 'no_open': True}"
                                           invisible="not has_name or asset_group_id"
                                           domain="[('company_id', '=', company_id), ('rs_form15_property_type_id', '=', property_type_id), ('asset_group_id', '=', False)]"/>
                                    <field name="asset_group_id" column_invisible="True"/>
                                    <field name="name" column_invisible="True"/>
                                    <field name="territory_id" options="{'no_create': True}"/>
                                    <field name="acquisition_year_id" options="{'no_create': True}"/>
                                    <field name="average_value"/>
                                    <field name="revaluation_coefficient_id" options="{'no_create': True}"/>
                                    <field name="exemption_amount" readonly="not exemption_basis_id" force_save="1"/>
                                    <field name="exemption_basis_id" options="{'no_create': True}"
                                           domain="['|', ('valid_from', '=', False), ('valid_from', '&lt;=', tax_year), '|', ('valid_to', '=', False), ('valid_to', '&gt;=', tax_year)]"
                                           placeholder="შეღავათით არ ვსარგებლობ"/>
                                    <field name="tax_rate" widget="rs_form15_rate"/>
                                    <field name="tax_amount"/>
                                    <field name="advance_amount"/>
                                    <field name="difference"/>
                                    <field name="months_of_existence"/>
                                    <field name="prorated_amount"/>
                                    <field name="is_immovable" column_invisible="True"/>
                                    <field name="has_name" column_invisible="True"/>
                                    <field name="company_id" column_invisible="True"/>
                                    <field name="tax_year" column_invisible="True"/>
                                    <field name="source" column_invisible="True"/>
                                    <field name="warning" column_invisible="True"/>
                                    <field name="asset_ids" column_invisible="True"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Part IV — Land" name="part4">
                            <field name="part4_line_ids" widget="rs_form15_part4_grid"
                                   readonly="state != 'draft'" nolabel="1">
                                <list editable="bottom" limit="1000">
                                    <field name="land_type_id" options="{'no_create': True}"/>
                                    <field name="land_territory_id" widget="rs_form15_land_territory" options="{'no_create': True}"/>
                                    <field name="area"/>
                                    <field name="taxable_area"/>
                                    <field name="exemption_basis_id" options="{'no_create': True}"
                                           domain="['|', ('valid_from', '=', False), ('valid_from', '&lt;=', land_year), '|', ('valid_to', '=', False), ('valid_to', '&gt;=', land_year)]"
                                           placeholder="შეღავათით არ ვსარგებლობ"/>
                                    <field name="rate"/>
                                    <field name="tax_amount"/>
                                    <field name="source" column_invisible="True"/>
                                    <field name="plot_id" column_invisible="True"/>
                                    <field name="land_year" column_invisible="True"/>
                                    <field name="base_rate" column_invisible="True"/>
                                    <field name="warning" column_invisible="True"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Files" name="files"
                              invisible="not export_file_3 and not export_file_4 and not explanation_file">
                            <group>
                                <field name="export_file_3" filename="export_filename_3"
                                       invisible="not export_file_3"/>
                                <field name="export_filename_3" invisible="1"/>
                                <field name="export_file_4" filename="export_filename_4"
                                       invisible="not export_file_4"/>
                                <field name="export_filename_4" invisible="1"/>
                                <field name="explanation_file" filename="explanation_filename"
                                       invisible="not explanation_file"/>
                                <field name="explanation_filename" invisible="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rs_form15_declaration_search" model="ir.ui.view">
        <field name="name">rs.form15.declaration.search</field>
        <field name="model">rs.form15.declaration</field>
        <field name="arch" type="xml">
            <search>
                <field name="date_from"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="warnings" string="With Warnings" domain="[('warning_count', '&gt;', 0)]"/>
                <filter name="group_year" string="Year" context="{'group_by': 'date_from:year'}"/>
            </search>
        </field>
    </record>

    <record id="action_rs_form15_declaration" model="ir.actions.act_window">
        <field name="name">Property Tax Declaration (Form V-01)</field>
        <field name="res_model">rs.form15.declaration</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
