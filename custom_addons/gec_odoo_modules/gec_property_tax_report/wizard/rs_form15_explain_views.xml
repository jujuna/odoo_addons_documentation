<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="row_explanation">
        <div class="o_rsf15_explain">
            <h4 t-out="title"/>
            <p class="text-muted"><i class="oi me-1" data-icon="calculate"/><t t-out="formula"/></p>

            <div t-if="warning" class="alert alert-warning py-2">
                <i class="oi me-1" data-icon="warning"/><t t-out="warning"/>
            </div>

            <table class="table table-sm o_rsf15_explain_table">
                <thead>
                    <tr>
                        <th style="width: 4rem;">Col.</th>
                        <th>What</th>
                        <th class="text-end" style="width: 9rem;">Value</th>
                        <th>How</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="steps" t-as="step" t-key="step_index"
                        t-att-class="step.get('total') and 'table-active fw-bold'">
                        <td t-out="step['code']"/>
                        <td t-out="step['label']"/>
                        <td class="text-end font-monospace" t-out="step['value']"/>
                        <td class="text-muted small" t-out="step['detail']"/>
                    </tr>
                </tbody>
            </table>

            <t t-if="sources">
                <h5 class="mt-3">Where column 6 comes from</h5>
                <table t-if="part == 'part3'" class="table table-sm o_rsf15_explain_table">
                    <thead>
                        <tr>
                            <th>Asset</th>
                            <th class="text-end">1 January</th>
                            <th class="text-end">31 December</th>
                            <th class="text-end">Average</th>
                            <th class="text-end">Exemption</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="sources" t-as="source" t-key="source_index">
                            <td>
                                <a t-att-href="'/odoo/account.asset/%s' % source['res_id']"
                                   target="_blank" t-out="source['name']"/>
                            </td>
                            <td class="text-end font-monospace" t-out="source['opening']"/>
                            <td class="text-end font-monospace" t-out="source['closing']"/>
                            <td class="text-end font-monospace" t-out="source['average']"/>
                            <td class="text-end font-monospace" t-out="source['exemption']"/>
                        </tr>
                    </tbody>
                </table>
                <ul t-else="" class="list-unstyled">
                    <li t-foreach="sources" t-as="source" t-key="source_index">
                        <a t-att-href="'/odoo/%s/%s' % (source['model'], source['res_id'])"
                           target="_blank" t-out="source['name']"/>
                    </li>
                </ul>
            </t>
        </div>
    </template>

    <record id="view_rs_form15_explain_form" model="ir.ui.view">
        <field name="name">rs.form15.explain.form</field>
        <field name="model">rs.form15.explain</field>
        <field name="arch" type="xml">
            <form>
                <field name="declaration_id" invisible="1"/>
                <field name="line_part" invisible="1"/>
                <field name="line_ref" invisible="1"/>
                <field name="content" nolabel="1" readonly="1"/>
                <footer>
                    <button string="Close" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
