#. module: gec_property_tax_report
#: model:ir.module.module,description:base.module_gec_property_tax_report
msgid ""
"\n"
"Builds parts III (property other than land) and IV (land) of the annual enterprise property tax\n"
"declaration, annex V-01, from fixed assets and a land plot register, validates them against the\n"
"rs.ge classifiers and exports the SpreadsheetML files the portal imports.\n"
msgstr ""
"\n"
"აგებს საწარმოს ქონების გადასახადის წლიური დეკლარაციის (დანართი V-01) III ნაწილს (ქონება, გარდა მიწისა)\n"
"და IV ნაწილს (მიწა) ძირითადი საშუალებებისა და მიწის ნაკვეთების რეესტრიდან, ამოწმებს მათ rs.ge-ის\n"
"კლასიფიკატორებთან და ქმნის პორტალზე ასატვირთ SpreadsheetML ფაილებს.\n"

#. module: gec_property_tax_report
#. odoo-python
#: code:addons/gec_property_tax_report/models/rs_form15_declaration.py:0
msgid "%(area)s x %(unit)s = %(tax)s"
msgstr "%(area)s x %(unit)s = %(tax)s"

#. module: gec_property_tax_report
#. odoo-python
#: code:addons/gec_property_tax_report/models/rs_form15_declaration.py:0
msgid "%(chargeable)s - %(advance)s = %(difference)s"
msgstr "%(chargeable)s - %(advance)s = %(difference)s"

#. module: gec_property_tax_report
#. odoo-python
#: code:addons/gec_property_tax_report/models/rs_form15_declaration.py:0
msgid "%(label)s: %(name)s is not valid in %(year)s"
msgstr "%(label)s: %(name)s არ მოქმედებს %(year)s წელს"

#. module: gec_property_tax_report
#. odoo-python
#: code:addons/gec_property_tax_report/models/rs_form15_declaration.py:0
msgid "%(label)s: rate %(got)s does not match the rs.ge table value %(want)s"
msgstr ""
"%(label)s: განაკვეთი %(got)s არ ემთხვევა rs.ge-ის ცხრილის მნიშვნელობას "
"%(want)s"

#. module: gec_property_tax_report
#. odoo-python
#: code:addons/gec_property_tax_report/models/rs_form15_declaration.py:0
msgid "%(name)s: the rate must be between 0 and %(cap)s percent."
msgstr "%(name)s: განაკვეთი უნდა იყოს 0-დან %(cap)s პროცენტამდე."

#. module: gec_property_tax_report
#. odoo-python
#: code:addons/gec_property_tax_report/models/rs_form15_declaration.py:0
msgid "%(tax)s / 12 x %(months)s = %(prorated)s"
msgstr "%(tax)s / 12 x %(months)s = %(prorated)s"

#. module: gec_property_tax_report
#. odoo-python
#: code:addons/gec_property_tax_report/models/rs_form15_land_plot.py:0
msgid "%s cannot be sold before it was acquired."
msgstr "%s: გასხვისების თარიღი შეძენის თარიღზე ადრე ვერ იქნება."

#. module: gec_property_tax_report
#. odoo-python
#: code:addons/gec_property_tax_report/models/account_asset.py:0
msgid ""
"%(asset)s is attached to the land plot %(plot)s. Land is not depreciated, so "
"this asset must keep a \"No depreciation\" model.\n"
"\n"
"To depreciate it, create a new asset, or first detach this asset from the "
"land plot (Accounting > Configuration > Land Plots, clear its Asset)."
msgstr ""
"%(asset)s მიბმულია მიწის ნაკვეთზე %(plot)s. მიწას ცვეთა არ ერიცხება, ამიტომ "
"ამ აქტივს უნდა ჰქონდეს ცვეთის მოდელი „ცვეთის გარეშე“.\n"
"\n"
"ცვეთის დასარიცხად შექმენით ახალი აქტივი ან ჯერ გააუქმეთ ამ აქტივის კავშირი "
"მიწის ნაკვეთთან (ბუღალტერია > კონფიგურაცია > მიწის ნაკვეთები, გაასუფთავეთ "
"ველი „აქტივი“)."

#. module: gec_property_tax_report
#. odoo-python
#: code:addons/gec_property_tax_report/models/rs_form15_land_plot.py:0
msgid ""
"%s has a taxable area but no exemption basis. The portal fills column 5 only"
" when an exemption applies."
msgstr ""
"%s: დასაბეგრი ფართობი შევსებულია, მაგრამ შეღავათის საფუძველი მითითებული არ "
"არის. პორტალი მე-5 სვეტს მხოლოდ შეღავათის შემთხვევაში ავსებს."

#. module: gec_property_tax_report
#. odoo-python
#: code:addons/gec_property_tax_report/models/rs_form15_declaration.py:0
msgid "%s is declared twice in this declaration."
msgstr "%s ამ დეკლარაციაში ორჯერ არის დეკლარირებული."

#. module: gec_property_tax_report
#. odoo-python
#: code:addons/gec_property_tax_report/models/rs_form15_declaration.py:0
msgid ""
"%s is movable property: the acquisition year and the revaluation coefficient"
" must stay empty (columns 5 and 7)."
msgstr ""
"%s მოძრავი ქონებაა: მიღების წელი და აფასების კოეფიციენტი ცარიელი უნდა დარჩეს"
" (მე-5 და მე-7 სვეტები)."

#. module: gec_property_tax_report
#. odoo-python
#: code:addons/gec_property_tax_report/models/rs_form15_declaration.py:0
msgid ""
"%s is not a named type: it is declared per territorial unit, without an "
"asset."
msgstr ""
"%s დასახელებული სახეობა არ არის: ის ტერიტორიული ერთეულის მიხედვით, აქტივის "
"მითითების გარეშე დეკლარირდება."

#. module: gec_property_tax_report
#. odoo-python
#: code:addons/gec_property_tax_report/models/rs_form15_declaration.py:0
msgid "%s: a named type needs the object's name (column 2)"
msgstr "%s: დასახელებულ სახეობას ობიექტის დასახელება სჭირდება (მე-2 სვეტი)"

#. module: gec_property_tax_report
#. odoo-python
#: code:addons/gec_property_tax_report/models/rs_form15_declaration.py:0
msgid "%s: an exemption amount needs an exemption basis (column 9)"
msgstr "%s: შეღავათის თანხას შეღავათის საფუძველი სჭირდება (მე-9 სვეტი)"

#. module: gec_property_tax_report
#. odoo-python
#: code:addons/gec_property_tax_report/models/rs_form15_declaration.py:0
msgid "%s: column 5 is filled but no exemption basis is set"
msgstr ""
"%s: მე-5 სვეტი შევსებულია, მაგრამ შეღავათის საფუძველი მითითებული არ არის"

#. module: gec_property_tax_report
#. odoo-python
#: code:addons/gec_property_tax_report/models/rs_form15_declaration.py:0
