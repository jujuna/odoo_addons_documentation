#: code:addons/gec_vat_declaration/models/gec_vat_declaration.py:0
msgid ""
"%(tab)s: correction %(name)s is posted but not accepted on rs.ge yet, and "
"%(original)s still counts in Odoo: Odoo's VAT holds both until it is "
"accepted."
msgstr ""
"%(tab)s: კორექტირება %(name)s გატარებულია, მაგრამ rs.ge-ზე ჯერ არ არის "
"დადასტურებული, %(original)s კი Odoo-ში ისევ ითვლება: დადასტურებამდე "
"Odoo-ს დღგ ორივეს ითვლის."

#. module: gec_vat_declaration
#. odoo-python
#: code:addons/gec_vat_declaration/models/gec_vat_declaration.py:0
msgid ""
"%(tab)s: correction %(name)s is dated %(month)s and the reversal of "
"%(original)s %(reversal_month)s, so %(row)s row 1 of both months differs "
"from rs.ge, which counts only the change."
msgstr ""
"%(tab)s: კორექტირება %(name)s დათარიღებულია %(month)s თვით, "
"%(original)s-ის საპირისპირო გატარება კი %(reversal_month)s თვით, ამიტომ "
"ორივე თვის %(row)s-ის 1-ლი სტრიქონი rs.ge-სგან განსხვავდება, რომელიც "
"მხოლოდ სხვაობას ითვლის."

#. module: gec_vat_declaration
#. odoo-python
#: code:addons/gec_vat_declaration/models/gec_vat_declaration.py:0
msgid ""
"%(tab)s: corrections accepted on rs.ge but still drafts in Odoo, so their "
"VAT is not counted: %(names)s."
msgstr ""
"%(tab)s: rs.ge-ზე დადასტურებული კორექტირებები Odoo-ში ისევ მონახაზებია, "
"ამიტომ მათი დღგ არ ითვლება: %(names)s."

#. module: gec_vat_declaration
#. odoo-python
#: code:addons/gec_vat_declaration/models/gec_vat_declaration.py:0
msgid ""
"%(tab)s: %(names)s are dated on rs.ge in an earlier month but booked in "
"this one: their VAT is in this month's A I and on that month's B I; file "
"an adjusted declaration for that month."
msgstr ""
"%(tab)s: %(names)s rs.ge-ზე ადრინდელი თვითაა დათარიღებული, Odoo-ში კი ამ "
"თვეშია გატარებული: მათი დღგ ამ თვის ა I-შია, ბ I-ში კი იმ თვისაა; იმ "
"თვისთვის დაზუსტებული დეკლარაცია წარადგინეთ."

#. module: gec_vat_declaration
#. odoo-python
#: code:addons/gec_vat_declaration/models/gec_vat_declaration.py:0
msgid ""
"Cell 7 holds %(cell7).2f, but A I row 1 is Odoo's figure, which already "
"subtracts the month's credit notes and corrections: type in cell 7 only "
"decreases not booked in Odoo."
msgstr ""
"მე-7 უჯრაში %(cell7).2f წერია, მაგრამ ა I-ის 1-ლი სტრიქონი Odoo-ს "
"მონაცემია, რომელიც თვის საკრედიტო ანგარიშ-ფაქტურებსა და კორექტირებებს უკვე "
"აკლებს: მე-7 "
"უჯრაში მხოლოდ Odoo-ში გაუტარებელი შემცირება შეიყვანეთ."

#. module: gec_vat_declaration
#. odoo-python
#: code:addons/gec_vat_declaration/models/gec_vat_declaration.py:0
msgid ""
"Cell 7 holds %(cell7).2f, more than the VAT reduced in B I, tab 13 and B "
"VIII (%(cap).2f); per the portal, cell 7 must not exceed that sum."
msgstr ""
"მე-7 უჯრაში %(cell7).2f წერია, რაც ბ I-ის, მე-13 ჩანართისა და ბ VIII-ის "
"შესამცირებელი დღგ-ის ჯამზე (%(cap).2f) მეტია; პორტალის მიხედვით, მე-7 "
"უჯრა ამ ჯამს არ უნდა აღემატებოდეს."

#. module: gec_vat_declaration
#. odoo-python
#: code:addons/gec_vat_declaration/models/gec_vat_declaration.py:0
msgid ""
"Mark as Filed also locks this month for %(names)s (own Tax ID): file their "
"declarations first."
msgstr ""
"წარდგენილად მონიშვნა ამ თვეს %(names)s-ისთვისაც (საკუთარი ს/ნ) ჩაკეტავს: "
"ჯერ მათი დეკლარაციები წარადგინეთ."

#. module: gec_vat_declaration
#. odoo-python
#: code:addons/gec_vat_declaration/models/gec_vat_declaration.py:0
msgid "%s can be marked as filed only after its month has ended."
msgstr "%s წარდგენილად მხოლოდ თვის დასრულების შემდეგ შეიძლება მოინიშნოს."

#. module: gec_vat_declaration
#: model_terms:ir.ui.view,arch_db:gec_vat_declaration.view_gec_vat_declaration_form
#: model_terms:ir.ui.view,arch_db:gec_vat_declaration.view_gec_vat_rc_declaration_form
msgid "Marking as filed locks the tax month for the company and all its branches; Reset to Draft does not unlock it. Continue?"
msgstr "წარდგენილად მონიშვნა ჩაკეტავს საგადასახადო თვეს კომპანიისა და მისი ყველა ფილიალისთვის; მონახაზზე დაბრუნება მას არ გახსნის. გავაგრძელოთ?"

#. module: gec_vat_declaration
#. odoo-python
#: code:addons/gec_vat_declaration/models/gec_vat_declaration.py:0
msgid "A I"
msgstr "ა I"

#. module: gec_vat_declaration
#. odoo-python
#: code:addons/gec_vat_declaration/models/gec_vat_declaration.py:0
msgid "A II"
msgstr "ა II"

#. module: gec_vat_declaration
#. odoo-python
#: code:addons/gec_vat_declaration/models/gec_vat_declaration.py:0
msgid "A III"
msgstr "ა III"

#. module: gec_vat_declaration
#. odoo-python
#: code:addons/gec_vat_declaration/models/gec_vat_declaration.py:0
msgid "B I"
msgstr "ბ I"

#. module: gec_vat_declaration
#. odoo-python
#: code:addons/gec_vat_declaration/models/gec_vat_declaration.py:0
msgid "B II"
msgstr "ბ II"

#. module: gec_vat_declaration
#. odoo-python
#: code:addons/gec_vat_declaration/models/gec_vat_declaration.py:0
msgid ""
"%(name)s: %(names)s of earlier months are not filed yet, and marking as filed locks every earlier "
"month; file or delete them first."
msgstr ""
"%(name)s: წინა თვეების %(names)s წარდგენილი არ არის, წარდგენილად მონიშვნა კი ყველა წინა თვეს ჩაკეტავს; "
"ჯერ ისინი წარადგინეთ ან წაშალეთ."

#. module: gec_vat_declaration
#. odoo-python
#: code:addons/gec_vat_declaration/models/gec_vat_rc_declaration.py:0
msgid ""
"%(bills)s are declared in Part I, but their lines have no reverse-charge tax, so Odoo books no VAT for "
"them: reset them to draft and add the tax %(tax)s to their lines."
msgstr ""
"%(bills)s I ნაწილში შევიდა, მაგრამ მათ ხაზებს უკუდაბეგვრის გადასახადი არ აქვს, ამიტომ Odoo მათზე დღგ-ს "
"არ ატარებს: დააბრუნეთ ისინი მონახაზზე და მათ ხაზებს დაამატეთ გადასახადი „%(tax)s“."
