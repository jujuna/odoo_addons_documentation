#. module: ai_documents_fleet
#: model:ir.actions.server,name:ai_documents_fleet.ir_actions_server_fleet_link
msgid "AI Tool: Link Document to Vehicle"
msgstr "AI ინსტრუმენტი: დოკუმენტის დაკავშირება ავტომობილთან"

#. module: ai_documents_fleet
#: model:ir.model,name:ai_documents_fleet.model_ai_documents_sort
msgid "Ai Documents Sort"
msgstr "AI დოკუმენტების დახარისხება"

#. module: ai_documents_fleet
#: model:ir.model.fields,field_description:ai_documents_fleet.field_ai_documents_sort__display_name model:ir.model.fields,field_description:ai_documents_fleet.field_documents_document__display_name
msgid "Display Name"
msgstr "საჩვენებელი სახელი"

#. module: ai_documents_fleet
#: model:ir.model,name:ai_documents_fleet.model_documents_document
msgid "Document"
msgstr "დოკუმენტი"

#. module: ai_documents_fleet
#: model:ir.model.fields,field_description:ai_documents_fleet.field_ai_documents_sort__id model:ir.model.fields,field_description:ai_documents_fleet.field_documents_document__id
msgid "ID"
msgstr "ID"

#. module: ai_documents_fleet
#. odoo-python
#: code:addons/ai_documents_fleet/wizard/ai_documents_sort.py:0
msgid "If the document contains license plate number, link the document with the vehicle with the same license plate."
msgstr "თუ დოკუმენტი შეიცავს სახელმწიფო ნომერს, დააკავშირეთ დოკუმენტი იმავე სახელმწიფო ნომრის მქონე ავტომობილთან."

#. module: ai_documents_fleet
#. odoo-python
#: code:addons/ai_documents_fleet/wizard/ai_documents_sort.py:0
msgid "If the document is a traffic fine, move it to the %(fleet)s folder and link it to the vehicle with the matching license plate."
msgstr "თუ დოკუმენტი საგზაო მოძრაობის ჯარიმაა, გადაიტანეთ ის %(fleet)s საქაღალდეში და დააკავშირეთ შესაბამისი სახელმწიფო ნომრის მქონე ავტომობილთან."

#. module: ai_documents_fleet
#: model:ir.actions.server,ai_tool_description:ai_documents_fleet.ir_actions_server_fleet_link
msgid "Link document to fleet vehicle"
msgstr "დოკუმენტის დაკავშირება ავტოპარკის ავტომობილთან"

#. module: ai_documents_fleet
#. odoo-python
#: code:addons/ai_documents_fleet/models/documents_document.py:0
msgid "This document is already linked to a vehicle."
msgstr "ეს დოკუმენტი უკვე დაკავშირებულია ავტომობილთან."

#. module: ai_documents_fleet
#. odoo-python
#: code:addons/ai_documents_fleet/models/documents_document.py:0
msgid "Vehicle not found: %s"
msgstr "ავტომობილი ვერ მოიძებნა: %s"

