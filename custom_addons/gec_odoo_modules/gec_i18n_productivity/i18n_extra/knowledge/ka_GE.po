#. module: knowledge
#: model_terms:ir.ui.view,arch_db:knowledge.knowledge_article_user_onboarding
msgid "<span style=\"font-size: 14px;\">From any Odoo document, find this article by clicking on the 📗 icon in the chatter.</span>"
msgstr "<span style=\"font-size: 14px;\">ნებისმიერი Odoo დოკუმენტიდან იპოვეთ ეს სტატია მიმოწერაში 📗 ხატულაზე დაწკაპუნებით.</span>"

#. module: knowledge
#: model_terms:ir.ui.view,arch_db:knowledge.knowledge_article_user_onboarding
