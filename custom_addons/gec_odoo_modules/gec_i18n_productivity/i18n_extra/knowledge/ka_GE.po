"        <span style=\"font-weight: bolder;\"><font class=\"text-o-color-2\">სტატიები</font></span>.\n"
"    </span>"

#. module: knowledge
#: model_terms:ir.ui.view,arch_db:knowledge.knowledge_article_user_onboarding
msgid ""
"<span style=\"font-size: 14px;\">\n"
"        To change the way\n"
