#. module: knowledge
#: model_terms:ir.ui.view,arch_db:knowledge.knowledge_article_user_onboarding
msgid "<span style=\"font-size: 14px;\">Got it? Now let's try advanced features 🧠</span>"
msgstr "<span style=\"font-size: 14px;\">გაიგეთ? ახლა სცადეთ გაფართოებული ფუნქციები 🧠</span>"

#. module: knowledge
#: model_terms:ir.ui.view,arch_db:knowledge.knowledge_article_user_onboarding
msgid "<span style=\"font-size: 14px;\">Need this document somewhere? Come back here by clicking on the 📗 icon in the chatter.</span>"
msgstr "<span style=\"font-size: 14px;\">გჭირდებათ ეს დოკუმენტი სადმე? დაბრუნდით აქ მიმოწერაში 📗 ხატულაზე დაწკაპუნებით.</span>"

#. module: knowledge
#: model_terms:ir.ui.view,arch_db:knowledge.knowledge_article_user_onboarding
msgid "<span style=\"font-size: 14px;\">Not sure how to do it? Check the video below 👇</span>"
msgstr "<span style=\"font-size: 14px;\">არ იცით, როგორ გააკეთოთ? იხილეთ ვიდეო ქვემოთ 👇</span>"

#. module: knowledge
#: model_terms:ir.ui.view,arch_db:knowledge.knowledge_article_user_onboarding
msgid "<span style=\"font-size: 14px;\">Press Ctrl+Z/⌘+Z to undo any change</span>"
msgstr "<span style=\"font-size: 14px;\">დააჭირეთ Ctrl+Z/⌘+Z ნებისმიერი ცვლილების გასაუქმებლად</span>"

#. module: knowledge
#: model_terms:ir.ui.view,arch_db:knowledge.knowledge_article_user_onboarding
msgid ""
"<span style=\"font-size: 14px;\">This private page is for you to play around with.</span>\n"
"    <br/>\n"
"    <span style=\"font-size: 14px;\">Ready to give it a spin?</span>"
msgstr ""
"<span style=\"font-size: 14px;\">ეს პირადი გვერდი თქვენთვისაა, რომ თავისუფლად ითამაშოთ.</span>\n"
"    <br/>\n"
"    <span style=\"font-size: 14px;\">მზად ხართ სცადოთ?</span>"

#. module: knowledge
#: model_terms:ir.ui.view,arch_db:knowledge.knowledge_article_user_onboarding
msgid "<span style=\"font-size: 14px;\">Try the following 👇</span>"
msgstr "<span style=\"font-size: 14px;\">სცადეთ შემდეგი 👇</span>"

#. module: knowledge
#: model_terms:ir.ui.view,arch_db:knowledge.knowledge_article_user_onboarding
msgid "<span style=\"font-size: 14px;\">You can use the clipboard as a description, a message or simply copy it to your clipboard! 👌</span>"
