#. module: ai_documents_account
#: model:ir.model.fields,field_description:ai_documents_account.field_documents_document__ai_document_or_env_company_id
msgid "AI Company"
msgstr "AI კომპანია"

#. module: ai_documents_account
#: model:ir.model,name:ai_documents_account.model_ai_documents_sort
msgid "Ai Documents Sort"
msgstr "AI დოკუმენტების დახარისხება"

#. module: ai_documents_account
#. odoo-python
#: code:addons/ai_documents_account/wizard/ai_documents_sort.py:0
msgid "Company > Name"
msgstr "კომპანია > სახელი"

#. module: ai_documents_account
#. odoo-python
#: code:addons/ai_documents_account/wizard/ai_documents_sort.py:0
msgid "Contracts & NDAs go to the %(legal)s folder."
msgstr "კონტრაქტები და NDA-ები გადადის %(legal)s საქაღალდეში."

#. module: ai_documents_account
#: model:ir.model.fields,field_description:ai_documents_account.field_ai_documents_sort__display_name model:ir.model.fields,field_description:ai_documents_account.field_documents_document__display_name model:ir.model.fields,field_description:ai_documents_account.field_ir_actions_server__display_name
msgid "Display Name"
msgstr "საჩვენებელი სახელი"

#. module: ai_documents_account
#: model:ir.model,name:ai_documents_account.model_documents_document
msgid "Document"
msgstr "დოკუმენტი"

#. module: ai_documents_account
#: model:ir.model.fields,field_description:ai_documents_account.field_ai_documents_sort__id model:ir.model.fields,field_description:ai_documents_account.field_documents_document__id model:ir.model.fields,field_description:ai_documents_account.field_ir_actions_server__id
msgid "ID"
msgstr "ID"

#. module: ai_documents_account
#. odoo-python
#: code:addons/ai_documents_account/wizard/ai_documents_sort.py:0
msgid "If it is a customer invoice, trigger the action to create one."
msgstr "თუ ეს არის მომხმარებლის ანგარიშ-ფაქტურა, გაუშვით მისი შესაქმნელი მოქმედება."

#. module: ai_documents_account
#. odoo-python
#: code:addons/ai_documents_account/wizard/ai_documents_sort.py:0
msgid "If the customer is %s it means it is a vendor bill, trigger the Create Vendor Bill action."
msgstr "თუ მომხმარებელი არის %s, ეს ნიშნავს, რომ ეს არის მომწოდებლის ანგარიშ-ფაქტურა, გაუშვით მომწოდებლის ანგარიშ-ფაქტურის შექმნის მოქმედება."

#. module: ai_documents_account
#. odoo-python
#: code:addons/ai_documents_account/wizard/ai_documents_sort.py:0
msgid "If the document is an invoice, trigger the Vendor Bill action after moving it."
msgstr "თუ დოკუმენტი ანგარიშ-ფაქტურაა, გადატანის შემდეგ გაუშვით მომწოდებლის ანგარიშ-ფაქტურის მოქმედება."

#. module: ai_documents_account
#. odoo-python
#: code:addons/ai_documents_account/wizard/ai_documents_sort.py:0
msgid "If the document is not an invoice, move it to the correct folder:"
msgstr "თუ დოკუმენტი არ არის ანგარიშ-ფაქტურა, გადაიტანეთ ის სწორ საქაღალდეში:"

#. module: ai_documents_account
#. odoo-python
#: code:addons/ai_documents_account/wizard/ai_documents_sort.py:0
msgid "Insurance contracts go to the %(insurance)s folder."
msgstr "სადაზღვევო კონტრაქტები გადადის %(insurance)s საქაღალდეში."

#. module: ai_documents_account
#: model:ir.model,name:ai_documents_account.model_ir_actions_server
msgid "Server Action"
msgstr "სერვერის მოქმედება"

#. module: ai_documents_account
#: model:documents.tag,name:ai_documents_account.documents_tag_to_split
msgid "To Split"
msgstr "გასაყოფად"

#. module: ai_documents_account
#. odoo-python
#: code:addons/ai_documents_account/wizard/ai_documents_sort.py:0
msgid "%(b_open)sContracts & NDAs%(b_close)s go to the %(legal)s folder."
msgstr "%(b_open)sკონტრაქტები და NDA-ები%(b_close)s გადადის %(legal)s საქაღალდეში."

#. module: ai_documents_account
#. odoo-python
#: code:addons/ai_documents_account/wizard/ai_documents_sort.py:0
msgid "%(b_open)sInsurance contracts%(b_close)s go to the %(insurance)s folder."
msgstr "%(b_open)sსადაზღვევო კონტრაქტები%(b_close)s გადადის %(insurance)s საქაღალდეში."

#. module: ai_documents_account
#. odoo-python
#: code:addons/ai_documents_account/wizard/ai_documents_sort.py:0
msgid "Company > Email"
msgstr "კომპანია > ელ-ფოსტა"

#. module: ai_documents_account
#. odoo-python
#: code:addons/ai_documents_account/wizard/ai_documents_sort.py:0
msgid "First, check the file to see if it contains a single document or if several documents are collated together."
msgstr "პირველ რიგში, შეამოწმეთ ფაილი, რათა დაადგინოთ, შეიცავს თუ არა ის ერთ დოკუმენტს, თუ რამდენიმე დოკუმენტია ერთად თავმოყრილი."

#. module: ai_documents_account
#. odoo-python
#: code:addons/ai_documents_account/wizard/ai_documents_sort.py:0
msgid "For this, use this field: %s"
msgstr "ამისთვის გამოიყენეთ ეს ველი: %s"

#. module: ai_documents_account
#. odoo-python
#: code:addons/ai_documents_account/wizard/ai_documents_sort.py:0
msgid "If it is false, continue with the normal process"
msgstr "თუ ეს მცდარია, გააგრძელეთ ჩვეულებრივი პროცესით"

#. module: ai_documents_account
#. odoo-python
#: code:addons/ai_documents_account/wizard/ai_documents_sort.py:0
msgid "If it is true, add the tag %(b_open)s\"To Split\"%(b_close)s and stop there. This way, we'll know we first need to manually split it into different files."
msgstr "თუ ეს ჭეშმარიტია, დაამატეთ ტეგი %(b_open)s\"გასაყოფად\"%(b_close)s და გაჩერდით აქ. ამ გზით ვიცით, რომ ჯერ ხელით უნდა გავყოთ ის სხვადასხვა ფაილად."

#. module: ai_documents_account
#. odoo-python
#: code:addons/ai_documents_account/wizard/ai_documents_sort.py:0
msgid "If the customer is %(b_open)sanyone else%(b_close)s, create a Customer Invoice."
msgstr "თუ მომხმარებელი არის %(b_open)sნებისმიერი სხვა%(b_close)s, შექმენით მომხმარებლის ანგარიშ-ფაქტურა."

#. module: ai_documents_account
#. odoo-python
#: code:addons/ai_documents_account/wizard/ai_documents_sort.py:0
msgid "If the customer of the invoice is us (%(company_name)s, with email %(company_email)s), create a Vendor Bill."
msgstr "თუ ანგარიშ-ფაქტურის მომხმარებელი ვართ ჩვენ (%(company_name)s, ელ-ფოსტით %(company_email)s), შექმენით მომწოდებლის ანგარიშ-ფაქტურა."

#. module: ai_documents_account
#. odoo-python
#: code:addons/ai_documents_account/wizard/ai_documents_sort.py:0
msgid "If the document is %(b_open)snot an invoice%(b_close)s, move it to the correct folder:"
msgstr "თუ დოკუმენტი %(b_open)sარ არის ანგარიშ-ფაქტურა%(b_close)s, გადაიტანეთ ის სწორ საქაღალდეში:"

#. module: ai_documents_account
#. odoo-python
#: code:addons/ai_documents_account/wizard/ai_documents_sort.py:0
msgid "If the document is an %(b_open)sinvoice%(b_close)s, move it to the %(finance)s folder then trigger the relevant action:"
msgstr "თუ დოკუმენტი არის %(b_open)sანგარიშ-ფაქტურა%(b_close)s, გადაიტანეთ ის %(finance)s საქაღალდეში და შემდეგ გაუშვით შესაბამისი მოქმედება:"

#. module: ai_documents_account
#. odoo-python
#: code:addons/ai_documents_account/wizard/ai_documents_sort.py:0
msgid "Is considered multipage"
msgstr "ითვლება მრავალგვერდიანად"

#. module: ai_documents_account
#. odoo-python
#: code:addons/ai_documents_account/wizard/ai_documents_sort.py:0
msgid "Otherwise, %s"
msgstr "წინააღმდეგ შემთხვევაში, %s"
