<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_hotel_rms">
        <field name="name">Hotel Revenue</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="group_hotel_rms_user" model="res.groups">
        <field name="name">Viewer</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_hotel_rms"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_hotel_rms_revenue_manager" model="res.groups">
        <field name="name">Revenue Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_hotel_rms"/>
        <field name="implied_ids" eval="[(4, ref('group_hotel_rms_user'))]"/>
    </record>

    <record id="group_hotel_rms_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_hotel_rms"/>
        <field name="implied_ids" eval="[(4, ref('group_hotel_rms_revenue_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
