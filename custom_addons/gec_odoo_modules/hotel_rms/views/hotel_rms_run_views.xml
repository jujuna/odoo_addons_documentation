<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hotel_rms_run_view_list" model="ir.ui.view">
        <field name="name">hotel.rms.run.list</field>
        <field name="model">hotel.rms.run</field>
        <field name="arch" type="xml">
            <list class="o_rms_list" create="0" delete="0" edit="0">
                <field name="started_at"/>
                <field name="property_id"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"
                       decoration-warning="state == 'stale'" decoration-danger="state == 'failed'"
                       decoration-muted="state == 'busy'"/>
                <field name="nights" optional="hide"/>
                <field name="prices_changed" string="Changed" width="[110px]"/>
                <field name="duration" optional="show" width="[130px]"/>
                <field name="params_hash" optional="hide"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="hotel_rms_run_view_form" model="ir.ui.view">
        <field name="name">hotel.rms.run.form</field>
        <field name="model">hotel.rms.run</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="busy,done"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status" invisible="not message">
                        <field name="message"/>
                    </div>
                    <group>
                        <group>
                            <field name="property_id"/>
                            <field name="run_date"/>
                            <field name="started_at"/>
                            <field name="duration"/>
                        </group>
                        <group>
                            <field name="nights"/>
                            <field name="prices_changed"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="advanced" string="Advanced">
                            <group>
                                <group>
                                    <field name="forecast_version"/>
                                    <field name="price_version"/>
                                    <field name="params_hash"/>
                                </group>
                            </group>
                            <field name="params" widget="json" nolabel="1" class="text-break font-monospace small"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hotel_rms_run_view_search" model="ir.ui.view">
        <field name="name">hotel.rms.run.search</field>
        <field name="model">hotel.rms.run</field>
        <field name="arch" type="xml">
            <search>
                <field name="property_id"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="stale" string="Data too old" domain="[('state', '=', 'stale')]"/>
                <group>
                    <filter name="group_property" string="Hotel" context="{'group_by': 'property_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'run_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hotel_rms_run" model="ir.actions.act_window">
        <field name="name">Engine Runs</field>
        <field name="res_model">hotel.rms.run</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">The engine did not run yet</p>
            <p>Press Run now on a hotel. The engine also runs by itself every day.</p>
        </field>
    </record>
</odoo>
