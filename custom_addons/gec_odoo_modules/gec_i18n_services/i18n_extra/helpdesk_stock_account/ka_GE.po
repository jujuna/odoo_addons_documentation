#: model:ir.module.module,shortdesc:base.module_helpdesk_stock_account
msgid "Helpdesk Stock Account"
msgstr "დახმარების სამსახურის მარაგის ანგარიში"

#. module: helpdesk_stock_account
#: model:ir.module.module,summary:base.module_helpdesk_stock_account
msgid "Helpdesk, Stock, Account"
msgstr "დახმარების სამსახური, მარაგი, ბუღალტერია"

#. module: helpdesk_stock_account
#: model:ir.model.fields,field_description:helpdesk_stock_account.field_account_move_reversal__id
