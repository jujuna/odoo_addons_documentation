#. module: helpdesk_stock_account
#: model:ir.model.fields,field_description:helpdesk_stock_account.field_account_move_reversal__product_id
msgid "Product"
msgstr "პროდუქტი"

#. module: helpdesk_stock_account
#: model:ir.model.fields,help:helpdesk_stock_account.field_account_move_reversal__tracking
msgid "Technical field holding the tracking method. False on a storable product means it's tracked by quantity only."
msgstr "ტექნიკური ველი, რომელიც მიდევნების მეთოდს ინახავს. შესანახ პროდუქტზე False ნიშნავს, რომ ის მხოლოდ რაოდენობის მიხედვით მიიდევნება."

#. module: helpdesk_stock_account
#: model:ir.model.fields,field_description:helpdesk_stock_account.field_account_move_reversal__tracking
msgid "Tracking Method"
msgstr "მიდევნების მეთოდი"

#. module: helpdesk_stock_account
#: model:ir.model,name:helpdesk_stock_account.model_account_move_reversal
msgid "Account Move Reversal"
msgstr "ანგარიშის გატარების სტორნირება"

#. module: helpdesk_stock_account
#: model:ir.model.fields,help:helpdesk_stock_account.field_account_move_reversal__tracking
msgid "Ensure the traceability of a storable product in your warehouse."
msgstr "უზრუნველყავით საწყობში დასაწყობებადი პროდუქტის მიდევნება."

#. module: helpdesk_stock_account
#: model:ir.model.fields,help:helpdesk_stock_account.field_account_move_reversal__product_id
msgid "Product this ticket is about. If selected, only the sales orders, deliveries and invoices including this product will be visible."
msgstr "პროდუქტი, რომელსაც ეს ბილეთი ეხება. თუ არჩეულია, ხილული იქნება მხოლოდ ის გაყიდვის შეკვეთები, მიწოდებები და ანგარიშ-ფაქტურები, რომლებიც ამ პროდუქტს მოიცავს."

#. module: helpdesk_stock_account
#: model:ir.model.fields,field_description:helpdesk_stock_account.field_account_move_reversal__tracking
msgid "Tracking"
msgstr "მიდევნება"
