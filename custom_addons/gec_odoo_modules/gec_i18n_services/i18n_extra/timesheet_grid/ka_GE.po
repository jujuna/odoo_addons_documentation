msgstr "<span class=\"col-auto ms-2\">წთ</span>"

#. module: timesheet_grid
#: model_terms:web_tour.tour,rainbow_man_message:timesheet_grid.timesheet_tour
msgid ""
"<span><b>You're all set!</b>\n"
"            <br>\n"
"            <i>You're ready to track your time like a pro.</i>\n"
"        </span>"
msgstr ""
"<span><b>ყველაფერი მზადაა!</b>\n"
"            <br>\n"
"            <i>მზად ხართ, დრო პროფესიონალივით აღრიცხოთ.</i>\n"
"        </span>"

#. module: timesheet_grid
msgid ""
"<t>\n"
"<t t-set=\"timesheet_hours\" t-value=\"ctx.get('timesheet_hours', 0)\"/>\n"
"<t t-set=\"working_hours\" t-value=\"ctx.get('working_hours', 0)\"/>\n"
"Hello <t t-out=\"object.name or ''\">Abigail Peterson</t>,<br/><br/>\n"
"This is a friendly reminder to log your hours for the following period: <t t-out=\"ctx.get('date_start') or ''\">05/05/2021</t> <i class=\"oi\" data-icon=\"east\"/> <t t-out=\"ctx.get('date_stop') or ''\">05/06/2021</t>.\n"
"For the time being, you <t t-if=\"timesheet_hours != 0\">only</t> logged <t t-out=\"'%d' %int(timesheet_hours)\">2</t><t t-if=\"timesheet_hours % 1 != 0\" t-out=\"':%02d' % (round(timesheet_hours % 1 * 60))\">:30</t> hours on the <t t-out=\"'%d' %int(working_hours)\">8</t><t t-if=\"working_hours % 1 != 0\" t-out=\"':%02d' % (round(working_hours % 1 * 60))\">:30</t> requested.<br/>\n"
"<div t-if=\"ctx.get('action_url')\" style=\"margin: 16px 0px 16px 0px;\">\n"
"    <a t-att-href=\"ctx.get('action_url')\" t-attf-style=\"background-color: {{object.company_id.email_secondary_color or '#875A7B'}};; padding: 8px 16px 8px 16px; text-decoration: none; color: {{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px; font-size: 13px;\">Fill in your timesheet</a>\n"
"</div>\n"
"<br/>Thank you,<br/>\n"
"<t t-if=\"user.signature\">\n"
"    <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"</t>\n"
"            </t>"
msgstr ""
"<t>\n"
"<t t-set=\"timesheet_hours\" t-value=\"ctx.get('timesheet_hours', 0)\"/>\n"
"<t t-set=\"working_hours\" t-value=\"ctx.get('working_hours', 0)\"/>\n"
"გამარჯობა, <t t-out=\"object.name or ''\">Abigail Peterson</t>,<br/><br/>\n"
"მეგობრულად შეგახსენებთ, რომ საჭიროა თქვენი საათების აღრიცხვა შემდეგი პერიოდისთვის: <t t-out=\"ctx.get('date_start') or ''\">05/05/2021</t> <i class=\"oi\" data-icon=\"east\"/> <t t-out=\"ctx.get('date_stop') or ''\">05/06/2021</t>.\n"
"ჯერჯერობით მოთხოვნილი <t t-out=\"'%d' %int(working_hours)\">8</t><t t-if=\"working_hours % 1 != 0\" t-out=\"':%02d' % (round(working_hours % 1 * 60))\">:30</t> საათიდან <t t-if=\"timesheet_hours != 0\">მხოლოდ</t> <t t-out=\"'%d' %int(timesheet_hours)\">2</t><t t-if=\"timesheet_hours % 1 != 0\" t-out=\"':%02d' % (round(timesheet_hours % 1 * 60))\">:30</t> საათი გაქვთ აღრიცხული.<br/>\n"
"<div t-if=\"ctx.get('action_url')\" style=\"margin: 16px 0px 16px 0px;\">\n"
"    <a t-att-href=\"ctx.get('action_url')\" t-attf-style=\"background-color: {{object.company_id.email_secondary_color or '#875A7B'}};; padding: 8px 16px 8px 16px; text-decoration: none; color: {{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px; font-size: 13px;\">შეავსეთ თქვენი ტაბელი</a>\n"
"</div>\n"
"<br/>გმადლობთ,<br/>\n"
"<t t-if=\"user.signature\">\n"
"    <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"</t>\n"
"            </t>"

#. module: timesheet_grid
msgid ""
"<t>\n"
"Hello <t t-out=\"object.name or ''\">Abigail Peterson</t>,<br/><br/>\n"
"This is a friendly reminder to approve your team's timesheets for the following period: <t t-out=\"ctx.get('date_start') or ''\">05/05/2021</t> - <t t-out=\"ctx.get('date_stop') or ''\">06/05/2021</t>.<br/>\n"
"<div t-if=\"ctx.get('action_url')\" style=\"margin: 16px 0px 16px 0px;\">\n"
"    <a t-att-href=\"ctx.get('action_url')\" t-attf-style=\"background-color: {{object.company_id.email_secondary_color or '#875A7B'}}; padding: 8px 16px 8px 16px; text-decoration: none; color: {{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px; font-size: 13px;\">Validate the Timesheets</a>\n"
"</div>\n"
"<br/>Thank you,<br/>\n"
"<t t-if=\"user.signature\">\n"
"    <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"</t>\n"
"            </t>"
msgstr ""
"<t>\n"
"გამარჯობა, <t t-out=\"object.name or ''\">Abigail Peterson</t>,<br/><br/>\n"
"მეგობრულად შეგახსენებთ, რომ საჭიროა თქვენი გუნდის ტაბელების დამტკიცება შემდეგი პერიოდისთვის: <t t-out=\"ctx.get('date_start') or ''\">05/05/2021</t> - <t t-out=\"ctx.get('date_stop') or ''\">06/05/2021</t>.<br/>\n"
"<div t-if=\"ctx.get('action_url')\" style=\"margin: 16px 0px 16px 0px;\">\n"
"    <a t-att-href=\"ctx.get('action_url')\" t-attf-style=\"background-color: {{object.company_id.email_secondary_color or '#875A7B'}}; padding: 8px 16px 8px 16px; text-decoration: none; color: {{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px; font-size: 13px;\">ტაბელების დამტკიცება</a>\n"
"</div>\n"
"<br/>გმადლობთ,<br/>\n"
"<t t-if=\"user.signature\">\n"
"    <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"</t>\n"
"            </t>"

