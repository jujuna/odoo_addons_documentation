#. module: timesheet_grid
#. odoo-javascript
#: code:addons/timesheet_grid/static/src/js/tours/timesheet_grid.js:0
msgid "<b>Add a description</b> <br/> <i>Briefly summarize your activity, e.g., \"Metting with the customer.\"</i>"
msgstr "<b>აღწერის დამატება</b> <br/> <i>მოკლედ შეაჯამეთ თქვენი აქტივობა, მაგ., \"შეხვედრა კლიენტთან.\"</i>"

#. module: timesheet_grid
#. odoo-javascript
#: code:addons/timesheet_grid/static/src/js/tours/timesheet_grid.js:0
msgid "<b>Add time in the Grid view</b> <br/> <i>Click a cell to enter hours. Press Tab or Enter to navigate easily.</i>"
msgstr "<b>დროის დამატება ცხრილის ხედში</b> <br/> <i>საათების შესაყვანად დააწკაპუნეთ უჯრაზე. მარტივი ნავიგაციისთვის დააჭირეთ Tab-ს ან Enter-ს.</i>"

#. module: timesheet_grid
#. odoo-javascript
#: code:addons/timesheet_grid/static/src/js/tours/timesheet_grid.js:0
msgid "<b>Create the timesheet</b> <br/> <i>Once saved, the timer automatically restarts for your next activity.</i>"
msgstr "<b>ტაბელის შექმნა</b> <br/> <i>შენახვის შემდეგ ტაიმერი ავტომატურად ხელახლა ჩაირთვება თქვენი შემდეგი აქტივობისთვის.</i>"

#. module: timesheet_grid
#. odoo-javascript
#: code:addons/timesheet_grid/static/src/js/tours/timesheet_grid.js:0
msgid "<b>Select a project</b> <br/> <i>Choose the relevant project, such as a customer or team project.</i>"
msgstr "<b>პროექტის არჩევა</b> <br/> <i>აირჩიეთ შესაბამისი პროექტი, მაგალითად, კლიენტის ან გუნდის პროექტი.</i>"

#. module: timesheet_grid
#. odoo-javascript
#: code:addons/timesheet_grid/static/src/js/tours/timesheet_grid.js:0
msgid "<b>Start managing your timesheets</b> <br/> <i>Everything you track begins here.</i>"
msgstr "<b>ტაბელების მართვის დაწყება</b> <br/> <i>ყველაფერი, რასაც აღრიცხავთ, აქ იწყება.</i>"

#. module: timesheet_grid
#: model_terms:digest.tip,tip_description:timesheet_grid.digest_tip_timesheet_grid_0
msgid "<b>Tip: Let the Timesheets Assistant do the hard work</b>"
msgstr "<b>რჩევა: მძიმე სამუშაო ტაბელების ასისტენტს მიანდეთ</b>"

#. module: timesheet_grid
#. odoo-javascript
#: code:addons/timesheet_grid/static/src/js/tours/timesheet_grid.js:0
msgid "<b>Use the timer to track your activities</b> <br/> <i>Start the timer, then log a timesheet when your activity ends. It restarts automatically for the next task.</i>"
msgstr "<b>ტაიმერის გამოყენება აქტივობების აღსარიცხად</b> <br/> <i>ჩართეთ ტაიმერი, შემდეგ კი აქტივობის დასრულებისას ჩაწერეთ ტაბელი. შემდეგი დავალებისთვის ის ავტომატურად ხელახლა ჩაირთვება.</i>"

