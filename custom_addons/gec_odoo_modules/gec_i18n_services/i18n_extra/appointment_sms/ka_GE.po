#. module: appointment_sms
#: model_terms:ir.ui.view,arch_db:appointment_sms.appointment_form
msgid ""
"<i class=\"oi me-1\" data-icon=\"lightbulb\"/>\n"
"                We will use it to remind you of this appointment."
msgstr ""
"<i class=\"oi me-1\" data-icon=\"lightbulb\"/>\n"
"                მას გამოვიყენებთ, რომ ამ შეხვედრის შესახებ შეგახსენოთ."

#. module: appointment_sms
#: model:ir.module.module,shortdesc:base.module_appointment_sms
msgid "Appointment SMS"
msgstr "შეხვედრების SMS"

#. module: appointment_sms
#: model:calendar.alarm,name:appointment_sms.calendar_alarm_data_1h_sms
msgid "SMS Text Message - 1 Hours"
msgstr "SMS ტექსტური შეტყობინება - 1 საათი"

#. module: appointment_sms
#: model:ir.module.module,summary:base.module_appointment_sms
msgid "Use SMS reminders for appointment meetings"
msgstr "შეხვედრებისთვის SMS შეხსენებების გამოყენება"
