#. module: timesheet_grid_hr_attendance
#. odoo-javascript
#: code:addons/timesheet_grid_hr_attendance/static/src/js/tours/timesheet_grid_hr_attendance.js:0
msgid "<b>Check in to start the timer</b> <br/> <i>This begins tracking your current activity automatically.</i>"
msgstr "<b>შემოსვლა ტაიმერის ჩასართავად</b> <br/> <i>ეს ავტომატურად იწყებს თქვენი მიმდინარე აქტივობის აღრიცხვას.</i>"

#. module: timesheet_grid_hr_attendance
#. odoo-javascript
#: code:addons/timesheet_grid_hr_attendance/static/src/js/tours/timesheet_grid_hr_attendance.js:0
msgid "<b>Use the timer to track your time</b> <br/> <i>Start your day by checking in and log timesheets from anywhere.</i>"
msgstr "<b>ტაიმერის გამოყენება დროის აღსარიცხად</b> <br/> <i>დაიწყეთ დღე შემოსვლის აღნიშვნით და ჩაწერეთ ტაბელები ნებისმიერი ადგილიდან.</i>"

