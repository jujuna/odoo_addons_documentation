#. module: project
#: model:mail.template,body_html:project.project_done_email_template
msgid ""
"<div>\n"
"    Dear <t t-out=\"object.partner_id.name or 'customer'\">Brandon Freeman</t>,<br/>\n"
"    It is my pleasure to let you know that we have successfully completed the project \"<strong t-out=\"object.name or ''\">Renovations</strong>\".\n"
"    <t t-if=\"user.signature\">\n"
"        <br/>\n"
"        <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"    </t>\n"
"</div>\n"
"<br/><span style=\"margin: 0px 0px 0px 0px; font-size: 12px; opacity: 0.5; color: #454748;\" groups=\"project.group_project_stages\">You are receiving this email because your project has been moved to the stage <b t-out=\"object.stage_id.name or ''\">Done</b></span>\n"
"            "
msgstr ""
"<div>\n"
"    ძვირფასო <t t-out=\"object.partner_id.name or 'customer'\">Brandon Freeman</t>,<br/>\n"
"    სიამოვნებით გაცნობებთ, რომ პროექტი \"<strong t-out=\"object.name or ''\">რემონტი</strong>\" წარმატებით დავასრულეთ.\n"
"    <t t-if=\"user.signature\">\n"
"        <br/>\n"
"        <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"    </t>\n"
"</div>\n"
"<br/><span style=\"margin: 0px 0px 0px 0px; font-size: 12px; opacity: 0.5; color: #454748;\" groups=\"project.group_project_stages\">ამ წერილს იღებთ, რადგან თქვენი პროექტი გადავიდა ეტაპზე <b t-out=\"object.stage_id.name or ''\">დასრულებული</b></span>\n"
"            "

#. module: project
msgid ""
"<div>\n"
"    Dear <t t-out=\"object.partner_id.name or 'customer'\">Brandon Freeman</t>,<br/><br/>\n"
"    Thank you for contacting us. We appreciate your interest in our products/services.<br/>\n"
"    Our team is currently reviewing your inquiry and will respond to your email as soon as possible.<br/>\n"
"    If you have any further questions or concerns in the meantime, please do not hesitate to let us know. We are here to help.<br/><br/>\n"
"    Thank you for your patience.<br/>\n"
"    Best regards,\n"
"    <t t-if=\"user.signature\">\n"
"        <br/>\n"
"        <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"    </t>\n"
"</div>\n"
"        "
msgstr ""
"<div>\n"
"    ძვირფასო <t t-out=\"object.partner_id.name or 'customer'\">Brandon Freeman</t>,<br/><br/>\n"
"    გმადლობთ, რომ დაგვიკავშირდით. ვაფასებთ, რომ ჩვენი პროდუქტებითა და მომსახურებებით დაინტერესდით.<br/>\n"
"    ჩვენი გუნდი ამჟამად განიხილავს თქვენს მოთხოვნას და თქვენს წერილს რაც შეიძლება მალე უპასუხებს.<br/>\n"
"    თუ მანამდე დამატებითი კითხვები ან შენიშვნები გაგიჩნდებათ, გთხოვთ, მოგერიდებლად შეგვატყობინოთ. მზად ვართ დაგეხმაროთ.<br/><br/>\n"
"    გმადლობთ მოთმინებისთვის.<br/>\n"
"    პატივისცემით,\n"
"    <t t-if=\"user.signature\">\n"
"        <br/>\n"
"        <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"    </t>\n"
"</div>\n"
"        "

