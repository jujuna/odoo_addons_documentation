<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="initiative_stage_proposed" model="bsc.initiative.stage">
            <field name="name">Proposed</field>
            <field name="sequence">10</field>
            <field name="state">proposed</field>
        </record>

        <record id="initiative_stage_assessment" model="bsc.initiative.stage">
            <field name="name">Under Assessment</field>
            <field name="sequence">20</field>
            <field name="state">proposed</field>
        </record>

        <record id="initiative_stage_approved" model="bsc.initiative.stage">
            <field name="name">Approved</field>
            <field name="sequence">30</field>
            <field name="state">approved</field>
        </record>

        <record id="initiative_stage_in_progress" model="bsc.initiative.stage">
            <field name="name">In Progress</field>
            <field name="sequence">40</field>
            <field name="state">in_progress</field>
        </record>

        <record id="initiative_stage_done" model="bsc.initiative.stage">
            <field name="name">Done</field>
            <field name="sequence">50</field>
            <field name="state">done</field>
            <field name="fold" eval="True"/>
        </record>

        <record id="initiative_stage_cancelled" model="bsc.initiative.stage">
            <field name="name">Cancelled</field>
            <field name="sequence">60</field>
            <field name="state">cancelled</field>
            <field name="fold" eval="True"/>
        </record>

    </data>
</odoo>
