<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Runs after the maintenance cron (priority 5), so the empty rows exist first. -->
        <record id="ir_cron_bsc_refresh_automated" model="ir.cron">
            <field name="name">BSC: refresh automated KPI figures</field>
            <field name="model_id" ref="bsc_strategy.model_bsc_measurement"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_automated()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="priority">7</field>
        </record>
    </data>
</odoo>
