msgstr "ეს ისარი სტრატეგიის მტკიცებაა, რომელიც არავის შეუმოწმებია."

#. module: bsc_strategy
#: model:ir.model.constraint,message:bsc_strategy.constraint_bsc_objective_link_source_target_uniq
msgid "This cause-effect link already exists."
msgstr "ეს მიზეზ-შედეგობრივი კავშირი უკვე არსებობს."

#. module: bsc_strategy
#: model_terms:ir.ui.view,arch_db:bsc_strategy.view_bsc_scorecard_form
msgid "This closes every open period and freezes the figures. Continue?"
msgstr "ეს ხურავს ყველა ღია პერიოდს და აფიქსირებს მნიშვნელობებს. გავაგრძელოთ?"

#. module: bsc_strategy
#: model:ir.model.fields,help:bsc_strategy.field_bsc_measurement__is_automated
msgid "This figure was produced by a data source, not typed in."
msgstr "ეს მნიშვნელობა მონაცემთა წყარომ მიიღო და ხელით არ შეუტანიათ."

#. module: bsc_strategy
#. odoo-python
#: code:addons/bsc_strategy/models/bsc_initiative_project.py:0
msgid ""
"This initiative is now in progress but has no project or task behind it. "
"Create one from the Execution tab if the work needs tracking."
msgstr ""
"ეს ინიციატივა ახლა მიმდინარეა, მაგრამ მის უკან არც პროექტი დგას და არც "
"დავალება. თუ სამუშაოს კონტროლი სჭირდება, შექმენით ჩანართიდან "
"„განხორციელება“."

#. module: bsc_strategy
#. odoo-javascript
#: code:addons/bsc_strategy/static/src/dashboard/dashboard.xml:0
msgid ""
"This is demo data. Remove it under\n"
