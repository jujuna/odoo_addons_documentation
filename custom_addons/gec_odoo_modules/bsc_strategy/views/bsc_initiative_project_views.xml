<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bsc_initiative_form_project" model="ir.ui.view">
        <field name="name">bsc.initiative.form.project</field>
        <field name="model">bsc.initiative</field>
        <field name="inherit_id" ref="bsc_strategy.view_bsc_initiative_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Execution" name="execution">
                    <p class="text-muted">
                        A large initiative gets its own project; a small one is a single
                        task. Neither is required - an initiative can be run and reported
                        here alone.
                    </p>
                    <div class="alert alert-info" role="alert"
                         invisible="not use_project_progress or (not project_id and not task_id)">
                        <b>Progress follows the tasks.</b> It is updated the moment a task
                        changes: a task counts as done when it is marked Done or dropped into
                        a folded column such as "Done"; cancelled tasks are left out; a task
                        with subtasks is counted through its subtasks. Untick
                        "Track Progress from Project" to type the progress yourself.
                    </div>
                    <group>
                        <group>
                            <field name="project_id" readonly="1"/>
                            <field name="task_id" readonly="1"/>
                            <field name="use_project_progress" groups="bsc_strategy.group_bsc_manager"
                                   invisible="not project_id and not task_id"/>
                        </group>
                        <group invisible="not project_id and not task_id">
                            <field name="task_done_count" string="Tasks done"/>
                            <field name="task_count" string="Tasks total"/>
                            <field name="project_progress" widget="progressbar"/>
                        </group>
                    </group>
                    <div class="mt-3">
                        <button name="action_create_project" type="object"
                                string="Create Project" class="btn-primary me-2"
                                invisible="project_id or state not in ('approved', 'in_progress')"/>
                        <button name="action_create_task" type="object"
                                string="Create Task" class="btn-secondary me-2"
                                invisible="task_id or state not in ('approved', 'in_progress')"/>
                        <button name="action_open_project" type="object"
                                string="Open Project" class="btn-secondary me-2"
                                invisible="not project_id"/>
                        <button name="action_open_project_tasks" type="object"
                                string="Open Tasks" class="btn-secondary me-2"
                                invisible="not project_id"/>
                        <button name="action_open_task" type="object"
                                string="Open Task" class="btn-secondary me-2"
                                invisible="not task_id"/>
                        <button name="action_sync_progress" type="object"
                                string="Sync Progress" class="btn-secondary"
                                invisible="not project_id and not task_id"/>
                        <span class="text-muted ms-2" invisible="state != 'proposed'">
                            Approve the initiative first.
                        </span>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_bsc_initiative_list_project" model="ir.ui.view">
        <field name="name">bsc.initiative.list.project</field>
        <field name="model">bsc.initiative</field>
        <field name="inherit_id" ref="bsc_strategy.view_bsc_initiative_list"/>
        <field name="arch" type="xml">
            <field name="progress" position="before">
                <field name="project_id" optional="show"/>
                <field name="task_id" optional="hide"/>
            </field>
        </field>
    </record>

</odoo>
