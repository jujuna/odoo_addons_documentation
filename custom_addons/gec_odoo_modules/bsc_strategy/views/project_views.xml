<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_form_bsc" model="ir.ui.view">
        <field name="name">project.project.form.bsc</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_bsc_initiatives" type="object"
                        class="oe_stat_button" icon="flag"
                        invisible="bsc_initiative_count == 0">
                    <field name="bsc_initiative_count" widget="statinfo"
                           string="Initiatives"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
