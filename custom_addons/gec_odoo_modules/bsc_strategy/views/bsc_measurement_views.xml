<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bsc_measurement_list" model="ir.ui.view">
        <field name="name">bsc.measurement.list</field>
        <field name="model">bsc.measurement</field>
        <field name="arch" type="xml">
            <list string="Measurements" editable="bottom"
                  create="false" delete="false" default_order="period_id, objective_id, kpi_id"
                  decoration-danger="status == 'red'"
                  decoration-warning="status == 'amber'"
                  decoration-muted="actual_value_set == False">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            help="Mark the selected figures as final from the data owner's side."/>
                    <button name="action_validate" type="object" string="Validate"
                            groups="bsc_strategy.group_bsc_manager"
                            help="Sign off the selected figures. A validated figure is never overwritten by automation."/>
                </header>
                <field name="period_id" readonly="1" optional="show"/>
                <field name="kpi_id" readonly="1"/>
                <field name="objective_id" readonly="1" optional="hide"/>
                <field name="perspective_id" readonly="1" optional="hide"/>
                <field name="uom_name" string="Unit" readonly="1"/>
                <field name="direction" readonly="1" optional="hide"/>
                <field name="baseline_value" readonly="1" optional="hide"/>
                <field name="bsc_can_manage" column_invisible="1"/>
                <field name="target_value" readonly="not bsc_can_manage"/>
                <field name="actual_value" readonly="state == 'validated' and not bsc_can_manage"/>
                <field name="actual_value_set" string="Reported" widget="boolean_toggle"
                       optional="show" readonly="period_state == 'closed' or (state == 'validated' and not bsc_can_manage)"
                       help="Switched on by itself when you type a figure. Switch it on by hand to report exactly 0."/>
                <field name="achievement" string="Achievement %" digits="[16,1]" readonly="1"/>
                <field name="status" widget="badge" readonly="1"
                       decoration-success="status == 'green'"
                       decoration-warning="status == 'amber'"
                       decoration-danger="status == 'red'"/>
                <field name="trend" readonly="1" optional="hide"/>
                <field name="previous_value" readonly="1" optional="show" string="Previous"/>
                <field name="comment" required="status == 'red'" readonly="state == 'validated' and not bsc_can_manage"/>
                <field name="state" widget="badge" readonly="1" optional="show"
                       decoration-info="state == 'submitted'"
                       decoration-success="state == 'validated'"/>
                <field name="entered_by_id" readonly="1" optional="hide"
                       widget="many2one_avatar_user"/>
                <field name="entry_date" readonly="1" optional="hide"/>
                <field name="period_state" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_bsc_measurement_form" model="ir.ui.view">
        <field name="name">bsc.measurement.form</field>
        <field name="model">bsc.measurement</field>
        <field name="arch" type="xml">
            <form string="Measurement">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_validate" type="object" string="Validate"
                            class="btn-primary" invisible="state != 'submitted'"
                            groups="bsc_strategy.group_bsc_manager"/>
                    <button name="action_reset" type="object" string="Clear Figure"
                            invisible="actual_value_set == False"
                            confirm="This removes the reported figure. Continue?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="bsc_can_manage" invisible="1"/>
                            <field name="kpi_id" options="{'no_create': True}" readonly="id and not bsc_can_manage"/>
                            <field name="period_id" options="{'no_create': True}" readonly="id and not bsc_can_manage"/>
                            <field name="objective_id" readonly="1"/>
                            <field name="uom_name" readonly="1"/>
                            <field name="direction" readonly="1"/>
                        </group>
                        <group>
                            <field name="baseline_value" readonly="1"/>
                            <field name="target_value" readonly="not bsc_can_manage"/>
                            <field name="actual_value" readonly="state == 'validated' and not bsc_can_manage"/>
                            <field name="actual_value_set" widget="boolean_toggle"
                                   readonly="period_state == 'closed' or (state == 'validated' and not bsc_can_manage)"/>
                            <field name="period_state" invisible="1"/>
                            <field name="previous_value" readonly="1"
                                   invisible="has_previous == False"/>
                            <field name="has_previous" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <label for="achievement"/>
                            <div class="o_row">
                                <field name="achievement" digits="[16,1]" class="oe_inline"
                                       readonly="1"/>
                                <span class="oe_inline">%</span>
                                <field name="status" widget="badge" class="ms-2" readonly="1"
                                       decoration-success="status == 'green'"
                                       decoration-warning="status == 'amber'"
                                       decoration-danger="status == 'red'"/>
                            </div>
                            <field name="trend" readonly="1"/>
                        </group>
                        <group>
                            <field name="entered_by_id" readonly="1"/>
                            <field name="entry_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Variance Comment">
                        <field name="comment" nolabel="1" required="status == 'red'"
                               readonly="state == 'validated' and not bsc_can_manage"
                               placeholder="Why the figure came out this way, and what happens next."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bsc_measurement_search" model="ir.ui.view">
        <field name="name">bsc.measurement.search</field>
        <field name="model">bsc.measurement</field>
        <field name="arch" type="xml">
            <search string="Measurements">
                <field name="kpi_id"/>
                <field name="period_id"/>
                <field name="objective_id"/>
                <field name="scorecard_id"/>
                <filter name="filter_mine" string="Mine to Report"
                        domain="[('owner_id', '=', uid)]"/>
                <!-- A separator, so the two default filters combine with AND instead of OR. -->
                <separator/>
                <filter name="filter_open_period" string="Open Period"
                        domain="[('period_id.state', '=', 'open')]"/>
                <separator/>
                <filter name="filter_missing" string="Not Reported"
                        domain="[('actual_value_set', '=', False)]"/>
                <filter name="filter_red" string="Off Track" domain="[('status', '=', 'red')]"/>
                <filter name="filter_amber" string="At Risk" domain="[('status', '=', 'amber')]"/>
                <group>
                    <filter name="group_period" string="Period"
                            context="{'group_by': 'period_id'}"/>
                    <filter name="group_kpi" string="KPI" context="{'group_by': 'kpi_id'}"/>
                    <filter name="group_objective" string="Objective"
                            context="{'group_by': 'objective_id'}"/>
                    <filter name="group_perspective" string="Perspective"
                            context="{'group_by': 'perspective_id'}"/>
                    <filter name="group_status" string="Status"
                            context="{'group_by': 'status'}"/>
                    <filter name="group_owner" string="Data Owner"
                            context="{'group_by': 'owner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_bsc_measurement_graph" model="ir.ui.view">
        <field name="name">bsc.measurement.graph</field>
        <field name="model">bsc.measurement</field>
        <field name="arch" type="xml">
            <graph string="KPI Performance" type="line">
                <field name="period_id" type="row"/>
                <field name="kpi_id" type="col"/>
                <field name="achievement" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_bsc_measurement_pivot" model="ir.ui.view">
        <field name="name">bsc.measurement.pivot</field>
        <field name="model">bsc.measurement</field>
        <field name="arch" type="xml">
            <pivot string="KPI Performance">
                <field name="perspective_id" type="row"/>
                <field name="objective_id" type="row"/>
                <field name="period_id" type="col"/>
                <field name="achievement" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_bsc_data_entry" model="ir.actions.act_window">
        <field name="name">Data Entry</field>
        <field name="res_model">bsc.measurement</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bsc_measurement_search"/>
        <field name="context">{'search_default_filter_mine': 1, 'search_default_filter_open_period': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing waiting for you</p>
            <p>Rows appear here once a scorecard is active and a period is open.
               Remove the filters above to see everyone else's figures.</p>
        </field>
    </record>

    <record id="action_bsc_measurement_analysis" model="ir.actions.act_window">
        <field name="name">KPI Analysis</field>
        <field name="res_model">bsc.measurement</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="search_view_id" ref="view_bsc_measurement_search"/>
    </record>

</odoo>
