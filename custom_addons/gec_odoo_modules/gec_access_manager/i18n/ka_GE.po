"<span class=\"text-muted\">\n"
"                                    Untick a menu to hide it. Click a menu to set what its users may do there.\n"
"                                </span>"
msgstr ""
"<span class=\"text-muted\">მენიუს დასამალად მოხსენით მონიშვნა. დააჭირეთ "
"მენიუს და აირჩიეთ, რა შეუძლიათ იქ მომხმარებლებს.</span>"

#. module: gec_access_manager
#. odoo-python
