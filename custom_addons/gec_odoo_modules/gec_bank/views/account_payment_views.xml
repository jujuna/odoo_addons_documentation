<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_gec_bank" model="ir.ui.view">
        <field name="name">account.payment.form.gec_bank</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <field name="gec_bank_code" invisible="1"/>
                <field name="gec_bank_state" invisible="1"/>
            </header>
        </field>
    </record>

    <record id="view_account_payment_list_gec_bank" model="ir.ui.view">
        <field name="name">account.payment.list.gec_bank</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="gec_bank_state" optional="hide" widget="badge"
                       decoration-success="gec_bank_state == 'confirmed'"
                       decoration-info="gec_bank_state == 'approved'"
                       decoration-danger="gec_bank_state in ('failed', 'unknown')"
                       decoration-warning="gec_bank_state not in ('pending', 'approved', 'confirmed', 'failed', 'unknown')"/>
            </field>
        </field>
    </record>
</odoo>
