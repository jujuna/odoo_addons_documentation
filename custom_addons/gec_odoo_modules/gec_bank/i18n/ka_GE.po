#. module: gec_bank
#. odoo-python
#: code:addons/gec_bank/models/account_payment.py:0
msgid ""
"%s rejected this transfer, so the payment is marked Rejected. Reset it to "
"draft, correct it, confirm and send it again."
msgstr ""
"ბანკმა (%s) ეს გადარიცხვა უარყო, ამიტომ გადახდა მონიშნულია, როგორც "
"უარყოფილი. დააბრუნეთ მონახაზზე, შეასწორეთ, დაადასტურეთ და გაგზავნეთ ხელახლა."

#. module: gec_bank
