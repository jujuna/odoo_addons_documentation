#. module: gec_bank
#. odoo-python
#: code:addons/gec_bank/models/account_payment.py:0
msgid ""
"%s approved this transfer but may no longer approve, so the approval was "
"withdrawn. Submit it for approval again."
msgstr ""
"ეს გადარიცხვა დაამტკიცა მომხმარებელმა %s, რომელსაც დამტკიცების უფლება აღარ "
"აქვს, ამიტომ დამტკიცება გაუქმდა. ხელახლა გაგზავნეთ დასამტკიცებლად."

#. module: gec_bank
#. odoo-python
#: code:addons/gec_bank/models/account_payment_method_line.py:0
msgid "%s has no IBAN, so the bank cannot identify the sender."
msgstr "%s: არ აქვს IBAN, ამიტომ ბანკი ვერ ამოიცნობს გამგზავნს."

#. module: gec_bank
#. odoo-python
#: code:addons/gec_bank/models/account_payment_method_line.py:0
msgid ""
"%s has no Outstanding Payments account, so its payments would post no "
"journal entry at all."
msgstr ""
"%s: გადასახდელი გადახდების ანგარიში მითითებული არ არის, ამიტომ ამ მეთოდის "
"გადახდები ბუღალტრულ გატარებას საერთოდ არ შექმნის."

#. module: gec_bank
#. odoo-python
#: code:addons/gec_bank/models/account_payment.py:0
msgid ""
"%s is at the bank, or may be, so it cannot move to another bank or payment "
"method."
msgstr ""
"%s ბანკშია ან შესაძლოა ბანკში იყოს, ამიტომ მისი სხვა ბანკზე ან გადახდის "
"მეთოდზე გადატანა შეუძლებელია."

#. module: gec_bank
#. odoo-python
#: code:addons/gec_bank/models/account_payment_method_line.py:0
msgid "%s is not an outbound payment method."
msgstr "%s გამავალი გადახდის მეთოდი არ არის."

#. module: gec_bank
#. odoo-python
#: code:addons/gec_bank/models/account_payment_method_line.py:0
msgid "%s is not on a bank journal."
