#. module: hr_expense_stripe
#. odoo-javascript
#: code:addons/hr_expense_stripe/static/src/components/open_expense_issuing_terms.xml:0
msgid ""
"You are fully liable for any negative balance on your Stripe Issuing account.\n"
"                    Repayment is due immediately upon notice."
msgstr ""
"თქვენ სრულად აგებთ პასუხს თქვენს Stripe Issuing ანგარიშზე არსებულ ნებისმიერ უარყოფით ნაშთზე.\n"
"                    დაფარვა ხდება შეტყობინების მიღებისთანავე."

#. module: hr_expense_stripe
#. odoo-javascript
#: code:addons/hr_expense_stripe/static/src/components/open_card_receive_terms.xml:0
msgid ""
"You are responsible for all transactions made with your card,\n"
"                    including unauthorized charges unless covered by law or Stripe’s policy."
msgstr ""
"თქვენ პასუხს აგებთ თქვენი ბარათით განხორციელებულ ყველა ტრანზაქციაზე,\n"
