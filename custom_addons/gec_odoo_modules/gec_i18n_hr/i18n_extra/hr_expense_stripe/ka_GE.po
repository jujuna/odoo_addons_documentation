#: code:addons/hr_expense_stripe/utils.py:0
msgid "The authorization was refused by your Odoo database"
msgstr "ავტორიზაცია უარყო თქვენმა Odoo-ს მონაცემთა ბაზამ"

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/utils.py:0
msgid "The authorization was suspected as fraudulent by Stripe's risk controls"
msgstr "ავტორიზაცია Stripe-ის რისკების კონტროლმა საეჭვოდ, თაღლითურად მიიჩნია"

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/utils.py:0
msgid "The card has expired"
msgstr "ბარათს ვადა გაუვიდა"

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/utils.py:0
msgid "The card is active, and there was no control setup on your Stripe account"
msgstr "ბარათი აქტიურია და თქვენს Stripe-ის ანგარიშზე კონტროლი დაყენებული არ იყო"

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/utils.py:0
msgid "The card is currently inactive, please activate it first"
msgstr "ბარათი ამჟამად არააქტიურია, გთხოვთ, ჯერ გაააქტიუროთ"

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/utils.py:0
msgid "The card used was blocked"
msgstr "გამოყენებული ბარათი დაბლოკილი იყო"

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/utils.py:0
msgid "The card was declined because of the Stripe spending controls"
msgstr "ბარათი უარყოფილ იქნა Stripe-ის ხარჯვის კონტროლის გამო"

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/utils.py:0
msgid "The card's PIN is blocked"
msgstr "ბარათის PIN-კოდი დაბლოკილია"

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/utils.py:0
msgid "The cardholder is currently inactive"
msgstr "ბარათის მფლობელი ამჟამად არააქტიურია"

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/utils.py:0
msgid "The cardholder is still under verification"
msgstr "ბარათის მფლობელი ჯერ კიდევ შემოწმების პროცესშია"

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/utils.py:0
msgid "The cardholder was blocked"
msgstr "ბარათის მფლობელი დაიბლოკა"

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/models/hr_expense.py:0
msgid "There is no product available for this expense. Please contact your administrator."
msgstr "ამ ხარჯისთვის ხელმისაწვდომი პროდუქტი არ არსებობს. გთხოვთ, დაუკავშირდეთ თქვენს ადმინისტრატორს."

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/utils.py:0
msgid "There was an error in your Odoo database and Stripe received an invalid response"
msgstr "თქვენს Odoo-ს მონაცემთა ბაზაში მოხდა შეცდომა და Stripe-მა არასწორი პასუხი მიიღო"

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/utils.py:0
msgid "Transaction amount exceeded the card daily/transaction hard limit of 50.000 €"
msgstr "ტრანზაქციის თანხამ გადააჭარბა ბარათის დღიურ/ტრანზაქციის მკაცრ ლიმიტს — 50.000 €"

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/models/hr_expense_stripe_card.py:0
msgid "Transaction amount exceeds the interval limit"
msgstr "ტრანზაქციის თანხა აჭარბებს ინტერვალის ლიმიტს"

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/models/hr_expense_stripe_card.py:0
msgid "Transaction amount exceeds the maximum allowed"
msgstr "ტრანზაქციის თანხა აჭარბებს მაქსიმალურ დასაშვებ ოდენობას"

#. module: hr_expense_stripe
#: model:ir.model.fields,field_description:hr_expense_stripe.field_hr_expense_stripe_card__website_message_ids model:ir.model.fields,field_description:hr_expense_stripe.field_hr_expense_stripe_cardholder_wizard__website_message_ids
msgid "Website Messages"
msgstr "ვებსაიტის შეტყობინებები"

#. module: hr_expense_stripe
#: model:ir.model.fields,help:hr_expense_stripe.field_hr_expense_stripe_card__website_message_ids model:ir.model.fields,help:hr_expense_stripe.field_hr_expense_stripe_cardholder_wizard__website_message_ids
msgid "Website communication history"
msgstr "ვებსაიტის კომუნიკაციის ისტორია"

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/utils.py:0
msgid "Your Odoo database failed to respond to Stripe in time, and the authorization was refused by default"
msgstr "თქვენმა Odoo მონაცემთა ბაზამ ვერ მოახერხა Stripe-ისთვის დროულად პასუხის გაცემა და ავტორიზაცია ნაგულისხმევად უარყოფილ იქნა"

#. module: hr_expense_stripe
#. odoo-python
#: code:addons/hr_expense_stripe/utils.py:0
msgid "Your Stripe account is disabled"
msgstr "თქვენი Stripe ანგარიში გათიშულია"
