#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/account_move.py:0
msgid "The '%(account_name)s' account for the salary rule '%(rule_name)s' must be of type 'Payable'."
msgstr "სახელფასო წესის „%(rule_name)s“ ანგარიში „%(account_name)s“ უნდა იყოს ტიპის „გადასახდელი“."

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/product_template.py:0
msgid ""
"The salary rules linked to a product must have a debit account of type 'Liability Payable'.\n"
"Please fix the following salary rule(s): %s"
msgstr ""
"პროდუქტთან დაკავშირებულ სახელფასო წესებს უნდა ჰქონდეს 'გადასახდელი ვალდებულების' ტიპის სადებეტო ანგარიში.\n"
"გთხოვთ, გაასწოროთ შემდეგი სახელფასო წესი/წესები: %s"

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/hr_expense.py:0
msgid "There are no valid expenses selected."
msgstr "მოქმედი ხარჯები არჩეული არ არის."

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/product_template.py:0
msgid ""
"You cannot assign multiple salary rules to the same structure for this product.\n"
"Please fix the following structure(s): %s"
msgstr ""
"ამ პროდუქტისთვის ერთსა და იმავე სტრუქტურაზე რამდენიმე სახელფასო წესს ვერ მიანიჭებთ.\n"
"გთხოვთ, გაასწოროთ შემდეგი სტრუქტურა(ები): %s"

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/hr_expense.py:0
msgid ""
"You cannot remove an expense from a payslip that has already been validated.\n"
"Expenses can only be removed from draft or canceled payslips."
msgstr ""
"უკვე დამოწმებული ხელფასის უწყისიდან ხარჯს ვერ ამოიღებთ.\n"
"ხარჯების ამოღება მხოლოდ მონახაზი ან გაუქმებული უწყისებიდანაა შესაძლებელი."

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/hr_expense.py:0
msgid "You do not have permission to add this expense to a payslip."
msgstr "ამ ხარჯის ხელფასის უწყისში დამატების ნებართვა არ გაქვთ."

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/hr_payslip.py:0
msgid "You don't have the access rights to link an expense to a payslip. You need to be a payroll officer to do that."
msgstr "ხარჯის ხელფასის უწყისთან დაკავშირების უფლება არ გაქვთ. ამისთვის ხელფასების ოფიცერი უნდა იყოთ."

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/account_move.py:0
msgid "You don't have the access rights to post an invoice."
msgstr "არ გაქვთ ანგარიშ-ფაქტურის გატარების წვდომის უფლებები."

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/hr_expense.py:0
msgid ""
"Expense reimbursement rule needs to be configured to add expenses to payslips.\n"
"Please create one salary rule with the \"%(code)s\" code on the relevant salary structures."
msgstr ""
"ხელფასის უწყისებში ხარჯების დასამატებლად საჭიროა ხარჯის ანაზღაურების წესის კონფიგურაცია.\n"
"გთხოვთ, შესაბამის სახელფასო სტრუქტურებში შექმნათ ერთი სახელფასო წესი კოდით „%(code)s“."

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/hr_payslip.py:0
msgid "Expense rules"
msgstr "ხარჯის წესები"

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/hr_expense.py:0
msgid "Go to salary rules"
msgstr "სახელფასო წესებზე გადასვლა"

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/hr_payslip.py:0
msgid "No debit account for EXPENSES rules"
msgstr "EXPENSES წესებისთვის სადებეტო ანგარიში არ არის"

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/hr_payslip.py:0
