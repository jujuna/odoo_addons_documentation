<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_employee_registry_rs_sync" model="ir.cron">
            <field name="name">RS Employee Registry: Daily Sync</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_employees_to_rs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_employee_registry_rs_log_rotation" model="ir.cron">
            <field name="name">RS Employee Registry: Log Rotation (90 days)</field>
            <field name="model_id" ref="model_employee_registry_rs_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_rotate_logs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
