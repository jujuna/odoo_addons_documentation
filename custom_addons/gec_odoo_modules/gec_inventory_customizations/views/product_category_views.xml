<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_category_search_view" model="ir.ui.view">
        <field name="name">product.category.search.gec</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search/group" position="before">
                <filter string="Top-level Categories" name="top_level" domain="[('parent_id', '=', False)]"/>
            </xpath>
            <xpath expr="//search/group" position="inside">
                <filter string="Parent Category" name="group_by_parent" context="{'group_by': 'parent_id'}"/>
                <filter string="Costing Method" name="group_by_cost_method" context="{'group_by': 'property_cost_method'}"/>
            </xpath>
            <xpath expr="//search" position="inside">
                <searchpanel>
                    <field name="parent_id" icon="filter_alt" icon_class="oi-filled" limit="false"/>
                </searchpanel>
            </xpath>
        </field>
    </record>
</odoo>
