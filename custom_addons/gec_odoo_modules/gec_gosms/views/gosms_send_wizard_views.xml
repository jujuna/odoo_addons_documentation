<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="gosms_send_wizard_view_form" model="ir.ui.view">
        <field name="name">gosms.send.wizard.form</field>
        <field name="model">gosms.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Send SMS">
                <group>
                    <field name="numbers" placeholder="e.g. 555 12 34 56, 599 00 00 00" required="1"/>
                    <field name="body" required="1"/>
                    <field name="urgent"/>
                </group>
                <footer>
                    <button string="Send" type="object" name="action_send" class="btn btn-primary" data-hotkey="q"/>
                    <button special="cancel" data-hotkey="z" class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="gosms_send_wizard_action" model="ir.actions.act_window">
        <field name="name">Send SMS</field>
        <field name="res_model">gosms.send.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
