<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="gosms_confirm_wizard_view_form" model="ir.ui.view">
        <field name="name">gosms.confirm.wizard.form</field>
        <field name="model">gosms.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="SMS Code">
                <sheet>
                    <h3 class="fw-normal">Type the code from the SMS:</h3>
                    <field name="code" class="o_field_highlight col-10 col-md-6 px-0" placeholder="Code" autocomplete="one-time-code"/>
                    <div class="text-muted mt-2" invisible="not attempts_left">Attempts left: <field name="attempts_left" class="d-inline"/></div>
                </sheet>
                <footer>
                    <button string="Confirm" type="object" name="action_confirm" class="btn btn-primary" data-hotkey="q"
                            context="{'gosms_code': code}"/>
                    <button string="Send a New Code" type="object" name="action_resend" class="btn btn-secondary" data-hotkey="r"/>
                    <button special="cancel" data-hotkey="z" class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
