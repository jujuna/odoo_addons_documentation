#. module: stock_account
#: model:ir.model.fields,help:stock_account.field_product_category__property_stock_valuation_account_id
msgid "When automated inventory valuation is enabled on a product, this account will hold the current value of the products."
msgstr "როდესაც პროდუქტზე ჩართულია მარაგის ავტომატური შეფასება, ეს ანგარიში ინახავს პროდუქტების მიმდინარე ღირებულებას."

#. module: stock_account
#: model:ir.model.fields,help:stock_account.field_product_category__property_stock_journal
msgid "When doing automated inventory valuation, this is the Accounting Journal in which entries will be automatically posted when stock moves are processed."
msgstr "მარაგის ავტომატური შეფასებისას ეს არის ბუღალტრული ჟურნალი, რომელშიც გატარებები ავტომატურად დაიდება მარაგის მოძრაობების დამუშავებისას."

#. module: stock_account
#: model:ir.model.fields,help:stock_account.field_product_category__property_price_difference_account_id model:ir.model.fields,help:stock_account.field_product_product__property_price_difference_account_id model:ir.model.fields,help:stock_account.field_product_template__property_price_difference_account_id
msgid "With perpetual valuation, this account will hold the price difference between the standard price and the bill price."
msgstr "უწყვეტი შეფასებისას ეს ანგარიში ინახავს ფასთა სხვაობას სტანდარტულ ფასსა და ანგარიშ-ფაქტურის ფასს შორის."

#. module: stock_account
#. odoo-python
#: code:addons/stock_account/models/product.py:0
msgid "You can only get the standard price at a given date for products with 'Standard Price' as cost method."
msgstr "სტანდარტული ფასის მიღება მოცემულ თარიღზე შესაძლებელია მხოლოდ იმ პროდუქტებისთვის, რომელთა თვითღირებულების მეთოდია 'სტანდარტული ფასი'."

#. module: stock_account
#. odoo-python
#: code:addons/stock_account/models/product.py:0
msgid "You can only use the '=' operator to search on valuation field."
msgstr "შეფასების ველზე ძიებისთვის შეგიძლიათ მხოლოდ '=' ოპერატორის გამოყენება."

#. module: stock_account
#. odoo-python
#: code:addons/stock_account/models/stock_picking.py:0
msgid "You cannot modify the scheduled date of this operation because it falls within a locked fiscal period."
msgstr "ვერ შეცვლით ამ ოპერაციის დაგეგმილ თარიღს, რადგან ის ჩაკეტილ საფინანსო პერიოდში ხვდება."
