#. odoo-python
#: code:addons/stock/models/stock_picking_type.py:0 model:ir.model.fields.selection,name:stock.selection__stock_picking__search_date_category__yesterday model_terms:ir.ui.view,arch_db:stock.view_picking_internal_search
msgid "Yesterday"
msgstr "გუშინ"

#. module: stock
#: model_terms:ir.ui.view,arch_db:stock.stock_quant_relocate_view_form
msgid ""
"You are about to move quantities in a package without moving the full package.\n"
"                    Those quantities will be removed from the following package(s):"
msgstr ""
"აპირებთ შეფუთვაში რაოდენობების გადაადგილებას მთელი შეფუთვის გადაადგილების გარეშე.\n"
"                    ეს რაოდენობები წაიშლება შემდეგი შეფუთვ(ებ)იდან:"

#. module: stock
#: model_terms:ir.ui.view,arch_db:stock.view_stock_quant_form
msgid ""
"You are going to pick products that are not referenced\n"
"in this location. That leads to a negative stock."
msgstr ""
"აპირებთ ისეთი პროდუქტების აღებას, რომლებიც ამ ადგილას\n"
"არ არის მითითებული. ეს უარყოფით მარაგამდე მიგვიყვანს."

#. module: stock
#: model_terms:ir.actions.act_window,help:stock.action_orderpoint_replenish
msgid "You are good, no replenishment to perform!"
msgstr "ყველაფერი რიგზეა, შესასრულებელი შევსება არ არის!"

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_lot.py:0
msgid "You are not allowed to change the product linked to a serial or lot number if some stock moves have already been created with that number. This would lead to inconsistencies in your stock."
msgstr "არ გაქვთ უფლება შეცვალოთ სერიულ ან პარტიის ნომერთან დაკავშირებული პროდუქტი, თუ ამ ნომრით მარაგის მოძრაობები უკვე შეიქმნა. ეს თქვენს მარაგში შეუსაბამობებამდე მიგვიყვანს."

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_lot.py:0
msgid "You are not allowed to create a lot or serial number with this operation type. To change this, go on the operation type and tick the box \"Create New Lots/Serial Numbers\"."
msgstr "არ გაქვთ უფლება ამ ტიპის ოპერაციით შექმნათ პარტია ან სერიული ნომერი. ამის შესაცვლელად გადადით ოპერაციის ტიპზე და მონიშნეთ ველი „ახალი პარტიების/სერიული ნომრების შექმნა“."

#. module: stock
#: model_terms:ir.ui.view,arch_db:stock.stock_package_destination_form_view
msgid "You are trying to put products going to different locations into the same package"
msgstr "თქვენ ცდილობთ სხვადასხვა მდებარეობაზე მიმავალი პროდუქტების ერთსა და იმავე შეკვრაში მოთავსებას"

#. module: stock
#: model_terms:ir.actions.act_window,help:stock.action_routes_form
msgid ""
"You can define here the main routes that run through\n"
"                your warehouses and that define the flows of your products. These\n"
"                routes can be assigned to a product, a product category or be fixed\n"
"                on procurement or sales order."
msgstr ""
"აქ შეგიძლიათ განსაზღვროთ ძირითადი მარშრუტები, რომლებიც\n"
"                თქვენს საწყობებს გაივლის და თქვენი პროდუქტების ნაკადებს განსაზღვრავს. ეს\n"
"                მარშრუტები შეიძლება მიენიჭოს პროდუქტს, პროდუქტის კატეგორიას, ან ფიქსირდეს\n"
"                შესყიდვის ან გაყიდვის შეკვეთაზე."

#. module: stock
#: model_terms:ir.ui.view,arch_db:stock.stock_inventory_conflict_form_view
msgid "You can either :"
msgstr "შეგიძლიათ ან:"

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_orderpoint.py:0
msgid "You can not create a snoozed orderpoint that is not manually triggered."
msgstr "ვერ შექმნით გადავადებულ შეკვეთის წერტილს, რომელიც ხელით არ არის გააქტიურებული."

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_move.py:0
msgid "You can not delete moves linked to another operation"
msgstr "ვერ წაშლით სხვა ოპერაციასთან დაკავშირებულ გადაადგილებებს"

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_move_line.py:0
msgid "You can not enter negative quantities."
msgstr "უარყოფითი რაოდენობების შეყვანა შეუძლებელია."

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_move.py:0
msgid "You can only enter positive quantities."
msgstr "შეგიძლიათ შეიყვანოთ მხოლოდ დადებითი რაოდენობები."

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_lot.py:0
msgid "You can only move a lot/serial to a new location if it exists in a single location."
msgstr "პარტიის/სერიულის ახალ მდებარეობაზე გადატანა შეგიძლიათ მხოლოდ იმ შემთხვევაში, თუ ის ერთ მდებარეობაში არსებობს."

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_quant.py:0
msgid "You can only move positive quantities stored in locations used by a single company per relocation."
msgstr "თითო გადაადგილებაზე შეგიძლიათ გადაიტანოთ მხოლოდ დადებითი რაოდენობები, რომლებიც ინახება ერთი კომპანიის მიერ გამოყენებულ მდებარეობებში."

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_move_line.py:0
msgid "You can only process 1.0 %s of products with unique serial number."
msgstr "უნიკალური სერიული ნომრის მქონე პროდუქტების მხოლოდ 1.0 %s-ის დამუშავება შეგიძლიათ."

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_orderpoint.py:0
msgid "You can only snooze manual orderpoints. You should rather archive 'auto-trigger' orderpoints if you do not want them to be triggered."
msgstr "მხოლოდ ხელით შეკვეთის წერტილების გადავადება შეგიძლიათ. სასურველია, დაარქივოთ „ავტოგამოძახების“ შეკვეთის წერტილები, თუ არ გსურთ მათი გამოძახება."

#. module: stock
#. odoo-python
#: code:addons/stock/models/res_config_settings.py:0
msgid "You can't deactivate the multi-location feature if you have more than one warehouse per company"
msgstr "ვერ გამორთავთ მრავალმდებარეობიანობის ფუნქციას, თუ ერთ კომპანიაზე ერთზე მეტი საწყობი გაქვთ"

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_location.py:0
msgid "You can't disable locations %s because they still contain products."
msgstr "ვერ გამორთავთ მდებარეობებს %s, რადგან ისინი ჯერ კიდევ შეიცავს პროდუქტებს."

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_location.py:0
msgid "You cannot archive location %(location)s because it is used by warehouse %(warehouse)s"
msgstr "ვერ დაარქივებთ მდებარეობას %(location)s, რადგან მას იყენებს საწყობი %(warehouse)s"

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_move.py:0
msgid "You cannot cancel a stock move that has been set to 'Done'. Create a return in order to reverse the moves which took place."
msgstr "ვერ გააუქმებთ მარაგის მოძრაობას, რომელიც „შესრულებულად“ არის დაყენებული. მომხდარი მოძრაობების უკუქცევისთვის შექმენით დაბრუნება."

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_move.py:0
msgid "You cannot change a cancelled stock move, create a new line instead."
msgstr "გაუქმებული მარაგის გადაადგილების შეცვლა არ შეგიძლიათ, სანაცვლოდ შექმენით ახალი ხაზი."

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_picking.py:0
msgid "You cannot change the Scheduled Date on a cancelled transfer."
msgstr "გაუქმებულ გადატანაზე დაგეგმილი თარიღის შეცვლა შეუძლებელია."

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_move.py:0
msgid "You cannot change the UoM for a stock move that has been set to 'Done'."
msgstr "ვერ შეცვლით ზ.ე.-ს მარაგის გადაადგილებისთვის, რომელიც დაყენებულია „დასრულდა“-ზე."

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_lot.py:0
msgid "You cannot change the company of a lot/serial number currently in a location belonging to another company."
msgstr "ვერ შეცვლით პარტიის/სერიული ნომრის კომპანიას, რომელიც ამჟამად სხვა კომპანიის კუთვნილ მდებარეობაშია."

#. module: stock
#. odoo-python
#: code:addons/stock/models/product.py:0
msgid "You cannot change the ratio of this unit of measure as some products with this UoM have already been moved or are currently reserved."
msgstr "ვერ შეცვლით ამ საზომი ერთეულის კოეფიციენტს, რადგან ამ საზომი ერთეულის მქონე ზოგიერთი პროდუქტი უკვე გადაადგილდა ან ამჟამად დარეზერვებულია."

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_picking_batch.py:0
msgid "You cannot delete Done batch transfers."
msgstr "დასრულებულ ჯგუფურ გადატანებს ვერ წაშლით."

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_quant.py:0
msgid "You cannot duplicate stock quants."
msgstr "მარაგის ქვანტების დუბლირება შეუძლებელია."

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_picking_batch.py:0
msgid "You cannot merge done or cancelled batch/wave transfers."
msgstr "დასრულებულ ან გაუქმებულ ჯგუფურ/ტალღურ გადატანებს ვერ გააერთიანებთ."

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_quant.py:0
msgid "You cannot modify inventory loss quantity"
msgstr "მარაგის დანაკარგის რაოდენობის შეცვლა არ შეგიძლიათ"

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_move_line.py:0
msgid "You cannot pack products into the same package when they are from different transfers with different operation types"
msgstr "ვერ შეაფუთავთ პროდუქტებს ერთსა და იმავე შეკვრაში, როდესაც ისინი სხვადასხვა გადატანიდან, სხვადასხვა ოპერაციის ტიპითაა"

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_location.py:0
msgid "You cannot set a location as a scrap location when it is assigned as a destination location for a manufacturing type operation."
msgstr "ადგილს ჩამოწერის ადგილად ვერ დააყენებთ, როცა ის წარმოების ტიპის ოპერაციისთვის დანიშნულების ადგილად არის მინიჭებული."

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_move.py:0
msgid "You cannot split a draft move. It needs to be confirmed first."
msgstr "მონახაზ გადაადგილებას ვერ გაყოფთ. ჯერ უნდა დადასტურდეს."

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_move.py:0
msgid "You cannot split a stock move that has been set to 'Done' or 'Cancel'."
