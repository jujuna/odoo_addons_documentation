#. module: purchase_stock
#. odoo-python
#: code:addons/purchase_stock/models/purchase_order_line.py:0
msgid "The warehouse of operation type (%(operation_type)s) is inconsistent with location (%(location)s) of reordering rule (%(reordering_rule)s) for product %(product)s. Change the operation type or cancel the request for quotation."
msgstr "ოპერაციის ტიპის (%(operation_type)s) საწყობი არ შეესაბამება პროდუქტის %(product)s შევსების წესის (%(reordering_rule)s) მდებარეობას (%(location)s). შეცვალეთ ოპერაციის ტიპი ან გააუქმეთ შეთავაზების მოთხოვნა."

#. module: purchase_stock
#. odoo-python
#: code:addons/purchase_stock/models/purchase_order_line.py:0
msgid "There is a mismatch between the company the Vendor is restricted to and the company receiving the purchased products. Please ensure the company is the same or that the Contact has no company restriction set."
msgstr "არსებობს შეუსაბამობა კომპანიას, რომლითაც მომწოდებელია შეზღუდული, და შესყიდული პროდუქტების მიმღებ კომპანიას შორის. გთხოვთ, დარწმუნდეთ, რომ კომპანია ერთი და იგივეა ან კონტაქტს კომპანიის შეზღუდვა არ აქვს მითითებული."

#. module: purchase_stock
#. odoo-python
#: code:addons/purchase_stock/models/stock_rule.py:0
msgid "There is no matching vendor price to generate the purchase order for product %s (no vendor defined, minimum quantity not reached, dates not valid, ...). Go on the product form and complete the list of vendors."
msgstr "არ არსებობს მომწოდებლის შესაბამისი ფასი, რომ დაგენერირდეს შესყიდვის ორდერი პროდუქტისთვის %s (მომწოდებელი არ არის განსაზღვრული, მინიმალური რაოდენობა არ არის მიღწეული, თარიღები არ არის მოქმედი, ...). გადადით პროდუქტის ფორმაზე და შეავსეთ მომწოდებლების სია."

#. module: purchase_stock
#: model_terms:ir.ui.view,arch_db:purchase_stock.res_config_settings_view_form_purchase
msgid "This adds a Replenish On Order (MTO) route to apply on products in order to generate on-demand replenishment linked to your sales orders (for example) as soon as they are confirmed, with a direct link. Purchase orders, manufacturing orders, etc. are triggered based on what way to replenish is set on the product (Buy or Manufacture route)."
msgstr "ეს ამატებს „შეკვეთით შევსების“ (MTO) მარშრუტს პროდუქტებზე გამოსაყენებლად, რომ დადასტურებისთანავე შეიქმნას მოთხოვნისამებრი შევსება, დაკავშირებული, მაგალითად, თქვენს გაყიდვის შეკვეთებთან, პირდაპირი ბმულით. შესყიდვის შეკვეთები, წარმოების შეკვეთები და სხვა გამოიძახება იმის მიხედვით, შევსების რომელი გზაა დაყენებული პროდუქტზე (ყიდვის თუ წარმოების მარშრუტი)."

#. module: purchase_stock
#: model_terms:ir.ui.view,arch_db:purchase_stock.res_config_settings_view_form_purchase
msgid "This adds a dropshipping route to apply on products in order to request your vendors to deliver to your customers. A product to dropship will generate a purchase request for quotation once the sales order confirmed. This is a on-demand flow. The requested delivery address will be the customer delivery address and not your warehouse."
msgstr "ეს ამატებს დროპშიპინგის მარშრუტს პროდუქტებზე გამოსაყენებლად, რომ მომწოდებლებს სთხოვოთ პირდაპირ თქვენს კლიენტებთან მიწოდება. დროპშიპინგისთვის განკუთვნილი პროდუქტი გაყიდვის შეკვეთის დადასტურებისთანავე შესყიდვის შეთავაზების მოთხოვნას დააგენერირებს. ეს მოთხოვნისამებრი პროცესია. მოთხოვნილი მიწოდების მისამართი იქნება კლიენტის მიწოდების მისამართი და არა თქვენი საწყობი."

