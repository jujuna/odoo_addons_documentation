#. module: gec_brand_kit
#: model:ir.module.module,description:base.module_gec_brand_kit
msgid ""
"\n"
"Upload one ZIP (brand.json + images + optional font files) under Settings > Brand Kit and apply\n"
"it: the backend colors are compiled from the kit through Odoo's SCSS variables (light and dark\n"
"mode), the logo and report colors are written to every company, and the favicon, browser title,\n"
"web-app manifest and home menu background follow the kit. Reset restores Odoo's default look.\n"
"One brand per database.\n"
msgstr ""
"\n"
"ატვირთეთ ერთი ZIP (brand.json + სურათები + სურვილისამებრ შრიფტის ფაილები) მენიუში\n"
"პარამეტრები > ბრენდის ნაკრები და გამოიყენეთ: სისტემის ფერები იქმნება ნაკრებიდან Odoo-ს SCSS\n"
"ცვლადებით (ღია და მუქი რეჟიმი), ლოგო და ანგარიშების ფერები იწერება ყველა კომპანიაში, ხოლო\n"
"ფავიკონი, ბრაუზერის სათაური, ვებაპლიკაციის მანიფესტი და მთავარი ეკრანის ფონი ნაკრებს მიჰყვება.\n"
"დაბრუნება აღადგენს Odoo-ს ნაგულისხმევ იერს. ერთი ბრენდი ერთ ბაზაზე.\n"

#. module: gec_brand_kit
#. odoo-python
#: code:addons/gec_brand_kit/wizard/gec_brand_kit_import.py:0
msgid ""
"\"%(name)s\" (%(key)s) is referenced in brand.json but missing from the ZIP."
msgstr ""
"„%(name)s“ (%(key)s) მითითებულია brand.json-ში, მაგრამ ZIP-ში არ არის."

#. module: gec_brand_kit
#. odoo-python
#: code:addons/gec_brand_kit/wizard/gec_brand_kit_import.py:0
msgid "\"%s\" is larger than 5 MB."
msgstr "„%s“ 5 მბ-ზე დიდია."

#. module: gec_brand_kit
#. odoo-python
#: code:addons/gec_brand_kit/wizard/gec_brand_kit_import.py:0
msgid "\"%s\" is not a readable image."
msgstr "„%s“ წაკითხვადი სურათი არ არის."

#. module: gec_brand_kit
#. odoo-python
#: code:addons/gec_brand_kit/models/gec_brand_kit.py:0
#: code:addons/gec_brand_kit/wizard/gec_brand_kit_import.py:0
msgid "\"%s\" is not a woff2, woff or ttf font."
msgstr "„%s“ woff2, woff ან ttf შრიფტი არ არის."

#. module: gec_brand_kit
#. odoo-python
#: code:addons/gec_brand_kit/wizard/gec_brand_kit_import.py:0
msgid "\"%s\": images must be png, jpg or webp."
msgstr "„%s“: სურათი უნდა იყოს png, jpg ან webp."

#. module: gec_brand_kit
#. odoo-python
#: code:addons/gec_brand_kit/wizard/gec_brand_kit_import.py:0
msgid "\"colors\" and \"dark\" must be objects."
msgstr "„colors“ და „dark“ ობიექტები უნდა იყოს."

#. module: gec_brand_kit
#. odoo-python
#: code:addons/gec_brand_kit/wizard/gec_brand_kit_import.py:0
msgid "\"files\" may only contain %s."
msgstr "„files“ შეიძლება შეიცავდეს მხოლოდ: %s."

#. module: gec_brand_kit
#. odoo-python
#: code:addons/gec_brand_kit/wizard/gec_brand_kit_import.py:0
msgid "\"font\" must be a font name or {\"family\": ..., \"files\": {...}}."
msgstr "„font“ უნდა იყოს შრიფტის სახელი ან {\"family\": ..., \"files\": {...}}."

#. module: gec_brand_kit
#. odoo-python
#: code:addons/gec_brand_kit/wizard/gec_brand_kit_import.py:0
msgid "\"style\" must be one of: %s."
msgstr "„style“ უნდა იყოს ერთ-ერთი: %s."

#. module: gec_brand_kit
#. odoo-python
#: code:addons/gec_brand_kit/models/gec_brand_kit.py:0
msgid "%(mode)s: %(what)s is too low (%(ratio).1f:1, at least 3:1 needed)."
msgstr ""
"%(mode)s: %(what)s ძალიან დაბალია (%(ratio).1f:1, საჭიროა მინიმუმ 3:1)."

