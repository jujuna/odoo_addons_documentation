<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="gec_brand_kit_view_form" model="ir.ui.view">
        <field name="name">gec.brand.kit.form</field>
        <field name="model">gec.brand.kit</field>
        <field name="arch" type="xml">
            <form string="Brand Kit" create="false" delete="false" duplicate="false">
                <header>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary" invisible="state == 'applied' and not unapplied_changes"
                            confirm="Apply this brand to the whole database? The logo, report colors and font of every company are overwritten."/>
                    <button name="action_open_import" type="object" string="Import Kit" class="btn-secondary"/>
                    <button name="action_apply" type="object" string="Apply" class="btn-secondary" invisible="state != 'applied' or unapplied_changes"
                            confirm="Apply this brand to the whole database? The logo, report colors and font of every company are overwritten."/>
                    <button name="action_reset" type="object" string="Reset to Odoo Default"
                            invisible="state != 'applied'" confirm="Restore Odoo's default look? Company logos and report colors stay as they are."/>
                    <button name="action_export" type="object" string="Export Kit" invisible="not color_primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status" invisible="color_primary">
                        Import a brand kit ZIP with <strong>Import Kit</strong>, or pick a ready-made palette below and adjust it.
                    </div>
                    <field name="unapplied_changes" invisible="1"/>
                    <div class="alert alert-warning" role="alert" invisible="not unapplied_changes">
                        <strong>Saved, but not applied yet.</strong> Click <strong>Apply</strong> so users see these changes.
                    </div>
                    <div class="alert alert-info" role="status" invisible="not color_primary or unapplied_changes">
                        Changes are saved here first; users see them only after <strong>Apply</strong>.
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Odoo"/></h1>
                    </div>
                    <group>
                        <group string="Style">
                            <field name="palette"/>
                            <field name="ui_style" widget="radio"/>
                        </group>
                        <group string="Readability">
                            <field name="readability" nolabel="1" colspan="2" readonly="1"/>
                            <div colspan="2" class="text-muted" invisible="readability">Pick a palette or fill in the colors.</div>
                        </group>
                    </group>
                    <separator string="Live Preview"/>
                    <widget name="gec_brand_preview"/>
                    <group>
                        <group string="Light Mode">
                            <field name="color_primary" widget="color"/>
                            <field name="color_action" widget="color"/>
                            <field name="color_accent" widget="color"/>
                            <field name="color_background" widget="color"/>
                            <field name="color_surface" widget="color"/>
                            <field name="color_text" widget="color"/>
                            <field name="color_success" widget="color"/>
                            <field name="color_warning" widget="color"/>
                            <field name="color_danger" widget="color"/>
                            <field name="color_info" widget="color"/>
                        </group>
                        <group string="Dark Mode">
                            <field name="dark_primary" widget="color"/>
                            <field name="dark_action" widget="color"/>
                            <field name="dark_background" widget="color"/>
                            <field name="dark_surface" widget="color"/>
                            <field name="dark_text" widget="color"/>
                        </group>
                    </group>
                    <group>
                        <group string="Font">
                            <field name="font"/>
                            <field name="font_sample" nolabel="1" colspan="2" readonly="1" invisible="not font_sample"/>
                        </group>
                        <group string="Own Font Files" invisible="font">
                            <field name="font_family" placeholder="e.g. FiraGO"/>
                            <field name="font_regular" filename="font_regular_name"/>
                            <field name="font_regular_name" invisible="1"/>
                            <field name="font_bold" filename="font_bold_name"/>
                            <field name="font_bold_name" invisible="1"/>
                            <field name="font_italic" filename="font_italic_name"/>
                            <field name="font_italic_name" invisible="1"/>
                            <field name="font_bold_italic" filename="font_bold_italic_name"/>
                            <field name="font_bold_italic_name" invisible="1"/>
                        </group>
                    </group>
                    <group string="Images">
                        <group>
                            <field name="logo" widget="image" options="{'size': [0, 80]}"/>
                            <field name="favicon" widget="image" options="{'size': [0, 48]}"/>
                        </group>
                        <group>
                            <field name="home_background" widget="image" options="{'size': [0, 180]}"/>
                            <field name="login_background" widget="image" options="{'size': [0, 180]}"/>
                        </group>
                    </group>
                    <group string="Applied">
                        <group>
                            <field name="applied_date"/>
                            <field name="applied_uid"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="gec_brand_kit_action" model="ir.actions.act_window">
        <field name="name">Brand Kit</field>
        <field name="res_model">gec.brand.kit</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="brand_kit"/>
        <field name="target">current</field>
    </record>

    <menuitem id="gec_brand_kit_menu" name="Brand Kit" parent="base.menu_administration"
              action="gec_brand_kit_action" sequence="4" groups="base.group_system"/>
</odoo>
