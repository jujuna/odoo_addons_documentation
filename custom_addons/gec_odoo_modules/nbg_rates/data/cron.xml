<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_fetch_nbg_rates" model="ir.cron">
        <field name="name">Fetch NBG Currency Rates (EUR, USD)</field>
        <field name="model_id" ref="base.model_res_currency"/>
        <field name="state">code</field>
        <field name="code">model._cron_fetch_nbg_rates()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 20:00:00')"/>
    </record>
</odoo>
