<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_basisbank_api_log_list" model="ir.ui.view">
        <field name="name">basisbank.api.log.list</field>
        <field name="model">basisbank.api.log</field>
        <field name="arch" type="xml">
            <list string="API Logs" create="false" edit="false" delete="false">
                <field name="create_date"/>
                <field name="connection_id"/>
                <field name="endpoint"/>
                <field name="http_status"/>
                <field name="error_code"
                       decoration-success="error_code == 0"
                       decoration-danger="error_code not in (0, False)"/>
                <field name="error_message"/>
                <field name="duration_ms"/>
            </list>
        </field>
    </record>

    <record id="view_basisbank_api_log_form" model="ir.ui.view">
        <field name="name">basisbank.api.log.form</field>
        <field name="model">basisbank.api.log</field>
        <field name="arch" type="xml">
            <form string="API Log" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="connection_id"/>
                            <field name="endpoint"/>
                            <field name="duration_ms"/>
                        </group>
                        <group>
                            <field name="http_status"/>
                            <field name="error_code"/>
                            <field name="error_message"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Request" name="request">
                            <field name="request_payload" widget="text" readonly="1"/>
                        </page>
                        <page string="Response" name="response">
                            <field name="response_payload" widget="text" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_basisbank_api_log" model="ir.actions.act_window">
        <field name="name">API Logs</field>
        <field name="res_model">basisbank.api.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
