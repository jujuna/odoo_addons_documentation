<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_basisbank" model="ir.ui.view">
        <field name="name">account.journal.form.basisbank</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Basis Bank" invisible="type != 'bank'">
                    <field name="is_basisbank" readonly="1"/>
                    <field name="basisbank_connection_id" readonly="1"
                           invisible="not is_basisbank"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
