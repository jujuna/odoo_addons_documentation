<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_basisbank" model="ir.module.category">
        <field name="name">Basis Bank</field>
        <field name="description">Send transfers and import statements via Basis Bank API.</field>
        <field name="sequence">25</field>
    </record>

    <record id="basisbank_privilege" model="res.groups.privilege">
        <field name="name">Basis Bank</field>
        <field name="category_id" ref="module_category_basisbank"/>
        <field name="sequence">25</field>
    </record>

    <record id="group_basisbank_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="basisbank_privilege"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="group_basisbank_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="basisbank_privilege"/>
        <field name="implied_ids" eval="[(4, ref('group_basisbank_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
