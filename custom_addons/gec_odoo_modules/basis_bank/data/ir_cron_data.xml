<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_basisbank_daily_statement_sync" model="ir.cron">
            <field name="name">Basis Bank — Daily statement sync</field>
            <field name="model_id" ref="model_basisbank_connection"/>
            <field name="state">code</field>
            <field name="code">model._cron_daily_statement_sync()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>

        <record id="cron_basisbank_confirm_or_reset" model="ir.cron">
            <field name="name">Basis Bank — 48h report confirmation check</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="state">code</field>
            <field name="code">model._cron_basisbank_confirm_or_reset()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
