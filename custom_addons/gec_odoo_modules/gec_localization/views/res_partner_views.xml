<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="contact_category_view_list" model="ir.ui.view">
        <field name="name">gec.contact.category.list</field>
        <field name="model">gec.contact.category</field>
        <field name="arch" type="xml">
            <list string="Contact Categories" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="contact_category_view_form" model="ir.ui.view">
        <field name="name">gec.contact.category.form</field>
        <field name="model">gec.contact.category</field>
        <field name="arch" type="xml">
            <form string="Contact Category">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="contact_category_view_search" model="ir.ui.view">
        <field name="name">gec.contact.category.search</field>
        <field name="model">gec.contact.category</field>
        <field name="arch" type="xml">
            <search string="Contact Categories">
                <field name="name"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="contact_category_action" model="ir.actions.act_window">
        <field name="name">Contact Categories</field>
        <field name="res_model">gec.contact.category</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="contact_category_view_search"/>
    </record>

    <menuitem id="menu_contact_categories" name="Contact Categories"
              parent="contacts.menu_contacts" action="contact_category_action"
              sequence="3" groups="base.group_user"/>

    <record id="view_partner_form_contact_categories" model="ir.ui.view">
        <field name="name">res.partner.form.contact.categories</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="gec_contact_category_ids" widget="many2many_tags"
                       options="{'color_field': 'color'}" readonly="parent_id"/>
            </field>
            <xpath expr="//field[@name='child_ids']/form/sheet/group[last()]" position="inside">
                <field name="gec_contact_category_ids" widget="many2many_tags"
                       options="{'color_field': 'color'}" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_partner_search_contact_categories" model="ir.ui.view">
        <field name="name">res.partner.search.contact.categories</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="gec_contact_category_ids"/>
            </field>
            <xpath expr="//search" position="inside">
                <searchpanel view_types="list,kanban">
                    <field name="gec_contact_category_ids" string="Contact Categories"
                           icon="group" select="multi" expand="1" limit="false"/>
                </searchpanel>
            </xpath>
        </field>
    </record>

    <record id="view_partner_property_form_ge_default_taxes" model="ir.ui.view">
        <field name="name">res.partner.property.form.ge.default.taxes</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <field name="property_account_position_id" position="after">
                <field name="property_sale_tax_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="property_purchase_tax_id" options="{'no_create': True, 'no_open': True}"/>
            </field>
        </field>
    </record>

    <record id="view_partner_property_form_ge_treasury_code" model="ir.ui.view">
        <field name="name">res.partner.property.form.ge.treasury.code</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <field name="bank_ids" position="after">
                <field name="gec_treasury_code" invisible="parent_id"/>
            </field>
        </field>
    </record>
</odoo>
