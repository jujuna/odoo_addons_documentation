<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_l10n_ge_cit_wizard_form" model="ir.ui.view">
    <field name="name">l10n.ge.cit.wizard.form</field>
    <field name="model">l10n.ge.cit.wizard</field>
    <field name="arch" type="xml">
      <form string="Georgian Profit Distribution (CIT)">
        <field name="company_id" invisible="1"/>
        <field name="currency_id" invisible="1"/>
        <group>
          <group>
            <field name="journal_id"/>
            <field name="date"/>
            <field name="partner_id"/>
            <field name="net_amount"/>
          </group>
          <group>
            <field name="gross_amount"/>
            <field name="cit_amount"/>
            <field name="dividend_wht_amount" invisible="not apply_dividend_wht"/>
          </group>
        </group>
        <group string="Dividend Withholding (individual / non-resident shareholder)">
          <field name="apply_dividend_wht"/>
          <field name="dividend_wht_tax_id" invisible="not apply_dividend_wht" required="apply_dividend_wht"
                 options="{'no_create': True}"/>
          <field name="dividend_wht_rate" invisible="not apply_dividend_wht" readonly="1"/>
          <field name="dividend_wht_account_id" invisible="not apply_dividend_wht" required="apply_dividend_wht"/>
        </group>
        <group string="Accounts">
          <field name="distribution_account_id"/>
          <field name="cit_account_id"/>
          <field name="cit_tax_id" options="{'no_create': True}"/>
          <field name="treasury_partner_id" options="{'no_create': True}"/>
          <field name="payable_account_id"/>
        </group>
        <footer>
          <button string="Post Distribution" name="action_post_cit" type="object" class="btn-primary"/>
          <button string="Cancel" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_l10n_ge_cit_wizard" model="ir.actions.act_window">
    <field name="name">Profit Distribution (CIT)</field>
    <field name="res_model">l10n.ge.cit.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <menuitem id="menu_l10n_ge_cit_wizard"
            name="Profit Distribution (CIT)"
            action="action_l10n_ge_cit_wizard"
            parent="account.menu_finance_entries"
            groups="account.group_account_manager"/>

</odoo>
