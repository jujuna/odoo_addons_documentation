<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_register_form_gec" model="ir.ui.view">
        <field name="name">account.payment.register.form.gec</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']/following-sibling::field[@name='currency_id']" position="attributes">
                <attribute name="readonly">context.get('gec_wht_tax_line_payment')</attribute>
            </xpath>
        </field>
    </record>
</odoo>
