<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_gec_pay_entry_line" model="ir.ui.view">
        <field name="name">account.move.form.gec.pay.entry.line</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/list" position="inside">
                <field name="gec_can_pay" column_invisible="True"/>
                <button name="action_gec_pay_entry_line" type="object" string="Pay" class="btn-link"
                        invisible="not gec_can_pay" groups="account.group_account_user"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_gec_pay_withholding" model="ir.ui.view">
        <field name="name">account.move.form.gec.pay.withholding</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@id='account_invoice_payment_secondary_btn']" position="after">
                <field name="gec_show_pay_withholding" invisible="1"/>
                <button name="action_gec_pay_withholding_tax" type="object" class="oe_highlight"
                        string="Pay Withholding Tax" invisible="not gec_show_pay_withholding"
                        groups="account.group_account_user"/>
            </xpath>
        </field>
    </record>
</odoo>
