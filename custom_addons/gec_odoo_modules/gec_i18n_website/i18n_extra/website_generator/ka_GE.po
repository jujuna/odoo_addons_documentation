#. module: website_generator
#: model:ir.module.module,description:base.module_website_generator
msgid ""
"\n"
"Generates a new website in Odoo, with the goal of recreating an external website as close as possible.\n"
msgstr ""
"\n"
"აგენერირებს ახალ ვებსაიტს Odoo-ში, გარე ვებსაიტის მაქსიმალურად ზუსტად ხელახლა შექმნის მიზნით.\n"

#. module: website_generator
#: model:mail.template,body_html:website_generator.email_template_website_scrapped
msgid ""
"<div>\n"
"                    <t t-if=\"ctx.get('website_url') and ctx.get('nbr_products_created') and ctx.get('nbr_products_created') &gt; 0 and ctx.get('nbr_blogs_created') and ctx.get('nbr_blogs_created') &gt; 0\">\n"
"                        <p><b>Great news!</b> Your website has been generated, and <t t-out=\"ctx.get('nbr_products_created')\"/> products and <t t-out=\"ctx.get('nbr_blogs_created')\"/> blog posts have been created.</p>\n"
"                    </t>\n"
"                    <t t-elif=\"ctx.get('website_url') and ctx.get('nbr_products_created') and ctx.get('nbr_products_created') &gt; 0\">\n"
"                        <p><b>Great news!</b> Your website has been generated and <t t-out=\"ctx.get('nbr_products_created')\"/> product(s) have been created.</p>\n"
"                    </t>\n"
"                    <t t-elif=\"ctx.get('website_url') and ctx.get('nbr_blogs_created') and ctx.get('nbr_blogs_created') &gt; 0\">\n"
"                        <p><b>Great news!</b> Your website has been generated and <t t-out=\"ctx.get('nbr_blogs_created')\"/> blog posts have been created.</p>\n"
"                    </t>\n"
"                    <t t-elif=\"ctx.get('website_url')\">\n"
"                        <p><b>Great news!</b> Your website has been successfully generated.</p>\n"
"                    </t>    \n"
"                    <t t-elif=\"ctx.get('nbr_products_created') and ctx.get('nbr_products_created') &gt; 0 and ctx.get('nbr_blogs_created') and ctx.get('nbr_blogs_created') &gt; 0\">\n"
"                        <p><b>Great news!</b> The import tool successfully created <t t-out=\"ctx.get('nbr_products_created')\"/> products and <t t-out=\"ctx.get('nbr_blogs_created')\"/> blog posts.</p>\n"
"                    </t>\n"
"                    <t t-elif=\"ctx.get('nbr_products_created') and ctx.get('nbr_products_created') &gt; 0\">\n"
"                        <p><b>Great news!</b> The import tool successfully created <t t-out=\"ctx.get('nbr_products_created')\"/> product(s).</p>\n"
"                    </t>\n"
"                    <t t-elif=\"ctx.get('nbr_blogs_created') and ctx.get('nbr_blogs_created') &gt; 0\">\n"
"                        <p><b>Great news!</b> The import tool successfully created <t t-out=\"ctx.get('nbr_blogs_created')\"/> blog post(s).</p>\n"
"                    </t>\n"
"                    <t t-else=\"\">\n"
"                        <p><b>Update:</b> We were unable to generate your website or products this time.</p>\n"
"                        <p>This may happen for a variety of reasons, such as:</p>\n"
"                        <ul>\n"
"                            <li>Protection mechanisms on your website preventing automated access,</li>\n"
"                            <li>Temporary maintenance or limited availability on our servers,</li>\n"
"                            <li>Custom code or configurations on your website that are not fully compatible with our process.</li>\n"
"                        </ul>\n"
"                        <p>Feel free to try again later or contact us if the issue persists — we’re here to help!</p>\n"
"                    </t>\n"
"\n"
"            <t t-if=\"ctx.get('website_url')\">\n"
"                <p>You can access your website by clicking the button below:</p>\n"
"                <div style=\"margin: 16px 0px 16px 0px;\">\n"
"                    <a t-att-href=\"ctx.get('website_url')\" style=\"background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;\">\n"
"                        Go to Website\n"
"                    </a>\n"
"                </div>\n"
"            </t>\n"
"            \n"
"            <p>Thank you for choosing Odoo for your web integration!</p>\n"
"            <p>Best regards,</p>\n"
"            <br/>\n"
"            <p>Odoo - The best open source website builder.</p>\n"
"            </div>\n"
"            "
msgstr ""
"<div>\n"
"                    <t t-if=\"ctx.get('website_url') and ctx.get('nbr_products_created') and ctx.get('nbr_products_created') &gt; 0 and ctx.get('nbr_blogs_created') and ctx.get('nbr_blogs_created') &gt; 0\">\n"
"                        <p><b>კარგი ამბავი!</b> თქვენი ვებსაიტი დაგენერირდა, ასევე შეიქმნა <t t-out=\"ctx.get('nbr_products_created')\"/> პროდუქტი და <t t-out=\"ctx.get('nbr_blogs_created')\"/> ბლოგპოსტი.</p>\n"
"                    </t>\n"
"                    <t t-elif=\"ctx.get('website_url') and ctx.get('nbr_products_created') and ctx.get('nbr_products_created') &gt; 0\">\n"
"                        <p><b>კარგი ამბავი!</b> თქვენი ვებსაიტი დაგენერირდა და შეიქმნა <t t-out=\"ctx.get('nbr_products_created')\"/> პროდუქტი.</p>\n"
"                    </t>\n"
"                    <t t-elif=\"ctx.get('website_url') and ctx.get('nbr_blogs_created') and ctx.get('nbr_blogs_created') &gt; 0\">\n"
"                        <p><b>კარგი ამბავი!</b> თქვენი ვებსაიტი დაგენერირდა და შეიქმნა <t t-out=\"ctx.get('nbr_blogs_created')\"/> ბლოგპოსტი.</p>\n"
"                    </t>\n"
"                    <t t-elif=\"ctx.get('website_url')\">\n"
"                        <p><b>კარგი ამბავი!</b> თქვენი ვებსაიტი წარმატებით დაგენერირდა.</p>\n"
"                    </t>    \n"
"                    <t t-elif=\"ctx.get('nbr_products_created') and ctx.get('nbr_products_created') &gt; 0 and ctx.get('nbr_blogs_created') and ctx.get('nbr_blogs_created') &gt; 0\">\n"
"                        <p><b>კარგი ამბავი!</b> იმპორტის ხელსაწყომ წარმატებით შექმნა <t t-out=\"ctx.get('nbr_products_created')\"/> პროდუქტი და <t t-out=\"ctx.get('nbr_blogs_created')\"/> ბლოგპოსტი.</p>\n"
"                    </t>\n"
"                    <t t-elif=\"ctx.get('nbr_products_created') and ctx.get('nbr_products_created') &gt; 0\">\n"
"                        <p><b>კარგი ამბავი!</b> იმპორტის ხელსაწყომ წარმატებით შექმნა <t t-out=\"ctx.get('nbr_products_created')\"/> პროდუქტი.</p>\n"
"                    </t>\n"
"                    <t t-elif=\"ctx.get('nbr_blogs_created') and ctx.get('nbr_blogs_created') &gt; 0\">\n"
"                        <p><b>კარგი ამბავი!</b> იმპორტის ხელსაწყომ წარმატებით შექმნა <t t-out=\"ctx.get('nbr_blogs_created')\"/> ბლოგპოსტი.</p>\n"
"                    </t>\n"
"                    <t t-else=\"\">\n"
"                        <p><b>განახლება:</b> ამჯერად თქვენი ვებსაიტის ან პროდუქტების დაგენერირება ვერ მოვახერხეთ.</p>\n"
"                        <p>ეს შეიძლება მოხდეს სხვადასხვა მიზეზით, მაგალითად:</p>\n"
"                        <ul>\n"
"                            <li>თქვენი ვებსაიტის დაცვის მექანიზმები, რომლებიც ავტომატურ წვდომას ხელს უშლის,</li>\n"
"                            <li>დროებითი ტექმომსახურება ან შეზღუდული ხელმისაწვდომობა ჩვენს სერვერებზე,</li>\n"
"                            <li>თქვენი ვებსაიტის მორგებული კოდი ან კონფიგურაციები, რომლებიც სრულად არ არის თავსებადი ჩვენს პროცესთან.</li>\n"
"                        </ul>\n"
"                        <p>სცადეთ ხელახლა მოგვიანებით ან დაგვიკავშირდით, თუ პრობლემა კვლავ გრძელდება — სიამოვნებით დაგეხმარებით!</p>\n"
"                    </t>\n"
"\n"
"            <t t-if=\"ctx.get('website_url')\">\n"
"                <p>თქვენს ვებსაიტზე გადასვლა შეგიძლიათ ქვემოთ მოცემულ ღილაკზე დაწკაპუნებით:</p>\n"
"                <div style=\"margin: 16px 0px 16px 0px;\">\n"
"                    <a t-att-href=\"ctx.get('website_url')\" style=\"background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;\">\n"
"                        ვებსაიტზე გადასვლა\n"
"                    </a>\n"
"                </div>\n"
"            </t>\n"
"            \n"
"            <p>გმადლობთ, რომ ვებინტეგრაციისთვის Odoo აირჩიეთ!</p>\n"
"            <p>პატივისცემით,</p>\n"
"            <br/>\n"
"            <p>Odoo - საუკეთესო ღია კოდის ვებსაიტის კონსტრუქტორი.</p>\n"
"            </div>\n"
"            "

