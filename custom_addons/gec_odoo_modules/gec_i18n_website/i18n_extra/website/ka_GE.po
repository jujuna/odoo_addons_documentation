#. module: website
#: model_terms:ir.ui.view,arch_db:website.s_quotes_carousel_compact model_terms:ir.ui.view,arch_db:website.s_quotes_carousel_minimal
msgid "\" A trusted partner for growth. <br/>Professional, efficient, and always ahead of the curve. \""
msgstr "„სანდო პარტნიორი ზრდისთვის. <br/>პროფესიონალური, ეფექტიანი და მუდამ წინ გამსწრები.“"

#. module: website
#: model_terms:ir.ui.view,arch_db:website.s_quotes_carousel_compact model_terms:ir.ui.view,arch_db:website.s_quotes_carousel_minimal
msgid "\" Outstanding service and results! <br/>They exceeded our expectations in every project. \""
msgstr "„გამორჩეული მომსახურება და შედეგები! <br/>მათ ყოველ პროექტში გადააჭარბეს ჩვენს მოლოდინს.“"

#. module: website
#: model_terms:ir.ui.view,arch_db:website.s_quotes_carousel
msgid "\" Their team understood our needs from day one. The result was a reliable solution that made our daily work much easier. \""
msgstr "\" მათმა გუნდმა ჩვენი საჭიროებები პირველივე დღიდან გაიგო. შედეგად მივიღეთ საიმედო გადაწყვეტა, რომელმაც ჩვენი ყოველდღიური მუშაობა ბევრად გაგვიადვილა. \""

#. module: website
#: model_terms:ir.ui.view,arch_db:website.s_quotes_carousel_compact model_terms:ir.ui.view,arch_db:website.s_quotes_carousel_minimal
msgid "\" This company transformed our business. <br/>Their solutions are innovative and reliable. \""
msgstr "„ამ კომპანიამ ჩვენი ბიზნესი გარდაქმნა. <br/>მათი გადაწყვეტები ინოვაციური და საიმედოა.“"

#. module: website
#: model_terms:ir.ui.view,arch_db:website.s_quotes_carousel
msgid "\" We were impressed by their attention to detail. Every step was clear, efficient, and focused on delivering real value. \""
msgstr "\" მათმა დეტალებისადმი ყურადღებამ ჩვენზე შთაბეჭდილება მოახდინა. ყოველი ნაბიჯი მკაფიო, ეფექტიანი და რეალური ღირებულების შექმნაზე ორიენტირებული იყო. \""

#. module: website
#: model_terms:ir.ui.view,arch_db:website.s_blockquote model_terms:ir.ui.view,arch_db:website.s_quotes_carousel
msgid "\" Write a quote here from one of your customers. Quotes are a great way to build confidence in your products or services. \""
msgstr "\" დაწერეთ აქ ციტატა თქვენი ერთ-ერთი კლიენტისგან. ციტატები შესანიშნავი გზაა თქვენი პროდუქტებისა თუ მომსახურების მიმართ ნდობის ასაშენებლად. \""

#. module: website
#: model_terms:ir.ui.view,arch_db:website.bs_debug_view
msgid "\" alert with a"
msgstr "„ გაფრთხილება"

