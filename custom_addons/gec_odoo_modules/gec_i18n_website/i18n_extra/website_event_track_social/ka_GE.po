#: model:ir.module.module,summary:base.module_website_event_track_social
msgid "Send reminder push notifications to event attendees based on favorites tracks."
msgstr "ღონისძიების მონაწილეებისთვის შეხსენების push შეტყობინებების გაგზავნა რჩეული ტრეკების მიხედვით."

#. module: website_event_track_social
#: model:ir.model,name:website_event_track_social.model_social_post
