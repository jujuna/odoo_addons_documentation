#. module: website_cf_turnstile
#. odoo-javascript
#: code:addons/website_cf_turnstile/static/src/interactions/error_handler.js:0
msgid "Please make sure your credentials for this service are properly set up.\\n"
msgstr "გთხოვთ, დარწმუნდეთ, რომ ამ მომსახურების ავტორიზაციის მონაცემები სწორად არის დაყენებული.\\n"

#. module: website_cf_turnstile
#. odoo-python
#: code:addons/website_cf_turnstile/models/ir_http.py:0
