#: code:addons/website_blog/static/src/tours/website_blog.js:0
msgid "<b>Write your story here.</b> Use the top toolbar to style your text: add an image or table, set bold or italic, etc. Drag and drop building blocks for more graphical blogs."
msgstr "<b>დაწერეთ თქვენი ისტორია აქ.</b> გამოიყენეთ ზედა ხელსაწყოთა ზოლი ტექსტის სტილისთვის: დაამატეთ სურათი ან ცხრილი, დააყენეთ მუქი ან დახრილი და ა.შ. გადმოათრიეთ ბლოკები უფრო გრაფიკული ბლოგებისთვის."

#. module: website_blog
#: model_terms:blog.post,content:website_blog.blog_post_7
msgid "<em class=\"h4 my-0\">\"Do not wait to strike till the iron is hot; but make it hot by striking.\"</em>"
msgstr "<em class=\"h4 my-0\">\"ნუ დაელოდებით რკინის გაცხელებას დასარტყმელად; გააცხელეთ ის დარტყმით.\"</em>"

#. module: website_blog
#: model_terms:blog.post,content:website_blog.blog_post_5
msgid "<em class=\"h4 my-0\">Minimalism isn't about having nothing. It's about making room for everything that matters. Living with intention can lead to more joy, clarity, and freedom.</em>"
msgstr "<em class=\"h4 my-0\">მინიმალიზმი იმას არ ნიშნავს, რომ არაფერი გქონდეთ. ის ნიშნავს ადგილის გამოთავისუფლებას ყველაფრისთვის, რაც მნიშვნელოვანია. გააზრებულ ცხოვრებას შეუძლია მეტი სიხარული, სიცხადე და თავისუფლება მოგიტანოთ.</em>"

#. module: website_blog
#: model_terms:blog.post,content:website_blog.blog_post_3
msgid "<em class=\"h4 my-0\">Productivity isn't about doing more. It's about doing what matters, with focus and intention. Working from home gives you the freedom to shape your day, use it to your advantage.</em>"
msgstr "<em class=\"h4 my-0\">პროდუქტიულობა მეტის კეთებას არ ნიშნავს. ის ნიშნავს იმის კეთებას, რაც მნიშვნელოვანია, ფოკუსითა და გააზრებულად. სახლიდან მუშაობა გაძლევთ თავისუფლებას, თავად ჩამოაყალიბოთ თქვენი დღე, გამოიყენეთ ეს თქვენს სასარგებლოდ.</em>"

#. module: website_blog
#: model_terms:blog.post,content:website_blog.blog_post_1
msgid "<em class=\"h4 my-0\">The best journeys in life are those that answer questions you never thought to ask. Traveling on a budget teaches you to slow down, observe, and appreciate more with less.</em>"
msgstr "<em class=\"h4 my-0\">ცხოვრებაში საუკეთესო მოგზაურობები ისეთებია, რომლებიც პასუხობს კითხვებს, რომელთა დასმაც არასოდეს გიფიქრიათ. შეზღუდული ბიუჯეტით მოგზაურობა გასწავლით, შეანელოთ ტემპი, დააკვირდეთ და ნაკლებით მეტი დააფასოთ.</em>"

#. module: website_blog
#: model_terms:blog.post,content:website_blog.blog_post_6
msgid "<em class=\"h4 my-0\">The best journeys often begin where the guidebook ends. Asia is full of surprises for those willing to look beyond the mainstream.</em>"
msgstr "<em class=\"h4 my-0\">საუკეთესო მოგზაურობები ხშირად იქ იწყება, სადაც გზამკვლევი მთავრდება. აზია სავსეა სიურპრიზებით მათთვის, ვინც მზადაა, პოპულარულ მარშრუტებს მიღმა გაიხედოს.</em>"

#. module: website_blog
#: model_terms:blog.post,content:website_blog.blog_post_2
msgid "<em class=\"h4 my-0\">The best technology doesn't just automate tasks. It adapts to our lives and helps us live better. The rise of smart homes is a shift from control to collaboration between people and their environments.</em>"
msgstr "<em class=\"h4 my-0\">საუკეთესო ტექნოლოგია მხოლოდ ამოცანების ავტომატიზაციით არ შემოიფარგლება. ის ჩვენს ცხოვრებას ერგება და უკეთ ცხოვრებაში გვეხმარება. ჭკვიანი სახლების აღზევება კონტროლიდან ადამიანებსა და მათ გარემოს შორის თანამშრომლობაზე გადასვლაა.</em>"

#. module: website_blog
#: model_terms:blog.post,content:website_blog.blog_post_4
msgid "<em class=\"h4 my-0\">The real question is not whether machines think but whether humans do.</em>"
msgstr "<em class=\"h4 my-0\">მთავარი კითხვა ის კი არ არის, აზროვნებენ თუ არა მანქანები, არამედ ის, აზროვნებენ თუ არა ადამიანები.</em>"

