#. module: website_forum
#: model_terms:ir.ui.view,arch_db:website_forum.post_display
msgid ""
"<b class=\"d-block \">This answer has been flagged</b>\n"
"                            As a moderator, you can either validate or reject this answer."
msgstr ""
"<b class=\"d-block \">ეს პასუხი მონიშნულია</b>\n"
"                            როგორც მოდერატორს, შეგიძლიათ ეს პასუხი დაამოწმოთ ან უარყოთ."

#. module: website_forum
#: model_terms:ir.ui.view,arch_db:website_forum.post_description_full
msgid ""
"<b class=\"d-block\">You have a pending post</b>\n"
"                        Please wait for a moderator to validate your previous post to be allowed replying questions."
msgstr ""
"<b class=\"d-block\">გაქვთ მოლოდინში მყოფი პოსტი</b>\n"
"                        დაელოდეთ, სანამ მოდერატორი თქვენს წინა პოსტს დაამოწმებს, რომ კითხვებზე პასუხის უფლება მიიღოთ."

#. module: website_forum
#: model_terms:forum.forum,faq:website_forum.forum_help model_terms:ir.ui.view,arch_db:website_forum.default_faq
msgid "<b>Answers should not add or expand questions</b>. Instead either edit the question or add a question comment."
msgstr "<b>პასუხები არ უნდა ამატებდეს ან აფართოებდეს კითხვებს</b>. სანაცვლოდ დაარედაქტირეთ კითხვა ან დაამატეთ კითხვის კომენტარი."

#. module: website_forum
#: model_terms:forum.forum,faq:website_forum.forum_help model_terms:ir.ui.view,arch_db:website_forum.default_faq
msgid "<b>Answers should not add or expand questions</b>. Instead, either edit the question or add a comment."
msgstr "<b>პასუხები არ უნდა ამატებდეს ან აფართოებდეს კითხვებს</b>. სანაცვლოდ დაარედაქტირეთ კითხვა ან დაამატეთ კომენტარი."

#. module: website_forum
#: model_terms:forum.forum,faq:website_forum.forum_help model_terms:ir.ui.view,arch_db:website_forum.default_faq
msgid "<b>Answers should not comment other answers</b>. Instead add a comment on the other answers."
msgstr "<b>პასუხები არ უნდა აკომენტარებდეს სხვა პასუხებს</b>. სანაცვლოდ დაამატეთ კომენტარი სხვა პასუხებზე."

#. module: website_forum
#: model_terms:forum.forum,faq:website_forum.forum_help model_terms:ir.ui.view,arch_db:website_forum.default_faq
msgid "<b>Answers should not start debates</b> This community Q&amp;A is not a discussion group. Please avoid holding debates in your answers as they tend to dilute the essence of questions and answers. For brief discussions please use commenting facility."
msgstr "<b>პასუხები არ უნდა იწყებდეს დებატებს</b> ეს საზოგადოების კითხვა-პასუხი განხილვის ჯგუფი არ არის. მოერიდეთ პასუხებში დებატებს, რადგან ისინი კითხვებისა და პასუხების არსს ანელებს. მოკლე განხილვებისთვის გამოიყენეთ კომენტარების ფუნქცია."

#. module: website_forum
#: model_terms:forum.forum,faq:website_forum.forum_help model_terms:ir.ui.view,arch_db:website_forum.default_faq
msgid "<b>Answers shouldn't just point to other Questions</b>. Instead add a question comment indication \"Possible duplicate of...\". However, it's ok to include links to other questions or answers providing relevant additional information."
msgstr "<b>პასუხები არ უნდა მიუთითებდეს მხოლოდ სხვა კითხვებზე</b>. სანაცვლოდ დაამატეთ კითხვის კომენტარი მინიშნებით „შესაძლო დუბლიკატი...“. თუმცა დასაშვებია სხვა კითხვების ან პასუხების ბმულების ჩართვა, თუ ისინი რელევანტურ დამატებით ინფორმაციას იძლევა."

#. module: website_forum
#: model_terms:forum.forum,faq:website_forum.forum_help model_terms:ir.ui.view,arch_db:website_forum.default_faq
msgid "<b>Answers shouldn't just point to other questions</b>.Instead add a comment indicating <i>\"Possible duplicate of...\"</i>. However, it's fine to include links to other questions or answers providing relevant additional information."
msgstr "<b>პასუხები არ უნდა მიუთითებდეს მხოლოდ სხვა კითხვებზე</b>. სანაცვლოდ დაამატეთ კომენტარი მინიშნებით <i>„შესაძლო დუბლიკატი...“</i>. თუმცა დასაშვებია სხვა კითხვების ან პასუხების ბმულების ჩართვა, თუ ისინი რელევანტურ დამატებით ინფორმაციას იძლევა."

#. module: website_forum
#: model_terms:forum.forum,faq:website_forum.forum_help model_terms:ir.ui.view,arch_db:website_forum.default_faq
msgid "<b>Answers shouldn't just provide a link a solution</b>. Instead provide the solution description text in your answer, even if it's just a copy/paste. Links are welcome, but should be complementary to answer, referring sources or additional reading."
msgstr "<b>პასუხები არ უნდა იძლეოდეს მხოლოდ გადაწყვეტის ბმულს</b>. სანაცვლოდ პასუხში მოიყვანეთ გადაწყვეტის აღწერა, თუნდაც კოპირებული. ბმულები მისაღებია, მაგრამ პასუხის დამატება უნდა იყოს — წყაროების ან დამატებითი წაკითხვის მითითება."

#. module: website_forum
#: model_terms:forum.forum,faq:website_forum.forum_help model_terms:ir.ui.view,arch_db:website_forum.default_faq
msgid "<b>Before you ask - please make sure to search for a similar question.</b> You can search questions by their title or tags. It’s also OK to answer your own question."
msgstr "<b>კითხვის დასმამდე აუცილებლად მოძებნეთ მსგავსი კითხვა.</b> კითხვების ძიება შეგიძლიათ სათაურით ან ტეგებით. საკუთარ კითხვაზე პასუხიც დასაშვებია."

#. module: website_forum
#: model_terms:forum.forum,faq:website_forum.forum_help model_terms:ir.ui.view,arch_db:website_forum.default_faq
msgid "<b>Please avoid asking questions that are too subjective and argumentative</b> or not relevant to this community."
msgstr "<b>მოერიდეთ ისეთი კითხვების დასმას, რომლებიც ძალიან სუბიექტური და კამათისმომგვრელია</b> ან ამ საზოგადოებისთვის არარელევანტურია."

#. module: website_forum
#: model_terms:ir.ui.view,arch_db:website_forum.post_answer
msgid ""
"<b>Please try to give a substantial answer.</b> If you wanted to comment on the question or answer, just\n"
"            <b>use the commenting tool.</b> Please remember that you can always <b>revise your answers</b>\n"
"            - no need to answer the same question twice. Also, please <b>don't forget to vote</b>\n"
"            - it really helps to select the best questions and answers!"
msgstr ""
"<b>შეეცადეთ, არსებითი პასუხი გასცეთ.</b> თუ კითხვის ან პასუხის კომენტირება გსურდათ, უბრალოდ\n"
"            <b>გამოიყენეთ კომენტარების ხელსაწყო.</b> გახსოვდეთ, რომ ყოველთვის შეგიძლიათ <b>გადაამუშაოთ თქვენი პასუხები</b>\n"
"            — ერთი კითხვაზე ორჯერ პასუხი საჭირო არ არის. ასევე, <b>არ დაგავიწყდეთ ხმის მიცემა</b>\n"
"            — ეს ნამდვილად ეხმარება საუკეთესო კითხვებისა და პასუხების შერჩევაში!"

#. module: website_forum
#: model_terms:ir.ui.view,arch_db:website_forum.faq_karma
msgid "<b>Why can other people edit my questions/answers?</b>"
msgstr "<b>რატომ შეუძლიათ სხვებს ჩემი კითხვების/პასუხების რედაქტირება?</b>"

#. module: website_forum
