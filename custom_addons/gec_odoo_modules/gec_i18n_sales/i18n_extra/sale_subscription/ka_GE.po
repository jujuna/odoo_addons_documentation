#. odoo-python
#: code:addons/sale_subscription/models/sale_order_line.py:0
msgid "(*) These recurring products are discounted according to the prorated period from %(start)s to %(end)s"
msgstr "(*) ამ განმეორებად პროდუქტებზე ფასდაკლება გამოითვლება პროპორციული პერიოდის მიხედვით %(start)s-იდან %(end)s-მდე"

#. module: sale_subscription
#. odoo-python
#: code:addons/sale_subscription/models/sale_order_line.py:0
msgid "(*) These recurring products are entirely discounted as the next period has not been invoiced yet."
msgstr "(*) ამ განმეორებად პროდუქტებზე სრული ფასდაკლებაა, რადგან მომდევნო პერიოდი ჯერ არ დაფაქტურებულა"

#. module: sale_subscription
#. odoo-python
#: code:addons/sale_subscription/models/sale_order_line.py:0
