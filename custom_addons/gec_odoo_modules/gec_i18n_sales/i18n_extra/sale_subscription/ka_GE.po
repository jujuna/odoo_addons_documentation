#. module: sale_subscription
msgid ""
"<t>\n"
"<p>Dear <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,</p>\n"
"<p>Your subscription <strong t-out=\"object.name or ''\">Office Cleaning Service\"</strong> needs your attention.</p>\n"
"<p>We invite you to renew it by clicking on the following link.</p>\n"
"<p>Kind regards.</p>\n"
"<p t-out=\"object.user_id.signature or ''\" data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/>Mitchell Admin</p>\n"
"        </t>"
msgstr ""
"<t>\n"
"<p>ძვირფასო <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,</p>\n"
"<p>თქვენი გამოწერა <strong t-out=\"object.name or ''\">ოფისის დასუფთავების მომსახურება\"</strong> ყურადღებას საჭიროებს.</p>\n"
"<p>გთხოვთ, განაახლოთ ის შემდეგ ბმულზე დაწკაპუნებით.</p>\n"
"<p>პატივისცემით.</p>\n"
"<p t-out=\"object.user_id.signature or ''\" data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/>Mitchell Admin</p>\n"
"        </t>"

#. module: sale_subscription
msgid ""
"<t>\n"
"<t t-set=\"company\" t-value=\"object.company_id or object.user_id.company_id or user.company_id\"/>\n"
"Hello <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,<br/><br/>\n"
"<t t-if=\"ctx.get('payment_token') and ctx.get('next_invoice_amount')\">\n"
"    Our final attempt to process a payment for your subscription using your payment method\n"
"    <t t-out=\"ctx.get('payment_token') or ''\">TOKEN</t>\n"
"    for <t t-out=\"ctx['next_invoice_amount'] or ''\">100</t> <t t-out=\"ctx.get('currency') or ''\">$</t> failed.\n"
"    <t t-if=\"ctx.get('error')\">\n"
"        Your bank or credit institution gave the following details about the issue: <pre t-out=\"ctx['error'] or ''\"/>.\n"
"    </t>\n"
"</t>\n"
"<t t-else=\"\">\n"
"    Our final attempt to process a payment for your subscription failed because we have no payment method recorded for you.\n"
"</t>\n"
"<br/><br/>\n"
"As your payment should have been made <strong><t t-out=\"ctx.get('auto_close_limit') or ''\">5</t> days ago</strong>, your subscription has been terminated.\n"
"Should you wish to resolve this issue, do not hesitate to contact us.<br/><br/>\n"
"Thank you for choosing <t t-out=\"company.name or ''\">YourCompany</t>!\n"
"<div t-if=\"user.signature\" data-o-mail-quote-container=\"1\">\n"
"    <br/><br/>\n"
"    <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"</div>\n"
"</t>\n"
"        "
msgstr ""
"<t>\n"
"<t t-set=\"company\" t-value=\"object.company_id or object.user_id.company_id or user.company_id\"/>\n"
"გამარჯობა, <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,<br/><br/>\n"
"<t t-if=\"ctx.get('payment_token') and ctx.get('next_invoice_amount')\">\n"
"    თქვენი გამოწერისთვის გადახდის დამუშავების ჩვენი ბოლო მცდელობა თქვენი გადახდის მეთოდით\n"
"    <t t-out=\"ctx.get('payment_token') or ''\">TOKEN</t>\n"
"    <t t-out=\"ctx['next_invoice_amount'] or ''\">100</t> <t t-out=\"ctx.get('currency') or ''\">$</t> თანხაზე ვერ შესრულდა.\n"
"    <t t-if=\"ctx.get('error')\">\n"
"        თქვენმა ბანკმა ან საკრედიტო დაწესებულებამ პრობლემის შესახებ შემდეგი დეტალები მოგვაწოდა: <pre t-out=\"ctx['error'] or ''\"/>.\n"
"    </t>\n"
"</t>\n"
"<t t-else=\"\">\n"
"    თქვენი გამოწერისთვის გადახდის დამუშავების ჩვენი ბოლო მცდელობა ვერ შესრულდა, რადგან თქვენი გადახდის მეთოდი არ გვაქვს დაფიქსირებული.\n"
"</t>\n"
"<br/><br/>\n"
"რადგან გადახდა უნდა განხორციელებულიყო <strong><t t-out=\"ctx.get('auto_close_limit') or ''\">5</t> დღის წინ</strong>, თქვენი გამოწერა შეწყდა.\n"
"თუ ამ საკითხის მოგვარება გსურთ, უყოყმანოდ დაგვიკავშირდით.<br/><br/>\n"
"გმადლობთ, რომ აირჩიეთ <t t-out=\"company.name or ''\">YourCompany</t>!\n"
"<div t-if=\"user.signature\" data-o-mail-quote-container=\"1\">\n"
"    <br/><br/>\n"
"    <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"</div>\n"
"</t>\n"
"        "

#. module: sale_subscription
msgid ""
"<t>\n"
"<t t-set=\"company\" t-value=\"object.company_id or object.user_id.company_id or user.company_id\"/>\n"
"Hello <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,<br/><br/>\n"
"<t t-if=\"ctx.get('payment_token') and ctx.get('next_invoice_amount')\">\n"
"    We were unable to process a payment for your subscription using your payment method\n"
"    <t t-out=\"ctx['payment_token'] or ''\">TOKEN</t>\n"
"    for <t t-out=\"ctx['next_invoice_amount'] or ''\">10</t> <t t-out=\"ctx.get('currency_name') or ''\">$</t>.\n"
"    <t t-if=\"ctx.get('error')\">\n"
"        Your bank or credit institution gave the following details about the issue: <pre t-out=\"ctx['error'] or ''\"/>.\n"
"    </t>\n"
"</t>\n"
"<t t-else=\"\">\n"
"    Your subscription <t t-out=\"object.client_order_ref or ''\">CODE</t> is due for renewal but we haven’t received your payment yet. To keep your subscription active, please make your payment as soon as possible.\n"
"</t>\n"
"<br/><br/>\n"
"Your subscription <t t-out=\"object.client_order_ref or ''\">CODE</t> will be <strong>suspended</strong>\n"
"<t t-out=\"(ctx.get('date_close') and ('on ' + format_date(ctx.get('date_close')))) or 'soon'\">05/05/2021</t>\n"
"if payment is not received.<br/>\n"
"<div style=\"margin: 16px 0px; text-align: center;\">\n"
"    <a t-attf-href=\"{{ ctx.get('payment_link', object.get_portal_url()) }}\" t-attf-style=\"display: inline-block; padding: 10px 30px; text-decoration: none; background-color: {{company.email_secondary_color or '#875A7B'}}; color: {{company.email_primary_color or '#FFFFFF'}}; border-radius: 5px;\">\n"
"        Pay Now\n"
"    </a>\n"
"</div>\n"
"<br/>\n"
"If you have any questions, do not hesitate to contact us.<br/><br/>\n"
"Thank you for choosing <t t-out=\"company.name or ''\">YourCompany</t>!\n"
"<div>\n"
"<t t-if=\"user.signature\">\n"
"    <br/><br/>\n"
"    <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"</t>\n"
"</div>\n"
"</t>\n"
"        "
msgstr ""
"<t>\n"
"<t t-set=\"company\" t-value=\"object.company_id or object.user_id.company_id or user.company_id\"/>\n"
"გამარჯობა, <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,<br/><br/>\n"
"<t t-if=\"ctx.get('payment_token') and ctx.get('next_invoice_amount')\">\n"
"    ვერ დავამუშავეთ გადახდა თქვენი გამოწერისთვის თქვენი გადახდის მეთოდით\n"
"    <t t-out=\"ctx['payment_token'] or ''\">TOKEN</t>\n"
"    <t t-out=\"ctx['next_invoice_amount'] or ''\">10</t> <t t-out=\"ctx.get('currency_name') or ''\">$</t> თანხაზე.\n"
"    <t t-if=\"ctx.get('error')\">\n"
"        თქვენმა ბანკმა ან საკრედიტო დაწესებულებამ პრობლემის შესახებ შემდეგი დეტალები მოგვაწოდა: <pre t-out=\"ctx['error'] or ''\"/>.\n"
"    </t>\n"
"</t>\n"
"<t t-else=\"\">\n"
"    თქვენს გამოწერას <t t-out=\"object.client_order_ref or ''\">CODE</t> განახლების ვადა დაუდგა, თუმცა თქვენი გადახდა ჯერ არ მიგვიღია. გთხოვთ, რაც შეიძლება მალე განახორციელოთ გადახდა, რათა თქვენი გამოწერა აქტიური დარჩეს.\n"
"</t>\n"
"<br/><br/>\n"
"თქვენი გამოწერა <t t-out=\"object.client_order_ref or ''\">CODE</t> <strong>შეჩერდება</strong>\n"
"<t t-out=\"(ctx.get('date_close') and ('on ' + format_date(ctx.get('date_close')))) or 'soon'\">05/05/2021</t>,\n"
"თუ გადახდა არ იქნება მიღებული.<br/>\n"
"<div style=\"margin: 16px 0px; text-align: center;\">\n"
"    <a t-attf-href=\"{{ ctx.get('payment_link', object.get_portal_url()) }}\" t-attf-style=\"display: inline-block; padding: 10px 30px; text-decoration: none; background-color: {{company.email_secondary_color or '#875A7B'}}; color: {{company.email_primary_color or '#FFFFFF'}}; border-radius: 5px;\">\n"
"        გადაიხადეთ ახლა\n"
"    </a>\n"
"</div>\n"
"<br/>\n"
"თუ რაიმე შეკითხვა გაქვთ, უყოყმანოდ დაგვიკავშირდით.<br/><br/>\n"
"გმადლობთ, რომ აირჩიეთ <t t-out=\"company.name or ''\">YourCompany</t>!\n"
"<div>\n"
"<t t-if=\"user.signature\">\n"
"    <br/><br/>\n"
"    <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"</t>\n"
"</div>\n"
"</t>\n"
"        "

