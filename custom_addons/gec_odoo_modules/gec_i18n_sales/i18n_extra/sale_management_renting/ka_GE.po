#. module: sale_management_renting
#: model:sale.order.template,name:sale_management_renting.rental_order_template_1
msgid "Couple's Room + Spa Package"
msgstr "ოთახი წყვილისთვის + სპა-პაკეტი"

#. module: sale_management_renting
#: model_terms:ir.actions.act_window,help:sale_management_renting.sale_order_template_action
msgid "Create your quotation template"
msgstr "შექმენით თქვენი შეთავაზების შაბლონი"

#. module: sale_management_renting
#: model:sale.order.template.line,name:sale_management_renting.rental_order_template_line_option_1
msgid "Half-day access to spa facilities including sauna and relaxation area."
msgstr "ნახევარდღიანი წვდომა სპა-ინფრასტრუქტურაზე, საუნისა და დასვენების ზონის ჩათვლით."

#. module: sale_management_renting
#: model:sale.order.template.line,name:sale_management_renting.rental_order_template_line_section_1
msgid "Optional Products"
msgstr "არასავალდებულო პროდუქტები"

#. module: sale_management_renting
#: model:ir.ui.menu,name:sale_management_renting.menu_quotation_template
msgid "Quotation Templates"
msgstr "შეთავაზების შაბლონები"

#. module: sale_management_renting
#: model:ir.actions.act_window,name:sale_management_renting.sale_order_template_action
msgid "Rental Quotation Templates"
msgstr "იჯარის შეთავაზების შაბლონები"

#. module: sale_management_renting
#: model:ir.module.module,shortdesc:base.module_sale_management_renting
msgid "Sale Management for Rental"
msgstr "გაყიდვების მართვა იჯარისთვის"

#. module: sale_management_renting
#: model_terms:ir.actions.act_window,help:sale_management_renting.sale_order_template_action
msgid ""
"Use templates to create polished, professional quotes in minutes.\n"
"                Send these quotes by email and let your customers sign online.\n"
"                Use cross-selling and discounts to push and boost your sales."
msgstr ""
"გამოიყენეთ შაბლონები დახვეწილი, პროფესიული შეთავაზებების წუთებში შესაქმნელად.\n"
"                გააგზავნეთ ეს შეთავაზებები ელფოსტით და მიეცით კლიენტებს ონლაინ ხელმოწერის საშუალება.\n"
"                გამოიყენეთ კროსსელი და ფასდაკლებები გაყიდვების გასაზრდელად."
