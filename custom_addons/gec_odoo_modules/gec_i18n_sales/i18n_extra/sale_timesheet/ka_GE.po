#. module: sale_timesheet
#. odoo-python
#: code:addons/sale_timesheet/models/sale_order.py:0
msgid ""
"\n"
"                <p class=\"o_view_nocontent_smiling_face\">\n"
"                    No activities found. Let's start a new one!\n"
"                </p><p>\n"
"                    Track your working hours by projects every day and invoice this time to your customers.\n"
"                </p>\n"
"            "
msgstr ""
"\n"
"                <p class=\"o_view_nocontent_smiling_face\">\n"
"                    აქტივობები ვერ მოიძებნა. დავიწყოთ ახალი!\n"
"                </p><p>\n"
"                    აღრიცხეთ თქვენი სამუშაო საათები პროექტების მიხედვით ყოველდღიურად და წარუდგინეთ ეს დრო თქვენს კლიენტებს.\n"
"                </p>\n"
"            "

#. module: sale_timesheet
#. odoo-python
#: code:addons/sale_timesheet/models/account_move.py:0 code:addons/sale_timesheet/models/project_project.py:0
msgid ""
"\n"
"                <p class=\"o_view_nocontent_smiling_face\">\n"
"                    Record timesheets\n"
"                </p><p>\n"
"                    You can register and track your workings hours by project every\n"
"                    day. Every time spent on a project will become a cost and can be re-invoiced to\n"
"                    customers if required.\n"
"                </p>\n"
"            "
msgstr ""
"\n"
"                <p class=\"o_view_nocontent_smiling_face\">\n"
"                    აღნიშეთ ტაბელები\n"
"                </p><p>\n"
"                    შეგიძლიათ აღნიშოთ და აკონტროლოთ სამუშაო საათები პროექტების მიხედვით,\n"
"                    ყოველდღიურად. პროექტზე დახარჯული დრო გახდება ხარჯი და, საჭიროებისამებრად,\n"
"                    შესაძლებელია კლიენტზე გადანაწილდეს ფაქტურით.\n"
"                </p>\n"
"            "

#. module: sale_timesheet
#: model:ir.module.module,description:base.module_sale_timesheet
msgid ""
"\n"
"Allows to sell timesheets in your sales order\n"
"=============================================\n"
"\n"
"This module set the right product on all timesheet lines\n"
"according to the order/contract you work on. This allows to\n"
"have real delivered quantities in sales orders.\n"
msgstr ""
"\n"
"თქვენს გაყიდვის შეკვეთაში ტაბელების გაყიდვის საშუალებას იძლევა\n"
"=============================================\n"
"\n"
"ეს მოდული ყველა ტაბელის სტრიქონზე სწორ პროდუქტს აყენებს\n"
"იმ შეკვეთის/კონტრაქტის მიხედვით, რომელზეც მუშაობთ. ეს საშუალებას იძლევა,\n"
"გაყიდვის შეკვეთებში რეალური მიწოდებული რაოდენობები გქონდეთ.\n"

#. module: sale_timesheet
#. odoo-python
#: code:addons/sale_timesheet/models/account_analytic_line.py:0
msgid "'%(missing_plan_names)s' analytic plan(s) required on the analytic distribution of the sale order item '%(so_line_name)s' linked to the timesheet."
msgstr "ტაბელთან დაკავშირებული გაყიდვის შეკვეთის სტრიქონის „%(so_line_name)s“ ანალიტიკურ განაწილებაში სავალდებულოა ანალიტიკური გეგმა (გეგმები): „%(missing_plan_names)s“."

