<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- MoF Order #996 Art.54: the e-invoice must reach the buyer within 30 days. -->
        <record id="cron_rs_einv_check_deadlines" model="ir.cron">
            <field name="name">RS E-Invoice: Deadline Check (Art.54)</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">model._cron_rs_einv_check_deadlines()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <!-- Disabled at install so no SOAP traffic starts before the operator enables it. -->
        <record id="ir_cron_rs_buyer_invoice_sync" model="ir.cron">
            <field name="name">RS E-Invoice: Sync Buyer Invoices</field>
            <field name="model_id" ref="model_rs_einvoice_cron"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_buyer_invoices(lookback_hours=72)</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="False"/>
        </record>

        <!-- Posted buyer-side bills in statuses 1, 2, 5, 8; catches supplier-side corrections and cancellations. -->
        <record id="ir_cron_rs_refresh_buyer_status" model="ir.cron">
            <field name="name">RS E-Invoice: Refresh Buyer Bill Status</field>
            <field name="model_id" ref="model_rs_einvoice_cron"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_buyer_status(batch_size=200)</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="False"/>
        </record>

        <!-- Buyer-side events on our invoices, notably 6 -> 7 (buyer confirmed cancellation; drives auto-reverse). -->
        <record id="ir_cron_rs_refresh_seller_status" model="ir.cron">
            <field name="name">RS E-Invoice: Refresh Seller Invoice Status</field>
            <field name="model_id" ref="model_rs_einvoice_cron"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_seller_status(batch_size=200)</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="False"/>
        </record>

        <!-- No rs.ge call, safe with SOAP crons off; completes GL reversal of 7/8 moves cut off by accept/cancel. -->
        <record id="ir_cron_rs_recover_stranded_cancellations" model="ir.cron">
            <field name="name">RS E-Invoice: Recover Stranded Cancellations</field>
            <field name="model_id" ref="model_rs_einvoice_cron"/>
            <field name="state">code</field>
            <field name="code">model._cron_rs_recover_stranded_cancellations(batch_size=200)</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="False"/>
        </record>

        <!-- Chatter reminder so operators do not forget orphan-resolve. -->
        <record id="ir_cron_rs_escalate_pending" model="ir.cron">
            <field name="name">RS E-Invoice: Escalate Stale Pending Actions</field>
            <field name="model_id" ref="model_rs_einvoice_cron"/>
            <field name="state">code</field>
            <field name="code">model._cron_escalate_pending_actions(age_hours=24)</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>

        <record id="ir_cron_rs_stuck_sends" model="ir.cron">
            <field name="name">RS E-Invoice: Detect Stuck Buyer Confirmations</field>
            <field name="model_id" ref="model_rs_einvoice_cron"/>
            <field name="state">code</field>
            <field name="code">model._cron_detect_stuck_sends(age_days=7)</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>

        <record id="ir_cron_rs_log_vacuum" model="ir.cron">
            <field name="name">RS E-Invoice: Vacuum Logs</field>
            <field name="model_id" ref="model_rs_einvoice_cron"/>
            <field name="state">code</field>
            <field name="code">model._cron_vacuum_rs_logs()</field>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>

    </data>
</odoo>
