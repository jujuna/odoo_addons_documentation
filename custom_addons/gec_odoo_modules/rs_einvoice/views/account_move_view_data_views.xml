<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_rs_einvoice_view_data" model="ir.ui.view">
        <field name="name">account.move.form.rs.einvoice.view.data</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_rs_view_current_data"
                        string="View RS Data"
                        type="object"
                        class="btn-secondary"
                        icon="zoom_in"
                        invisible="not rs_einv_id or rs_einv_is_spec"/>
            </xpath>
        </field>
    </record>

</odoo>
