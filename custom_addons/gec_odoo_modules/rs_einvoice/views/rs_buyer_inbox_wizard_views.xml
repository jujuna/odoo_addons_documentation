<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rs_buyer_inbox_wizard_form" model="ir.ui.view">
        <field name="name">rs.einvoice.inbox.wizard.form</field>
        <field name="model">rs.einvoice.inbox.wizard</field>
        <field name="arch" type="xml">
            <form string="rs.ge Buyer Inbox">
                <sheet>
                    <div class="alert alert-info mb-2" role="alert">
                        <strong>Bulk-import vendor invoices from rs.ge.</strong>
                        Pick a date range, click <em>Search rs.ge</em>, tick
                        the rows you want, then <em>Import Selected</em>.
                        Each row runs the same checks as the per-bill
                        Pull from rs.ge (partner verification, status
                        guard, line auto-import).
                    </div>

                    <group>
                        <group string="Filters">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="only_actionable"/>
                        </group>
                        <group string="Optional">
                            <field name="seller_tin" placeholder="e.g. 404444444"/>
                            <field name="invoice_no" placeholder="rs.ge invoice number fragment"/>
                        </group>
                    </group>

                    <div>
                        <button name="action_search"
                                string="Search rs.ge"
                                type="object"
                                class="btn btn-primary"
                                icon="search"/>
                        <button name="action_import_selected"
                                string="Import Selected"
                                type="object"
                                class="btn btn-success ms-2"
                                icon="download"
                                invisible="not line_ids"
                                confirm="For each selected row Odoo will create a draft vendor bill and call 'Pull from rs.ge'. Continue?"/>
                        <button name="action_toggle_all"
                                string="Select / Unselect All"
                                type="object"
                                class="btn btn-secondary ms-2"
                                icon="check_box"
                                invisible="not line_ids"/>
                        <field name="last_search_info" readonly="1" nolabel="1" class="ms-3 text-muted d-inline-block"/>
                    </div>

                    <field name="line_ids" nolabel="1" class="mt-3">
                        <list editable="bottom" decoration-success="import_status == 'imported'"
                              decoration-danger="import_status == 'error'"
                              decoration-muted="already_imported and import_status != 'imported'">
                            <field name="selected" widget="boolean_toggle"/>
                            <field name="rs_inv_id" readonly="1"/>
                            <field name="f_series" readonly="1" optional="show"/>
                            <field name="f_number" readonly="1" optional="show"/>
                            <field name="reg_dt" readonly="1"/>
                            <field name="operation_dt" readonly="1"/>
                            <field name="status" readonly="1" widget="badge"
                                   decoration-success="status in ('2', '8')"
                                   decoration-warning="status in ('1', '5', '6')"
                                   decoration-info="status in ('0', '4')"
                                   decoration-muted="status == '3'"/>
                            <field name="seller_tin" readonly="1"/>
                            <field name="seller_name" readonly="1"/>
                            <field name="amount" readonly="1" sum="Total"/>
                            <field name="k_type" readonly="1" optional="hide"/>
                            <field name="partner_id" readonly="already_imported"
                                   domain="[('vat', '=', seller_tin), ('company_id', 'in', [False, current_company_id])]"
                                   options="{'no_create': True}"/>
                            <field name="already_imported" readonly="1" widget="boolean_toggle" optional="show"/>
                            <field name="existing_move_id" readonly="1" optional="show"/>
                            <field name="import_status" readonly="1" widget="badge"
                                   decoration-success="import_status == 'imported'"
                                   decoration-danger="import_status == 'error'"/>
                            <field name="import_note" readonly="1"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rs_buyer_inbox_wizard" model="ir.actions.act_window">
        <field name="name">rs.ge Inbox (Buyer)</field>
        <field name="res_model">rs.einvoice.inbox.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Pull vendor invoices from rs.ge
            </p>
            <p>
                Use filters above and click <em>Search rs.ge</em> to list every
                invoice where your company is the buyer. Tick the rows you
                want, click <em>Import Selected</em>, and Odoo will create
                draft vendor bills with the rs.ge data already linked.
            </p>
        </field>
    </record>

    <menuitem id="menu_rs_buyer_inbox"
              name="rs.ge Inbox"
              parent="account.menu_finance_payables"
              action="action_rs_buyer_inbox_wizard"
              sequence="40"/>

</odoo>
