"                                    <i class=\"oi rse-status-card__icon rse-status-card__icon--info\" data-icon=\"edit_square\" title=\"მონახაზი rs.ge-ზე\" role=\"img\" aria-label=\"მონახაზი rs.ge-ზე\" invisible=\"rs_einv_rejection_note or rs_einv_latest_status not in ('0', '4')\"/>\n"
"                                    <i class=\"oi rse-status-card__icon rse-status-card__icon--muted\" data-icon=\"history\" title=\"ჩანაცვლებულია კორექტირებით\" role=\"img\" aria-label=\"ჩანაცვლებულია კორექტირებით\" invisible=\"rs_einv_rejection_note or rs_einv_latest_status != '3'\"/>"

