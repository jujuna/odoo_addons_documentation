"                                    <i class=\"oi rse-status-card__icon rse-status-card__icon--info\" data-icon=\"edit_square\" title=\"Draft on rs.ge\" role=\"img\" aria-label=\"Draft on rs.ge\" invisible=\"rs_einv_rejection_note or rs_einv_latest_status not in ('0', '4')\"/>\n"
"                                    <i class=\"oi rse-status-card__icon rse-status-card__icon--muted\" data-icon=\"history\" title=\"Superseded by correction\" role=\"img\" aria-label=\"Superseded by correction\" invisible=\"rs_einv_rejection_note or rs_einv_latest_status != '3'\"/>"
msgstr ""
"<i class=\"oi rse-status-card__icon rse-status-card__icon--success\" data-icon=\"check_circle\" title=\"დადასტურებული\" role=\"img\" aria-label=\"დადასტურებული\" invisible=\"rs_einv_rejection_note or rs_einv_latest_status not in ('2', '8')\"/>\n"
