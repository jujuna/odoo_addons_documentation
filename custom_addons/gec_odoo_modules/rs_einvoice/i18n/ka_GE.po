msgid ""
"<i class=\"oi rse-status-card__icon rse-status-card__icon--success\" data-icon=\"check_circle\" title=\"Confirmed\" role=\"img\" aria-label=\"Confirmed\" invisible=\"rs_einv_rejection_note or rs_einv_latest_status not in ('2', '8')\"/>\n"
"                                    <i class=\"oi rse-status-card__icon rse-status-card__icon--warning rse-status-card__icon--pulse\" data-icon=\"schedule\" title=\"Pending\" role=\"img\" aria-label=\"Pending\" invisible=\"rs_einv_rejection_note or rs_einv_latest_status not in ('1', '5', '6')\"/>\n"
