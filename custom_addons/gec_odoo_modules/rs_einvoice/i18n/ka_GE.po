msgstr "ჯამი (დღგ+აქციზი)"

#. module: rs_einvoice
#: model_terms:ir.ui.view,arch_db:rs_einvoice.view_move_form_rs_einvoice
msgid "Total Qty"
msgstr "ჯამური რაოდ."

#. module: rs_einvoice
#: model_terms:ir.ui.view,arch_db:rs_einvoice.view_move_form_rs_einvoice
msgid "Total VAT"
msgstr "სულ დღგ"

#. module: rs_einvoice
#: model:ir.model.fields,field_description:rs_einvoice.field_rs_einvoice_view_wizard__total_vat_charge
msgid "Total Vat Charge"
msgstr "სულ დასარიცხი დღგ-ს თანხა"

#. module: rs_einvoice
#: model:ir.model.fields,field_description:rs_einvoice.field_rs_einvoice_view_wizard__total_vat_reduce
msgid "Total Vat Reduce"
msgstr "სულ შესამცირებელი დღგ-ს თანხა"

#. module: rs_einvoice
#: model_terms:ir.ui.view,arch_db:rs_einvoice.view_rs_replace_preview_wizard_form
msgid "Total corrected"
msgstr "ჯამი კორექტირებული"

#. module: rs_einvoice
#: model_terms:ir.ui.view,arch_db:rs_einvoice.view_rs_replace_preview_wizard_form
msgid "Total original"
msgstr "ჯამი ორიგინალი"

#. module: rs_einvoice
#: model:ir.model.fields,help:rs_einvoice.field_account_bank_statement_line__rs_einv_is_buyer_side
#: model:ir.model.fields,help:rs_einvoice.field_account_move__rs_einv_is_buyer_side
msgid ""
"True for vendor bills/credit notes. Switches the RS E-Invoice tab to buyer "
"actions."
msgstr ""
"True მომწოდებლის ანგარიშ-ფაქტურებისთვის/საკრედიტო ანგარიშ-ფაქტურებისთვის. "
"„RS ელ. ანგარიშ-ფაქტურა“ ჩანართს მყიდველის ქმედებებზე გადართავს."

#. module: rs_einvoice
#: model:ir.model.fields,help:rs_einvoice.field_account_bank_statement_line__rs_einv_has_pending_changes
#: model:ir.model.fields,help:rs_einvoice.field_account_move__rs_einv_has_pending_changes
msgid "True when Odoo lines have changed since the last sync."
msgstr "True, როცა Odoo-ს სტრიქონები ბოლო სინქრონიზაციის შემდეგ შეიცვალა."

#. module: rs_einvoice
#: model:ir.model.fields,help:rs_einvoice.field_account_move_line__rs_synced
msgid ""
"True when rs.ge has this line in its current Odoo form. False after local "
"edits, deletion, or cancellation."
msgstr ""
"True, როცა rs.ge-ზე ეს სტრიქონი მიმდინარე Odoo სახით არის. False ლოკალური "
