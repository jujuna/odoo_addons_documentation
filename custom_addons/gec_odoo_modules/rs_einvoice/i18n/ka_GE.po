#. module: rs_einvoice
#: model:ir.model.fields,field_description:rs_einvoice.field_rs_einvoice_replace_preview_line__correction_amount
msgid "Corrected Amount"
msgstr "კორექტირებული თანხა"

#. module: rs_einvoice
#: model:ir.model.fields.selection,name:rs_einvoice.selection__rs_einvoice_inbox_line__status__3
msgid "Corrected Original"
msgstr "კორექტირებული ორიგინალი"

#. module: rs_einvoice
#: model:ir.model.fields.selection,name:rs_einvoice.selection__account_move__rs_einv_replacement_mode__correction
msgid "Corrected version of old RS invoice"
msgstr "ძველი RS ანგარიშ-ფაქტურის კორექტირებული ვერსია"

#. module: rs_einvoice
#: model:ir.model.fields,field_description:rs_einvoice.field_rs_einvoice_correction_line__correction_id
#: model_terms:ir.ui.view,arch_db:rs_einvoice.view_move_form_rs_einvoice
msgid "Correction"
msgstr "კორექტირება"

#. module: rs_einvoice
#: model:ir.model.fields.selection,name:rs_einvoice.selection__account_move__rs_einv_latest_status__8
#: model:ir.model.fields.selection,name:rs_einvoice.selection__account_move__rs_einv_status__8
#: model:ir.model.fields.selection,name:rs_einvoice.selection__rs_einvoice_correction__status__8
