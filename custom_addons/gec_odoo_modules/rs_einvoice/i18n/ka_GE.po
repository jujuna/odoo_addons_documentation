#: model_terms:ir.ui.view,arch_db:rs_einvoice.view_move_form_rs_einvoice
msgid ""
"<i class=\"oi me-2\" data-icon=\"archive\" role=\"img\" aria-label=\"Settled\"/>\n"
"                            <strong>Cancelled on rs.ge — document is settled.</strong>"
msgstr ""
"<i class=\"oi me-2\" data-icon=\"archive\" role=\"img\" aria-label=\"დახურული\"/>\n"
"                            <strong>გაუქმებულია rs.ge-ზე — დოკუმენტი დახურულია.</strong>"

#. module: rs_einvoice
#: model_terms:ir.ui.view,arch_db:rs_einvoice.view_move_form_rs_einvoice
msgid ""
"<i class=\"oi me-2\" data-icon=\"autorenew\" role=\"img\" aria-label=\"Replacement in flight\"/>\n"
"                            <strong>Replacement in progress.</strong>\n"
"                            This invoice stays posted until rs.ge accepts its replacement (see <em>Replaced By</em>);\n"
"                            until then both count in the sale order, and once the replacement is posted also in\n"
"                            revenue and VAT. Exclude it at month-end close."
msgstr ""
"<i class=\"oi me-2\" data-icon=\"autorenew\" role=\"img\" aria-label=\"ჩანაცვლება მიმდინარეობს\"/>\n"
"                            <strong>ჩანაცვლება მიმდინარეობს.</strong>\n"
"                            ეს ანგარიშ-ფაქტურა გატარებული რჩება, სანამ rs.ge მის ჩამნაცვლებელ ანგარიშ-ფაქტურას არ მიიღებს (იხ. <em>ჩანაცვლებულია</em>);\n"
"                            მანამდე ორივე აისახება გაყიდვის შეკვეთაში, ხოლო ჩამნაცვლებლის გატარების შემდეგ —\n"
"                            შემოსავალსა და დღგ-შიც. თვის დახურვისას ეს ანგარიშ-ფაქტურა გამორიცხეთ."

#. module: rs_einvoice
#: model_terms:ir.ui.view,arch_db:rs_einvoice.view_move_form_rs_einvoice
msgid ""
"<i class=\"oi me-2\" data-icon=\"block\" title=\"Skip rs.ge\" role=\"img\" aria-label=\"Skip rs.ge\"/>\n"
"                            <strong>VAT-NEUTRAL — Skip rs.ge active.</strong>\n"
"                            No correction will be filed.\n"
"                            Reason:"
msgstr ""
"<i class=\"oi me-2\" data-icon=\"block\" title=\"rs.ge-ს გამოტოვება\" role=\"img\" aria-label=\"rs.ge-ს გამოტოვება\"/>\n"
"                            <strong>დღგ-ნეიტრალური — rs.ge-ს გამოტოვება ჩართულია.</strong>\n"
"                            კორექტირება rs.ge-ზე არ წარდგება.\n"
"                            მიზეზი:"

#. module: rs_einvoice
#: model_terms:ir.ui.view,arch_db:rs_einvoice.view_move_form_rs_einvoice
msgid ""
"<i class=\"oi me-2\" data-icon=\"cancel\" role=\"img\" aria-label=\"Rejection\"/>\n"
"                            <strong>You rejected this on rs.ge.</strong>"
msgstr ""
"<i class=\"oi me-2\" data-icon=\"cancel\" role=\"img\" aria-label=\"უარყოფა\"/>\n"
"                            <strong>თქვენ უარყავით ეს დოკუმენტი rs.ge-ზე.</strong>"

#. module: rs_einvoice
#: model_terms:ir.ui.view,arch_db:rs_einvoice.view_move_form_rs_einvoice
msgid "<i class=\"oi me-2\" data-icon=\"error\" role=\"img\" aria-label=\"Deadline missed\"/>"
msgstr ""
"<i class=\"oi me-2\" data-icon=\"error\" role=\"img\" aria-label=\"ვადა "
"გადაცილებულია\"/>"

#. module: rs_einvoice
#: model_terms:ir.ui.view,arch_db:rs_einvoice.view_move_form_rs_einvoice
msgid ""
"<i class=\"oi me-2\" data-icon=\"error\" role=\"img\" aria-label=\"Not cancelled\"/>\n"
"                            <strong>rs.ge no longer counts this document, but Odoo could not cancel it.</strong>\n"
"                            It stays in the books until the blocker is fixed (payments or credit notes applied, locked period).\n"
"                            Follow the To-Do activity, then click <em>Check Status</em>."
msgstr ""
"<i class=\"oi me-2\" data-icon=\"error\" role=\"img\" aria-label=\"გაუქმებული არ არის\"/>\n"
"                            <strong>rs.ge ამ დოკუმენტს აღარ ითვალისწინებს, მაგრამ Odoo-მ ის ვერ გააუქმა.</strong>\n"
"                            დოკუმენტი ბუღალტერიაში რჩება, სანამ ხელშემშლელი მიზეზი არ აღმოიფხვრება (გამოყენებული გადახდები ან საკრედიტო ანგარიშ-ფაქტურები, ჩაკეტილი პერიოდი).\n"
"                            შეასრულეთ „გასაკეთებელი“ აქტივობა, შემდეგ დააჭირეთ <em>სტატუსის შემოწმება</em>."

#. module: rs_einvoice
#: model_terms:ir.ui.view,arch_db:rs_einvoice.view_move_form_rs_einvoice
msgid ""
"<i class=\"oi me-2\" data-icon=\"error\" role=\"img\" aria-label=\"Pending RS action\"/>\n"
