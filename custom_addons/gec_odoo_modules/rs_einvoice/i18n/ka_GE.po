#. module: rs_einvoice
#. odoo-python
#: code:addons/rs_einvoice/models/account_move.py:0
#: code:addons/rs_einvoice/wizard/rs_buyer_inbox_wizard.py:0
msgid " (and %d more)"
msgstr " (და კიდევ %d)"

#. module: rs_einvoice
#. odoo-python
#: code:addons/rs_einvoice/models/account_move_seller.py:0
msgid ""
" Note: rs.ge refuses corrections of a fully settled advance — if this "
"advance is attached to a delivery invoice (possibly on the rs.ge portal), "
"release it first."
msgstr ""
" შენიშვნა: rs.ge არ იღებს სრულად ჩათვლილი ავანსის კორექტირებას — თუ ეს "
"ავანსი მიბმულია მიწოდების ანგარიშ-ფაქტურაზე (შესაძლოა rs.ge-ს პორტალზე), ჯერ"
" მოხსენით მიბმა."

#. module: rs_einvoice
#: model_terms:ir.ui.view,arch_db:rs_einvoice.view_move_form_rs_einvoice
msgid ""
"#996 Art.54 requires the e-invoice to reach the buyer within 30 days.\n"
"                            Click <em>Send to Buyer</em> promptly to avoid a tax penalty."
msgstr ""
"№996 ბრძანების 54-ე მუხლით ელ. ანგარიშ-ფაქტურა მყიდველს 30 დღეში უნდა "
"მიუვიდეს.\n"
"                            საგადასახადო ჯარიმის თავიდან ასაცილებლად დროულად"
" დააჭირეთ <em>მყიდველთან გაგზავნა</em>."

#. module: rs_einvoice
#. odoo-python
#: code:addons/rs_einvoice/models/account_move_cancel.py:0
msgid "%(name)s was accepted on rs.ge but Odoo did not post it: %(reason)s. Fix the cause and click Check Status to retry."
msgstr "%(name)s დადასტურდა rs.ge-ზე, მაგრამ Odoo-მ ვერ გაატარა: %(reason)s. გამოასწორეთ მიზეზი და ხელახლა დააჭირეთ „სტატუსის შემოწმება“."

#. module: rs_einvoice
#. odoo-python
#: code:addons/rs_einvoice/models/account_move.py:0
msgid "%s is posted automatically when the buyer accepts the correction on rs.ge."
msgstr "%s ავტომატურად გაიტარება, როცა მყიდველი rs.ge-ზე კორექტირებას დაადასტურებს."

#. module: rs_einvoice
#. odoo-python
#: code:addons/rs_einvoice/models/account_move_line.py:0
msgid "%s was sent to the buyer on rs.ge: its lines can no longer change."
msgstr "%s rs.ge-ზე მყიდველს გაეგზავნა: მისი სტრიქონები მეტად ვეღარ შეიცვლება."

#. module: rs_einvoice
#. odoo-python
#: code:addons/rs_einvoice/models/account_move_seller.py:0
msgid "%(action)s on CN-driven correction (status: %(old)s → %(new)s)"
msgstr ""
"%(action)s — საკრედიტო ა/ფ-ზე დაფუძნებული კორექტირება (სტატუსი: %(old)s → "
"%(new)s)"

#. module: rs_einvoice
#. odoo-python
#: code:addons/rs_einvoice/models/account_move_seller.py:0
msgid "%(action)s on RS (status: %(old)s → %(new)s)"
msgstr "%(action)s RS-ზე (სტატუსი: %(old)s → %(new)s)"

#. module: rs_einvoice
#. odoo-python
#: code:addons/rs_einvoice/models/account_move_seller.py:0
msgid ""
"%(action)s routed to CN-driven correction %(target)s on move %(move)s "
"(status: %(old)s → %(new)s)"
msgstr ""
"%(action)s გადამისამართდა საკრედიტო ა/ფ-ზე დაფუძნებულ კორექტირებაზე "
"%(target)s, გატარება %(move)s (სტატუსი: %(old)s → %(new)s)"

#. module: rs_einvoice
#. odoo-python
#: code:addons/rs_einvoice/models/account_move_seller.py:0
msgid ""
"%(action)s routed to legacy correction %(target)s (status: %(old)s → "
"%(new)s)"
msgstr ""
"%(action)s გადამისამართდა ძველი ტიპის კორექტირებაზე %(target)s (სტატუსი: "
"%(old)s → %(new)s)"

#. module: rs_einvoice
#. odoo-python
#: code:addons/rs_einvoice/models/account_move_seller.py:0
msgid ""
"%(action)s succeeded on rs.ge (target: %(target)s, new status: %(status)s) "
"but no Odoo record holds that ID. rs.ge and Odoo may now be out of sync — "
"verify on rs.ge and run Check Status on every related document."
msgstr ""
"%(action)s წარმატებით შესრულდა rs.ge-ზე (სამიზნე: %(target)s, ახალი სტატუსი:"
" %(status)s), მაგრამ ამ ID-ს Odoo-ს არცერთი ჩანაწერი არ ფლობს. შესაძლოა "
"rs.ge და Odoo ახლა ერთმანეთს არ ემთხვევა — გადაამოწმეთ rs.ge-ზე და ყველა "
"დაკავშირებულ დოკუმენტზე გაუშვით „სტატუსის შემოწმება“."

#. module: rs_einvoice
#. odoo-python
#: code:addons/rs_einvoice/wizard/rs_replace_preview_wizard.py:0
msgid ""
"%(ok)d pair(s) succeeded. %(fail)d failed:\n"
"\n"
"%(details)s\n"
"\n"
"The failed pairs were not modified — re-open the rs.ge inbox to retry."
msgstr ""
"%(ok)d წყვილი წარმატებით დამუშავდა. %(fail)d ვერ შესრულდა:\n"
"\n"
"%(details)s\n"
"\n"
"წარუმატებელი წყვილები არ შეცვლილა — ხელახლა საცდელად თავიდან გახსენით rs.ge "
"შემოსულები."

#. module: rs_einvoice
#. odoo-python
#: code:addons/rs_einvoice/models/account_move.py:0
msgid ""
"%(original)s already has a replacement (%(replacement)s, %(mode)s). "
"%(guidance)s"
msgstr ""
"%(original)s-ს უკვე აქვს ჩამნაცვლებელი (%(replacement)s, %(mode)s). "
"%(guidance)s"

#. module: rs_einvoice
#. odoo-python
#: code:addons/rs_einvoice/models/account_move.py:0
msgid ""
"%(original)s has a cancelled replacement (%(replacement)s). Use 'Clear "
"Cancelled Replacement' first."
msgstr ""
"%(original)s-ს აქვს გაუქმებული ჩამნაცვლებელი (%(replacement)s). ჯერ "
"გამოიყენეთ „გაუქმებული ჩანაცვლების გასუფთავება“."

#. module: rs_einvoice
#. odoo-python
#: code:addons/rs_einvoice/models/account_move_checks.py:0
msgid ""
"%d line(s) exceed %d characters — rs.ge would truncate them. Shorten the "
"product names or labels."
msgstr ""
"%d სტრიქონი აჭარბებს %d სიმბოლოს — rs.ge მათ შეკვეცს. შეამოკლეთ "
"პროდუქტების ან სტრიქონების დასახელებები."

#. module: rs_einvoice
#. odoo-python
#: code:addons/rs_einvoice/models/account_move_checks.py:0
msgid ""
"%d line(s) have negative quantities — rs.ge rejects these on a regular "
"invoice. Use a credit note."
msgstr ""
"%d სტრიქონს აქვს უარყოფითი რაოდენობა — ჩვეულებრივ ანგარიშ-ფაქტურაზე rs.ge "
"ამას არ იღებს. გამოიყენეთ საკრედიტო ანგარიშ-ფაქტურა."

#. module: rs_einvoice
#. odoo-python
#: code:addons/rs_einvoice/models/account_move_checks.py:0
msgid ""
"%d line(s) have no product or description — rs.ge requires a name on "
"every line."
msgstr ""
"%d სტრიქონს არ აქვს პროდუქტი ან აღწერა — rs.ge ყველა სტრიქონზე "
"დასახელებას მოითხოვს."

#. module: rs_einvoice
#. odoo-python
#: code:addons/rs_einvoice/models/account_move_buyer.py:0
msgid "'%s' is not a valid rs.ge ID — only digits are allowed."
msgstr "„%s“ არასწორი rs.ge ID-ა — დაშვებულია მხოლოდ ციფრები."

#. module: rs_einvoice
#. odoo-python
#: code:addons/rs_einvoice/wizard/rs_buyer_inbox_wizard.py:0
msgid "'Issued From' must be on or before 'Issued To'."
msgstr "„გამოწერის თარიღი (-დან)“ არ უნდა იყოს „გამოწერის თარიღი (-მდე)“-ზე გვიან."

#. module: rs_einvoice
#: model:ir.model.fields,help:rs_einvoice.field_account_bank_statement_line__rs_einv_lines_sync_state
#: model:ir.model.fields,help:rs_einvoice.field_account_move__rs_einv_lines_sync_state
msgid ""
"'partial' when Update on RS aborted mid-sync, leaving rs.ge with mixed "
"lines. Cleared on success."
msgstr ""
"„ნაწილობრივი“ — როცა „RS-ზე განახლება“ სინქრონიზაციის შუაში შეწყდა და "
"rs.ge-ზე შერეული სტრიქონები დარჩა. წარმატებისას სუფთავდება."

#. module: rs_einvoice
#: model_terms:ir.ui.view,arch_db:rs_einvoice.view_move_form_rs_einvoice
msgid ""
").\n"
"                            Click <em>Import Supplier Correction</em> to pull it as a vendor credit note."
msgstr ""
").\n"
"                            მომწოდებლის საკრედიტო ანგარიშ-ფაქტურად "
"ჩამოსატვირთად დააჭირეთ <em>მომწოდებლის კორექტირების იმპორტი</em>."

#. module: rs_einvoice
#: model_terms:ir.ui.view,arch_db:rs_einvoice.view_move_form_rs_einvoice
msgid ""
".\n"
"                            A network timeout may have left an orphan draft on rs.ge.\n"
"                            Click <em>Resolve Orphan</em> after checking your rs.ge drafts list."
msgstr ""
".\n"
"                            შესაძლოა ქსელის ტაიმაუტის გამო rs.ge-ზე ობოლი "
"მონახაზი დარჩა.\n"
"                            rs.ge-ს მონახაზების სიის შემოწმების შემდეგ "
"დააჭირეთ <em>ობოლი ჩანაწერის მოგვარება</em>."

#. module: rs_einvoice
#: model_terms:ir.ui.view,arch_db:rs_einvoice.view_move_form_rs_einvoice
msgid "Uncheck the toggle below to re-enable RS actions."
msgstr "RS ქმედებების ხელახლა ჩასართავად მოხსენით ქვემოთ მოცემული გადამრთველი."

#. module: rs_einvoice
#: model_terms:ir.ui.view,arch_db:rs_einvoice.view_move_form_rs_einvoice
msgid ""
"<i class=\"fa fa-archive me-2\" role=\"img\" aria-label=\"Settled\"/>\n"
"                            <strong>Cancelled on rs.ge — document is settled.</strong>"
msgstr ""
"<i class=\"fa fa-archive me-2\" role=\"img\" aria-label=\"დახურული\"/>\n"
"                            <strong>გაუქმებულია rs.ge-ზე — დოკუმენტი "
"დახურულია.</strong>"

#. module: rs_einvoice
#: model_terms:ir.ui.view,arch_db:rs_einvoice.view_move_form_rs_einvoice
msgid ""
"<i class=\"fa fa-ban me-2\" title=\"Skip rs.ge\" role=\"img\" aria-label=\"Skip rs.ge\"/>\n"
"                            <strong>VAT-NEUTRAL — Skip rs.ge active.</strong>\n"
"                            No correction will be filed.\n"
"                            Reason:"
msgstr ""
"<i class=\"fa fa-ban me-2\" title=\"rs.ge-ს გამოტოვება\" role=\"img\" "
"aria-label=\"rs.ge-ს გამოტოვება\"/>\n"
"                            <strong>დღგ-ნეიტრალური — rs.ge-ს გამოტოვება "
"ჩართულია.</strong>\n"
"                            კორექტირება rs.ge-ზე არ წარდგება.\n"
"                            მიზეზი:"

#. module: rs_einvoice
#: model_terms:ir.ui.view,arch_db:rs_einvoice.view_move_form_rs_einvoice
msgid ""
"<i class=\"fa fa-bell me-2\" role=\"img\" aria-label=\"New supplier correction\"/>\n"
"                            <strong>Supplier issued a correction on rs.ge</strong>\n"
"                            (correction ID"
msgstr ""
"<i class=\"fa fa-bell me-2\" role=\"img\" aria-label=\"მომწოდებლის ახალი "
"კორექტირება\"/>\n"
"                            <strong>მომწოდებელმა rs.ge-ზე კორექტირება "
"გამოწერა</strong>\n"
"                            (კორექტირების ID"

#. module: rs_einvoice
#: model_terms:ir.ui.view,arch_db:rs_einvoice.view_move_form_rs_einvoice
msgid ""
"<i class=\"fa fa-check-circle rse-status-card__icon rse-status-card__icon--success\" title=\"Confirmed\" role=\"img\" aria-label=\"Confirmed\" invisible=\"rs_einv_rejection_note or rs_einv_latest_status not in ('2', '8')\"/>\n"
"                                    <i class=\"fa fa-clock-o rse-status-card__icon rse-status-card__icon--warning rse-status-card__icon--pulse\" title=\"Pending\" role=\"img\" aria-label=\"Pending\" invisible=\"rs_einv_rejection_note or rs_einv_latest_status not in ('1', '5', '6')\"/>\n"
"                                    <i class=\"fa fa-times-circle rse-status-card__icon rse-status-card__icon--danger\" title=\"Rejected or deleted\" role=\"img\" aria-label=\"Rejected or deleted\" invisible=\"not rs_einv_rejection_note and rs_einv_latest_status not in ('-1', '7')\"/>\n"
"                                    <i class=\"fa fa-pencil-square-o rse-status-card__icon rse-status-card__icon--info\" title=\"Draft on rs.ge\" role=\"img\" aria-label=\"Draft on rs.ge\" invisible=\"rs_einv_rejection_note or rs_einv_latest_status not in ('0', '4')\"/>\n"
"                                    <i class=\"fa fa-history rse-status-card__icon rse-status-card__icon--muted\" title=\"Superseded by correction\" role=\"img\" aria-label=\"Superseded by correction\" invisible=\"rs_einv_rejection_note or rs_einv_latest_status != '3'\"/>"
msgstr ""
"<i class=\"fa fa-check-circle rse-status-card__icon "
"rse-status-card__icon--success\" title=\"დადასტურებული\" role=\"img\" "
"aria-label=\"დადასტურებული\" invisible=\"rs_einv_rejection_note or "
"rs_einv_latest_status not in ('2', '8')\"/>\n"
"                                    <i class=\"fa fa-clock-o "
"rse-status-card__icon rse-status-card__icon--warning "
"rse-status-card__icon--pulse\" title=\"მოლოდინში\" role=\"img\" "
"aria-label=\"მოლოდინში\" invisible=\"rs_einv_rejection_note or "
"rs_einv_latest_status not in ('1', '5', '6')\"/>\n"
"                                    <i class=\"fa fa-times-circle "
"rse-status-card__icon rse-status-card__icon--danger\" title=\"უარყოფილი ან "
"წაშლილი\" role=\"img\" aria-label=\"უარყოფილი ან წაშლილი\" invisible=\"not "
"rs_einv_rejection_note and rs_einv_latest_status not in ('-1', '7')\"/>\n"
"                                    <i class=\"fa fa-pencil-square-o "
"rse-status-card__icon rse-status-card__icon--info\" title=\"მონახაზი "
"rs.ge-ზე\" role=\"img\" aria-label=\"მონახაზი rs.ge-ზე\" "
"invisible=\"rs_einv_rejection_note or rs_einv_latest_status not in ('0', "
"'4')\"/>\n"
"                                    <i class=\"fa fa-history "
"rse-status-card__icon rse-status-card__icon--muted\" title=\"ჩანაცვლებულია "
"კორექტირებით\" role=\"img\" aria-label=\"ჩანაცვლებულია კორექტირებით\" "
"invisible=\"rs_einv_rejection_note or rs_einv_latest_status != '3'\"/>"

#. module: rs_einvoice
#: model_terms:ir.ui.view,arch_db:rs_einvoice.view_move_form_rs_einvoice
msgid ""
"<i class=\"fa fa-clock-o me-2\" role=\"img\" aria-label=\"Cancellation pending\"/>\n"
"                            <strong>Cancellation pending buyer confirmation on rs.ge.</strong>\n"
"                            Odoo accounting has not been reversed yet. Follow up with the buyer if this stays pending."
msgstr ""
"<i class=\"fa fa-clock-o me-2\" role=\"img\" aria-label=\"გაუქმება "
"მოლოდინშია\"/>\n"
"                            <strong>გაუქმება rs.ge-ზე მყიდველის დადასტურებას"
" ელოდება.</strong>\n"
"                            Odoo-ს ბუღალტრული გატარებები ჯერ არ "
"სტორნირებულა. თუ მოლოდინი გაგრძელდა, დაუკავშირდით მყიდველს."

#. module: rs_einvoice
#: model_terms:ir.ui.view,arch_db:rs_einvoice.view_move_form_rs_einvoice
msgid ""
"<i class=\"fa fa-exclamation-circle me-2\" role=\"img\" aria-"
"label=\"Deadline missed\"/>"
msgstr ""
"<i class=\"fa fa-exclamation-circle me-2\" role=\"img\" aria-label=\"ვადა "
"გადაცილებულია\"/>"

#. module: rs_einvoice
#: model_terms:ir.ui.view,arch_db:rs_einvoice.view_move_form_rs_einvoice
msgid ""
"<i class=\"fa fa-exclamation-circle me-2\" role=\"img\" aria-label=\"Pending RS action\"/>\n"
"                            <strong>Pending rs.ge action did not complete.</strong>\n"
"                            Action"
msgstr ""
"<i class=\"fa fa-exclamation-circle me-2\" role=\"img\" "
"aria-label=\"მოლოდინში მყოფი RS ქმედება\"/>\n"
"                            <strong>მოლოდინში მყოფი rs.ge ქმედება არ "
"დასრულდა.</strong>\n"
"                            ქმედება:"

#. module: rs_einvoice
#: model_terms:ir.ui.view,arch_db:rs_einvoice.view_move_form_rs_einvoice
msgid ""
"<i class=\"fa fa-exclamation-triangle me-2\" role=\"img\" aria-label=\"Advance settlement\"/>\n"
"                            <strong>rs.ge advance settlement is not clean.</strong>\n"
"                            Do NOT send to the buyer yet. Check the Advance Settlements audit table below,\n"
"                            fix the advance invoice/state issue, then click <em>Update on RS</em>."
msgstr ""
"<i class=\"fa fa-exclamation-triangle me-2\" role=\"img\" "
"aria-label=\"ავანსის ანგარიშსწორება\"/>\n"
"                            <strong>rs.ge-ზე ავანსის ანგარიშსწორება არ არის "
