msgid ""
"<i class=\"oi me-2\" data-icon=\"notifications\" role=\"img\" aria-label=\"New supplier correction\"/>\n"
"                            <strong>Supplier issued a correction on rs.ge</strong>\n"
"                            (correction ID"
msgstr ""
"<i class=\"oi me-2\" data-icon=\"notifications\" role=\"img\" aria-label=\"მომწოდებლის ახალი კორექტირება\"/>\n"
