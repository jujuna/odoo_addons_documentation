"                            (კორექტირების ID"

#. module: rs_einvoice
#: model_terms:ir.ui.view,arch_db:rs_einvoice.view_move_form_rs_einvoice
msgid ""
"<i class=\"oi me-2\" data-icon=\"schedule\" role=\"img\" aria-label=\"Cancellation pending\"/>\n"
"                            <strong>Cancellation pending buyer confirmation on rs.ge.</strong>\n"
"                            Odoo accounting has not been reversed yet. Follow up with the buyer if this stays pending."
msgstr ""
"<i class=\"oi me-2\" data-icon=\"schedule\" role=\"img\" aria-label=\"გაუქმება მოლოდინშია\"/>\n"
"                            <strong>გაუქმება rs.ge-ზე მყიდველის დადასტურებას ელოდება.</strong>\n"
"                            Odoo-ს ბუღალტრული გატარებები ჯერ არ სტორნირებულა. თუ მოლოდინი გაგრძელდა, დაუკავშირდით მყიდველს."

#. module: rs_einvoice
#: model_terms:ir.ui.view,arch_db:rs_einvoice.view_move_form_rs_einvoice
msgid ""
"<i class=\"oi me-2\" data-icon=\"warning\" role=\"img\" aria-label=\"Advance settlement\"/>\n"
"                            <strong>rs.ge advance settlement is not clean.</strong>\n"
"                            Do NOT send to the buyer yet. Check the Advance Settlements audit table below,\n"
"                            fix the advance invoice/state issue, then click <em>Update on RS</em>."
msgstr ""
