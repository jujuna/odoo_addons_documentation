"                                    </div>\n"
"                                </td>\n"
"                                <td valign=\"middle\" align=\"right\">\n"
"                                    <t t-if=\"not object.uses_default_logo\">\n"
"                                        <img t-att-src=\"'/logo.png?company=%s' % object.id\" style=\"height: auto; width: 80px; margin-right: 10px;\" t-att-alt=\"'%s' % object.name\"/>\n"
