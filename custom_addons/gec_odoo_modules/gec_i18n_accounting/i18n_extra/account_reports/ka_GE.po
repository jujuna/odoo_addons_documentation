#: code:addons/account_reports/models/bank_reconciliation_report.py:0
msgid "'%(account_name)s' account balance is affected by journal items which don't originate from a bank statement or payment."
msgstr "ანგარიშის '%(account_name)s' ნაშთზე გავლენას ახდენს ჟურნალის ერთეულები, რომლებიც არც ბანკის ამონაწერიდან და არც გადახდიდან არ მომდინარეობს."

#. module: account_reports
#. odoo-python
#: code:addons/account_reports/models/account_report.py:0
msgid "'%s' date scope cannot be evaluated for a report used by multiple return types using different periodicities."
msgstr "თარიღის არეალი '%s' ვერ შეფასდება ანგარიშისთვის, რომელსაც სხვადასხვა პერიოდულობის მქონე რამდენიმე დეკლარაციის ტიპი იყენებს."

#. module: account_reports
#. odoo-python
#: code:addons/account_reports/models/account_report.py:0
msgid "'Open General Ledger' caret option is only available form report lines targetting accounts or Result Brought Forward."
msgstr "კარეტის ოფცია 'მთავარი წიგნის გახსნა' ხელმისაწვდომია მხოლოდ იმ ანგარიშის სტრიქონებისთვის, რომლებიც ანგარიშებს ან გადმოტანილ შედეგს ეხება."

#. module: account_reports
#. odoo-python
#: code:addons/account_reports/models/account_report.py:0
msgid "'View Bank Statement' caret option is only available for report lines targeting bank statements."
msgstr "კარეტის ოფცია 'ბანკის ამონაწერის ნახვა' ხელმისაწვდომია მხოლოდ იმ ანგარიშის სტრიქონებისთვის, რომლებიც ბანკის ამონაწერებს ეხება."

#. module: account_reports
#. odoo-python
#: code:addons/account_reports/models/account_return.py:0
msgid "'active' field of account.return.type shouldn't be directly written to in data files. Use active_fallback. (Detected while loading %(file_path)s)"
msgstr "account.return.type-ის 'active' ველი მონაცემთა ფაილებში პირდაპირ არ უნდა ჩაიწეროს. გამოიყენეთ active_fallback. (აღმოჩენილია %(file_path)s-ის ჩატვირთვისას)"

#. module: account_reports
#. odoo-python
#: code:addons/account_reports/models/account_report.py:0
msgid "'date_from' must be set when generating the report date options in range mode."
msgstr "დიაპაზონის რეჟიმში ანგარიშის თარიღის პარამეტრების გენერირებისას 'date_from' უნდა იყოს მითითებული."

#. module: account_reports
#. odoo-python
#: code:addons/account_reports/models/account_report.py:0
msgid "'date_to' must be set when generating the report date options."
msgstr "ანგარიშის თარიღის პარამეტრების გენერირებისას 'date_to' უნდა იყოს მითითებული."

#. module: account_reports
