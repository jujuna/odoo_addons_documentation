#. module: account_reports
#: model:mail.template,body_html:account_reports.email_template_tax_return_deadline
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px;\">\n"
"                    Hi <span t-out=\"ctx.get('partner') and ctx['partner'].name\"/>,<br/><br/>\n"
"                    The deadline to submit <strong t-out=\"object.name\"/> is <strong t-out=\"format_date(object.date_deadline)\"/>.<br/>\n"
"                    To avoid any potential fine, please ensure all remaining documents are sent over as soon as possible.<br/>\n"
"                    If you've already submitted everything but still received this email, it's likely the tax return hasn't been marked as submitted in Odoo.<br/>\n"
"                    Should you have any question or need assistance, feel free to get in touch.<br/><br/>\n"
"                    Best regards,<br/>\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px;\">\n"
"                    გამარჯობა, <span t-out=\"ctx.get('partner') and ctx['partner'].name\"/>,<br/><br/>\n"
"                    <strong t-out=\"object.name\"/>-ის წარდგენის ბოლო ვადაა <strong t-out=\"format_date(object.date_deadline)\"/>.<br/>\n"
"                    შესაძლო ჯარიმის თავიდან ასაცილებლად, გთხოვთ, ყველა დარჩენილი დოკუმენტი რაც შეიძლება მალე გამოგვიგზავნოთ.<br/>\n"
"                    თუ ყველაფერი უკვე წარადგინეთ, მაგრამ ეს წერილი მაინც მიიღეთ, სავარაუდოდ, საგადასახადო დეკლარაცია Odoo-ში წარდგენილად არ არის მონიშნული.<br/>\n"
"                    თუ რაიმე კითხვა გაქვთ ან დახმარება გჭირდებათ, ნუ მოგერიდებათ, დაგვიკავშირდით.<br/><br/>\n"
"                    პატივისცემით,<br/>\n"
"                </p>\n"
"            </div>\n"
"        "

#. module: account_reports
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p>\n"
"                    Dear <t t-out=\"object.company_id.name\">YourCompany</t>,\n"
"                </p>\n"
"                <p>\n"
"                    Based on the documents and information received, the tax return of <t t-out=\"object.company_id.name\">YourCompany</t>\n"
"                    for period <t t-out=\"object.type_id._get_period_name(object.company_id, object.date_from, object.date_to)\"/> has been submitted.\n"
"                </p>\n"
"                <p>\n"
"                    It has been determined that an amount of <t t-out=\"format_amount(object.total_amount_to_pay, object.amount_to_pay_currency_id)\"/> remains payable.\n"
"                </p>\n"
"                <table style=\"border:1px solid black; padding:20px; text-align:left; border-spacing: 16px;\">\n"
"                    <tr>\n"
"                        <td>Amount to Pay</td>\n"
"                        <td><t t-out=\"format_amount(object.total_amount_to_pay, object.amount_to_pay_currency_id)\"/></td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td>Due By</td>\n"
"                        <td><t t-out=\"format_date(object.date_deadline)\"/></td>\n"
"                    </tr>\n"
"                </table>\n"
"                <p>Kind regards,</p>\n"
"                <p><t t-out=\"user.name\">Mitchell Admin</t></p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p>\n"
"                    ძვირფასო <t t-out=\"object.company_id.name\">YourCompany</t>,\n"
"                </p>\n"
"                <p>\n"
"                    მიღებული დოკუმენტებისა და ინფორმაციის საფუძველზე <t t-out=\"object.company_id.name\">YourCompany</t>-ის საგადასახადო დეკლარაცია\n"
"                    <t t-out=\"object.type_id._get_period_name(object.company_id, object.date_from, object.date_to)\"/> პერიოდისთვის წარდგენილია.\n"
"                </p>\n"
"                <p>\n"
"                    დადგინდა, რომ გადასახდელი რჩება <t t-out=\"format_amount(object.total_amount_to_pay, object.amount_to_pay_currency_id)\"/> ოდენობის თანხა.\n"
"                </p>\n"
"                <table style=\"border:1px solid black; padding:20px; text-align:left; border-spacing: 16px;\">\n"
"                    <tr>\n"
"                        <td>გადასახდელი თანხა</td>\n"
"                        <td><t t-out=\"format_amount(object.total_amount_to_pay, object.amount_to_pay_currency_id)\"/></td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td>გადახდის ვადა</td>\n"
"                        <td><t t-out=\"format_date(object.date_deadline)\"/></td>\n"
"                    </tr>\n"
"                </table>\n"
"                <p>პატივისცემით,</p>\n"
"                <p><t t-out=\"user.name\">Mitchell Admin</t></p>\n"
"            </div>\n"
"        "

