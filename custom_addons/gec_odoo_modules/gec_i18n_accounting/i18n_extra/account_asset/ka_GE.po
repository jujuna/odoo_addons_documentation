#: model:ir.model,name:account_asset.model_account_account
msgid "Account"
msgstr "ანგარიში"

#. module: account_asset
#. odoo-python
#: code:addons/account_asset/models/account_move.py:0
msgid "Account %(account)s should have accumulated depreciation and depreciation expense accounts set in order to generate an asset"
msgstr "აქტივის გენერირებისთვის ანგარიშს %(account)s უნდა ჰქონდეს მითითებული დაგროვილი ცვეთისა და ცვეთის ხარჯის ანგარიშები"

#. module: account_asset
#. odoo-python
#: code:addons/account_asset/models/account_move.py:0
msgid "Account %(name)s cannot be used to create an asset. The account must be of the Fixed Asset type."
msgstr "ანგარიში %(name)s ვერ გამოიყენება აქტივის შესაქმნელად. ანგარიში უნდა იყოს ძირითადი საშუალების ტიპის."

#. module: account_asset
#. odoo-python
#: code:addons/account_asset/models/account_move.py:0
msgid "Account %(name)s not setup to generate assets. Depreciation model and asset accounts need to be set on account."
msgstr "ანგარიში %(name)s არ არის გამართული აქტივების გენერირებისთვის. ანგარიშზე უნდა მიეთითოს ცვეთის მოდელი და აქტივის ანგარიშები."

