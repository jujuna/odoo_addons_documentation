#. module: account_asset
#. odoo-python
#: code:addons/account_asset/wizard/asset_modify.py:0
msgid "A journal entry will transfer the asset value from <strong><em>\"%(old_account)s\"</em></strong> to <strong><em>\"%(new_account)s\"</em></strong> on <strong>%(date)s</strong>.<br/> The current asset will be closed and a new asset will be created with the same book value.<br/> Depreciation will begin from <strong>%(date)s</strong> using the depreciation parameters configured on the new account."
msgstr "ბუღალტრული გატარება აქტივის ღირებულებას გადაიტანს <strong><em>\"%(old_account)s\"</em></strong>-დან <strong><em>\"%(new_account)s\"</em></strong>-ზე <strong>%(date)s</strong> თარიღით.<br/> ეს აქტივი დაიხურება და შეიქმნება ახალი აქტივი იმავე საბალანსო ღირებულებით.<br/> ცვეთა დაიწყება <strong>%(date)s</strong>-დან ახალ ანგარიშზე კონფიგურირებული ცვეთის პარამეტრების გამოყენებით."

#. module: account_asset
#. odoo-python
#: code:addons/account_asset/models/account_depreciation_model.py:0
msgid "A journal with a ledger is required to create a depreciation model in this context."
msgstr "ამ კონტექსტში ცვეთის მოდელის შესაქმნელად საჭიროა მთავარი წიგნის მქონე ჟურნალი."

#. module: account_asset
#. odoo-python
#: code:addons/account_asset/models/account_asset_ledger_variant.py:0
msgid "A ledger sub-asset is closed together with its asset. Dispose of the asset instead."
msgstr "მთავარი წიგნის ქვეაქტივი იხურება თავის აქტივთან ერთად. ამის ნაცვლად განკარგეთ აქტივი."

#. module: account_asset
#. odoo-python
#: code:addons/account_asset/models/account_asset.py:0
msgid "A non deductible tax value of %(tax_value)s was added to %(name)s's initial value of %(purchase_value)s"
msgstr "არაგამოქვითვადი გადასახადის თანხა %(tax_value)s დაემატა %(name)s-ის საწყის ღირებულებას %(purchase_value)s"

