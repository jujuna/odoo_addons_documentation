#. module: account_saft
#. odoo-python
#: code:addons/account_saft/models/account_general_ledger.py:0
msgid "View Partners"
msgstr "პარტნიორების ნახვა"

#. module: account_saft
#. odoo-python
#: code:addons/account_saft/models/account_general_ledger.py:0
msgid "the Company ID"
msgstr "კომპანიის საიდენტიფიკაციო ნომერი"

#. module: account_saft
#. odoo-python
#: code:addons/account_saft/models/account_general_ledger.py:0
msgid "the city or zip code"
msgstr "ქალაქი ან საფოსტო ინდექსი"

#. module: account_saft
#. odoo-python
#: code:addons/account_saft/models/account_general_ledger.py:0
msgid "the phone number"
msgstr "ტელეფონის ნომერი"

#. module: account_saft
#. odoo-javascript
#: code:addons/account_saft/static/src/components/general_ledger/filters/warnings.xml:0
msgid "your company"
msgstr "თქვენი კომპანია"
