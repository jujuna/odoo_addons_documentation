msgstr "განსაზღვრეთ შემდეგი, ვისთვისაც"

#. module: account_saft
#. odoo-python
#: code:addons/account_saft/models/account_general_ledger.py:0
msgid "SAF-T is only compatible with one column group."
msgstr "SAF-T თავსებადია მხოლოდ ერთ სვეტთა ჯგუფთან."

#. module: account_saft
#. odoo-python
#: code:addons/account_saft/models/account_general_ledger.py:0
