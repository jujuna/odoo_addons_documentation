#. module: account_accountant_check_printing
#: model:ir.module.module,shortdesc:base.module_account_accountant_check_printing
msgid "Account accountant check printing"
msgstr "ბუღალტერიის ჩეკის ბეჭდვა"

#. module: account_accountant_check_printing
#: model:ir.module.module,summary:base.module_account_accountant_check_printing
msgid "Allows using Reconciliation with the account check printing."
msgstr "შეჯერების გამოყენების შესაძლებლობა ბუღალტერიის ჩეკის ბეჭდვასთან ერთად."

#. module: account_accountant_check_printing
#: model:ir.model.fields,field_description:account_accountant_check_printing.field_account_move_line__check_number
msgid "Check Number"
msgstr "ჩეკის ნომერი"

#. module: account_accountant_check_printing
#: model:ir.model.fields,field_description:account_accountant_check_printing.field_account_move_line__display_name
msgid "Display Name"
msgstr "საჩვენებელი სახელი"

#. module: account_accountant_check_printing
#: model:ir.model.fields,field_description:account_accountant_check_printing.field_account_move_line__id
msgid "ID"
msgstr "ID"

#. module: account_accountant_check_printing
#: model:ir.model,name:account_accountant_check_printing.model_account_move_line
msgid "Journal Item"
msgstr "ჟურნალის ერთეული"

#. module: account_accountant_check_printing
#: model:ir.model.fields,help:account_accountant_check_printing.field_account_move_line__check_number
msgid "The selected journal is configured to print check numbers. If your pre-printed check paper already has numbers or if the current numbering is wrong, you can change it in the journal configuration page."
msgstr "არჩეული ჟურნალი კონფიგურირებულია ჩეკის ნომრების დასაბეჭდად. თუ თქვენს წინასწარ დაბეჭდილ ჩეკის ქაღალდს უკვე აქვს ნომრები ან თუ მიმდინარე ნუმერაცია არასწორია, შეგიძლიათ შეცვალოთ ის ჟურნალის კონფიგურაციის გვერდზე."
