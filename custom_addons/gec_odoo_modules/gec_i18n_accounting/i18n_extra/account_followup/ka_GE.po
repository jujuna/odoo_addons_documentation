#. module: account_followup
#: model:mail.template,body_html:account_followup.demo_followup_email_template_2
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p>\n"
"                        <t t-if=\"object.id != object.commercial_partner_id.id\">Dear <t t-out=\"object.name or ''\"/> (<t t-out=\"object.commercial_partner_id.name or ''\"/>),</t>\n"
"                        <t t-else=\"\">Dear <t t-out=\"object.name or ''\"/>,</t>\n"
"                        <br/>\n"
"                        We are disappointed to see that despite sending a reminder, that your account is now seriously overdue.\n"
"                        <br/>\n"
"                        It is essential that immediate payment is made, otherwise we will have to consider placing a stop on your account which means that we will no longer be able to supply your company with (goods/services). Please, take appropriate measures in order to carry out this payment in the next 8 days.\n"
"                        <br/>\n"
"                        If there is a problem with paying invoice that we are not aware of, do not hesitate to contact our accounting department, so that we can resolve the matter quickly.\n"
"                        <br/>\n"
"                        Details of due payments is printed below.\n"
"                        <br/>\n"
"                        Best Regards,\n"
"                        <t t-if=\"not is_html_empty(object._get_followup_responsible().signature)\">\n"
"                            <br/>\n"
"                            <t t-out=\"object._get_followup_responsible().signature\"/>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <br/>\n"
"                            --\n"
"                            <br/>\n"
"                            <t t-out=\"object._get_followup_responsible().name\"/>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p>\n"
"                        <t t-if=\"object.id != object.commercial_partner_id.id\">ძვირფასო <t t-out=\"object.name or ''\"/> (<t t-out=\"object.commercial_partner_id.name or ''\"/>),</t>\n"
"                        <t t-else=\"\">ძვირფასო <t t-out=\"object.name or ''\"/>,</t>\n"
"                        <br/>\n"
"                        სამწუხაროდ ვხედავთ, რომ შეხსენების გაგზავნის მიუხედავად, თქვენი ანგარიში უკვე სერიოზულად ვადაგადაცილებულია.\n"
"                        <br/>\n"
"                        აუცილებელია დაუყოვნებლივი გადახდა, წინააღმდეგ შემთხვევაში იძულებული გავხდებით განვიხილოთ თქვენი ანგარიშის შეჩერება, რაც ნიშნავს, რომ ვეღარ შევძლებთ თქვენი კომპანიის მომარაგებას (საქონლით/მომსახურებით). გთხოვთ, მიიღოთ შესაბამისი ზომები ამ გადახდის მომდევნო 8 დღეში განსახორციელებლად.\n"
"                        <br/>\n"
"                        თუ ანგარიშ-ფაქტურის გადახდასთან დაკავშირებით არსებობს პრობლემა, რომლის შესახებაც ჩვენ არ ვიცით, მოგერიდებლად დაუკავშირდით ჩვენს ბუღალტრულ განყოფილებას, რათა საკითხი სწრაფად მოვაგვაროთ.\n"
"                        <br/>\n"
"                        გადასახდელი თანხის დეტალები მოცემულია ქვემოთ.\n"
"                        <br/>\n"
"                        პატივისცემით,\n"
"                        <t t-if=\"not is_html_empty(object._get_followup_responsible().signature)\">\n"
"                            <br/>\n"
"                            <t t-out=\"object._get_followup_responsible().signature\"/>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <br/>\n"
"                            --\n"
"                            <br/>\n"
"                            <t t-out=\"object._get_followup_responsible().name\"/>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "

#. module: account_followup
#: model:mail.template,body_html:account_followup.email_template_followup_1
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p>\n"
"                        <t t-if=\"object.id != object.commercial_partner_id.id\">Dear <t t-out=\"object.name or ''\"/> (<t t-out=\"object.commercial_partner_id.name or ''\"/>),</t>\n"
"                        <t t-else=\"\">Dear <t t-out=\"object.name or ''\"/>,</t>\n"
"                    </p>\n"
"                    <p>\n"
"                        We would like to inform you that your account shows an outstanding balance of <b><t t-out=\"format_amount(object.total_overdue_followup, object.currency_id) or ''\"/></b>.\n"
"                        We kindly ask that you settle this amount within the next <b>8 days</b>.\n"
"                    </p>\n"
"                    <p t-if=\"object._show_pay_now_button()\">\n"
"                        <a t-att-href=\"'/my/invoices/overdue'\" style=\"padding: 8px 12px; font-size: 12px; color: #FFFFFF; text-decoration: none !important; font-weight: 400; background-color: #875A7B; border: 0px solid #875A7B; border-radius:3px\">Pay now</a>\n"
"                    </p>\n"
"                    <p>\n"
"                        If payment has already been made, please disregard this notice.\n"
"                        For any questions or if you need assistance, feel free to contact our accounting department.\n"
"                    </p>\n"
"                    <p>\n"
"                        We appreciate your cooperation in resolving this matter.\n"
"                    </p>\n"
"                    <p>\n"
"                        Sincerely,\n"
"                    </p>\n"
"                    <p>\n"
"                        <t t-if=\"not is_html_empty(object._get_followup_responsible().signature)\">\n"
"                            <t t-out=\"object._get_followup_responsible().signature\"/>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <t t-out=\"object._get_followup_responsible().name\"/>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p>\n"
"                        <t t-if=\"object.id != object.commercial_partner_id.id\">ძვირფასო <t t-out=\"object.name or ''\"/> (<t t-out=\"object.commercial_partner_id.name or ''\"/>),</t>\n"
"                        <t t-else=\"\">ძვირფასო <t t-out=\"object.name or ''\"/>,</t>\n"
"                    </p>\n"
"                    <p>\n"
"                        გვსურს გაცნობოთ, რომ თქვენი ანგარიში აჩვენებს დაუფარავ ნაშთს <b><t t-out=\"format_amount(object.total_overdue_followup, object.currency_id) or ''\"/></b>.\n"
"                        თავაზიანად გთხოვთ, დაფაროთ ეს თანხა მომდევნო <b>8 დღეში</b>.\n"
"                    </p>\n"
"                    <p t-if=\"object._show_pay_now_button()\">\n"
"                        <a t-att-href=\"'/my/invoices/overdue'\" style=\"padding: 8px 12px; font-size: 12px; color: #FFFFFF; text-decoration: none !important; font-weight: 400; background-color: #875A7B; border: 0px solid #875A7B; border-radius:3px\">გადაიხადეთ ახლა</a>\n"
"                    </p>\n"
"                    <p>\n"
"                        თუ გადახდა უკვე განხორციელდა, გთხოვთ, უგულებელყოთ ეს შეტყობინება.\n"
"                        ნებისმიერი შეკითხვისთვის ან დახმარების საჭიროების შემთხვევაში, მოგერიდებლად დაუკავშირდით ჩვენს ბუღალტრულ განყოფილებას.\n"
"                    </p>\n"
"                    <p>\n"
"                        მადლობას გიხდით ამ საკითხის მოგვარებაში თანამშრომლობისთვის.\n"
"                    </p>\n"
"                    <p>\n"
"                        პატივისცემით,\n"
"                    </p>\n"
"                    <p>\n"
"                        <t t-if=\"not is_html_empty(object._get_followup_responsible().signature)\">\n"
"                            <t t-out=\"object._get_followup_responsible().signature\"/>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <t t-out=\"object._get_followup_responsible().name\"/>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "

