msgstr "'შეხსენება ' + object.display_name"

#. module: account_followup
#: model:mail.template,body_html:account_followup.mail_template_invoice_payment_kind_reminder
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Dear\n"
"                        <t t-if=\"object.partner_id.parent_id\">\n"
"                            <t t-if=\"object.partner_id.name\">\n"
"                                <t t-out=\"object.partner_id.name\">Brandon Freeman</t> (<t t-out=\"object.partner_id.parent_id.name or ''\">Azure Interior</t>),\n"
"                            </t>\n"
"                            <t t-else=\"\">\n"
"                                <t t-out=\"object.partner_id.parent_id.name or ''\">Azure Interior</t>,\n"
"                            </t>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,\n"
"                        </t>\n"
"                        <br/><br/>\n"
"                        This is a kind reminder that invoice\n"
"                        <t t-if=\"object.name\">\n"
"                            <span style=\"font-weight:bold;\" t-out=\"object.name or ''\">INV/2021/05/0005</span>\n"
"                        </t>\n"
"                        <t t-if=\"object.invoice_origin\">\n"
"                            (with reference: <t t-out=\"object.invoice_origin or ''\">SUB003</t>)\n"
"                        </t>\n"
"                        amounting in <span style=\"font-weight:bold;\" t-out=\"format_amount(object.amount_residual, object.currency_id) or ''\">$ 143,750.00</span>\n"
"                        from <t t-out=\"object.company_id.name or ''\">YourCompany</t> is now overdue.\n"
"                        <br/><br/>\n"
"                        Please remit payment at your earliest convenience\n"
"                        <t t-if=\"object.payment_reference\">\n"
"                            using the following communication for your payment: <strong t-out=\"object.payment_reference or ''\">INV/2021/05/0005</strong>\n"
"                            <t t-if=\"object.partner_bank_id\">\n"
"                                on the account <strong t-out=\"object.partner_bank_id.account_number\"/>\n"
"                            </t>.\n"
"                        </t>\n"
"                        <br/><br/>\n"
"                        </p><p t-if=\"object.partner_id._show_pay_now_button()\">\n"
"                            <a t-att-href=\"'/my/invoices/%s' % object.id\" style=\"padding: 8px 12px; font-size: 12px; color: #FFFFFF; text-decoration: none !important; font-weight: 400; background-color: #875A7B; border: 0px solid #875A7B; border-radius:3px\">Pay now</a>\n"
"                        </p>\n"
"                        You will find a copy of the original invoice attached to this email.\n"
"                        <br/>\n"
"                        If you have already sent the payment, please disregard this notice. If you have any questions or concerns, please don't hesitate to reply to this email.\n"
"                        <br/><br/>\n"
"                        Thank you,\n"
"                        <t t-if=\"not is_html_empty(object.invoice_user_id.signature)\">\n"
"                            <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-out=\"object.invoice_user_id.signature or ''\">Mitchell Admin</t></div>\n"
"                        </t>\n"
"                    \n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        ძვირფასო\n"
"                        <t t-if=\"object.partner_id.parent_id\">\n"
"                            <t t-if=\"object.partner_id.name\">\n"
"                                <t t-out=\"object.partner_id.name\">Brandon Freeman</t> (<t t-out=\"object.partner_id.parent_id.name or ''\">Azure Interior</t>),\n"
"                            </t>\n"
"                            <t t-else=\"\">\n"
"                                <t t-out=\"object.partner_id.parent_id.name or ''\">Azure Interior</t>,\n"
"                            </t>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,\n"
"                        </t>\n"
"                        <br/><br/>\n"
"                        თავაზიანად შეგახსენებთ, რომ ანგარიშ-ფაქტურა\n"
"                        <t t-if=\"object.name\">\n"
"                            <span style=\"font-weight:bold;\" t-out=\"object.name or ''\">INV/2021/05/0005</span>\n"
"                        </t>\n"
"                        <t t-if=\"object.invoice_origin\">\n"
"                            (მითითება: <t t-out=\"object.invoice_origin or ''\">SUB003</t>)\n"
"                        </t>\n"
"                        <span style=\"font-weight:bold;\" t-out=\"format_amount(object.amount_residual, object.currency_id) or ''\">$ 143,750.00</span> ოდენობით,\n"
"                        <t t-out=\"object.company_id.name or ''\">YourCompany</t>-ის მიერ გამოწერილი, უკვე ვადაგადაცილებულია.\n"
"                        <br/><br/>\n"
"                        გთხოვთ, გადაიხადოთ თანხა პირველივე შესაძლებლობისას\n"
"                        <t t-if=\"object.payment_reference\">\n"
"                            და გადახდის დანიშნულებაში მიუთითოთ: <strong t-out=\"object.payment_reference or ''\">INV/2021/05/0005</strong>\n"
"                            <t t-if=\"object.partner_bank_id\">\n"
"                                ანგარიშზე <strong t-out=\"object.partner_bank_id.account_number\"/>\n"
"                            </t>.\n"
"                        </t>\n"
"                        <br/><br/>\n"
"                        </p><p t-if=\"object.partner_id._show_pay_now_button()\">\n"
"                            <a t-att-href=\"'/my/invoices/%s' % object.id\" style=\"padding: 8px 12px; font-size: 12px; color: #FFFFFF; text-decoration: none !important; font-weight: 400; background-color: #875A7B; border: 0px solid #875A7B; border-radius:3px\">გადაიხადეთ ახლა</a>\n"
"                        </p>\n"
"                        საწყისი ანგარიშ-ფაქტურის ასლი თან ერთვის ამ ელფოსტას.\n"
"                        <br/>\n"
"                        თუ გადახდა უკვე განახორციელეთ, გთხოვთ, უგულებელყოთ ეს შეტყობინება. თუ რაიმე კითხვა ან შენიშვნა გაქვთ, მოგერიდებლად უპასუხეთ ამ ელფოსტას.\n"
"                        <br/><br/>\n"
"                        გმადლობთ,\n"
"                        <t t-if=\"not is_html_empty(object.invoice_user_id.signature)\">\n"
"                            <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-out=\"object.invoice_user_id.signature or ''\">Mitchell Admin</t></div>\n"
"                        </t>\n"
"\n"
"                </div>\n"
"            "

#. module: account_followup
#: model:mail.template,body_html:account_followup.mail_template_invoice_payment_last_reminder
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Dear\n"
"                        <t t-if=\"object.partner_id.parent_id\">\n"
"                            <t t-if=\"object.partner_id.name\">\n"
"                                <t t-out=\"object.partner_id.name\">Brandon Freeman</t> (<t t-out=\"object.partner_id.parent_id.name or ''\">Azure Interior</t>),\n"
"                            </t>\n"
"                            <t t-else=\"\">\n"
"                                <t t-out=\"object.partner_id.parent_id.name or ''\">Azure Interior</t>,\n"
"                            </t>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,\n"
"                        </t>\n"
"                        <br/><br/>\n"
"                        This is our third and final reminder regarding the outstanding payment for invoice\n"
"                        <t t-if=\"object.name\">\n"
"                            <span style=\"font-weight:bold;\" t-out=\"object.name or ''\">INV/2021/05/0005</span>\n"
"                        </t>\n"
"                        <t t-if=\"object.invoice_origin\">\n"
"                            (with reference: <t t-out=\"object.invoice_origin or ''\">SUB003</t>)\n"
"                        </t>\n"
"                        which is now\n"
"                        <t t-if=\"object.invoice_date_due and object.invoice_date_due &lt; datetime.date.today()\">\n"
"                            <t t-out=\"(datetime.date.today() - object.invoice_date_due).days\"/> days\n"
"                        </t>\n"
"                        overdue.\n"
"                        The total amount outstanding is <span style=\"font-weight:bold;\" t-out=\"format_amount(object.amount_residual, object.currency_id) or ''\">$ 143,750.00</span>.\n"
"                        We have sent previous reminders but have not yet received payment or a response.\n"
"                        <br/><br/>\n"
"                        </p><p t-if=\"object.partner_id._show_pay_now_button()\">\n"
"                            <a t-att-href=\"'/my/invoices/%s' % object.id\" style=\"padding: 8px 12px; font-size: 12px; color: #FFFFFF; text-decoration: none !important; font-weight: 400; background-color: #875A7B; border: 0px solid #875A7B; border-radius:3px\">Pay now</a>\n"
"                        </p>\n"
"                        Please be advised that your account is now considered delinquent. We urge you to make payment immediately to settle this balance. The original invoice is attached.\n"
"                        <br/><br/>\n"
"                        Please contact us to either confirm your payment or discuss this matter. If we do not receive payment or a response by within 10 days we will be forced to review the status of your account.\n"
"                        <br/><br/>\n"
"                        We hope to resolve this amicably.\n"
"                        <br/><br/>\n"
"                        Sincerely,\n"
"                        <t t-if=\"not is_html_empty(object.invoice_user_id.signature)\">\n"
"                            <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-out=\"object.invoice_user_id.signature or ''\">Mitchell Admin</t></div>\n"
"                        </t>\n"
"                    \n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        ძვირფასო\n"
"                        <t t-if=\"object.partner_id.parent_id\">\n"
"                            <t t-if=\"object.partner_id.name\">\n"
"                                <t t-out=\"object.partner_id.name\">Brandon Freeman</t> (<t t-out=\"object.partner_id.parent_id.name or ''\">Azure Interior</t>),\n"
"                            </t>\n"
"                            <t t-else=\"\">\n"
"                                <t t-out=\"object.partner_id.parent_id.name or ''\">Azure Interior</t>,\n"
"                            </t>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,\n"
"                        </t>\n"
"                        <br/><br/>\n"
"                        ეს ჩვენი მესამე და ბოლო შეხსენებაა ანგარიშ-ფაქტურის\n"
"                        <t t-if=\"object.name\">\n"
"                            <span style=\"font-weight:bold;\" t-out=\"object.name or ''\">INV/2021/05/0005</span>\n"
"                        </t>\n"
"                        <t t-if=\"object.invoice_origin\">\n"
"                            (მითითება: <t t-out=\"object.invoice_origin or ''\">SUB003</t>)\n"
"                        </t>\n"
"                        გადაუხდელი თანხის შესახებ, რომელიც უკვე\n"
"                        <t t-if=\"object.invoice_date_due and object.invoice_date_due &lt; datetime.date.today()\">\n"
"                            <t t-out=\"(datetime.date.today() - object.invoice_date_due).days\"/> დღით\n"
"                        </t>\n"
"                        ვადაგადაცილებულია.\n"
"                        გადაუხდელი საერთო თანხა შეადგენს <span style=\"font-weight:bold;\" t-out=\"format_amount(object.amount_residual, object.currency_id) or ''\">$ 143,750.00</span>.\n"
"                        ჩვენ უკვე გამოგიგზავნეთ წინა შეხსენებები, თუმცა გადახდა ან პასუხი ჯერ არ მიგვიღია.\n"
"                        <br/><br/>\n"
"                        </p><p t-if=\"object.partner_id._show_pay_now_button()\">\n"
"                            <a t-att-href=\"'/my/invoices/%s' % object.id\" style=\"padding: 8px 12px; font-size: 12px; color: #FFFFFF; text-decoration: none !important; font-weight: 400; background-color: #875A7B; border: 0px solid #875A7B; border-radius:3px\">გადაიხადეთ ახლა</a>\n"
"                        </p>\n"
"                        გაცნობებთ, რომ თქვენი ანგარიში ამიერიდან ვადაგადაცილებული დავალიანების მქონედ ითვლება. მოგიწოდებთ, დაუყოვნებლივ განახორციელოთ გადახდა ამ ბალანსის დასაფარად. საწყისი ანგარიშ-ფაქტურა თან ერთვის.\n"
"                        <br/><br/>\n"
"                        გთხოვთ, დაგვიკავშირდეთ გადახდის დასადასტურებლად ან ამ საკითხის განსახილველად. თუ 10 დღის განმავლობაში გადახდას ან პასუხს არ მივიღებთ, იძულებული ვიქნებით, გადავხედოთ თქვენი ანგარიშის სტატუსს.\n"
"                        <br/><br/>\n"
"                        ვიმედოვნებთ, რომ ამ საკითხს ურთიერთშეთანხმებით მოვაგვარებთ.\n"
"                        <br/><br/>\n"
"                        პატივისცემით,\n"
"                        <t t-if=\"not is_html_empty(object.invoice_user_id.signature)\">\n"
"                            <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-out=\"object.invoice_user_id.signature or ''\">Mitchell Admin</t></div>\n"
"                        </t>\n"
"\n"
"                </div>\n"
"            "

#. module: account_followup
#: model:mail.template,body_html:account_followup.mail_template_invoice_payment_second_reminder
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Dear\n"
"                        <t t-if=\"object.partner_id.parent_id\">\n"
"                            <t t-if=\"object.partner_id.name\">\n"
"                                <t t-out=\"object.partner_id.name\">Brandon Freeman</t> (<t t-out=\"object.partner_id.parent_id.name or ''\">Azure Interior</t>),\n"
"                            </t>\n"
"                            <t t-else=\"\">\n"
