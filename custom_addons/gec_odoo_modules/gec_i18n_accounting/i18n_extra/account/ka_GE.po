#: code:addons/account/models/account_report.py:0
msgid "You can't delete a report that has variants."
msgstr "ვერ წაშლით ანგარიშგებას, რომელსაც აქვს ვარიანტები."

#. module: account
#. odoo-python
#: code:addons/account/models/account_move_send.py:0
msgid "You can't generate invoices that are not posted."
msgstr "ვერ მოახდენთ ისეთი ანგარიშ-ფაქტურების გენერირებას, რომლებიც არ არის გატარებული."

#. module: account
#. odoo-python
#: code:addons/account/models/account_journal.py:0
msgid "You can't have two payment method lines of the same payment type (%(payment_type)s) and with the same name (%(name)s) on a single journal."
msgstr "ერთ ჟურნალზე ვერ გექნებათ გადახდის მეთოდის ორი სტრიქონი ერთი და იმავე გადახდის ტიპით (%(payment_type)s) და ერთი და იმავე სახელით (%(name)s)."

#. module: account
#. odoo-python
#: code:addons/account/wizard/account_payment_register.py:0
msgid "You can't open the register payment wizard without at least one receivable/payable line."
msgstr "ვერ გახსნით გადახდის რეგისტრაციის ვიზარდს მინიმუმ ერთი მისაღები/გადასახდელი სტრიქონის გარეშე."

#. module: account
#. odoo-python
#: code:addons/account/models/account_bank_statement_line.py:0
msgid "You can't provide a foreign currency without specifying an amount in 'Amount in Currency' field."
msgstr "ვერ მიუთითებთ უცხოურ ვალუტას ისე, რომ ველში 'თანხა ვალუტაში' არ მიუთითოთ თანხა."

#. module: account
#. odoo-python
#: code:addons/account/models/account_bank_statement_line.py:0
msgid "You can't provide an amount in foreign currency without specifying a foreign currency."
msgstr "ვერ მიუთითებთ თანხას უცხოურ ვალუტაში უცხოური ვალუტის მითითების გარეშე."

#. module: account
#. odoo-python
#: code:addons/account/wizard/account_payment_register.py:0
msgid "You can't register payments for both inbound and outbound moves at the same time."
msgstr "ვერ დაარეგისტრირებთ გადახდებს ერთდროულად შემომავალი და გამავალი გადატანებისთვის."

#. module: account
#. odoo-python
#: code:addons/account/models/account_account.py:0
msgid "You can't unlink this company from this account since there are some journal items linked to it."
msgstr "ვერ მოხსნით ამ კომპანიის კავშირს ამ ანგარიშთან, ვინაიდან მას დაკავშირებული აქვს ზოგიერთი ჟურნალის ერთეული."

#. module: account
#. odoo-python
#: code:addons/account/models/account_move.py:0
msgid "You cannot add/modify entries prior to and inclusive of: %(lock_date_info)s."
msgstr "ვერ დაამატებთ/შეცვლით ჩანაწერებს შემდეგ თარიღამდე და ამ თარიღის ჩათვლით: %(lock_date_info)s."

#. module: account
#. odoo-python
#: code:addons/account/models/account_payment.py:0
msgid "You cannot change the amount of a payment with multiple liquidity lines."
msgstr "ვერ შეცვლით ლიკვიდურობის მრავალი სტრიქონის მქონე გადახდის თანხას."

#. module: account
#. odoo-python
#: code:addons/account/models/company.py:0
msgid "You cannot change the currency of the company since some journal items already exist"
msgstr "ვერ შეცვლით კომპანიის ვალუტას, ვინაიდან უკვე არსებობს ზოგიერთი ჟურნალის ერთეული"

#. module: account
#. odoo-python
#: code:addons/account/models/account_account.py:0
msgid "You cannot change the type of an account set as Bank Account on a journal to Receivable or Payable."
msgstr "ვერ შეცვლით ჟურნალზე ბანკის ანგარიშად მითითებული ანგარიშის ტიპს მისაღებად ან გადასახდელად."

#. module: account
#. odoo-python
#: code:addons/account/wizard/base_document_layout.py:0
msgid "You cannot configure the document layout for this company."
msgstr "ამ კომპანიისთვის დოკუმენტის განლაგებას ვერ დააკონფიგურირებთ."

#. module: account
#. odoo-python
#: code:addons/account/models/partner.py:0
msgid "You cannot create a fiscal position with a country outside of the selected country group."
msgstr "ვერ შექმნით ფისკალურ პოზიციას არჩეული ქვეყნების ჯგუფის გარეთ მდებარე ქვეყნით."

#. module: account
#. odoo-python
#: code:addons/account/models/partner.py:0
msgid "You cannot create a fiscal position with a foreign Tax ID within your fiscal country without assigning it a state."
msgstr "ვერ შექმნით ფისკალურ პოზიციას უცხოური საგადასახადო ID-ით თქვენი ფისკალური ქვეყნის ფარგლებში შტატის მიკუთვნების გარეშე."

#. module: account
#. odoo-python
#: code:addons/account/models/account_move.py:0
msgid "You cannot create a move already in the posted state. Please create a draft move and post it after."
msgstr "ვერ შექმნით უკვე გატარებულ მდგომარეობაში მყოფ გადატანას. გთხოვთ შექმნათ მონახაზი გადატანა და გაატაროთ ის შემდეგ."

#. module: account
#. odoo-python
#: code:addons/account/models/account_move_line.py:0
msgid "You cannot delete a payable/receivable line as it would not be consistent with the payment terms"
msgstr "ვერ წაშლით გადასახდელ/მისაღებ სტრიქონს, ვინაიდან ის არ შეესაბამება გადახდის პირობებს"

#. module: account
#. odoo-python
#: code:addons/account/models/account_move_line.py:0
msgid "You cannot delete a tax line as it would impact the tax report"
msgstr "ვერ წაშლით გადასახადის სტრიქონს, ვინაიდან ის გავლენას მოახდენს გადასახადის ანგარიშგებაზე"

#. module: account
#. odoo-python
#: code:addons/account/models/account_move_line.py:0
msgid "You cannot delete journal items belonging to a locked journal entry."
msgstr "ვერ წაშლით ჩაკეტილ ბუღალტრულ გატარებას მიკუთვნებულ ჟურნალის ერთეულებს."

#. module: account
#. odoo-python
#: code:addons/account/models/account_tax.py:0
msgid "You cannot delete taxes that are currently in use. Consider archiving them instead."
msgstr "ვერ წაშლით გადასახადებს, რომლებიც ამჟამად გამოიყენება. ამის ნაცვლად, განიხილეთ მათი დაარქივება."

#. module: account
#. odoo-python
#: code:addons/account/models/account_account_tag.py:0
msgid "You cannot delete this account tag (%s), it is used on the chart of account definition."
msgstr "ვერ წაშლით ამ ანგარიშის ტეგს (%s), ის გამოიყენება ანგარიშთა გეგმის განსაზღვრებაში."

#. module: account
#. odoo-python
#: code:addons/account/models/account_move.py:0
msgid "You cannot delete this entry, as it has already consumed a sequence number and is not the last one in the chain. You should probably revert it instead."
msgstr "ვერ წაშლით ამ ჩანაწერს, ვინაიდან მან უკვე გამოიყენა მიმდევრობის ნომერი და არ არის ჯაჭვში ბოლო. სავარაუდოდ, ის უმჯობესია გააუქმოთ."

#. module: account
#. odoo-python
#: code:addons/account/models/mail_template.py:0
msgid "You cannot delete this mail template, it is used in the invoice sending flow."
msgstr "ვერ წაშლით ამ ელფოსტის შაბლონს, ის გამოიყენება ანგარიშ-ფაქტურის გაგზავნის ნაკადში."

#. module: account
#. odoo-python
#: code:addons/account/models/ir_actions_report.py:0
msgid "You cannot delete this report (%s), it is used by the accounting PDF generation engine."
msgstr "ვერ წაშლით ამ ანგარიშგებას (%s), ის გამოიყენება ბუღალტრული PDF-ის გენერირების ძრავის მიერ."

#. module: account
#. odoo-python
#: code:addons/account/models/account_account.py:0
msgid "You cannot deprecate an account that is used in a tax distribution."
msgstr "ვერ მონიშნავთ მოძველებულად ანგარიშს, რომელიც გამოიყენება გადასახადის განაწილებაში."

#. module: account
#. odoo-python
#: code:addons/account/models/res_config_settings.py:0
msgid "You cannot disable this setting because some of your taxes are cash basis. Modify your taxes first before disabling this setting."
msgstr "ვერ გათიშავთ ამ პარამეტრს, ვინაიდან თქვენი ზოგიერთი გადასახადი საკასო პრინციპზეა. ამ პარამეტრის გათიშვამდე ჯერ შეცვალეთ თქვენი გადასახადები."

#. module: account
#. odoo-python
#: code:addons/account/models/account_move_line.py:0
msgid ""
"You cannot do this modification on a reconciled journal entry. You can just change some non legal fields or you must unreconcile first.\n"
"Journal Entry (id): %(entry)s (%(id)s)"
msgstr ""
"ვერ შეასრულებთ ამ ცვლილებას შეჯერებულ ბუღალტრულ გატარებაზე. შეგიძლიათ მხოლოდ ზოგიერთი არასამართლებრივი ველის შეცვლა, ან ჯერ უნდა გააუქმოთ შეჯერება.\n"
"ბუღალტრული გატარება (id): %(entry)s (%(id)s)"

#. module: account
#. odoo-python
#: code:addons/account/models/account_lock_exception.py:0
msgid "You cannot duplicate a Lock Date Exception."
msgstr "ვერ დაადუბლირებთ ჩაკეტვის თარიღის გამონაკლისს."

#. module: account
#. odoo-python
#: code:addons/account/models/account_move_line.py:0
msgid ""
"You cannot edit the following fields: %(fields)s.\n"
"The following entries are already hashed:\n"
"%(entries)s"
msgstr ""
"ვერ შეცვლით შემდეგ ველებს: %(fields)s.\n"
"შემდეგი ჩანაწერები უკვე ჰეშირებულია:\n"
"%(entries)s"

#. module: account
#. odoo-python
#: code:addons/account/models/account_move.py:0
msgid "You cannot edit the journal of a journal entry if it has been posted once, unless the name is removed or set to \"/\". This might create a gap in the sequence."
msgstr "ვერ შეცვლით ბუღალტრული გატარების ჟურნალს, თუ ის ერთხელ მაინც გატარდა, გარდა იმ შემთხვევისა, როდესაც სახელი წაშლილია ან დაყენებულია \"/\"-ზე. ამან შესაძლოა გამოიწვიოს ხარვეზი მიმდევრობაში."

#. module: account
#. odoo-python
#: code:addons/account/models/account_move.py:0
msgid "You cannot edit the journal of a journal entry with a sequence number assigned, unless the name is removed or set to \"/\". This might create a gap in the sequence."
msgstr "ვერ შეცვლით მინიჭებული მიმდევრობის ნომრის მქონე ბუღალტრული გატარების ჟურნალს, თუ არ მოიხსნა სახელი ან არ დაყენდა \"/\"-ზე. ამან შესაძლოა გამოიწვიოს ხარვეზი მიმდევრობაში."

#. module: account
#. odoo-python
#: code:addons/account/models/account_account.py:0
msgid "You cannot have a receivable/payable account that is not reconcilable. (account code: %s)"
msgstr "ვერ გექნებათ მისაღები/გადასახდელი ანგარიში, რომელიც არ არის შესაჯერებელი. (ანგარიშის კოდი: %s)"

#. module: account
#. odoo-python
#: code:addons/account/models/company.py:0
msgid "You cannot import the \"openning_balance\" if the opening move (%s) is already posted.                 If you are absolutely sure you want to modify the opening balance of your accounts, reset the move to draft."
msgstr "ვერ მოახდენთ \"openning_balance\"-ის იმპორტს, თუ გახსნის გადატანა (%s) უკვე გატარებულია.                 თუ აბსოლუტურად დარწმუნებული ხართ, რომ გსურთ თქვენი ანგარიშების საწყისი ნაშთის შეცვლა, დააბრუნეთ გადატანა მონახაზში."

#. module: account
#. odoo-python
#: code:addons/account/models/account_account.py:0
msgid "You cannot merge accounts."
msgstr "ვერ გააერთიანებთ ანგარიშებს."

#. module: account
#. odoo-python
#: code:addons/account/models/res_partner_bank.py:0
msgid "You cannot modify the account number or partner of an account that has been trusted."
msgstr "ვერ შეცვლით სანდო ანგარიშის ანგარიშის ნომერს ან პარტნიორს."

#. module: account
#. odoo-python
#: code:addons/account/models/account_journal.py:0
msgid "You cannot modify the field %s of a journal that already has accounting entries."
msgstr "ვერ შეცვლით %s ველს ჟურნალისა, რომელსაც უკვე აქვს ბუღალტრული გატარებები."

#. module: account
#. odoo-python
#: code:addons/account/models/account_move.py:0
msgid "You cannot modify the following readonly fields on the posted move %(move)s: %(fields)s"
msgstr "ვერ შეცვლით შემდეგ მხოლოდ წასაკითხ ველებს გატარებულ ბუღალტრულ გატარებაში %(move)s: %(fields)s"

#. module: account
#. odoo-python
#: code:addons/account/models/account_move_line.py:0
msgid "You cannot modify the taxes related to a posted journal item, you should reset the journal entry to draft to do so."
msgstr "ვერ შეცვლით გატარებულ ჟურნალის ერთეულთან დაკავშირებულ გადასახადებს, ამისათვის უნდა დააბრუნოთ ბუღალტრული გატარება მონახაზში."

#. module: account
#. odoo-python
#: code:addons/account/models/account_account.py:0
msgid "You cannot perform this action on an account that contains journal items."
msgstr "ვერ შეასრულებთ ამ მოქმედებას ანგარიშზე, რომელიც შეიცავს ჟურნალის ერთეულებს."

#. module: account
#. odoo-python
#: code:addons/account/models/account_move.py:0
msgid "You cannot post an entry in an archived journal (%(journal)s)"
msgstr "ვერ გაატარებთ ჩანაწერს დაარქივებულ ჟურნალში (%(journal)s)"

#. module: account
#. odoo-python
#: code:addons/account/models/account_move.py:0
msgid "You cannot post an entry with an archived analytic account: %s"
msgstr "ვერ გაატარებთ ჩანაწერს დაარქივებული ანალიტიკური ანგარიშით: %s"

#. module: account
#. odoo-python
#: code:addons/account/wizard/base_document_layout.py:0
msgid "You cannot preview this invoice."
msgstr "ამ ანგარიშ-ფაქტურას წინასწარ ვერ ნახავთ."

#. module: account
#. odoo-python
#: code:addons/account/models/res_currency.py:0
msgid "You cannot reduce the number of decimal places of a currency which has already been used to make accounting entries."
msgstr "ვერ შეამცირებთ ვალუტის ათობითი ნიშნების რაოდენობას, რომელიც უკვე გამოყენებულია ბუღალტრული გატარებების შესაქმნელად."

#. module: account
#. odoo-python
#: code:addons/account/models/account_move.py:0 code:addons/account/wizard/account_payment_register.py:0
msgid "You cannot register payments for blocked invoices."
msgstr "ვერ დაარეგისტრირებთ გადახდებს დაბლოკილი ანგარიშ-ფაქტურებისთვის."

#. module: account
#. odoo-python
#: code:addons/account/models/account_move.py:0
msgid "You cannot register payments for miscellaneous entries."
msgstr "ვერ დაარეგისტრირებთ გადახდებს სხვადასხვა ჩანაწერებისთვის."

#. module: account
#. odoo-python
#: code:addons/account/models/ir_attachment.py:0
msgid "You cannot remove parts of a restricted audit trail."
msgstr "ვერ წაშლით აუდიტის შეზღუდული კვალის ნაწილებს."

#. module: account
#. odoo-python
#: code:addons/account/models/mail_message.py:0
msgid "You cannot remove parts of a restricted audit trail. Archive the record instead."
msgstr "ვერ წაშლით აუდიტის შეზღუდული კვალის ნაწილებს. ამის ნაცვლად დააარქივეთ ჩანაწერი."

#. module: account
#. odoo-python
#: code:addons/account/models/account_account.py:0
msgid "You cannot remove/deactivate the accounts \"%s\" which are set on a tax repartition line."
msgstr "ვერ წაშლით/გათიშავთ ანგარიშებს \"%s\", რომლებიც მითითებულია გადასახადის გადანაწილების სტრიქონზე."

#. module: account
#. odoo-python
#: code:addons/account/models/account_account.py:0
