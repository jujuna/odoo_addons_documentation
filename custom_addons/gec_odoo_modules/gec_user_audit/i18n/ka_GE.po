#. module: gec_user_audit
#: model:mail.template,body_html:gec_user_audit.mail_template_sign_in
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p><t t-out=\"object.name or ''\"/> (<t t-out=\"object.login or ''\"/>) signed in to <t t-out=\"object.company_id.name or ''\"/>.</p>\n"
"<ul>\n"
"    <t t-set=\"not_available\">N/A</t>\n"
"    <li>When: <t t-out=\"ctx.get('gec_date') and format_datetime(ctx.get('gec_date'), tz=object.tz, dt_format='medium') or not_available\"/></li>\n"
"    <li>Where: <t t-out=\"ctx.get('gec_place') or not_available\"/></li>\n"
"    <li>Address: <t t-out=\"ctx.get('gec_ip') or not_available\"/></li>\n"
"    <li>Browser: <t t-out=\"ctx.get('gec_agent') or not_available\"/></li>\n"
"</ul>\n"
"<p style=\"margin: 16px 0px 16px 0px;\">\n"
"    If this sign-in was not expected, change the password of this account and end its\n"
"    sessions from Settings.\n"
"</p>\n"
"</div>\n"
"        "
msgstr ""

