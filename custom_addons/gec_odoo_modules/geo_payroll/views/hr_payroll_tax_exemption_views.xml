<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payroll_tax_exemption_view_list" model="ir.ui.view">
        <field name="name">hr.payroll.tax.exemption.list</field>
        <field name="model">hr.payroll.tax.exemption</field>
        <field name="arch" type="xml">
            <list string="Income Tax Exemptions">
                <field name="name"/>
                <field name="yearly_limit"/>
                <field name="employee_count" string="Employees"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="hr_payroll_tax_exemption_view_form" model="ir.ui.view">
        <field name="name">hr.payroll.tax.exemption.form</field>
        <field name="model">hr.payroll.tax.exemption</field>
        <field name="arch" type="xml">
            <form string="Income Tax Exemption">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" widget="text"
                                   placeholder="e.g. მარტოხელა დედა"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="yearly_limit"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Employees" name="employees">
                            <field name="employee_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="department_id"/>
                                    <field name="job_id"/>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_payroll_tax_exemption_view_search" model="ir.ui.view">
        <field name="name">hr.payroll.tax.exemption.search</field>
        <field name="model">hr.payroll.tax.exemption</field>
        <field name="arch" type="xml">
            <search string="Income Tax Exemptions">
                <field name="name"/>
                <field name="employee_ids" string="Employee"/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_hr_payroll_tax_exemption" model="ir.actions.act_window">
        <field name="name">Income Tax Exemptions</field>
        <field name="res_model">hr.payroll.tax.exemption</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an income tax exemption category</p>
            <p>Employees assigned to a category pay no income tax until their
               cumulative yearly payslip gross reaches the limit; the excess is
               taxed normally. Salary, bonuses and benefits all count.</p>
        </field>
    </record>

    <menuitem id="menu_hr_payroll_tax_exemption" name="Income Tax Exemptions"
              parent="hr_payroll.menu_hr_salary_configuration"
              action="action_hr_payroll_tax_exemption" sequence="40"/>
</odoo>
