#. module: geo_payroll
#. odoo-python
#: code:addons/geo_payroll/models/hr_payslip_account.py:0
msgid "These payslips were corrected or refunded and have nothing left to pay: %(names)s"
msgstr "ამ ხელფასის უწყისებზე უკვე შექმნილია კორექტირება ან დაბრუნება და გადასახდელი აღარაფერი დარჩა: %(names)s"

#. module: geo_payroll
#. odoo-python
#: code:addons/geo_payroll/models/hr_payslip_account.py:0
msgid "These payslips are linked to a posted journal entry, only a user with accounting rights can release it: %(names)s"
msgstr "ამ ხელფასის უწყისების ბუღალტრული გატარება უკვე დადასტურებულია; მისი გაუქმება მხოლოდ ბუღალტრული აღრიცხვის უფლებების მქონე მომხმარებელს შეუძლია: %(names)s"

#. module: geo_payroll
#. odoo-python
#: code:addons/geo_payroll/models/hr_payslip_account.py:0
msgid "These payslips have a validated refund or correction: %(names)s. Cancel the correction and its refund first."
msgstr "ამ ხელფასის უწყისებს აქვს დადასტურებული დაბრუნება ან კორექტირება: %(names)s. ჯერ გააუქმეთ კორექტირება და მისი დაბრუნება."

#. module: geo_payroll
#. odoo-python
#: code:addons/geo_payroll/models/hr_payslip_account.py:0
msgid "The journal entry of these payslips is matched with a payment or a bank statement line: %(names)s. Cancel or unreconcile that payment first, then try again."
msgstr "ამ ხელფასის უწყისების ბუღალტრული გატარება შეჯერებულია გადახდასთან ან საბანკო ამონაწერის სტრიქონთან: %(names)s. ჯერ გააუქმეთ ეს გადახდა ან მოხსენით შეჯერება, შემდეგ კვლავ სცადეთ."

#. module: geo_payroll
#. odoo-python
#: code:addons/geo_payroll/models/hr_payslip_account.py:0
msgid "The journal entry of payslip %(slip)s is dated %(date)s, in a period locked by %(locks)s: set the entry's date to an open day or ask for a lock exception, then validate again."
msgstr "ხელფასის უწყისის %(slip)s ბუღალტრული გატარების თარიღი (%(date)s) ჩაკეტილ პერიოდშია (%(locks)s): მიუთითეთ გატარებაში ღია პერიოდის თარიღი ან მოითხოვეთ ჩაკეტვის გამონაკლისი, შემდეგ კვლავ დაადასტურეთ."
