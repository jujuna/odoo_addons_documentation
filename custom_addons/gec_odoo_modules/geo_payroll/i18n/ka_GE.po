#. module: geo_payroll
#. odoo-python
#: code:addons/geo_payroll/models/hr_version.py:0
msgid ""
"%(count)s timesheet line(s) on the allowed projects since %(date)s are not "
"paid yet and will be paid by the next payslips."
msgstr "დაშვებულ პროექტებზე %(date)s-იდან %(count)s ტაბელის სტრიქონი ჯერ არ ანაზღაურებულა და შემდეგი ხელფასის უწყისებით ანაზღაურდება."

#. module: geo_payroll
#. odoo-python
#: code:addons/geo_payroll/models/hr_version.py:0
msgid ""
"%(count)s timesheet line(s) on the allowed projects are not paid yet and "
"will be paid by the next payslips."
msgstr "დაშვებულ პროექტებზე %(count)s ტაბელის სტრიქონი ჯერ არ ანაზღაურებულა და შემდეგი ხელფასის უწყისებით ანაზღაურდება."

#. module: geo_payroll
#. odoo-python
#: code:addons/geo_payroll/models/hr_payslip_settlement.py:0
msgid ""
"%(employee)s has %(total).2f payable timesheet hours on %(date)s, over the "
"24h/day limit. Fix or delete the excess lines before computing payroll."
msgstr "%(employee)s-ს %(date)s-ზე აქვს %(total).2f ასანაზღაურებელი ტაბელის საათი, რაც აღემატება დღიურ 24-საათიან ზღვარს. სახელფასო უწყისის გამოთვლამდე შეასწორეთ ან წაშალეთ ზედმეტი სტრიქონები."

#. module: geo_payroll
#. odoo-python
#: code:addons/geo_payroll/models/hr_employee_work_log.py:0
msgid ""
"%(employee)s is paid by the hour from attendance, so these hours are already"
" in the payslip: correct the attendance instead of adding a work log."
msgstr "%(employee)s საათობრივად ანაზღაურდება დასწრების მიხედვით, ამიტომ ეს საათები უწყისში უკვე ხვდება: სამუშაოს აღრიცხვის დამატების ნაცვლად შეასწორეთ დასწრება."

#. module: geo_payroll
#. odoo-python
#: code:addons/geo_payroll/models/hr_employee_work_log.py:0
msgid ""
"%(employee)s is paid by the hour from timesheets: enter the overtime as a "
"timesheet, not as a work log."
msgstr "%(employee)s საათობრივად ანაზღაურდება ტაბელების მიხედვით: ზეგანაკვეთური დრო შეიტანეთ ტაბელში და არა სამუშაოს აღრიცხვაში."

#. module: geo_payroll
#. odoo-python
#: code:addons/geo_payroll/models/hr_employee_work_log.py:0
msgid "%(employee)s is not under contract on %(date)s."
msgstr "%(employee)s %(date)s-ზე ხელშეკრულებით არ არის დასაქმებული."

#. module: geo_payroll
#. odoo-python
#: code:addons/geo_payroll/models/hr_employee_work_log.py:0
msgid ""
"%(employee)s's contract does not pay %(kind)s work logs: set a Pay Scheme or"
" pay option on the contract that pays them, then approve again."
msgstr "დასაქმებულის (%(employee)s) ხელშეკრულება არ ითვალისწინებს %(kind)s ტიპის სამუშაოს აღრიცხვების ანაზღაურებას: ხელშეკრულებაზე აირჩიეთ ანაზღაურების სქემა ან პარამეტრი, რომელიც მათ ანაზღაურებს, და ხელახლა დაამტკიცეთ."

#. module: geo_payroll
#. odoo-python
#: code:addons/geo_payroll/models/hr_version.py:0
msgid ""
"%(name)s has %(count)s timesheet line(s) that payroll could no longer pay "
"after this change (dates: %(dates)s): use New Contract to make the change "
"from a date, or ask a payroll manager to waive those lines first (cancel or "
"delete a draft payslip that already contains them)."
msgstr "%(name)s-ს აქვს %(count)s ტაბელის სტრიქონი, რომელიც ამ ცვლილების შემდეგ ხელფასში ვეღარ ანაზღაურდება (თარიღები: %(dates)s): გამოიყენეთ „ახალი კონტრაქტი“, რომ ცვლილება მითითებული თარიღიდან ამოქმედდეს, ან ჯერ სთხოვეთ სახელფასო მენეჯერს ამ სტრიქონების გამორიცხვა (მონახაზი უწყისი, რომელიც მათ უკვე შეიცავს, გააუქმეთ ან წაშალეთ)."

#. module: geo_payroll
#. odoo-python
#: code:addons/geo_payroll/models/hr_payroll_structure_type.py:0
msgid ""
"Leave the default structure of %(name)s empty: it is used only for separate "
"payments, not for regular salary."
msgstr "%(name)s-ის ნაგულისხმევი სტრუქტურა ცარიელი დატოვეთ: ის მხოლოდ ცალკე გადახდებისთვის გამოიყენება და არა ჩვეულებრივი ხელფასისთვის."

#. module: geo_payroll
#. odoo-python
#: code:addons/geo_payroll/models/hr_payroll_benefit.py:0
msgid ""
"%(names)s already paid on validated payslips: the vendor and the advance "
"terms cannot change. Archive the program and create a new one."
msgstr "%(names)s უკვე ანაზღაურდა დადასტურებულ ხელფასის უწყისებზე: მომწოდებელი და ავანსის პირობები არ იცვლება. დაარქივეთ პროგრამა და შექმენით ახალი."

#. module: geo_payroll
#. odoo-python
#: code:addons/geo_payroll/models/hr_payslip_benefit.py:0
msgid ""
"%(slip)s paid out an advance whose installments are already validated "
"(%(names)s). Correct it instead of cancelling."
msgstr "უწყისმა (%(slip)s) გასცა ავანსი, რომლის შენატანები უკვე დადასტურებულია (%(names)s). გაუქმების ნაცვლად შეასწორეთ იგი."

