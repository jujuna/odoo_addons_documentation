#. module: pos_tyro
#. odoo-javascript
#: code:addons/pos_tyro/static/src/app/payment_tyro.js:0
msgid "A tip was added on the Tyro terminal, but tipping is not enabled for this Point of Sale. It will instead be recorded as a surcharge."
msgstr "Tyro-ს ტერმინალზე დაემატა ჩაის ფული, მაგრამ ამ გაყიდვის წერტილისთვის ჩაის ფული ჩართული არ არის. ის სანაცვლოდ დანამატად აღირიცხება."

#. module: pos_tyro
#: model:ir.model.fields,field_description:pos_tyro.field_pos_payment_method__tyro_always_print_merchant_receipt
msgid "Always print merchant receipts"
msgstr "მერჩანტის ქვითრების ყოველთვის დაბეჭდვა"

#. module: pos_tyro
#: model:ir.model.fields,help:pos_tyro.field_pos_payment_method__tyro_always_print_merchant_receipt
msgid "By default, merchant copies are only printed when a signature is required. Enable this setting to always print the merchant copy."
msgstr "ნაგულისხმევად მერჩანტის ასლები იბეჭდება მხოლოდ მაშინ, როდესაც ხელმოწერა საჭიროა. ჩართეთ ეს პარამეტრი, რომ მერჩანტის ასლი ყოველთვის დაიბეჭდოს."

