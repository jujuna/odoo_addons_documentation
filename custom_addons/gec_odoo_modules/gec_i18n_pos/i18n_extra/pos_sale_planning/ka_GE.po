#. module: pos_sale_planning
#. odoo-python
#: code:addons/pos_sale_planning/models/pos_order.py:0
msgid "The invoice for this order will be generated in the related Sales Order, because you used a payment method linked to a resource."
msgstr "ამ შეკვეთის ანგარიშ-ფაქტურა დაგენერირდება დაკავშირებულ გაყიდვის შეკვეთაში, რადგან გამოიყენეთ რესურსთან დაკავშირებული გადახდის მეთოდი."

#. module: pos_sale_planning
#: model:ir.model.fields,help:pos_sale_planning.field_pos_payment_method__resource_ids
msgid "The planning resources linked to this payment method. If there are several, the user will be able to choose on the POS which one to use when validating an order with this payment method."
msgstr "ამ გადახდის მეთოდთან დაკავშირებული დაგეგმვის რესურსები. თუ რამდენიმეა, მომხმარებელს შეეძლება POS-ში აირჩიოს, რომელი გამოიყენოს ამ გადახდის მეთოდით შეკვეთის დადასტურებისას."

#. module: pos_sale_planning
#: model:ir.model.fields,field_description:pos_sale_planning.field_pos_payment_method__type
msgid "Type"
msgstr "ტიპი"

#. module: pos_sale_planning
#. odoo-javascript
#: code:addons/pos_sale_planning/static/src/app/models/pos_order.js:0
msgid "You cannot add a resource linked payment method when the order contains lines coming from a sale order. You can split the order if you want to pay the other lines with this payment method."
msgstr "რესურსთან დაკავშირებულ გადახდის მეთოდს ვერ დაამატებთ, როდესაც შეკვეთა შეიცავს გაყიდვის შეკვეთიდან მომავალ ხაზებს. შეგიძლიათ, შეკვეთა გაყოთ, თუ გსურთ სხვა ხაზების ამ გადახდის მეთოდით გადახდა."

#. module: pos_sale_planning
#. odoo-javascript
#: code:addons/pos_sale_planning/static/src/app/screens/payment_screen/payment_screen.js:0
msgid "You cannot add another payment method if there is already a resource-linked payment on the order."
msgstr "სხვა გადახდის მეთოდს ვერ დაამატებთ, თუ შეკვეთაში უკვე არის რესურსთან დაკავშირებული გადახდა."

#. module: pos_sale_planning
#. odoo-javascript
#: code:addons/pos_sale_planning/static/src/app/screens/payment_screen/payment_screen.js:0
msgid "You cannot create an invoice for an order that will be paid with a resource-linked payment method."
msgstr "ვერ შექმნით ანგარიშ-ფაქტურას შეკვეთისთვის, რომელიც რესურსთან დაკავშირებული გადახდის მეთოდით გადაიხდება."

#. module: pos_sale_planning
#. odoo-javascript
#: code:addons/pos_sale_planning/static/src/app/screens/feedback_screen/feedback_screen.js:0
msgid "You cannot edit the payment if there is a resource-linked payment method on the order."
msgstr "გადახდას ვერ შეცვლით, თუ შეკვეთაში რესურსთან დაკავშირებული გადახდის მეთოდია."

#. module: pos_sale_planning
#. odoo-javascript
#: code:addons/pos_sale_planning/static/src/app/screens/payment_screen/payment_screen.js:0
msgid "You cannot pay with a resource-linked payment method if there are already other payments."
msgstr "რესურსთან დაკავშირებული გადახდის მეთოდით ვერ გადაიხდით, თუ უკვე არსებობს სხვა გადახდები."

#. module: pos_sale_planning
#. odoo-python
#: code:addons/pos_sale_planning/models/pos_order.py:0
msgid "You cannot set the order to be invoiced because you used a payment method linked to a resource. The invoice will be generated in the related Sales Order."
msgstr "შეკვეთაზე ანგარიშ-ფაქტურის გამოწერას ვერ მიუთითებთ, რადგან გამოიყენეთ რესურსთან დაკავშირებული გადახდის მეთოდი. ანგარიშ-ფაქტურა დაგენერირდება დაკავშირებულ გაყიდვის შეკვეთაში."

#. module: pos_sale_planning
#. odoo-python
#: code:addons/pos_sale_planning/models/pos_order.py:0
msgid "You cannot use more than one payment method when one of them is linked to a resource"
msgstr "ერთზე მეტ გადახდის მეთოდს ვერ გამოიყენებთ, როდესაც ერთ-ერთი მათგანი რესურსთან არის დაკავშირებული"

#. module: pos_sale_planning
#. odoo-python
#: code:addons/pos_sale_planning/models/sale_order.py:0
msgid "id"
msgstr "id"
