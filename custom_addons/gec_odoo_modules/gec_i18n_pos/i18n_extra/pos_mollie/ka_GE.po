#. module: pos_mollie
#: model:ir.module.module,summary:base.module_pos_mollie
msgid "Integrate your POS with a Mollie payment terminal"
msgstr "თქვენი POS-ის ინტეგრაცია Mollie-ს გადახდის ტერმინალთან"

#. module: pos_mollie
#: model_terms:ir.ui.view,arch_db:pos_mollie.pos_payment_method_view_form_inherit_pos_mollie
