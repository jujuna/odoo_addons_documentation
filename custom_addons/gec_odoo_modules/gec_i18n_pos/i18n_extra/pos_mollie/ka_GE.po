#. module: pos_mollie
#. odoo-javascript
#: code:addons/pos_mollie/static/src/payment_mollie.js:0
msgid "No internet connection. Waiting for recovery to confirm the payment..."
msgstr "ინტერნეტკავშირი არ არის. გადახდის დასადასტურებლად ველოდებით კავშირის აღდგენას..."

#. module: pos_mollie
#: model:ir.module.module,shortdesc:base.module_pos_mollie
msgid "POS Mollie"
msgstr "POS Mollie"

#. module: pos_mollie
#. odoo-python
#: code:addons/pos_mollie/models/pos_payment_method.py:0
msgid "Please set the API key on the Mollie payment provider before making a payment."
msgstr "გთხოვთ, გადახდის განხორციელებამდე მიუთითოთ API გასაღები Mollie-ს გადახდის მიმწოდებელზე."

#. module: pos_mollie
#: model:ir.model,name:pos_mollie.model_pos_payment_method
