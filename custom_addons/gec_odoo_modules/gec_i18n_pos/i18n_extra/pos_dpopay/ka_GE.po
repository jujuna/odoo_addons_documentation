#. module: pos_dpopay
#: model:ir.model.fields,field_description:pos_dpopay.field_pos_payment_method__dpopay_test_mode
msgid "Enable Test Mode"
msgstr "სატესტო რეჟიმის ჩართვა"

#. module: pos_dpopay
#: model:ir.model.fields,help:pos_dpopay.field_pos_payment_method__dpopay_chain_id
msgid "Enter the Chain-ID header value(e.g., DPO-DTM-Testing)"
msgstr "შეიყვანეთ Chain-ID სათაურის მნიშვნელობა (მაგ., DPO-DTM-Testing)"

#. module: pos_dpopay
#: model:ir.model.fields,help:pos_dpopay.field_pos_payment_method__dpopay_mid
msgid "Enter the Merchant ID assigned by DPO Pay (e.g., 123456789012)."
msgstr "შეიყვანეთ DPO Pay-ის მიერ მინიჭებული მერჩანტის ID (მაგ., 123456789012)."

#. module: pos_dpopay
#: model:ir.model.fields,help:pos_dpopay.field_pos_payment_method__dpopay_tid
msgid "Enter the unique Terminal ID (TID) of your DPO Pay POS terminal (e.g., XXXXXXXX)."
msgstr "შეიყვანეთ თქვენი DPO Pay-ის POS ტერმინალის უნიკალური ტერმინალის ID (TID) (მაგ., XXXXXXXX)."

#. module: pos_dpopay
#. odoo-javascript
#: code:addons/pos_dpopay/static/src/app/utils/payment/payment_dpopay.js:0
msgid "Failed to cancel payment."
msgstr "გადახდის გაუქმება ვერ მოხერხდა."

#. module: pos_dpopay
#. odoo-javascript
#: code:addons/pos_dpopay/static/src/app/utils/payment/payment_dpopay.js:0
msgid "Failed to fetch last transaction result."
msgstr "ბოლო ტრანზაქციის შედეგის მიღება ვერ მოხერხდა."

#. module: pos_dpopay
#. odoo-javascript
#: code:addons/pos_dpopay/static/src/app/utils/payment/payment_dpopay.js:0
msgid "Failed to retrieve payment status."
msgstr "გადახდის სტატუსის მიღება ვერ მოხერხდა."

#. module: pos_dpopay
#. odoo-javascript
#: code:addons/pos_dpopay/static/src/app/utils/payment/payment_dpopay.js:0
msgid "Failed to retrieve transaction result."
msgstr "ტრანზაქციის შედეგის მიღება ვერ მოხერხდა."

#. module: pos_dpopay
#: model:ir.model.fields,field_description:pos_dpopay.field_pos_payment__id model:ir.model.fields,field_description:pos_dpopay.field_pos_payment_method__id
msgid "ID"
msgstr "ID"

#. module: pos_dpopay
#: model:ir.module.module,summary:base.module_pos_dpopay
