msgstr "არასწორი Chain ID. გთხოვთ, შეამოწმოთ კონფიგურაცია. %s"

#. module: pos_dpopay
#. odoo-python
#: code:addons/pos_dpopay/models/pos_payment_method.py:0
msgid "Invalid endpoint"
msgstr "არასწორი endpoint"

#. module: pos_dpopay
#: model:ir.model.fields.selection,name:pos_dpopay.selection__pos_payment_method__dpopay_payment_mode__momo
msgid "Mobile Money"
msgstr "მობილური ფული"

#. module: pos_dpopay
#: model:ir.model.fields,field_description:pos_dpopay.field_pos_payment__dpopay_mobile_money_phone
msgid "Mobile Money Phone Number(Last 4 Digit)"
msgstr "მობილური ფულის ტელეფონის ნომერი (ბოლო 4 ციფრი)"

#. module: pos_dpopay
#. odoo-javascript
#: code:addons/pos_dpopay/static/src/app/utils/payment/payment_dpopay.js:0
msgid "Payment is declined by DPO Pay."
msgstr "DPO Pay-მ გადახდა უარყო."

#. module: pos_dpopay
#. odoo-javascript
#: code:addons/pos_dpopay/static/src/app/utils/payment/payment_dpopay.js:0
msgid "Payment is unsuccessful."
msgstr "გადახდა ვერ შესრულდა."

#. module: pos_dpopay
#. odoo-python
#: code:addons/pos_dpopay/models/pos_payment_method.py:0
msgid "Please ensure the device is online and confirm that the Merchant ID (MID) and Terminal ID (TID) are correct. %s"
msgstr "გთხოვთ, დარწმუნდეთ, რომ მოწყობილობა ონლაინ რეჟიმშია, და გადაამოწმოთ, რომ მერჩანტის ID (MID) და ტერმინალის ID (TID) სწორია. %s"

#. module: pos_dpopay
#: model:ir.module.module,shortdesc:base.module_pos_dpopay
msgid "PoS DPO Pay"
msgstr "PoS DPO Pay"

#. module: pos_dpopay
#: model:ir.model,name:pos_dpopay.model_pos_payment
msgid "Point of Sale Payment"
msgstr "გაყიდვის წერტილის გადახდა"

#. module: pos_dpopay
#: model:ir.model,name:pos_dpopay.model_pos_payment_method
msgid "Point of Sale Payment Method"
msgstr "გაყიდვის წერტილის გადახდის მეთოდი"

#. module: pos_dpopay
#: model:ir.model.fields,field_description:pos_dpopay.field_pos_payment__dpopay_rrn
msgid "RRN"
msgstr "RRN"

#. module: pos_dpopay
#: model:ir.model.fields,help:pos_dpopay.field_pos_payment__dpopay_transaction_ref
msgid "Reference number required for Mobile Money refund transactions."
msgstr "მობილური ფულით თანხის დაბრუნების ტრანზაქციებისთვის საჭირო მითითების ნომერი."

#. module: pos_dpopay
#: model:ir.model.fields,help:pos_dpopay.field_pos_payment__dpopay_rrn
msgid "Retrieval Reference Number generated for the DPO Pay transaction."
msgstr "DPO Pay-ის ტრანზაქციისთვის გენერირებული მოძიების მითითების ნომერი."

#. module: pos_dpopay
#: model:ir.model.fields,help:pos_dpopay.field_pos_payment_method__dpopay_client_id
msgid "The Client ID provided by DPO Pay for authenticating requests."
msgstr "DPO Pay-ის მიერ მოწოდებული კლიენტის ID მოთხოვნების ავთენტიფიკაციისთვის."

#. module: pos_dpopay
#: model:ir.model.fields,help:pos_dpopay.field_pos_payment_method__dpopay_client_secret
msgid "The Client Secret provided by DPO Pay for secure access. Keep it confidential."
msgstr "DPO Pay-ის მიერ მოწოდებული კლიენტის საიდუმლო გასაღები უსაფრთხო წვდომისთვის. შეინახეთ ის კონფიდენციალურად."

#. module: pos_dpopay
#: model:ir.model.fields,field_description:pos_dpopay.field_pos_payment__dpopay_transaction_ref
msgid "Transaction Reference"
msgstr "ტრანზაქციის ნომერი"

#. module: pos_dpopay
#. odoo-javascript
#: code:addons/pos_dpopay/static/src/app/utils/payment/payment_dpopay.js:0
msgid "Transaction amount must be greater than zero."
msgstr "ტრანზაქციის თანხა ნულზე მეტი უნდა იყოს."

#. module: pos_dpopay
#. odoo-javascript
#: code:addons/pos_dpopay/static/src/app/utils/payment/payment_dpopay.js:0
msgid "Unable to initiate DPO payment. Please try again."
msgstr "DPO-ით გადახდის დაწყება ვერ მოხერხდა. გთხოვთ, სცადოთ ხელახლა."

#. module: pos_dpopay
#. odoo-javascript
#: code:addons/pos_dpopay/static/src/app/utils/payment/payment_dpopay.js:0
msgid "Unable to reach DPO Pay terminal."
msgstr "DPO Pay-ის ტერმინალთან დაკავშირება ვერ ხერხდება."

#. module: pos_dpopay
#. odoo-python
#: code:addons/pos_dpopay/models/pos_payment_method.py:0
msgid "Unable to retrieve DPO Pay bearer token: check Client ID and Client Secret."
msgstr "DPO Pay-ის Bearer ტოკენის მიღება ვერ მოხერხდა: შეამოწმეთ კლიენტის ID და კლიენტის საიდუმლო გასაღები."
