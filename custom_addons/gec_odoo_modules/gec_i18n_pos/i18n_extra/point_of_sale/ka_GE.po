#. module: point_of_sale
#. odoo-javascript
#: code:addons/point_of_sale/static/src/backend/lna_checklist/lna_checklist.xml:0
msgid ""
"Local Network Access (LNA) is a Chrome feature that allows your browser to communicate \n"
"                directly with your local network. It means you can make your browser communicate with \n"
"                your devices without the need for importing certificates."
msgstr ""
"ლოკალურ ქსელზე წვდომა (LNA) არის Chrome-ის ფუნქცია, რომელიც თქვენს ბრაუზერს საშუალებას აძლევს,\n"
"                პირდაპირ დაუკავშირდეს თქვენს ლოკალურ ქსელს. ეს ნიშნავს, რომ შეგიძლიათ თქვენი ბრაუზერი\n"
"                დაუკავშიროთ თქვენს მოწყობილობებს სერტიფიკატების იმპორტის საჭიროების გარეშე."

#. module: point_of_sale
#. odoo-javascript
#: code:addons/point_of_sale/static/src/app/utils/init_lna.js:0
msgid "Local Network Access configuration is enabled, but your browser is not Chromium-based. Please use a Chromium-based browser to benefit from this feature. Please note that IOS devices do not support Local Network Access yet."
msgstr "ლოკალურ ქსელზე წვდომის კონფიგურაცია ჩართულია, მაგრამ თქვენი ბრაუზერი Chromium-ზე დაფუძნებული არ არის. გთხოვთ, გამოიყენოთ Chromium-ზე დაფუძნებული ბრაუზერი, რომ ამ ფუნქციით ისარგებლოთ. გთხოვთ, გაითვალისწინოთ, რომ IOS მოწყობილობები ლოკალურ ქსელზე წვდომას ჯერ მხარს არ უჭერს."

#. module: point_of_sale
#. odoo-javascript
#: code:addons/point_of_sale/static/src/app/utils/init_lna.js:0
msgid "Local Network Access is enabled for this POS, but your browser version does not support it. Please update your browser to the latest version."
msgstr "ლოკალურ ქსელზე წვდომა ამ POS-ისთვის ჩართულია, მაგრამ თქვენი ბრაუზერის ვერსია მას არ უჭერს მხარს. გთხოვთ, განაახლოთ ბრაუზერი უახლეს ვერსიამდე."

#. module: point_of_sale
#. odoo-javascript
#: code:addons/point_of_sale/static/src/app/services/pos_store.js:0
msgid "Local Network Access is not configured for this POS."
msgstr "ამ POS-ისთვის ლოკალურ ქსელზე წვდომა კონფიგურირებული არ არის."

#. module: point_of_sale
#. odoo-javascript
#: code:addons/point_of_sale/static/src/app/utils/init_lna.js:0
msgid "Local Network Access permission granted."
msgstr "ლოკალურ ქსელზე წვდომის უფლება მინიჭებულია."

#. module: point_of_sale
#. odoo-javascript
#: code:addons/point_of_sale/static/src/app/utils/init_lna.js:0
msgid "Local Network Access permission is denied. Some hardware devices might not work properly. Please allow Local Network Access in your browser settings."
msgstr "ლოკალურ ქსელზე წვდომის ნებართვა უარყოფილია. ზოგიერთმა მოწყობილობამ შეიძლება სათანადოდ არ იმუშაოს. გთხოვთ, დაუშვათ ლოკალურ ქსელზე წვდომა ბრაუზერში."

#. module: point_of_sale
#. odoo-javascript
#: code:addons/point_of_sale/static/src/app/utils/init_lna.js:0
msgid "Local Network Access permission is not yet granted. Some hardware devices might not work properly. Please allow Local Network Access in your browser settings."
msgstr "ლოკალურ ქსელზე წვდომის ნებართვა ჯერ არ არის გაცემული. ზოგიერთმა მოწყობილობამ შეიძლება სათანადოდ არ იმუშაოს. გთხოვთ, დაუშვათ ლოკალურ ქსელზე წვდომა ბრაუზერის პარამეტრებში."

