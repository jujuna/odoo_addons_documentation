<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sign_item_role_view_list" model="ir.ui.view">
        <field name="name">sign.item.role.list.id_ge_sign</field>
        <field name="model">sign.item.role</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="auth_method"/>
            </list>
        </field>
    </record>

    <record id="sign_item_role_action" model="ir.actions.act_window">
        <field name="name">Roles</field>
        <field name="res_model">sign.item.role</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="sign_item_role_menu"
              name="Roles"
              parent="sign.menu_sign_configuration"
              action="sign_item_role_action"
              groups="sign.group_sign_manager"
              sequence="15"/>

</odoo>
