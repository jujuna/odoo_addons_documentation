#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.homepage
msgid ""
"<span class=\"h3-fs\">Our philosophy is grounded in holistic wellness and "
"personalized care. What began as a small initiative has transformed into a "
"center committed to fostering health and well-being through tailored "
"programs and community engagement.</span>"
msgstr ""
"<span class=\"h3-fs\">ჩვენი ფილოსოფია ჰოლისტიკურ ველნესსა და პერსონალიზებულ ზრუნვას ეფუძნება. ის, რაც მცირე ინიციატივით დაიწყო, ცენტრად იქცა, რომელიც ჯანმრთელობასა და კეთილდღეობას ინდივიდუალური პროგრამებითა და საზოგადოების ჩართულობით უწყობს ხელს.</span>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid ""
"<span style=\"font-size: 30px;\">Basics</span><span class=\"h1-fs\">\n"
"        </span>"
msgstr ""
"<span style=\"font-size: 30px;\">საფუძვლები</span><span class=\"h1-fs\">\n"
"        </span>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.homepage
msgid ""
"<strong>\n"
"                        <font class=\"text-o-color-1\">OUR PHILOSOPHY</font>\n"
"                      </strong>"
msgstr ""
"<strong>\n"
"                        <font class=\"text-o-color-1\">ჩვენი ფილოსოფია</font>\n"
"                      </strong>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid "<strong> Plan Shifts</strong>"
msgstr "<strong> ცვლების დაგეგმვა</strong>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid ""
"<strong><b>Appointment App</b>: </strong>Manage bookings for spa entrances "
"and massages with a clear, flexible schedule that prevents double-"
"booking.<br/>"
msgstr ""
"<strong><b>შეხვედრების დაჯავშნის აპლიკაცია</b>: </strong>მართეთ სპაში შესვლისა და მასაჟის ჯავშნები მკაფიო, მოქნილი განრიგით, რომელიც ორმაგ ჯავშნებს გამორიცხავს.<br/>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid ""
"<strong><b>Inventory App</b>: </strong>Monitor the consumption of wellness "
"products like essential oils and towels to ensure you are always "
"prepared.<br/>"
msgstr ""
"<strong><b>მარაგების აპლიკაცია</b>: </strong>აკონტროლეთ ველნეს-პროდუქტების, მაგალითად ეთერზეთებისა და პირსახოცების, მოხმარება, რათა ყოველთვის მზად იყოთ ყველაფრისთვის.<br/>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid ""
"<strong><b>Planning App</b>: </strong>Organize your therapists' schedules "
"efficiently to match staff availability with treatment bookings.<br/>"
msgstr ""
"<strong><b>დაგეგმვის აპლიკაცია</b>: </strong>ეფექტურად დაგეგმეთ თერაპევტების განრიგი, რათა პერსონალის ხელმისაწვდომობა პროცედურების ჯავშნებს შეესაბამებოდეს.<br/>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid ""
"<strong><b>Point of Sale App</b>: </strong>Upsell relaxation by selling "
"tickets, cosmetics, and accessories like bathrobes directly at the "
"reception.<br/>"
msgstr ""
"<strong><b>გაყიდვის წერტილის აპლიკაცია</b>: </strong>გაზარდეთ გაყიდვები — ბილეთები, კოსმეტიკა, აქსესუარები და ხალათები, პირდაპირ მიმღებში გაყიდეთ.<br/>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid ""
"<strong><b>Sales App</b>: </strong>Handle complex bookings like group offers"
" and special spa packages by sending professional quotations.<br/>"
msgstr ""
"<strong><b>გაყიდვების აპლიკაცია</b>: </strong>მართეთ კომპლექსური ჯავშნები, მაგალითად ჯგუფური შეთავაზებები და სპეციალური სპა-პაკეტები, პროფესიონალური შეთავაზებების გაგზავნით.<br/>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid ""
"<strong><b>Website &amp; eCommerce App</b>: </strong>Showcase your wellness "
"menu online, allowing guests to book treatments and buy gift cards "
"24/7.<br/>"
msgstr ""
"<strong><b>ვებსაიტისა და ელკომერციის აპლიკაცია</b>: </strong>წარმოადგინეთ თქვენი ველნეს-მენიუ ონლაინ, რათა სტუმრებს 24/7-ზე შეეძლოთ პროცედურების დაჯავშნა და სასაჩუქრე ბარათების შეძენა.<br/>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid ""
"<strong>Accounting</strong> helps you manage all finances, payments, and "
"reconciliations in one integrated system."
msgstr ""
"<strong>ბუღალტერია</strong> გეხმარებათ, ყველა ფინანსი, გადახდა და შეჯერება ერთ ინტეგრირებულ სისტემაში მართოთ."

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid "<strong>Coupons</strong>"
msgstr "<strong>კუპონები</strong>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid "<strong>Define Hours &amp; Roles</strong>"
msgstr "<strong>სამუშაო საათებისა და როლების განსაზღვრა</strong>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid ""
"<strong>Events</strong> lets you create and manage workshops, wellness "
"weekends, or private retreats with online registration and ticketing."
msgstr ""
"<strong>ღონისძიებები</strong> საშუალებას გაძლევთ, შექმნათ და მართოთ ვორქშოპები, ველნეს-შაბათ-კვირები ან კერძო რიტრიტები ონლაინ რეგისტრაციითა და ბილეთებით."

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid "<strong>Gift Cards</strong>"
msgstr "<strong>სასაჩუქრე ბარათები</strong>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid "<strong>Link Appointments to Products</strong>"
msgstr "<strong>შეხვედრების პროდუქტებთან დაკავშირება</strong>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid "<strong>Loyalty Cards, Gift Cards, Coupons &amp; Promo Codes</strong>"
msgstr ""
"<strong>ლოიალობის ბარათები, სასაჩუქრე ბარათები, კუპონები და პრომოკოდები</strong>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid "<strong>Loyalty Cards</strong>"
msgstr "<strong>ლოიალობის ბარათები</strong>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid ""
"<strong>Maintenance</strong> schedules and monitors upkeep for spa equipment"
" such as saunas, massage tables, pools, and other installations."
msgstr ""
"<strong>ტექმომსახურება</strong> გეგმავს და აკონტროლებს სპა-აღჭურვილობის — საუნების, სამასაჟო მაგიდების, აუზებისა და სხვა დანადგარების — მოვლას."

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid "<strong>Manage Purchases</strong>"
msgstr "<strong>შესყიდვების მართვა</strong>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid "<strong>Point of Sale (POS) at Reception</strong>"
msgstr "<strong>გაყიდვის წერტილი (POS) მიმღებში</strong>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid "<strong>Promo Codes</strong>"
msgstr "<strong>პრომოკოდები</strong>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid "<strong>Quotations for Groups or Special Requests</strong>"
msgstr ""
"<strong>შეთავაზებები ჯგუფებისთვის ან სპეციალური მოთხოვნებისთვის</strong>"

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid ""
"<strong>Restaurant/Bar Point of Sale</strong> allows you to sell food and "
"drinks if your spa resort offers a restaurant or bar service."
msgstr ""
"<strong>რესტორნის/ბარის გაყიდვის წერტილი</strong> საშუალებას გაძლევთ, გაყიდოთ საკვები და სასმელი, თუ თქვენს სპა-რეზორტს რესტორანი ან ბარი აქვს."

#. module: spa_resort
#: model_terms:ir.ui.view,arch_db:spa_resort.welcome_article_body
msgid "<strong>Set Pricelists</strong>"
msgstr "<strong>ფასების სიების დაყენება</strong>"

#. module: spa_resort
