#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.contactus
msgid "*salesteam*"
msgstr "*salesteam*"

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.welcome_article_body
msgid ", and feel free to"
msgstr " და თავისუფლად"

#. module: industry_real_estate
#: model:website.page,url:industry_real_estate.website_page_9
msgid "/about-us"
msgstr "/about-us"

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.homepage
#: model_terms:ir.ui.view,arch_db:industry_real_estate.ir_ui_view_1416
msgid "<b>ABOUT US</b>"
msgstr "<b>ჩვენ შესახებ</b>"

#. module: industry_real_estate
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_27
msgid ""
"<b>Architectural Excellence:</b> A modern duplex layout that maximizes both "
"privacy and social space."
msgstr ""
"<b>არქიტექტურული სრულყოფილება:</b> თანამედროვე დუპლექსის განლაგება, რომელიც მაქსიმალურად უზრუნველყოფს როგორც პირად, ისე საერთო სივრცეს."

#. module: industry_real_estate
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_27
msgid ""
"<b>Breathtaking Views:</b> Wide-angle vistas of the Uccle skyline from your "
"private balcony."
msgstr ""
"<b>თვალწარმტაცი ხედები:</b> უკლის ჰორიზონტის ფართო ხედები თქვენი პირადი აივნიდან."

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.welcome_article_body
msgid ""
"<b>CRM App</b>: Manage your leads efficiently, tracking ongoing buying and selling opportunities in a visual\n"
"                pipeline."
msgstr ""
"<b>CRM აპლიკაცია</b>: ეფექტურად მართეთ ლიდები და თვალი ადევნეთ ყიდვა-გაყიდვის მიმდინარე შესაძლებლობებს ვიზუალურ პაიპლაინში."

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.welcome_article_body
msgid ""
"<b>Contacts App: </b>Centralize all stakeholder data, managing the unique relationships between property owners,\n"
"                tenants, and service providers within a single, searchable directory with full communication history."
msgstr ""
"<b>კონტაქტების აპლიკაცია: </b>მოაქციეთ დაინტერესებული პირების ყველა მონაცემი ერთ ადგილას და მართეთ ქონების მფლობელებს, მოიჯარეებსა და მომსახურების მიმწოდებლებს შორის ურთიერთობები ერთიან, საძიებო ცნობარში კომუნიკაციის სრული ისტორიით."

#. module: industry_real_estate
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_20
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_21
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_22
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_26
msgid "<b>Contemporary Heritage Living</b>"
msgstr "<b>თანამედროვე ცხოვრება ისტორიულ გარემოში</b>"

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.welcome_article_body
msgid ""
"<b>Create a Contract:</b> Click \"New\" and select the tenant as the "
"\"Customer\" and add the Rental fee product."
msgstr ""
"<b>შექმენით ხელშეკრულება:</b> დააკლიკეთ „ახალი“ ღილაკზე, „კლიენტად“ აირჩიეთ მდგმური და დაამატეთ ქირის პროდუქტი."

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.welcome_article_body
msgid ""
"<b>Create a Property:</b> Click \"New\" to create a unit. Fill in its "
"building, location and other details."
msgstr ""
"<b>შექმენით ობიექტი:</b> დააკლიკეთ „ახალი“ ღილაკზე ერთეულის შესაქმნელად. შეავსეთ მისი შენობა, მდებარეობა და სხვა დეტალები."

#. module: industry_real_estate
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_20
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_21
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_22
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_26
msgid ""
"<b>Designer Interiors:</b> Each unit features unique, modern furniture "
"packages and high-quality flooring."
msgstr ""
"<b>დიზაინერული ინტერიერი:</b> თითოეულ ერთეულს აქვს უნიკალური, თანამედროვე ავეჯის კომპლექტი და მაღალი ხარისხის იატაკი."

#. module: industry_real_estate
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_23
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_24
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_25
msgid ""
"<b>Diverse Space Options:</b> Whether you need a collaborative hub "
"(<b>Office M</b>), a focused executive suite (<b>Office S</b>), or a "
"spacious flagship floor (<b>Office T</b>), we have the right fit for your "
"team."
msgstr ""
"<b>სივრცის მრავალფეროვანი არჩევანი:</b> რაც არ უნდა დაგჭირდეთ - თანამშრომლობისთვის განკუთვნილი სივრცე (<b>Office M</b>), ხელმძღვანელისთვის მყუდრო კაბინეტი (<b>Office S</b>) თუ ვრცელი წარმომადგენლობითი სართული (<b>Office T</b>) — თქვენი გუნდისთვის შესაფერისი სივრცე გვაქვს."

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.welcome_article_body
msgid ""
"<b>Documents App:</b> Store signed leases, property deeds, and insurance "
"certificates with expiration alerts."
msgstr ""
"<b>დოკუმენტების აპლიკაცია:</b> შეინახეთ ხელმოწერილი იჯარის ხელშეკრულებები, საკუთრების დოკუმენტები და სადაზღვევო სერტიფიკატები ვადის გასვლის შეხსენების ფუნქციასთან ერთად."

#. module: industry_real_estate
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_23
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_24
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_25
msgid ""
"<b>Elite Location:</b> Situated in the prestigious <b>Louise area</b>, "
"providing immediate access to world-class dining, high-end retail, and "
"excellent transport links."
msgstr ""
"<b>ელიტური მდებარეობა:</b> მდებარეობს პრესტიჟულ <b>ლუიზის რაიონში</b>, მსოფლიო დონის რესტორნებთან, მაღალი კლასის მაღაზიებთან და შესანიშნავ სატრანსპორტო კავშირებთან ახლოს."

#. module: industry_real_estate
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_23
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_24
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_25
msgid ""
"<b>Fully Equipped Amenities:</b> Access to premium lounges, designer meeting"
" rooms, and state-of-the-art infrastructure."
msgstr ""
"<b>სრულად აღჭურვილი სივრცეები:</b> წვდომა პრემიუმ ლაუნჯებზე, დიზაინერულ სათათბირო ოთახებსა და თანამედროვე ინფრასტრუქტურაზე."

#. module: industry_real_estate
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_20
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_21
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_22
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_23
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_24
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_25
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_26
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_27
msgid "<b>Key Highlights:</b>"
msgstr "<b>მთავარი უპირატესობები:</b>"

#. module: industry_real_estate
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_23
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_24
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_25
msgid ""
"<b>Modern Industrial Aesthetic:</b> Features high ceilings, exposed "
"ductwork, and abundant natural light to foster creativity and productivity."
msgstr ""
"<b>თანამედროვე ინდუსტრიული ესთეტიკა:</b> მაღალი ჭერი, ღია სავენტილაციო სისტემა და უხვი ბუნებრივი განათება შემოქმედებითობისა და პროდუქტიულობისთვის."

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.welcome_article_body
msgid ""
"<b>Move-in Logs:</b> Utilize the dedicated property tab to record meter "
"readings (water, electricity) at the time of the tenant's entry and exit to "
"ensure accurate utility re-billing later."
msgstr ""
"<b>შესახლების ჩანაწერები:</b> გამოიყენეთ ობიექტის სპეციალური ჩანართი, რათა მდგმურის შესვლისა და გასვლისას დააფიქსიროთ მრიცხველების ჩვენებები (წყალი, ელექტროენერგია) და შემდეგ კომუნალური ხარჯები ზუსტად გადაახდევინოთ."

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.welcome_article_body
msgid ""
"<b>Open the Availability</b>: Open the <strong>Leasing App</strong> and "
"navigate through the app menu Availability"
msgstr ""
"<b>გახსენით ხელმისაწვდომობა</b>: გახსენით <strong>იჯარის აპლიკაცია</strong> და გადადით აპლიკაციის მენიუში „ხელმისაწვდომობა“"

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.welcome_article_body
msgid ""
"<b>Open the Contracts</b>: Open the <strong>Leasing App</strong> to reach "
"the Subscriptions."
msgstr ""
"<b>გახსენით ხელშეკრულებები</b>: გახსენით <strong>იჯარის აპლიკაცია</strong> ხელმოწერებზე გადასასვლელად."

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.welcome_article_body
msgid ""
"<b>Open the Properties: </b>Open the <b>Leasing App </b>and navigate through"
" the app menu Infrastructure / Properties."
msgstr ""
"<b>გახსენით ობიექტები: </b>გახსენით <b>იჯარის აპლიკაცია </b>და გადადით აპლიკაციის მენიუში „ინფრასტრუქტურა / ობიექტები“."

#. module: industry_real_estate
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_20
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_21
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_22
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_26
msgid ""
"<b>Peaceful Setting:</b> Set within the quiet, green surroundings of a "
"beautifully repurposed farmhouse."
msgstr ""
"<b>მშვიდი გარემო:</b> მდებარეობს ლამაზად გადაკეთებული ფერმის მყუდრო, მწვანე გარემოში."

#. module: industry_real_estate
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_27
msgid ""
"<b>Prime Location:</b> Situated in one of Brussels' most sought-after "
"residential districts."
msgstr ""
"<b>საუკეთესო მდებარეობა:</b> მდებარეობს ბრიუსელის ერთ-ერთ ყველაზე მოთხოვნად საცხოვრებელ უბანში."

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.welcome_article_body
msgid ""
"<b>Pro Tip:</b> You can create a new rental contract directly from this view by clicking on an empty slot in\n"
"                    the timeline."
msgstr ""
"<b>რჩევა:</b> ამ ხედიდან შეგიძლიათ პირდაპირ შექმნათ ახალი იჯარის ხელშეკრულება — დააკლიკეთ ცარიელ სლოტზე დროის ხაზზე."

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.welcome_article_body
msgid ""
"<b>Properties App: </b>Organize your portfolio with a dedicated app to manage property listings, contracts, and\n"
"                availability status."
msgstr ""
"<b>ობიექტების აპლიკაცია: </b>მოაწესრიგეთ თქვენი პორტფელი სპეციალური აპლიკაციით, სადაც მართავთ ობიექტების განცხადებებს, ხელშეკრულებებსა და ხელმისაწვდომობის სტატუსს."

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.welcome_article_body
msgid ""
"<b>Sales App: </b>Handle offers, negotiations, and closing deals with professional quotations and digital\n"
"                signatures."
msgstr ""
"<b>გაყიდვების აპლიკაცია: </b>მართეთ შეთავაზებები, მოლაპარაკებები და გარიგებების დახურვა პროფესიონალური შეთავაზებებითა და ციფრული ხელმოწერებით."

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.welcome_article_body
msgid "<b>Select the Property:</b> Select the \"Property\" to rent."
msgstr "<b>აირჩიეთ ობიექტი:</b> აირჩიეთ გასაქირავებელი „ობიექტი“."

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.welcome_article_body
msgid ""
"<b>Sign App:</b> Send lease agreements for legally binding electronic "
"signatures."
msgstr ""
"<b>ხელმოწერის აპლიკაცია:</b> გაგზავნეთ იჯარის ხელშეკრულებები იურიდიულად სავალდებულო ელექტრონული ხელმოწერისთვის."

#. module: industry_real_estate
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_27
msgid "<b>Sky-High Sophistication in Uccle</b>"
msgstr "<b>მაღალი დახვეწილობა უკლში</b>"

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.welcome_article_body
msgid ""
"<b>Subscriptions App: </b>Automate the collection of recurring rent and service charges with flexible billing\n"
"                cycles, ensuring consistent cash flow and effortless lease renewals."
msgstr ""
"<b>ხელმოწერების აპლიკაცია: </b>მოახდინეთ რეგულარული ქირისა და მომსახურების საფასურის აკრეფის ავტომატიზაცია მოქნილი ბილინგის ციკლებით — სტაბილური ფულადი ნაკადისა და იჯარის მარტივი განახლებისთვის."

#. module: industry_real_estate
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_23
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_24
#: model_terms:product.template,description_ecommerce:industry_real_estate.product_template_prop_25
msgid "<b>The Future of Work in the Heart of Brussels</b>"
msgstr "<b>სამუშაოს მომავალი ბრიუსელის გულში</b>"

#. module: industry_real_estate
#: model_terms:ir.ui.view,arch_db:industry_real_estate.welcome_article_body
msgid ""
"<b>Timeline:</b> Specify the start date, the recurring period (monthly, quarterly, etc.) and the expiration of\n"
"                the contract."
msgstr ""
"<b>ვადები:</b> მიუთითეთ დაწყების თარიღი, განმეორების პერიოდი (ყოველთვიური, კვარტალური და ა.შ.) და ხელშეკრულების ვადის გასვლის თარიღი."

#. module: industry_real_estate
