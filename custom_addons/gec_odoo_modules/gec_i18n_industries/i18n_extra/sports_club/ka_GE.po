#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Accounting:</strong> Automatically log payments, close sessions, and\n"
"                    generate tax reports."
msgstr ""
"<strong>ბუღალტერია:</strong> ავტომატურად აღრიცხეთ გადახდები, დახურეთ სესიები და შექმენით საგადასახადო ანგარიშები."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.contactus
msgid "<strong>Are links to other websites approved?</strong>"
msgstr "<strong>სხვა ვებსაიტების ბმულები დამოწმებულია?</strong>"

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Automated Lead Generation:</strong> Every submission on your \"Contact Us\"\n"
"                    page instantly creates a brand-new opportunity in your <strong>CRM App</strong>."
msgstr ""
"<strong>ლიდების ავტომატური გენერირება:</strong> „დაგვიკავშირდით“ გვერდზე გაგზავნილი ყველა ფორმა მომენტალურად ქმნის ახალ შესაძლებლობას თქვენს <strong>CRM აპლიკაციაში</strong>."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid "<strong>Availability:</strong> Exclusive to Friday evenings."
msgstr "<strong>ხელმისაწვდომობა:</strong> ექსკლუზიურად პარასკევს საღამოობით."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Cafeteria:</strong> Running their on-site food and beverage\n"
"                            services."
msgstr ""
"<strong>კაფეტერია:</strong> ადგილზე მართავს კვებისა და სასმელების სერვისებს."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.contactus
msgid "<strong>Can you trust our partners?</strong>"
msgstr "<strong>შეგიძლიათ ენდოთ ჩვენს პარტნიორებს?</strong>"

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Court Rentals:</strong> Managing bookings and scheduling for\n"
"                            players."
msgstr ""
"<strong>კორტების გაქირავება:</strong> მოთამაშეების ჯავშნებისა და განრიგის მართვა."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid "<strong>Duration:</strong> 60-minute playing sessions."
msgstr "<strong>ხანგრძლივობა:</strong> 60-წუთიანი თამაშის სესიები."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Flexible Fulfillment:</strong> Customers can choose between convenient\n"
"                    paid home delivery or free in-club pickup."
msgstr ""
"<strong>მოქნილი მიწოდება:</strong> კლიენტებს შეუძლიათ აირჩიონ: მოსახერხებელი ფასიანი მიწოდება სახლში ან უფასო გატანა კლუბიდან."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Frequency:</strong> Slots start every 30 minutes to maximize court\n"
"                    turnover and availability."
msgstr ""
"<strong>სიხშირე:</strong> სლოტები ყოველ 30 წუთში იწყება, რათა კორტების გამოყენება და ხელმისაწვდომობა მაქსიმალური იყოს."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>From the CRM app:</strong> Track client interactions in real time and use\n"
"                    the <strong>Sales\n"
"                        App</strong> to quickly shoot over tailored quotations for B2B leads or\n"
"                    custom customer requests, or use the <strong>Subscription App</strong> for new\n"
"                    members."
msgstr ""
"<strong>CRM აპლიკაციიდან:</strong> რეალურ დროში აკონტროლეთ კლიენტებთან ურთიერთობა და გამოიყენეთ <strong>გაყიდვების\n"
"                        აპლიკაცია</strong> B2B ლიდებისთვის ან კლიენტების ინდივიდუალური მოთხოვნებისთვის მორგებული შეთავაზებების სწრაფად გასაგზავნად, ხოლო ახალი წევრებისთვის გამოიყენეთ — <strong>ხელმოწერების აპლიკაცია</strong>."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Full Restaurant Capabilities:</strong> Do you have a kitchen or\n"
"                            seated dining area? Map out a visual table layout right in the system\n"
"                            and integrate a digital <strong>Kitchen Display System (KDS)</strong> to\n"
"                            seamlessly coordinate orders between the floor and the kitchen."
msgstr ""
"<strong>რესტორნის სრული შესაძლებლობები:</strong> გაქვთ სამზარეულო ან დასაჯდომი სივრცე? შექმენით მაგიდების ვიზუალური განლაგება პირდაპირ სისტემაში და დააინტეგრირეთ ციფრული <strong>სამზარეულოს ეკრანის სისტემა (KDS)</strong> დარბაზსა და სამზარეულოს შორის შეკვეთების შეუფერხებლად კოორდინაციისთვის."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Gear &amp; Equipment:</strong> Handling basic sports gear and\n"
"                            inventory."
msgstr ""
"<strong>ეკიპირება და აღჭურვილობა:</strong> ძირითადი სპორტული ეკიპირებისა და მარაგის მართვა."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.contactus
msgid "<strong>How is your data secured?</strong>"
msgstr "<strong>როგორ არის თქვენი მონაცემები დაცული?</strong>"

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Instant Checkout:</strong> If a player needs gear right before a match or\n"
"                    wants to buy items directly at the club, staff can process the transaction\n"
"                    instantly using the dedicated Shop POS system."
msgstr ""
"<strong>მომენტალური ანგარიშსწორება:</strong> თუ მოთამაშეს მატჩის წინ ეკიპირება სჭირდება ან ნივთების პირდაპირ კლუბში ყიდვა სურს, პერსონალს შეუძლია ტრანზაქციის მომენტალურად დამუშავება მაღაზიის სპეციალური POS სისტემით."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Instant Member Scanning:</strong> Link unique barcodes to your\n"
"                            members' profiles. Staff can simply scan a physical or digital\n"
"                            membership card at the bar to instantly apply their preferential\n"
"                            discounts or tab the drinks to their account."
msgstr ""
"<strong>წევრების მომენტალური სკანირება:</strong> მიაბით უნიკალური შტრიხკოდები წევრების პროფილებს. პერსონალს შეუძლია უბრალოდ დაასკანეროს ფიზიკური ან ციფრული წევრობის ბარათი ბარში, რათა მომენტალურად გამოიყენოს შეღავათიანი ფასდაკლებები ან სასმელები წევრის ანგარიშზე ჩაწეროს."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Internal Counter Bookings:</strong> For walk-ins or phone reservations,\n"
"                    counter employees can seamlessly book courts on behalf of members by navigating\n"
"                    to the <strong>Appointments\n"
"                        &gt; Resource Schedule</strong> menu."
msgstr ""
"<strong>შიდა დაჯავშნა მიმღებიდან:</strong> ადგილზე მოსულებისთვის ან სატელეფონო ჯავშნებისთვის მიმღების თანამშრომლებს შეუძლიათ წევრების სახელით კორტები მარტივად დაჯავშნონ მენიუდან <strong>შეხვედრების დაჯავშნა\n"
"                        &gt; რესურსების განრიგი</strong>."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.contactus
msgid "<strong>Is the website user-friendly?</strong>"
msgstr ""
"<strong>არის თუ არა ვებსაიტი მოსახერხებელი და მარტივად გამოსაყენებელი?</strong>"

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Payroll:</strong> Use this feature to handle <strong>employee\n"
"                    salaries and manage holiday requests</strong>."
msgstr ""
"<strong>ხელფასები:</strong> გამოიყენეთ ეს ფუნქცია <strong>თანამშრომლების ხელფასებისა და შვებულების მოთხოვნების სამართავად</strong>."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Purpose:</strong> Designed for social play, allowing individual players\n"
"                    to sign up and join open, existing games."
msgstr ""
"<strong>დანიშნულება:</strong> შექმნილია სოციალური თამაშისთვის — ცალკეულ მოთამაშეებს შეუძლიათ დარეგისტრირდნენ და შეუერთდნენ ღია, უკვე არსებულ თამაშებს."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Shareable Court Resources:</strong> Because the courts are configured as <strong>shareable\n"
"                    resources</strong>, multiple players can register for the same court\n"
"                    simultaneously. The system will continue to accept registrations for a slot as\n"
"                    long as there are open spots available on that court."
msgstr ""
"<strong>გაზიარებადი კორტის რესურსები:</strong> რადგან კორტები კონფიგურირებულია როგორც <strong>გაზიარებადი\n"
"                    რესურსები</strong>, ერთსა და იმავე კორტზე ერთდროულად რამდენიმე მოთამაშეს შეუძლია დარეგისტრირება. სისტემა სლოტზე რეგისტრაციებს მანამ მიიღებს, სანამ ამ კორტზე თავისუფალი ადგილები დარჩება."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Smart Pricelists:</strong> Link these membership levels to custom\n"
"                    pricelists. The system will automatically apply preferential rates, bar\n"
"                    discounts, or free bookings whenever the member makes a purchase."
msgstr ""
"<strong>ჭკვიანი ფასების სიები:</strong> დაუკავშირეთ წევრობის დონეები ინდივიდუალურ ფასების სიებს. როდესაც წევრი შენაძენს აკეთებს, სისტემა ავტომატურად გამოიყენებს შეღავათიან ტარიფებს, ბარის ფასდაკლებებს ან უფასო ჯავშნებს."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
msgid ""
"<strong>Smart Upselling:</strong> The system automatically maximizes revenue. For\n"
"                    example, when a customer purchases a racket, the eShop strategically suggests\n"
"                    relevant add-ons like towels or balls before checkout."
msgstr ""
"<strong>ჭკვიანი დამატებითი გაყიდვები:</strong> სისტემა შემოსავალს ავტომატურად ზრდის. მაგალითად, როდესაც კლიენტი ჩოგანს ყიდულობს, ონლაინ მაღაზია ყიდვის დასრულებამდე შესაბამის დამატებით ნივთებს სთავაზობს, მაგალითად პირსახოცებს ან ბურთებს."

#. module: sports_club
#: model_terms:ir.ui.view,arch_db:sports_club.welcome_article_body
