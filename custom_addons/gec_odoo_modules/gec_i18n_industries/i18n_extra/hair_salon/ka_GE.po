#. module: hair_salon
#: model_terms:ir.ui.view,arch_db:hair_salon.view_page_home
msgid ""
"<span class=\"text-o-color-1\">A flawless blow-dry with volume, movement, "
"and a polished, long-lasting result.</span>"
msgstr ""
"<span class=\"text-o-color-1\">უნაკლო მოცულობითი ვარცხნილობა, დახვეწილი, ხანგრძლივი შედეგით.</span>"

#. module: hair_salon
#: model_terms:ir.ui.view,arch_db:hair_salon.view_page_home
msgid ""
"<span class=\"text-o-color-1\">A fully customized haircut and styling experience designed to enhance your features and reflect your personal style.</span>\n"
"                                                        <br/>"
msgstr ""
"<span class=\"text-o-color-1\">სრულიად პერსონალიზირებული თმის შეჭრა და სტაილინგი, რომელიც თქვენს ნაკვთებს უსვამს ხაზს და თქვენს პირად სტილს ასახავს.</span>\n"
"                                                        <br/>"

#. module: hair_salon
#: model_terms:ir.ui.view,arch_db:hair_salon.view_page_home
msgid ""
"<span class=\"text-o-color-1\">A relaxing, high-end scalp treatment "
"combining massage and targeted care to stimulate growth and restore "
"balance.</span>"
msgstr ""
"<span class=\"text-o-color-1\">სარელაქსაციო, მაღალი კლასის სკალპის პროცედურა, რომელიც მასაჟსა და მიზნობრივ მოვლას აერთიანებს თმის ზრდის სტიმულირებისა და ბალანსის აღდგენისთვის.</span>"

#. module: hair_salon
#: model_terms:ir.ui.view,arch_db:hair_salon.view_page_home
msgid ""
"<span class=\"text-o-color-1\">Bespoke hairstyles for weddings, galas, and special events, crafted with elegance and long-lasting perfection.</span>\n"
"                                                        <br/>"
msgstr ""
"<span class=\"text-o-color-1\">ინდივიდუალური ვარცხნილობები ქორწილებისთვის, გალა-საღამოებისა და სპეციალური ღონისძიებებისთვის — ელეგანტური და ხანგრძლივად უნაკლო.</span>\n"
"                                                        <br/>"

#. module: hair_salon
#: model_terms:ir.ui.view,arch_db:hair_salon.view_page_home
msgid ""
"<span class=\"text-o-color-1\">Hand-painted highlights inspired by the natural glow of the Mediterranean sun for a soft, luminous finish.</span>\n"
"                                                        <br/>"
msgstr ""
"<span class=\"text-o-color-1\">ხელით შესრულებული მელირება, შთაგონებული ხმელთაშუა ზღვის მზის ბუნებრივი ნათებით, რბილი და მანათობელი შედეგისთვის.</span>\n"
"                                                        <br/>"

#. module: hair_salon
#: model_terms:ir.ui.view,arch_db:hair_salon.view_page_home
msgid ""
"<span class=\"text-o-color-1\">Intensive restoration treatment to repair, strengthen, and deeply nourish the hair for lasting shine and vitality.</span>\n"
