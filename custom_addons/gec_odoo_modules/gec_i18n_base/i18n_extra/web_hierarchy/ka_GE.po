#. module: web_hierarchy
#: model:ir.model,name:web_hierarchy.model_ir_actions_act_window_view
msgid "Action Window View"
msgstr "მოქმედების ფანჯრის ხედი"

#. module: web_hierarchy
#: model:ir.model,name:web_hierarchy.model_base
msgid "Base"
msgstr "ბაზა"

#. module: web_hierarchy
#. odoo-javascript
#: code:addons/web_hierarchy/static/src/hierarchy_model.js:0
msgid "Cannot change the parent because it will cause a cyclic."
msgstr "მშობლის შეცვლა შეუძლებელია, რადგან ეს ციკლს გამოიწვევს."

#. module: web_hierarchy
#: model:ir.model.fields,field_description:web_hierarchy.field_ir_actions_act_window_view__display_name model:ir.model.fields,field_description:web_hierarchy.field_ir_ui_view__display_name
msgid "Display Name"
msgstr "საჩვენებელი სახელი"

#. module: web_hierarchy
#: model:ir.model.fields.selection,name:web_hierarchy.selection__ir_actions_act_window_view__view_mode__hierarchy model:ir.model.fields.selection,name:web_hierarchy.selection__ir_ui_view__type__hierarchy
msgid "Hierarchy"
msgstr "იერარქია"

#. module: web_hierarchy
#. odoo-python
#: code:addons/web_hierarchy/models/ir_ui_view.py:0
msgid "Hierarchy child can only be field or template, got %s"
msgstr "იერარქიის შვილობილი ელემენტი შეიძლება იყოს მხოლოდ field ან template, მიღებულია %s"

#. module: web_hierarchy
#. odoo-python
#: code:addons/web_hierarchy/models/ir_ui_view.py:0
msgid "Hierarchy view can contain only one templates tag"
msgstr "იერარქიის ხედი მხოლოდ ერთ templates ტეგს შეიძლება შეიცავდეს"

#. module: web_hierarchy
#: model:ir.model.fields,field_description:web_hierarchy.field_ir_actions_act_window_view__id model:ir.model.fields,field_description:web_hierarchy.field_ir_ui_view__id
msgid "ID"
msgstr "ID"

#. module: web_hierarchy
#. odoo-javascript
#: code:addons/web_hierarchy/static/src/hierarchy_renderer.js:0
msgid "Impossible to update the parent node of the dragged node because no parent has been found."
msgstr "გადათრეული კვანძის მშობელი კვანძის განახლება შეუძლებელია, რადგან მშობელი ვერ მოიძებნა."

#. module: web_hierarchy
#. odoo-python
#: code:addons/web_hierarchy/models/ir_ui_view.py:0
msgid "Invalid attributes (%(invalid_attributes)s) in hierarchy view. Attributes must be in (%(valid_attributes)s)"
msgstr "არასწორი ატრიბუტები (%(invalid_attributes)s) იერარქიის ხედში. ატრიბუტები უნდა იყოს შემდეგთაგან: (%(valid_attributes)s)"

#. module: web_hierarchy
#. odoo-javascript
#: code:addons/web_hierarchy/static/src/hierarchy_controller.xml:0
msgid "New"
msgstr "ახალი"

#. module: web_hierarchy
#. odoo-javascript
#: code:addons/web_hierarchy/static/src/hierarchy_model.js:0
msgid "The parent of \"%s\" was successfully updated. Reloading records to account for other changes."
msgstr "\"%s\"-ის მშობელი წარმატებით განახლდა. ჩანაწერები ხელახლა იტვირთება სხვა ცვლილებების გასათვალისწინებლად."

#. module: web_hierarchy
#. odoo-javascript
#: code:addons/web_hierarchy/static/src/hierarchy_model.js:0
msgid "The parent record cannot be the record dragged."
msgstr "მშობელი ჩანაწერი არ შეიძლება იყოს გადათრეული ჩანაწერი."

#. module: web_hierarchy
#: model:ir.model,name:web_hierarchy.model_ir_ui_view
msgid "View"
msgstr "ნახვა"

#. module: web_hierarchy
#: model:ir.model.fields,field_description:web_hierarchy.field_ir_actions_act_window_view__view_mode model:ir.model.fields,field_description:web_hierarchy.field_ir_ui_view__type
msgid "View Type"
msgstr "ხედის ტიპი"

#. module: web_hierarchy
#: model:ir.module.module,shortdesc:base.module_web_hierarchy
msgid "Web Hierarchy"
msgstr "ვებ-იერარქია"
