#. module: digest_enterprise
#: model_terms:digest.tip,tip_description:digest_enterprise.digest_tip_web_enterprise_0
msgid "<b class=\"tip_title\">Tip: Navigate menus like a pro</b>"
msgstr "<b class=\"tip_title\">რჩევა: იმოძრავეთ მენიუებში პროფესიონალივით</b>"

#. module: digest_enterprise
#: model_terms:digest.tip,tip_description:digest_enterprise.digest_tip_web_enterprise_1
msgid "Connect your WhatsApp account to Odoo to receive inbound messages directly in your CRM."
msgstr "დააკავშირეთ თქვენი WhatsApp ანგარიში Odoo-სთან, რათა შემომავალი შეტყობინებები პირდაპირ თქვენს CRM-ში მიიღოთ."

#. module: digest_enterprise
#: model:ir.module.module,shortdesc:base.module_digest_enterprise
msgid "Digest Enterprise"
msgstr "დაიჯესტი Enterprise"

#. module: digest_enterprise
#: model_terms:digest.tip,tip_description:digest_enterprise.digest_tip_web_enterprise_0
msgid "From the Home page, start typing what you would like to access. Odoo will suggest menus matching your search. Use arrow keys and press enter to jump to your menu."
msgstr "მთავარ გვერდზე დაიწყეთ იმის წერა, რისი გახსნაც გსურთ. Odoo შემოგთავაზებთ თქვენი ძიების შესაბამის მენიუებს. გამოიყენეთ ისრები და დააჭირეთ Enter-ს სასურველ მენიუზე გადასასვლელად."

#. module: digest_enterprise
#: model:digest.tip,name:digest_enterprise.digest_tip_web_enterprise_0
msgid "Tip: Navigate menus like a pro"
msgstr "რჩევა: იმოძრავეთ მენიუებში პროფესიონალივით"

#. module: digest_enterprise
#: model:digest.tip,name:digest_enterprise.digest_tip_web_enterprise_1 model_terms:digest.tip,tip_description:digest_enterprise.digest_tip_web_enterprise_1
msgid "Tip: Your Business right in their pocket"
msgstr "რჩევა: თქვენი ბიზნესი პირდაპირ მათ ჯიბეში"
