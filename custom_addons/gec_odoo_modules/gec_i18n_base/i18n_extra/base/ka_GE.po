#. module: base
#: model:ir.model.fields,help:base.field_ir_attachment__type
msgid "You can either upload a file from your computer or copy/paste an internet link to your file."
msgstr "შეგიძლიათ ფაილი ატვირთოთ კომპიუტერიდან ან დააკოპიროთ/ჩასვათ ინტერნეტ-ბმული თქვენს ფაილზე."

#. module: base
#. odoo-python
#: code:addons/base/models/properties_base_definition.py:0
msgid "You can not change the field of a base definition"
msgstr "საბაზისო განსაზღვრების ველს ვერ შეცვლით"

#. module: base
#: model:ir.model.constraint,message:base.constraint_res_users_login_key
msgid "You can not have two users with the same login!"
msgstr "ერთი და იმავე ავტორიზაციის სახელით ორი მომხმარებელი ვერ გექნებათ!"

#. module: base
#. odoo-python
#: code:addons/base/models/res_users.py:0
msgid "You can not remove API keys unless they're yours or you are a system user"
msgstr "API გასაღებებს ვერ წაშლით, თუ ისინი თქვენი არ არის ან სისტემური მომხმარებელი არ ხართ"

#. module: base
#. odoo-python
#: code:addons/base/models/res_users.py:0
msgid "You can not remove the admin user as it is used internally for resources created by Odoo (updates, module installation, ...)"
msgstr "admin მომხმარებელს ვერ წაშლით, რადგან ის შიდა გამოყენებაშია Odoo-ს მიერ შექმნილი რესურსებისთვის (განახლებები, მოდულების დაყენება, ...)"

#. module: base
#. odoo-python
#: code:addons/base/models/res_users.py:0
msgid "You can ony call user.has_group() with your current user."
msgstr "user.has_group() მხოლოდ მიმდინარე მომხმარებლით შეგიძლიათ გამოიძახოთ."

#. module: base
#. odoo-python
#: code:addons/base/models/report_paperformat.py:0
msgid "You can select either a format or a specific page width/height, but not both."
msgstr "შეგიძლიათ აირჩიოთ ან ფორმატი, ან გვერდის კონკრეტული სიგანე/სიმაღლე, მაგრამ არა ორივე."

#. module: base
msgid "You can use '/' to indicate that the customer has no Tax ID."
msgstr "შეგიძლიათ გამოიყენოთ '/', რათა მიუთითოთ, რომ კლიენტს არ აქვს საგადასახადო ID."

#. module: base
#. odoo-python
#: code:addons/base/models/res_users.py:0
msgid "You cannot activate the superuser."
msgstr "სუპერმომხმარებელს ვერ გაააქტიურებთ."

#. module: base
#. odoo-python
#: code:addons/base/models/res_partner.py:0
msgid ""
"You cannot archive contacts linked to an active user.\n"
"Ask an administrator to archive their associated user first.\n"
"\n"
"Linked active users :\n"
"%(names)s"
msgstr ""
"აქტიურ მომხმარებელთან დაკავშირებული კონტაქტების დაარქივება შეუძლებელია.\n"
"სთხოვეთ ადმინისტრატორს, ჯერ მათთან დაკავშირებული მომხმარებელი დაარქივოს.\n"
"\n"
"დაკავშირებული აქტიური მომხმარებლები :\n"
"%(names)s"

#. module: base
#. odoo-python
#: code:addons/base/models/res_partner.py:0
msgid ""
"You cannot archive contacts linked to an active user.\n"
"You first need to archive their associated user.\n"
"\n"
"Linked active users : %(names)s"
msgstr ""
"აქტიურ მომხმარებელთან დაკავშირებული კონტაქტების დაარქივება შეუძლებელია.\n"
"ჯერ მათთან დაკავშირებული მომხმარებელი უნდა დაარქივოთ.\n"
"\n"
"დაკავშირებული აქტიური მომხმარებლები : %(names)s"

#. module: base
#. odoo-python
#: code:addons/base/models/res_lang.py:0
msgid "You cannot archive the language in which Odoo was setup as it is used by automated processes."
msgstr "ვერ დაარქივებთ იმ ენას, რომელზეც Odoo დაყენდა, რადგან მას ავტომატური პროცესები იყენებენ."

#. module: base
#. odoo-python
#: code:addons/base/models/ir_mail_server.py:0
msgid ""
"You cannot archive these Outgoing Mail Servers (%(server_usage)s) because they are still used in the following case(s):\n"
"%(usage_details)s"
msgstr ""
"ვერ დაარქივებთ ამ გამავალი ფოსტის სერვერებს (%(server_usage)s), რადგან ისინი კვლავ გამოიყენება შემდეგ შემთხვევ(ებ)ში:\n"
"%(usage_details)s"

#. module: base
#. odoo-python
#: code:addons/base/models/ir_mail_server.py:0
msgid ""
"You cannot archive this Outgoing Mail Server (%(server_usage)s) because it is still used in the following case(s):\n"
"%(usage_details)s"
msgstr ""
"ვერ დაარქივებთ ამ გამავალი ფოსტის სერვერს (%(server_usage)s), რადგან ის კვლავ გამოიყენება შემდეგ შემთხვევ(ებ)ში:\n"
"%(usage_details)s"

#. module: base
#. odoo-python
#: code:addons/base/models/ir_attachment.py:0
msgid ""
"You cannot attach an attachment to itself.\n"
"Attachment %(record)s cannot have res_id: %(res_id)s"
msgstr ""
"დანართს საკუთარ თავზე ვერ მიამაგრებთ.\n"
"დანართს %(record)s არ შეიძლება ჰქონდეს res_id: %(res_id)s"

#. module: base
#. odoo-python
#: code:addons/base/models/res_partner.py:0
msgid "You cannot create recursive Partner hierarchies."
msgstr "რეკურსიული პარტნიორის იერარქიების შექმნა შეუძლებელია."

#. module: base
#. odoo-python
#: code:addons/base/models/ir_ui_view.py:0
msgid "You cannot create recursive inherited views."
msgstr "რეკურსიულ მემკვიდრეობით ხედებს ვერ შექმნით."

#. module: base
#: model:ir.model.constraint,message:base.constraint_ir_sequence_date_range_unique_range_per_sequence
msgid "You cannot create two date ranges for the same sequence with the same date range."
msgstr "ერთი და იმავე მიმდევრობისთვის ერთი და იმავე თარიღების დიაპაზონით ორ დიაპაზონს ვერ შექმნით."

#. module: base
#. odoo-python
#: code:addons/base/models/res_users.py:0
msgid "You cannot deactivate the user you're currently logged in as."
msgstr "ვერ გამორთავთ იმ მომხმარებელს, რომლითაც ამჟამად ხართ შესული."

#. module: base
#. odoo-python
#: code:addons/models.py:0
msgid "You cannot delete %(to_delete_record)s, as it is used by %(on_restrict_record)s"
msgstr "ვერ წაშლით ჩანაწერს %(to_delete_record)s, რადგან მას იყენებს %(on_restrict_record)s"

#. module: base
#. odoo-python
#: code:addons/base/models/ir_embedded_actions.py:0
msgid "You cannot delete a default embedded action"
msgstr "ნაგულისხმევ ჩაშენებულ მოქმედებას ვერ წაშლით"

#. module: base
#. odoo-python
#: code:addons/base/models/res_groups.py:0
msgid "You cannot delete a group linked with a settings field."
msgstr "პარამეტრების ველთან დაკავშირებულ ჯგუფს ვერ წაშლით."

#. module: base
#. odoo-python
#: code:addons/base/models/res_partner.py:0
msgid ""
"You cannot delete contacts linked to an active user.\n"
"Ask an administrator to archive their associated user first.\n"
"\n"
"Linked active users :\n"
"%(names)s"
msgstr ""
"აქტიურ მომხმარებელთან დაკავშირებული კონტაქტების წაშლა შეუძლებელია.\n"
"სთხოვეთ ადმინისტრატორს, ჯერ მათთან დაკავშირებული მომხმარებელი დაარქივოს.\n"
"\n"
"დაკავშირებული აქტიური მომხმარებლები :\n"
"%(names)s"

#. module: base
#. odoo-python
#: code:addons/base/models/res_partner.py:0
msgid ""
"You cannot delete contacts linked to an active user.\n"
"You should rather archive them after archiving their associated user.\n"
"\n"
"Linked active users : %(names)s"
msgstr ""
"აქტიურ მომხმარებელთან დაკავშირებული კონტაქტების წაშლა შეუძლებელია.\n"
"სანაცვლოდ, ჯობს დაარქივოთ ისინი მათთან დაკავშირებული მომხმარებლის დაარქივების შემდეგ.\n"
"\n"
"დაკავშირებული აქტიური მომხმარებლები : %(names)s"

#. module: base
#. odoo-python
#: code:addons/base/models/ir_config_parameter.py:0
msgid "You cannot delete the %s record."
msgstr "%s ჩანაწერს ვერ წაშლით."

#. module: base
#. odoo-python
#: code:addons/base/models/res_users.py:0
msgid "You cannot delete the admin user because it is utilized in various places (such as security configurations,...). Instead, archive it."
msgstr "admin მომხმარებელს ვერ წაშლით, რადგან ის სხვადასხვა ადგილას გამოიყენება (მაგ. უსაფრთხოების კონფიგურაციებში). სანაცვლოდ დაარქივეთ."

#. module: base
#. odoo-python
#: code:addons/base/models/res_lang.py:0
msgid ""
"You cannot delete the language which is Active!\n"
"Please de-activate the language first."
msgstr ""
"აქტიურ ენას ვერ წაშლით!\n"
"ჯერ ენა გამორთეთ."

#. module: base
#. odoo-python
#: code:addons/base/models/res_lang.py:0
msgid "You cannot delete the language which is the user's preferred language."
msgstr "ვერ წაშლით ენას, რომელიც მომხმარებლის სასურველი ენაა."

#. module: base
#. odoo-python
#: code:addons/base/models/res_users.py:0
msgid "You cannot exceed %(duration)s days."
msgstr "%(duration)s დღეს ვერ გადააჭარბებთ."

#. module: base
#. odoo-python
#: code:addons/base/wizard/base_partner_merge.py:0
msgid "You cannot merge a contact with one of his parent."
msgstr "კონტაქტს მის მშობელთან ვერ გააერთიანებთ."

#. module: base
#. odoo-python
#: code:addons/base/wizard/base_partner_merge.py:0
msgid "You cannot merge contacts linked to more than one user even if only one is active."
msgstr "ერთზე მეტ მომხმარებელთან დაკავშირებულ კონტაქტებს ვერ გააერთიანებთ, თუნდაც მხოლოდ ერთი იყოს აქტიური."

#. module: base
#. odoo-python
#: code:addons/base/models/ir_config_parameter.py:0
msgid "You cannot rename config parameters with keys %s"
msgstr "კონფიგურაციის პარამეტრებს გასაღებებით %s ვერ გადაარქმევთ"

#. module: base
#. odoo-python
#: code:addons/fields_properties.py:0
msgid "You cannot use “%(property_name)s” because the linked “%(model_name)s” model doesn't exist or is invalid"
msgstr "თვისებას „%(property_name)s“ ვერ გამოიყენებთ, რადგან დაკავშირებული მოდელი „%(model_name)s“ არ არსებობს ან არასწორია"

#. module: base
#. odoo-python
#: code:addons/models.py:0
msgid ""
"You do not have enough rights to access the field \"%(field)s\" on %(document_kind)s (%(document_model)s). Please contact your system administrator.\n"
"\n"
"Operation: %(operation)s"
msgstr ""
"%(document_kind)s-ის (%(document_model)s) ველზე \"%(field)s\" წვდომისთვის საკმარისი უფლებები არ გაქვთ. გთხოვთ, დაუკავშირდეთ სისტემის ადმინისტრატორს.\n"
"\n"
"ოპერაცია: %(operation)s"

#. module: base
#. odoo-python
#: code:addons/base/models/ir_actions.py:0
msgid "You don't have enough access rights to run this action."
msgstr "ამ მოქმედების გასაშვებად საკმარისი წვდომის უფლებები არ გაქვთ."

#. module: base
#. odoo-python
#: code:addons/models.py:0
msgid "You don't have the rights to export data. Please contact an Administrator."
msgstr "მონაცემების ექსპორტის უფლება არ გაქვთ. გთხოვთ, დაუკავშირდეთ ადმინისტრატორს."

#. module: base
#. odoo-python
#: code:addons/base/wizard/base_partner_merge.py:0
msgid "You have to specify a filter for your selection."
msgstr "არჩევანისთვის ფილტრი უნდა მიუთითოთ."

#. module: base
#. odoo-python
#: code:addons/base/models/res_users.py:0
msgid "You must have at least an administrator user."
msgstr "მინიმუმ ერთი ადმინისტრატორი მომხმარებელი უნდა გყავდეთ."

#. module: base
#: model_terms:ir.actions.act_window,help:base.open_module_tree
msgid "You should try other search criteria."
msgstr "სცადეთ სხვა საძიებო კრიტერიუმები."

#. module: base
#: model_terms:res.company,invoice_terms_html:base.demo_company_id model_terms:res.company,invoice_terms_html:base.main_company
msgid "You should update this document to reflect your T&amp;C."
msgstr "უნდა განაახლოთ ეს დოკუმენტი, რათა ასახოს თქვენი წესები და პირობები."

#. module: base
#. odoo-python
#: code:addons/base/models/ir_module.py:0
msgid ""
"You try to install module \"%(module)s\" that depends on module \"%(dependency)s\".\n"
"But the latter module is not available in your system."
msgstr ""
"ცდილობთ მოდულის „%(module)s“ დაყენებას, რომელიც დამოკიდებულია მოდულზე „%(dependency)s“.\n"
"მაგრამ ეს უკანასკნელი თქვენს სისტემაში ხელმისაწვდომი არ არის."

#. module: base
#. odoo-python
#: code:addons/base/models/ir_module.py:0
