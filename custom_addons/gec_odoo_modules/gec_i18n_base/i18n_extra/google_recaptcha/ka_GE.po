#. module: google_recaptcha
#: model_terms:ir.ui.view,arch_db:google_recaptcha.res_config_settings_view_form
msgid "<i class=\"oi\" data-icon=\"east\"/> Generate reCAPTCHA v3 keys"
msgstr "<i class=\"oi\" data-icon=\"east\"/> reCAPTCHA v3 გასაღებების გენერირება"

#. module: google_recaptcha
#: model:ir.model.fields,help:google_recaptcha.field_res_config_settings__recaptcha_min_score
msgid ""
"By default, should be one of 0.1, 0.3, 0.7, 0.9.\n"
"1.0 is very likely a good interaction, 0.0 is very likely a bot"
msgstr ""
"ნაგულისხმევად უნდა იყოს ერთ-ერთი: 0.1, 0.3, 0.7, 0.9.\n"
"1.0 დიდი ალბათობით კარგი ურთიერთქმედებაა, 0.0 დიდი ალბათობით ბოტია"

#. module: google_recaptcha
#: model:ir.model,name:google_recaptcha.model_res_config_settings
msgid "Config Settings"
msgstr "კონფიგურაციის პარამეტრები"

#. module: google_recaptcha
#: model:ir.model.fields,field_description:google_recaptcha.field_ir_http__display_name model:ir.model.fields,field_description:google_recaptcha.field_res_config_settings__display_name
msgid "Display Name"
msgstr "საჩვენებელი სახელი"

#. module: google_recaptcha
#: model:ir.model.fields,field_description:google_recaptcha.field_res_config_settings__enable_recaptcha
msgid "Enable reCAPTCHA"
msgstr "reCAPTCHA-ს ჩართვა"

#. module: google_recaptcha
#: model:ir.module.module,shortdesc:base.module_google_recaptcha
msgid "Google reCAPTCHA integration"
msgstr "Google reCAPTCHA-ს ინტეგრაცია"

#. module: google_recaptcha
#: model:ir.model,name:google_recaptcha.model_ir_http
msgid "HTTP Routing"
msgstr "HTTP მარშრუტიზაცია"

#. module: google_recaptcha
#: model:ir.model.fields,field_description:google_recaptcha.field_ir_http__id model:ir.model.fields,field_description:google_recaptcha.field_res_config_settings__id
msgid "ID"
msgstr "ID"

#. module: google_recaptcha
#: model:ir.model.fields,field_description:google_recaptcha.field_res_config_settings__recaptcha_min_score
msgid "Minimum score"
msgstr "მინიმალური ქულა"

#. module: google_recaptcha
#. odoo-javascript
#: code:addons/google_recaptcha/static/src/xml/recaptcha.xml:0
msgid "Privacy Policy"
msgstr "კონფიდენციალურობის პოლიტიკა"

#. module: google_recaptcha
#: model_terms:ir.ui.view,arch_db:google_recaptcha.res_config_settings_view_form
msgid "Protect your forms from spam and abuse. If no keys are provided, no checks will be done."
msgstr "დაიცავით თქვენი ფორმები სპამისა და ბოროტად გამოყენებისგან. თუ გასაღებები მითითებული არ არის, შემოწმება არ ჩატარდება."

#. module: google_recaptcha
#. odoo-javascript
#: code:addons/google_recaptcha/static/src/xml/recaptcha.xml:0
msgid "Protected by reCAPTCHA,"
msgstr "დაცულია reCAPTCHA-ით,"

#. module: google_recaptcha
#: model:ir.model.fields,field_description:google_recaptcha.field_res_config_settings__recaptcha_private_key
msgid "Secret Key"
msgstr "საიდუმლო გასაღები"

#. module: google_recaptcha
#: model:ir.model.fields,field_description:google_recaptcha.field_res_config_settings__recaptcha_public_key
msgid "Site Key"
msgstr "საიტის გასაღები"

#. module: google_recaptcha
#. odoo-python
#: code:addons/google_recaptcha/models/ir_http.py:0
msgid "Suspicious activity detected by google reCAPTCHA."
msgstr "google reCAPTCHA-მ საეჭვო აქტივობა აღმოაჩინა."

#. module: google_recaptcha
#. odoo-javascript
#: code:addons/google_recaptcha/static/src/xml/recaptcha.xml:0
msgid "Terms of Service"
msgstr "მომსახურების პირობები"

#. module: google_recaptcha
#. odoo-python
#: code:addons/google_recaptcha/models/ir_http.py:0
msgid "The reCaptcha private key is invalid."
msgstr "reCaptcha-ს პირადი გასაღები არასწორია."

#. module: google_recaptcha
#. odoo-python
#: code:addons/google_recaptcha/models/ir_http.py:0
msgid "The reCaptcha token is invalid."
msgstr "reCaptcha-ს ტოკენი არასწორია."

#. module: google_recaptcha
#. odoo-javascript
#: code:addons/google_recaptcha/static/src/js/recaptcha.js:0
msgid "The recaptcha site key is invalid."
msgstr "recaptcha-ს საიტის გასაღები არასწორია."

#. module: google_recaptcha
#. odoo-python
#: code:addons/google_recaptcha/models/ir_http.py:0
msgid "The request is invalid or malformed."
msgstr "მოთხოვნა არასწორია ან დაზიანებულია."

#. module: google_recaptcha
#. odoo-python
#: code:addons/google_recaptcha/models/ir_http.py:0
msgid "Your request has timed out, please retry."
msgstr "თქვენი მოთხოვნის დრო ამოიწურა, გთხოვთ, სცადოთ ხელახლა."

#. module: google_recaptcha
#. odoo-javascript
#: code:addons/google_recaptcha/static/src/xml/recaptcha.xml:0
msgid "apply."
msgstr "ვრცელდება."

#. module: google_recaptcha
#. odoo-javascript
#: code:addons/google_recaptcha/static/src/js/recaptcha.js:0
msgid "reCAPTCHA disabled or no site key has been configured. Please check your settings."
msgstr "reCAPTCHA გათიშულია ან საიტის გასაღები არ არის კონფიგურირებული. გთხოვთ, შეამოწმოთ თქვენი პარამეტრები."
