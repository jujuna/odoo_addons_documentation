msgid ""
"<strong>\n"
"                                    <em>{{ company_name }}</em>\n"
"                                </strong>operates\n"
"                                grievance mechanisms enabling confidential reporting of workplace\n"
"                                concerns, including discrimination, harassment, or labor rights\n"
