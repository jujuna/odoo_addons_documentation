msgstr "წყლის მოხმარება (E3-4) <span class=\"d-print-none\">[არაარსებითი]</span>"

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_vsm_b2 model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_vsm_c2
msgid "Water and Marine Resources"
msgstr "წყლის და საზღვაო რესურსები"

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_environmental_a
msgid ""
"Water and marine data cover all operational sites within the organizational boundary,\n"
"                including production facilities, offices, and logistics hubs."
msgstr "წყლის და საზღვაო მონაცემები მოიცავს ორგანიზაციული საზღვრის ფარგლებში არსებულ ყველა საოპერაციო ობიექტს, მათ შორის საწარმოო ინფრასტრუქტურას, ოფისებსა და ლოგისტიკურ ცენტრებს."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e3
msgid ""
"Water and marine resource management are integrated within <strong>{{ company_name }}</strong>'s overall environmental and social strategy.\n"
"                        Interconnections with climate resilience, pollution control, and\n"
"                        biodiversity are assessed jointly to avoid duplication and ensure data\n"
"                        consistency."
msgstr "წყლის და საზღვაო რესურსების მართვა ინტეგრირებულია <strong>{{ company_name }}</strong>-ის საერთო გარემოსდაცვით და სოციალურ სტრატეგიაში. კლიმატურ მედეგობასთან, დაბინძურების კონტროლთან და ბიომრავალფეროვნებასთან ურთიერთკავშირები ერთობლივად ფასდება, რათა თავიდან იქნეს აცილებული დუბლირება და უზრუნველყოფილი იყოს მონაცემების თანმიმდევრულობა."

#. module: esg
#: model_terms:ir.actions.act_window,help:esg.action_view_metrics
msgid "Water and marine resources"
msgstr "წყლის და საზღვაო რესურსები"

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e3
msgid "Water consumed in high-stress areas"
msgstr "მაღალი სტრესის მქონე არეალებში მოხმარებული წყალი"

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e3
msgid "Water recycled and reused"
msgstr "რეციკლირებული და ხელახლა გამოყენებული წყალი"

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_basic_for_prepation
msgid ""
"We continuously refine these methodologies and aim to enhance the accuracy of\n"
"                        estimated data in future reporting periods."
msgstr "ჩვენ მუდმივად ვხვეწთ ამ მეთოდოლოგიებს და მიზნად ვისახავთ მომავალ საანგარიშგებო პერიოდებში სავარაუდო მონაცემების სიზუსტის გაზრდას."

#. module: esg
#: model_terms:survey.survey,description:esg.esg_metric_review_template
msgid ""
"Welcome to this CSRD Double Materiality Stakeholder Review, <br><br>\n"
"                    You've been asked to participate to a CSRD Metric Review. <br><br>\n"
"                    We are looking for your input on how the company impacts the environment and how these impacts could affect the company financially."
msgstr "კეთილი იყოს თქვენი მობრძანება CSRD ორმაგი არსებითობის დაინტერესებული მხარის შეფასებაზე, <br><br> თქვენ გთხოვეს, მონაწილეობა მიიღოთ CSRD მეტრიკის შეფასებაში. <br><br> გვსურს, მივიღოთ თქვენი შენატანი იმის შესახებ, თუ როგორ ახდენს კომპანია გავლენას გარემოზე და როგორ შეიძლება ამ გავლენებმა კომპანიაზე ფინანსურად იმოქმედოს."

#. module: esg
#: model_terms:ir.ui.view,arch_db:esg.res_config_settings_view_form
msgid "When enabled, ESRS metrics, double materiality assessment, stakeholder review, and the sustainability report are added."
msgstr "როდესაც ჩართულია, ემატება ESRS მეტრიკები, ორმაგი არსებითობის შეფასება, დაინტერესებული მხარის შეფასება და მდგრადობის ანგარიში."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_basic_for_prepation
msgid ""
"When indirect data sources or estimates have been used (e.g., industry\n"
"                        averages or supplier data models), the basis for such estimations is clearly\n"
"                        indicated in the respective topic sections."
msgstr "როდესაც გამოყენებულია არაპირდაპირი მონაცემთა წყაროები ან შეფასებები (მაგ., ინდუსტრიის საშუალო მაჩვენებლები ან მომწოდებლების მონაცემთა მოდელები), ასეთი შეფასებების საფუძველი მკაფიოდ არის მითითებული თემების შესაბამის სექციებში."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_basic_for_prepation
msgid ""
"When specific sustainability topics deviate from these default time horizons\n"
"                        (e.g., climate-related targets extending beyond 10 years), the rationale is\n"
"                        provided in the respective disclosure section."
msgstr "როდესაც მდგრადობის კონკრეტული თემები განსხვავდება ამ ნაგულისხმევი დროის ჰორიზონტებისგან (მაგ., კლიმატთან დაკავშირებული მიზნები, რომლებიც 10 წელზე მეტ პერიოდს მოიცავს), დასაბუთება მოცემულია გამჟღავნების შესაბამის სექციაში."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_metrics_targets
msgid ""
"Where applicable, both absolute and intensity-based data are disclosed to\n"
"                        ensure\n"
"                        comparability and transparency."
msgstr "შესაბამის შემთხვევებში შედარებადობისა და გამჭვირვალობის უზრუნველსაყოფად მჟღავნდება როგორც აბსოლუტური, ისე ინტენსივობაზე დაფუძნებული მონაცემები."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_environmental_a
msgid ""
"Where automated measurement is not available, data are estimated using emission\n"
"                factors or mass balance methods consistent with the EU Industrial Emissions\n"
"                Directive (IED) or ISO 14064 guidelines."
msgstr "სადაც ავტომატური გაზომვა არ არის ხელმისაწვდომი, მონაცემები ფასდება ემისიის კოეფიციენტების ან მასის ბალანსის მეთოდების გამოყენებით, ევროკავშირის სამრეწველო ემისიების დირექტივის (IED) ან ISO 14064-ის სახელმძღვანელო წესების შესაბამისად."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_governance_c
msgid ""
"Where complete data are unavailable, estimates are based on the scope of governance\n"
"                oversight, sample audits, or extrapolation from comparable business units."
msgstr "როდესაც სრული მონაცემები მიუწვდომელია, შეფასებები ეფუძნება მმართველობითი ზედამხედველობის მოცვას, შერჩევით აუდიტებს ან შესადარებელი ბიზნესერთეულების მონაცემების ექსტრაპოლაციას."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_social_b
msgid ""
"Where data gaps exist, disclose estimation techniques and\n"
"                                    sources."
msgstr "მონაცემებში ხარვეზების არსებობის შემთხვევაში გაამჟღავნეთ შეფასების ხერხები და წყაროები."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_social_b
msgid "Where data gaps exist, disclose estimation techniques and data sources."
msgstr "მონაცემებში ხარვეზების არსებობისას გაამჟღავნეთ შეფასების მეთოდები და მონაცემთა წყაროები."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_social_b
msgid ""
"Where direct data are unavailable, estimates are derived from sample surveys,\n"
"                        historical trends, or modeled ratios based on comparable products, services,\n"
"                        or regions."
msgstr "როდესაც პირდაპირი მონაცემები მიუწვდომელია, შეფასებები მიიღება შერჩევითი გამოკითხვების, ისტორიული ტენდენციების ან შესადარის პროდუქტებზე, მომსახურებებზე ან რეგიონებზე დაფუძნებული მოდელირებული თანაფარდობების საფუძველზე."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_basic_for_prepation
msgid ""
"Where quantitative metrics are based on estimates, approximations, or partial\n"
"                        data coverage, the methodology and assumptions are explained in the\n"
"                        corresponding disclosure notes."
msgstr "როდესაც რაოდენობრივი მეტრიკები ეფუძნება შეფასებებს, მიახლოებით გამოთვლებს ან მონაცემთა ნაწილობრივ მოცვას, მეთოდოლოგია და დაშვებები ახსნილია გამჟღავნების შესაბამის შენიშვნებში."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_social_b
msgid ""
"Where relevant, consumer-related indicators (e.g., complaints, product\n"
"                        recalls, satisfaction scores, privacy compliance) undergo external assurance\n"
"                        in line with recognized frameworks such as ISO 9001, ISO 26000, AA1000\n"
"                        Assurance Standard, or regulatory audits."
msgstr "შესაბამის შემთხვევებში მომხმარებლებთან დაკავშირებული ინდიკატორები (მაგ., საჩივრები, პროდუქტის ბაზრიდან გამოწვევა, კმაყოფილების ქულები, კონფიდენციალურობის მოთხოვნებთან შესაბამისობა) ექვემდებარება გარე რწმუნებას აღიარებული ჩარჩოების შესაბამისად, როგორიცაა ISO 9001, ISO 26000, AA1000 რწმუნების სტანდარტი ან რეგულატორული აუდიტები."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_governance_c
msgid ""
"Where relevant, governance indicators (e.g., confirmed corruption incidents, policy\n"
"                coverage, ethical training completion) undergo external assurance using recognized\n"
"                frameworks such as ISO 37001, AA1000 Assurance Standard, or national audit\n"
"                standards."
msgstr "სადაც ეს შესაბამისია, მმართველობის ინდიკატორები (მაგ., კორუფციის დადასტურებული შემთხვევები, პოლიტიკით მოცვა, ეთიკის ტრენინგის დასრულება) ექვემდებარება გარე რწმუნებას აღიარებული ჩარჩოების გამოყენებით, როგორიცაა ISO 37001, AA1000 რწმუნების სტანდარტი ან აუდიტის ეროვნული სტანდარტები."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_iro_management
msgid ""
"Where relevant, references are included to external standards or\n"
"                        initiatives the company aligns with."
msgstr "შესაბამის შემთხვევებში მოცემულია მითითებები იმ გარე სტანდარტებზე ან ინიციატივებზე, რომლებთანაც კომპანია შესაბამისობაშია."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_social_b
msgid ""
"Where relevant, workforce indicators (e.g., diversity, pay equity, safety)\n"
"                undergo external assurance in line with recognized frameworks such as <strong>ISAE\n"
"                3000</strong>, <strong>GRI 401-404</strong>, or <strong>ILO labor standards</strong>\n"
"                ."
msgstr "საჭიროების შემთხვევაში პერსონალის ინდიკატორები (მაგ., მრავალფეროვნება, ანაზღაურების თანასწორობა, უსაფრთხოება) ექვემდებარება გარე რწმუნებას ისეთი აღიარებული ჩარჩოების შესაბამისად, როგორიცაა <strong>ISAE 3000</strong>, <strong>GRI 401-404</strong> ან <strong>ILO-ს შრომის სტანდარტები</strong> ."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_basic_for_prepation
msgid ""
"Where reporting systems are still being harmonized, integration of\n"
"                        sustainability data collection, consolidation, and internal control\n"
"                        procedures is targeted for completion by <strong>[<em>insert target year</em>]</strong>."
msgstr "თუ ანგარიშგების სისტემების ჰარმონიზაცია ჯერ კიდევ მიმდინარეობს, მდგრადობის მონაცემების შეგროვების, კონსოლიდაციისა და შიდა კონტროლის პროცედურების ინტეგრაციის დასრულება დაგეგმილია <strong>[<em>მიუთითეთ სამიზნე წელი</em>]</strong> წლისთვის."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_basic_for_prepation
msgid ""
"Where such topics have been assessed as <strong>material</strong>,\n"
"                                the entity should still provide a <strong>summary of relevant\n"
"                                impacts, policies,\n"
"                                    actions, and metrics</strong>."
msgstr "თუ ასეთი თემები შეფასებულია <strong>არსებითად</strong>, ერთეულმა მაინც უნდა წარმოადგინოს <strong>შესაბამისი გავლენების, პოლიტიკების, ქმედებებისა და მეტრიკების შეჯამება</strong>."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_basic_for_prepation
msgid "Which standards are partially or fully omitted"
msgstr "რომელი სტანდარტებია ნაწილობრივ ან სრულად გამოტოვებული"

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_governance_c
msgid "Whistleblowing and grievance reporting platforms."
msgstr "დარღვევების მხილებისა და საჩივრების წარდგენის პლატფორმები."

#. module: esg
