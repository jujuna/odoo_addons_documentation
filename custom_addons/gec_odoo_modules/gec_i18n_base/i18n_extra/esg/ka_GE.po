#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_vsm_b10
msgid "{{ company_name }} ensures fair and equitable remuneration for all employees, with compensation aligned with legal requirements, local labor standards, and applicable collective bargaining agreements. Remuneration practices include base salary, overtime, benefits, and additional fixed payments where relevant."
msgstr "{{ company_name }} უზრუნველყოფს ყველა თანამშრომლის სამართლიან და თანასწორ ანაზღაურებას, რომელიც შეესაბამება კანონით დადგენილ მოთხოვნებს, ადგილობრივ შრომის სტანდარტებს და მოქმედ კოლექტიურ ხელშეკრულებებს. ანაზღაურების პრაქტიკა მოიცავს საბაზისო ხელფასს, ზეგანაკვეთის ანაზღაურებას, შეღავათებს და, შესაბამის შემთხვევებში, დამატებით ფიქსირებულ გადახდებს."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_vsm_b11
msgid "{{ company_name }} has implemented internal procedures and controls to prevent corruption, bribery, and unethical business conduct. These measures cover employee behavior, supplier management, financial approvals, and monitoring mechanisms to ensure compliance with anti-corruption laws and company policies."
msgstr "{{ company_name }}-მა დანერგა შიდა პროცედურები და კონტროლის მექანიზმები კორუფციის, მექრთამეობისა და არაეთიკური საქმიანი ქცევის თავიდან ასაცილებლად. ეს ღონისძიებები მოიცავს თანამშრომელთა ქცევას, მომწოდებლების მართვას, ფინანსურ დამტკიცებებს და მონიტორინგის მექანიზმებს, რათა უზრუნველყოფილი იყოს კორუფციის წინააღმდეგ ბრძოლის კანონმდებლობისა და კომპანიის პოლიტიკების დაცვა."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_vsm_b11
msgid "{{ company_name }} is committed to maintaining integrity, transparency, and ethical conduct in all business operations. Corruption and bribery are considered major business conduct sustainability issues, and the company reports on any convictions or fines related to anti-corruption and anti-bribery laws."
msgstr "{{ company_name }} იღებს ვალდებულებას, ყველა ბიზნესოპერაციაში დაიცვას კეთილსინდისიერება, გამჭვირვალობა და ეთიკური ქცევა. კორუფცია და მექრთამეობა საქმიანი ქცევის სფეროში მდგრადობის მნიშვნელოვან საკითხებად მიიჩნევა და კომპანია ანგარიშგებაში ასახავს კორუფციისა და მექრთამეობის წინააღმდეგ ბრძოლის კანონმდებლობასთან დაკავშირებულ ნებისმიერ გამამტყუნებელ განაჩენს ან ჯარიმას."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_vsm_b11
msgid "{{ company_name }} monitors payment terms and any legal proceedings related to delayed payments as part of ethical business conduct."
msgstr "{{ company_name }} ეთიკური საქმიანი ქცევის ფარგლებში ახორციელებს გადახდის პირობებისა და დაგვიანებულ გადახდებთან დაკავშირებული ნებისმიერი სამართალწარმოების მონიტორინგს."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_vsm_b11
msgid "{{ company_name }} requires suppliers and partners to adhere to ethical standards, ensuring transparency, fairness, and compliance with anti-corruption rules."
msgstr "{{ company_name }} მომწოდებლებისა და პარტნიორებისგან მოითხოვს ეთიკური სტანდარტების დაცვას, რაც უზრუნველყოფს გამჭვირვალობას, სამართლიანობას და კორუფციის წინააღმდეგ ბრძოლის წესებთან შესაბამისობას."

