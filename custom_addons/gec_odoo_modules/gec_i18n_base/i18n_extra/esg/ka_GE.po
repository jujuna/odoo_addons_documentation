msgid ""
"<strong>\n"
"                            {{ company_name }}\n"
"                        </strong> identifies,\n"
"                        assesses, and monitors its <strong>material impacts, risks, and\n"
"                            opportunities (IROs)</strong> across its operations, value chain, and\n"
"                        broader business context. These IROs are central to strategic\n"
"                        decision-making, risk management, and long-term value creation."
msgstr "<strong> {{ company_name }} </strong> ავლენს, აფასებს და მონიტორინგს უწევს თავის <strong>არსებით გავლენებს, რისკებსა და შესაძლებლობებს (IRO)</strong> საკუთარ ოპერაციებში, ღირებულების ჯაჭვსა და ბიზნესის უფრო ფართო კონტექსტში. ამ IRO-ებს ცენტრალური ადგილი უჭირავს სტრატეგიული გადაწყვეტილებების მიღებაში, რისკების მართვასა და გრძელვადიანი ღირებულების შექმნაში."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_strategy
msgid ""
"<strong>\n"
"                            {{ company_name }}\n"
"                        </strong> regularly\n"
"                        engages with a diverse range of stakeholders to understand their views,\n"
"                        concerns, and expectations. This engagement informs the company's business\n"
"                        model, strategy, and sustainability approach. Stakeholder feedback is\n"
"                        collected through ongoing dialogue, consultations, surveys, and formal\n"
"                        meetings. Insights from these engagements are integrated into the company's\n"
"                        sustainability reporting and decision-making processes, including the Double\n"
"                        Materiality Assessment (DMA) or equivalent materiality analyses."
msgstr "<strong> {{ company_name }} </strong> რეგულარულად უზრუნველყოფს დაინტერესებული მხარეების ფართო წრის ჩართულობას, რათა გაიგოს მათი შეხედულებები, საზრუნავი საკითხები და მოლოდინები. ამ ჩართულობის შედეგები აისახება კომპანიის ბიზნესმოდელში, სტრატეგიასა და მდგრადობისადმი მიდგომაში. დაინტერესებული მხარეების უკუკავშირი გროვდება მუდმივი დიალოგის, კონსულტაციების, გამოკითხვებისა და ოფიციალური შეხვედრების მეშვეობით. ჩართულობის ამ ფორმებიდან მიღებული დასკვნები ინტეგრირდება კომპანიის მდგრადობის ანგარიშგებასა და გადაწყვეტილების მიღების პროცესებში, მათ შორის ორმაგი არსებითობის შეფასებაში (DMA) ან არსებითობის ეკვივალენტურ ანალიზებში."

