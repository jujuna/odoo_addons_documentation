#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_social_b
msgid "Data Collection Methods"
msgstr "მონაცემთა შეგროვების მეთოდები"

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_social_b
msgid "Data Sources"
msgstr "მონაცემთა წყაროები"

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_environmental_a
msgid ""
"Data are collected through Continuous Emissions Monitoring Systems (CEMS) for air\n"
"                pollutants (e.g., NOₓ, SOₓ, PM), complemented by periodic sampling and laboratory\n"
"                analyses for water and soil parameters."
msgstr "ჰაერის დამაბინძურებლების (მაგ., NOₓ, SOₓ, PM) მონაცემები გროვდება ემისიების უწყვეტი მონიტორინგის სისტემებით (CEMS), რასაც წყლისა და ნიადაგის პარამეტრებისთვის ავსებს პერიოდული სინჯის აღება და ლაბორატორიული ანალიზები."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_social_b
msgid ""
"Data are collected through Human Resources Information Systems (HRIS), payroll,\n"
"                attendance, learning management, and occupational safety systems. Additional\n"
"                information comes from employee surveys, grievance platforms, and union or works\n"
"                council reports."
msgstr "მონაცემები გროვდება ადამიანური რესურსების საინფორმაციო სისტემების (HRIS), ხელფასების, დასწრების, სწავლის მართვისა და შრომის უსაფრთხოების სისტემების მეშვეობით. დამატებითი ინფორმაცია მიიღება თანამშრომელთა გამოკითხვებიდან, საჩივრების პლატფორმებიდან და პროფკავშირების ან დასაქმებულთა საბჭოების ანგარიშებიდან."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_social_b
msgid ""
"Data are collected through field surveys, participatory consultations,\n"
"                        project monitoring systems, and third-party reports. Where direct data are\n"
"                        unavailable, estimates or external databases are used."
msgstr "მონაცემები გროვდება საველე გამოკითხვების, მონაწილეობითი კონსულტაციების, პროექტების მონიტორინგის სისტემებისა და მესამე მხარის ანგარიშების მეშვეობით. როდესაც პირდაპირი მონაცემები მიუწვდომელია, გამოიყენება შეფასებები ან გარე მონაცემთა ბაზები."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_environmental_a
msgid ""
"Data are collected through material flow analysis (MFA), life-cycle\n"
"                    assessment (LCA), and internal production monitoring systems. Information covers\n"
"                    inputs (raw, renewable, and secondary materials) and outputs (products,\n"
"                    packaging, and waste). When primary data are unavailable, supplier declarations\n"
"                    and modeled estimates are used following EU Environmental Footprint or ISO 14044\n"
"                    standards."
msgstr "მონაცემები გროვდება მასალების ნაკადის ანალიზით (MFA), სასიცოცხლო ციკლის შეფასებით (LCA) და წარმოების მონიტორინგის შიდა სისტემებით. ინფორმაცია მოიცავს შემავალ ნაკადებს (ნედლეული, განახლებადი და მეორეული მასალები) და გამომავალ ნაკადებს (პროდუქტები, შეფუთვა და ნარჩენები). როდესაც პირველადი მონაცემები მიუწვდომელია, გამოიყენება მომწოდებლების დეკლარაციები და მოდელირებული შეფასებები ევროკავშირის გარემოსდაცვითი კვალის მეთოდოლოგიის ან ISO 14044 სტანდარტების შესაბამისად."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_governance_c model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_social_b
msgid "Data are collected through:"
msgstr "მონაცემები გროვდება შემდეგი საშუალებებით:"

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e3
msgid ""
"Data are compiled from\n"
"                                    site-level monitoring, covering both direct measurements and\n"
"                                    modeled estimates. Reporting follows the<em>\n"
"                                        <strong> GHG Protocol Water Guidance and the WRI Aqueduct\n"
"                                    risk tool</strong>\n"
"                                    </em>."
msgstr "მონაცემები გროვდება ობიექტების დონეზე განხორციელებული მონიტორინგის საფუძველზე და მოიცავს როგორც პირდაპირ გაზომვებს, ისე მოდელირებულ შეფასებებს. ანგარიშგება ეფუძნება<em> <strong> GHG Protocol-ის წყლის სახელმძღვანელოსა და WRI Aqueduct-ის რისკების შეფასების ინსტრუმენტს</strong> </em>."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_governance_c
msgid ""
"Data are consolidated and reviewed internally by compliance, internal audit, and\n"
"                sustainability teams."
msgstr "მონაცემების კონსოლიდაციასა და შიდა განხილვას ახორციელებენ შესაბამისობის, შიდა აუდიტისა და მდგრადობის გუნდები."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_social_b
msgid ""
"Data are consolidated and reviewed internally by consumer experience, product\n"
"                        safety, compliance, or sustainability teams."
msgstr "მონაცემებს შიდა დონეზე აკონსოლიდირებენ და განიხილავენ მომხმარებლის გამოცდილების, პროდუქტის უსაფრთხოების, შესაბამისობის ან მდგრადობის გუნდები."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_social_b
msgid "Data are consolidated and reviewed internally by the HR and sustainability teams."
msgstr "მონაცემების კონსოლიდაციასა და შიდა მიმოხილვას ახორციელებენ ადამიანური რესურსებისა და მდგრადობის გუნდები."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_environmental_a
msgid ""
"Data are gathered from site-level environmental surveys, GIS and\n"
"                    remote-sensing tools, and ecological monitoring programs. Key indicators include\n"
"                    land use, habitat condition, and species presence, measured against recognized\n"
"                    frameworks such as IUCN Habitat Classification or TNFD guidelines. When direct\n"
"                    data are unavailable, modeled estimates or external databases (e.g., GBIF, IPBES\n"
"                    regional data) are used."
msgstr "მონაცემები გროვდება ობიექტის დონეზე ჩატარებული გარემოსდაცვითი კვლევებიდან, GIS-ისა და დისტანციური ზონდირების ინსტრუმენტებიდან და ეკოლოგიური მონიტორინგის პროგრამებიდან. ძირითადი ინდიკატორები მოიცავს მიწათსარგებლობას, ჰაბიტატის მდგომარეობას და სახეობების არსებობას, რომლებიც ფასდება აღიარებული ჩარჩოების მიხედვით, როგორიცაა IUCN-ის ჰაბიტატების კლასიფიკაცია ან TNFD-ის სახელმძღვანელო წესები. როდესაც პირდაპირი მონაცემები მიუწვდომელია, გამოიყენება მოდელირებული შეფასებები ან გარე მონაცემთა ბაზები (მაგ., GBIF, IPBES-ის რეგიონული მონაცემები)."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_environmental_a
msgid ""
"Data are obtained through direct flow measurements, smart meters, or\n"
"                supplier-provided utility records. In areas where direct monitoring is not\n"
"                available, estimates are based on production volumes, water intensity factors, or\n"
"                modeled consumption data."
msgstr "მონაცემები მიიღება ნაკადის პირდაპირი გაზომვებით, ჭკვიანი მრიცხველებით ან მომწოდებლის მიერ წარმოდგენილი კომუნალური მომსახურების ჩანაწერებით. იმ ადგილებში, სადაც პირდაპირი მონიტორინგი არ არის ხელმისაწვდომი, შეფასებები ეფუძნება წარმოების მოცულობებს, წყლის ინტენსივობის კოეფიციენტებს ან მოდელირებული მოხმარების მონაცემებს."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_environmental_a
msgid ""
"Data are reviewed by the environmental management team and verified by accredited\n"
"                third parties under ISO 14001 or equivalent standards."
msgstr "მონაცემებს განიხილავს გარემოსდაცვითი მართვის გუნდი და ადასტურებს აკრედიტებული მესამე მხარე ISO 14001-ის ან ტოლფასი სტანდარტების შესაბამისად."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_environmental_a
msgid ""
"Data are reviewed internally by sustainability and environmental experts.\n"
"                    Where relevant, external assurance is performed under recognized standards\n"
"                    (e.g., ISO 14001 Environmental Management Systems, IUCN methodologies)."
msgstr "მონაცემების შიდა განხილვას ახორციელებენ მდგრადობისა და გარემოსდაცვითი საკითხების ექსპერტები. შესაბამის შემთხვევებში გარე რწმუნება ტარდება აღიარებული სტანდარტების შესაბამისად (მაგ., ISO 14001 გარემოსდაცვითი მართვის სისტემები, IUCN-ის მეთოდოლოგიები)."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_social_b
msgid ""
"Data are reviewed internally by sustainability, social-impact, or CSR\n"
"                        specialists. Third-party assurance is performed for high-risk projects or\n"
"                        regions, following recognized standards (e.g., AA1000 Assurance Standard,\n"
"                        ISO 26000 guidelines)."
msgstr "მონაცემებს შიდა დონეზე განიხილავენ მდგრადობის, სოციალური გავლენის ან CSR-ის სპეციალისტები. მაღალი რისკის პროექტების ან რეგიონებისთვის ხორციელდება მესამე მხარის რწმუნება აღიარებული სტანდარტების შესაბამისად (მაგ., AA1000 რწმუნების სტანდარტი, ISO 26000-ის სახელმძღვანელო წესები)."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_environmental_a
msgid ""
"Data are verified internally by the environmental management team and, where\n"
"                applicable, externally assured under ISO 14046 (Water Footprint) or ISO 14001."
msgstr "მონაცემებს შიდა დონეზე ადასტურებს გარემოსდაცვითი მართვის გუნდი, ხოლო საჭიროების შემთხვევაში მათზე ტარდება გარე რწმუნება ISO 14046-ის (წყლის კვალი) ან ISO 14001-ის შესაბამისად."

