msgstr "<strong>{{ company_name }}</strong> მიზნად ისახავს ეკონომიკური ზრდისა და მასალების მოხმარების ურთიერთკავშირის გაწყვეტას, ნარჩენების წარმოქმნის შემცირებას და რესურსების ეფექტიანობის გაზრდას ევროკავშირის ცირკულარული ეკონომიკის სამოქმედო გეგმის შესაბამისად."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s3
msgid ""
"<strong>{{ company_name }}</strong> applies a Community Engagement\n"
"                                        Policy and Human-Rights Policy covering social inclusion,\n"
"                                        consultation, and impact mitigation. Policies are aligned\n"
"                                        with the UN Guiding Principles on Business and Human Rights\n"
"                                        and OECD standards."
msgstr "<strong>{{ company_name }}</strong> იყენებს საზოგადოების ჩართულობის პოლიტიკასა და ადამიანის უფლებების პოლიტიკას, რომლებიც მოიცავს სოციალურ ინკლუზიას, კონსულტაციებსა და გავლენის შერბილებას. პოლიტიკები შესაბამისობაშია ბიზნესისა და ადამიანის უფლებების შესახებ გაეროს სახელმძღვანელო პრინციპებთან და OECD-ის სტანდარტებთან."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s2
msgid ""
"<strong>{{ company_name }}</strong> applies a Responsible Sourcing\n"
"                                    Policy and Supplier Code of Conduct covering labor rights,\n"
"                                    working conditions, and ethical practices."
msgstr "<strong>{{ company_name }}</strong> იყენებს პასუხისმგებლიანი მომარაგების პოლიტიკასა და მომწოდებლების ქცევის კოდექსს, რომლებიც მოიცავს შრომით უფლებებს, სამუშაო პირობებსა და ეთიკურ პრაქტიკას."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s4
msgid ""
"<strong>{{ company_name }}</strong> applies policies on product\n"
"                                        safety, ethical marketing, consumer privacy, and complaint\n"
"                                        handling. Policies align with international standards such\n"
"                                        as <em>\n"
"                                            <strong>ISO 9001, ISO 26000, and consumer protection\n"
"                                        regulations.</strong>\n"
"                                        </em>"
msgstr "<strong>{{ company_name }}</strong> იყენებს პოლიტიკებს პროდუქტის უსაფრთხოების, ეთიკური მარკეტინგის, მომხმარებელთა კონფიდენციალურობისა და საჩივრების განხილვის სფეროებში. პოლიტიკები შეესაბამება ისეთ საერთაშორისო სტანდარტებს, როგორიცაა <em> <strong>ISO 9001, ISO 26000 და მომხმარებელთა უფლებების დაცვის რეგულაციები.</strong> </em>"

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e4
msgid ""
"<strong>{{ company_name }}</strong> assesses financial\n"
"                                            exposure to\n"
"                                            water-related risks (scarcity, regulation, pollution\n"
"                                            events) and\n"
"                                            potential opportunities (cost savings, sustainable\n"
"                                            branding). These\n"
"                                            assessments are integrated into the enterprise risk\n"
"                                            management framework\n"
"                                            and scenario analyses."
msgstr "<strong>{{ company_name }}</strong> აფასებს წყალთან დაკავშირებული რისკებისადმი (დეფიციტი, რეგულირება, დაბინძურების შემთხვევები) ფინანსურ მოწყვლადობას და პოტენციურ შესაძლებლობებს (ხარჯების დაზოგვა, მდგრადობაზე ორიენტირებული ბრენდინგი). ეს შეფასებები ინტეგრირებულია საწარმოს რისკების მართვის ჩარჩოსა და სცენარების ანალიზში."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e3
msgid ""
"<strong>{{ company_name }}</strong> assesses financial\n"
"                                        exposure to\n"
"                                        water-related risks (scarcity, regulation, pollution events)\n"
"                                        and potential\n"
"                                        opportunities (cost savings, sustainable branding). These\n"
"                                        assessments are\n"
"                                        integrated into the enterprise risk management framework and\n"
"                                        scenario\n"
"                                        analyses."
msgstr "<strong>{{ company_name }}</strong> აფასებს წყალთან დაკავშირებული რისკებისადმი (დეფიციტი, რეგულირება, დაბინძურების შემთხვევები) ფინანსურ მოწყვლადობას და პოტენციურ შესაძლებლობებს (ხარჯების დაზოგვა, მდგრადობაზე ორიენტირებული ბრენდინგი). ეს შეფასებები ინტეგრირებულია საწარმოს რისკების მართვის ჩარჩოსა და სცენარების ანალიზში."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e2
msgid ""
"<strong>{{ company_name }}</strong> assesses financial exposure to\n"
"                                pollution-related risks, including regulatory changes, accidental\n"
"                                releases, and contamination of air, water, and soil."
msgstr "<strong>{{ company_name }}</strong> აფასებს თავის ფინანსურ ექსპოზიციას დაბინძურებასთან დაკავშირებული რისკების მიმართ, რომელთა შორისაა მარეგულირებელი ცვლილებები, ავარიული გაფრქვევები და ჰაერის, წყლისა და ნიადაგის დაბინძურება."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e1
msgid ""
"<strong>{{ company_name }}</strong> assesses financial exposure to both\n"
"                                physical climate risks (e.g., extreme weather, heat, flooding) and\n"
"                                transition risks (e.g., carbon pricing, regulatory change,\n"
"                                technology shifts)."
msgstr "<strong>{{ company_name }}</strong> აფასებს თავის ფინანსურ მოწყვლადობას როგორც კლიმატის ფიზიკური რისკების (მაგ., ექსტრემალური ამინდი, სიცხე, წყალდიდობა), ისე გადასვლის რისკების (მაგ., ნახშირბადის ფასწარმოქმნა, მარეგულირებელი ცვლილებები, ტექნოლოგიური ძვრები) მიმართ."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_appendix_environmental_a
msgid ""
"<strong>{{ company_name }}</strong> calculates its GHG emissions following the <strong>GHG Protocol</strong>\n"
"                and <strong>Le Bilan Carbone®</strong> methodology. The emissions are categorized\n"
"                into:"
msgstr "<strong>{{ company_name }}</strong> სათბურის გაზების ემისიებს ითვლის <strong>GHG Protocol</strong> სტანდარტისა და <strong>Le Bilan Carbone®</strong> მეთოდოლოგიის შესაბამისად. ემისიები შემდეგ კატეგორიებად იყოფა:"

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s3
msgid ""
"<strong>{{ company_name }}</strong> engages communities via consultations, town halls,\n"
"                                                surveys, and collaborative projects. Engagement\n"
"                                                identifies risks such as displacement, environmental\n"
"                                                harm, or lack of economic opportunities. Outcomes\n"
"                                                inform mitigation and investment plans."
msgstr "<strong>{{ company_name }}</strong> საზოგადოებების ჩართულობას უზრუნველყოფს კონსულტაციების, საჯარო შეხვედრების, გამოკითხვებისა და ერთობლივი პროექტების მეშვეობით. ჩართულობა ავლენს ისეთ რისკებს, როგორიცაა განსახლება, გარემოსთვის მიყენებული ზიანი ან ეკონომიკური შესაძლებლობების ნაკლებობა. შედეგები გამოიყენება შერბილებისა და საინვესტიციო გეგმების შემუშავებისას."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s2
msgid ""
"<strong>{{ company_name }}</strong> engages suppliers and their workers through audits,\n"
"                                            surveys, and dialogue<strong>\n"
"                                                <em> platforms</em>\n"
"                                            </strong><em>\n"
"                                            .</em>Engagement aims to identify and address issues\n"
"                                            such as excessive overtime, discrimination, or lack of\n"
"                                            worker representation. Findings feed into\n"
"                                            supplier-improvement plans."
msgstr "<strong>{{ company_name }}</strong> მომწოდებლებისა და მათი მუშაკების ჩართულობას უზრუნველყოფს აუდიტებით, გამოკითხვებითა და დიალოგის<strong> <em> პლატფორმებით</em> </strong><em> .</em>ჩართულობა მიზნად ისახავს ისეთი საკითხების გამოვლენასა და მოგვარებას, როგორიცაა გადაჭარბებული ზეგანაკვეთი, დისკრიმინაცია ან მუშაკების წარმომადგენლობის არარსებობა. მიგნებები აისახება მომწოდებლების გაუმჯობესების გეგმებში."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s1
msgid ""
"<strong>{{ company_name }}</strong> engages workers via surveys, focus\n"
"                                groups, and consultation committees to capture views on workplace\n"
"                                conditions and workforce impacts."
msgstr "<strong>{{ company_name }}</strong> მუშაკების ჩართულობას უზრუნველყოფს გამოკითხვების, ფოკუს-ჯგუფებისა და საკონსულტაციო კომიტეტების მეშვეობით, რათა შეაგროვოს მოსაზრებები სამუშაო ადგილის პირობებისა და პერსონალზე გავლენების შესახებ."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s1
msgid ""
"<strong>{{ company_name }}</strong> ensures that all workers receive\n"
"                                wages meeting or exceeding legal minimums and living wage benchmarks\n"
"                                where available. Regular reviews assess wage competitiveness and\n"
"                                internal equity."
msgstr "<strong>{{ company_name }}</strong> უზრუნველყოფს, რომ ყველა მუშაკი იღებდეს ხელფასს, რომელიც უდრის ან აღემატება კანონით დადგენილ მინიმუმებს და, სადაც ხელმისაწვდომია, საარსებო ხელფასის ორიენტირებს. ხელფასების კონკურენტუნარიანობა და შიდა სამართლიანობა ფასდება რეგულარული გადახედვის ფარგლებში."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s1
msgid ""
"<strong>{{ company_name }}</strong> ensures that employees have the\n"
"                                right to freedom of association and collective bargaining. Social\n"
"                                dialogue occurs through regular meetings between management and\n"
"                                employee representatives at site and group levels. Collective\n"
"                                agreements define working conditions, pay, and benefits where\n"
"                                applicable."
msgstr "<strong>{{ company_name }}</strong> უზრუნველყოფს, რომ თანამშრომლებს ჰქონდეთ გაერთიანების თავისუფლებისა და კოლექტიური მოლაპარაკებების უფლება. სოციალური დიალოგი მიმდინარეობს მენეჯმენტსა და თანამშრომელთა წარმომადგენლებს შორის რეგულარული შეხვედრების გზით, ობიექტისა და ჯგუფის დონეებზე. კოლექტიური ხელშეკრულებები, შესაბამის შემთხვევებში, განსაზღვრავს სამუშაო პირობებს, ანაზღაურებასა და ბენეფიტებს."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e5
msgid ""
"<strong>{{ company_name }}</strong> evaluates\n"
"                                            financial impacts from\n"
"                                            resource-use and circular-economy risks, integrating\n"
"                                            them into\n"
"                                            enterprise risk management. Opportunities include\n"
"                                            cost savings,\n"
"                                            access to green financing, and market growth for\n"
"                                            circular products."
msgstr "<strong>{{ company_name }}</strong> აფასებს რესურსების გამოყენებასა და ცირკულარულ ეკონომიკასთან დაკავშირებული რისკების ფინანსურ გავლენებს და აინტეგრირებს მათ საწარმოს რისკების მართვაში. შესაძლებლობები მოიცავს ხარჯების დანაზოგს, მწვანე დაფინანსებაზე წვდომასა და ცირკულარული პროდუქტების ბაზრის ზრდას."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s1
msgid ""
"<strong>{{ company_name }}</strong> fosters inclusion for persons with disabilities through\n"
"                                accessible recruitment, workplace adaptation, and dedicated\n"
"                                training. Progress is monitored via self-identification and HR\n"
"                                systems."
msgstr "<strong>{{ company_name }}</strong> ხელს უწყობს შეზღუდული შესაძლებლობის მქონე პირების ინკლუზიას ხელმისაწვდომი კადრების შერჩევის, სამუშაო ადგილის ადაპტაციისა და მიზნობრივი ტრენინგების მეშვეობით. პროგრესის მონიტორინგი ხორციელდება თვითიდენტიფიკაციისა და ადამიანური რესურსების მართვის სისტემების საშუალებით."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e4
msgid ""
"<strong>{{ company_name }}</strong> has developed a transition plan\n"
"                                    to ensure its business model and strategy are compatible with\n"
"                                    global ecological thresholds, <strong>\n"
"                                        <em>including the Post-2020 Global Biodiversity Framework\n"
"                                            and the EU\n"
"                                            Biodiversity Strategy for 2030</em>\n"
"                                    </strong>.\n"
"                                    The plan addresses material impacts and dependencies on\n"
"                                    biodiversity and ecosystems across own operations and the value\n"
"                                    chain, using the mitigation hierarchy: avoid, reduce, restore,\n"
"                                    and offset. Short-term (2025), medium-term (2030), and long-term\n"
"                                    (2040-2050) milestones are defined, with governance approval and\n"
"                                    monitoring systems in place."
msgstr "<strong>{{ company_name }}</strong>-მა შეიმუშავა გადასვლის გეგმა, რათა უზრუნველყოს, რომ მისი ბიზნესმოდელი და სტრატეგია თავსებადი იყოს გლობალურ ეკოლოგიურ ზღვრებთან, <strong> <em>მათ შორის 2020 წლის შემდგომ ბიომრავალფეროვნების გლობალურ ჩარჩოსთან და ევროკავშირის ბიომრავალფეროვნების 2030 წლის სტრატეგიასთან</em> </strong>. გეგმა მოიცავს ბიომრავალფეროვნებასა და ეკოსისტემებზე არსებით გავლენებსა და მათზე დამოკიდებულებებს როგორც საკუთარ ოპერაციებში, ისე ღირებულების ჯაჭვში და ეყრდნობა შერბილების იერარქიას: თავიდან აცილება, შემცირება, აღდგენა და კომპენსაცია. განსაზღვრულია მოკლევადიანი (2025), საშუალოვადიანი (2030) და გრძელვადიანი (2040-2050) საკვანძო ეტაპები, ამასთან, გეგმა დამტკიცებულია მმართველობის დონეზე და დანერგილია მონიტორინგის სისტემები."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e1
msgid ""
"<strong>{{ company_name }}</strong> has established a transition plan\n"
"                                to align its activities with a 1.5°C pathway, achieving net-zero GHG\n"
"                                emissions by <strong>\n"
"                                    <em>[insert year]</em>\n"
"                                </strong>.\n"
"                                The plan includes short-term (2025), medium-term (2030), and\n"
"                                long-term (2040-2050) milestones."
msgstr "<strong>{{ company_name }}</strong>-მა შეიმუშავა გადასვლის გეგმა, რათა თავისი აქტივობები შესაბამისობაში მოიყვანოს 1.5°C-ის ტრაექტორიასთან და სათბურის გაზების წმინდა ნულოვან ემისიებს მიაღწიოს <strong> <em>[მიუთითეთ წელი]</em> </strong> წლისთვის. გეგმა მოიცავს მოკლევადიან (2025), საშუალოვადიან (2030) და გრძელვადიან (2040-2050) საკვანძო ეტაპებს."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e2
msgid ""
"<strong>{{ company_name }}</strong> identifies substances of concern\n"
"                                (including SVHCs) in operations, products, and supply chains.\n"
"                                Management measures include substitution, safe handling, and\n"
"                                tracking of quantities used."
msgstr "<strong>{{ company_name }}</strong> ავლენს საყურადღებო ნივთიერებებს (მათ შორის SVHC-ებს) ოპერაციებში, პროდუქტებსა და მიწოდების ჯაჭვებში. მართვის ღონისძიებები მოიცავს ჩანაცვლებას, უსაფრთხო მოპყრობას და გამოყენებული რაოდენობების მიდევნებას."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s2
msgid ""
"<strong>{{ company_name }}</strong> implements\n"
"                                    supplier-training programs, capacity-building partnerships, and\n"
"                                    collaborative industry initiatives to reduce negative impacts on\n"
"                                    value-chain workers. Effectiveness is evaluated by improvements\n"
"                                    in audit results, reduced complaints, and supplier retention\n"
"                                    rates."
msgstr "<strong>{{ company_name }}</strong> ახორციელებს მომწოდებლების ტრენინგის პროგრამებს, პოტენციალის განვითარების პარტნიორობებსა და ინდუსტრიის ერთობლივ ინიციატივებს ღირებულების ჯაჭვის მუშაკებზე უარყოფითი გავლენების შესამცირებლად. ეფექტურობა ფასდება აუდიტის შედეგების გაუმჯობესების, საჩივრების შემცირებისა და მომწოდებლების შენარჩუნების მაჩვენებლების მიხედვით."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s3
msgid ""
"<strong>{{ company_name }}</strong> implements community-investment\n"
"                                            programs, livelihood initiatives, and collaborative\n"
"                                            mitigation projects. Effectiveness is evaluated by\n"
"                                            reductions in complaints, improved community\n"
"                                            satisfaction, and measurable social outcomes."
msgstr "<strong>{{ company_name }}</strong> ახორციელებს საზოგადოებაში ინვესტირების პროგრამებს, საარსებო საშუალებების ხელშეწყობის ინიციატივებსა და შერბილების ერთობლივ პროექტებს. ეფექტურობა ფასდება საჩივრების შემცირების, საზოგადოების კმაყოფილების ზრდისა და გაზომვადი სოციალური შედეგების მიხედვით."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e1
msgid ""
"<strong>{{ company_name }}</strong> implements group-wide climate and\n"
"                                energy policies to steer operations toward decarbonization and\n"
"                                resilience. Policies are endorsed by the Board and integrated into\n"
"                                corporate governance."
msgstr "<strong>{{ company_name }}</strong> ახორციელებს ჯგუფის მასშტაბით მოქმედ კლიმატისა და ენერგეტიკის პოლიტიკებს, რათა ოპერაციები დეკარბონიზაციისა და მედეგობისკენ წარმართოს. პოლიტიკები მოწონებულია საბჭოს მიერ და ინტეგრირებულია კორპორაციულ მმართველობაში."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e2
msgid ""
"<strong>{{ company_name }}</strong> implements group-wide pollution\n"
"                                policies endorsed by the Board, integrated into operational\n"
"                                management and governance. Policies cover prevention, monitoring,\n"
"                                and reporting of environmental impacts."
msgstr "<strong>{{ company_name }}</strong> ნერგავს საბჭოს მიერ მოწონებულ, ჯგუფის მასშტაბით მოქმედ დაბინძურების პოლიტიკებს, რომლებიც ინტეგრირებულია საოპერაციო მართვასა და მმართველობაში. პოლიტიკები მოიცავს გარემოზე გავლენების პრევენციას, მონიტორინგსა და ანგარიშგებას."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e1
msgid ""
"<strong>{{ company_name }}</strong> integrates carbon-cost\n"
"                                considerations into its decision-making to anticipate regulatory,\n"
"                                market, and transition risks. The company applies an internal carbon\n"
"                                price to guide capital allocation and project evaluation."
msgstr "<strong>{{ company_name }}</strong> გადაწყვეტილების მიღების პროცესში ითვალისწინებს ნახშირბადის ხარჯებთან დაკავშირებულ ფაქტორებს, რათა წინასწარ განჭვრიტოს მარეგულირებელი, საბაზრო და გადასვლის რისკები. კომპანია ნახშირბადის შიდა ფასს იყენებს, როგორც ორიენტირს კაპიტალის განაწილებისა და პროექტების შეფასებისას."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s1
msgid ""
"<strong>{{ company_name }}</strong> invests in continuous learning through structured\n"
"                                programs, on-the-job training, and e-learning. Focus areas include\n"
"                                digital skills, leadership, and sustainability awareness."
msgstr "<strong>{{ company_name }}</strong> ახორციელებს ინვესტიციებს უწყვეტ სწავლაში სტრუქტურირებული პროგრამების, სამუშაო ადგილზე ტრენინგისა და ელექტრონული სწავლების მეშვეობით. პრიორიტეტული მიმართულებები მოიცავს ციფრულ უნარებს, ლიდერობასა და მდგრადობის შესახებ ცნობიერებას."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e3
msgid ""
"<strong>{{ company_name }}</strong> maintains comprehensive water\n"
"                                    and marine management policies approved by senior leadership.\n"
"                                    These policies aim to ensure responsible sourcing, efficient\n"
"                                    consumption, and safe return of water to the environment, while\n"
"                                    safeguarding ocean ecosystems."
msgstr "<strong>{{ company_name }}</strong> ახორციელებს წყლის და საზღვაო რესურსების მართვის ყოვლისმომცველ პოლიტიკებს, რომლებიც დამტკიცებულია უმაღლესი ხელმძღვანელობის მიერ. ეს პოლიტიკები ემსახურება წყლის პასუხისმგებლიანი მოპოვების, ეფექტიანი მოხმარებისა და გარემოში უსაფრთხოდ დაბრუნების უზრუნველყოფას, ოკეანის ეკოსისტემების დაცვასთან ერთად."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_g1
msgid ""
"<strong>{{ company_name }}</strong> maintains corporate culture and\n"
"                                    business conduct policies covering ethical behavior,\n"
"                                    whistleblowing, anti-corruption, and responsible\n"
"                                    decision-making. Policies align with OECD Guidelines, UN Global\n"
"                                    Compact, and ISO 37001 anti-bribery standards."
msgstr "<strong>{{ company_name }}</strong> ახორციელებს კორპორაციული კულტურისა და საქმიანი ქცევის პოლიტიკებს, რომლებიც მოიცავს ეთიკურ ქცევას, დარღვევების მხილებას, კორუფციის წინააღმდეგ ბრძოლასა და გადაწყვეტილებების პასუხისმგებლიანად მიღებას. პოლიტიკები შეესაბამება OECD-ის სახელმძღვანელო წესებს, გაეროს გლობალურ შეთანხმებასა და მექრთამეობის წინააღმდეგ ბრძოლის ISO 37001 სტანდარტებს."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e1
msgid ""
"<strong>{{ company_name }}</strong> monitors any GHG removal activities\n"
"                                or carbon credit projects linked to its operations. These may\n"
"                                include carbon sequestration in soils, forests, or technological\n"
"                                capture, and participation in certified carbon offset programs."
msgstr "<strong>{{ company_name }}</strong> მონიტორინგს უწევს საკუთარ ოპერაციებთან დაკავშირებულ სათბურის გაზების შთანთქმის ნებისმიერ აქტივობასა თუ ნახშირბადის კრედიტების პროექტს. ეს შეიძლება მოიცავდეს ნახშირბადის სეკვესტრაციას ნიადაგსა და ტყეებში ან ტექნოლოგიური დაჭერის გზით, ასევე ნახშირბადის კომპენსაციის სერტიფიცირებულ პროგრამებში მონაწილეობას."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e1
msgid ""
"<strong>{{ company_name }}</strong> progressively increases renewable\n"
"                                energy share through Power Purchase Agreements and on-site\n"
"                                generation."
msgstr "<strong>{{ company_name }}</strong> ეტაპობრივად ზრდის განახლებადი ენერგიის წილს ელექტროენერგიის შესყიდვის ხელშეკრულებებისა და ადგილზე გამომუშავების მეშვეობით."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s1
msgid ""
"<strong>{{ company_name }}</strong> promotes equal opportunity and\n"
"                                diversity at all levels. Metrics include gender, age, nationality,\n"
"                                and underrepresented groups. Diversity targets are integrated into\n"
"                                leadership evaluations and HR processes."
msgstr "<strong>{{ company_name }}</strong> ხელს უწყობს თანაბარ შესაძლებლობებსა და მრავალფეროვნებას ყველა დონეზე. მეტრიკები მოიცავს სქესს, ასაკს, მოქალაქეობასა და არასაკმარისად წარმოდგენილ ჯგუფებს. მრავალფეროვნების მიზნები ინტეგრირებულია ხელმძღვანელთა შეფასებასა და ადამიანური რესურსების მართვის პროცესებში."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s1
msgid ""
"<strong>{{ company_name }}</strong> provides formal channels for\n"
"                                workers to report concerns, including whistleblowing hotlines,\n"
"                                email, and direct contact with HR. Remediation processes ensure\n"
"                                timely follow-up, investigation, and resolution of issues."
msgstr "<strong>{{ company_name }}</strong> მუშაკებს სთავაზობს ოფიციალურ არხებს შეშფოთების შესახებ შესატყობინებლად, მათ შორის მამხილებელთა ცხელ ხაზებს, ელფოსტას და ადამიანური რესურსების სამსახურთან უშუალო კონტაქტს. გამოსწორების პროცესები უზრუნველყოფს საკითხებზე დროულ რეაგირებას, მათ შესწავლასა და გადაწყვეტას."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e1
msgid ""
"<strong>{{ company_name }}</strong> quantifies its greenhouse-gas (GHG)\n"
"                                emissions following recognised accounting principles consistent with\n"
"                                the GHG Protocol Corporate Standard and ESRS E1-6."
msgstr "<strong>{{ company_name }}</strong> სათბურის გაზების (GHG) ემისიებს რაოდენობრივად აფასებს აღრიცხვის აღიარებული პრინციპების შესაბამისად, რომლებიც თანხვედრაშია GHG Protocol Corporate Standard-თან და ESRS E1-6-თან."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_e2
msgid ""
"<strong>{{ company_name }}</strong> tracks emissions and discharges\n"
"                                systematically across all relevant operational sites. Data\n"
"                                collection is aligned with the EMS and reported consistently to\n"
"                                management and regulatory authorities."
msgstr "<strong>{{ company_name }}</strong> სისტემატურად ადევნებს თვალყურს ემისიებსა და ჩაშვებებს ყველა შესაბამის საოპერაციო ობიექტზე. მონაცემების შეგროვება შესაბამისობაშია EMS-თან, მონაცემები კი თანმიმდევრულად წარედგინება მენეჯმენტსა და მარეგულირებელ ორგანოებს."

#. module: esg
#: model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s3 model_terms:knowledge.article,template_body:esg.esg_csrd_knowledge_article_template_csrd_esrs_s4
msgid ""
"<strong>{{ company_name }}</strong> will <strong>review this assessment\n"
"                                    annually</strong> or in response to significant business,\n"
"                                    regulatory, or environmental changes."
