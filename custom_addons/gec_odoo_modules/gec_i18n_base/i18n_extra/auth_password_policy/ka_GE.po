#. module: auth_password_policy
#: model:ir.model,name:auth_password_policy.model_res_config_settings
msgid "Config Settings"
msgstr "კონფიგურაციის პარამეტრები"

#. module: auth_password_policy
#: model:ir.model.fields,field_description:auth_password_policy.field_res_config_settings__display_name model:ir.model.fields,field_description:auth_password_policy.field_res_users__display_name
msgid "Display Name"
msgstr "საჩვენებელი სახელი"

#. module: auth_password_policy
#: model:ir.model.fields,field_description:auth_password_policy.field_res_config_settings__id model:ir.model.fields,field_description:auth_password_policy.field_res_users__id
msgid "ID"
msgstr "ID"

#. module: auth_password_policy
#: model:ir.module.module,summary:base.module_auth_password_policy
msgid "Implement basic password policy configuration & check"
msgstr "პაროლის პოლიტიკის საბაზისო კონფიგურაციისა და შემოწმების დანერგვა"

#. module: auth_password_policy
#. odoo-javascript
#: code:addons/auth_password_policy/static/src/password_meter.js:0
msgid "Medium"
msgstr "არხი"

#. module: auth_password_policy
#: model:ir.model.fields,field_description:auth_password_policy.field_res_config_settings__minlength
msgid "Minimum Password Length"
msgstr "პაროლის მინიმალური სიგრძე"

#. module: auth_password_policy
#: model:ir.model.fields,help:auth_password_policy.field_res_config_settings__minlength
msgid "Minimum number of characters passwords must contain, set to 0 to disable."
msgstr "სიმბოლოების მინიმალური რაოდენობა, რომელიც პაროლმა უნდა შეიცავდეს, გასათიშად დააყენეთ 0-ზე."

#. module: auth_password_policy
#. odoo-javascript
#: code:addons/auth_password_policy/static/src/password_field.js:0
msgid "Password"
msgstr "პაროლი"

#. module: auth_password_policy
#: model:ir.module.module,shortdesc:base.module_auth_password_policy
msgid "Password Policy"
msgstr "პაროლის პოლიტიკა"

#. module: auth_password_policy
#. odoo-javascript
#: code:addons/auth_password_policy/static/src/password_meter.js:0
msgid ""
"Required: %s\n"
"\n"
"Hint: to increase password strength, increase length, use multiple words, and use non-letter characters."
msgstr ""
"სავალდებულო: %s\n"
"\n"
"მინიშნება: პაროლის სიძლიერის გასაზრდელად გაზარდეთ სიგრძე, გამოიყენეთ რამდენიმე სიტყვა და ასოების გარდა სხვა სიმბოლოებიც."

#. module: auth_password_policy
#. odoo-javascript
#: code:addons/auth_password_policy/static/src/password_meter.js:0
msgid "Strong"
msgstr "ძლიერი"

#. module: auth_password_policy
#: model:ir.model,name:auth_password_policy.model_res_users
msgid "User"
msgstr "მომხმარებელი"

#. module: auth_password_policy
#. odoo-javascript
#: code:addons/auth_password_policy/static/src/password_meter.js:0
msgid "Weak"
msgstr "სუსტი"

#. module: auth_password_policy
#. odoo-python
#: code:addons/auth_password_policy/models/res_users.py:0
msgid "Your password must contain at least %(minimal_length)d characters and only has %(current_count)d."
msgstr "თქვენი პაროლი უნდა შეიცავდეს მინიმუმ %(minimal_length)d სიმბოლოს, ამჟამად კი მხოლოდ %(current_count)d-ს შეიცავს."

#. module: auth_password_policy
#. odoo-javascript
#: code:addons/auth_password_policy/static/src/password_policy.js:0
msgid "at least %s character classes"
msgstr "მინიმუმ %s სიმბოლოთა კლასი"

#. module: auth_password_policy
#. odoo-javascript
#: code:addons/auth_password_policy/static/src/password_policy.js:0
msgid "at least %s characters"
msgstr "მინიმუმ %s სიმბოლო"

#. module: auth_password_policy
#. odoo-javascript
#: code:addons/auth_password_policy/static/src/password_policy.js:0
msgid "at least %s words"
msgstr "მინიმუმ %s სიტყვა"

#. module: auth_password_policy
#. odoo-javascript
#: code:addons/auth_password_policy/static/src/password_meter.js:0
msgid "no requirements"
msgstr "მოთხოვნები არ არის"
