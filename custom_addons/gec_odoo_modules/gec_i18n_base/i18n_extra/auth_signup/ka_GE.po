#. module: auth_signup
#: model:ir.module.module,description:base.module_auth_signup
msgid ""
"\n"
"Allow users to sign up and reset their password\n"
"===============================================\n"
msgstr ""
"\n"
"მომხმარებლებისთვის რეგისტრაციისა და პაროლის აღდგენის დაშვება\n"
"============================================================\n"

#. module: auth_signup
#: model_terms:ir.ui.view,arch_db:auth_signup.reset_password_email
msgid ""
",<br/><br/>\n"
"        A password reset was requested for the account linked to this email.\n"
"        You may change your password by following this link which will remain valid during"
msgstr ""
",<br/><br/>\n"
"        ამ ელფოსტასთან დაკავშირებული ანგარიშისთვის მოთხოვნილია პაროლის აღდგენა.\n"
"        პაროლი შეგიძლიათ შეცვალოთ ამ ბმულით, რომელიც ძალაშია"

#. module: auth_signup
msgid ""
"<t>\n"
"                        Dear <t t-out=\"object.name or ''\">Marc Demo</t>,<br/><br/>\n"
"                        Your account has been successfully created!<br/>\n"
"                        Your login is <strong><t t-out=\"object.email or ''\">mark.brown23@example.com</t></strong><br/>\n"
"                        To gain access to your account, you can use the following link:\n"
"                        <div style=\"margin: 32px 0px 32px 0px;\">\n"
"                            <a t-attf-href=\"/web/login?auth_login={{object.email}}\" t-attf-style=\"background-color: {{object.company_id.email_secondary_color or '#875A7B'}}; padding: 8px 16px 8px 16px; text-decoration: none; color: {{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px; font-size:13px;\">\n"
"                                Go to My Account\n"
"                            </a>\n"
"                        </div>\n"
"                        Thanks,<br/>\n"
"                        <t t-if=\"user.signature\">\n"
"                            <br/>\n"
"                            <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"                        </t>\n"
"                    </t>"
msgstr ""
"<t>\n"
"                        ძვირფასო <t t-out=\"object.name or ''\">Marc Demo</t>,<br/><br/>\n"
"                        თქვენი ანგარიში წარმატებით შეიქმნა!<br/>\n"
"                        თქვენი მომხმარებლის სახელია <strong><t t-out=\"object.email or ''\">mark.brown23@example.com</t></strong><br/>\n"
"                        ანგარიშზე წვდომის მისაღებად შეგიძლიათ გამოიყენოთ შემდეგი ბმული:\n"
"                        <div style=\"margin: 32px 0px 32px 0px;\">\n"
"                            <a t-attf-href=\"/web/login?auth_login={{object.email}}\" t-attf-style=\"background-color: {{object.company_id.email_secondary_color or '#875A7B'}}; padding: 8px 16px 8px 16px; text-decoration: none; color: {{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px; font-size:13px;\">\n"
"                                ჩემს ანგარიშზე გადასვლა\n"
"                            </a>\n"
"                        </div>\n"
"                        გმადლობთ,<br/>\n"
"                        <t t-if=\"user.signature\">\n"
"                            <br/>\n"
"                            <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"                        </t>\n"
"                    </t>"

#. module: auth_signup
msgid ""
"<t>\n"
"                Dear <t t-out=\"object.name or ''\">Marc Demo</t>,<br/> <br/>\n"
"                Welcome to <t t-out=\"object.company_id.name\">YourCompany</t>'s Portal!<br/><br/>\n"
"                An account has been created for you with the following login: <t t-out=\"object.login\">demo</t><br/><br/>\n"
"                Click on the button below to pick a password and activate your account.\n"
"                <div style=\"margin: 16px 0px 16px 0px; text-align: center;\">\n"
"                    <a t-att-href=\"object.partner_id._get_signup_url()\" t-attf-style=\"display: inline-block; padding: 10px; text-decoration: none; font-size: 12px; background-color: {{object.company_id.email_secondary_color or '#875A7B'}}; color: {{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px;\">\n"
"                        <strong>Activate Account</strong>\n"
"                    </a>\n"
"                </div>\n"
"                <t t-out=\"ctx.get('welcome_message') or ''\">Welcome to our company's portal.</t>\n"
"            </t>"
msgstr ""
"<t>\n"
"                ძვირფასო <t t-out=\"object.name or ''\">Marc Demo</t>,<br/> <br/>\n"
"                მოგესალმებით <t t-out=\"object.company_id.name\">YourCompany</t>-ის პორტალში!<br/><br/>\n"
"                თქვენთვის შეიქმნა ანგარიში შემდეგი მომხმარებლის სახელით: <t t-out=\"object.login\">demo</t><br/><br/>\n"
"                დააწკაპუნეთ ქვემოთ მოცემულ ღილაკზე პაროლის ასარჩევად და ანგარიშის გასააქტიურებლად.\n"
"                <div style=\"margin: 16px 0px 16px 0px; text-align: center;\">\n"
"                    <a t-att-href=\"object.partner_id._get_signup_url()\" t-attf-style=\"display: inline-block; padding: 10px; text-decoration: none; font-size: 12px; background-color: {{object.company_id.email_secondary_color or '#875A7B'}}; color: {{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px;\">\n"
"                        <strong>ანგარიშის გააქტიურება</strong>\n"
"                    </a>\n"
"                </div>\n"
"                <t t-out=\"ctx.get('welcome_message') or ''\">მოგესალმებით ჩვენი კომპანიის პორტალში.</t>\n"
"            </t>"

#. module: auth_signup
msgid ""
"<t>\n"
"<t t-set=\"company_name\" t-value=\"object.company_id.name or ''\"/>\n"
"<t t-set=\"website_url\" t-value=\"object.get_base_url()\"/>\n"
"Hi <t t-out=\"object.name or ''\">Marc Demo</t>,<br/><br/>\n"
"<em>This link is valid for <t t-out=\"(object.env['ir.config_parameter'].sudo().get_int('auth_signup.signup.validity.hours') or 144)//24\">link_validity_days</t> days </em><br/>\n"
"<b><t t-out=\"company_name\"/></b> uses <a href=\"https://odoo.com\" t-attf-style=\"color: {{object.company_id.email_secondary_color or '#875A7B'}};\">Odoo</a>\n"
"to run its business. You have been invited by <b><t t-out=\"object.create_uid.name or ''\">OdooBot</t></b> to connect.\n"
"<br/><br/>\n"
"Once accepted, you can reconnect through: <br/>\n"
"<ul>\n"
"    <li>Login: <a t-attf-href=\"/web/login?login={{ object.email }}\" target=\"_blank\" t-out=\"object.email or ''\">mark.brown23@example.com</a></li>\n"
"    <li>Link: <a t-att-href=\"website_url\" t-out=\"website_url or ''\">http://yourcompany.odoo.com</a></li>\n"
"</ul>\n"
"<br/>\n"
"<div style=\"margin: 16px 0px 16px 0px;\">\n"
"    <a t-att-href=\"object.partner_id._get_signup_url()\" t-attf-style=\"background-color: {{object.company_id.email_secondary_color or '#875A7B'}}; padding: 8px 16px 8px 16px; text-decoration: none; color: {{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px; font-size:13px;\">\n"
"        Accept invitation\n"
"    </a>\n"
"</div>\n"
"<br/>\n"
"Enjoy Odoo!<br/><br/>\n"
"--<br/>The <t t-out=\"company_name\"/> Team</t>\n"
"            "
msgstr ""
"<t>\n"
"<t t-set=\"company_name\" t-value=\"object.company_id.name or ''\"/>\n"
"<t t-set=\"website_url\" t-value=\"object.get_base_url()\"/>\n"
"გამარჯობა, <t t-out=\"object.name or ''\">Marc Demo</t>,<br/><br/>\n"
"<em>ეს ბმული მოქმედია <t t-out=\"(object.env['ir.config_parameter'].sudo().get_int('auth_signup.signup.validity.hours') or 144)//24\">link_validity_days</t> დღის განმავლობაში </em><br/>\n"
"<b><t t-out=\"company_name\"/></b> თავისი ბიზნესის სამართავად იყენებს <a href=\"https://odoo.com\" t-attf-style=\"color: {{object.company_id.email_secondary_color or '#875A7B'}};\">Odoo</a>-ს.\n"
"<b><t t-out=\"object.create_uid.name or ''\">OdooBot</t></b> გიწვევთ დასაკავშირებლად.\n"
"<br/><br/>\n"
"მოწვევის მიღების შემდეგ ხელახლა დაკავშირება შეგიძლიათ შემდეგი მონაცემებით: <br/>\n"
"<ul>\n"
"    <li>მომხმარებლის სახელი: <a t-attf-href=\"/web/login?login={{ object.email }}\" target=\"_blank\" t-out=\"object.email or ''\">mark.brown23@example.com</a></li>\n"
"    <li>ბმული: <a t-att-href=\"website_url\" t-out=\"website_url or ''\">http://yourcompany.odoo.com</a></li>\n"
"</ul>\n"
"<br/>\n"
"<div style=\"margin: 16px 0px 16px 0px;\">\n"
"    <a t-att-href=\"object.partner_id._get_signup_url()\" t-attf-style=\"background-color: {{object.company_id.email_secondary_color or '#875A7B'}}; padding: 8px 16px 8px 16px; text-decoration: none; color: {{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px; font-size:13px;\">\n"
"        მოწვევის მიღება\n"
"    </a>\n"
"</div>\n"
"<br/>\n"
"ისიამოვნეთ Odoo-თი!<br/><br/>\n"
"--<br/><t t-out=\"company_name\"/>-ის გუნდი</t>\n"
"            "

#. module: auth_signup
msgid ""
"<t>\n"
"Dear <t t-out=\"object.name or ''\">Mitchell Admin</t>,<br/> <br/>\n"
"You added the following user(s) to your database but they haven't registered yet:\n"
"<ul>\n"
"    <t t-foreach=\"invited_users\" t-as=\"invited_user\">\n"
"        <li t-out=\"invited_user or ''\">demo@example.com</li>\n"
"    </t>\n"
"</ul>\n"
"Follow up with them so they can access your database and start working with you.\n"
"<br/><br/>\n"
"Have a nice day!<br/>\n"
"--<br/>The <t t-out=\"object.company_id.name or ''\">YourCompany</t> Team\n"
"            </t>"
msgstr ""
"<t>\n"
"ძვირფასო <t t-out=\"object.name or ''\">Mitchell Admin</t>,<br/> <br/>\n"
"თქვენს ბაზაში დაამატეთ შემდეგი მომხმარებელ(ებ)ი, მაგრამ მათ ჯერ არ დაურეგისტრირებიათ თავი:\n"
"<ul>\n"
"    <t t-foreach=\"invited_users\" t-as=\"invited_user\">\n"
"        <li t-out=\"invited_user or ''\">demo@example.com</li>\n"
"    </t>\n"
"</ul>\n"
"დაუკავშირდით მათ, რომ თქვენს ბაზაზე წვდომა მიიღონ და თქვენთან მუშაობა დაიწყონ.\n"
"<br/><br/>\n"
"კარგი დღე გისურვებთ!<br/>\n"
"--<br/><t t-out=\"object.company_id.name or ''\">YourCompany</t>-ის გუნდი\n"
"            </t>"

