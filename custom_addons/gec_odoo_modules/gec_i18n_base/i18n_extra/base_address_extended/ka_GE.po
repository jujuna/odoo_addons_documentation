#: model:ir.model.fields,help:base_address_extended.field_res_country__enforce_cities model:ir.model.fields,help:base_address_extended.field_res_partner__country_enforce_cities model:ir.model.fields,help:base_address_extended.field_res_users__country_enforce_cities
msgid "Check this box to ensure every address created in that country has a 'City' chosen in the list of the country's cities."
msgstr "მონიშნეთ ეს უჯრა, რათა ამ ქვეყანაში შექმნილ ყველა მისამართს ჰქონდეს ქვეყნის ქალაქების სიიდან არჩეული „ქალაქი“."

