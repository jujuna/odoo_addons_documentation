"<span invisible=\"nb_products_selected &lt;= 1000\">\n"
"                            As only 1000 products can be processed per day, the remaining will be\n"
"                            done tomorrow.\n"
"                        </span>"
msgstr ""
"<span invisible=\"nb_products_selected &lt;= 1000\">\n"
"                            რადგან დღეში მხოლოდ 1000 პროდუქტის დამუშავებაა შესაძლებელი, დარჩენილი\n"
"                            ხვალ დამუშავდება.\n"
"                        </span>"

