<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_gec_cit" model="ir.ui.view">
        <field name="name">res.config.settings.form.gec.cit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='default_taxes_setting_container']" position="after">
                <block title="Profit Tax Declaration" name="gec_cit_setting_container" groups="account.group_account_manager">
                    <setting id="gec_cit_status" company_dependent="1" string="Enterprise Status"
                             help="Part I of the declaration; it also decides what goes to column 3">
                        <field name="gec_cit_company_status" widget="radio"/>
                        <div class="content-group mt-2">
                            <div class="row">
                                <label for="gec_cit_special_status" class="col-lg-4 o_light_label"/>
                                <field name="gec_cit_special_status"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="gec_cit_kind" company_dependent="1" string="Special Activities"
                             help="Change which lines of the declaration apply">
                        <div class="content-group">
                            <div><field name="gec_cit_financial"/> <label for="gec_cit_financial" class="o_light_label"/></div>
                            <div><field name="gec_cit_insurer"/> <label for="gec_cit_insurer" class="o_light_label"/></div>
                        </div>
                    </setting>
                    <setting id="gec_cit_post_entry" company_dependent="1"
                             help="Confirming a declaration posts its profit tax, except the dividend tax the CIT wizard books">
                        <field name="gec_cit_post_entry"/>
                        <div class="content-group mt-2" invisible="not gec_cit_post_entry">
                            <div class="row">
                                <label for="gec_cit_journal_id" class="col-lg-4 o_light_label"/>
                                <field name="gec_cit_journal_id" options="{'no_create': True}"/>
                            </div>
                            <div class="row">
                                <label for="gec_cit_expense_account_id" class="col-lg-4 o_light_label"/>
                                <field name="gec_cit_expense_account_id" options="{'no_create': True}"/>
                            </div>
                            <div class="row">
                                <label for="gec_cit_payable_account_id" class="col-lg-4 o_light_label"/>
                                <field name="gec_cit_payable_account_id" options="{'no_create': True}"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
