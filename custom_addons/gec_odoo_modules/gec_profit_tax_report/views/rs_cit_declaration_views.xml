                                    <tr><td class="o_rs_cit_n">2</td><td>მათ შორის, წინა ფინანსური წლის განმავლობაში მიღებული წმინდა მოგებიდან მიმდინარე საანგარიშო პერიოდში (თვეში) განაწილებული დივიდენდის ოდენობა</td><td class="o_rs_cit_amount"><field name="a17_2" options="{'no_symbol': True}" readonly="state != 'draft'"/></td></tr>
                                    <tr><td class="o_rs_cit_n">3</td><td>წინა ფინანსური წლის განმავლობაში კვლევისა და განვითარებისთვის გაწეული ხარჯების სამმაგი ოდენობა</td><td class="o_rs_cit_amount"><field name="a17_3" options="{'no_symbol': True}" readonly="state != 'draft'"/></td></tr>
                                    <tr><td class="o_rs_cit_n">4</td><td>ხარჯების ოდენობა, რომლითაც წინა საანგარიშო პერიოდებში შემცირდა მოგების გადასახადით დასაბეგრი განაწილებული მოგების თანხა</td><td class="o_rs_cit_amount"><field name="a17_4" options="{'no_symbol': True}"/></td></tr>
                                    <tr><td class="o_rs_cit_n">5</td><td>ხარჯების ოდენობა, რომლითაც მიმდინარე საანგარიშო პერიოდში მცირდება მოგების გადასახადით დასაბეგრი განაწილებული მოგების თანხა (სვ.3-სვ.4)</td><td class="o_rs_cit_amount"><field name="a17_5" options="{'no_symbol': True}"/></td></tr>
                                    <tr><td class="o_rs_cit_n">6</td><td>მიმდინარე საანგარიშო პერიოდში მოგების გადასახადით დასაბეგრი განაწილებული მოგების თანხა</td><td class="o_rs_cit_amount"><field name="a17_6" options="{'no_symbol': True}"/></td></tr>
                                </table>
                            </div>

                            <div invisible="not is_march">
                                <div class="o_rs_cit_bar o_rs_cit_bar_annex">დანართი 2</div>
                                <div class="o_rs_cit_subbar">სასაქონლო-მატერიალური ფასეულობების და ძირითადი საშუალებების ნაშთი</div>
                                <table class="o_rs_cit_table o_rs_cit_fields">
                                    <tr><th>N</th><th>შინაარსი</th><th class="o_rs_cit_amount">ლარი</th></tr>
                                    <tr><td class="o_rs_cit_n">1</td><td>სასაქონლო-მატერიალური ფასეულობის ნაშთი წლის ბოლოს</td><td class="o_rs_cit_amount"><field name="a2_inventory" options="{'no_symbol': True}"/></td></tr>
                                    <tr><td class="o_rs_cit_n">2</td><td>ძირითადი საშუალებების ნაშთი წლის ბოლოს</td><td class="o_rs_cit_amount"><field name="a2_fixed" options="{'no_symbol': True}"/></td></tr>
                                </table>
                            </div>

                            <div class="o_rs_cit_bar o_rs_cit_bar_annex">დანართი 3</div>
                            <div class="o_rs_cit_subbar">სესხების და კაპიტალის აღრიცხვა</div>
                            <field name="annex3_line_ids" widget="rs_cit_annex3" readonly="state != 'draft'">
                                <list>
                                    <field name="annex" column_invisible="1"/>
                                    <field name="sequence"/>
                                    <field name="name"/>
                                    <field name="amount1"/>
                                    <field name="amount2"/>
                                    <field name="amount3"/>
                                    <field name="amount4"/>
                                    <field name="amount5"/>
                                    <field name="amount6"/>
                                    <field name="manual"/>
                                </list>
                            </field>
                            <div class="o_rs_cit_annex3_none">
                                <span class="o_rs_cit_annex3_none_text">იმ შემთხვევაში თუ არ გიფიქსირდებათ N3 დანართის სვეტებით მოთხოვნილი ინფორმაცია,გთხოვთ გააკეთოთ მონიშვნა</span>
                                <field name="annex3_none" readonly="state != 'draft'"/>
                            </div>

                            <div invisible="not is_march and not annex4_line_ids">
                                <div class="o_rs_cit_bar o_rs_cit_bar_annex">დანართი 4</div>
                                <div class="o_rs_cit_subbar">ინფორმაცია საქართველოს საგადასახადო კოდექსის 126-129¹ მუხლებით გათვალისწინებული საერთაშორისო კონტროლირებული ოპერაციების შესახებ</div>
                                <field name="annex4_line_ids" readonly="state != 'draft'" context="{'default_annex': '4'}">
                                    <list editable="bottom">
                                        <field name="annex" column_invisible="1"/>
                                        <field name="partner_id"/>
                                        <field name="partner_vat" optional="show"/>
                                        <field name="partner_country_id" optional="show"/>
                                        <field name="relation"/>
                                        <field name="operation"/>
                                        <field name="operation_currency_id"/>
                                        <field name="amount1" string="Volume in Currency"/>
                                        <field name="amount2" string="Volume in GEL" sum="Total"/>
                                        <field name="amount3" string="Balance at Year End"/>
                                        <field name="date" string="Start Date"/>
                                        <field name="documentation"/>
                                        <field name="name" string="Contract" optional="hide"/>
                                    </list>
                                </field>
                            </div>
                        </page>

                        <page string="Odoo" name="odoo">
                            <group>
                                <group>
                                    <field name="date_to"/>
                                    <field name="version"/>
                                    <field name="booking_amount"/>
                                    <field name="booked_amount"/>
                                    <field name="move_id"/>
                                </group>
                                <group>
                                    <field name="dividend_total"/>
                                    <field name="dividend_unmatched"/>
                                    <field name="charity_taxed"/>
                                </group>
                            </group>
                            <group string="Taxed this month (recovered later on lines 27.1 and 27.2)">
                                <field name="taxed_item_ids" nolabel="1" colspan="2">
                                    <list>
                                        <field name="currency_id" column_invisible="1"/>
                                        <field name="code"/>
                                        <field name="date"/>
                                        <field name="partner_id"/>
                                        <field name="account_id"/>
                                        <field name="amount" sum="Total"/>
                                        <field name="remaining"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="rs_cit_entry_view_list" model="ir.ui.view">
        <field name="name">rs.cit.entry.list</field>
        <field name="model">rs.cit.entry</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="false" delete="false" decoration-muted="entered" class="o_rs_cit_entry">
                <field name="entered" widget="boolean_toggle" width="90px"/>
                <field name="section" width="190px"/>
                <field name="code" width="110px"/>
                <field name="name"/>
                <field name="value" widget="CopyClipboardChar" width="240px"/>
            </list>
        </field>
    </record>

    <record id="rs_cit_declaration_action" model="ir.actions.act_window">
        <field name="name">Profit Tax Declarations</field>
        <field name="res_model">rs.cit.declaration</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="rs_cit_declaration_menu"
              name="Profit Tax Declaration (II-086)"
              parent="account.menu_finance_reports"
              action="rs_cit_declaration_action"
              sequence="61"/>

    <record id="rs_cit_taxed_item_view_list" model="ir.ui.view">
        <field name="name">rs.cit.taxed.item.list</field>
        <field name="model">rs.cit.taxed.item</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="currency_id" column_invisible="1"/>
                <field name="declaration_id"/>
                <field name="code"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="account_id"/>
                <field name="move_line_id" optional="hide"/>
                <field name="amount" sum="Total"/>
                <field name="recovered" sum="Total"/>
                <field name="remaining"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="rs_cit_taxed_item_action" model="ir.actions.act_window">
        <field name="name">Profit Tax Taxed Items</field>
        <field name="res_model">rs.cit.taxed.item</field>
        <field name="view_mode">list</field>
        <field name="domain">[('state', '=', 'confirmed')]</field>
        <field name="help" type="html">
            <p>Amounts taxed on lines 18.1.1, 18.1.3, 18.1.4, 18.2 and 18.3 by confirmed declarations. When the
               money comes back, the declaration of that month counts it on line 27.1 or 27.2.</p>
        </field>
    </record>

    <menuitem id="rs_cit_taxed_item_menu"
              name="Profit Tax Taxed Items"
              parent="account.menu_finance_reports"
              action="rs_cit_taxed_item_action"
              groups="account.group_account_user"
              sequence="62"/>
</odoo>
