<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rs_cit_declaration_view_list" model="ir.ui.view">
        <field name="name">rs.cit.declaration.list</field>
        <field name="model">rs.cit.declaration</field>
        <field name="arch" type="xml">
            <list>
                <field name="currency_id" column_invisible="1"/>
                <field name="date_from" widget="date" options="{'format': 'MM/yyyy'}"/>
                <field name="declaration_type"/>
                <field name="version" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="tax_payable" sum="Total"/>
                <field name="tax_refund" optional="show" sum="Total"/>
                <field name="move_id" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <record id="rs_cit_declaration_view_search" model="ir.ui.view">
        <field name="name">rs.cit.declaration.search</field>
        <field name="model">rs.cit.declaration</field>
        <field name="arch" type="xml">
            <search>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="corrected" string="Corrected" domain="[('declaration_type', '=', 'corrected')]"/>
                <separator/>
                <filter name="month" string="Month" date="date_from"/>
            </search>
        </field>
    </record>

    <record id="rs_cit_declaration_view_form" model="ir.ui.view">
        <field name="name">rs.cit.declaration.form</field>
        <field name="model">rs.cit.declaration</field>
        <field name="arch" type="xml">
            <form class="o_rs_cit_form">
                <header>
                    <button name="action_compute" string="Recalculate" type="object" invisible="state != 'draft'"/>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_open_rs_entry" string="rs.ge Entry" type="object"
                            help="Values to type on rs.ge, with copy buttons"/>
                    <button name="action_export_xlsx" string="Export XLSX" type="object"/>
                    <button name="action_create_correction" string="Correct" type="object" invisible="state != 'confirmed'"
                            help="Start a corrected declaration of the same month"/>
                    <button name="action_draft" string="Back to Draft" type="object" invisible="state != 'confirmed'"
                            groups="account.group_account_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <field name="gambling" invisible="1"/>
                    <field name="is_march" invisible="1"/>
                    <div class="alert alert-warning" role="alert" invisible="not checks">
                        <field name="checks" class="text-break" style="white-space: pre-line;"/>
                    </div>
                    <div class="o_rs_cit_titlebar">
                        <span>მოგების გადასახადის ყოველთვიური დეკლარაცია</span>
                        <span class="ms-auto"><field name="company_id" readonly="state != 'draft'" options="{'no_open': True}"/></span>
                    </div>
                    <div class="o_rs_cit_period">
                        <field name="declaration_type"/>
                        <span>,</span>
                        <field name="period_label"/>
                        <span class="ms-auto fw-normal fs-6 text-muted">
                            <span>Payable: </span><field name="tax_payable" class="fw-bold"/>
                            <span class="ms-3">Refundable: </span><field name="tax_refund" class="fw-bold"/>
                            <span class="ms-3" invisible="not rs_entry_progress">Entered on rs.ge: </span>
                            <field name="rs_entry_progress" class="fw-bold" invisible="not rs_entry_progress"/>
                        </span>
                    </div>
                    <notebook>
                        <page string="1. ნაწილი I" name="part_1">
                            <div class="o_rs_cit_bar mt-0">ნაწილი I</div>
                            <table class="o_rs_cit_table o_rs_cit_fields">
                                <tr>
                                    <td class="w-25">საანგარიშო პერიოდი</td>
                                    <td><field name="date_from" widget="date" options="{'min_precision': 'months', 'numeric': true}" readonly="state != 'draft'"/></td>
                                </tr>
                                <tr>
                                    <td class="w-25">საწარმოს სტატუსი</td>
                                    <td><field name="company_status" widget="radio" readonly="state != 'draft'"/></td>
                                </tr>
                            </table>
                            <div class="o_rs_cit_bar">Odoo</div>
                            <table class="o_rs_cit_table o_rs_cit_fields">
                                <tr>
                                    <td class="w-25"><label for="special_status"/></td>
                                    <td><field name="special_status" readonly="state != 'draft'"/></td>
                                </tr>
                                <tr>
                                    <td><label for="col3_rate"/></td>
                                    <td><field name="col3_rate" widget="percentage" readonly="state != 'draft'"/></td>
                                </tr>
                            </table>
                        </page>

                        <page string="2. ნაწილი III და დანართები" name="part_3">
                            <div class="o_rs_cit_bar mt-0">III ნაწილი</div>
                            <field name="line_ids" widget="rs_cit_part3" readonly="state != 'draft'">
                                <list limit="200">
                                    <field name="cell_id" column_invisible="1"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="kind"/>
                                    <field name="columns"/>
                                    <field name="amount_auto"/>
                                    <field name="amount_adjust"/>
                                    <field name="amount"/>
                                    <field name="amount3_auto"/>
                                    <field name="amount3_adjust"/>
                                    <field name="amount3"/>
                                    <field name="move_line_count"/>
                                </list>
                            </field>

                            <div class="o_rs_cit_bar o_rs_cit_bar_annex">დანართი 1</div>
                            <div class="o_rs_cit_subbar">სადაზღვევო ორგანიზაციის შემთხვევაში - 2015 წლის 1 იანვრიდან 2024 წლის 1 იანვრამდე, ხოლო სხვა შემთხვევაში - 2008 წლის 1 იანვრიდან 2017 წლის 1 იანვრამდე მიღებული წმინდა მოგებიდან დივიდენდის განაწილებისას ამავე საანგარიშო პერიოდების მიხედვით დარიცხული და გადახდილი მოგების გადასახადის თანხა, რომელიც ექვემდებარება ჩათვლას</div>
                            <table class="o_rs_cit_table o_rs_cit_fields">
                                <tr><th>N</th><th>შინაარსი</th><th class="o_rs_cit_amount">ლარი</th></tr>
                                <tr><td class="o_rs_cit_n">1</td><td>საანგარიშო პერიოდში დივიდენდის სახით განაწილებული თანხის ოდენობა, რომელიც ექვემდებარება დაბეგვრას ( III ნაწილის სტ. 16.1.1 )</td><td class="o_rs_cit_amount"><field name="a1_1" options="{'no_symbol': True}" readonly="state != 'draft'"/></td></tr>
                                <tr><td class="o_rs_cit_n">2</td><td>სადაზღვევო ორგანიზაციის შემთხვევაში - 2015 წლის 1 იანვრიდან 2024 წლის 1 იანვრამდე საანგარიშო პერიოდების, ხოლო სხვა შემთხვევაში - 2008 წლის 1 იანვრიდან 2017 წლის 1 იანვრამდე საანგარიშო პერიოდების მიხედვით დარიცხული და გადახდილი მოგების გადასახადის თანხა</td><td class="o_rs_cit_amount"><field name="a1_2" options="{'no_symbol': True}" readonly="state != 'draft'"/></td></tr>
                                <tr><td class="o_rs_cit_n">3</td><td>სადაზღვევო ორგანიზაციის შემთხვევაში - 2015 წლის 1 იანვრიდან 2024 წლის 1 იანვრამდე საანგარიშო პერიოდების, ხოლო სხვა შემთხვევაში - 2008 წლის 1 იანვრიდან 2017 წლის 1 იანვრამდე საანგარიშო პერიოდებში მიღებული წმინდა მოგების ოდენობა</td><td class="o_rs_cit_amount"><field name="a1_3" options="{'no_symbol': True}" readonly="state != 'draft'"/></td></tr>
                                <tr><td class="o_rs_cit_n">4</td><td>სადაზღვევო ორგანიზაციის შემთხვევაში - 2015 წლის 1 იანვრიდან 2024 წლის 1 იანვრამდე საანგარიშო პერიოდების, ხოლო სხვა შემთხვევაში - 2008 წლის 1 იანვრიდან 2017 წლის 1 იანვრამდე საანგარიშო პერიოდებში მიღებული წმინდა მოგების ხარჯზე დივიდენდის სანაცვლოდ საწარმოს მიერ პარტნიორისათვის გადაცემული ამ საწარმოს აქციების/წილის ღირებულება</td><td class="o_rs_cit_amount"><field name="a1_4" options="{'no_symbol': True}" readonly="state != 'draft'"/></td></tr>
                                <tr><td class="o_rs_cit_n">5</td><td>ჩასათვლელი თანხა (სტ.1*სტ.2/(სტ.3-სტ.4))</td><td class="o_rs_cit_amount"><field name="a1_5" options="{'no_symbol': True}"/></td></tr>
                            </table>

                            <div>
                                <div class="o_rs_cit_bar text-center">IV ნაწილი</div>
                                <div class="o_rs_cit_subbar">სათამაშო აპარატების სალონის მომწყობი პირის, სისტემურ-ელექტრონული ფორმით აზარტული თამაშობების ან/და სისტემურ-ელექტრონული ფორმით ტოტალიზატორის თამაშობების ორგანიზატორის მოგების გადასახადის გაანგარიშება</div>
                                <table class="o_rs_cit_table o_rs_cit_fields">
                                    <tr><th>N</th><th>დაბეგვრის ობიექტი</th><th class="o_rs_cit_amount">თანხა</th><th class="o_rs_cit_amount">კუთვნილი მოგების გადასახადი</th></tr>
                                    <tr><td class="o_rs_cit_n">1</td><td>სისტემურ-ელექტრონული ფორმით აზარტული თამაშობების ორგანიზატორის მიერ საქმიანობის ამ ნაწილში (გარდა უცხო ქვეყნის მოქალაქეების სისტემურ-ელექტრონული ფორმით ორგანიზებულ აზარტულ თამაშობებში მონაწილეობის შედეგად მიღებული დასაბეგრი მოგებისა) საანგარიშო თვის განმავლობაში მიღებულ ფსონებსა და გაცემულ მოგებას შორის სხვაობის თანხა</td><td class="o_rs_cit_amount"><field name="g1" options="{'no_symbol': True}" readonly="state != 'draft'"/></td><td class="o_rs_cit_amount"><field name="g1_tax" options="{'no_symbol': True}"/></td></tr>
                                    <tr><td class="o_rs_cit_n">2</td><td>სისტემურ-ელექტრონული ფორმით ტოტალიზატორის თამაშობების ორგანიზატორის მიერ საქმიანობის ამ ნაწილში (გარდა უცხო ქვეყნის მოქალაქეების სისტემურ-ელექტრონული ფორმით ორგანიზებულ ტოტალიზატორის თამაშობებში მონაწილეობის შედეგად მიღებული დასაბეგრი მოგებისა) საანგარიშო თვის განმავლობაში მიღებული ფსონების ჯამური თანხა</td><td class="o_rs_cit_amount"><field name="g2" options="{'no_symbol': True}" readonly="state != 'draft'"/></td><td class="o_rs_cit_amount"><field name="g2_tax" options="{'no_symbol': True}"/></td></tr>
                                    <tr><td class="o_rs_cit_n">3</td><td>სათამაშო აპარატების სალონის მომწყობი პირის მიერ საქმიანობის ამ ნაწილში საანგარიშო თვის განმავლობაში მიღებულ ფსონებსა და გაცემულ მოგებას შორის სხვაობის თანხა</td><td class="o_rs_cit_amount"><field name="g3" options="{'no_symbol': True}" readonly="state != 'draft'"/></td><td class="o_rs_cit_amount"><field name="g3_tax" options="{'no_symbol': True}"/></td></tr>
                                    <tr><td class="o_rs_cit_n">4</td><td>უცხო ქვეყნის მოქალაქეების სისტემურ-ელექტრონული ფორმით აზარტულ თამაშობებში მონაწილეობის შედეგად, სისტემურ-ელექტრონული ფორმით აზარტული თამაშობების ორგანიზატორის მიერ საანგარიშო თვის განმავლობაში მიღებულ ფსონებსა და ამ მოთამაშეებზე გაცემულ მოგებას შორის სხვაობის თანხა</td><td class="o_rs_cit_amount"><field name="g4" options="{'no_symbol': True}" readonly="state != 'draft'"/></td><td class="o_rs_cit_amount"><field name="g4_tax" options="{'no_symbol': True}"/></td></tr>
                                    <tr><td class="o_rs_cit_n">5</td><td>უცხო ქვეყნის მოქალაქეების სისტემურ-ელექტრონული ფორმით ტოტალიზატორის თამაშობებში მონაწილეობის შედეგად, სისტემურ-ელექტრონული ფორმით ტოტალიზატორის თამაშობების ორგანიზატორის მიერ საანგარიშო თვის განმავლობაში მიღებულ ფსონებსა და ამ მოთამაშეებზე გაცემულ მოგებას შორის სხვაობის თანხა</td><td class="o_rs_cit_amount"><field name="g5" options="{'no_symbol': True}" readonly="state != 'draft'"/></td><td class="o_rs_cit_amount"><field name="g5_tax" options="{'no_symbol': True}"/></td></tr>
                                    <tr><td/><td>ჯამი</td><td/><td class="o_rs_cit_amount"><field name="gambling_total" options="{'no_symbol': True}"/></td></tr>
                                </table>
                                <div class="o_rs_cit_note">შენიშვნა:<br/>მიღებულ ფსონებში:<br/>-გაითვალისწინება მოთამაშეთა მიერ გამოყენებული უფასო ფსონები;<br/>-არ გაითვალისწინება მოთამაშეთა შორის დადებული ფსონები, როდესაც თამაშობა არ გულისხმობს თამაშობის ორგანიზატორის მიერ ფსონის მიღებას.</div>
                            </div>

                            <div class="o_rs_cit_bar o_rs_cit_bar_annex">დანართი 1¹</div>
                            <div class="o_rs_cit_subbar">სადაზღვევო ორგანიზაციის შემთხვევაში - 2015 წლის 1 იანვრიდან 2024 წლის 1 იანვრამდე, ხოლო სხვა შემთხვევაში - 2008 წლის 1 იანვრიდან 2017 წლის 1 იანვრამდე მიღებული წმინდა მოგებიდან დივიდენდის განაწილებისას ამავე საანგარიშო პერიოდების მიხედვით დარიცხული და გადახდილი მოგების გადასახადის თანხის მიხედვით ჩასათვლელი თანხის კორექტირება</div>
                            <div class="o_rs_cit_subbar text-start">ნაწილი I<br/>მოგების გადასახადის ყოველთვიური დეკლარაციის საანგარიშო პერიოდი, რომელშიც განაწილებული დივიდენდის მიხედვით ჩასათვლელი თანხის კორექტირება ხორციელდება</div>
                            <field name="annex11_line_ids" readonly="state != 'draft'" context="{'default_annex': '1.1'}">
                                <list editable="bottom">
                                    <field name="annex" column_invisible="1"/>
                                    <field name="name" string="თვე/წელი"/>
                                    <field name="amount1" string="25.1 სტრიქონის მონაცემი" width="260px" sum="სულ" readonly="1" force_save="1"/>
                                    <field name="amount2" string="16.1.1 სტრიქონის მონაცემი" width="260px" sum="სულ" readonly="1" force_save="1"/>
                                </list>
                            </field>
                            <div class="o_rs_cit_bar">ნაწილი II</div>
                            <table class="o_rs_cit_table o_rs_cit_fields">
