<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rs_cit_cell_view_list" model="ir.ui.view">
        <field name="name">rs.cit.cell.list</field>
        <field name="model">rs.cit.cell</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="measure" optional="show"/>
                <field name="parent_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="rs_cit_cell_action" model="ir.actions.act_window">
        <field name="name">Profit Tax Declaration Rows</field>
        <field name="res_model">rs.cit.cell</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="rs_cit_cell_menu"
              name="Profit Tax Declaration Rows"
              parent="account.account_account_menu"
              action="rs_cit_cell_action"
              groups="account.group_account_manager"
              sequence="90"/>
</odoo>
