<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.signify.documents</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="documents.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='documents']" position="attributes">
                <attribute name="notApp">0</attribute>
            </xpath>
            <xpath expr="//block[@id='files_centralization_section']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
            <xpath expr="//block[@id='files_centralization_section']" position="inside">
                <setting company_dependent="1" string="Signify" help="Folder for the signed files and evidence reports. While no folder is chosen, nothing is saved in Documents.">
                    <label class="o_form_label col-lg-3" for="documents_signify_folder_id" string="Folder"/>
                    <field name="documents_signify_folder_id" options="{'no_create': True, 'no_create_edit': True}"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
