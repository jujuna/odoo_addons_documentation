<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="dps_account_report_filter.AccountReportCurrenciesData">
        <Dropdown>
            <button class="btn btn-secondary">
                <i class="oi me-1" data-icon="payments"/><t t-out="this.controller.cachedFilterOptions.selected_currencies"/>
            </button>
            <t t-set-slot="content">
                <t t-foreach="this.controller.cachedFilterOptions.currencies" t-as="currency" t-key="currency.id">
                    <DropdownItem
                        class="{ 'selected': currency.selected, 'ps-4': true }"
                        onSelected="() => this.OnSelectCurrency(currency)"
                    >
                        <t t-out="currency.name"/>
                    </DropdownItem>
                </t>
            </t>
        </Dropdown>
    </t>
</templates>
