<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rs_invoice_from_waybill_wizard_form" model="ir.ui.view">
        <field name="name">rs.invoice.from.waybill.wizard.form</field>
        <field name="model">rs.invoice.from.waybill.wizard</field>
        <field name="arch" type="xml">
            <form string="Create RS Invoice from Waybills">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="seed_sale_order_id" readonly="1"
                                   invisible="is_standalone"/>
                            <field name="common_sale_order_id" readonly="1"
                                   invisible="not is_standalone or not common_sale_order_id"/>
                            <field name="has_mixed_sale_orders" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="is_standalone" invisible="1"/>
                        </group>
                        <group>
                            <field name="invoice_date"/>
                            <field name="journal_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group string="Waybills">
                        <field name="waybill_ids" widget="many2many_tags"
                               readonly="is_standalone"
                               options="{'no_create': True, 'no_open': True}"
                               nolabel="1"/>
                    </group>

                    <div class="alert alert-warning mb-2" role="alert"
                         invisible="not has_unmatched or is_standalone">
                        Some waybill lines could not be matched to a sale order line.
                        Those invoice lines will be created without a sale order link
                        (qty_invoiced will not auto-update).
                        <div class="mt-1">
                            <field name="i_confirm_unmatched"/>
                            <label for="i_confirm_unmatched" string="I understand"/>
                        </div>
                    </div>

                    <div class="alert alert-warning mb-2" role="alert"
                         invisible="not has_overdelivery or is_standalone">
                        Some lines invoice more than the remaining quantity on the SO line.
                        <div class="mt-1">
                            <field name="i_confirm_overdelivery"/>
                            <label for="i_confirm_overdelivery" string="I understand"/>
                        </div>
                    </div>

                    <div class="alert alert-danger mb-2" role="alert"
                         invisible="not has_mixed_sale_orders">
                        Selected waybills are linked to different sale orders.
                        All waybills must share the same sale order (or none).
                        Remove the mismatched waybills before creating the invoice.
                    </div>

                    <field name="line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="waybill_line_id" column_invisible="1" force_save="1"/>
                            <field name="waybill_id" readonly="1" optional="show" force_save="1"/>
                            <field name="product_id" readonly="1" force_save="1"/>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="discount" optional="show"/>
                            <field name="tax_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                            <field name="partner_id" column_invisible="1"/>
                            <field name="sale_line_id"
                                   domain="[('order_id.partner_id','=', partner_id),
                                            ('order_id.state','in',('sale','done')),
                                            ('product_id','=', product_id),
                                            ('is_downpayment','=', False),
                                            ('display_type','=', False)]"
                                   options="{'no_create': True}"/>
                            <field name="sale_order_id" readonly="1" optional="show"/>
                            <field name="qty_to_invoice_remaining" readonly="1" optional="show"/>
                            <field name="warning" readonly="1"
                                   decoration-warning="warning != False"/>
                        </list>
                    </field>

                    <group string="Notes">
                        <field name="note" nolabel="1" placeholder="Optional narration appended to the invoice notes..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_invoice" string="Create Invoice"
                            type="object" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
