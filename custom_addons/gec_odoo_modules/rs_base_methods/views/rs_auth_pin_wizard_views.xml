<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rs_auth_pin_wizard_view_form" model="ir.ui.view">
        <field name="name">rs.auth.pin.wizard.form</field>
        <field name="model">rs.auth.pin.wizard</field>
        <field name="arch" type="xml">
            <form string="RS 2-Step Authentication">
                <div class="alert alert-info" role="alert">
                    The Revenue Service just sent a 4-digit SMS code to
                    <field name="masked_mobile" readonly="1" class="oe_inline fw-bold"/>.
                    Enter it below to finish authentication and pair this device so future
                    logins skip the SMS step.
                </div>
                <group>
                    <field name="user_id" readonly="1"/>
                    <field name="company_id" readonly="1"/>
                    <field name="pin_token" invisible="1"/>
                    <field name="pin" placeholder="e.g. 7542"/>
                </group>
                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Confirm"
                            class="btn-primary"
                            icon="check"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
