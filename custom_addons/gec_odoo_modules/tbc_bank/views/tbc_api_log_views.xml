<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tbc_api_log_list" model="ir.ui.view">
        <field name="name">tbc.api.log.list</field>
        <field name="model">tbc.api.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="create_date"/>
                <field name="connection_id"/>
                <field name="endpoint"/>
                <field name="http_status"/>
                <field name="error_message"/>
                <field name="duration_ms"/>
            </list>
        </field>
    </record>

    <record id="view_tbc_api_log_form" model="ir.ui.view">
        <field name="name">tbc.api.log.form</field>
        <field name="model">tbc.api.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="connection_id"/>
                            <field name="endpoint"/>
                            <field name="http_status"/>
                            <field name="duration_ms"/>
                        </group>
                        <group>
                            <field name="error_message"/>
                        </group>
                    </group>
                    <group string="Request">
                        <field name="request_payload" nolabel="1"/>
                    </group>
                    <group string="Response">
                        <field name="response_payload" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tbc_api_log" model="ir.actions.act_window">
        <field name="name">TBC API Logs</field>
        <field name="res_model">tbc.api.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
