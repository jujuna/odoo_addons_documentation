<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tbc_approval_form" model="ir.ui.view">
        <field name="name">tbc.approval.form</field>
        <field name="model">tbc.approval</field>
        <field name="arch" type="xml">
            <form string="TBC Bank Approver">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="approver_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Delegates">
                        <field name="delegate_ids" nolabel="1" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tbc_approval_list" model="ir.ui.view">
        <field name="name">tbc.approval.list</field>
        <field name="model">tbc.approval</field>
        <field name="arch" type="xml">
            <list string="TBC Bank Approvers">
                <field name="approver_id"/>
                <field name="delegate_ids" widget="many2many_tags"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_tbc_approval" model="ir.actions.act_window">
        <field name="name">Approvers &amp; Delegates</field>
        <field name="res_model">tbc.approval</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
