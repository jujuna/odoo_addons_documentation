<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_tbc" model="ir.ui.view">
        <field name="name">account.journal.form.tbc</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <sheet position="inside">
                <field name="is_tbc" invisible="1"/>
                <button name="action_tbc_import_statement" type="object" groups="tbc_bank.group_tbc_user"
                        string="Import TBC Statement" class="btn-secondary"
                        invisible="not is_tbc"/>
            </sheet>
        </field>
    </record>
</odoo>
