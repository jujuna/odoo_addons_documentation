<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_batch_payment_form_tbc" model="ir.ui.view">
        <field name="name">account.batch.payment.form.tbc</field>
        <field name="model">account.batch.payment</field>
        <field name="inherit_id" ref="account_batch_payment.view_batch_payment_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <field name="tbc_processing_mode" invisible="1"/>
                <button name="action_tbc_submit_approval" type="object"
                        string="Submit for TBC Approval" groups="tbc_bank.group_tbc_user"
                        invisible="payment_method_code != 'tbc_transfer' or tbc_processing_mode != 'odoo_approve' or state != 'draft'"/>
                <button name="action_tbc_approve" type="object"
                        string="Approve TBC Transfers"
                        invisible="payment_method_code != 'tbc_transfer' or tbc_processing_mode != 'odoo_approve' or state != 'draft'"/>
                <button name="action_tbc_send_batch" type="object"
                        groups="tbc_bank.group_tbc_user"
                        string="Send to TBC" class="btn-primary"
                        confirm="This sends the ready transfers of this batch to TBC Bank. Continue?"
                        invisible="payment_method_code != 'tbc_transfer' or state != 'draft'"/>
            </header>
            <xpath expr="//button[@id='validate_button'][@name='validate_batch_button']" position="attributes">
                <attribute name="invisible" add="payment_method_code == 'tbc_transfer'" separator=" or "/>
            </xpath>
        </field>
    </record>
</odoo>
