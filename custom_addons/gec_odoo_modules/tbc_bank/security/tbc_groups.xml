<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_tbc" model="ir.module.category">
        <field name="name">TBC Bank</field>
        <field name="description">Send transfers and import statements via the TBC Bank BIS API.</field>
        <field name="sequence">25</field>
    </record>

    <record id="tbc_privilege" model="res.groups.privilege">
        <field name="name">TBC Bank</field>
        <field name="category_id" ref="module_category_tbc"/>
        <field name="sequence">25</field>
    </record>

    <record id="group_tbc_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="tbc_privilege"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="group_tbc_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="tbc_privilege"/>
        <field name="implied_ids" eval="[(4, ref('group_tbc_user')), (4, ref('account.group_account_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
